# Copy to .env.play when you want to upload screenshots.
# Do not commit .env.play or the service-account JSON.
PLAY_PACKAGE_NAME=xyz.waozi.inbe
PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/google-play-service-account.json
PLAY_LANGUAGE=en-US
PLAY_METADATA_IMAGES_DIR=fastlane/metadata/android/en-US/images
PLAY_IMAGE_TYPES=phoneScreenshots,sevenInchScreenshots,tenInchScreenshots
PLAY_DELETE_EXISTING=1

# Default is validate-only and discards the draft edit.
# Set to 1 only when you want the uploaded screenshots committed to Play.
PLAY_COMMIT=0
