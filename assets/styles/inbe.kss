Text.practice-heading {
    foreground: text;
}
Text.muted {
    foreground: muted;
}
Text.selected-navigation {
    foreground: accent-ink;
}
Text.circle-ink {
    foreground: #171022;
}

Button.practice-pager {
    font-size: 42;
}

Image {
    foreground: #ffffff;
    background: #00000000;
    border: #00000000;
    radius: 0;
    border-width: 0;
    material: flat;
    opacity: 1;
}

Image.pose-muted {
    opacity: 0.62;
}
