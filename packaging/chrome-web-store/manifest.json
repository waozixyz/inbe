{
  "manifest_version": 3,
  "name": "Inner Breeze",
  "short_name": "Inbe",
  "version": "__APP_VERSION__",
  "description": "Breathing, meditation, habit tracking, and encrypted sync.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inner Breeze",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
