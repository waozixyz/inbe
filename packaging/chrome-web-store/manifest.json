{
  "manifest_version": 3,
  "name": "Inner Breeze",
  "short_name": "Inbe",
  "version": "__APP_VERSION__",
  "description": "Breathing, meditation, habit tracking, and encrypted sync.",
  "permissions": [
    "alarms",
    "contextMenus",
    "idle",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.waozi.xyz/*",
    "https://inbe.waozi.xyz/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.waozi.xyz wss://api.waozi.xyz https://inbe.waozi.xyz; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inner Breeze",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
