#module "app.chrome"

#import "app.h"

app_draw_close_title_bar :: (app: InnerBreeze*, title: const char*,
                             height: int) -> int #export {
    hover := 0
    button_size := Scale(22)
    padding := Scale(11)
    button_total := button_size + padding * 2
    x := view_width - button_total - Scale(8)
    y := (height - button_total) / 2
    if y < 0 { y = 0 }
    TitleBar(title, height)
    if app != nil && !app->modal.active &&
       PaddedIconBtn(0, x, y, button_size, padding,
                     app->icons[UI_ICON_TYPE_X], &hover) {
        return 1
    }
    return 0
}

app_scaffold_close_title :: (title: const char*, height: int,
                             user_data: void*) -> int #export {
    return app_draw_close_title_bar((InnerBreeze*)user_data, title, height)
}

app_draw_close_dropdown_title_bar :: (app: InnerBreeze*,
                                      dropdown: UITitleBarDropdown,
                                      height: int) -> int #export {
    hover := 0
    button_size := Scale(22)
    padding := Scale(11)
    button_total := button_size + padding * 2
    close_x := view_width - button_total - Scale(8)
    close_y := (height - button_total) / 2
    dropdown_x := Scale(8)
    dropdown_h := dropdown.height > 0 ? dropdown.height : Scale(32)
    dropdown_y := (height - dropdown_h) / 2
    dropdown_w := close_x - dropdown_x - Scale(8)
    if close_y < 0 { close_y = 0 }
    if dropdown_y < 0 { dropdown_y = 0 }
    if dropdown_w < 1 { dropdown_w = 1 }
    DrawRectangle(0, 0, view_width, height, GetThemeBackground())
    DrawLine(0, height - 1, view_width, height - 1,
             DarkenUIColor(GetThemeButton(), 18))
    Dropdown(dropdown.id, dropdown_x, dropdown_y, dropdown_w, dropdown_h,
             dropdown.options, dropdown.option_count, dropdown.selected_index)
    if app != nil && !app->modal.active &&
       PaddedIconBtn(0, close_x, close_y, button_size, padding,
                     app->icons[UI_ICON_TYPE_X], &hover) {
        return 1
    }
    return 0
}

app_toolbar_height :: () -> int #export {
    return Scale(58)
}

app_content_top_reserved :: (app: const InnerBreeze*) -> int #export {
    if app != nil && app->breathing.screen == ScreenStart {
        tabs := (TabBarProps){0}
        return GetNodeHeight(NodeTabBar(tabs))
    }
    return app_toolbar_height()
}
