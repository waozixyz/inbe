#module "app.lifecycle"

#import "app.h"
#import "app/app_route_url.h" #private
#import "practices/whm/whm_session.h" #private
#import <stdlib.h> #private
#import <string.h> #private

static global_app: InnerBreeze* = nil

get_global_app :: () -> InnerBreeze* #export {
    return global_app
}

set_global_app :: (app: InnerBreeze*) #export {
    global_app = app
    TraceLog(LOG_INFO, "APP: Global app pointer set to %p", app)
}

CreateApp :: (project_path: const char*) -> void* #export {
    app := (InnerBreeze*)calloc(1, sizeof(InnerBreeze))
    if app == nil { return nil }
    if project_path != nil && project_path[0] != '\0' {
        ChangeDirectory(project_path)
    }
    app_init(app)
    set_global_app(app)
    return app
}

DestroyApp :: (value: void*) #export {
    app := (InnerBreeze*)value
    if app == nil { return }
    app_destroy(app)
    free(app)
    set_global_app(nil)
}

ApplyRoute :: (value: void*, route_info: const AppRouteInfo*) #export {
    app := (InnerBreeze*)value
    if app == nil || route_info == nil || route_info->id == nil { return }
    if strcmp(route_info->id, "session") == 0 {
        session_start(app)
        return
    }
    screen := screen_for_route_id(route_info->id)
    if screen < 0 { return }
    route := app_current_route(app)
    route.screen = screen
    app_switch_route(app, route)
}

BeginScreenDraw :: (value: void*, viewport: Rectangle) #export {
    unused value
    view_width = (int)viewport.width
    view_height = (int)viewport.height
}
