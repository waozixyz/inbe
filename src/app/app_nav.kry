#import "app/app.h"
#import "app_nav.h"

#import "ui_app_shell_props.generated.h" #private
#import "storage.h" #private
#import "sync_account.h" #private
#import "screens/settings/settings_screen.h" #private
#import <stdio.h>
#import <string.h>

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB

#enum {
    APP_BOTTOM_NAV_CONFIGURABLE_COUNT = 5
    APP_NAV_CONFIG_ACTION_NONE,
    APP_NAV_CONFIG_ACTION_MOVE,
    APP_NAV_CONFIG_ACTION_REMOVE,
    APP_NAV_CONFIG_ACTION_ADD,
    APP_NAV_CONFIG_ACTION_SET
}

app_nav_mark_int_used :: (value: int) #private {
    if value == 0 {
        return
    }
}

app_active_practice_title_height :: () -> int {
    min_height := Scale(76)
    title_height := AppTitleBarHeight()

    return title_height > min_height ? title_height : min_height
}

app_draw_active_practice_title_bar :: (app: InnerBreeze*, title: const char*, height: int) -> int {

    button_size := Scale(24)
    padding := Scale(10)
    button_total := button_size + padding * 2
    content_x := app_nav_desktop_rail_enabled(app) ? app_nav_desktop_rail_width(app) : 0
    content_w := view_width - content_x
    close_x := view_width - button_total - Scale(12)
    close_y := (height - button_total) / 2
    side_reserved := view_width - close_x + Scale(8)
    left_reserved := Scale(112)
    title_area_x: int
    title_area_w: int
    font := Text32
    max_w := content_w - side_reserved * 2
    title_w: int

    if title == NULL {
        title = ""
    }
    if height < app_active_practice_title_height() {
        height = app_active_practice_title_height()
    }
    if close_y < 0 {
        close_y = 0
    }
    if content_w < Scale(120) {
        content_w = view_width
        content_x = 0
    }
    if max_w < Scale(80) {
        max_w = content_w - Scale(24)
    }
    title_area_x = content_x + left_reserved
    title_area_w = view_width - title_area_x - side_reserved
    if max_w > title_area_w - Scale(24) {
        max_w = title_area_w - Scale(24)
    }

    title_w = AppTextWidth(title, font)
    while font > AppFontSize() && title_w > max_w {
        font--
        title_w = AppTextWidth(title, font)
    }

    TitleBar((TitleBarProps){.title = "", .height = height})
    Text((TextProps){
        .text = title,
        .bounds = {(float)(title_area_x + (title_area_w - title_w) / 2), (float)((height - AppTextLineHeight(font)) / 2), 0, 0},
        .font = font,
        .wrap = TextWrapNone
    })
    if app != NULL && !app->modal.active &&
       Button((ButtonProps){
           .id = 0,
           .bounds = {(float)(close_x), (float)(close_y),
                      (float)((button_size) + (padding) * 2),
                      (float)((button_size) + (padding) * 2)},
           .icon_type = ICON_X, .icon_only = 1,
           .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
       }) {
        return 1
    }
    return 0
}

app_nav_desktop_rail_width :: (app: const InnerBreeze*) -> int {
    return Scale(app != NULL && app->nav_rail_collapsed ? 88 : 224)
}

app_capture_navigation_viewport :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    app->navigation_view_width = view_width
    app->navigation_view_height = view_height
    app->navigation_desktop_mode = IsDesktopMode()
}

app_navigation_desktop_mode :: (app: const InnerBreeze*) -> int #private {
    if app != NULL && app->navigation_view_height > 0 {
        return app->navigation_desktop_mode
    }
    return IsDesktopMode()
}

app_navigation_placement :: (app: const InnerBreeze*) -> int {
    if app != NULL && app->navigation_placement >= NAVIGATION_LEFT &&
       app->navigation_placement <= NAVIGATION_TOP {
        return app->navigation_placement
    }
    #if DESKTOP {
        return app_navigation_desktop_mode(app) ? NAVIGATION_LEFT : NAVIGATION_BOTTOM
    } #else {
        return NAVIGATION_BOTTOM
    }
}

app_nav_desktop_rail_enabled :: (app: const InnerBreeze*) -> int {
    placement := app_navigation_placement(app)
    full_height := app != NULL && app->navigation_view_height > 0 ? app->navigation_view_height : view_height
    if app == NULL || (placement != NAVIGATION_LEFT && placement != NAVIGATION_RIGHT) ||
       full_height < Scale(476) {
        return 0
    }
    if app->file_dialog_active {
        return 0
    }
    if app->modal.active && app->modal.type == UIModalEditProgressiveStartSpeed {
        return 0
    }
    if app->breathing.screen == ScreenHabitSessionEdit ||
       app->breathing.screen == ScreenSession ||
       app->breathing.screen == ScreenMeditation ||
       app->breathing.screen == ScreenSunSalutation ||
       app->breathing.screen == ScreenPatterns ||
       app->breathing.screen == ScreenResults {
        return 0
    }
    return app->breathing.screen == ScreenStart ||
           app->breathing.screen == ScreenHabits ||
           app->breathing.screen == ScreenHabitEdit ||
           app->breathing.screen == ScreenEList ||
           app->breathing.screen == ScreenProfile ||
           app->breathing.screen == ScreenSettings
}

app_bottom_nav_configurable_route :: (route: int) -> int #private {
    return route == APP_NAV_ROUTE_HABITS ||
           route == APP_NAV_ROUTE_ELIST ||
           route == APP_NAV_ROUTE_PRACTICE ||
           route == APP_NAV_ROUTE_PROFILE ||
           route == APP_NAV_ROUTE_SETTINGS
}

app_nav_bottom_profile_enabled :: (app: const InnerBreeze*) -> int #private {
    #if DESKTOP {
        return app_navigation_desktop_mode(app)
    } #else {
        return 0
    }
}

app_main_tab_route :: (main_tab: int) -> int #private {
    if main_tab == APP_MAIN_TAB_HABITS {
        return APP_NAV_ROUTE_HABITS
    }
    if main_tab == APP_MAIN_TAB_PRACTICE {
        return APP_NAV_ROUTE_PRACTICE
    }
    if main_tab == APP_MAIN_TAB_ELIST {
        return APP_NAV_ROUTE_ELIST
    }
    return APP_NAV_ROUTE_NONE
}

app_main_tab_for_route :: (route: int) -> int #private {
    if route == APP_NAV_ROUTE_HABITS {
        return APP_MAIN_TAB_HABITS
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_ELIST {
        return APP_MAIN_TAB_ELIST
    }
    return APP_MAIN_TAB_NONE
}

app_bottom_nav_has_route :: (app: const InnerBreeze*, route: int) -> int #private {
    if app == NULL || route == APP_NAV_ROUTE_NONE {
        return 0
    }
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        if app->bottom_nav_routes[i] == route {
            return 1
        }
    }
    return 0
}

app_screen_for_main_tab :: (main_tab: int) -> int {
    if main_tab == APP_MAIN_TAB_HABITS {
        return ScreenHabits
    }
    if main_tab == APP_MAIN_TAB_ELIST {
        return ScreenEList
    }
    return ScreenStart
}

app_reset_bottom_nav_routes :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    app->bottom_nav_routes[0] = APP_NAV_ROUTE_ELIST
    app->bottom_nav_routes[1] = APP_NAV_ROUTE_HABITS
    app->bottom_nav_routes[2] = APP_NAV_ROUTE_PRACTICE
    app->bottom_nav_routes[3] = APP_NAV_ROUTE_SETTINGS
    app->bottom_nav_route_count = 4
}

app_reset_bottom_nav_routes_for_layout_version :: (app: InnerBreeze*, layout_version: int) -> int {
    if app == NULL || layout_version >= 2 {
        return 0
    }
    app_reset_bottom_nav_routes(app)
    return 1
}

app_migrate_legacy_bottom_nav_routes :: (app: InnerBreeze*) -> int {
    if app == NULL {
        return 0
    }
    // Earlier releases saved these default orders before Lists became first.
    if app->bottom_nav_route_count == 4 &&
       app->bottom_nav_routes[0] == APP_NAV_ROUTE_HABITS &&
       ((app->bottom_nav_routes[1] == APP_NAV_ROUTE_PRACTICE &&
         app->bottom_nav_routes[2] == APP_NAV_ROUTE_SETTINGS &&
         app->bottom_nav_routes[3] == APP_NAV_ROUTE_ELIST) ||
        (app->bottom_nav_routes[1] == APP_NAV_ROUTE_ELIST &&
         app->bottom_nav_routes[2] == APP_NAV_ROUTE_PRACTICE &&
         app->bottom_nav_routes[3] == APP_NAV_ROUTE_SETTINGS)) {
        app_reset_bottom_nav_routes(app)
        return 1
    }
    return 0
}

app_sanitize_bottom_nav_routes :: (app: InnerBreeze*) {
    allowed: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] int
    allowed_count := 0

    if app == NULL {
        return
    }
    allowed[allowed_count] = APP_NAV_ROUTE_HABITS
    allowed_count += 1
    allowed[allowed_count] = APP_NAV_ROUTE_ELIST
    allowed_count += 1
    allowed[allowed_count] = APP_NAV_ROUTE_PRACTICE
    allowed_count += 1
    if app_nav_bottom_profile_enabled(app) {
        allowed[allowed_count] = APP_NAV_ROUTE_PROFILE
        allowed_count += 1
    }
    allowed[allowed_count] = APP_NAV_ROUTE_SETTINGS
    allowed_count += 1
    if app->bottom_nav_route_count < 0 ||
       app->bottom_nav_route_count > APP_BOTTOM_NAV_CONTENT_MAX {
        app_reset_bottom_nav_routes(app)
        return
    }
    app->bottom_nav_route_count =
        KryRouteListSanitizeSet((KryRouteList){
            .routes = app->bottom_nav_routes,
            .count = app->bottom_nav_route_count,
            .capacity = APP_BOTTOM_NAV_CONTENT_MAX,
            .empty_route = APP_NAV_ROUTE_NONE
        }, allowed, allowed_count)
    if !KryRouteListContains(app->bottom_nav_routes,
                             app->bottom_nav_route_count,
                             APP_NAV_ROUTE_SETTINGS) &&
       app->bottom_nav_route_count < APP_BOTTOM_NAV_CONTENT_MAX {
        app->bottom_nav_routes[app->bottom_nav_route_count] = APP_NAV_ROUTE_SETTINGS
        app->bottom_nav_route_count += 1
    }
}

app_reconcile_bottom_nav_selection :: (app: InnerBreeze*) #private {
    selected_route: int

    if app == NULL {
        return
    }
    app_sanitize_bottom_nav_routes(app)
    if app->bottom_nav_route_count <= 0 {
        app->main_tab = APP_MAIN_TAB_NONE
        return
    }

    selected_route = app_main_tab_route(app->main_tab)
    if !app_bottom_nav_has_route(app, selected_route) {
        app->main_tab = app_main_tab_for_route(app->bottom_nav_routes[0])
    }
}

app_leave_habit_child_route :: (app: InnerBreeze*) #private {
    if app == NULL {
        return
    }
    if app->habit_edit.active || app->breathing.screen == ScreenHabitEdit {
        app->habit_edit = (HabitEditState){
            .index = -1,
            .color = {99, 196, 165, 255},
            .sync_mode = HABIT_SYNC_NONE
        }
    }
    if app->habit_session_edit.active ||
       app->breathing.screen == ScreenHabitSessionEdit {
        app->habit_session_edit = (HabitSessionEditState){.round = -1}
    }
    app->habit_detail_index = -1
    app->habit_detail_day = 0
    app->habit_detail_session_path[0] = '\0'
    app->habit_counter_press_day = 0
    app->habit_counter_press_index = -1
    app->habit_counter_press_frames = 0
    app->habit_counter_press_long_done = 0
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = -1
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    app->habits.scroll = 0
}

app_open_main_tab :: (app: InnerBreeze*, main_tab: int, persist: int) #private {
    if app == NULL {
        return
    }

    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    app_leave_habit_child_route(app)
    if main_tab == APP_MAIN_TAB_NONE {
        route := app_current_route(app)
        app->main_tab = APP_MAIN_TAB_NONE
        route.screen = ScreenStart
        app_request_route(app, route)
        if persist {
            save_settings(app)
        }
        return
    }

    app->main_tab = clampi(main_tab, APP_MAIN_TAB_HABITS, APP_MAIN_TAB_ELIST)
    if app->main_tab == APP_MAIN_TAB_PRACTICE {
        app->practice_tab = PRACTICE_TAB_PLAY
    }
    route := app_current_route(app)
    route.screen = app_screen_for_main_tab(app->main_tab)
    app_request_route(app, route)
    if persist {
        save_settings(app)
    }
}

app_open_profile_tab :: (app: InnerBreeze*, tab: int) #private {
    route: AppRoute

    if app == NULL {
        return
    }
    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    app_leave_habit_child_route(app)
    app->profile_return_to_settings = app->breathing.screen == ScreenSettings
    app->profile_view = PROFILE_VIEW_MAIN
    app->profile_scroll = 0
    app->sync_server_url_focused = 0
    settings_screen_clear_status()
    route = app_current_route(app)
    route.screen = ScreenProfile
    route.profile_view = PROFILE_VIEW_MAIN
    route.profile_tab = clampi(tab, PROFILE_TAB_OVERVIEW, PROFILE_TAB_COUNT - 1)
    app_request_route(app, route)
}

app_apply_nav_route :: (app: InnerBreeze*, route: int) {

    if app == NULL {
        return
    }

    if route == APP_NAV_ROUTE_PROFILE {
        app_open_profile_tab(app, PROFILE_TAB_OVERVIEW)
    } else if route == APP_NAV_ROUTE_ACCOUNT {
        app_open_profile_tab(app, PROFILE_TAB_SYNC)
    } else if route == APP_NAV_ROUTE_DATA {
        app_open_profile_tab(app, PROFILE_TAB_DATA)
    } else if route == APP_NAV_ROUTE_FRIENDS {
        app_open_profile_tab(app, PROFILE_TAB_FRIENDS)
    } else if route == APP_NAV_ROUTE_LEADERBOARD {
        app_open_profile_tab(app, PROFILE_TAB_LEADERBOARD)
    } else if route == APP_NAV_ROUTE_PRACTICE {
        app_open_main_tab(app, APP_MAIN_TAB_PRACTICE, 1)
    } else if route == APP_NAV_ROUTE_HABITS {
        app_open_main_tab(app, APP_MAIN_TAB_HABITS, 1)
    } else if route == APP_NAV_ROUTE_ELIST {
        app_open_main_tab(app, APP_MAIN_TAB_ELIST, 1)
    } else if route == APP_NAV_ROUTE_SETTINGS {
        app_open_settings(app)
    }
}

app_is_practice_fullscreen_subview :: (app: const InnerBreeze*) -> int #private {
    return app != NULL &&
           app->breathing.screen == ScreenStart &&
           (app->practice_tab == PRACTICE_TAB_MANUAL ||
            app->practice_tab == PRACTICE_TAB_CONFIG)
}

app_is_blank_home :: (app: const InnerBreeze*) -> int #private {
    return app != NULL &&
           app->breathing.screen == ScreenStart &&
           app->main_tab == APP_MAIN_TAB_NONE
}

app_navigation_height :: (app: const InnerBreeze*) -> int {
    if app == NULL {
        return 0
    }
    if app_nav_desktop_rail_enabled(app) {
        return 0
    }
    if app->breathing.screen == ScreenHabitEdit {
        return 0
    }
    if app_is_practice_fullscreen_subview(app) {
        return 0
    }
    if app_current_nav_route(app) == APP_NAV_ROUTE_NONE &&
       !app_is_blank_home(app) {
        return 0
    }
    # Matches the Material NavigationBar height drawn by app_draw_bottom_nav.
    return Scale(86)
}

app_content_bottom_reserved :: (app: const InnerBreeze*) -> int {
    return app_navigation_placement(app) == NAVIGATION_TOP ? 0 : app_navigation_height(app)
}

app_content_left_reserved :: (app: const InnerBreeze*) -> int {
    unused app
    return 0
}

app_page_height :: (app: const InnerBreeze*, full_height: int) -> int {
    bottom_reserved: int

    if full_height <= 0 {
        return 0
    }
    bottom_reserved = app_fullscreen_bottom_reserved(app)
    if bottom_reserved > 0 && bottom_reserved < full_height {
        return full_height - bottom_reserved
    }
    return full_height
}

app_nav_route_label :: (route: int) -> const char* {
    if route == APP_NAV_ROUTE_PROFILE {
        return GetLocaleText("tab_profile")
    }
    if route == APP_NAV_ROUTE_ACCOUNT {
        return GetLocaleText("sync_account_title")
    }
    if route == APP_NAV_ROUTE_DATA {
        return GetLocaleText("profile_data")
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return GetLocaleText("profile_friends_title")
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return GetLocaleText("profile_leaderboard_title")
    }
    if route == APP_NAV_ROUTE_HABITS {
        return GetLocaleText("tab_habits")
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return GetLocaleText("tab_practice")
    }
    if route == APP_NAV_ROUTE_ELIST {
        return GetLocaleText("tab_elist")
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return GetLocaleText("settings_title")
    }
    return ""
}

app_current_nav_route :: (app: const InnerBreeze*) -> int {
    if app == NULL {
        return APP_NAV_ROUTE_NONE
    }
    if app->breathing.screen == ScreenProfile {
        return APP_NAV_ROUTE_PROFILE
    }
    if app->breathing.screen == ScreenSettings {
        return APP_NAV_ROUTE_SETTINGS
    }
    if app->breathing.screen == ScreenStart {
        if app_is_practice_fullscreen_subview(app) {
            return APP_NAV_ROUTE_NONE
        }
        if app->main_tab == APP_MAIN_TAB_NONE {
            return APP_NAV_ROUTE_NONE
        }
        return APP_NAV_ROUTE_PRACTICE
    }
    if app->breathing.screen == ScreenHabits {
        return APP_NAV_ROUTE_HABITS
    }
    if app->breathing.screen == ScreenEList {
        return APP_NAV_ROUTE_ELIST
    }
    return APP_NAV_ROUTE_NONE
}

app_fullscreen_bottom_reserved :: (app: const InnerBreeze*) -> int {
    unused app
    return 0
}

app_open_settings :: (app: InnerBreeze*) #private {
    route: AppRoute

    if app == NULL {
        return
    }
    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    app_leave_habit_child_route(app)
    app->settings_scroll = 0
    settings_screen_clear_status()
    route = app_current_route(app)
    route.screen = ScreenSettings
    route.settings_overview = !app_settings_wide_layout(app)
    app_request_route(app, route)
}

app_compact_public_id :: (public_id: const char*, out: char*, out_size: size_t) #private {
    len: size_t

    if out == NULL || out_size == 0 {
        return
    }
    out[0] = '\0'
    if public_id == NULL {
        return
    }
    len = strlen(public_id)
    if len <= 12 {
        snprintf(out, out_size, "%s", public_id)
        return
    }
    snprintf(out, out_size, "%.*s...%.*s", 4, public_id, 4, public_id + len - 4)
}

app_alias_display_name :: (alias: const char*, out: char*, out_size: size_t) #private {
    if out == NULL || out_size == 0 {
        return
    }
    out[0] = '\0'
    if alias == NULL || alias[0] == '\0' {
        return
    }
    snprintf(out, out_size, "%s", alias)
    if out[0] >= 'a' && out[0] <= 'z' {
        out[0] = out[0] - 'a' + 'A'
    }
}

app_nav_profile_identity :: (app: InnerBreeze*, out: char*, out_size: size_t,
                             subtitle: char*, subtitle_size: size_t) {
    account: SyncAccount
    alias: const char*

    if out == NULL || out_size == 0 {
        return
    }
    if subtitle != NULL && subtitle_size > 0 {
        subtitle[0] = '\0'
    }
    if app != NULL && app->profile_display_name[0] != '\0' {
        snprintf(out, out_size, "%s", app->profile_display_name)
        if sync_account_load(&account) {
            alias = storage_get_setting_text("sync_account_alias")
            if alias != NULL && alias[0] != '\0' && subtitle != NULL && subtitle_size > 0 {
                snprintf(subtitle, subtitle_size, "@%s", alias)
            }
        }
        return
    }
    if !sync_account_load(&account) {
        snprintf(out, out_size, "%s", GetLocaleText("tab_profile"))
        return
    }
    alias = storage_get_setting_text("sync_account_alias")
    if alias != NULL && alias[0] != '\0' {
        app_alias_display_name(alias, out, out_size)
        if subtitle != NULL && subtitle_size > 0 {
            snprintf(subtitle, subtitle_size, "@%s", alias)
        }
        return
    }
    app_compact_public_id(account.public_id, out, out_size)
    if subtitle != NULL && subtitle_size > 0 {
        snprintf(subtitle, subtitle_size, "%s", GetLocaleText("tab_profile"))
    }
}

app_open_customize_nav :: (app: InnerBreeze*) {

    if app == NULL {
        return
    }
    app_sanitize_bottom_nav_routes(app)
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        app->bottom_nav_config_routes[i] = app->bottom_nav_routes[i]
    }
    app->bottom_nav_config_route_count = app->bottom_nav_route_count
    route := app_current_route(app)
    route.screen = ScreenCustomizeNav
    app_request_route(app, route)
}

app_nav_option_index :: (app: const InnerBreeze*, route: int) -> int #private {
    if route == APP_NAV_ROUTE_ELIST {
        return 0
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return 2
    }
    if route == APP_NAV_ROUTE_HABITS {
        return 1
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        if app_nav_bottom_profile_enabled(app) {
            return 4
        }
        return 3
    }
    if app_nav_bottom_profile_enabled(app) && route == APP_NAV_ROUTE_PROFILE {
        return 3
    }
    return 0
}

app_nav_config_option_count :: (app: const InnerBreeze*) -> int #private {
    if app_nav_bottom_profile_enabled(app) {
        return APP_BOTTOM_NAV_CONFIGURABLE_COUNT
    }
        return 4
}

app_nav_route_for_option :: (app: const InnerBreeze*, option: int) -> int #private {
    routes: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] int
    count := app_nav_config_option_count(app)

    routes[0] = APP_NAV_ROUTE_ELIST
    routes[1] = APP_NAV_ROUTE_HABITS
    routes[2] = APP_NAV_ROUTE_PRACTICE
    if app_nav_bottom_profile_enabled(app) {
        routes[3] = APP_NAV_ROUTE_PROFILE
        routes[4] = APP_NAV_ROUTE_SETTINGS
    } else {
        routes[3] = APP_NAV_ROUTE_SETTINGS
    }

    if option < 0 || option >= count {
        return APP_NAV_ROUTE_HABITS
    }
    return routes[option]
}

app_save_bottom_nav_config :: (app: InnerBreeze*) #private {
    if app == NULL {
        return
    }
    app->bottom_nav_route_count = app->bottom_nav_config_route_count
    for int i = 0; i < APP_BOTTOM_NAV_CONTENT_MAX; i++ {
        app->bottom_nav_routes[i] = i < app->bottom_nav_route_count
                                        ? app->bottom_nav_config_routes[i]
                                        : APP_NAV_ROUTE_NONE
    }
    app_reconcile_bottom_nav_selection(app)
    save_settings(app)
}

app_move_bottom_nav_config_route :: (app: InnerBreeze*, from_index: int,
                                    to_index: int) -> int #private {
    if app == NULL {
        return 0
    }
    return KryRouteListMove((KryRouteList){
        .routes = app->bottom_nav_config_routes,
        .count = app->bottom_nav_config_route_count,
        .capacity = APP_BOTTOM_NAV_CONTENT_MAX,
        .empty_route = APP_NAV_ROUTE_NONE
    }, from_index, to_index)
}

app_first_unused_bottom_nav_route :: (app: const InnerBreeze*) -> int #private {
    routes: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] int
    count := app_nav_config_option_count(app)

    routes[0] = APP_NAV_ROUTE_ELIST
    routes[1] = APP_NAV_ROUTE_HABITS
    routes[2] = APP_NAV_ROUTE_PRACTICE
    if app_nav_bottom_profile_enabled(app) {
        routes[3] = APP_NAV_ROUTE_PROFILE
        routes[4] = APP_NAV_ROUTE_SETTINGS
    } else {
        routes[3] = APP_NAV_ROUTE_SETTINGS
    }

    return KryRouteListFirstUnused(app != NULL ? app->bottom_nav_config_routes : nil,
                                   app != NULL ? app->bottom_nav_config_route_count : 0,
                                   routes, count,
                                   APP_NAV_ROUTE_HABITS)
}

app_customize_nav_scaffold_title :: (title: const char*, height: int,
                                     user_data: void*) -> int #private {
    app := (InnerBreeze*)user_data

    if app == nil || app->modal.active {
        TitleBar((TitleBarProps){.title = title, .height = height})
        return 0
    }
    if TitleBar((TitleBarProps){.title = title, .height = height,
                                .has_leading_action = 1}) {
        app_block_current_click(app)
        app_open_main_tab(app, app->main_tab, 0)
        return 1
    }
    return 0
}

app_draw_customize_nav_page :: (app: InnerBreeze*) -> int {
    options: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] const char*
    reorder_items: [APP_BOTTOM_NAV_CONTENT_MAX] ReorderItem
    reorder: ReorderListResult
    selected: [APP_BOTTOM_NAV_CONTENT_MAX] int
    row_y: [APP_BOTTOM_NAV_CONTENT_MAX] int
    y: int
    changed := 0
    button_h := Scale(36)
    row_h := Scale(64)
    handle_w := Scale(40)
    draw_count: int
    action := APP_NAV_CONFIG_ACTION_NONE
    action_index := -1
    action_to_index := -1
    action_route := APP_NAV_ROUTE_NONE
    option_count := app_nav_config_option_count(app)
    side_padding := GetPageSidePadding()
    max_content_w := Scale(CONTENT_MAX_W)
    content_x := 0
    content_w := 0
    content_h: int
    viewport_h: int
    title_h := AppTitleBarHeight()
    top_gap := Scale(18)

    if app == NULL {
        return 0
    }
    if app->bottom_nav_config_route_count < 0 ||
       app->bottom_nav_config_route_count > APP_BOTTOM_NAV_CONTENT_MAX {
        app_sanitize_bottom_nav_routes(app)
        for int i = 0; i < app->bottom_nav_route_count; i++ {
            app->bottom_nav_config_routes[i] = app->bottom_nav_routes[i]
        }
        app->bottom_nav_config_route_count = app->bottom_nav_route_count
    }
    draw_count = app->bottom_nav_config_route_count

    options[0] = app_nav_route_label(APP_NAV_ROUTE_ELIST)
    options[1] = app_nav_route_label(APP_NAV_ROUTE_HABITS)
    options[2] = app_nav_route_label(APP_NAV_ROUTE_PRACTICE)
    if app_nav_bottom_profile_enabled(app) {
        options[3] = app_nav_route_label(APP_NAV_ROUTE_PROFILE)
        options[4] = app_nav_route_label(APP_NAV_ROUTE_SETTINGS)
    } else {
        options[3] = app_nav_route_label(APP_NAV_ROUTE_SETTINGS)
    }

    if app_customize_nav_scaffold_title(GetLocaleText("customize_nav_title"),
                                        title_h, app) {
        return 1
    }

    if max_content_w > view_width - side_padding * 2 {
        max_content_w = view_width - side_padding * 2
    }
    if max_content_w < Scale(300) {
        max_content_w = Scale(300)
    }
    GetCenteredColumn(max_content_w, side_padding, &content_x, &content_w)
    content_h = draw_count * row_h
    if draw_count < option_count {
        content_h += button_h + Scale(14)
    }
    content_h += Scale(24)
    viewport_h = view_height - title_h - top_gap - app_content_bottom_reserved(app)
    if viewport_h < 0 {
        viewport_h = 0
    }

    Scroll page: {
        bounds = (Rectangle){(float)0, (float)(title_h + top_gap),
                             (float)view_width, (float)viewport_h}
        content_height = content_h
        scroll_offset = &app->navigation_config_scroll

        list_y := (int)page.y
        y = list_y

        for int i = 0; i < APP_BOTTOM_NAV_CONTENT_MAX; i++ {
            selected[i] = app_nav_option_index(app, app->bottom_nav_config_routes[i])
        }

        for int i = 0; i < draw_count; i++ {
            row_y[i] = list_y + i * row_h
            reorder_items[i] = (ReorderItem){
                .id = app->bottom_nav_config_routes[i] * 100 + i + 1,
                .bounds = {(float)content_x, (float)row_y[i],
                           (float)content_w, (float)row_h},
                .disabled = 0
            }
        }

        reorder = UpdateReorderList((ReorderList){
            .id = 701,
            .bounds = {(float)content_x, (float)list_y,
                       (float)content_w,
                       (float)(row_h * draw_count)},
            .items = reorder_items,
            .item_count = draw_count,
            .handle_width = handle_w,
            .scroll_offset = &app->navigation_config_scroll,
            .max_scroll = content_h > viewport_h ? content_h - viewport_h : 0,
            .viewport_top = title_h + top_gap,
            .viewport_bottom = title_h + top_gap + viewport_h
        })
        if reorder.committed {
            action = APP_NAV_CONFIG_ACTION_MOVE
            action_index = reorder.from_index
            action_to_index = reorder.to_index
        }

        for int i = 0; i < draw_count; i++ {
            icon_w := Scale(36)
            icon_gap := Scale(8)
            dropdown_x := content_x + handle_w
            trash_x := content_x + content_w - icon_w
            dropdown_w := trash_x - icon_gap - dropdown_x
            dropdown_y := row_y[i] + (row_h - button_h) / 2

            if dropdown_w < Scale(48) {
                dropdown_w = Scale(48)
            }

            if reorder.dragging && i == reorder.active_index {
                continue
            }

            AppReorderHandle(content_x, row_y[i], handle_w, row_h,
                                reorder.active && i == reorder.active_index)
            if Dropdown((DropdownProps){.id = 740 + i,
                                    .bounds = {dropdown_x, dropdown_y, dropdown_w, button_h},
                                    .options = options, .option_count = option_count,
                                    .selected_index = &selected[i]}) &&
               action == APP_NAV_CONFIG_ACTION_NONE {
                action = APP_NAV_CONFIG_ACTION_SET
                action_index = i
                action_route = app_nav_route_for_option(app, selected[i])
            }
            if Button((ButtonProps){
                .id = 0,
                .bounds = {(float)(trash_x), (float)(dropdown_y - Scale(2)),
                           (float)((Scale(20)) + (Scale(8)) * 2),
                           (float)((Scale(20)) + (Scale(8)) * 2)},
                .icon_type = ICON_TRASH, .icon_only = 1,
                .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
            }) &&
               action == APP_NAV_CONFIG_ACTION_NONE {
                action = APP_NAV_CONFIG_ACTION_REMOVE
                action_index = i
            }
        }
        if reorder.dragging && reorder.target_index >= 0 &&
           reorder.target_index < draw_count {
            AppReorderPlaceholder(reorder_items[reorder.target_index].bounds)
        }
        if reorder.dragging && reorder.active_index >= 0 &&
           reorder.active_index < draw_count {
            i := reorder.active_index
            icon_w := Scale(36)
            icon_gap := Scale(8)
            dropdown_x := content_x + handle_w
            trash_x := content_x + content_w - icon_w
            dropdown_w := trash_x - icon_gap - dropdown_x
            overlay_y := row_y[i] + reorder.drag_delta_y
            dropdown_y := overlay_y + (row_h - button_h) / 2

            if dropdown_w < Scale(48) {
                dropdown_w = Scale(48)
            }
            DrawRectangle(content_x, overlay_y, content_w, row_h,
                             LightenColor(GetThemeBackground(), 8))
            AppReorderHandle(content_x, overlay_y, handle_w, row_h, 1)
            Dropdown((DropdownProps){.id = 740 + i,
                                    .bounds = {dropdown_x, dropdown_y, dropdown_w, button_h},
                                    .options = options, .option_count = option_count,
                                    .selected_index = &selected[i]})
            Icon(0, trash_x + Scale(8), dropdown_y + Scale(6),
                 Scale(20), ICON_TRASH, GetThemeIcon())
        }

        y += row_h * draw_count

        if draw_count < option_count {

            if Button((ButtonProps){
                .bounds = {(float)(content_x), (float)(y), (float)(content_w), (float)(button_h)},
                .label = GetLocaleText("customize_nav_add"),
                .tone = ButtonToneNeutral,
                .emphasis = ButtonEmphasisSoft,
                .disabled = 0
            }) &&
               action == APP_NAV_CONFIG_ACTION_NONE {
                action = APP_NAV_CONFIG_ACTION_ADD
            }
            y += button_h + Scale(14)
        }

    }

    if action == APP_NAV_CONFIG_ACTION_MOVE {
        changed = app_move_bottom_nav_config_route(app, action_index,
                                                   action_to_index)
    } else if action == APP_NAV_CONFIG_ACTION_REMOVE {
        if action_index >= 0 &&
           action_index < app->bottom_nav_config_route_count {
            for int j = action_index; j < app->bottom_nav_config_route_count - 1; j++ {
                app->bottom_nav_config_routes[j] =
                    app->bottom_nav_config_routes[j + 1]
            }
            app->bottom_nav_config_route_count--
            changed = 1
        }
    } else if action == APP_NAV_CONFIG_ACTION_ADD {
        if app->bottom_nav_config_route_count < option_count {
            app->bottom_nav_config_routes[app->bottom_nav_config_route_count++] =
                app_first_unused_bottom_nav_route(app)
            changed = 1
        }
    } else if action == APP_NAV_CONFIG_ACTION_SET {
        if action_index >= 0 && action_index < app->bottom_nav_config_route_count {
            old_route := app->bottom_nav_config_routes[action_index]
            if action_route != old_route {
                for int j = 0; j < app->bottom_nav_config_route_count; j++ {
                    if j != action_index && app->bottom_nav_config_routes[j] == action_route {
                        app->bottom_nav_config_routes[j] = old_route
                        break
                    }
                }
            }
            app->bottom_nav_config_routes[action_index] = action_route
            changed = 1
        }
    }

    if changed {
        app_save_bottom_nav_config(app)
    }

    return 0
}

app_settings_back :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    if app->settings_dirty {
        save_settings(app)
    }
    settings_screen_clear_status()
    app->settings_scroll = 0
    route := app_current_route(app)
    if !app_settings_wide_layout(app) && !app->settings_overview {
        route.settings_overview = 1
    } else {
        route.screen = app_screen_for_main_tab(app->main_tab)
    }
    app_switch_route(app, route)
}

app_settings_wide_layout :: (app: const InnerBreeze*) -> int {
    #if DESKTOP {
        width := app != NULL && app->navigation_view_width > 0 ? app->navigation_view_width : view_width
        height := app != NULL && app->navigation_view_height > 0 ? app->navigation_view_height : view_height
        if app_nav_desktop_rail_enabled(app) {
            width -= app_nav_desktop_rail_width(app)
        }
        return width >= Scale(688) && height >= Scale(476)
    } #else {
        unused app
        return 0
    }
}
