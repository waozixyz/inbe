#import "app.h"
#import "app_nav.h"

#import "storage.h" #private
#import "sync_account.h" #private
#import "screens/profile_social.h" #private
#import "screens/settings/settings_screen.h" #private
#import <stdio.h>

#enum {
    APP_BOTTOM_NAV_CONFIGURABLE_COUNT = 2
    APP_NAV_CONFIG_ACTION_NONE,
    APP_NAV_CONFIG_ACTION_MOVE,
    APP_NAV_CONFIG_ACTION_REMOVE,
    APP_NAV_CONFIG_ACTION_ADD,
    APP_NAV_CONFIG_ACTION_SET
}

AppSidebarRouteItem :: struct {
    label_key: const char*
    route: int
}

AppSidebarSettingsItem :: struct {
    tab: int
}

static android_bottom_nav_height: int = 0

app_nav_mark_int_used :: (value: int) #private {
    if value == 0 {
        return
    }
}

app_nav_sidebar_width :: () -> int #private {
    sidebar_w: int

    if view_width <= ScaleUIPx(480) {
        return view_width
    }
    sidebar_w = ScaleUIPx(292)
    if sidebar_w > view_width - ScaleUIPx(36) {
        sidebar_w = view_width - ScaleUIPx(36)
    }
    if sidebar_w < ScaleUIPx(220) {
        sidebar_w = view_width
    }
    return sidebar_w
}

app_nav_sidebar_compact :: () -> int #private {
    return view_width <= ScaleUIPx(480)
}

app_nav_sidebar_screen_active :: (app: const InbeApp*) -> int #private {
    return app != NULL && app->inbe.screen == InbeScreenNavSidebar
}

app_bottom_nav_configurable_route :: (route: int) -> int #private {
    return route == APP_NAV_ROUTE_HABITS ||
           route == APP_NAV_ROUTE_PRACTICE
}

app_main_tab_route :: (main_tab: int) -> int #private {
    if main_tab == APP_MAIN_TAB_HABITS {
        return APP_NAV_ROUTE_HABITS
    }
    if main_tab == APP_MAIN_TAB_PRACTICE {
        return APP_NAV_ROUTE_PRACTICE
    }
    return APP_NAV_ROUTE_NONE
}

app_main_tab_for_route :: (route: int) -> int #private {
    if route == APP_NAV_ROUTE_HABITS {
        return APP_MAIN_TAB_HABITS
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return APP_MAIN_TAB_PRACTICE
    }
    return APP_MAIN_TAB_NONE
}

app_bottom_nav_has_route :: (app: const InbeApp*, route: int) -> int #private {
    if app == NULL || route == APP_NAV_ROUTE_NONE {
        return 0
    }
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        if app->bottom_nav_routes[i] == route {
            return 1
        }
    }
    return 0
}

app_screen_for_main_tab :: (main_tab: int) -> int #private {
    return main_tab == APP_MAIN_TAB_HABITS ? InbeScreenHabits : InbeScreenStart
}

app_open_nav_sidebar :: (app: InbeApp*) #private {
    if app == NULL || app->modal.active {
        return
    }
    app->nav_sidebar_open = 1
    app->nav_sidebar_open_frame = app->inbe.frame
    app->nav_sidebar_return_on_back = 0
    if app_nav_sidebar_compact() {
        app->nav_sidebar_prior_screen = app->inbe.screen
        app_switch_screen(app, InbeScreenNavSidebar)
    }
}

app_close_nav_sidebar :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    app->nav_sidebar_open = 0
    app->nav_sidebar_return_on_back = 0
    if app_nav_sidebar_screen_active(app) {
        prior := app->nav_sidebar_prior_screen
        if prior > 0 && prior != InbeScreenNavSidebar {
            app_switch_screen(app, prior)
        } else {
            app_switch_screen(app, app_screen_for_main_tab(app->main_tab))
        }
        app_block_pointer_frame(app)
    }
}

app_update_nav_sidebar_mode :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    if app_nav_sidebar_screen_active(app) && !app_nav_sidebar_compact() {
        app->nav_sidebar_open = 1
        app_switch_screen(app, app_screen_for_main_tab(app->main_tab))
    }
}

app_return_to_nav_sidebar_if_needed :: (app: InbeApp*) -> int {
    if app == NULL || !app->nav_sidebar_return_on_back ||
       !app_nav_sidebar_compact() {
        return 0
    }
    app->nav_sidebar_return_on_back = 0
    app_open_nav_sidebar(app)
    app->nav_sidebar_prior_screen = app_screen_for_main_tab(app->main_tab)
    return 1
}

app_reset_bottom_nav_routes :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    app->bottom_nav_routes[0] = APP_NAV_ROUTE_HABITS
    app->bottom_nav_routes[1] = APP_NAV_ROUTE_PRACTICE
    for int i = 2; i < APP_BOTTOM_NAV_CONTENT_MAX; i++ {
        app->bottom_nav_routes[i] = APP_NAV_ROUTE_NONE
    }
    app->bottom_nav_route_count = 2
}

app_sanitize_bottom_nav_routes :: (app: InbeApp*) {
    clean: [APP_BOTTOM_NAV_CONTENT_MAX] int
    clean_count := 0

    if app == NULL {
        return
    }
    if app->bottom_nav_route_count < 0 ||
       app->bottom_nav_route_count > APP_BOTTOM_NAV_CONTENT_MAX {
        app_reset_bottom_nav_routes(app)
        return
    }
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        route := app->bottom_nav_routes[i]
        duplicate := 0

        if !app_bottom_nav_configurable_route(route) {
            continue
        }
        for int j = 0; j < clean_count; j++ {
            if clean[j] == route {
                duplicate = 1
                break
            }
        }
        if duplicate {
            continue
        }
        clean[clean_count++] = route
    }
    for int i = 0; i < clean_count; i++ {
        app->bottom_nav_routes[i] = clean[i]
    }
    app->bottom_nav_route_count = clean_count
}

app_reconcile_bottom_nav_selection :: (app: InbeApp*) #private {
    selected_route: int

    if app == NULL {
        return
    }
    app_sanitize_bottom_nav_routes(app)
    if app->bottom_nav_route_count <= 0 {
        app->main_tab = APP_MAIN_TAB_NONE
        return
    }

    selected_route = app_main_tab_route(app->main_tab)
    if !app_bottom_nav_has_route(app, selected_route) {
        app->main_tab = app_main_tab_for_route(app->bottom_nav_routes[0])
    }
}

app_set_android_bottom_nav_height :: (height: int) {
    android_bottom_nav_height = height > 0 ? height : 0
}

app_android_bottom_nav_height :: () -> int {
    return android_bottom_nav_height
}

app_open_main_tab :: (app: InbeApp*, main_tab: int, persist: int) #private {
    if app == NULL {
        return
    }

    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    if app->inbe.screen == InbeScreenHabits &&
       app->habits.screen_mode == HABITS_SCREEN_REORDER {
        app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
        app->habits.scroll = 0
    }

    if main_tab == APP_MAIN_TAB_NONE {
        app->main_tab = APP_MAIN_TAB_NONE
        app_switch_screen(app, InbeScreenStart)
        if persist {
            save_settings(app)
        }
        return
    }

    app->main_tab = clampi(main_tab, APP_MAIN_TAB_HABITS, APP_MAIN_TAB_PRACTICE)
    if app->main_tab == APP_MAIN_TAB_PRACTICE {
        app->practice_tab = PRACTICE_TAB_PLAY
    }
    app_switch_screen(app, app_screen_for_main_tab(app->main_tab))
    if persist {
        save_settings(app)
    }
}

app_open_profile_tab :: (app: InbeApp*, tab: int) #private {
    route: AppRoute
    return_to_sidebar: int

    if app == NULL {
        return
    }
    return_to_sidebar = app_nav_sidebar_screen_active(app)
    app->nav_sidebar_open = 0
    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    app->profile_view = PROFILE_VIEW_MAIN
    app->profile_scroll = 0
    app->sync_server_url_focused = 0
    settings_screen_clear_status()
    app_block_pointer_frame(app)
    route = app_current_route(app)
    route.screen = InbeScreenProfile
    route.profile_view = PROFILE_VIEW_MAIN
    route.profile_tab = clampi(tab, PROFILE_TAB_SYNC, PROFILE_TAB_COUNT - 1)
    app->nav_sidebar_return_on_back = return_to_sidebar
    app_switch_route(app, route)
}

app_apply_nav_route :: (app: InbeApp*, route: int) {
    return_to_sidebar: int

    if app == NULL {
        return
    }
    return_to_sidebar = app_nav_sidebar_screen_active(app)

    if app->inbe.screen == InbeScreenHabits &&
       app->habits.screen_mode == HABITS_SCREEN_REORDER {
        app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
        app->habits.scroll = 0
    }

    if route == APP_NAV_ROUTE_PROFILE || route == APP_NAV_ROUTE_ACCOUNT {
        app_open_profile_tab(app, PROFILE_TAB_SYNC)
    } else if route == APP_NAV_ROUTE_DATA {
        app_open_profile_tab(app, PROFILE_TAB_DATA)
    } else if route == APP_NAV_ROUTE_FRIENDS {
        app_open_profile_tab(app, PROFILE_TAB_FRIENDS)
    } else if route == APP_NAV_ROUTE_LEADERBOARD {
        app_open_profile_tab(app, PROFILE_TAB_LEADERBOARD)
    } else if route == APP_NAV_ROUTE_PRACTICE {
        app->nav_sidebar_open = 0
        app->nav_sidebar_return_on_back = return_to_sidebar
        app_open_main_tab(app, APP_MAIN_TAB_PRACTICE, 1)
    } else if route == APP_NAV_ROUTE_HABITS {
        app->nav_sidebar_open = 0
        app->nav_sidebar_return_on_back = return_to_sidebar
        app_open_main_tab(app, APP_MAIN_TAB_HABITS, 1)
    } else if route == APP_NAV_ROUTE_STACK {
        if app_nav_sidebar_screen_active(app) || app->nav_sidebar_open {
            app_close_nav_sidebar(app)
        } else {
            app_open_nav_sidebar(app)
        }
    }
}

app_is_practice_fullscreen_subview :: (app: const InbeApp*) -> int #private {
    return app != NULL &&
           app->inbe.screen == InbeScreenStart &&
           (app->practice_tab == PRACTICE_TAB_MANUAL ||
            app->practice_tab == PRACTICE_TAB_CONFIG)
}

app_is_blank_home :: (app: const InbeApp*) -> int #private {
    return app != NULL &&
           app->inbe.screen == InbeScreenStart &&
           app->main_tab == APP_MAIN_TAB_NONE
}

app_content_bottom_reserved :: (app: const InbeApp*) -> int {
    if app == NULL {
        return 0
    }
    if app->inbe.screen == InbeScreenHabits &&
       app->habits.screen_mode == HABITS_SCREEN_REORDER {
        return 0
    }
    if app_is_practice_fullscreen_subview(app) {
        return 0
    }
    if app_current_nav_route(app) == APP_NAV_ROUTE_NONE &&
       !app_is_blank_home(app) {
        return 0
    }
    return UIGetNodeHeight(UINodeBottomNav((BottomNavProps){0}))
}

app_page_height :: (app: const InbeApp*, full_height: int) -> int {
    bottom_reserved: int

    if full_height <= 0 {
        return 0
    }
    bottom_reserved = app_fullscreen_bottom_reserved(app)
    if bottom_reserved > 0 && bottom_reserved < full_height {
        return full_height - bottom_reserved
    }
    return full_height
}

app_nav_route_label :: (route: int) -> const char* #private {
    if route == APP_NAV_ROUTE_PROFILE || route == APP_NAV_ROUTE_ACCOUNT {
        return GetLocaleText("sync_configure_account_button")
    }
    if route == APP_NAV_ROUTE_DATA {
        return GetLocaleText("profile_data")
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return GetLocaleText("profile_friends_title")
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return GetLocaleText("profile_leaderboard_title")
    }
    if route == APP_NAV_ROUTE_HABITS {
        return GetLocaleText("tab_habits")
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return GetLocaleText("tab_practice")
    }
    if route == APP_NAV_ROUTE_STACK {
        return GetLocaleText("tab_stack")
    }
    return ""
}

app_current_nav_route :: (app: const InbeApp*) -> int {
    if app == NULL {
        return APP_NAV_ROUTE_NONE
    }
    if app->inbe.screen == InbeScreenProfile {
        return APP_NAV_ROUTE_NONE
    }
    if app->inbe.screen == InbeScreenStart {
        if app_is_practice_fullscreen_subview(app) {
            return APP_NAV_ROUTE_NONE
        }
        if app->main_tab == APP_MAIN_TAB_NONE {
            return APP_NAV_ROUTE_NONE
        }
        return APP_NAV_ROUTE_PRACTICE
    }
    if app->inbe.screen == InbeScreenHabits {
        return APP_NAV_ROUTE_HABITS
    }
    return APP_NAV_ROUTE_NONE
}

app_fullscreen_bottom_reserved :: (app: const InbeApp*) -> int {
    if app == NULL {
        return 0
    }
    return app_android_bottom_nav_height()
}

app_sidebar_button :: (app: InbeApp*, x: int, y: int*, w: int,
                      label: const char*, route: int) -> int #private {
    hover := 0
    h := ScaleUIPx(38)
    disabled := app != NULL && app->modal.active

    if GenericButton(0, x, *y, w, h, label, UI_BUTTON_STYLE_SECONDARY,
                           disabled || route == APP_NAV_ROUTE_NONE, &hover) {
        app_apply_nav_route(app, route)
        return 1
    }
    *y += h + ScaleUIPx(8)
    return 0
}

app_open_settings_tab :: (app: InbeApp*, tab: int) #private {
    route: AppRoute
    return_to_sidebar: int

    if app == NULL {
        return
    }
    return_to_sidebar = app_nav_sidebar_screen_active(app)
    app->nav_sidebar_open = 0
    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    app->settings_scroll = 0
    settings_screen_clear_status()
    app_block_pointer_frame(app)
    route = app_current_route(app)
    route.screen = InbeScreenSettings
    route.settings_tab = tab
    app->nav_sidebar_return_on_back = return_to_sidebar
    app_switch_route(app, route)
}

app_sidebar_settings_button :: (app: InbeApp*, x: int, y: int*, w: int,
                               tab: int) -> int #private {
    hover := 0
    h := ScaleUIPx(38)
    disabled := app != NULL && app->modal.active

    if GenericButton(0, x, *y, w, h, settings_screen_tab_label(tab),
                           UI_BUTTON_STYLE_SECONDARY, disabled, &hover) {
        app_open_settings_tab(app, tab)
        return 1
    }
    *y += h + ScaleUIPx(8)
    return 0
}

app_draw_sidebar_route_items :: (app: InbeApp*, x: int, y: int*, w: int,
                                items: const AppSidebarRouteItem*,
                                count: int) -> int #private {
    for int i = 0; i < count; i++ {
        if app_sidebar_button(app, x, y, w, GetLocaleText(items[i].label_key),
                              items[i].route) {
            return 1
        }
    }
    return 0
}

app_draw_sidebar_settings_items :: (app: InbeApp*, x: int, y: int*, w: int,
                                   items: const AppSidebarSettingsItem*,
                                   count: int) -> int #private {
    for int i = 0; i < count; i++ {
        if app_sidebar_settings_button(app, x, y, w, items[i].tab) {
            return 1
        }
    }
    return 0
}

app_sidebar_account_label :: (out: char*, out_size: size_t) #private {
    account: KsyncAccount
    alias: const char*

    if out == NULL || out_size == 0 {
        return
    }
    if !sync_account_load(&account) {
        snprintf(out, out_size, "%s", GetLocaleText("sync_configure_account_button"))
        return
    }
    alias = storage_get_setting_text("sync_account_alias")
    if alias != NULL && alias[0] != '\0' {
        snprintf(out, out_size, "@%s", alias)
    } else {
        snprintf(out, out_size, "%.12s...", account.public_id)
    }
}

app_draw_sidebar_profile_header :: (app: InbeApp*, x: int, y: int*, w: int,
                                   has_account: int,
                                   account_label: const char*) -> int #private {
    header_h := ScaleUIPx(138)
    friends_count := has_account ? profile_social_friends_count(app) : 0
    pending_count := has_account ? profile_social_pending_count(app) : 0
    friends_text: [64] char
    header: UISidebarAccountHeaderResult

    if pending_count > 0 {
        FormatLocaleText(friends_text, sizeof(friends_text), "profile_friends_pending_summary", friends_count, pending_count)
    } else {
        snprintf(friends_text, sizeof(friends_text),
                    GetLocaleText("profile_friends_summary"), friends_count)
    }

    header = SidebarAccountHeader((UISidebarAccountHeaderSpec){
        .x = x,
        .y = *y,
        .width = w,
        .height = header_h,
        .username = account_label,
        .subtitle = has_account ? NULL : GetLocaleText("profile_no_account"),
        .friends_text = friends_text,
        .icons = app != NULL ? app->icons : NULL,
        .pfp_icon_type = app != NULL ? app->profile_picture_icon : UI_ICON_TYPE_NONE,
        .content_padding_x = ScaleUIPx(16),
        .current_frame = app != NULL ? app->inbe.frame : 0,
        .block_click_frame = app != NULL ? app->nav_sidebar_open_frame : -1
    })

    if header.pfp_clicked {
        app->profile_picture_picker_scroll = 0
        app_open_modal(app, UIModalProfilePicturePicker)
        *y += header.height + ScaleUIPx(12)
        return 1
    }
    if header.friends_clicked {
        app_apply_nav_route(app, has_account ? APP_NAV_ROUTE_FRIENDS
                                                : APP_NAV_ROUTE_ACCOUNT)
        *y += header.height + ScaleUIPx(12)
        return 1
    }
    if header.username_clicked {
        app_apply_nav_route(app, APP_NAV_ROUTE_ACCOUNT)
        *y += header.height + ScaleUIPx(12)
        return 1
    }

    *y += header.height + ScaleUIPx(12)
    return 0
}

app_open_bottom_nav_config :: (app: InbeApp*) #private {
    return_to_sidebar: int

    if app == NULL {
        return
    }
    return_to_sidebar = app_nav_sidebar_screen_active(app)
    app_sanitize_bottom_nav_routes(app)
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        app->bottom_nav_config_routes[i] = app->bottom_nav_routes[i]
    }
    app->bottom_nav_config_route_count = app->bottom_nav_route_count
    app->nav_sidebar_open = 0
    app->nav_sidebar_return_on_back = return_to_sidebar
    app_block_pointer_frame(app)
    app_switch_screen(app, InbeScreenCustomizeNav)
}

app_draw_nav_sidebar :: (app: InbeApp*) {
    sidebar_w: int
    sidebar_x: int
    pad: int
    footer_h: int
    footer_gap: int
    close_h: int
    close_y: int
    header_y: int
    header_h: int
    scroll_y: int
    scroll_h: int
    y: int
    hover := 0
    close_hover := 0
    scrim := BLACK
    area: UIScrollArea
    view: UIScrollView
    account: KsyncAccount
    has_account: int
    account_label: [96] char
    profile_items: [1] const AppSidebarRouteItem = {
        {"tab_profile", APP_NAV_ROUTE_PROFILE}
    }
    settings_count := 6
    #if DESKTOP {
        settings_items: [6] const AppSidebarSettingsItem = {
            {SETTINGS_TAB_DEVICE},
            {SETTINGS_TAB_AUDIO},
            {SETTINGS_TAB_BREAKS},
            {SETTINGS_TAB_NOTIFICATIONS},
            {SETTINGS_TAB_THEME},
            {SETTINGS_TAB_ABOUT}
        }
    } #else {
        settings_items: [5] const AppSidebarSettingsItem = {
            {SETTINGS_TAB_DEVICE},
            {SETTINGS_TAB_AUDIO},
            {SETTINGS_TAB_NOTIFICATIONS},
            {SETTINGS_TAB_THEME},
            {SETTINGS_TAB_ABOUT}
        }
        settings_count = 5
    }

    if app == NULL || (!app->nav_sidebar_open && !app_nav_sidebar_screen_active(app)) {
        return
    }

    if !app->modal.active {
        ClearUIInputCaptures()
    }

    sidebar_w = app_nav_sidebar_width()
    sidebar_x = view_width - sidebar_w
    pad = ScaleUIPx(16)
    close_h = ScaleUIPx(40)
    footer_gap = ScaleUIPx(14)
    footer_h = close_h + footer_gap * 2 + app_fullscreen_bottom_reserved(app)
    close_y = view_height - app_fullscreen_bottom_reserved(app) -
              footer_gap - close_h
    if close_y < footer_gap {
        close_y = footer_gap
    }
    if footer_h > view_height - ScaleUIPx(80) {
        footer_h = view_height > ScaleUIPx(80) ? view_height - ScaleUIPx(80)
                                               : view_height
    }

    scrim.a = 92
    DrawRectangle(0, 0, view_width, view_height, scrim)
    DrawRectangle(sidebar_x, 0, sidebar_w, view_height, GetThemeSurface())
    if sidebar_x > 0 {
        DrawLine(sidebar_x, 0, sidebar_x, view_height,
                    DarkenUIColor(GetThemeSurface(), 42))
    }

    if app->nav_sidebar_open_frame == app->inbe.frame {
        return
    }

    if app->nav_sidebar_open_frame != app->inbe.frame &&
       UIPointerReleaseOutside((Rectangle){(float)sidebar_x, 0.0f,
                                           (float)sidebar_w,
                                           (float)view_height}) {
        UIConsumeRelease()
        app_close_nav_sidebar(app)
        return
    }

    has_account = sync_account_load(&account)
    app_sidebar_account_label(account_label, sizeof(account_label))
    header_y = 0
    if app_draw_sidebar_profile_header(app, sidebar_x, &header_y, sidebar_w,
                                       has_account, account_label) {
        return
    }

    header_h = header_y
    scroll_y = header_h
    scroll_h = view_height - footer_h - scroll_y
    if scroll_h < 0 {
        scroll_h = 0
    }

    area = (UIScrollArea){
        .bounds = {(float)sidebar_x, (float)scroll_y, (float)sidebar_w,
                   (float)scroll_h},
        .content_height = (1 + settings_count) * (ScaleUIPx(38) + ScaleUIPx(8)) +
                          ScaleUIPx(10) + ScaleUIPx(40),
        .content_x = sidebar_x + pad,
        .content_width = sidebar_w - pad * 2,
        .scroll_offset = &app->nav_sidebar_scroll,
        .wheel_step = ScaleUIPx(42),
        .scrollbar_x = sidebar_x + sidebar_w - ScaleUIPx(8)
    }
    view = BeginUIScrollContainer(area)
    y = view.content_y
    if app_draw_sidebar_route_items(app, area.content_x, &y, area.content_width,
                                    profile_items, 1) {
        EndUIScrollContainer(area, view)
        return
    }
    if app_draw_sidebar_settings_items(app, area.content_x, &y,
                                       area.content_width, settings_items,
                                       settings_count) {
        EndUIScrollContainer(area, view)
        return
    }
    y += ScaleUIPx(10)
    if GenericButton(0, area.content_x, y, area.content_width, ScaleUIPx(40),
                           GetLocaleText("customize_nav_button"),
                           UI_BUTTON_STYLE_PRIMARY, app->modal.active, &hover) {
        app_open_bottom_nav_config(app)
        EndUIScrollContainer(area, view)
        return
    }

    EndUIScrollContainer(area, view)

    DrawLine(sidebar_x, view_height - footer_h, sidebar_x + sidebar_w,
                view_height - footer_h, DarkenUIColor(GetThemeSurface(), 28))
    if GenericButton(0, sidebar_x + pad, close_y, sidebar_w - pad * 2,
                           close_h, GetLocaleText("close_button"),
                           UI_BUTTON_STYLE_SECONDARY, app->modal.active,
                           &close_hover) {
        app_close_nav_sidebar(app)
        app_block_pointer_frame(app)
    }
}

app_nav_option_index :: (route: int) -> int #private {
    if route == APP_NAV_ROUTE_HABITS {
        return 0
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return 1
    }
    return 0
}

app_nav_route_for_option :: (option: int) -> int #private {
    routes: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] const int = {
        APP_NAV_ROUTE_HABITS,
        APP_NAV_ROUTE_PRACTICE
    }

    if option < 0 || option >= APP_BOTTOM_NAV_CONFIGURABLE_COUNT {
        return APP_NAV_ROUTE_HABITS
    }
    return routes[option]
}

app_save_bottom_nav_config :: (app: InbeApp*) #private {
    if app == NULL {
        return
    }
    app->bottom_nav_route_count = app->bottom_nav_config_route_count
    for int i = 0; i < APP_BOTTOM_NAV_CONTENT_MAX; i++ {
        app->bottom_nav_routes[i] = i < app->bottom_nav_route_count
                                        ? app->bottom_nav_config_routes[i]
                                        : APP_NAV_ROUTE_NONE
    }
    app_reconcile_bottom_nav_selection(app)
    save_settings(app)
}

app_move_bottom_nav_config_route :: (app: InbeApp*, from_index: int,
                                    to_index: int) -> int #private {
    route: int

    if app == NULL {
        return 0
    }
    if from_index < 0 || to_index < 0 ||
       from_index >= app->bottom_nav_config_route_count ||
       to_index >= app->bottom_nav_config_route_count ||
       from_index == to_index {
        return 0
    }

    route = app->bottom_nav_config_routes[from_index]
    if from_index < to_index {
        for int i = from_index; i < to_index; i++ {
            app->bottom_nav_config_routes[i] =
                app->bottom_nav_config_routes[i + 1]
        }
    } else {
        for int i = from_index; i > to_index; i-- {
            app->bottom_nav_config_routes[i] =
                app->bottom_nav_config_routes[i - 1]
        }
    }
    app->bottom_nav_config_routes[to_index] = route
    return 1
}

app_first_unused_bottom_nav_route :: (app: const InbeApp*) -> int #private {
    routes: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] const int = {
        APP_NAV_ROUTE_HABITS,
        APP_NAV_ROUTE_PRACTICE
    }

    for int i = 0; i < APP_BOTTOM_NAV_CONFIGURABLE_COUNT; i++ {
        used := 0

        for int j = 0; app != NULL && j < app->bottom_nav_config_route_count; j++ {
            if app->bottom_nav_config_routes[j] == routes[i] {
                used = 1
                break
            }
        }
        if !used {
            return routes[i]
        }
    }

    return APP_NAV_ROUTE_HABITS
}

app_draw_customize_nav_page :: (app: InbeApp*) -> int {
    options: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT] const char*
    page: UIScrollPage
    reorder_items: [APP_BOTTOM_NAV_CONTENT_MAX] UIReorderItem
    reorder: UIReorderListResult
    selected: [APP_BOTTOM_NAV_CONTENT_MAX] int
    row_y: [APP_BOTTOM_NAV_CONTENT_MAX] int
    y: int
    changed := 0
    button_h := ScaleUIPx(36)
    row_h := ScaleUIPx(58)
    handle_w := ScaleUIPx(34)
    draw_count: int
    action := APP_NAV_CONFIG_ACTION_NONE
    action_index := -1
    action_to_index := -1
    action_route := APP_NAV_ROUTE_NONE

    if app == NULL {
        return 0
    }
    if app->bottom_nav_config_route_count < 0 ||
       app->bottom_nav_config_route_count > APP_BOTTOM_NAV_CONTENT_MAX {
        app_sanitize_bottom_nav_routes(app)
        for int i = 0; i < app->bottom_nav_route_count; i++ {
            app->bottom_nav_config_routes[i] = app->bottom_nav_routes[i]
        }
        app->bottom_nav_config_route_count = app->bottom_nav_route_count
    }
    draw_count = app->bottom_nav_config_route_count

    if app_draw_close_title_bar(app, GetLocaleText("customize_nav_title"),
                                UIGetNodeHeight(UINodeTabBar((TabBarProps){0}))) {
        app_block_pointer_frame(app)
        app_open_main_tab(app, app->main_tab, 0)
        return 1
    }

    options[0] = app_nav_route_label(APP_NAV_ROUTE_HABITS)
    options[1] = app_nav_route_label(APP_NAV_ROUTE_PRACTICE)

    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = UIGetNodeHeight(UINodeTabBar((TabBarProps){0})) + ScaleUIPx(8),
        .height = view_height - UIGetNodeHeight(UINodeTabBar((TabBarProps){0})) - ScaleUIPx(8),
        .max_content_width = ScaleUIPx(CONTENT_MAX_W),
        .min_content_width = ScaleUIPx(300),
        .scroll_offset = &app->nav_sidebar_scroll
    })
    y = page.content_y

    for int i = 0; i < APP_BOTTOM_NAV_CONTENT_MAX; i++ {
        selected[i] = app_nav_option_index(app->bottom_nav_config_routes[i])
    }

    for int i = 0; i < draw_count; i++ {
        row_y[i] = y + i * row_h
        reorder_items[i] = (UIReorderItem){
            .id = app->bottom_nav_config_routes[i] * 100 + i + 1,
            .bounds = {(float)page.content_x, (float)row_y[i],
                       (float)page.content_w, (float)row_h},
            .disabled = 0
        }
    }

    reorder = UpdateUIReorderList((UIReorderList){
        .id = 701,
        .bounds = {(float)page.content_x, (float)page.content_y,
                   (float)page.content_w,
                   (float)(row_h * draw_count)},
        .items = reorder_items,
        .item_count = draw_count,
        .handle_width = handle_w,
        .scroll_offset = &app->nav_sidebar_scroll,
        .max_scroll = page.view.max_scroll,
        .viewport_top = (int)page.area.bounds.y,
        .viewport_bottom = (int)(page.area.bounds.y + page.area.bounds.height)
    })
    if reorder.committed {
        action = APP_NAV_CONFIG_ACTION_MOVE
        action_index = reorder.from_index
        action_to_index = reorder.to_index
    }

    for int i = 0; i < draw_count; i++ {
        trash_hover := 0
        icon_w := ScaleUIPx(36)
        icon_gap := ScaleUIPx(8)
        dropdown_x := page.content_x + handle_w
        trash_x := page.content_x + page.content_w - icon_w
        dropdown_w := trash_x - icon_gap - dropdown_x
        dropdown_y := row_y[i] + (row_h - button_h) / 2

        if dropdown_w < ScaleUIPx(48) {
            dropdown_w = ScaleUIPx(48)
        }

        if reorder.dragging && i == reorder.active_index {
            continue
        }

        ReorderHandle(0, page.content_x, row_y[i], handle_w, row_h,
                               reorder.active && i == reorder.active_index)
        if Dropdown(740 + i, dropdown_x, dropdown_y,
                                dropdown_w, button_h, options,
                                APP_BOTTOM_NAV_CONFIGURABLE_COUNT, &selected[i]) &&
           action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_SET
            action_index = i
            action_route = app_nav_route_for_option(selected[i])
        }
        if PaddedIconBtn(0, trash_x, dropdown_y - ScaleUIPx(2),
                               ScaleUIPx(20), ScaleUIPx(8),
                               app->icons[UI_ICON_TYPE_TRASH],
                               &trash_hover) &&
           action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_REMOVE
            action_index = i
        }
    }
    if reorder.dragging && reorder.target_index >= 0 &&
       reorder.target_index < draw_count {
        ReorderPlaceholder(reorder_items[reorder.target_index].bounds)
    }
    if reorder.dragging && reorder.active_index >= 0 &&
       reorder.active_index < draw_count {
        i := reorder.active_index
        trash_hover := 0
        icon_w := ScaleUIPx(36)
        icon_gap := ScaleUIPx(8)
        dropdown_x := page.content_x + handle_w
        trash_x := page.content_x + page.content_w - icon_w
        dropdown_w := trash_x - icon_gap - dropdown_x
        overlay_y := row_y[i] + reorder.drag_delta_y
        dropdown_y := overlay_y + (row_h - button_h) / 2

        if dropdown_w < ScaleUIPx(48) {
            dropdown_w = ScaleUIPx(48)
        }
        DrawRectangle(page.content_x, overlay_y, page.content_w, row_h,
                         LightenUIColor(GetThemeBackground(), 8))
        ReorderHandle(0, page.content_x, overlay_y, handle_w, row_h, 1)
        Dropdown(740 + i, dropdown_x, dropdown_y,
                                dropdown_w, button_h, options,
                                APP_BOTTOM_NAV_CONFIGURABLE_COUNT, &selected[i])
        app_nav_mark_int_used(trash_hover)
        IconTexture(0, trash_x + ScaleUIPx(8), dropdown_y + ScaleUIPx(6),
                             ScaleUIPx(20), app->icons[UI_ICON_TYPE_TRASH],
                             GetThemeIcon())
    }

    y += row_h * draw_count

    if draw_count < APP_BOTTOM_NAV_CONFIGURABLE_COUNT {
        add_hover := 0
        if GenericButton(0, page.content_x, y, page.content_w, button_h,
                               GetLocaleText("customize_nav_add"),
                               UI_BUTTON_STYLE_SECONDARY, 0, &add_hover) &&
           action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_ADD
        }
        y += button_h + ScaleUIPx(14)
    }

    EndUIScrollPage(page)

    if action == APP_NAV_CONFIG_ACTION_MOVE {
        changed = app_move_bottom_nav_config_route(app, action_index,
                                                   action_to_index)
    } else if action == APP_NAV_CONFIG_ACTION_REMOVE {
        if action_index >= 0 &&
           action_index < app->bottom_nav_config_route_count {
            for int j = action_index; j < app->bottom_nav_config_route_count - 1; j++ {
                app->bottom_nav_config_routes[j] =
                    app->bottom_nav_config_routes[j + 1]
            }
            app->bottom_nav_config_route_count--
            changed = 1
        }
    } else if action == APP_NAV_CONFIG_ACTION_ADD {
        if app->bottom_nav_config_route_count < APP_BOTTOM_NAV_CONFIGURABLE_COUNT {
            app->bottom_nav_config_routes[app->bottom_nav_config_route_count++] =
                app_first_unused_bottom_nav_route(app)
            changed = 1
        }
    } else if action == APP_NAV_CONFIG_ACTION_SET {
        if action_index >= 0 && action_index < app->bottom_nav_config_route_count {
            old_route := app->bottom_nav_config_routes[action_index]
            if action_route != old_route {
                for int j = 0; j < app->bottom_nav_config_route_count; j++ {
                    if j != action_index && app->bottom_nav_config_routes[j] == action_route {
                        app->bottom_nav_config_routes[j] = old_route
                        break
                    }
                }
            }
            app->bottom_nav_config_routes[action_index] = action_route
            changed = 1
        }
    }

    if changed {
        app_save_bottom_nav_config(app)
    }

    return 0
}
