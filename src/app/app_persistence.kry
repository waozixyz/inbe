#module "app.persistence"

#import "app.h"
#import "screens/habits_screen.h" #private

app_flush_deferred_settings :: (app: InnerBreeze*) #export {
    if app == nil || app->settings_save_delay_ticks <= 0 { return }
    app->settings_save_delay_ticks--
    if app->settings_save_delay_ticks <= 0 && app->settings_dirty {
        save_settings(app)
    }
}

habits_save_pending :: (app: const InnerBreeze*) -> int #private {
    return app != nil &&
           (app->habits.dirty || app->habits.pending_day_save_count > 0)
}

flush_habits_post_frame :: (userdata: void*) -> void #private {
    app := (InnerBreeze*)userdata
    if app == nil { return }
    app->habits_flush_post_frame_scheduled = 0
    habits_flush_save(app)
}

app_schedule_habits_post_frame_flush :: (app: InnerBreeze*) #export {
    if !habits_save_pending(app) || app->habits_flush_post_frame_scheduled {
        return
    }
    app->habits_flush_post_frame_scheduled = 1
    if !SchedulePostFrameCallback(flush_habits_post_frame, app) {
        app->habits_flush_post_frame_scheduled = 0
        habits_flush_save(app)
    }
}
