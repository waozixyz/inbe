#module "app.profile"

#import "kryon.h"
#import <stdlib.h> #private
#import <string.h> #private

ProfileStats :: struct {
    initialized: int
    enabled: int
    frames: int
    frame_total: double
    frame_max: double
    update_total: double
    update_max: double
    habits_total: double
    habits_max: double
    sync_total: double
    sync_max: double
}

static stats: ProfileStats = {0}

enabled :: () -> int #private {
    if !stats.initialized {
        environment := getenv("APP_PROFILE")
        stats.enabled = environment != nil && environment[0] != '\0' &&
                        environment[0] != '0'
        stats.initialized = 1
    }
    return stats.enabled
}

app_profile_now :: () -> double #export {
    return enabled() ? GetTime() : 0.0
}

accumulate :: (total: double*, maximum: double*, start: double) #private {
    if !enabled() || start <= 0.0 { return }
    elapsed := (GetTime() - start) * 1000.0
    total[0] += elapsed
    if elapsed > maximum[0] { maximum[0] = elapsed }
}

app_profile_record_update :: (start: double) #export {
    accumulate(&stats.update_total, &stats.update_max, start)
}

app_profile_record_habits :: (start: double) #export {
    accumulate(&stats.habits_total, &stats.habits_max, start)
}

app_profile_record_sync :: (start: double) #export {
    accumulate(&stats.sync_total, &stats.sync_max, start)
}

app_profile_frame_end :: (start: double) #export {
    if !enabled() || start <= 0.0 { return }
    elapsed := (GetTime() - start) * 1000.0
    stats.frame_total += elapsed
    if elapsed > stats.frame_max { stats.frame_max = elapsed }
    stats.frames++
    if stats.frames < 120 { return }
    TraceLog(LOG_INFO,
             "PROFILE: frame avg=%.2f max=%.2f update avg=%.2f max=%.2f habits avg=%.2f max=%.2f sync avg=%.2f max=%.2f",
             stats.frame_total / stats.frames, stats.frame_max,
             stats.update_total / stats.frames, stats.update_max,
             stats.habits_total / stats.frames, stats.habits_max,
             stats.sync_total / stats.frames, stats.sync_max)
    memset(&stats, 0, sizeof(stats))
    stats.initialized = 1
    stats.enabled = 1
}
