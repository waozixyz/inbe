#module "app.route_state"

#import "app/app"
#import "screens/profile_social" #private
#import <stdlib.h> #private

app_route_debug_enabled :: () -> int #private {
    value := getenv("INBE_DEBUG_ROUTE")
    return value != nil && value[0] != '\0'
}

app_current_route :: (app: const InnerBreeze*) -> AppRoute #export {
    route := (AppRoute){0}
    if app == nil { return route }
    route.screen = app->breathing.screen
    route.exercise_type = app->exercise_type
    route.practice_tab = app->practice_tab
    route.practice_config_tab = app->practice_config_tab
    route.settings_overview = app->settings_overview
    route.settings_tab = app->settings_tab
    route.profile_view = app->profile_view
    route.profile_tab = app->profile_tab
    route.habits_screen_mode = app->habits.screen_mode
    route.habits_tab = app->habits.tab
    return route
}

route_uses_habit_state :: (screen: int) -> int #private {
    return screen == ScreenHabits || screen == ScreenHabitEdit ||
           screen == ScreenHabitSessionEdit
}

routes_equal :: (left: AppRoute, right: AppRoute) -> int #export {
    if left.screen != right.screen { return 0 }
    if route_uses_habit_state(left.screen) {
        return left.habits_screen_mode == right.habits_screen_mode &&
               left.habits_tab == right.habits_tab
    }
    switch left.screen {
    case ScreenStart:
        return left.exercise_type == right.exercise_type &&
               left.practice_tab == right.practice_tab &&
               (left.practice_tab != PRACTICE_TAB_CONFIG ||
                left.practice_config_tab == right.practice_config_tab)
    case ScreenSettings:
        return left.settings_tab == right.settings_tab &&
               left.settings_overview == right.settings_overview
    case ScreenProfile:
        return left.profile_view == right.profile_view &&
               left.profile_tab == right.profile_tab
    }
    return 1
}

enter_route :: (app: InnerBreeze*, route: AppRoute) #private {
    if route.screen != ScreenProfile { return }
    if route.profile_tab == PROFILE_TAB_FRIENDS {
        profile_social_load_friends_cache(app)
        app_request_social_refresh(app)
    } else if route.profile_tab == PROFILE_TAB_LEADERBOARD {
        profile_social_load_leaderboard_cache(app)
        app_request_social_refresh(app)
    }
}

apply_route :: (app: InnerBreeze*, route: AppRoute) #private {
    app->breathing.screen = route.screen
    app->exercise_type = route.exercise_type
    app->practice_tab = route.practice_tab
    app->practice_config_tab = route.practice_config_tab
    app->settings_overview = route.settings_overview
    app->settings_tab = route.settings_tab
    app->profile_view = route.profile_view
    app->profile_tab = route.profile_tab
    app->habits.screen_mode = route.habits_screen_mode
    app->habits.tab = route.habits_tab
}

app_switch_route :: (app: InnerBreeze*, route: AppRoute) #export {
    if app == nil || routes_equal(app_current_route(app), route) { return }
    before := app_current_route(app)
    if route.screen == ScreenHabits && app->breathing.screen != ScreenHabits {
        app->habits.focus_selected_tab = 1
    }
    apply_route(app, route)
    enter_route(app, app_current_route(app))
    if app_route_debug_enabled() {
        TraceLog(LOG_INFO, "ROUTE switch frame=%d screen=%d->%d",
                 app->breathing.frame, before.screen, route.screen)
    }
}

app_request_route :: (app: InnerBreeze*, route: AppRoute) #export {
    if app == nil { return }
    if app_route_debug_enabled() {
        current := app_current_route(app)
        TraceLog(LOG_INFO, "ROUTE request frame=%d screen=%d->%d",
                 app->breathing.frame, current.screen, route.screen)
    }
    app_switch_route(app, route)
    RouterNavigate(&app->route_router, route.screen)
}

app_switch_screen :: (app: InnerBreeze*, screen: int) #export {
    if app == nil { return }
    route := app_current_route(app)
    route.screen = screen
    if screen == ScreenSettings {
        route.settings_overview = 0
    }
    app_switch_route(app, route)
}
