#module "app.route_url"

#import "app.h"
#import "app/app_route_state.h" #private
#import <stdio.h> #private
#import <string.h> #private

static route_version: int = -1

route_id_for_screen :: (screen: int) -> const char* #private {
    switch screen {
    case ScreenStart:
        return "start"
    case ScreenSession:
        return "session"
    case ScreenMeditation:
        return "meditation"
    case ScreenSunSalutation:
        return "sun_salutation"
    case ScreenPatterns:
        return "patterns"
    case ScreenResults:
        return "results"
    case ScreenSettings:
        return "settings"
    case ScreenLanguage:
        return "language"
    case ScreenManual:
        return "manual"
    case ScreenProfile:
        return "profile"
    case ScreenHabits:
        return "habits"
    case ScreenEList:
        return "elist"
    case ScreenCustomizeNav:
        return "customize_nav"
    case ScreenNavSidebar:
        return "nav_sidebar"
    case ScreenHabitEdit:
        return "habit_edit"
    case ScreenHabitSessionEdit:
        return "habit_session_edit"
    }
    return nil
}

screen_for_route_id :: (id: const char*) -> int #export {
    if id == nil || id[0] == '\0' { return -1 }
    if strcmp(id, "start") == 0 { return ScreenStart }
    if strcmp(id, "session") == 0 { return ScreenSession }
    if strcmp(id, "meditation") == 0 { return ScreenMeditation }
    if strcmp(id, "sun_salutation") == 0 { return ScreenSunSalutation }
    if strcmp(id, "patterns") == 0 { return ScreenPatterns }
    if strcmp(id, "results") == 0 { return ScreenResults }
    if strcmp(id, "settings") == 0 { return ScreenSettings }
    if strcmp(id, "language") == 0 { return ScreenLanguage }
    if strcmp(id, "manual") == 0 { return ScreenManual }
    if strcmp(id, "profile") == 0 { return ScreenProfile }
    if strcmp(id, "habits") == 0 { return ScreenHabits }
    if strcmp(id, "elist") == 0 { return ScreenEList }
    if strcmp(id, "customize_nav") == 0 { return ScreenCustomizeNav }
    if strcmp(id, "nav_sidebar") == 0 { return ScreenNavSidebar }
    if strcmp(id, "habit_edit") == 0 { return ScreenHabitEdit }
    if strcmp(id, "habit_session_edit") == 0 { return ScreenHabitSessionEdit }
    return -1
}

copy_hash_id :: (destination: char*, capacity: size_t,
                 hash: const char*) #private {
    length: size_t = 0

    if destination == nil || capacity == 0 { return }
    destination[0] = '\0'
    if hash == nil { return }
    while hash[0] == ' ' || hash[0] == '\t' || hash[0] == '#' { hash++ }
    if hash[0] == '/' { hash++ }
    while hash[length] != '\0' && hash[length] != '/' &&
          hash[length] != '?' && hash[length] != '&' &&
          length + 1 < capacity {
        destination[length] = hash[length]
        length++
    }
    destination[length] = '\0'
}

write_current_route :: (app: InnerBreeze*, push: int) #private {
    if app == nil { return }
    id := route_id_for_screen(app->breathing.screen)
    if id == nil || id[0] == '\0' { return }
    path := GetRoutePath()
    if path == nil || path[0] == '\0' { path = "/" }
    route: [320]char
    snprintf(route, sizeof(route), "%s#/%s", path, id)
    if push {
        PushRoute(route)
    } else {
        ReplaceRoute(route)
    }
    route_version = GetRouteVersion()
}

app_sync_route_from_url :: (app: InnerBreeze*) #export {
    if app == nil { return }
    version := GetRouteVersion()
    if version == route_version { return }
    route_version = version

    id: [96]char
    copy_hash_id(id, sizeof(id), GetRouteHash())
    screen := screen_for_route_id(id)
    if screen < 0 || (screen == ScreenLanguage && app->language_selected) {
        write_current_route(app, 0)
        return
    }
    route := app_current_route(app)
    route.screen = screen
    app_switch_route(app, route)
}

app_observe_direct_route_change :: (app: InnerBreeze*, before: AppRoute) #export {
    if app == nil || routes_equal(before, app_current_route(app)) { return }
    if app->breathing.screen == ScreenHabits && before.screen != ScreenHabits {
        app->habits.focus_selected_tab = 1
    }
    write_current_route(app, 1)
}
