#module "app.route_url"

#import "app/app.h"
#import "app/app_route_state.h" #private
#import <stdio.h> #private
#import <string.h> #private

InbeRouterConstants :: enum {
    INBE_ROUTER_ROUTE_COUNT = 15
}

static app_router_routes: [INBE_ROUTER_ROUTE_COUNT] const RouterRoute = {
    {ScreenStart, -1, "start", "Start", "main"},
    {ScreenSession, ScreenStart, "session", "Session", "practice"},
    {ScreenMeditation, ScreenStart, "meditation", "Meditation", "practice"},
    {ScreenSunSalutation, ScreenStart, "sun_salutation", "Sun Salutation", "practice"},
    {ScreenPatterns, ScreenStart, "patterns", "Patterns", "practice"},
    {ScreenResults, ScreenStart, "results", "Results", "practice"},
    {ScreenSettings, -1, "settings", "Settings", "main"},
    {ScreenLanguage, ScreenSettings, "language", "Language", "settings"},
    {ScreenManual, ScreenStart, "manual", "Manual", "practice"},
    {ScreenProfile, -1, "profile", "Profile", "main"},
    {ScreenHabits, -1, "habits", "Habits", "main"},
    {ScreenEList, -1, "elist", "Exercises", "main"},
    {ScreenCustomizeNav, ScreenSettings, "customize_nav", "Customize Navigation", "settings"},
    {ScreenHabitEdit, ScreenHabits, "habit_edit", "Habit Edit", "habits"},
    {ScreenHabitSessionEdit, ScreenHabits, "habit_session_edit", "Habit Session Edit", "habits"}
}

route_id_for_screen :: (screen: int) -> const char* #private {
    switch screen {
    case ScreenStart:
        return "start"
    case ScreenSession:
        return "session"
    case ScreenMeditation:
        return "meditation"
    case ScreenSunSalutation:
        return "sun_salutation"
    case ScreenPatterns:
        return "patterns"
    case ScreenResults:
        return "results"
    case ScreenSettings:
        return "settings"
    case ScreenLanguage:
        return "language"
    case ScreenManual:
        return "manual"
    case ScreenProfile:
        return "profile"
    case ScreenHabits:
        return "habits"
    case ScreenEList:
        return "elist"
    case ScreenCustomizeNav:
        return "customize_nav"
    case ScreenHabitEdit:
        return "habit_edit"
    case ScreenHabitSessionEdit:
        return "habit_session_edit"
    }
    return nil
}

screen_for_route_id :: (id: const char*) -> int #export {
    if id == nil || id[0] == '\0' { return -1 }
    if strcmp(id, "start") == 0 { return ScreenStart }
    if strcmp(id, "session") == 0 { return ScreenSession }
    if strcmp(id, "meditation") == 0 { return ScreenMeditation }
    if strcmp(id, "sun_salutation") == 0 { return ScreenSunSalutation }
    if strcmp(id, "patterns") == 0 { return ScreenPatterns }
    if strcmp(id, "results") == 0 { return ScreenResults }
    if strcmp(id, "settings") == 0 { return ScreenSettings }
    if strcmp(id, "language") == 0 { return ScreenLanguage }
    if strcmp(id, "manual") == 0 { return ScreenManual }
    if strcmp(id, "profile") == 0 { return ScreenProfile }
    if strcmp(id, "habits") == 0 { return ScreenHabits }
    if strcmp(id, "elist") == 0 { return ScreenEList }
    if strcmp(id, "customize_nav") == 0 { return ScreenCustomizeNav }
    if strcmp(id, "habit_edit") == 0 { return ScreenHabitEdit }
    if strcmp(id, "habit_session_edit") == 0 { return ScreenHabitSessionEdit }
    return -1
}

app_router_props :: (app: InnerBreeze*) -> RouterProps #private {
    return (RouterProps){
        .bounds = {0, 0, 0, 0},
        .key = Key("inbe-router"),
        .state = app != nil ? &app->route_router : nil,
        .routes = app_router_routes,
        .route_count = INBE_ROUTER_ROUTE_COUNT,
        .initial_route = app != nil ? app->breathing.screen : ScreenStart,
        .sync_url = 1,
        .replace_on_init = 1
    }
}

app_sync_route_from_url :: (app: InnerBreeze*) #export {
    if app == nil { return }
    result := Router(app_router_props(app))
    if result.route == ScreenLanguage && app->language_selected {
        RouterSetRoute(app_router_props(app), app->breathing.screen, 0)
        return
    }
    if result.changed {
        route := app_current_route(app)
        route.screen = result.route
        app_switch_route(app, route)
    }
}

app_observe_direct_route_change :: (app: InnerBreeze*, before: AppRoute) #export {
    if app == nil || routes_equal(before, app_current_route(app)) { return }
    if app->breathing.screen == ScreenHabits && before.screen != ScreenHabits {
        app->habits.focus_selected_tab = 1
    }
    RouterSetRoute(app_router_props(app), app->breathing.screen, 1)
}
