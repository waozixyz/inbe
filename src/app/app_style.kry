#module "app.style"
#import "app/app.h"
#import <stdio.h>
#import <stdlib.h>
#import <string.h>

#style <material> as material

style_pack_id :: (index: int) -> const char* #export {
    switch index {
        case 1:
        return "material"
        case 2:
        return "classic"
        case 3:
        return "lightfield"
        default:
        return "material"
    }
}

style_pack_label :: (index: int) -> const char* #export {
    switch index {
        case 1:
        return "Material"
        case 2:
        return "Classic"
        case 3:
        return "Lightfield"
        default:
        return "Material"
    }
}

style_token_color :: (color: Color) -> u32 #private {
    return (u32)ColorToInt(color)
}

lightfield_token_color :: (style_index: int, color: Color,
                           alpha: float) -> u32 #private {
    if style_index == 3 {
        return style_token_color(Fade(color, alpha))
    }
    return style_token_color(color)
}

register_style_pack_variant :: (source: const char*, label: const char*,
                                colors: ThemeColors, style_index: int) -> int #private {
    tokens: [47] StyleColorToken = {
        {"canvas", style_token_color(colors.background)},
        {"text", style_token_color(colors.text)},
        {"muted", style_token_color(colors.text_muted)},
        {"surface", lightfield_token_color(style_index, colors.surface, 0.87f)},
        {"surface-end", lightfield_token_color(style_index, colors.surface_raised, 0.93f)},
        {"card", lightfield_token_color(style_index, colors.surface_raised, 0.87f)},
        {"card-end", lightfield_token_color(style_index, colors.surface, 0.93f)},
        {"panel", style_token_color(colors.surface_raised)},
        {"panel-hover", style_token_color(colors.surface)},
        {"panel-pressed", style_token_color(colors.surface_sunken)},
        {"button", lightfield_token_color(style_index, colors.surface_raised, 0.87f)},
        {"button-end", lightfield_token_color(style_index, colors.surface, 0.93f)},
        {"button-hover", lightfield_token_color(style_index, colors.surface, 0.93f)},
        {"button-hover-end", lightfield_token_color(style_index, colors.surface_raised, 0.93f)},
        {"button-pressed", lightfield_token_color(style_index, colors.surface_sunken, 0.93f)},
        {"button-pressed-end", lightfield_token_color(style_index, colors.surface, 0.93f)},
        {"button-disabled", style_token_color(colors.surface)},
        {"dropdown-end", lightfield_token_color(style_index, colors.surface_raised, 0.93f)},
        {"border", style_token_color(colors.border)},
        {"border-soft", style_token_color(colors.divider)},
        {"border-hover", style_token_color(colors.border_strong)},
        {"border-hover-strong", style_token_color(colors.border_strong)},
        {"border-disabled", style_token_color(colors.divider)},
        {"card-border", style_token_color(colors.border)},
        {"outline-border", style_token_color(colors.border_strong)},
        {"focus", style_token_color(colors.focus)},
        {"accent", style_token_color(colors.accent)},
        {"accent-end", style_token_color(colors.accent_pressed)},
        {"accent-hover", style_token_color(colors.accent_hover)},
        {"accent-hover-end", style_token_color(colors.accent)},
        {"accent-border", style_token_color(colors.accent_pressed)},
        {"accent-ink", style_token_color(colors.on_accent)},
        {"danger", style_token_color(colors.danger)},
        {"danger-hover", style_token_color(colors.danger)},
        {"danger-ink", style_token_color(colors.on_danger)},
        {"danger-border", style_token_color(colors.danger)},
        {"row", lightfield_token_color(style_index, colors.surface, 0.67f)},
        {"thumb-ink", style_token_color(colors.on_accent)},
        {"divider", style_token_color(colors.divider)},
        {"track", style_token_color(colors.surface_sunken)},
        {"track-hover", style_token_color(colors.surface_raised)},
        {"field", style_token_color(colors.surface_sunken)},
        {"field-border", style_token_color(colors.border)},
        {"scroll-thumb", style_token_color(colors.text_muted)},
        {"scroll-border", style_token_color(colors.border_strong)},
        {"link", style_token_color(colors.link)},
        {"icon", style_token_color(colors.icon)},
    }
    return RegisterStylePackVariant("inbe", source, label, tokens, 47)
}

static applied_style: int = -1
static applied_colors: ThemeColors

style_pack_has_glow :: (index: int) -> int #export {
    return index == 3
}

app_apply_style :: (app: InnerBreeze*) #export {
    if app == NULL {
        return
    }
    SetFancyEffectsEnabled(!style_pack_has_glow(app->style_index) ||
    app->lightfield_glow_enabled)
    scheme := GetThemeScheme()
    colors := (ThemeColors){
        .background = GetThemeBackground(),
        .surface = GetThemeSurface(),
        .surface_raised = GetThemeSurfaceAlt(),
        .surface_sunken = scheme.surface_container,
        .text = GetThemeText(),
        .text_muted = GetThemeMutedText(),
        .border = GetThemeBorder(),
        .border_strong = scheme.outline,
        .divider = GetThemeBorder(),
        .focus = GetThemeButton(),
        .accent = GetThemeButton(),
        .accent_hover = GetThemeButtonHover(),
        .accent_pressed = MixThemeColor(GetThemeButton(), GetThemeText(), 0.12f),
        .on_accent = GetThemeButtonText(),
        .danger = scheme.error,
        .on_danger = GetThemeReadableText(scheme.error),
        .link = GetThemeLink(),
        .icon = GetThemeIcon()
    }
    if applied_style == app->style_index &&
    memcmp(&applied_colors, &colors, sizeof(ThemeColors)) == 0 &&
    FindStylePack("inbe") != NULL {
        SetActiveStylePack("inbe")
        return
    }
    if !EnsureBuiltInStylePacks() {
        TraceLog(LOG_ERROR, "STYLE: Built-in style assets are unavailable")
        return
    }
    path: [128] char
    snprintf(path, sizeof(path), "styles/kryon/%s.kss", style_pack_id(app->style_index))
    source := LoadEmbeddedAssetText(path)
    if source == NULL {
        TraceLog(LOG_ERROR, "STYLE: Could not load %s", path)
        return
    }
    overrides := LoadEmbeddedAssetText("assets/styles/inbe.kss")
    if overrides != nil {
        source_size := strlen(source)
        combined := realloc(source, source_size + strlen(overrides) + 2)
        if combined != nil {
            source = combined
            source[source_size] = '\n'
            strcpy(source + source_size + 1, overrides)
        }
        free(overrides)
    }
    if register_style_pack_variant(source, style_pack_label(app->style_index),
                                   colors, app->style_index) {
        SetActiveStylePack("inbe")
        applied_style = app->style_index
        applied_colors = colors
    } else {
        TraceLog(LOG_ERROR, "STYLE: Could not apply the selected color variation")
    }
    free(source)
}
