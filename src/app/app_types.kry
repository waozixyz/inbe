#enum {
    AUDIO_BUILTIN_MUSIC_COUNT = 3
    AUDIO_CUSTOM_SOUND_MAX = 8
    AUDIO_CUSTOM_MUSIC_MAX = 16
    AUDIO_LABEL_SIZE = 64
    AUDIO_MUSIC_COUNT_MAX =
    AUDIO_BUILTIN_MUSIC_COUNT + AUDIO_CUSTOM_MUSIC_MAX
