HostApiRequestSize :: void (*)(void *userdata, int width, int height) #type

HostApiClose :: void (*)(void *userdata) #type

UIPanelFrame :: struct {
    x: int
    y: int
    w: int
    h: int
    content_x: int
    content_y: int
    content_w: int
    content_h: int
    left_clicked: int
    right_clicked: int
}

UIGuideStep :: struct {
    anchor: Rectangle
    text: const char*
}

GuideOverlayProps :: struct {
    steps: const UIGuideStep*
    count: int
    step: int*
    view_width: int
    view_height: int
    reserved_top: int
    reserved_bottom: int
    max_width: int
    line_gap: int
    paragraph_font: int
    close_icon_type: int
    back_icon_type: int
    next_icon_type: int
    done_icon_type: int
}

UIGuideResult :: struct {
    closed: int
    finished: int
    changed: int
    step: int
}

IconSliderPopupProps :: struct {
    id: int
    x: int
    y: int
    icon_size: int
    icon_padding: int
    icon_type: int
    open: int*
    value: int*
    min: int
    max: int
    popup_width: int
    popup_height: int
}

IconRowAction :: struct {
    icon_type: int
    disabled: int
}

IconRowRequest :: struct {
    center_x: int
    view_width: int
    view_height: int
    count: int
    items: const IconRowAction*
}

ProfileImagePickerProps :: struct {
    title: const char*
    selected_icon_type: IconType*
    close_icon_type: int
    max_width: int
    scroll_offset: int*
}

ProfileImagePickerResult :: struct {
    closed: int
    changed: int
    selected_index: int
    selected_icon_type: IconType
}

#enum {
    SETTINGS_SPEED_MIN = 1
