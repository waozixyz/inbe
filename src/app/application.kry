view_height :: int = APP_DEFAULT_HEIGHT #global #export

static app_full_view_width: int = APP_DEFAULT_WIDTH

# Theme colors are now accessed via theme accessor functions

app_leave_practice_config :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    if app->settings_dirty {
        save_settings(app)
    }
    {
        practice: const PracticeDefinition* = practice_get(app->exercise_type)
        if practice->leave_config != nil {
            practice->leave_config(app)
        }
    }
    app->settings_scroll = 0
}

app_request_desktop_close :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    # Configured close behaviour overrides the ask prompt (desktop only).
    if app->desktop_close_action == CLOSE_QUIT {
        app->request_quit = 1
        return
    }
    #if #defined(DESKTOP_TRAY_ENABLED) {
        if !desktop_tray_ready() {
            app->request_quit = 1
            return
        }
    }
    if app->desktop_close_action == CLOSE_KEEP_RUNNING {
        #if #defined(DESKTOP_TRAY_ENABLED) {
            if !desktop_tray_keep_running() {
                app->request_quit = 1
            }
        } #else {
            app->request_quit = 1
        }
        return
    }
    app->close_prompt_open = 1
    app_block_current_click(app)
    app->close_prompt_result = AppClosePromptNone
}

#
# Desktop quit request from an explicit command such as Ctrl+Q. Window-close
# requests may still ask whether to keep running, but a quit command should
# always terminate the app.
#

app_request_desktop_quit :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    app->request_quit = 1
}

app_consume_close_prompt_result :: (app: InnerBreeze*) -> AppClosePromptResult #export {
    result: AppClosePromptResult
    if app == nil {
        return AppClosePromptNone
    }
    result = app->close_prompt_result
    app->close_prompt_result = AppClosePromptNone
    return result
}

app_draw_session_exit_modal :: (can_save: int, save_message: const char*, discard_message: const char*) -> SessionExitModalResult #export {
    modal_result: int
    if can_save {
        actions: [3] ModalAction = {
            {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
            {GetLocaleText("save_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
            {GetLocaleText("discard_button"), ButtonToneDanger, ButtonEmphasisSoft, 0},
        }
        modal_result = Modal((ModalProps){.title = GetLocaleText("exit_session_title"),
            .message = save_message,
            .actions = actions,
            .action_count = 3})
        if modal_result == 2 {
            return SessionExitModalSave
        }
        if modal_result == 3 {
            return SessionExitModalDiscard
        }
    } else {
        actions: [2] ModalAction = {
            {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
            {GetLocaleText("exit_button"), ButtonToneDanger, ButtonEmphasisFilled, 0},
        }
        modal_result = Modal((ModalProps){.title = GetLocaleText("exit_session_title"),
            .message = discard_message,
            .actions = actions,
            .action_count = 2})
        if modal_result == 2 {
            return SessionExitModalDiscard
        }
    }
    return modal_result == 1 ? SessionExitModalCancel : SessionExitModalNone
}

app_draw_close_prompt :: (app: InnerBreeze*) #private {
    modal_result: int
    actions: [2] ModalAction
    props: ModalProps
    if app == nil || !app->close_prompt_open {
        return
    }
    if app->blocked_input_frame == app->breathing.frame {
        return
    }
    ClearInputCaptures()
    memset(actions, 0, sizeof(actions))
    actions[0].label = GetLocaleText("desktop_close_keep_running_button")
    actions[0].tone = ButtonToneAccent
    actions[0].emphasis = ButtonEmphasisFilled
    actions[1].label = GetLocaleText("desktop_close_quit_button")
    actions[1].tone = ButtonToneDanger
    actions[1].emphasis = ButtonEmphasisFilled
    memset(&props, 0, sizeof(props))
    props.title = GetLocaleText("desktop_close_prompt_title")
    props.message = GetLocaleText("desktop_close_prompt_message")
    props.actions = actions
    props.action_count = 2
    props.max_width = 420
    modal_result = Modal(props)
    if modal_result == -1 {
        app->close_prompt_open = 0
    } else if modal_result == 1 {
        app->close_prompt_open = 0
        app->close_prompt_result = AppClosePromptKeepRunning
    } else if modal_result == 2 {
        app->close_prompt_open = 0
        app->close_prompt_result = AppClosePromptQuit
    }
}

exercise_manual_seen_bit :: (exercise_type: int) -> int #private {
    if exercise_type < 0 || exercise_type >= EXERCISE_COUNT {
        return 0
    }
    return 1 << exercise_type
}

exercise_manual_seen :: (app: InnerBreeze*, exercise_type: int) -> int #export {
    bit: int = exercise_manual_seen_bit(exercise_type)
    if app == nil || bit == 0 {
        return 1
    }
    return (app->exercise_manual_seen_mask & bit) != 0
}

mark_exercise_manual_seen :: (app: InnerBreeze*, exercise_type: int) #export {
    bit: int = exercise_manual_seen_bit(exercise_type)
    if app == nil || bit == 0 {
        return
    }
    if (app->exercise_manual_seen_mask & bit) == 0 {
        app->exercise_manual_seen_mask |= bit
        save_settings(app)
    }
}

app_reload_graphics_resources :: (app: InnerBreeze*) #private {
    empty: Texture2D
    if app == nil || !app->graphics_reload_requested {
        return
    }
    app->graphics_reload_requested = 0
    if app_running_in_kryon_preview() {
        return
    }
    TraceLog(LOG_INFO, "ANDROID: Reloading graphics resources")
    memset(&empty, 0, sizeof(empty))
    app->font_shapes_texture = empty
    discard_locale_font_cpu(app)
    if !load_locale_font(app) {
        TraceLog(LOG_WARNING, "FONT: Failed to reload Noto UI font")
    }
}

refresh_locale_dependent_text :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    if !config.title_custom {
        snprintf(config.title, sizeof(config.title), "%s", GetLocaleText("app_title"))
    }
    manual_screen_reset_layouts(app)
    app->language_index = GetCurrentLocaleIndex()
    if app->language_index < 0 {
        app->language_index = 0
    }
}

apply_language_code :: (app: InnerBreeze*, code: const char*) #private {
    if app == nil {
        return
    }
    if code == nil || code[0] == '\0' {
        code = "en"
    }
    if !SetLocale(code) {
        code = "en"
        SetLocale(code)
    }
    snprintf(app->language, sizeof(app->language), "%s", code)
    if !load_locale_font(app) {
        TraceLog(LOG_WARNING, "FONT: Failed to load Noto UI font for locale %s", code)
    }
    refresh_locale_dependent_text(app)
}

apply_system_language_selection :: (app: InnerBreeze*, save_now: int) #export {
    if app == nil {
        return
    }
    app->language_system = 1
    app->language_selected = 1
    apply_language_code(app, GetDefaultLocaleCode())
    if save_now {
        save_settings(app)
    }
}

apply_language_selection :: (app: InnerBreeze*, language_index: int, save_now: int) #export {
    code: const char*
    if app == nil {
        return
    }
    if language_index < 0 || language_index >= GetLocaleCount() {
        language_index = 0
    }
    code = GetLocaleCode(language_index)
    if code == nil || code[0] == '\0' {
        code = "en"
    }
    app->language_system = 0
    app->language_selected = 1
    apply_language_code(app, code)
    if save_now {
        save_settings(app)
    }
}

app_accept_language_selection :: (app: InnerBreeze*) #export {
    first_language_setup: int
    if app == nil {
        return
    }
    first_language_setup = storage_get_setting_int("language_setup_done", 0) == 0
    if app->language_system || !app->language_selected {
        apply_system_language_selection(app, 1)
    } else {
        save_settings(app)
    }
    #if #defined(PLATFORM_WEB) {
        sync_web_storage_critical()
    }
    if first_language_setup && habits_seed_default_set_if_needed(&app->habits) {
        app_restore_habits_view_settings(app)
    }
}

load_config :: () #private {
    if config.loaded {
        return
    }
    if config.title[0] == '\0' {
        snprintf(config.title, sizeof(config.title), "%s", GetLocaleText("app_title"))
        config.title_custom = 0
    }
    #if #defined(PLATFORM_WEB) {
        refresh_theme_colors(THEME_SKY, 1)
    } #else {
        refresh_theme_colors(THEME_SKY, 0)
    }
    config.loaded = 1
}

clampi :: (value: int, min: int, max: int) -> int #export {
    if value < min {
        return min
    }
    if value > max {
        return max
    }
    return value
}

count_from_int :: (dst: [CountSize] char, value: int) #export {
    value = clampi(value, 0, 999)
    dst[0] = (char)('0' + (value / 100) % 10)
    dst[1] = (char)('0' + (value / 10) % 10)
    dst[2] = (char)('0' + value % 10)
    dst[3] = 0
}

int_from_count :: (src: [CountSize] const char) -> int #export {
    a: int = (src[0] >= '0' && src[0] <= '9') ? src[0] - '0' : 0
    b: int = (src[1] >= '0' && src[1] <= '9') ? src[1] - '0' : 0
    c: int = (src[2] >= '0' && src[2] <= '9') ? src[2] - '0' : 0
    return a * 100 + b * 10 + c
}

app_restore_habits_view_settings :: (app: InnerBreeze*) #private {
    screen_mode: int
    habit_tab: int
    view_mode: int
    if app == nil {
        return
    }
    screen_mode = storage_get_setting_int("habits_screen_mode", HABITS_SCREEN_OVERVIEW)
    habit_tab = storage_get_setting_int("habits_tab", HABIT_TAB_WEEKLY)
    view_mode = storage_get_setting_int("habits_view_mode", HABIT_VIEW_WEEKLY)
    app->habits.screen_mode = clampi(screen_mode, HABITS_SCREEN_OVERVIEW,
    HABITS_SCREEN_STATISTICS)
    app->habits.tab = clampi(habit_tab, HABIT_TAB_WEEKLY, HABIT_TAB_COUNT - 1)
    app->habits.view_mode = clampi(view_mode, HABIT_VIEW_CALENDAR, HABIT_VIEW_WEEKLY)
    # The cards screen is the root. Restoring settings must not reopen a
    # habit card automatically; only the chevron expands a card.
    app->habits.selected = -1
}

app_reload_after_import :: (app: InnerBreeze*, reload_settings: int) #export {
    detail_habit_id: [HABIT_ID_SIZE] char = ""
    detail_index: int = -1
    view_mode: int = HABIT_VIEW_CALENDAR
    habit_tab: int = HABIT_TAB_WEEKLY
    month_offset: int = 0
    scroll: int = 0
    weekly_days: int = 0
    hold_stats_range_days: int = 0
    i: int
    if app == nil {
        return
    }
    if !reload_settings {
        if app->habit_detail_index >= 0 && app->habit_detail_index < app->habits.count {
            snprintf(detail_habit_id, sizeof(detail_habit_id), "%s",
            app->habits.items[app->habit_detail_index].id)
        }
        detail_index = app->habit_detail_index
        view_mode = app->habits.view_mode
        habit_tab = app->habits.tab
        month_offset = app->habits.month_offset
        scroll = app->habits.scroll
        weekly_days = app->habits.weekly_days
        hold_stats_range_days = app->habits.hold_stats_range_days
    }
    if reload_settings {
        if app_load_settings(app) {
            save_settings(app)
        }
        app_apply_style(app)
        reset_settings_preview(app)
        practice_update_session_sounds(app)
    }
    habits_init_with_defaults(&app->habits, app->language_selected)
    if reload_settings {
        app_restore_habits_view_settings(app)
    }
    if !reload_settings {
        app->habits.selected = -1
        app->habit_detail_index = -1
        for i = 0; i < app->habits.count; i++ {
            if detail_habit_id[0] != '\0' &&
            strcmp(app->habits.items[i].id, detail_habit_id) == 0 {
                app->habit_detail_index = i
                break
            }
        }
        if app->habit_detail_index < 0 && detail_index >= 0 && detail_index < app->habits.count {
            app->habit_detail_index = detail_index
        }
        app->habits.view_mode = view_mode
        app->habits.tab = habit_tab
        app->habits.month_offset = month_offset
        app->habits.scroll = scroll
        app->habits.weekly_days = weekly_days
        app->habits.hold_stats_range_days = hold_stats_range_days == 31 ? 31 : 7
    }
    if app->habit_detail_index >= app->habits.count {
        app->habit_detail_index = -1
    }
    if app->habits.selected >= app->habits.count {
        app->habits.selected = -1
    }
    app->habit_session_edit.active = 0
    app->habit_edit.active = 0
}

#if ANDROID_BUILD {
    app_request_graphics_reload :: (app: InnerBreeze*) #export {
        if app != nil {
            app->graphics_reload_requested = 1
        }
    }
}

app_draw_blank_home_easteregg :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    available_h := view_height - app_content_bottom_reserved(app)
    if available_h < Scale(120) {
        available_h = view_height
    }
    Image((ImageProps){
        .asset_path = "assets/easteregg/art.png",
        .bounds = {0, 0, (float)view_width, (float)available_h},
        .fit = ImageFitCover
    })
    logo_size := (float)view_width * 0.58f
    if logo_size > (float)available_h * 0.58f {
        logo_size = (float)available_h * 0.58f
    }
    if logo_size > (float)Scale(320) {
        logo_size = (float)Scale(320)
    }
    bounds := (Rectangle){((float)view_width - logo_size) / 2,
        ((float)available_h - logo_size) / 2, logo_size, logo_size}
    if Button((ButtonProps){
        .bounds = bounds,
        .image = (ImageProps){
            .asset_path = "assets/easteregg/waozi.png",
            .bounds = bounds, .fit = ImageFitContain
        },
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisGhost
    }) {
        OpenURI("https://waozi.xyz")
    }
}

app_apply_initial_screen :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    if !app->language_selected {
        app->breathing.screen = ScreenLanguage
        app->habits.focus_selected_tab = 0
        return
    }
    app->breathing.screen = app_screen_for_main_tab(app->main_tab)
    app->habits.focus_selected_tab = app->breathing.screen == ScreenHabits
}

app_init :: (vapp: void*) #export {
    app: InnerBreeze* = vapp
    i: int
    if app == 0 {
        return
    }
    #if ANDROID_BUILD {
        if practice_active(app) != nil {
            android_allow_screen_off()
        }
        practice_active_background_stop(app)
    }
    InitLocale()
    InitDPI()
    TraceLog(LOG_INFO, "APP: app init width=%d height=%d embedded=%d",
    config.width, config.height, config.loaded)
    load_config()
    app_notifications_init(app)
    view_width = config.width > 0 ? config.width : APP_DEFAULT_WIDTH
    view_height = config.height > 0 ? config.height : APP_DEFAULT_HEIGHT
    UpdateDPI(view_width, view_height)
    view_width = GetLayoutWidth()
    view_height = GetLayoutHeight()
    {
        user_scale: float = app->ui_scale_tenths > 0
        ? (float)app->ui_scale_tenths / 10.0f
        : 1.0f
        InitInterface(view_width, view_height, user_scale)
    }
    TraceLog(LOG_INFO, "APP: render scale=%.2f layout=%dx%d",
    GetRenderScale(), view_width, view_height)
    #if ANDROID_BUILD {
        SetTextInputPlatformCallback(android_device_set_soft_keyboard_visible)
    }
    breath_session_init(&app->breathing)
    break_engine_init(&app->breaks)
    app->breaks_enabled = 0
    app->desktop_startup_mode = STARTUP_SHOW
    app->desktop_close_action = CLOSE_ASK
    app->break_hud_x = -1
    app->break_hud_y = -1
    #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
        app->break_sounds_enabled = 1
    } #else {
        app->break_sounds_enabled = 0
    }
    data_init()
    if app_load_settings(app) {
        save_settings(app)
    }
    app_apply_style(app)
    app_init_donation_reminder_observed_practice_count(app)
    if !load_locale_font(app) {
        TraceLog(LOG_WARNING, "FONT: Failed to load Noto UI font -> using built-in default")
    }
    update_check_start()
    app->practice_tab = PRACTICE_TAB_PLAY
    app->practice_config_tab = 0
    memset(&app->session_result, 0, sizeof(app->session_result))
    if app->language_needs_save {
        save_settings(app)
        app->language_needs_save = 0
    }
    habits_init_with_defaults(&app->habits, app->language_selected)
    app_restore_habits_view_settings(app)
    app->habit_detail_index = -1
    app->elist.editing_item = -1
    memset(&app->habit_session_edit, 0, sizeof(app->habit_session_edit))
    app->habit_session_edit.round = -1
    app_apply_initial_screen(app)
    practice_update_circle_bounds(app, app_content_top_reserved(app),
    app_content_bottom_reserved(app))
    #if !#defined(PLATFORM_WEB) {
        if !app_running_in_kryon_preview() {
            init_audio(app)
        }
    }
    for i = 0; i < practice_count(); i++ {
        practice: const PracticeDefinition* = practice_get(i)
        if practice->init != nil {
            practice->init(app)
        }
    }
    memset(&app->camera, 0, sizeof(app->camera))
    app->play_circle_hover = 0
    app->play_circle_scale = 1.0f
    app->settings_tab = SETTINGS_TAB_DEVICE
    app->settings_overview = 1
    memset(&app->habit_edit, 0, sizeof(app->habit_edit))
    app->habit_edit.index = -1
    app->habit_edit.color.r = 99
    app->habit_edit.color.g = 196
    app->habit_edit.color.b = 165
    app->habit_edit.color.a = 255
    app->habit_edit.sync_mode = HABIT_SYNC_NONE
    practice_update_session_sounds(app)
    reset_settings_preview(app)
    breath_session_init(&app->start_speed_preview)
    # Icons resolve from Kryon's embedded sheets; no app-side textures.
    memset(&app->modal, 0, sizeof(app->modal))
    app->meditation.duration_seconds = 0
    app->meditation.remaining_seconds = 0
    app->meditation.frame_ticks = 0
    app_auto_sync(app)
}

handle_back_button :: (app: InnerBreeze*) #private {
    # If modal is active, let modal drawing handle it
    if app->modal.active {
        return
    }
    switch app->breathing.screen {
        case ScreenStart:
        if app->practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        if app->practice_tab != PRACTICE_TAB_PLAY {
            route: AppRoute = app_current_route(app)
            route.practice_tab = PRACTICE_TAB_PLAY
            app->manual_scroll = 0
            app->settings_scroll = 0
            app->tutorial_step = 0
            app_switch_route(app, route)
            break
        }
        break
        case ScreenSettings:
        app_settings_back(app)
        break
        case ScreenProfile:
        profile_screen_back(app)
        break
        case ScreenCustomizeNav:
        app_switch_screen(app, app->main_tab == APP_MAIN_TAB_HABITS
        ? ScreenHabits
        : ScreenStart)
        break
        case ScreenPracticeConfig:
        app_leave_practice_config(app)
        app_switch_screen(app, ScreenStart)
        break
        case ScreenHabits:
        if app->habits.screen_mode == HABITS_SCREEN_HISTORY ||
        app->habits.screen_mode == HABITS_SCREEN_STATISTICS {
            app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
            app->habits.selected = -1
            app->habits.tab = HABIT_TAB_WEEKLY
            app->habits.view_mode = HABIT_VIEW_WEEKLY
            app->habits.scroll = 0
            save_settings(app)
            break
        }
        if app->habits.tab == HABIT_TAB_EDIT && app->habit_edit.active {
            habit_edit_cancel(app)
            break
        }
        app_switch_screen(app, ScreenStart)
        break
        case ScreenEList:
        app_switch_screen(app, app_screen_for_main_tab(APP_MAIN_TAB_PRACTICE))
        break
        case ScreenHabitEdit:
        habit_edit_cancel(app)
        app_switch_screen(app, ScreenHabits)
        break
        case ScreenHabitSessionEdit:
        habit_session_cancel_edit(app)
        app_switch_screen(app, ScreenHabits)
        break
        case ScreenLanguage:
        break
        case ScreenManual:
        manual_screen_close_tutorial(app, 0)
        break
        case ScreenResults:
        practice_ensure_results_saved(app)
        #if ANDROID_BUILD {
            android_allow_screen_off()
            android_wakelock_release()
        }
        app_init(app)
        break
        case ScreenSession:
        # When paused, exit immediately
        if app->session_paused {
            practice_active_background_stop(app)
            app_init(app)
        } else {
            # Show confirmation modal
            app_open_modal(app, UIModalConfirmExitSession)
        }
        break
        case ScreenMeditation:
        {
            practice: const PracticeDefinition* = practice_get(PRACTICE_MEDITATION)
            if practice->request_exit != nil {
                practice->request_exit(app)
            }
        }
        break
        case ScreenPatterns:
        {
            practice: const PracticeDefinition* = practice_get(PRACTICE_PATTERNS)
            if practice->request_exit != nil {
                practice->request_exit(app)
            }
        }
        break
        default:
        break
    }
}

draw_profile_picture_picker_modal :: (app: InnerBreeze*) #private {
    result: ProfileImagePickerResult
    props: ProfileImagePickerProps
    if app == nil {
        return
    }
    memset(&props, 0, sizeof(props))
    props.title = "Profile picture"
    props.selected_icon_type = &app->profile_picture_icon
    props.close_icon_type = ICON_X
    props.max_width = 520
    props.scroll_offset = &app->profile_picture_picker_scroll
    result = AppProfileImagePickerModal(props)
    if result.changed {
        save_settings(app)
    }
    if result.closed {
        app_close_modal(app)
    }
}

app_donation_address_box_height :: (address: const char*, w: int, font: int) -> int #private {
    pad: int = Scale(10)
    unused address
    unused w
    return AppTextLineHeight(font) + pad * 2
}

app_donation_coin_section_height :: (address: const char*, w: int) -> int #private {
    label_font: int = AppFontSize()
    address_font: int = AppSmallFontSize()
    pad: int = Scale(12)
    button_h: int = Scale(36)
    gap: int = Scale(8)
    content_w: int = w - pad * 2
    action_h: int = button_h
    if content_w < Scale(120) {
        content_w = Scale(120)
    }
    if app_donation_button_stack(content_w) {
        action_h = button_h * 3 + gap * 2
    }
    return pad +
    AppTextLineHeight(label_font) +
    Scale(6) +
    app_donation_address_box_height(address, content_w, address_font) +
    Scale(10) + action_h + pad
}

static app_donation_bitcoin_text: [96] char

static app_donation_monero_text: [160] char

static app_donation_bitcoin_cursor: int

static app_donation_monero_cursor: int

static app_donation_bitcoin_focused: int

static app_donation_monero_focused: int

static app_donation_bitcoin_scroll: int

static app_donation_monero_scroll: int

static app_donation_modal_scroll: int

app_donation_button_stack :: (w: int) -> int #private {
    return w < Scale(330)
}

app_donation_address_preview :: (address: const char*, out: char*, out_size: size_t) #private {
    len: size_t
    head: int = 14
    tail: int = 14

    if out == nil || out_size == 0 {
        return
    }
    out[0] = '\0'
    if address == nil {
        return
    }
    len = strlen(address)
    if len <= (size_t)(head + tail + 3) || out_size <= (size_t)(head + tail + 4) {
        snprintf(out, out_size, "%s", address)
        return
    }
    snprintf(out, out_size, "%.*s...%s", head, address,
             address + len - (size_t)tail)
}

app_draw_donation_coin_section :: (label: const char*, address: const char*, wallet_url: const char*, trocador_url: const char*, address_text: char*, address_text_size: size_t, cursor: int*, focused: int*, scroll: int*, focus_id: int, x: int, w: int, y: int*) #private {
    label_font: int = AppFontSize()
    address_font: int = AppSmallFontSize()
    pad: int = Scale(12)
    button_h: int = Scale(36)
    gap: int = Scale(8)
    content_x: int = x + pad
    content_w: int = w - pad * 2
    button_w: int = (content_w - gap * 2) / 3
    stack_buttons: int = app_donation_button_stack(content_w)
    card_y: int = y != nil ? *y : 0
    card_h: int
    box_h: int
    address_y: int
    address_preview: [80] char = {0}
    if y == nil {
        return
    }
    unused cursor
    unused focused
    unused scroll
    if address_text == nil || address_text_size == 0 {
        return
    }
    snprintf(address_text, address_text_size, "%s", address)
    app_donation_address_preview(address, address_preview, sizeof(address_preview))
    card_h = app_donation_coin_section_height(address, w)
    DrawRectangleRounded((Rectangle){(float)x, (float)card_y, (float)w,
        (float)card_h}, 0.08f, 8,
    DarkenColor(StyleTokenColor("canvas"), 5))
    DrawRectangleRoundedLinesEx((Rectangle){(float)x, (float)card_y,
        (float)w, (float)card_h}, 0.08f, 8,
    (float)Scale(1),
    DarkenColor(StyleTokenColor("canvas"), 26))
    *y = card_y + pad
    Text((TextProps){
        .bounds = {(float)content_x, (float)*y, 0, 0},
        .text = label,
        .wrap = TextWrapNone,
    })
    *y += AppTextLineHeight(label_font) + Scale(6)
    box_h = app_donation_address_box_height(address, content_w, address_font)
    unused focus_id
    DrawRectangleRounded((Rectangle){(float)content_x, (float)*y,
                         (float)content_w, (float)box_h},
                         0.06f, 8, StyleTokenColor("accent"))
    DrawRectangleRoundedLinesEx((Rectangle){(float)content_x, (float)*y,
                                 (float)content_w, (float)box_h},
                                 0.06f, 8, (float)Scale(1),
                                 DarkenColor(StyleTokenColor("canvas"), 28))
    address_y = *y + (box_h - AppTextLineHeight(address_font)) / 2
    Text((TextProps){
        .bounds = {(float)(content_x + Scale(10)), (float)address_y,
                   (float)(content_w - Scale(20)),
                   (float)AppTextLineHeight(address_font)},
        .text = address_preview,
        .wrap = TextWrapNone,
        .vertical_align = TextAlignCenter
    })
    *y += box_h + Scale(10)
    if stack_buttons {
        button_w = content_w
    }
    if Button((ButtonProps){
        .bounds = {(float)(content_x), (float)(*y), (float)(button_w), (float)(button_h)},
        .label = GetLocaleText("copy_address_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        #if ANDROID_BUILD {
            android_copy_ok: int = android_device_copy_text_and_toast(address,
            GetLocaleText("address_copied"))
            if !android_copy_ok {
                SetClipboardTextValue(address)
                Toast((ToastProps){.message = GetLocaleText("address_copied")})
            }
        } #else {
            SetClipboardTextValue(address)
            Toast((ToastProps){.message = GetLocaleText("address_copied")})
        }
    }
    if stack_buttons {
        *y += button_h + gap
    }
    if Button((ButtonProps){
        .bounds = {(float)(stack_buttons ? content_x : content_x + button_w + gap), (float)(*y), (float)(button_w), (float)(button_h)},
        .label = GetLocaleText("open_wallet_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        if !OpenURI(wallet_url) {
            Toast((ToastProps){.message = GetLocaleText("wallet_not_installed_toast")})
        }
    }
    if stack_buttons {
        *y += button_h + gap
    }
    if Button((ButtonProps){
        .bounds = {(float)(stack_buttons ? content_x :
            content_x + (button_w + gap) * 2), (float)(*y), (float)(button_w), (float)(button_h)},
        .label = GetLocaleText("trocador_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        OpenURI(trocador_url)
    }
    *y = card_y + card_h
}

draw_about_donation_modal :: (app: InnerBreeze*) #private {
    frame: UIPanelFrame
    message: ParagraphSpec
    clip: Rectangle
    modal_w: int
    modal_h: int
    content_w: int
    max_modal_h: int
    message_h: int
    content_h: int
    coin_w: int
    coin_gap: int
    bitcoin_h: int
    monero_h: int
    coins_h: int
    columns: int
    scroll_h: int
    max_scroll: int
    track_h: int
    thumb_h: int
    y: int
    coin_y: int
    button_w: int
    button_h: int = Scale(36)
    empty_icon: Texture2D
    if app == nil {
        return
    }
    modal_w = Scale(760)
    if view_width < Scale(820) {
        modal_w = Scale(460)
    }
    if modal_w > view_width - Scale(24) {
        modal_w = view_width - Scale(24)
    }
    if modal_w < Scale(240) {
        modal_w = Scale(240)
    }
    content_w = modal_w - Scale(36)
    coin_gap = Scale(12)
    columns = content_w >= Scale(640)
    coin_w = columns ? (content_w - coin_gap) / 2 : content_w
    memset(&message, 0, sizeof(message))
    message.text = GetLocaleText("about_donation_message")
    message.width = content_w
    message.font = AppSmallFontSize()
    message.line_gap = Scale(4)
    message_h = AppParagraphHeight(message.text, message.width, message.font,
    message.line_gap)
    bitcoin_h = app_donation_coin_section_height(app_bitcoin_donation_address(),
    coin_w)
    monero_h = app_donation_coin_section_height(app_monero_donation_address(),
    coin_w)
    coins_h = columns ? (bitcoin_h > monero_h ? bitcoin_h : monero_h)
    : bitcoin_h + coin_gap + monero_h
    content_h = message_h + Scale(16) + coins_h
    modal_h = Scale(58) + content_h + Scale(14) + button_h +
    Scale(16)
    max_modal_h = view_height - Scale(24)
    if modal_h > max_modal_h {
        modal_h = max_modal_h
    }
    if modal_h < Scale(260) {
        modal_h = Scale(260)
    }
    memset(&empty_icon, 0, sizeof(empty_icon))
    frame = AppModalFrame(modal_w, modal_h,
    GetLocaleText("donation_reminder_title"),
    0, 0)
    if frame.right_clicked {
        app_close_modal(app)
        return
    }
    button_w = Scale(120)
    if button_w > frame.content_w {
        button_w = frame.content_w
    }
    scroll_h = frame.content_h - button_h - Scale(14)
    if scroll_h < Scale(120) {
        scroll_h = Scale(120)
    }
    # App-owned scrolled region: wheel input, a clamped offset, and a thin
    # painted track. Kryon owns scrolling inside declarative Scroll blocks;
    # this modal predates them and keeps its own clamping.
    max_scroll = content_h - scroll_h
    if max_scroll < 0 {
        max_scroll = 0
    }
    app_donation_modal_scroll -= (int)(GetMouseWheelMove() * Scale(34))
    if app_donation_modal_scroll < 0 {
        app_donation_modal_scroll = 0
    }
    if app_donation_modal_scroll > max_scroll {
        app_donation_modal_scroll = max_scroll
    }
    clip = (Rectangle){
        (float)frame.content_x,
        (float)frame.content_y,
        (float)frame.content_w,
        (float)scroll_h
    }
    BeginScissorMode((int)clip.x, (int)clip.y, (int)clip.width,
    (int)clip.height)
    y = frame.content_y - app_donation_modal_scroll
    message.width = frame.content_w
    Paragraph(message, frame.content_x, &y)
    y += Scale(16)
    coin_y = y
    app_draw_donation_coin_section("Bitcoin",
    app_bitcoin_donation_address(),
    app_bitcoin_wallet_url(),
    app_bitcoin_trocador_url(),
    app_donation_bitcoin_text,
    sizeof(app_donation_bitcoin_text),
    &app_donation_bitcoin_cursor,
    &app_donation_bitcoin_focused,
    &app_donation_bitcoin_scroll,
    6101,
    frame.content_x, coin_w, &coin_y)
    if columns {
        coin_y = y
        app_draw_donation_coin_section("Monero",
        app_monero_donation_address(),
        app_monero_wallet_url(),
        app_monero_trocador_url(),
        app_donation_monero_text,
        sizeof(app_donation_monero_text),
        &app_donation_monero_cursor,
        &app_donation_monero_focused,
        &app_donation_monero_scroll,
        6102,
        frame.content_x + coin_w +
        coin_gap,
        coin_w, &coin_y)
    } else {
        coin_y += coin_gap
        app_draw_donation_coin_section("Monero",
        app_monero_donation_address(),
        app_monero_wallet_url(),
        app_monero_trocador_url(),
        app_donation_monero_text,
        sizeof(app_donation_monero_text),
        &app_donation_monero_cursor,
        &app_donation_monero_focused,
        &app_donation_monero_scroll,
        6102,
        frame.content_x, coin_w, &coin_y)
    }
    EndScissorMode()
    if max_scroll > 0 {
        track_h = scroll_h - Scale(8)
        thumb_h = track_h * scroll_h / content_h
        if thumb_h < Scale(24) {
            thumb_h = Scale(24)
        }
        DrawRectangle(frame.content_x + frame.content_w - Scale(6),
        clip.y + Scale(4) +
        (track_h - thumb_h) * app_donation_modal_scroll /
        max_scroll,
        Scale(3), thumb_h,
        Fade(StyleTokenColor("text"), 0.28f))
    }
    if Button((ButtonProps){
        .bounds = {(float)(frame.x + (frame.w - button_w) / 2), (float)(frame.y + frame.h - button_h - Scale(16)), (float)(button_w), (float)(button_h)},
        .label = GetLocaleText("close_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        app_close_modal(app)
    }
}

draw_donation_reminder_modal :: (app: InnerBreeze*) #private {
    modal_result: int
    actions: [3] ModalAction
    props: ModalProps
    if app == nil {
        return
    }
    memset(actions, 0, sizeof(actions))
    actions[0].label = GetLocaleText("donation_reminder_donate_button")
    actions[0].tone = ButtonToneAccent
    actions[0].emphasis = ButtonEmphasisFilled
    actions[1].label = GetLocaleText("donation_reminder_skip_button")
    actions[1].tone = ButtonToneNeutral
    actions[1].emphasis = ButtonEmphasisSoft
    actions[2].label = GetLocaleText("donation_reminder_dismiss_button")
    actions[2].tone = ButtonToneDanger
    actions[2].emphasis = ButtonEmphasisFilled
    memset(&props, 0, sizeof(props))
    props.title = GetLocaleText("donation_reminder_title")
    props.message = GetLocaleText("donation_reminder_message")
    props.actions = actions
    props.action_count = 3
    props.max_width = 420
    modal_result = Modal(props)
    if modal_result == -1 {
        app_record_donation_reminder_seen(app)
        app_close_modal(app)
    } else if modal_result > 0 {
        app_handle_donation_reminder_action(app, modal_result)
    }
}

static draw_secure_migration_modal_no_texture: const Texture2D

draw_secure_migration_modal :: (app: InnerBreeze*) #private {
    status: StorageSyncStatus
    frame: UIPanelFrame
    message: ParagraphSpec
    message_text: const char*
    modal_h: int
    message_h: int
    y: int
    button_y: int
    button_h: int
    gap: int
    if app == nil {
        return
    }
    memset(&status, 0, sizeof(status))
    storage_sync_status(&status)
    if !status.has_account || !status.enabled {
        app_close_modal(app)
        return
    }
    if !status.secure_migration_pending {
        message_text = GetLocaleText("sync_secure_migration_done_message")
    } else if app->secure_migration_started {
        message_text = GetLocaleText("sync_secure_migration_updating_message")
    } else {
        message_text = GetLocaleText("sync_secure_migration_message")
    }
    memset(&message, 0, sizeof(message))
    message.text = message_text
    message.width = Scale(380) - Scale(36)
    message.font = AppFontSize()
    message.line_gap = Scale(4)
    message_h = AppParagraphHeight(message.text, message.width, message.font,
    message.line_gap)
    button_h = Scale(36)
    gap = Scale(10)
    modal_h = Scale(74) + message_h + Scale(24) + button_h +
    Scale(24)
    if status.secure_migration_pending && app->secure_migration_started {
        modal_h += Scale(42)
    }
    if modal_h < Scale(210) {
        modal_h = Scale(210)
    }
    frame = AppModalFrame(Scale(380), modal_h,
    GetLocaleText("sync_secure_migration_title"),
    0, 0)
    y = frame.content_y
    message.width = frame.content_w
    Paragraph(message, frame.content_x, &y)
    y += Scale(18)
    if status.secure_migration_pending && app->secure_migration_started {
        total: long long = status.secure_migration_total
        done: long long = status.secure_migration_done
        progress_label: [64] char
        progress_props: ProgressProps
        progress_max: int
        progress_value: int
        if total <= 0 {
            total = status.secure_migration_queued > 0
            ? status.secure_migration_queued
            : 1
        }
        if done < 0 {
            done = 0
        }
        if done > total {
            done = total
        }
        progress_max = total > INT_MAX ? INT_MAX : (int)total
        progress_value = done > INT_MAX ? INT_MAX : (int)done
        snprintf(progress_label, sizeof(progress_label), "%lld / %lld",
        done, total)
        memset(&progress_props, 0, sizeof(progress_props))
        progress_props.bounds = (Rectangle){
            (float)frame.content_x,
            (float)y,
            (float)frame.content_w,
            (float)Scale(24)
        }
        progress_props.min = 0
        progress_props.max = progress_max > 0 ? progress_max : 1
        progress_props.value = progress_value
        progress_props.label = progress_label
        Progress(progress_props)
        return
    }
    button_y = frame.y + frame.h - Scale(24) - button_h
    if !status.secure_migration_pending {
        button_w: int = Scale(120)
        if Button((ButtonProps){
            .bounds = {(float)(frame.x + (frame.w - button_w) / 2), (float)(button_y), (float)(button_w), (float)(button_h)},
            .label = GetLocaleText("ok_button"),
            .tone = ButtonToneAccent,
            .emphasis = ButtonEmphasisFilled,
            .disabled = 0
        }) {
            app_close_modal(app)
        }
    } else {
        button_w: int = (frame.content_w - gap) / 2
        if Button((ButtonProps){
            .bounds = {(float)(frame.content_x), (float)(button_y), (float)(button_w), (float)(button_h)},
            .label = GetLocaleText("sync_secure_migration_later_button"),
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app->secure_migration_prompt_seen = 1
            app->secure_migration_deferred = 1
            app_close_modal(app)
        }
        if Button((ButtonProps){
            .bounds = {(float)(frame.content_x + button_w + gap), (float)(button_y), (float)(button_w), (float)(button_h)},
            .label = GetLocaleText("sync_secure_migration_start_button"),
            .tone = ButtonToneAccent,
            .emphasis = ButtonEmphasisFilled,
            .disabled = 0
        }) {
            app->secure_migration_prompt_seen = 1
            app->secure_migration_deferred = 0
            app->secure_migration_started = 1
            app_auto_sync(app)
        }
    }
}

draw_global_modal :: (app: InnerBreeze*) #private {
    modal_result: int
    if app == nil || !app->modal.active {
        return
    }
    if app->blocked_input_frame == app->breathing.frame {
        return
    }
    ClearInputCaptures()
    if settings_data_draw_modals(app) {
        return
    }
    if app->modal.type == UIModalDonationReminder {
        draw_donation_reminder_modal(app)
        return
    }
    if app->modal.type == UIModalSecureMigration {
        draw_secure_migration_modal(app)
        return
    }
    if app->modal.type == UIModalAboutDonation {
        draw_about_donation_modal(app)
        return
    }
    if app->modal.type == UIModalMeditationNetworkError {
        actions: [2] ModalAction = {
            {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
            {GetLocaleText("retry_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
        }
        modal_result = Modal((ModalProps){.title = GetLocaleText("meditation_music_network_error_title"),
            .message = GetLocaleText("meditation_music_network_error_message"),
            .actions = actions,
            .action_count = 2})
        if modal_result == 1 {
            TraceLog(LOG_INFO, "AUDIO: Network error download cancelled")
            app_close_modal(app)
        } else if modal_result == 2 {
            TraceLog(LOG_INFO, "AUDIO: Network error download retry requested")
            app_close_modal(app)
            meditation_music_start_download(app)
        }
    }
    if app->modal.type == UIModalAppIconPicker {
        settings_screen_draw_app_icon_modal(app)
        return
    }
    if app->modal.type == UIModalThemePicker {
        settings_screen_draw_theme_picker_modal(app)
    }
    if app->modal.type == UIModalProfilePicturePicker {
        draw_profile_picture_picker_modal(app)
        return
    }
    if app->modal.type == UIModalConfirmRemoveFriend {
        profile_screen_draw_remove_friend_modal(app)
        return
    }
    if app->modal.type == UIModalPracticeManual ||
    app->modal.type == UIModalPracticeConfig ||
    app->modal.type == UIModalEditProgressiveStartSpeed {
        practice_screen_draw_modal(app)
        return
    }
    if app->modal.type == UIModalSyncAlias {
        modal_result = settings_sync_account_draw_alias_modal(app)
        if modal_result == 1 {
            then_backup: int = app->sync_alias_then_backup
            app->sync_alias_then_backup = 0
            app_close_modal(app)
            settings_screen_set_status_success(GetLocaleText("sync_alias_saved"), nil)
            if then_backup {
                app_open_modal(app, UIModalSyncAccountBackup)
            }
        } else if modal_result == 2 {
            settings_screen_set_status_error(GetLocaleText("sync_alias_failed"))
        } else if modal_result == 3 {
            then_backup: int = app->sync_alias_then_backup
            app->sync_alias_then_backup = 0
            app_close_modal(app)
            if then_backup {
                app_open_modal(app, UIModalSyncAccountBackup)
            }
        }
    }
    if app->modal.type == UIModalSyncPublicId {
        modal_result = settings_sync_account_draw_public_id_modal(app)
        if modal_result != 0 {
            app_close_modal(app)
        }
    }
}

updateapp :: (app: InnerBreeze*) #private {
    hover: int = 0
    center_x: int = view_width / 2
    frame_view_height: int = view_height
    center_y: int
    i: int
    frame_route: AppRoute
    first_run_guide_active: int = 0
    habits_guide_active: int = 0
    practice_fullscreen_modal: int = 0
    global_modal_drawn: int = 0
    content_input_clip_active: int = 0
    bottom_input_reserved: int = 0
    input_rect: Rectangle
    input_clip_rect: Rectangle
    app_sync_route_from_url(app)
    frame_route = app_current_route(app)
    #if ANDROID_BUILD {
        {
            if android_take_pending_donation_reminder() {
                if app->modal.active {
                    app_close_modal(app)
                }
                app_open_modal(app, UIModalDonationReminder)
            }
        }
        {
            practice_id: int = android_take_pending_practice_start()
            if practice_id >= 0 {
                active_break: int
                practice: const PracticeDefinition*
                app->exercise_type = practice_clamp_id(practice_id)
                if app->modal.active {
                    app_close_modal(app)
                }
                active_break = break_engine_active_break(&app->breaks)
                if active_break >= 0 {
                    app_breaks_start_practice(app, active_break, app->exercise_type)
                } else {
                    app->main_tab = APP_MAIN_TAB_PRACTICE
                    app->practice_tab = PRACTICE_TAB_PLAY
                    practice = practice_get(app->exercise_type)
                    if practice != nil && practice->start != nil {
                        practice->start(app)
                    }
                }
            }
        }
    }
    app_breaks_update(app)
    app_notifications_tick(app)
    for i = 0; i < practice_count(); i++ {
        practice: const PracticeDefinition* = practice_get(i)
        if practice->update != nil {
            practice->update(app)
        }
    }
    if app->practice_coming_soon_ticks > 0 {
        app->practice_coming_soon_ticks--
    }
    practice_screen_prepare_first_run_guide(app)
    habits_screen_prepare_first_run_guide(app)
    first_run_guide_active = practice_screen_first_run_guide_active(app)
    habits_guide_active = habits_screen_first_run_guide_active(app)
    app_clear_invalid_screen_local_modal(app)
    app_maybe_open_donation_reminder(app, first_run_guide_active,
    habits_guide_active)
    practice_fullscreen_modal =
    app->modal.active &&
    app->modal.type == UIModalEditProgressiveStartSpeed
    input_rect.x = 0
    input_rect.y = 0
    input_rect.width = (float)view_width
    input_rect.height = (float)view_height
    if app->modal.active {
        BeginModalLayer()
    }
    if app->close_prompt_open || first_run_guide_active || habits_guide_active {
        PushInputCapture(input_rect, 0)
    }
    view_height = app_page_height(app, view_height)
    center_y = view_height / 2
    bottom_input_reserved = app_content_bottom_reserved(app)
    if bottom_input_reserved > 0 && bottom_input_reserved < view_height {
        input_clip_rect.x = 0
        input_clip_rect.y = 0
        input_clip_rect.width = (float)view_width
        input_clip_rect.height = (float)(view_height - bottom_input_reserved)
        PushInputClip(input_clip_rect)
        content_input_clip_active = 1
    }
    if app_nav_desktop_rail_enabled(app) {
        app_draw_bottom_nav(app)
    }
    back_requested := IsKeyPressed(KEY_BACK)
    #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
        if IsKeyPressed(KEY_BACKSPACE) &&
        ((app->breathing.screen == ScreenStart && app->practice_tab != PRACTICE_TAB_PLAY) ||
        app->breathing.screen == ScreenSession || app->breathing.screen == ScreenMeditation ||
        app->breathing.screen == ScreenSunSalutation || app->breathing.screen == ScreenPatterns) {
            back_requested = 1
        }
    }
    if back_requested {
        if app->close_prompt_open {
            app->close_prompt_open = 0
        } else if first_run_guide_active || habits_guide_active {
            if first_run_guide_active {
                practice_screen_dismiss_first_run_guide(app)
            }
            if habits_guide_active {
                habits_screen_dismiss_first_run_guide(app)
            }
        } else if app->modal.active {
            app_close_modal(app)
        } else {
            handle_back_button(app)
        }
    }
    #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
        # Ctrl+Q quits from any screen; Esc quits only from idle home.
        if IsKeyPressed(KEY_Q) &&
        (IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL)) {
            app_request_desktop_quit(app)
        } else if IsKeyPressed(KEY_ESCAPE) &&
        app->breathing.screen == ScreenStart &&
        app->practice_tab == PRACTICE_TAB_PLAY &&
        !app->modal.active &&
        !first_run_guide_active && !habits_guide_active {
            app_request_desktop_quit(app)
        }
    }
    switch app->breathing.screen {
        case ScreenSettings:
        settings_screen_draw(app)
        goto finish_frame
        case ScreenProfile:
        profile_screen_draw(app)
        goto finish_frame
        case ScreenCustomizeNav:
        app_draw_customize_nav_page(app)
        goto finish_frame
        case ScreenLanguage:
        language_screen_draw(app)
        goto finish_frame
        case ScreenHabits:
        draw_habits_screen(app)
        goto finish_frame
        case ScreenEList:
        draw_elist_screen(app)
        goto finish_frame
        case ScreenHabitEdit:
        habit_edit_draw(app)
        goto finish_frame
        case ScreenHabitSessionEdit:
        habit_session_draw_edit_screen(app)
        goto finish_frame
        case ScreenBreak:
        break_overlay_draw(app)
        goto finish_frame
    }
    if app->breathing.screen == ScreenStart {
        practice_update_circle_bounds(app, app_content_top_reserved(app),
        app_content_bottom_reserved(app))
    } else if app->breathing.screen == ScreenSession {
        practice_update_circle_bounds(app, AppTitleBarHeight(), 84)
    }
    if app->breathing.screen == ScreenSession {
        practice_draw_active_breathing(app, center_x, center_y)
    }
    switch app->breathing.screen {
        case ScreenStart:
        {
            if !practice_fullscreen_modal &&
            app->main_tab == APP_MAIN_TAB_NONE {
                app_draw_blank_home_easteregg(app)
            } else if !practice_fullscreen_modal &&
            app->main_tab != APP_MAIN_TAB_NONE {
                if app->practice_tab == PRACTICE_TAB_MANUAL {
                    manual_screen_draw(app)
                } else if app->practice_tab == PRACTICE_TAB_CONFIG {
                    practice: const PracticeDefinition* = practice_get(app->exercise_type)
                    if practice->draw_config != nil {
                        practice->draw_config(app)
                    }
                } else {
                    practice_screen_draw_home(app)
                }
            }
        }
        # Skip drawing on the same frame modal opens to prevent click propagation
        if app->modal.active && app->modal.type == UIModalMeditationSetup &&
        app->blocked_input_frame != app->breathing.frame {
            practice: const PracticeDefinition* = practice_get(PRACTICE_MEDITATION)
            if practice->draw_setup_modal != nil {
                practice->draw_setup_modal(app)
            }
        }
        break
        case ScreenSession:
        practice_update_active_breathing(app, center_x, center_y, &hover)
        break
        case ScreenMeditation:
        {
            practice: const PracticeDefinition* = practice_get(PRACTICE_MEDITATION)
            if practice->draw_active_session != nil {
                practice->draw_active_session(app, center_x, center_y)
            }
        }
        break
        case ScreenSunSalutation:
        {
            practice: const PracticeDefinition* = practice_get(PRACTICE_SUN_SALUTATION)
            if practice->draw_active_session != nil {
                practice->draw_active_session(app, center_x, center_y)
            }
        }
        break
        case ScreenPatterns:
        {
            practice: const PracticeDefinition* = practice_get(PRACTICE_PATTERNS)
            if practice->draw_active_session != nil {
                practice->draw_active_session(app, center_x, center_y)
            }
        }
        break
        case ScreenResults:
        practice_draw_results(app, center_x, center_y, &hover)
        break
    }
    finish_frame:
    if content_input_clip_active {
        PopInputClip()
    }
    if practice_fullscreen_modal {
        draw_global_modal(app)
        global_modal_drawn = 1
    }
    view_height = frame_view_height
    app_draw_bottom_nav(app)
    practice_screen_draw_first_run_guide(app)
    habits_screen_draw_first_run_guide(app)
    if !global_modal_drawn {
        draw_global_modal(app)
    }
    app_draw_close_prompt(app)
    app_flush_deferred_settings(app)
    app_observe_direct_route_change(app, frame_route)
    app->breathing.frame++
}

static app_update_draw_last_full_w: int = -1

static app_update_draw_last_full_h: int = -1

static app_update_draw_last_content_x: int = -1

static app_update_draw_last_content_w: int = -1

static app_update_draw_last_log_time: double = -1.0

app_update_draw :: (vapp: void*, viewport: Rectangle) #export {
    app: InnerBreeze* = vapp
    profile_frame_start: double = app_profile_now()
    profile_update_start: double
    profile_habits_start: double
    profile_sync_start: double
    full_width: int
    full_height: int
    content_x: int = 0
    rail_width: int = 0
    top_height: int = 0
    content_w: int
    layout_width: int
    layout_height: int
    layout_content_x: int
    layout_content_w: int
    render_scale: float
    if app == 0 || viewport.width <= 0 || viewport.height <= 0 {
        return
    }
    app_update_frame_pacing(app)
    app_reload_graphics_resources(app)
    full_width = (int)viewport.width
    full_height = (int)viewport.height
    view_width = full_width
    view_height = full_height
    # Update DPI cache
    UpdateDPI(view_width, view_height)
    if !(GetDPIScale() > 0.0f) || GetDPIScale() > 8.0f {
        TraceLog(LOG_WARNING, "APP_EMBED: repairing invalid dpi %.2f for %dx%d",
        GetDPIScale(), view_width, view_height)
        InitDPI()
        UpdateDPI(view_width, view_height)
    }
    layout_width = GetLayoutWidth()
    layout_height = GetLayoutHeight()
    render_scale = GetRenderScale()
    if !(render_scale > 0.0f) {
        render_scale = 1.0f
    }
    app_full_view_width = layout_width
    view_width = layout_width
    view_height = layout_height
    SetViewSize(view_width, view_height)
    {
        user_scale: float = app->ui_scale_tenths > 0
        ? (float)app->ui_scale_tenths / 10.0f
        : 1.0f
        InitInterface(view_width, view_height, user_scale)
    }
    # Freeze responsive navigation from the full viewport before narrowing content.
    app_capture_navigation_viewport(app)
    rail_width = app_nav_desktop_rail_enabled(app) ? app_nav_desktop_rail_width(app) : 0
    layout_content_x = app_navigation_placement(app) == NAVIGATION_LEFT ? rail_width : 0
    layout_content_w = layout_width - rail_width
    if layout_content_w < 1 {
        layout_content_w = 1
    }
    content_x = (int)((float)layout_content_x * render_scale + 0.5f)
    rail_width = (int)((float)rail_width * render_scale + 0.5f)
    top_height = app_navigation_placement(app) == NAVIGATION_TOP
        ? (int)((float)app_navigation_height(app) * render_scale + 0.5f) : 0
    if app->modal.active {
        BeginModalLayer()
    }
    practice_update_circle_bounds(app, app_content_top_reserved(app),
    app_content_bottom_reserved(app))
    app_device_preferences_update(app)
    update_check_poll()
    app_refresh_theme(app)
    DrawRectangleRec(viewport, StyleTokenColor("canvas"))
    content_w = full_width - rail_width
    if content_w < 1 {
        content_w = 1
    }
    {
        now: double = GetTime()
        changed: int = full_width != app_update_draw_last_full_w || full_height != app_update_draw_last_full_h ||
        content_x != app_update_draw_last_content_x || content_w != app_update_draw_last_content_w
        if changed && (app_update_draw_last_log_time < 0.0 || now - app_update_draw_last_log_time >= 0.25) {
            TraceLog(LOG_INFO, "APP_EMBED: geometry viewport=%dx%d layout=%dx%d content_x=%d content=%dx%d render_scale=%.2f",
            full_width, full_height, layout_width, layout_height,
            layout_content_x, layout_content_w, layout_height,
            GetRenderScale())
            app_update_draw_last_log_time = now
        }
        if changed {
            app_update_draw_last_full_w = full_width
            app_update_draw_last_full_h = full_height
            app_update_draw_last_content_x = content_x
            app_update_draw_last_content_w = content_w
        }
    }
    view_width = layout_content_w
    view_height = layout_height - (int)((float)top_height / render_scale + 0.5f)
    SetViewSize(view_width, view_height)
    memset(&app->camera, 0, sizeof(app->camera))
    app->camera.zoom = render_scale
    app->camera.offset.x = IsInspectActive() ? 0.0f : viewport.x + content_x
    app->camera.offset.y = IsInspectActive() ? 0.0f : viewport.y + top_height
    SetFrameCamera(app->camera)
    if IsInspectActive() {
        DrawRectangle(0, 0, view_width, view_height, StyleTokenColor("canvas"))
        profile_update_start = app_profile_now()
        updateapp(app)
        app_profile_record_update(profile_update_start)
        EndInterfaceFrame()
    } else {
        BeginClip((int)viewport.x, (int)viewport.y, full_width, full_height)
        BeginMode2D(app->camera)
        DrawRectangle(0, 0, view_width, view_height, StyleTokenColor("canvas"))
        profile_update_start = app_profile_now()
        updateapp(app)
        Overlays()
        app_profile_record_update(profile_update_start)
        EndInterfaceFrame()
        EndMode2D()
        EndClip()
    }
    profile_habits_start = app_profile_now()
    app_schedule_habits_post_frame_flush(app)
    app_profile_record_habits(profile_habits_start)
    profile_sync_start = app_profile_now()
    app_sync_pump(app)
    app_profile_record_sync(profile_sync_start)
    app_profile_frame_end(profile_frame_start)
}

app_unload_texture :: (texture: Texture2D) #export {
    if texture.id != 0 {
        UnloadTexture(texture)
    }
}

app_destroy :: (vapp: void*) #export {
    app: InnerBreeze* = vapp
    i: int
    if app == nil {
        return
    }
    CloseNativeWindow(app->break_window)
    app->break_window = nil
    CloseNativeWindow(app->break_hud)
    app->break_hud = nil
    save_settings(app)
    app->habits_flush_post_frame_scheduled = 0
    habits_flush_save(app)
    app_unload_texture(app->pet.egg)
    app_unload_texture(app->font_shapes_texture)
    if !IsInspectActive() {
        unload_locale_font(app)
    }
    unload_cue_sounds(app)
    for i = 0; i < practice_count(); i++ {
        practice: const PracticeDefinition* = practice_get(i)
        if practice->destroy != nil {
            practice->destroy(app)
        }
    }
    if app->audio_ready {
        if app->audio_meter_attached {
            DetachAudioMixedProcessor(audio_mixed_meter)
            app->audio_meter_attached = 0
        }
        CloseAudioDevice()
        app->audio_ready = 0
    }
    memset(app, 0, sizeof(*app))
}

app_should_use_tab_bar :: (app: const InnerBreeze*) -> int #export {
    if app == nil {
        return 0
    }
    return app->navigation_mode == NAV_MODE_TABBAR
}
