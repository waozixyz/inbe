#import "app.h"
#import "app_internal.h"
#import "practices/meditation/meditation_practice.h"
#import <stdio.h>
#import <string.h>

static g_audio_meter_peak_milli: volatile int

#if #defined(KRYON_PLATFORM_PLAN9) {
    load_sound_file_asset :: (path: const char*) -> Sound #private {
        wave: Wave
        sound: Sound
        memset(&sound, 0, sizeof(sound))
        wave = LoadWave(path)
        if wave.data == nil {
            return sound
        }
        WaveFormat(&wave, 44100, 16, 2)
        sound = LoadSoundFromWave(wave)
        UnloadWave(wave)
        if sound.frameCount == 0 {
            TraceLog(LOG_ERROR, "AUDIO: Failed to create sound from file asset: %s", path)
        } else {
            TraceLog(LOG_INFO, "AUDIO: Loaded sound file asset %s (%d frames)",
            path, (int)sound.frameCount)
        }
        return sound
    }
}

load_sound_asset :: (name: const char*) -> Sound #private {
    path: [96] char
    asset: const EmbeddedAsset*
    wave: Wave
    sound: Sound = {0}
    snprintf(path, sizeof(path), "assets/sounds/%s", name)
    asset = GetEmbeddedAsset(path)
    if asset == nil || asset->data == nil || asset->size == 0 {
        #if #defined(KRYON_PLATFORM_PLAN9) {
            return load_sound_file_asset(path)
        } #else {
            TraceLog(LOG_ERROR, "AUDIO: Missing embedded sound asset: %s", path)
            return sound
        }
    }
    wave = LoadWaveFromMemory(GetEmbeddedAssetExtension(path), asset->data, (int)asset->size)
    if wave.data == nil {
        #if #defined(KRYON_PLATFORM_PLAN9) {
            return load_sound_file_asset(path)
        } #else {
            TraceLog(LOG_ERROR, "AUDIO: Failed to decode embedded sound asset: %s", path)
            return sound
        }
    }
    WaveFormat(&wave, 44100, 16, 2)
    sound = LoadSoundFromWave(wave)
    UnloadWave(wave)
    if sound.frameCount == 0 {
        TraceLog(LOG_ERROR, "AUDIO: Failed to create sound from embedded asset: %s", path)
    } else {
        TraceLog(LOG_INFO, "AUDIO: Loaded sound asset %s (%d frames)",
        path, (int)sound.frameCount)
    }
    return sound
}

app_sound_volume_scale :: (app: InnerBreeze*, scale: float) -> float #private {
    volume: float
    if app == nil || app->sound_volume <= 0 {
        return 0.0f
    }
    volume = ((float)app->sound_volume / 100.0f) * scale
    if volume < 0.0f {
        volume = 0.0f
    }
    if volume > 1.0f {
        volume = 1.0f
    }
    return volume
}

audio_mixed_meter :: (bufferData: void*, frames: unsigned int) #export {
    samples: float* = bufferData
    peak: float = 0.0f
    peak_milli: int
    count: unsigned int
    if samples == nil || frames == 0 {
        return
    }
    count = frames * 2
    for unsigned int i = 0; i < count; i++ {
        sample: float = samples[i]
        if sample < 0.0f {
            sample = -sample
        }
        if sample > peak {
            peak = sample
        }
    }
    if peak > 1.0f {
        peak = 1.0f
    }
    peak_milli = (int)(peak * 1000.0f)
    if peak_milli > g_audio_meter_peak_milli {
        g_audio_meter_peak_milli = peak_milli
    }
}

app_breath_cue_pitch :: (app: InnerBreeze*) -> float #private {
    default_ticks: int = breath_half_ticks_for_speed(DefaultSpeedLevel)
    half_ticks: int
    if app == nil {
        return 1.0f
    }
    half_ticks = app->breathing.breath_half_ticks
    if half_ticks <= 0 {
        half_ticks = breath_half_ticks_for_speed(app->breathing.speed_level)
    }
    if half_ticks <= 0 {
        half_ticks = default_ticks
    }
    if default_ticks <= 0 {
        return 1.0f
    }
    return (float)default_ticks / (float)half_ticks
}

app_play_sound_pitch :: (app: InnerBreeze*, sound: Sound, scale: float, pitch: float) #private {
    volume: float
    if app == nil {
        return
    }
    if !app->audio_ready {
        app_audio_ensure_ready(app)
    }
    if !app->audio_ready {
        return
    }
    if sound.frameCount == 0 {
        TraceLog(LOG_ERROR, "AUDIO: Cannot play sound because sound is not loaded")
        return
    }
    volume = app_sound_volume_scale(app, scale)
    if volume <= 0.0f {
        return
    }
    if pitch < 0.75f {
        pitch = 0.75f
    }
    if pitch > 1.45f {
        pitch = 1.45f
    }
    StopSound(sound)
    SetSoundVolume(sound, volume)
    SetSoundPitch(sound, pitch)
    PlaySound(sound)
    if !IsSoundPlaying(sound) {
        TraceLog(LOG_ERROR, "AUDIO: PlaySound returned but sound is not playing")
    }
}

app_play_sound :: (app: InnerBreeze*, sound: Sound, scale: float) #export {
    app_play_sound_pitch(app, sound, scale, 1.0f)
}

app_play_breath_cue :: (app: InnerBreeze*, dir: int) #export {
    sound: Sound
    scale: float = 1.25f
    if app == nil {
        return
    }
    sound = dir == 0 ? app->breath_in_sound : app->breath_out_sound
    app_play_sound_pitch(app, sound, scale, app_breath_cue_pitch(app))
}

app_play_bell_cue :: (app: InnerBreeze*, scale: float) #export {
    if app == nil {
        return
    }
    app_play_sound(app, app->bell_sound, scale)
}

app_bell_cue_playing :: (app: InnerBreeze*) -> int #export {
    if app == nil || !app->audio_ready || app->bell_sound.frameCount == 0 {
        return 0
    }
    return IsSoundPlaying(app->bell_sound) ? 1 : 0
}

app_audio_output_level :: (app: InnerBreeze*) -> float #export {
    latest: float
    if app == nil || !app->audio_ready {
        return 0.0f
    }
    latest = (float)g_audio_meter_peak_milli / 1000.0f
    g_audio_meter_peak_milli = 0
    if latest > app->audio_meter_level {
        app->audio_meter_level = latest
    } else {
        app->audio_meter_level *= 0.86f
    }
    if app->audio_meter_level < 0.01f {
        app->audio_meter_level = 0.0f
    }
    if app->audio_meter_level > 1.0f {
        app->audio_meter_level = 1.0f
    }
    return app->audio_meter_level
}

unload_cue_sounds :: (app: InnerBreeze*) #export {
    empty: Sound
    if app == nil {
        return
    }
    SafeUnloadSound(app->breath_in_sound)
    SafeUnloadSound(app->breath_out_sound)
    SafeUnloadSound(app->bell_sound)
    memset(&empty, 0, sizeof(empty))
    app->breath_in_sound = empty
    app->breath_out_sound = empty
    app->bell_sound = empty
}

load_cue_sound :: (app: InnerBreeze*, cue: int) -> Sound #private {
    path: [FS_PATH_MAX] char
    wave: Wave
    sound: Sound = {0}
    if app == nil {
        return sound
    }
    if app_audio_cue_path(app, cue, path, sizeof(path)) {
        wave = LoadWave(path)
        if wave.data != nil {
            WaveFormat(&wave, 44100, 16, 2)
            sound = LoadSoundFromWave(wave)
            UnloadWave(wave)
            if sound.frameCount != 0 {
                return sound
            }
        }
    }
    return load_sound_asset(app_audio_cue_default_asset(cue))
}

app_audio_reload_cue_sounds :: (app: InnerBreeze*) #export {
    if app == nil || !app->audio_ready {
        return
    }
    unload_cue_sounds(app)
    app->breath_in_sound = load_cue_sound(app, AUDIO_CUE_BREATH_IN)
    app->breath_out_sound = load_cue_sound(app, AUDIO_CUE_BREATH_OUT)
    app->bell_sound = load_cue_sound(app, AUDIO_CUE_BELL)
}

init_audio :: (app: InnerBreeze*) #export {
    if app == nil || app->audio_ready {
        return
    }
    InitAudioDevice()
    app->audio_ready = IsAudioDeviceReady()
    if !app->audio_ready {
        TraceLog(LOG_ERROR, "AUDIO: Audio device failed to initialize")
        return
    }
    TraceLog(LOG_INFO, "AUDIO: Audio device initialized")
    app_audio_reload_cue_sounds(app)
    AttachAudioMixedProcessor(audio_mixed_meter)
    app->audio_meter_attached = 1
}

app_audio_ensure_ready :: (app: InnerBreeze*) #export {
    if app == nil || app->audio_ready {
        return
    }
    if app_running_in_kryon_preview() {
        return
    }
    init_audio(app)
}

app_audio_reinitialize :: (app: InnerBreeze*) -> int #export {
    if app == nil {
        return 0
    }
    meditation_music_unload(app)
    if app->audio_ready && app->audio_meter_attached {
        DetachAudioMixedProcessor(audio_mixed_meter)
        app->audio_meter_attached = 0
    }
    unload_cue_sounds(app)
    if app->audio_ready {
        CloseAudioDevice()
        app->audio_ready = 0
    }
    app->audio_meter_level = 0.0f
    g_audio_meter_peak_milli = 0
    if !app_running_in_kryon_preview() {
        init_audio(app)
    }
    return app->audio_ready ? 1 : 0
}

SafeUnloadSound :: (sound: Sound) #private {
    if sound.frameCount != 0 {
        UnloadSound(sound)
    }
}
