FontFallback :: struct {
    name: const char*
    path: const char*
}

#import "app/app"
#import "ui_locale_props.generated.h"
#import "app_internal.h"
#import "app_font_assets.h"
#import <stdlib.h>
#import <string.h>

app_running_in_kryon_preview :: () -> int #export {
    inspect: const char* = getenv("KRYON_INSPECT")
    return IsInspectActive() ||
    (inspect != nil && inspect[0] != '\0' && strcmp(inspect, "0") != 0)
}

# Register a UI font from an embedded asset. Kryon seeds the standard
# codepoint range (ASCII, Latin and Latin Extended, punctuation, currency,
# Greek, Cyrillic) and grows the atlas on demand, so the font renders every
# glyph its file contains in its own typeface instead of falling back to a
# different registered font.

register_ui_font_source :: (name: const char*, path: const char*, codepoints: const int*, codepoint_count: int) -> int #private {
    asset: const EmbeddedAsset*
    if name == nil || path == nil {
        return 0
    }
    asset = GetEmbeddedAsset(path)
    if asset == nil {
        #if #defined(KRYON_PLATFORM_PLAN9) {
            return RegisterTextFontFileSource(name, path, codepoints, codepoint_count)
        } #else {
            return 0
        }
    }
    return RegisterTextFontSource(name, GetEmbeddedAssetExtension(path),
    asset->data, asset->size,
    codepoints, codepoint_count)
}

#if !#defined(PLATFORM_WEB) && !#defined(_WIN32) && !ANDROID_BUILD {
    register_desktop_system_ui_font :: () -> int #private {
        font_path: [512] char
        if !GetSystemTextFontFile(font_path, (int)sizeof(font_path)) {
            return 0
        }
        if !RegisterTextFontFileSource("ui", font_path, nil, 0) {
            TraceLog(LOG_WARNING, "APP: failed to load system UI font: %s",
            font_path)
            return 0
        }
        TraceLog(LOG_INFO, "APP: using system UI font: %s", font_path)
        return 1
    }
}

#if ANDROID_BUILD {
    # Android system fonts act as cross-font fallback for scripts the bundled
    # subset lacks. They are dynamic source fonts: the atlas grows as glyphs are
    # needed. (.ttc collections are omitted -- raylib cannot load them.)
    static register_android_system_font_fallbacks_fonts: [6] const FontFallback = {
        {"sys-sc", "/system/fonts/NotoSansSC-Regular.otf"},
        {"sys-jp", "/system/fonts/NotoSansJP-Regular.otf"},
        {"sys-kr", "/system/fonts/NotoSansKR-Regular.otf"},
        {"sys-tc", "/system/fonts/NotoSansTC-Regular.otf"},
        {"sys-latin", "/system/fonts/NotoSans-Regular.ttf"},
        {"sys-roboto", "/system/fonts/Roboto-Regular.ttf"}
    }

    register_android_system_font_fallbacks :: () #private {
        for size_t i = 0; i < sizeof(register_android_system_font_fallbacks_fonts) / sizeof(register_android_system_font_fallbacks_fonts[0]); i++ {
            RegisterTextFontFileSource(register_android_system_font_fallbacks_fonts[i].name, register_android_system_font_fallbacks_fonts[i].path, nil, 0)
        }
    }
}

# Fallback fonts only ever draw language names: ASCII plus the no-break
# space covers their seeded set, and the native-script glyphs grow the
# raster on demand with one batched re-rasterization per burst. This avoids
# rasterizing the ~1000-glyph standard seed in every fallback font at
# startup.

static language_picker_seed_codepoints_seed: [0x7E - 0x20 + 2] int

static language_picker_seed_codepoints_ready: int = 0

language_picker_seed_codepoints :: (out_count: int*) -> const int* #private {
    count: int = 0
    if !language_picker_seed_codepoints_ready {
        for int cp = 0x20; cp <= 0x7E; cp++ {
            language_picker_seed_codepoints_seed[count++] = cp
        }
        language_picker_seed_codepoints_seed[count++] = 0x00A0
        language_picker_seed_codepoints_ready = 1
    }
    if out_count != nil {
        *out_count = count
    }
    return language_picker_seed_codepoints_seed
}

# The language picker lists every locale in its native script, so CJK glyphs
# must render even when the active UI font is Latin. Register the CJK subset
# fonts as cross-font fallback; they grow on demand as their glyphs are drawn.

register_language_picker_fonts :: () #private {
    seed_count: int = 0
    seed: const int* = language_picker_seed_codepoints(&seed_count)
    register_ui_font_source("ui-lang-latin", FONT_LATIN, nil, 0)
    register_ui_font_source("ui-lang-ja", FONT_JP, seed, seed_count)
    register_ui_font_source("ui-lang-ko", FONT_KR, seed, seed_count)
    register_ui_font_source("ui-lang-zh", FONT_SC, seed, seed_count)
}

load_locale_font :: (app: InnerBreeze*) -> int #export {
    white: Image
    code: const char*
    font_path: const char*
    font_asset: const EmbeddedAsset*
    system_font_active: int = 0
    ok: int = 0
    if app == nil {
        return 0
    }
    code = GetCurrentLocaleCode()
    if code == nil || code[0] == '\0' {
        code = "en"
    }
    font_path = ui_font_asset_for_locale(code)
    font_asset = GetEmbeddedAsset(font_path)
    #if !#defined(KRYON_PLATFORM_PLAN9) {
        if font_asset == nil {
            return 0
        }
    }
    if !IsInspectActive() {
        ClearTextFonts()
    }
    #if !#defined(PLATFORM_WEB) && !#defined(_WIN32) && !ANDROID_BUILD {
        system_font_active = register_desktop_system_ui_font()
    }
    if system_font_active && font_asset != nil {
        RegisterTextFontSource("ui-locale", GetEmbeddedAssetExtension(font_path),
        font_asset->data, font_asset->size,
        nil, 0)
    } else {
        if font_asset != nil {
            if !RegisterTextFontSource("ui", GetEmbeddedAssetExtension(font_path),
            font_asset->data, font_asset->size,
            nil, 0) {
                goto done
            }
        } else {
            #if #defined(KRYON_PLATFORM_PLAN9) {
                if !RegisterTextFontFileSource("ui", font_path, nil, 0) {
                    goto done
                }
            } #else {
                goto done
            }
        }
    }
    #if ANDROID_BUILD {
        register_android_system_font_fallbacks()
    }
    register_language_picker_fonts()
    if !UseTextFont("ui") {
        goto done
    }
    white = GenImageColor(1, 1, WHITE)
    app->font_shapes_texture = LoadTextureFromImage(white)
    UnloadImage(white)
    if app->font_shapes_texture.id == 0 {
        goto done
    }
    SetTextureFilter(app->font_shapes_texture, TEXTURE_FILTER_POINT)
    SetShapesTexture(app->font_shapes_texture, (Rectangle){0, 0, 1, 1})
    ok = 1
    done:
    if !ok && !IsInspectActive() {
        ClearTextFonts()
    }
    return ok
}

unload_locale_font :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    if !IsInspectActive() {
        ClearTextFonts()
    }
}

discard_locale_font_cpu :: (app: InnerBreeze*) #export {
    if app == nil {
        return
    }
    if !IsInspectActive() {
        ClearTextFonts()
    }
}
