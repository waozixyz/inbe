#import "app.h"

app_locale_dropdown :: (id: int, x: int, y: int, w: int, h: int,
                        selected_index: int*) -> int {
    labels: [64] const char* = {0}
    count := GetLocaleCount()
    max_count := 64

    if count > max_count {
        count = max_count
    }
    if count <= 0 {
        labels[0] = GetLocaleText("language_system_label")
        count = 1
    } else {
        for int i = 0; i < count; i++ {
            labels[i] = GetLocaleLabel(i)
        }
    }

    if selected_index != nil {
        if *selected_index < 0 {
            *selected_index = 0
        }
        if *selected_index >= count {
            *selected_index = count - 1
        }
    }

    return Dropdown(id, x, y, w, h, labels, count, selected_index)
}
