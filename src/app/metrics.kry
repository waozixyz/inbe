#import "kryon.h"
#import <string.h>

AppFontSize :: () -> int #export {
    return Scale(Text16)
}

AppSmallFontSize :: () -> int #export {
    return Scale(Text14)
}

AppTextWidth :: (text: const char*, font: int) -> int #export {
    return MeasureTextWidth(text, font, nil)
}

AppTextLineHeight :: (font: int) -> int #export {
    return font > 0 ? font : AppFontSize()
}

AppTitleBarHeight :: () -> int #export {
    return Scale(48)
}

AppTitleFontSize :: (title: const char*, max_width: int) -> int #export {
    value: const char* = title != nil ? title : ""
    large: int = Scale(Text24)
    medium: int = Scale(Text16)
    small: int = Scale(Text14)
    if max_width <= 0 || AppTextWidth(value, large) <= max_width {
        return large
    }
    if AppTextWidth(value, medium) <= max_width {
        return medium
    }
    return small
}

AppFitFontSize :: (text: const char*, max_width: int, preferred: int, minimum: int) -> int #export {
    value: const char* = text != nil ? text : ""
    font: int = preferred
    if max_width <= 0 {
        return preferred
    }
    while font > minimum && AppTextWidth(value, font) > max_width {
        font--
    }
    return font
}

AppControlTextY :: (text: const char*, box_y: int, box_h: int, font: int) -> int #export {
    line_height: int = AppTextLineHeight(font)
    unused text
    return box_y + (box_h - line_height) / 2 + line_height * 3 / 4
}

AppParagraphHeight :: (text: const char*, width: int, font: int, line_gap: int) -> int #export {
    value: const char* = text != nil ? text : ""
    word: [128] char
    line_height: int = AppTextLineHeight(font)
    lines: int = 1
    line_w: int = 0
    i: int = 0
    if width <= 0 {
        return line_height
    }
    while value[i] != '\0' {
        word_start: int = i
        word_len: int
        word_w: int
        space_w: int
        j: int = i
        while value[j] != '\0' && value[j] != ' ' && value[j] != '\n' {
            j++
        }
        word_len = j - word_start
        if word_len > (int)sizeof(word) - 1 {
            word_len = (int)sizeof(word) - 1
        }
        memcpy(word, value + word_start, (size_t)word_len)
        word[word_len] = '\0'
        word_w = word_len > 0 ? AppTextWidth(word, font) : 0
        space_w = AppTextWidth(" ", font)
        if word_len == 0 {
            j++
            word_w = space_w
        }
        if value[j - 1] == '\n' || (line_w > 0 && line_w + word_w > width) {
            lines++
            line_w = word_w
        } else {
            line_w += word_w
        }
        i = j
    }
    return lines * line_height + (lines - 1) * line_gap
}
