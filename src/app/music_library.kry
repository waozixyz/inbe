#import "app/app.h"
#import "audio_library.h"
#import "data.h"
#import "practices/meditation/meditation_practice.h"
#import "storage.h"
#import <stdio.h>
#import <string.h>

static audio_builtin_music_titles: [AUDIO_BUILTIN_MUSIC_COUNT] const char* const = {
    "Deep Meditation",
    "Path Of Meditation",
    "Truth Of Silence"
}

#if #defined(KRYON_PLATFORM_PLAN9) {
    static audio_builtin_music_files: [AUDIO_BUILTIN_MUSIC_COUNT] const char* const = {
        "Elijah_K/deep-meditation.wav",
        "Elijah_K/path-of-meditation.wav",
        "Elijah_K/truth-of-silence.wav"
    }
} #else {
    static audio_builtin_music_files: [AUDIO_BUILTIN_MUSIC_COUNT] const char* const = {
        "Elijah_K/deep-meditation.ogg",
        "Elijah_K/path-of-meditation.ogg",
        "Elijah_K/truth-of-silence.ogg"
    }
}

static audio_cue_setting_keys: [AUDIO_CUE_COUNT] const char* const = {
    "audio_cue_breath_in",
    "audio_cue_breath_out",
    "audio_cue_bell"
}

#if #defined(KRYON_PLATFORM_PLAN9) {
    static audio_cue_default_files: [AUDIO_CUE_COUNT] const char* const = {
        "breath-in.wav",
        "breath-out.wav",
        "bell.wav"
    }
} #else {
    static audio_cue_default_files: [AUDIO_CUE_COUNT] const char* const = {
        "breath-in.ogg",
        "breath-out.ogg",
        "bell.ogg"
    }
}

#if #defined(KRYON_PLATFORM_PLAN9) {
    AUDIO_MUSIC_EXTENSIONS :: ".wav"
    AUDIO_SOUND_EXTENSIONS :: ".wav"
} #else {
    AUDIO_MUSIC_EXTENSIONS :: ".ogg;.wav;.qoa;.xm;.mod;.mp3;.flac;.m4a;.opus"
    AUDIO_SOUND_EXTENSIONS :: ".ogg;.wav;.qoa;.mp3;.flac;.m4a;.opus"
}

app_audio_music_file_valid :: (path: const char*) -> int #export {
    return KryAudioFileValid(path, AUDIO_MUSIC_EXTENSIONS)
}

app_audio_sound_file_valid :: (path: const char*) -> int #export {
    return KryAudioFileValid(path, AUDIO_SOUND_EXTENSIONS)
}

audio_import_error_from_kryon :: (error: int) -> int #private {
    switch error {
        case KRY_AUDIO_IMPORT_OK:
        return AUDIO_IMPORT_SUCCESS
        case KRY_AUDIO_IMPORT_INVALID_PATH:
        return AUDIO_IMPORT_ERROR_INVALID_PATH
        case KRY_AUDIO_IMPORT_INVALID_FORMAT:
        return AUDIO_IMPORT_ERROR_INVALID_FORMAT
        case KRY_AUDIO_IMPORT_FILE_NOT_FOUND:
        return AUDIO_IMPORT_ERROR_FILE_NOT_FOUND
        case KRY_AUDIO_IMPORT_COPY_FAILED:
        return AUDIO_IMPORT_ERROR_COPY_FAILED
        case KRY_AUDIO_IMPORT_FULL:
        return AUDIO_IMPORT_ERROR_UNKNOWN
        default:
        return AUDIO_IMPORT_ERROR_UNKNOWN
    }
}

audio_import_item :: (items: AudioLibraryItem*, count: int*, max_count: int, kind: const char*, src: const char*, extensions: const char*, error_code: int*) -> int #private {
    item: KryAudioLibraryItem
    kry_error: int = KRY_AUDIO_IMPORT_COPY_FAILED
    index: int
    if error_code {
        *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
    }
    if items == nil || count == nil || extensions == nil ||
    *count < 0 || *count >= max_count {
        if error_code {
            *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
        }
        return -1
    }
    index = *count
    memset(&item, 0, sizeof(item))
    item.title = items[index].title
    item.title_size = sizeof(items[index].title)
    item.path = items[index].path
    item.path_size = sizeof(items[index].path)
    if !KryAudioImportItem(item, index, data_root(), kind, extensions, src,
    &kry_error) {
        if error_code {
            *error_code = audio_import_error_from_kryon(kry_error)
        }
        return -1
    }
    *count = index + 1
    if error_code {
        *error_code = AUDIO_IMPORT_SUCCESS
    }
    return index
}

audio_load_item :: (item: AudioLibraryItem*, prefix: const char*, index: int) #private {
    key: [96] char
    value: const char*
    if item == nil || prefix == nil {
        return
    }
    snprintf(key, sizeof(key), "%s_%d_title", prefix, index)
    value = storage_get_setting_text(key)
    snprintf(item->title, sizeof(item->title), "%s",
    value != nil && value[0] != '\0' ? value : "Custom audio")
    snprintf(key, sizeof(key), "%s_%d_path", prefix, index)
    value = storage_get_setting_text(key)
    snprintf(item->path, sizeof(item->path), "%s", value != nil ? value : "")
}

audio_save_item :: (item: const AudioLibraryItem*, prefix: const char*, index: int) #private {
    key: [96] char
    if item == nil || prefix == nil {
        return
    }
    snprintf(key, sizeof(key), "%s_%d_title", prefix, index)
    storage_set_setting_text(key, item->title)
    snprintf(key, sizeof(key), "%s_%d_path", prefix, index)
    storage_set_setting_text(key, item->path)
}

app_audio_library_load :: (app: InnerBreeze*) #export {
    i: int
    if app == nil {
        return
    }
    app->audio_custom_sound_count =
    storage_get_setting_int("audio_custom_sound_count", 0)
    if app->audio_custom_sound_count < 0 {
        app->audio_custom_sound_count = 0
    }
    if app->audio_custom_sound_count > AUDIO_CUSTOM_SOUND_MAX {
        app->audio_custom_sound_count = AUDIO_CUSTOM_SOUND_MAX
    }
    for i = 0; i < app->audio_custom_sound_count; i++ {
        audio_load_item(&app->audio_custom_sounds[i], "audio_custom_sound", i)
    }
    app->audio_custom_music_count =
    storage_get_setting_int("audio_custom_music_count", 0)
    if app->audio_custom_music_count < 0 {
        app->audio_custom_music_count = 0
    }
    if app->audio_custom_music_count > AUDIO_CUSTOM_MUSIC_MAX {
        app->audio_custom_music_count = AUDIO_CUSTOM_MUSIC_MAX
    }
    for i = 0; i < app->audio_custom_music_count; i++ {
        audio_load_item(&app->audio_custom_music[i], "audio_custom_music", i)
    }
    for i = 0; i < AUDIO_CUE_COUNT; i++ {
        selected: int = storage_get_setting_int(audio_cue_setting_keys[i], 0)
        if selected < 0 || selected > app->audio_custom_sound_count {
            selected = 0
        }
        app->audio_cue_selected[i] = selected
    }
}

app_audio_library_save :: (app: const InnerBreeze*) #export {
    i: int
    if app == nil {
        return
    }
    storage_set_setting_int("audio_custom_sound_count", app->audio_custom_sound_count)
    for i = 0; i < AUDIO_CUSTOM_SOUND_MAX; i++ {
        if i < app->audio_custom_sound_count {
            audio_save_item(&app->audio_custom_sounds[i], "audio_custom_sound", i)
        } else {
            empty: AudioLibraryItem = {{0}, {0}}
            audio_save_item(&empty, "audio_custom_sound", i)
        }
    }
    storage_set_setting_int("audio_custom_music_count", app->audio_custom_music_count)
    for i = 0; i < AUDIO_CUSTOM_MUSIC_MAX; i++ {
        if i < app->audio_custom_music_count {
            audio_save_item(&app->audio_custom_music[i], "audio_custom_music", i)
        } else {
            empty: AudioLibraryItem = {{0}, {0}}
            audio_save_item(&empty, "audio_custom_music", i)
        }
    }
    for i = 0; i < AUDIO_CUE_COUNT; i++ {
        storage_set_setting_int(audio_cue_setting_keys[i], app->audio_cue_selected[i])
    }
}

app_audio_import_custom_sound :: (app: InnerBreeze*, cue: int, path: const char*) -> int #export {
    error_code: int
    return app_audio_import_custom_sound_ex(app, cue, path, &error_code)
}

app_audio_import_custom_sound_ex :: (app: InnerBreeze*, cue: int, path: const char*, error_code: int*) -> int #export {
    index: int
    if error_code {
        *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
    }
    if app == nil {
        if error_code {
            *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
        }
        return 0
    }
    index = audio_import_item(app->audio_custom_sounds,
    &app->audio_custom_sound_count,
    AUDIO_CUSTOM_SOUND_MAX,
    "sounds", path,
    AUDIO_SOUND_EXTENSIONS, error_code)
    if index < 0 {
        return 0
    }
    if cue >= 0 && cue < AUDIO_CUE_COUNT {
        app->audio_cue_selected[cue] = index + 1
    }
    app_audio_library_save(app)
    app_audio_reload_cue_sounds(app)
    return 1
}

app_audio_import_custom_music :: (app: InnerBreeze*, path: const char*) -> int #export {
    error_code: int
    return app_audio_import_custom_music_ex(app, path, &error_code)
}

app_audio_import_custom_music_ex :: (app: InnerBreeze*, path: const char*, error_code: int*) -> int #export {
    index: int
    probe: Music
    if error_code {
        *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
    }
    if app == nil {
        if error_code {
            *error_code = AUDIO_IMPORT_ERROR_UNKNOWN
        }
        return 0
    }
    index = audio_import_item(app->audio_custom_music,
    &app->audio_custom_music_count,
    AUDIO_CUSTOM_MUSIC_MAX,
    "music", path,
    AUDIO_MUSIC_EXTENSIONS, error_code)
    if index < 0 {
        return 0
    }
    probe = LoadMusicStream(app->audio_custom_music[index].path)
    if !IsMusicValid(probe) {
        TraceLog(LOG_ERROR, "AUDIO: Imported music could not be decoded: %s",
        app->audio_custom_music[index].path)
        remove(app->audio_custom_music[index].path)
        memset(&app->audio_custom_music[index], 0,
        sizeof(app->audio_custom_music[index]))
        app->audio_custom_music_count = index
        if error_code {
            *error_code = AUDIO_IMPORT_ERROR_INVALID_FORMAT
        }
        return 0
    }
    UnloadMusicStream(probe)
    app->meditation.music_track = AUDIO_BUILTIN_MUSIC_COUNT + index
    app_audio_music_sanitize_selection(app)
    app_audio_library_save(app)
    return 1
}

app_audio_remove_custom_sound :: (app: InnerBreeze*, index: int) -> int #export {
    i: int
    cue: int
    if app == nil || index < 0 || index >= app->audio_custom_sound_count {
        return 0
    }
    for i = index; i + 1 < app->audio_custom_sound_count; i++ {
        app->audio_custom_sounds[i] = app->audio_custom_sounds[i + 1]
    }
    app->audio_custom_sound_count--
    memset(&app->audio_custom_sounds[app->audio_custom_sound_count], 0,
    sizeof(app->audio_custom_sounds[0]))
    for cue = 0; cue < AUDIO_CUE_COUNT; cue++ {
        if app->audio_cue_selected[cue] == index + 1 {
            app->audio_cue_selected[cue] = 0
        } else if app->audio_cue_selected[cue] > index + 1 {
            app->audio_cue_selected[cue]--
        }
    }
    app_audio_library_save(app)
    app_audio_reload_cue_sounds(app)
    return 1
}

app_audio_remove_custom_music :: (app: InnerBreeze*, index: int) -> int #export {
    removed_track: int = AUDIO_BUILTIN_MUSIC_COUNT + index
    i: int
    if app == nil || index < 0 || index >= app->audio_custom_music_count {
        return 0
    }
    meditation_music_unload(app)
    for i = index; i + 1 < app->audio_custom_music_count; i++ {
        app->audio_custom_music[i] = app->audio_custom_music[i + 1]
    }
    app->audio_custom_music_count--
    memset(&app->audio_custom_music[app->audio_custom_music_count], 0,
    sizeof(app->audio_custom_music[0]))
    if app->meditation.music_track == removed_track {
        app->meditation.music_track = 0
    } else if app->meditation.music_track > removed_track {
        app->meditation.music_track--
    }
    for i = 0; i < EXERCISE_COUNT; i++ {
        if app->meditation.music_practice_tracks[i] == removed_track {
            app->meditation.music_practice_tracks[i] = 0
        } else if app->meditation.music_practice_tracks[i] > removed_track {
            app->meditation.music_practice_tracks[i]--
        }
    }
    app_audio_music_sanitize_selection(app)
    app_audio_library_save(app)
    return 1
}

app_audio_music_count :: (app: const InnerBreeze*) -> int #export {
    custom: int = app != nil ? app->audio_custom_music_count : 0
    if custom < 0 {
        custom = 0
    }
    if custom > AUDIO_CUSTOM_MUSIC_MAX {
        custom = AUDIO_CUSTOM_MUSIC_MAX
    }
    return AUDIO_BUILTIN_MUSIC_COUNT + custom
}

app_audio_music_label :: (app: const InnerBreeze*, index: int) -> const char* #export {
    if index >= 0 && index < AUDIO_BUILTIN_MUSIC_COUNT {
        return audio_builtin_music_titles[index]
    }
    index -= AUDIO_BUILTIN_MUSIC_COUNT
    if app != nil && index >= 0 && index < app->audio_custom_music_count {
        return app->audio_custom_music[index].title
    }
    return ""
}

app_audio_cue_default_asset :: (cue: int) -> const char* #export {
    if cue < 0 || cue >= AUDIO_CUE_COUNT {
        return ""
    }
    return audio_cue_default_files[cue]
}

app_audio_cue_path :: (app: InnerBreeze*, cue: int, out: char*, out_size: size_t) -> int #export {
    selected: int
    if out == nil || out_size == 0 {
        return 0
    }
    out[0] = '\0'
    if app == nil || cue < 0 || cue >= AUDIO_CUE_COUNT {
        return 0
    }
    selected = app->audio_cue_selected[cue]
    if selected <= 0 || selected > app->audio_custom_sound_count {
        return 0
    }
    if !app_audio_sound_file_valid(app->audio_custom_sounds[selected - 1].path) {
        app->audio_cue_selected[cue] = 0
        return 0
    }
    snprintf(out, out_size, "%s", app->audio_custom_sounds[selected - 1].path)
    return 1
}

app_audio_music_path :: (app: const InnerBreeze*, index: int, out: char*, out_size: size_t) -> int #export {
    if out == nil || out_size == 0 {
        return 0
    }
    out[0] = '\0'
    if index >= 0 && index < AUDIO_BUILTIN_MUSIC_COUNT {
        candidate: [FS_PATH_MAX * 2] char
        #if #defined(DEBUG_LOCAL_ASSETS) || #defined(KRYON_PLATFORM_PLAN9) {
            snprintf(candidate, sizeof(candidate), "unpackaged_assets/audio/%s",
            audio_builtin_music_files[index])
            if app_audio_music_file_valid(candidate) {
                snprintf(out, out_size, "%s", candidate)
                return 1
            }
        }
        if app != nil && app->meditation.music_cache_dir[0] != '\0' {
            snprintf(candidate, sizeof(candidate), "%s/audio/%s",
            app->meditation.music_cache_dir,
            audio_builtin_music_files[index])
            if app_audio_music_file_valid(candidate) {
                snprintf(out, out_size, "%s", candidate)
                return 1
            }
        }
        snprintf(candidate, sizeof(candidate), "audio/%s",
        audio_builtin_music_files[index])
        if app_audio_music_file_valid(candidate) {
            snprintf(out, out_size, "%s", candidate)
            return 1
        }
        return 0
    }
    index -= AUDIO_BUILTIN_MUSIC_COUNT
    if app != nil && index >= 0 && index < app->audio_custom_music_count &&
    app_audio_music_file_valid(app->audio_custom_music[index].path) {
        snprintf(out, out_size, "%s", app->audio_custom_music[index].path)
        return 1
    }
    return 0
}

app_audio_music_sanitize_selection :: (app: InnerBreeze*) #export {
    count: int
    mask: int
    i: int
    if app == nil {
        return
    }
    count = app_audio_music_count(app)
    if count <= 0 {
        count = 1
    }
    if app->meditation.music_track < 0 || app->meditation.music_track >= count {
        app->meditation.music_track = 0
    }
    # The mask is derived from the per-practice track slots so it can never
    # drift out of sync: a bit is set iff that practice has a valid track
    # (i.e. not AUDIO_MUSIC_NONE).
    mask = 0
    for i = 0; i < EXERCISE_COUNT; i++ {
        track: int = app->meditation.music_practice_tracks[i]
        # AUDIO_MUSIC_NONE (-1) is valid and means "no music". Any other
        # out-of-range value is clamped to None rather than 0 so a stale index
        # never silently selects a different track.
        if track != AUDIO_MUSIC_NONE &&
        (track < 0 || track >= count) {
            app->meditation.music_practice_tracks[i] = AUDIO_MUSIC_NONE
        }
        if app->meditation.music_practice_tracks[i] != AUDIO_MUSIC_NONE {
            mask |= 1 << i
        }
    }
    app->meditation.music_practice_mask = mask
}
