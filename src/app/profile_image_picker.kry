#import "app/app.h"

AppProfileImagePickerModal :: (modal: ProfileImagePickerProps) -> ProfileImagePickerResult {
    result := (ProfileImagePickerResult){0}
    candidates: [25] IconType = {
        ICON_PFP_BAMBUS, ICON_PFP_BIRD, ICON_PFP_BOWL, ICON_PFP_BUSH,
        ICON_PFP_BUTTERFLY, ICON_PFP_CACTUS, ICON_PFP_COFFEE,
        ICON_PFP_DRAGONFLY, ICON_PFP_FIREPLACE, ICON_PFP_FLOWER1,
        ICON_PFP_FLOWER2, ICON_PFP_FOX, ICON_PFP_HEART, ICON_PFP_INCENSE,
        ICON_PFP_LOTUS, ICON_PFP_MOUNTAIN, ICON_PFP_MUSHROOM, ICON_PFP_PALM,
        ICON_PFP_PERSON1, ICON_PFP_RAINBOW, ICON_PFP_TENT, ICON_PFP_CAT,
        ICON_PFP_TURTLE, ICON_PFP_MOON, ICON_PFP_TREE4
    }
    count := (int)(sizeof(candidates) / sizeof(candidates[0]))
    default_scroll_offset := 0
    scroll_offset := modal.scroll_offset != NULL ? modal.scroll_offset : &default_scroll_offset
    width := modal.max_width > 0 ? Scale(modal.max_width) : Scale(440)
    gap := Scale(8)
    if width > view_width - Scale(24) {
        width = view_width - Scale(24)
    }
    content_w := width - Scale(36)
    columns := (content_w + gap) / (Scale(64) + gap)
    if columns < 1 {
        columns = 1
    }
    cell := (content_w - (columns - 1) * gap) / columns
    if cell > Scale(64) {
        cell = Scale(64)
    }
    rows := (count + columns - 1) / columns
    content_h := rows * cell + (rows - 1) * gap
    height := Scale(74) + content_h + Scale(18)
    if height > view_height - Scale(24) {
        height = view_height - Scale(24)
    }
    frame := AppModalFrame(width, height,
        modal.title != NULL ? modal.title : "Profile image", 0, modal.close_icon_type)
    if frame.right_clicked {
        result.closed = 1
        return result
    }
    Scroll grid: {
        bounds = (Rectangle){(float)frame.content_x, (float)frame.content_y,
                             (float)frame.content_w, (float)frame.content_h}
        content_height = content_h
        scroll_offset = scroll_offset
        for int i = 0; i < count; i++ {
            row := i / columns
            col := i % columns
            grid_w := columns * cell + (columns - 1) * gap
            x := (int)grid.x + ((int)grid.width - grid_w) / 2 + col * (cell + gap)
            y := (int)grid.y + row * (cell + gap)
            type := candidates[i]
            active := modal.selected_icon_type != NULL && *modal.selected_icon_type == type
            if Button((ButtonProps){
                .id = 7800 + i,
                .bounds = {(float)x, (float)y, (float)cell, (float)cell},
                .selected = active,
                .tone = ButtonToneNeutral,
                .emphasis = ButtonEmphasisSoft
            }) {
                if modal.selected_icon_type != NULL {
                    *modal.selected_icon_type = type
                }
                result.changed = 1
                result.selected_index = i
                result.selected_icon_type = type
                result.closed = 1
            }
            inset := Scale(6)
            Icon(0, x + inset, y + inset, cell - inset * 2, type, WHITE)
        }
    }
    return result
}
