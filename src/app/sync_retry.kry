#module "app.sync_retry"
#import "sync.h"
#import "sync_retry_table.h"

retry_attempt_index :: (attempt: int) -> int #private {
    if attempt < 0 {
        return 0
    }
    if attempt > 4 {
        return 4
    }
    return attempt
}

sync_retry_decision :: (result: int, attempt: int) -> RetryDecision #export {
    if result < SYNC_OK || result > SYNC_AUTH_FAILED {
        result = 8
    }
    return retry_decisions[result][retry_attempt_index(attempt)]
}

app_sync_failure_needs_action :: (result: int) -> int #export {
    decision := sync_retry_decision(result, 0)
    return decision.needs_action
}

app_sync_retry_delay :: (attempt: int) -> double #export {
    return retry_delays[retry_attempt_index(attempt)]
}
