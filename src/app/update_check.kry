#import "app_update_check.h"
#import "app.h"
#import "kry_archive.h"
#import "storage.h"
#import "version.h"
#import "kryon.h"
#import "kry_update_flow.h"
#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>

#
# Desktop update flow. The lifecycle (check, channel choice, download,
# sha256 verify, apply mechanics) lives in kryon's kry_update_flow; this
# file adds breathing's persistence (one check per day in settings), locale,
# the toast, and the Windows zip extractor. Screenshot mode
# (APP_DATA_ROOT) skips the check so CI stays offline-deterministic.
#

APPCAST_URL :: "https://github.com/waozixyz/inbe/releases/latest/download/appcast.json"

UPDATE_CHECK_INTERVAL_S :: (24 * 60 * 60)

UPDATE_LAST_CHECK_KEY :: "update_check_last_unix"

#if !#defined(PLATFORM_WEB) && !ANDROID_BUILD {
    static flow: KryUpdateFlow*
    static update_available_flag: int
    static shown_available_toast: int
    static logged_ready: int
    static logged_failed: int
    static check_resolved: int
    static apply_armed: int
    update_check_throttled :: () -> int #private {
        last: long = storage_get_setting_int(UPDATE_LAST_CHECK_KEY, 0)
        now: long = (long)time(nil)
        return last > 0 && now >= last &&
        now - last < UPDATE_CHECK_INTERVAL_S
    }
    update_appcast_url :: () -> const char* #private {
        override: const char* = getenv("UPDATE_APPCAST_OVERRIDE")
        return override != nil && override[0] != '\0' ? override
        : APPCAST_URL
    }
    update_zip_extract_cb :: (archive: const char*, dest_dir: const char*, user: void*) -> int #private {
        unused user
        return KryArchiveExtractZip(archive, dest_dir)
    }
    update_flow_note_state :: () #private {
        state: KryUpdateFlowState = kry_update_flow_state(flow)
        if !check_resolved && state != KRY_UPDATE_FLOW_CHECKING &&
        state != KRY_UPDATE_FLOW_IDLE {
            check_resolved = 1
            # any terminal check state arms the throttle
            storage_set_setting_int(UPDATE_LAST_CHECK_KEY, (int)time(nil))
        }
        switch state {
            case KRY_UPDATE_FLOW_AVAILABLE:
            if !update_available_flag {
                update_available_flag = 1
                TraceLog(LOG_INFO, "APP: update %s available (channel %s)",
                kry_update_flow_new_version(flow),
                kry_update_channel_name(kry_update_flow_channel(flow)))
                # Toast only where a download is actionable; system channels
                # hear about updates from their package manager.
                if kry_update_flow_artifact(flow) != nil &&
                !shown_available_toast {
                    Toast((ToastProps){.message = GetLocaleText("update_available_toast")})
                    shown_available_toast = 1
                }
                # Test/automation hook: fetch immediately instead of waiting
                # for a click on the About row.
                if getenv("UPDATE_AUTO_DOWNLOAD") != nil {
                    kry_update_flow_download(flow)
                }
            }
            break
            case KRY_UPDATE_FLOW_READY:
            if !logged_ready {
                logged_ready = 1
                TraceLog(LOG_INFO, "APP: update staged and verified")
            }
            break
            case KRY_UPDATE_FLOW_FAILED:
            if !logged_failed {
                logged_failed = 1
                TraceLog(LOG_WARNING, "APP: update flow: %s",
                kry_update_flow_error(flow) != nil
                ? kry_update_flow_error(flow) : "?")
            }
            break
            default:
            break
        }
    }
    update_check_start :: () #export {
        cfg: KryUpdateFlowConfig = {
            .app_name = "breathing",
            .current_version = APP_VERSION_STRING,
        }
        override: const char* = getenv("UPDATE_APPCAST_OVERRIDE")
        if flow != nil || update_available_flag || update_check_throttled() {
            return
        }
        if getenv("APP_DATA_ROOT") != nil && (override == nil || override[0] == '\0') {
            return
        }
        # screenshot/test runs stay offline unless overridden
        flow = kry_update_flow_start(&cfg, update_appcast_url())
        if flow == nil {
            TraceLog(LOG_INFO, "APP: update check unavailable (no HTTP client)")
        } else {
            kry_update_flow_set_extractor(flow, update_zip_extract_cb, nil)
        }
    }
    update_check_poll :: () #export {
        if flow == nil {
            return
        }
        kry_update_flow_poll(flow)
        update_flow_note_state()
    }
    update_available :: () -> int #export {
        return update_available_flag
    }
    static update_row_text_text: [96] char

    update_row_text :: () -> const char* #export {
        if !update_available_flag {
            return ""
        }
        snprintf(update_row_text_text, sizeof(update_row_text_text), "%s: v%s",
        GetLocaleText("update_available_row"),
        kry_update_flow_new_version(flow))
        return update_row_text_text
    }
    update_download_url :: () -> const char* #export {
        if flow == nil {
            return ""
        }
        {
            release: const char* = kry_update_flow_release_url(flow)
            if release[0] != '\0' {
                return release
            }
        }
        return "https://github.com/waozixyz/inbe/releases"
    }
    update_flow :: () -> UpdateFlow #export {
        # map kryon states onto the historical app enum
        switch kry_update_flow_state(flow) {
            case KRY_UPDATE_FLOW_AVAILABLE:
            return UPDATE_FLOW_AVAILABLE
            case KRY_UPDATE_FLOW_DOWNLOADING:
            return UPDATE_FLOW_DOWNLOADING
            case KRY_UPDATE_FLOW_READY:
            return UPDATE_FLOW_READY
            case KRY_UPDATE_FLOW_FAILED:
            return UPDATE_FLOW_FAILED
            default:
            return UPDATE_FLOW_IDLE
        }
    }
    update_can_self_update :: () -> int #export {
        return flow != nil && kry_update_flow_artifact(flow) != nil
    }
    update_download_fraction :: () -> double #export {
        return kry_update_flow_progress(flow)
    }
    update_flow_error :: () -> const char* #export {
        return kry_update_flow_error(flow)
    }
    update_is_downloading :: () -> int #export {
        return kry_update_flow_state(flow) == KRY_UPDATE_FLOW_DOWNLOADING
    }
    static update_action_label_label: [96] char

    update_action_label :: () -> const char* #export {
        if kry_update_flow_state(flow) == KRY_UPDATE_FLOW_READY {
            return GetLocaleText("update_restart")
        }
        if kry_update_flow_state(flow) == KRY_UPDATE_FLOW_FAILED {
            return GetLocaleText("update_retry")
        }
        snprintf(update_action_label_label, sizeof(update_action_label_label), "%s v%s",
        GetLocaleText("update_download"), kry_update_flow_new_version(flow))
        return update_action_label_label
    }
    update_row_action :: () #export {
        if kry_update_flow_state(flow) == KRY_UPDATE_FLOW_READY {
            update_apply()
        } else {
            logged_failed = 0
            kry_update_flow_download(flow)
        }
    }
    update_error_text :: () -> const char* #export {
        error: const char*
        if kry_update_flow_state(flow) != KRY_UPDATE_FLOW_FAILED {
            return ""
        }
        error = kry_update_flow_error(flow)
        return error != nil && error[0] != '\0' ? error
        : GetLocaleText("update_failed")
    }
    update_apply :: () #export {
        app: InnerBreeze* = get_global_app()
        if kry_update_flow_apply(flow) {
            apply_armed = 1
            if app != nil {
                app->request_quit = 1
            }
            # already user-confirmed; skip the close prompt
        }
    }
    update_apply_at_exit :: () -> int #export {
        if flow == nil || !apply_armed {
            return 0
        }
        TraceLog(LOG_INFO, "APP: applying update and restarting")
        if !kry_update_flow_exec_pending(flow) {
            TraceLog(LOG_WARNING, "APP: update re-exec failed; continuing exit")
        }
        return 1
    }
} #else {
    # web/Android: stores manage updates
    update_check_start :: () #export {

    }
    update_check_poll :: () #export {

    }
    update_available :: () -> int #export {
        return 0
    }
    update_row_text :: () -> const char* #export {
        return ""
    }
    update_download_url :: () -> const char* #export {
        return ""
    }
    update_flow :: () -> UpdateFlow #export {
        return UPDATE_FLOW_IDLE
    }
    update_can_self_update :: () -> int #export {
        return 0
    }
    update_download_fraction :: () -> double #export {
        return -1.0
    }
    update_flow_error :: () -> const char* #export {
        return nil
    }
    update_is_downloading :: () -> int #export {
        return 0
    }
    update_action_label :: () -> const char* #export {
        return ""
    }
    update_row_action :: () #export {

    }
    update_error_text :: () -> const char* #export {
        return ""
    }
    update_apply :: () #export {

    }
    update_apply_at_exit :: () -> int #export {
        return 0
    }
}
