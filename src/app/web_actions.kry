    web_test_rect_valid :: (rect: Rectangle) -> int #private {
        return rect.width > 0.0f && rect.height > 0.0f
    }
    static web_test_first_run_guide_action_anchor_zero_rect: const Rectangle

    web_test_first_run_guide_action_anchor :: (app: InnerBreeze*) -> Rectangle #private {
        manual: Rectangle
        config: Rectangle
        anchor: Rectangle
        manual_valid: int
        config_valid: int
        right: float
        bottom: float
        config_right: float
        config_bottom: float
        if app == nil {
            return web_test_first_run_guide_action_anchor_zero_rect
        }
        manual = app->practice_home_bounds_manual
        config = app->practice_home_bounds_config
        manual_valid = web_test_rect_valid(manual)
        config_valid = web_test_rect_valid(config)
        if !manual_valid {
            return config_valid ? config : web_test_first_run_guide_action_anchor_zero_rect
        }
        if !config_valid {
            return manual
        }
        anchor = manual
        if config.x < anchor.x {
            anchor.x = config.x
        }
        if config.y < anchor.y {
            anchor.y = config.y
        }
        right = manual.x + manual.width
        bottom = manual.y + manual.height
        config_right = config.x + config.width
        config_bottom = config.y + config.height
        if config_right > right {
            right = config_right
        }
        if config_bottom > bottom {
            bottom = config_bottom
        }
        anchor.width = right - anchor.x
        anchor.height = bottom - anchor.y
        return anchor
    }
    app_web_test_first_run_guide_anchor_x :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(get_global_app())
        return (int)anchor.x
    }
    app_web_test_first_run_guide_anchor_y :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(get_global_app())
        return (int)anchor.y
    }
    app_web_test_first_run_guide_anchor_w :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(get_global_app())
        return (int)anchor.width
    }
    app_web_test_first_run_guide_anchor_h :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(get_global_app())
        return (int)anchor.height
    }
    app_web_test_sync_key_state :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        source: SyncAccount* = &web_test_source_account
        if web_test_sync_key_import_status != 1 {
            return web_test_sync_key_import_status
        }
        if !HasSyncAccountValues(source) {
            return -10
        }
        return 1
    }
    app_web_test_import_sync_key :: () #export #attr "EMSCRIPTEN_KEEPALIVE" {
        source: SyncAccount* = &web_test_source_account
        web_test_sync_key_import_status = 0
        data_init()
        web_test_make_sync_account(source)
        if !HasSyncAccountValues(source) {
            web_test_sync_key_import_status = -1
            return
        }
        storage_settings_begin_write()
        storage_set_setting_text("sync_public_id", source->public_id)
        storage_set_setting_text("sync_public_key", source->public_key_hex)
        storage_set_setting_text("sync_private_key", source->private_key_hex)
        storage_set_setting_text("sync_account_alias", "")
        storage_set_sync_enabled(0)
        storage_settings_end_write()
        web_test_sync_key_import_status = 1
    }
    web_test_habits_click_target :: () -> Vector2 #private {
        app := get_global_app()
        if app == nil || app->breathing.screen != ScreenHabits {
            return (Vector2){-1, -1}
        }
        bounds := habits_first_day_bounds
        if !web_test_rect_valid(bounds) {
            return (Vector2){-1, -1}
        }
        return GetWorldToScreen2D((Vector2){bounds.x + bounds.width / 2,
            bounds.y + bounds.height / 2}, app->camera)
    }
    app_web_test_habits_click_x :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        target := web_test_habits_click_target()
        return (int)target.x
    }
    app_web_test_habits_click_y :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        target := web_test_habits_click_target()
        return (int)target.y
    }
