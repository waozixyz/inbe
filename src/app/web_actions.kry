    app_web_test_practice_start_click_x :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        app: InnerBreeze* = get_global_app()
        if app == nil || !web_test_rect_valid(app->practice_home_bounds_start) {
            return -1
        }
        return (int)(app->practice_home_bounds_start.x +
        app->practice_home_bounds_start.width * 0.5f)
    }
    app_web_test_practice_start_click_y :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        app: InnerBreeze* = get_global_app()
        if app == nil || !web_test_rect_valid(app->practice_home_bounds_start) {
            return -1
