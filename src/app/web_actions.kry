    app_web_test_onboarding_state :: () -> int #export #attr "EMSCRIPTEN_KEEPALIVE" {
        app: InnerBreeze* = get_global_app()
        if app == nil {
            return 0
        }
        return app->language_selected && strcmp(app->language, "es") == 0 &&
