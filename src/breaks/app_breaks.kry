#import "app.h"
#import "platform/inbe_activity_monitor.h" #private
#import "platform/inbe_desktop_tray.h" #private
#import "storage/break_stats.h" #private
ovl :: #import "screens/break_overlay"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB
TRAY :: #defined(INBE_DESKTOP_TRAY_ENABLED)

#enum {
    BreakActivityThresholdMs = 1000
    BreakDayResetHour = 4
    BreakPreludeToastS = 6
    BreakEventQueueMax = 8
    BreakStatsFlushS = 60
    BreakFallbackInputTicks = 90
    BreakCatchupMaxS = 300
}

break_day_key :: () -> int #private {
    now: time_t = time(nil)
    tm: struct tm* = localtime(&now)

    if tm == nil {
        return 0
    }

    key := (tm->tm_year + 1900) * 366 + tm->tm_yday
    if tm->tm_hour < BreakDayResetHour {
        key--
    }
    return key
}

break_fallback_input_seen :: () -> int #private {
    wheel := (int)(GetMouseWheelMove() * 1000.0f)
    if wheel != 0 {
        return 1
    }
    dx := GetMouseDelta().x
    dy := GetMouseDelta().y
    if dx != 0.0f || dy != 0.0f {
        return 1
    }
    for int k = KEY_SPACE; k <= KEY_KB_MENU; k++ {
        if IsKeyPressed(k) {
            return 1
        }
    }
    return 0
}

break_sample_activity :: (app: InbeApp*, idle_ms_out: int*) -> int #private {
    idle_ms := inbe_activity_get_idle_ms()
    if idle_ms_out != nil {
        *idle_ms_out = (int)idle_ms
    }

    if idle_ms >= 0 {
        return idle_ms < BreakActivityThresholdMs ? 1 : 0
    }

    if !IsWindowFocused() {
        return 0
    }
    if break_fallback_input_seen() {
        app->break_fallback_last_input = app->inbe.frame
    }
    return app->inbe.frame - app->break_fallback_last_input < BreakFallbackInputTicks ? 1 : 0
}

break_play_cue :: (app: InbeApp*, scale: float) #private {
    if app->break_sounds_enabled {
        app_play_bell_cue(app, scale)
    }
}

break_pick_exercises :: (app: InbeApp*) #private {
    app->break_ex_pick_count = 0
    app->break_ex_offset_s = 0
    app->break_ex_paused = 0
    app->break_ex_hidden = 0

    if app->break_exercise_count <= 0 {
        return
    }

    seed := app->breaks.day_key * 100 + app->breaks.stats[BREAK_REST].taken +
            app->breaks.stats[BREAK_REST].natural + 1
    app->break_ex_pick_count = break_exercise_shuffle(seed,
        app->break_exercise_count, app->break_ex_picked, 4)
}

break_engine_open_window :: (app: InbeApp*, t: int) #private {
    # The break renders only in its own centered always-on-top window
    # (created per-frame in app_breaks_window_update). The main window -
    # possibly hidden to tray - is left completely alone. Only the keyboard
    # block for strict block modes is applied on top.
    #if DESKTOP {
        if app->break_block_mode >= 1 {
            inbe_break_set_input_blocked(1)
        }
    }
    app->break_window_taken = 1
}

break_engine_close_window :: (app: InbeApp*) #private {
    if !app->break_window_taken {
        return
    }
    app->break_window_taken = 0
    if app->break_window != nil {
        CloseUIWindow(app->break_window)
        app->break_window = nil
    }
    #if DESKTOP {
        inbe_break_set_input_blocked(0)
    }
}

# The break overlay as its own OS window: centered, borderless, always on
# top. Drawn with the regular break screen; clicks are hit-tested by hand
# because widget mouse state belongs to the main window.
app_breaks_window_update :: (app: InbeApp*) {
#if !ANDROID && !WEB {
    if app == nil {
        return
    }
    t := break_engine_active_break(&app->breaks)
    if t < 0 {
        if app->break_window != nil {
            CloseUIWindow(app->break_window)
            app->break_window = nil
        }
        return
    }

    scale := GetUIDPIScale()
    if scale <= 0 || scale > 8 {
        scale = 1
    }
    monitor := GetCurrentMonitor()
    win_w := GetMonitorWidth(monitor) * 60 / 100
    win_h := GetMonitorHeight(monitor) * 66 / 100
    if win_w < ScaleUIPx(340) {
        win_w = ScaleUIPx(340)
    }
    if win_h < ScaleUIPx(320) {
        win_h = ScaleUIPx(320)
    }

    if app->break_window != nil && (app->break_window_w != win_w ||
                                    app->break_window_h != win_h) {
        CloseUIWindow(app->break_window)
        app->break_window = nil
    }
    if app->break_window == nil {
        flags := UI_WINDOW_BORDERLESS + UI_WINDOW_ALWAYS_ON_TOP +
                 UI_WINDOW_SKIP_TASKBAR + UI_WINDOW_CENTER
        app->break_window = OpenUIWindow("Inner Breeze", 0, 0,
                                         win_w, win_h, flags,
                                         DarkenUIColor(GetThemeBackground(), 8),
                                         scale)
        if app->break_window == nil {
            return
        }
        app->break_window_w = win_w
        app->break_window_h = win_h
    }

    BeginUIWindow(app->break_window)
    ovl.break_overlay_draw_sized(app, win_w, win_h)
    EndUIWindow()

    click_x := 0
    click_y := 0
    if IsUIWindowDragged(app->break_window) {
        return
    }
    if IsUIWindowRightClicked(app->break_window) {
        #if TRAY {
            win_quit := 0
            inbe_desktop_tray_apply_action(app,
                                             INBE_DESKTOP_TRAY_ACTION_BREAK_SETTINGS,
                                             &win_quit)
        } #else {
            app->settings_tab = SETTINGS_TAB_BREAKS
            app_switch_screen(app, InbeScreenSettings)
        }
        return
    }
    if IsUIWindowClicked(app->break_window) {
        GetUIWindowClickPosition(app->break_window, &click_x, &click_y)
        app_breaks_window_click(app, t, click_x, click_y, win_w, win_h)
    }
}
}

# Manual hit-test of the break overlay's button row (layout mirrored from
# break_overlay_draw; DrawUITextButton centers each button on its x).
app_breaks_window_click :: (app: InbeApp*, t: int, x: int, y: int,
                              view_w: int, view_h: int) {
    timer := &app->breaks.timers[t]
    if timer->lock_buttons_s > 0 {
        return
    }
    panel_w := view_w * 72 / 100
    if panel_w > ScaleUIPx(560) {
        panel_w = ScaleUIPx(560)
    }
    if panel_w < ScaleUIPx(280) {
        panel_w = ScaleUIPx(280)
    }
    panel_h := view_h * 46 / 100
    if panel_h > ScaleUIPx(420) {
        panel_h = ScaleUIPx(420)
    }
    if panel_h < ScaleUIPx(240) {
        panel_h = ScaleUIPx(240)
    }
    panel_y := view_h / 2 - panel_h / 2
    button_y := panel_y + panel_h - ScaleUIPx(56)
    if y < button_y - ScaleUIPx(8) || y > button_y + ScaleUIPx(40) {
        return
    }
    button_w := ScaleUIPx(132)
    gap := ScaleUIPx(12)
    half := button_w / 2 + ScaleUIPx(10)
    count := 0
    if timer->show_postpone != 0 {
        count++
    }
    if timer->show_skip != 0 {
        count++
    }
    if t == BREAK_MICRO {
        count++
    }
    if count == 0 {
        return
    }
    row_w := count * button_w + (count - 1) * gap
    cx := view_w / 2 - row_w / 2
    if timer->show_postpone != 0 {
        if x >= cx - half && x <= cx + half {
            break_engine_postpone(&app->breaks, t)
            return
        }
        cx += button_w + gap
    }
    if timer->show_skip != 0 {
        if x >= cx - half && x <= cx + half {
            break_engine_skip(&app->breaks, t)
            return
        }
        cx += button_w + gap
    }
    if t == BREAK_MICRO {
        if x >= cx - half && x <= cx + half {
            break_engine_force_break(&app->breaks, BREAK_REST)
        }
    }
}

app_breaks_update :: (app: InbeApp*) {
    if app == nil || !app->breaks_enabled {
        return
    }

#if !ANDROID && !WEB {
    idle_ms := 0
    active := break_sample_activity(app, &idle_ms)
    now := GetTime()
    elapsed := 0.0f
    ticks := 0

    app->break_input_active = active

    # Natural breaks straight from the OS idle counter: covers absences the
    # capped catch-up ticks cannot see (loop stalls, suspend). The engine's
    # per-timer latch keeps one idle period from taking a break twice.
    if idle_ms >= 0 {
        break_engine_note_idle(&app->breaks, idle_ms / 1000)
    }

    if app->break_last_update_time <= 0.0f {
        app->break_last_update_time = now
    }
    elapsed = (float)(now - app->break_last_update_time)
    if elapsed < 0.0f {
        elapsed = 0.0f
    }
    if elapsed > (float)BreakCatchupMaxS {
        elapsed = (float)BreakCatchupMaxS
    }
    app->break_last_update_time = now

    pending := app->break_tick_pending + elapsed * (float)BreakTicksPerSecond
    ticks = (int)pending
    if ticks <= 0 {
        app->break_tick_pending = pending
        return
    }
    if ticks > BreakCatchupMaxS * BreakTicksPerSecond {
        ticks = BreakCatchupMaxS * BreakTicksPerSecond
    }
    app->break_tick_pending = pending - (float)ticks

    # The activity sample only says whether input happened within the last
    # BreakActivityThresholdMs - it cannot vouch for a longer stall (occluded
    # or hidden window, system suspend, a slow frame). Credit at most one
    # second of the batch to the live sample; older catch-up ticks run as
    # idle so time away from the machine never counts toward the next break.
    active_ticks := 0
    if active {
        active_ticks = BreakTicksPerSecond
        if active_ticks > ticks {
            active_ticks = ticks
        }
    }

    day := break_day_key()
    if break_engine_set_day(&app->breaks, day) {
        storage_break_flush_day(&app->breaks)
        break_engine_reset_day_stats(&app->breaks)
        app->break_stats_flush_s = 0
    }

    for int i = 0; i < ticks; i++ {
        sample_active := i >= ticks - active_ticks ? active : 0
        break_engine_tick(&app->breaks, sample_active)
        app->break_stats_flush_s++
    }
    if app->break_stats_flush_s >= BreakStatsFlushS {
        app->break_stats_flush_s = 0
        storage_break_flush_day(&app->breaks)
    }

    for int i = 0; i < BreakEventQueueMax; i++ {
        t := 0
        event := break_engine_take_event(&app->breaks, &t)
        if event == BreakEventNone {
            break
        }

        if event == BreakEventPrompt {
            ShowUIToastFor(GetLocaleText("break_prelude_text"), BreakPreludeToastS)
            break_play_cue(app, 0.8f)
        } else if event == BreakEventStart {
            break_engine_open_window(app, t)
            break_play_cue(app, 1.0f)
        } else if event == BreakEventTaken || event == BreakEventNatural {
            break_engine_close_window(app)
            if t != BREAK_DAILY {
                break_play_cue(app, 1.2f)
            }
        } else if event == BreakEventSkipped || event == BreakEventPostponed {
            break_engine_close_window(app)
        }
    }
}
}

app_breaks_set_mode :: (app: InbeApp*, mode: int, duration_s: int) {
    if app == nil {
        return
    }
    break_engine_set_mode(&app->breaks, mode, duration_s)
}

app_breaks_rest_break_now :: (app: InbeApp*) {
    if app == nil || !app->breaks_enabled {
        return
    }
    break_engine_force_break(&app->breaks, BREAK_REST)
    for int i = 0; i < BreakEventQueueMax; i++ {
        t := 0
        event := break_engine_take_event(&app->breaks, &t)
        if event == BreakEventStart {
            break_engine_open_window(app, t)
        }
    }
}

app_breaks_exercise_second :: (app: const InbeApp*) -> int {
    if app == nil || app->break_ex_pick_count <= 0 || app->break_ex_hidden {
        return -1
    }
    if app->break_ex_paused {
        return app->break_ex_offset_s
    }
    timer := &app->breaks.timers[BREAK_REST]
    elapsed := timer->idle_s - app->break_ex_offset_s
    if elapsed < 0 {
        elapsed = 0
    }
    return elapsed
}

app_breaks_exercise_at :: (app: const InbeApp*, second: int, start_out: int*) -> int {
    if app == nil || second < 0 {
        return -1
    }
    start := 0
    for int i = 0; i < app->break_ex_pick_count; i++ {
        total := break_exercise_total_s(app->break_ex_picked[i])
        if second < start + total {
            if start_out != nil {
                *start_out = start
            }
            return i
        }
        start += total
    }
    return -1
}

app_breaks_exercise_step_second :: (app: const InbeApp*, index: int, second: int) -> int {
    if app == nil || index < 0 || index >= app->break_ex_pick_count {
        return -1
    }
    ex := app->break_ex_picked[index]
    duration := break_exercise_step_duration_s(ex)
    if duration <= 0 {
        return -1
    }
    return second / duration
}

app_breaks_exercise_toggle_pause :: (app: InbeApp*) {
    elapsed := 0

    if app == nil || app->break_ex_pick_count <= 0 || app->break_ex_hidden {
        return
    }
    elapsed = app_breaks_exercise_second(app)
    if elapsed < 0 {
        return
    }
    if !app->break_ex_paused {
        app->break_ex_offset_s = elapsed
        app->break_ex_paused = 1
    } else {
        app->break_ex_offset_s = app->breaks.timers[BREAK_REST].idle_s - elapsed
        if app->break_ex_offset_s < 0 {
            app->break_ex_offset_s = 0
        }
        app->break_ex_paused = 0
    }
}

app_breaks_exercise_skip :: (app: InbeApp*, forward: int) {
    start := 0
    index := 0
    target := 0
    idle := 0

    if app == nil || app->break_ex_pick_count <= 0 || app->break_ex_hidden {
        return
    }

    idle = app->breaks.timers[BREAK_REST].idle_s
    index = app_breaks_exercise_at(app, app_breaks_exercise_second(app), &start)
    if index < 0 {
        return
    }

    if forward {
        target = start + break_exercise_total_s(app->break_ex_picked[index])
        if target >= idle && index >= app->break_ex_pick_count - 1 {
            return
        }
    } else {
        target = start
        if index > 0 {
            target -= break_exercise_total_s(app->break_ex_picked[index - 1])
        }
        if target < 0 {
            target = 0
        }
    }

    app->break_ex_offset_s = idle - target
    if app->break_ex_offset_s < 0 {
        app->break_ex_offset_s = 0
    }
    app->break_ex_paused = 0
}

app_breaks_exercise_hide :: (app: InbeApp*) {
    if app == nil {
        return
    }
    app->break_ex_hidden = 1
}

app_breaks_hud_update :: (app: InbeApp*) {
#if !ANDROID && !WEB {
    if app == nil {
        return
    }
    if !app->breaks_enabled {
        if app->break_hud != nil {
            CloseUIWindow(app->break_hud)
            app->break_hud = nil
        }
        return
    }

    scale := GetUIDPIScale()
    if scale <= 0 || scale > 8 {
        scale = 1
    }
    hud_w := (int)(150 * scale + 0.5)
    row_h := (int)(17 * scale + 0.5)
    pad := (int)(7 * scale + 0.5)
    # disabled timers are not shown at all: the hud only has rows for the
    # enabled ones
    visible := 0
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        if app->breaks.timers[t].enabled {
            visible++
        }
    }
    if visible == 0 {
        if app->break_hud != nil {
            CloseUIWindow(app->break_hud)
            app->break_hud = nil
        }
        return
    }
    hud_h := pad * 2 + row_h * visible

    if app->break_hud != nil && (app->break_hud_w != hud_w || app->break_hud_h != hud_h) {
        CloseUIWindow(app->break_hud)
        app->break_hud = nil
    }
    if app->break_hud == nil {
        track := DarkenUIColor(GetThemeBackground(), 18)
        flags := UI_WINDOW_BORDERLESS + UI_WINDOW_ALWAYS_ON_TOP +
                 UI_WINDOW_SKIP_TASKBAR
        hud_x := ScaleUIPx(8)
        hud_y := ScaleUIPx(8)
        if app->break_hud_x >= 0 && app->break_hud_y >= 0 {
            # restore the dragged-to position instead of the default corner
            hud_x = app->break_hud_x
            hud_y = app->break_hud_y
        } else {
            flags += UI_WINDOW_TOP_RIGHT
        }
        app->break_hud = OpenUIWindow("Inner Breeze", hud_x, hud_y,
                                      hud_w, hud_h, flags, track, scale)
        if app->break_hud == nil {
            return
        }
        app->break_hud_w = hud_w
        app->break_hud_h = hud_h
    }

    BeginUIWindow(app->break_hud)
    app_breaks_hud_draw(app, hud_w, hud_h, row_h, pad)
    EndUIWindow()

    if IsUIWindowDragged(app->break_hud) {
        GetUIWindowPosition(app->break_hud, &app->break_hud_x,
                            &app->break_hud_y)
        app->settings_dirty = 1
        save_settings(app)
    } else if IsUIWindowRightClicked(app->break_hud) {
        #if TRAY {
            hud_quit := 0
            inbe_desktop_tray_apply_action(app,
                                             INBE_DESKTOP_TRAY_ACTION_BREAK_SETTINGS,
                                             &hud_quit)
        } #else {
            app->settings_tab = SETTINGS_TAB_BREAKS
            app_switch_screen(app, InbeScreenSettings)
        }
    } else if IsUIWindowClicked(app->break_hud) {
        app->settings_tab = SETTINGS_TAB_BREAKS
        app_switch_screen(app, InbeScreenSettings)
    }
}
}

app_breaks_hud_draw :: (app: InbeApp*, hud_w: int, hud_h: int, row_h: int, pad: int) {
    track := DarkenUIColor(GetThemeBackground(), 18)
    border := DarkenUIColor(GetThemeText(), 62)
    muted := DarkenUIColor(GetThemeText(), 45)
    fill := (Color){74, 178, 102, 255}
    overdue := (Color){222, 140, 44, 255}
    idle_col := (Color){240, 200, 60, 255}
    labels: [BREAK_TYPE_COUNT] const char* = {
        GetLocaleText("break_hud_micro"),
        GetLocaleText("break_hud_rest"),
        GetLocaleText("break_hud_daily")
    }

    Rect(0, 0, hud_w, hud_h, track, border)

    row := 0
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        timer := &app->breaks.timers[t]
        if !timer->enabled {
            continue
        }
        row_y := pad + row_h * row
        row = row + 1
        bar_x := pad
        bar_w := hud_w - pad * 2
        time_x := hud_w - pad
        next := break_timer_next_due_s(&app->breaks, t)

        Text(labels[t], bar_x, row_y + ScaleUIPx(2), UI_TEXT_12, muted)

        if next < 0 {
            line := "off"
            Text(line, time_x - MeasureUIText(line, UI_TEXT_12), row_y + ScaleUIPx(2),
                 UI_TEXT_12, muted)
        } else if timer->state == BreakStateBreaking {
            # active break: count down the remaining rest time (this is the
            # wait that resets the timer once it completes)
            left := timer->duration_s - timer->idle_s
            if left < 0 {
                left = 0
            }
            line: [16] char
            break_format_duration(line, sizeof(line), left)
            Text(line, time_x - MeasureUIText(line, UI_TEXT_12), row_y + ScaleUIPx(2),
                 UI_TEXT_12, fill)
            if timer->duration_s > 0 {
                fraction := timer->idle_s * (bar_w - 2) / timer->duration_s
                if fraction > bar_w - 2 {
                    fraction = bar_w - 2
                }
                Rect(bar_x, row_y + row_h - ScaleUIPx(4), bar_w, ScaleUIPx(3),
                     DarkenUIColor(GetThemeBackground(), 30), DarkenUIColor(GetThemeBackground(), 30))
                if fraction > 0 {
                    Rect(bar_x + 1, row_y + row_h - ScaleUIPx(4), fraction, ScaleUIPx(3),
                         fill, fill)
                }
            }
        } else {
            line: [16] char
            if next == 0 {
                snprintf(line, sizeof(line), "%s", GetLocaleText("settings_breaks_due_now"))
            } else {
                break_format_duration(line, sizeof(line), next)
            }
            color := next == 0 ? overdue : GetThemeText()
            Text(line, time_x - MeasureUIText(line, UI_TEXT_12), row_y + ScaleUIPx(2),
                 UI_TEXT_12, color)

            if timer->limit_s > 0 {
                fraction := timer->active_s * (bar_w - 2) / timer->limit_s
                if fraction > bar_w - 2 {
                    fraction = bar_w - 2
                }
                Rect(bar_x, row_y + row_h - ScaleUIPx(4), bar_w, ScaleUIPx(3),
                     DarkenUIColor(GetThemeBackground(), 30), DarkenUIColor(GetThemeBackground(), 30))
                if fraction > 0 {
                    Rect(bar_x + 1, row_y + row_h - ScaleUIPx(4), fraction, ScaleUIPx(3),
                         next == 0 ? overdue : fill, next == 0 ? overdue : fill)
                }
                # Idle progress toward a natural break: a yellow tip grows on
                # top of the green fill toward the end of the bar. Full yellow
                # means the idle duration is reached - the break is taken
                # naturally and the timer resets.
                if timer->state == BreakStateRunning && timer->duration_s > 0 &&
                   timer->idle_s > 0 && !timer->idle_latched {
                    tip := (bar_w - 2 - fraction) * timer->idle_s / timer->duration_s
                    if tip > 0 {
                        Rect(bar_x + 1 + fraction, row_y + row_h - ScaleUIPx(4),
                             tip, ScaleUIPx(3), idle_col, idle_col)
                    }
                }
            }
        }
    }
}
