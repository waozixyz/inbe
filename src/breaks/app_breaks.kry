#import "app.h"
#import "platform/inbe_activity_monitor.h" #private

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)

#enum {
    BreakActivityThresholdMs = 1000
    BreakDayResetHour = 4
    BreakPreludeToastS = 6
    BreakEventQueueMax = 8
}

break_day_key :: () -> int #private {
    now: time_t = time(nil)
    tm: struct tm* = localtime(&now)

    if tm == nil {
        return 0
    }

    key := (tm->tm_year + 1900) * 366 + tm->tm_yday
    if tm->tm_hour < BreakDayResetHour {
        key--
    }
    return key
}

break_sample_activity :: (app: InbeApp*) -> int #private {
    idle_ms := inbe_activity_get_idle_ms()

    if idle_ms >= 0 {
        return idle_ms < BreakActivityThresholdMs ? 1 : 0
    }

    if IsWindowFocused() {
        return 1
    }
    return 0
}

break_engine_open_window :: (app: InbeApp*, t: int) #private {
    if app->inbe.screen != InbeScreenBreak {
        app->break_prev_screen = app->inbe.screen
        app_switch_screen(app, InbeScreenBreak)
    }
    if IsWindowHidden() {
        RestoreWindow()
    }

    SetWindowState(FLAG_WINDOW_TOPMOST)
    if app->break_block_mode >= 2 {
        SetWindowState(FLAG_WINDOW_UNDECORATED)
        MaximizeWindow()
    }
    if app->break_block_mode >= 1 {
        inbe_break_set_input_blocked(1)
    }
}

break_engine_close_window :: (app: InbeApp*) #private {
    if app->inbe.screen == InbeScreenBreak {
        app_switch_screen(app, app->break_prev_screen != 0 ? app->break_prev_screen : InbeScreenStart)
    }
    ClearWindowState(FLAG_WINDOW_TOPMOST | FLAG_WINDOW_UNDECORATED)
    if app->break_block_mode >= 2 {
        RestoreWindow()
    }
    inbe_break_set_input_blocked(0)
}

app_breaks_update :: (app: InbeApp*) {
    if app == nil || !app->breaks_enabled {
        return
    }

#if !ANDROID && !WEB {
    active := break_sample_activity(app)
    app->break_input_active = active

    day := break_day_key()
    if break_engine_set_day(&app->breaks, day) {
        break_engine_reset_day_stats(&app->breaks)
    }

    break_engine_tick(&app->breaks, active)

    for int i = 0; i < BreakEventQueueMax; i++ {
        t := 0
        event := break_engine_take_event(&app->breaks, &t)
        if event == BreakEventNone {
            break
        }

        if event == BreakEventPrompt {
            ShowUIToastFor(GetLocaleText("break_prelude_text"), BreakPreludeToastS)
        } else if event == BreakEventStart {
            break_engine_open_window(app, t)
        } else if event == BreakEventTaken || event == BreakEventNatural {
            break_engine_close_window(app)
        } else if event == BreakEventSkipped || event == BreakEventPostponed {
            break_engine_close_window(app)
        }
    }
}
