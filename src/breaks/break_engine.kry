#enum {
    BreakTicksPerSecond = 60
    BreakPreludeRepeatS = 30
    BreakPromotionWindowS = 30
}

#enum {
    BREAK_MICRO = 0
    BREAK_REST = 1
    BREAK_DAILY = 2
    BREAK_TYPE_COUNT = 3
}

#enum {
    BreakStateRunning = 0
    BreakStatePrompting
    BreakStateSnoozed
    BreakStateBreaking
}

#enum {
    BreakModeNormal = 0
    BreakModeQuiet
    BreakModeSuspended
}

#enum {
    BreakEventNone = 0
    BreakEventModeExpired
    BreakEventPrompt
    BreakEventNatural
    BreakEventPostponed
    BreakEventSkipped
    BreakEventTaken
    BreakEventStart
}

BreakDayStats :: struct {
    prompts: int
    repeated_prompts: int
    taken: int
    natural: int
    skipped: int
    postponed: int
    overdue_s: int
}

BreakTimer :: struct {
    enabled: int
    limit_s: int
    duration_s: int
    postpone_s: int
    max_prompts: int
    show_skip: int
    show_postpone: int

    active_s: int
    idle_s: int
    idle_latched: int
    snooze_s: int
    prompt_s: int
    prompt_count: int
    lock_buttons_s: int
    skipped_today: int
    state: int
}

BreakEngine :: struct {
    timers: [BREAK_TYPE_COUNT] BreakTimer
    stats: [BREAK_TYPE_COUNT] BreakDayStats

    usage_today_s: int
    mode: int
    mode_until_s: int
    reading_mode: int
    reading_active: int
    micro_counts_as_activity: int
    day_key: int

    sectick: int
    event: int
    event_break: int
}

break_engine_raise :: (e: BreakEngine*, event: int, t: int) #private {
    if event < e->event {
        return
    }
    e->event = event
    e->event_break = t
}

break_engine_init :: (e: BreakEngine*) {
    if e == nil {
        return
    }

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        timer := &e->timers[t]
        timer->enabled = 1
        timer->limit_s = 0
        timer->duration_s = 0
        timer->postpone_s = 0
        timer->max_prompts = 3
        timer->show_skip = 1
        timer->show_postpone = 1
        timer->active_s = 0
        timer->idle_s = 0
        timer->idle_latched = 0
        timer->snooze_s = 0
        timer->prompt_s = 0
        timer->prompt_count = 0
        timer->lock_buttons_s = 0
        timer->skipped_today = 0
        timer->state = BreakStateRunning
    }

    e->timers[BREAK_MICRO].limit_s = 180
    e->timers[BREAK_MICRO].duration_s = 30
    e->timers[BREAK_MICRO].postpone_s = 150
    # micro breaks open their window the moment they are due - the toast
    # prompt phase would be invisible whenever the main window is in tray
    e->timers[BREAK_MICRO].max_prompts = 0

    e->timers[BREAK_REST].limit_s = 2700
    e->timers[BREAK_REST].duration_s = 600
    e->timers[BREAK_REST].postpone_s = 180

    e->timers[BREAK_DAILY].limit_s = 14400
    e->timers[BREAK_DAILY].postpone_s = 1200

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        e->stats[t].prompts = 0
        e->stats[t].repeated_prompts = 0
        e->stats[t].taken = 0
        e->stats[t].natural = 0
        e->stats[t].skipped = 0
        e->stats[t].postponed = 0
        e->stats[t].overdue_s = 0
    }

    e->usage_today_s = 0
    e->mode = BreakModeNormal
    e->mode_until_s = 0
    e->reading_mode = 0
    e->reading_active = 0
    e->micro_counts_as_activity = 0
    e->day_key = 0
    e->sectick = 0
    e->event = BreakEventNone
    e->event_break = BREAK_MICRO
}

break_timer_begin :: (e: BreakEngine*, t: int) #private {
    timer := &e->timers[t]

    # A higher-priority break takes the window over: credit and reset any
    # lower break that is still showing.
    for int o = 0; o < BREAK_TYPE_COUNT; o++ {
        if o != t && e->timers[o].enabled && e->timers[o].state == BreakStateBreaking {
            e->timers[o].state = BreakStateRunning
            e->timers[o].active_s = 0
            e->timers[o].idle_s = 0
            e->timers[o].idle_latched = 0
            e->timers[o].prompt_s = 0
            e->timers[o].prompt_count = 0
            e->timers[o].lock_buttons_s = 0
        }
    }

    timer->state = BreakStateBreaking
    timer->idle_s = 0
    timer->idle_latched = 0
    timer->prompt_s = 0
    timer->prompt_count = 0

    if t == BREAK_REST {
        e->reading_active = 0
    }

    break_engine_raise(e, BreakEventStart, t)
}

break_timer_take :: (e: BreakEngine*, t: int, natural: int) {
    timer := &e->timers[t]
    timer->state = BreakStateRunning
    timer->active_s = 0
    timer->idle_s = 0
    # A natural take ends an idle period: latch so continued idle (the user
    # stays away) does not re-take the break every duration. Any input clears
    # the latch. A completed break window (natural == 0) starts fresh.
    timer->idle_latched = natural
    timer->prompt_s = 0
    timer->prompt_count = 0
    timer->lock_buttons_s = 0

    if natural {
        e->stats[t].natural++
        break_engine_raise(e, BreakEventNatural, t)
    } else {
        e->stats[t].taken++
        break_engine_raise(e, BreakEventTaken, t)
    }

    # Workrave semantics: a rest break subsumes micro breaks - completing one
    # (window or natural) resets the micro timer too. idle_latched stays
    # untouched: one continuous idle period must not take the same break
    # twice, and a fresh micro cycle only starts after real input.
    if t == BREAK_REST {
        micro := &e->timers[BREAK_MICRO]
        if micro->enabled && micro->state != BreakStateBreaking {
            micro->active_s = 0
            micro->idle_s = 0
            micro->snooze_s = 0
            micro->prompt_s = 0
            micro->prompt_count = 0
            if micro->state == BreakStatePrompting {
                micro->state = BreakStateRunning
            }
        }
    }

    if t == BREAK_MICRO && e->micro_counts_as_activity {
        daily := &e->timers[BREAK_DAILY]
        if daily->enabled && !daily->skipped_today && daily->limit_s > 0 {
            daily->active_s += timer->duration_s
        }
    }
}

break_timer_due :: (e: BreakEngine*, t: int) #private {
    if e->mode == BreakModeQuiet {
        e->stats[t].overdue_s++
        return
    }

    if t == BREAK_MICRO {
        rest := &e->timers[BREAK_REST]
        if rest->enabled && rest->limit_s > 0 && rest->active_s >= rest->limit_s - BreakPromotionWindowS {
            micro := &e->timers[BREAK_MICRO]
            micro->active_s = 0
            micro->idle_s = 0
            micro->state = BreakStateRunning
            if micro->max_prompts == 0 {
                rest->lock_buttons_s = rest->duration_s
            }
            break_timer_begin(e, BREAK_REST)
            return
        }
    }

    timer := &e->timers[t]
    if timer->max_prompts == 0 {
        break_timer_begin(e, t)
        return
    }

    timer->state = BreakStatePrompting
    timer->prompt_count = 1
    timer->prompt_s = 0
    timer->idle_s = 0
    e->stats[t].prompts++
    break_engine_raise(e, BreakEventPrompt, t)
}

break_timer_step :: (e: BreakEngine*, t: int, is_active: int, owner: int) #private {
    timer := &e->timers[t]
    if !timer->enabled {
        return
    }
    if t == BREAK_DAILY && timer->skipped_today {
        return
    }

    if owner >= 0 && owner != t {
        if is_active {
            timer->idle_s = 0
            timer->idle_latched = 0
        } else if !timer->idle_latched && timer->duration_s > 0 {
            timer->idle_s++
            if timer->idle_s >= timer->duration_s {
                break_timer_take(e, t, 1)
            }
        }
        return
    }

    if timer->state == BreakStateRunning {
        if is_active {
            timer->active_s++
            timer->idle_s = 0
            timer->idle_latched = 0
            if timer->limit_s > 0 && timer->active_s >= timer->limit_s {
                break_timer_due(e, t)
            }
        } else if !timer->idle_latched {
            timer->idle_s++
            if timer->duration_s > 0 && timer->idle_s >= timer->duration_s {
                break_timer_take(e, t, 1)
            }
        }
        return
    }

    if timer->state == BreakStatePrompting {
        e->stats[t].overdue_s++
        if is_active {
            timer->idle_s = 0
            timer->idle_latched = 0
        } else if !timer->idle_latched {
            timer->idle_s++
            if timer->duration_s > 0 && timer->idle_s >= timer->duration_s {
                break_timer_take(e, t, 1)
                return
            }
        }
        timer->prompt_s++
        if timer->prompt_s >= BreakPreludeRepeatS {
            timer->prompt_s = 0
            timer->prompt_count++
            e->stats[t].repeated_prompts++
            if timer->max_prompts > 0 && timer->prompt_count >= timer->max_prompts {
                break_timer_begin(e, t)
            } else {
                break_engine_raise(e, BreakEventPrompt, t)
            }
        }
        return
    }

    if timer->state == BreakStateSnoozed {
        timer->snooze_s--
        if timer->snooze_s <= 0 {
            timer->snooze_s = 0
            timer->prompt_count = 0
            timer->prompt_s = 0
            if timer->max_prompts == 0 {
                break_timer_begin(e, t)
            } else {
                timer->state = BreakStatePrompting
                e->stats[t].prompts++
                break_engine_raise(e, BreakEventPrompt, t)
            }
        }
        return
    }

    # BreakStateBreaking — but only when this timer already owned the window
    # when the tick started (owner == t). A break that began earlier in this
    # same tick (promotion, forced break) must not process its own first
    # tick.
    if owner != t {
        return
    }
    if timer->lock_buttons_s > 0 {
        timer->lock_buttons_s--
    }
    if t == BREAK_DAILY {
        return
    }
    if !is_active {
        timer->idle_s++
        if timer->idle_s >= timer->duration_s {
            break_timer_take(e, t, 0)
        }
    }
}

break_engine_tick :: (e: BreakEngine*, active: int) {
    if e == nil {
        return
    }

    e->sectick++
    if e->sectick < BreakTicksPerSecond {
        return
    }
    e->sectick = 0

    if e->mode != BreakModeNormal && e->mode_until_s > 0 {
        e->mode_until_s--
        if e->mode_until_s <= 0 {
            e->mode = BreakModeNormal
            break_engine_raise(e, BreakEventModeExpired, BREAK_MICRO)
        }
    }

    if e->mode == BreakModeSuspended {
        return
    }

    reading := 0
    if e->reading_mode {
        if active {
            e->reading_active = 1
        }
        reading = e->reading_active
    }

    is_active := active != 0 || reading != 0

    if is_active {
        e->usage_today_s++
    }

    owner := -1
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        if e->timers[t].enabled && e->timers[t].state == BreakStateBreaking {
            owner = t
        }
    }

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        break_timer_step(e, t, is_active, owner)
    }
}

break_engine_skip :: (e: BreakEngine*, t: int) {
    if e == nil || t < 0 || t >= BREAK_TYPE_COUNT {
        return
    }
    timer := &e->timers[t]
    if timer->state != BreakStateBreaking && timer->state != BreakStatePrompting {
        return
    }

    if t == BREAK_DAILY {
        timer->skipped_today = 1
    }
    timer->state = BreakStateRunning
    timer->active_s = 0
    timer->idle_s = 0
    timer->idle_latched = 0
    timer->prompt_s = 0
    timer->prompt_count = 0
    timer->lock_buttons_s = 0
    e->stats[t].skipped++
    break_engine_raise(e, BreakEventSkipped, t)
}

break_engine_postpone :: (e: BreakEngine*, t: int) {
    if e == nil || t < 0 || t >= BREAK_TYPE_COUNT {
        return
    }
    timer := &e->timers[t]
    if timer->state != BreakStateBreaking && timer->state != BreakStatePrompting {
        return
    }

    timer->state = BreakStateSnoozed
    timer->snooze_s = timer->postpone_s
    timer->idle_s = 0
    timer->idle_latched = 0
    timer->prompt_s = 0
    e->stats[t].postponed++
    break_engine_raise(e, BreakEventPostponed, t)
}

break_engine_force_break :: (e: BreakEngine*, t: int) {
    if e == nil || t < 0 || t >= BREAK_TYPE_COUNT {
        return
    }
    timer := &e->timers[t]
    if !timer->enabled || timer->state == BreakStateBreaking {
        return
    }
    if timer->active_s < timer->limit_s {
        timer->active_s = timer->limit_s
    }
    break_timer_begin(e, t)
}

break_engine_set_mode :: (e: BreakEngine*, mode: int, duration_s: int) {
    if e == nil {
        return
    }
    e->mode = mode
    e->mode_until_s = duration_s
}

break_engine_set_day :: (e: BreakEngine*, day_key: int) -> int {
    if e == nil {
        return 0
    }
    if day_key == e->day_key {
        return 0
    }
    e->day_key = day_key

    daily := &e->timers[BREAK_DAILY]
    daily->active_s = 0
    daily->idle_s = 0
    daily->idle_latched = 0
    daily->skipped_today = 0
    daily->prompt_s = 0
    daily->prompt_count = 0
    if daily->state == BreakStateBreaking {
        daily->state = BreakStateRunning
        break_engine_raise(e, BreakEventTaken, BREAK_DAILY)
    } else {
        daily->state = BreakStateRunning
    }
    return 1
}

break_engine_reset_day_stats :: (e: BreakEngine*) {
    if e == nil {
        return
    }
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        e->stats[t].prompts = 0
        e->stats[t].repeated_prompts = 0
        e->stats[t].taken = 0
        e->stats[t].natural = 0
        e->stats[t].skipped = 0
        e->stats[t].postponed = 0
        e->stats[t].overdue_s = 0
    }
    e->usage_today_s = 0
}

break_engine_take_event :: (e: BreakEngine*, break_out: int*) -> int {
    if e == nil {
        return BreakEventNone
    }
    event := e->event
    if break_out != nil {
        *break_out = e->event_break
    }
    e->event = BreakEventNone
    return event
}

break_engine_active_break :: (e: const BreakEngine*) -> int {
    if e == nil {
        return -1
    }
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        if e->timers[t].enabled && e->timers[t].state == BreakStateBreaking {
            return t
        }
    }
    return -1
}

break_timer_next_due_s :: (e: const BreakEngine*, t: int) -> int {
    if e == nil || t < 0 || t >= BREAK_TYPE_COUNT {
        return -1
    }
    if !e->timers[t].enabled {
        return -1
    }
    if e->timers[t].state != BreakStateRunning {
        return 0
    }
    left := e->timers[t].limit_s - e->timers[t].active_s
    if left < 0 {
        left = 0
    }
    return left
}

# Workrave-style natural-break detection from observed system idle time.
# The per-second ticks already credit idle while the loop runs, but a stalled
# loop (hidden window, system suspend) catches up capped at BreakCatchupMaxS,
# so a longer absence can only be seen through the OS idle counter: when the
# user has really been away for at least a break duration, take that break
# naturally and reset its timer. idle_latched keeps one idle period from
# taking the same break twice; any input re-arms it.
break_engine_note_idle :: (e: BreakEngine*, idle_s: int) -> int {
    if e == nil || idle_s < 0 {
        return 0
    }
    if e->mode == BreakModeSuspended {
        return 0
    }
    if e->reading_mode && e->reading_active {
        return 0
    }

    took := 0
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        timer := &e->timers[t]
        if !timer->enabled || timer->duration_s <= 0 || timer->idle_latched {
            continue
        }
        if timer->state == BreakStateRunning || timer->state == BreakStatePrompting {
            if idle_s >= timer->duration_s {
                break_timer_take(e, t, 1)
                took = 1
            }
        }
    }
    return took
}

# "M:SS" below an hour, "H:MM:SS" from one hour up - used by the HUD, the
# tray status, the settings rows, and the break overlay.
break_format_duration :: (dst: char*, dst_size: int, seconds: int) {
    if dst == nil || dst_size == 0 {
        return
    }
    if seconds < 0 {
        seconds = 0
    }
    if seconds >= 3600 {
        snprintf(dst, dst_size, "%d:%02d:%02d", seconds / 3600,
                 (seconds / 60) % 60, seconds % 60)
    } else {
        snprintf(dst, dst_size, "%d:%02d", seconds / 60, seconds % 60)
    }
}
