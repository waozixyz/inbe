#import "core/types"

eqcount :: (a: const char*, b: const char*) -> int #private {
    return a[0] == b[0] && a[1] == b[1] && a[2] == b[2]
}

count_value :: (v: const char*) -> int #private {
    a := v[0] >= '0' && v[0] <= '9' ? v[0] - '0' : 0
    b := v[1] >= '0' && v[1] <= '9' ? v[1] - '0' : 0
    c := v[2] >= '0' && v[2] <= '9' ? v[2] - '0' : 0

    return a * 100 + b * 10 + c
}

breath_half_ticks_for_speed :: (speed: int) -> int {
    breath_half_ticks: [8] const int = {
        180, 160, 144, 132,
        120, 108, 93, 74
    }

    if speed < 1 {
        speed = 1
    }
    if speed > 8 {
        speed = 8
    }

    return breath_half_ticks[speed - 1]
}

cpcount :: (dst: char*, src: const char*) {
    dst[0] = src[0]
    dst[1] = src[1]
    dst[2] = src[2]
    dst[3] = 0
}

inccount :: (v: char*) {
    if v[2] < '9' {
        v[2]++
        return
    }
    v[2] = '0'

    if v[1] < '9' {
        v[1]++
        return
    }
    v[1] = '0'

    if v[0] < '9' {
        v[0]++
        return
    }
    v[0] = '0'
}

get_play_in_background :: (inbe: Inbe*) -> int {
    return inbe->play_in_background
}

inbeinit :: (l: Inbe*) {
    if l == nil {
        return
    }

    l->screen = InbeScreenStart
    l->phase = InbePhaseStarting
    l->round = 0

    l->r = 25
    l->rmin = 25
    l->rmax = 50
    l->dir = 0
    l->speed_level = DefaultSpeedLevel
    l->breath_frame = 0
    l->breath_half_ticks = 120
    l->frame = 0

    l->breathtick = 0
    l->sectick = 0
    l->halftick = 0
    l->max_rounds = DefaultMaxRounds
    l->pause_seconds = DefaultPauseSeconds
    l->progressive_speed = 1
    l->progressive_start_speed = DefaultProgressiveStartSpeed
    l->breath_animation = InbeBreathAnimationLinear
    l->play_in_background = 1

    for int i = 0; i < MaxRounds; i++ {
        cpcount(l->results[i], "000")
    }

    cpcount(l->count, "000")
    cpcount(l->maxbreaths, "030")
    l->completed = 0
}

lerp_int :: (a: int, b: int, num: int, den: int) -> int #private {
    delta := b - a
    scaled := delta * num

    if scaled >= 0 {
        scaled += den / 2
    } else {
        scaled -= den / 2
    }

    return a + scaled / den
}

effective_breath_half_ticks :: (l: const Inbe*) -> int #private {
    target_ticks := breath_half_ticks_for_speed(l->speed_level)
    start_speed := l->progressive_start_speed

    if !l->progressive_speed || l->round != 0 {
        return target_ticks
    }

    if start_speed < 1 {
        start_speed = 1
    }
    if start_speed > l->speed_level {
        start_speed = l->speed_level
    }

    completed_breaths := count_value(l->count)

    if completed_breaths < 5 {
        return breath_half_ticks_for_speed(start_speed)
    }
    if completed_breaths >= 10 {
        return target_ticks
    }

    return lerp_int(
        breath_half_ticks_for_speed(start_speed),
        target_ticks,
        completed_breaths - 4,
        5
    )
}

current_breath_half_ticks :: (l: const Inbe*) -> int {
    if l == nil {
        return 0
    }
    return effective_breath_half_ticks(l)
}

current_breath_progress :: (l: const Inbe*) -> float {
    if l == nil || l->phase != InbePhaseBreathe {
        return 0.0f
    }

    half_ticks := effective_breath_half_ticks(l)
    if half_ticks <= 0 {
        return 0.0f
    }

    amount := (float)l->breath_frame / (float)half_ticks
    if amount < 0.0f {
        amount = 0.0f
    }
    if amount > 1.0f {
        amount = 1.0f
    }

    if l->dir == 0 {
        return amount * 0.5f
    }
    return 0.5f + amount * 0.5f
}

inbe_effective_pause_seconds :: (l: const Inbe*) -> int {
    if l == nil {
        return 0
    }

    if l->round == 0 {
        return 3
    }
    return l->pause_seconds
}

smoothstepf :: (t: float) -> float #private {
    if t < 0.0f {
        t = 0.0f
    }
    if t > 1.0f {
        t = 1.0f
    }
    return t * t * (3.0f - 2.0f * t)
}

eased_span :: (span: int, frame: int, half_ticks: int) -> int #private {
    if span <= 0 || half_ticks <= 0 {
        return 0
    }

    t := (float)frame / (float)half_ticks
    return (int)((float)span * smoothstepf(t) + 0.5f)
}

animated_span :: (l: const Inbe*, span: int, frame: int, half_ticks: int) -> int #private {
    if l != nil && l->breath_animation == InbeBreathAnimationLinear {
        return lerp_int(0, span, frame, half_ticks)
    }
    return eased_span(span, frame, half_ticks)
}

draw_radius :: (l: const Inbe*) -> float {
    if l == nil {
        return 0.0f
    }
    return (float)l->r
}

starting :: (l: Inbe*) #private {
    pause_ticks := inbe_effective_pause_seconds(l) * 60

    if pause_ticks <= 0 {
        l->sectick = 0
        l->phase = InbePhaseBreathe
        return
    }

    l->sectick++
    if l->sectick < pause_ticks {
        return
    }

    l->sectick = 0
    l->phase = InbePhaseBreathe
}

breathe :: (l: Inbe*) #private {
    span := l->rmax - l->rmin
    half_ticks := effective_breath_half_ticks(l)

    if span <= 0 || half_ticks <= 0 {
        return
    }

    l->breath_frame++
    if l->breath_frame > half_ticks {
        l->breath_frame = half_ticks
    }

    eased := animated_span(l, span, l->breath_frame, half_ticks)
    if l->dir == 0 {
        l->r = l->rmin + eased
    } else {
        l->r = l->rmax - eased
    }

    if l->breath_frame >= half_ticks {
        l->breath_frame = 0
        if l->dir == 0 {
            l->dir = 1
            l->r = l->rmax
        } else {
            l->dir = 0
            l->r = l->rmin
            inccount(l->count)
        }
    }

    if count_value(l->count) >= count_value(l->maxbreaths) {
        cpcount(l->count, "000")
        l->phase = InbePhaseHold
    }
}

next :: (l: Inbe*) #private {
    span := l->rmax - l->rmin

    if span <= 0 || l->breath_half_ticks <= 0 {
        return
    }

    l->breath_frame++
    if l->breath_frame > l->breath_half_ticks {
        l->breath_frame = l->breath_half_ticks
    }

    eased := animated_span(l, span, l->breath_frame, l->breath_half_ticks)
    l->r = l->rmax - eased

    if l->breath_frame >= l->breath_half_ticks {
        l->breath_frame = 0
        l->r = l->rmin
        cpcount(l->count, "000")

        if l->round < l->max_rounds - 1 {
            l->round++
            l->phase = InbePhaseStarting
        } else {
            l->completed = 1
            l->phase = InbePhaseStarting
        }
    }
}

recover :: (l: Inbe*) #private {
    span := l->rmax - l->rmin

    if span <= 0 || l->breath_half_ticks <= 0 {
        return
    }

    if l->r < l->rmax {
        l->breath_frame++
        if l->breath_frame > l->breath_half_ticks {
            l->breath_frame = l->breath_half_ticks
        }

        eased := animated_span(l, span, l->breath_frame, l->breath_half_ticks)
        l->r = l->rmin + eased

        if l->breath_frame >= l->breath_half_ticks {
            l->breath_frame = 0
            l->sectick = 0
            l->r = l->rmax
        }
        return
    }

    if l->count[0] != '0' || l->count[1] != '0' || l->count[2] != '0' {
        l->sectick++
        if l->sectick < 60 {
            return
        }
        l->sectick = 0

        inccount(l->count)
        if eqcount(l->count, "015") {
            cpcount(l->count, "000")
            l->breath_frame = 0
            l->phase = InbePhaseNext
        }
        return
    }

    l->sectick++
    if l->sectick < 60 {
        return
    }
    l->sectick = 0

    inccount(l->count)
}

hold :: (l: Inbe*) #private {
    l->sectick++
    if l->sectick < 60 {
        return
    }

    l->sectick = 0
    inccount(l->count)
}

inbestep :: (l: Inbe*) {
    if l == nil {
        return
    }
    if l->completed {
        return
    }

    switch l->phase {
    case InbePhaseStarting:
        starting(l)
        break
    case InbePhaseBreathe:
        breathe(l)
        break
    case InbePhaseHold:
        hold(l)
        break
    case InbePhaseRecover:
        recover(l)
        break
    case InbePhaseNext:
        next(l)
        break
    }
}

inbe_end_hold :: (l: Inbe*) {
    if l == nil {
        return
    }

    cpcount(l->results[l->round], l->count)
    cpcount(l->count, "000")
    l->phase = InbePhaseRecover
    l->r = l->rmin
    l->breath_frame = 0
    l->breathtick = 0
    l->sectick = 0
}

inbe_just_completed :: (l: const Inbe*) -> int {
    if l == nil {
        return 0
    }
    return l->completed
}

inbe_clear_completed :: (l: Inbe*) {
    if l == nil {
        return
    }
    l->completed = 0
}
