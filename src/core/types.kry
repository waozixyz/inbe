#enum {
    Rshift = 3
    Runit = 1 << Rshift
}

#enum {
    CountSize = 4
    MaxRounds = 12
    DefaultSpeedLevel = 6
    DefaultMaxRounds = 4
    DefaultMaxBreaths = 30
    DefaultPauseSeconds = 2
    DefaultProgressiveStartSpeed = 3
}

#enum {
    ScreenStart = 0
    ScreenSession
    ScreenPracticeSession = ScreenSession
    ScreenMeditation
    ScreenSunSalutation
    ScreenPatterns
    ScreenResults
    ScreenSettings
    ScreenPracticeConfig
    ScreenLanguage
    ScreenManual
    ScreenProfile
    ScreenHabits
    ScreenCustomizeNav
    ScreenNavSidebar
    ScreenHabitEdit
    ScreenHabitSessionEdit
    ScreenEList
    ScreenBreak
}

#enum {
    BreathPhaseStarting = 0
    BreathPhaseBreathe
    BreathPhaseHold
    BreathPhaseRecover
    BreathPhaseNext
}

BreathAnimation :: enum {
    BreathAnimationLinear = 0
    BreathAnimationInOut = 1
    BreathAnimationCount
}

BreathSession :: struct {
    screen: int
    phase: int
    round: int

    r: int
    rmin: int
    rmax: int
    dir: int
    speed_level: int
    breath_frame: int
    breath_half_ticks: int
    frame: int

    breathtick: int
    sectick: int
    halftick: int
    max_rounds: int
    pause_seconds: int
    play_in_background: int
    progressive_speed: int
    progressive_start_speed: int
    breath_animation: int

    count: [CountSize] char
    maxbreaths: [CountSize] char

    results: [MaxRounds][CountSize] char
    completed: int
}
