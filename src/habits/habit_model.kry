#import "app.h"
#import "screens/habits_screen.h"
#import "screens/habits/habits.h"
#import "data.h"
#import "storage.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "time.h"

copy_text :: (dst: char*, dst_size: size_t, src: const char*) #private {
    if dst == nil || dst_size == 0 {
        return
    }
    if src == nil {
        src = ""
    }
    snprintf(dst, dst_size, "%s", src)
}

habit_find_day :: (habit: const InbeHabit*, day_index: int) -> int #private {
    if habit == nil || habit->days == nil {
        return -1
    }
    for int i = 0; i < habit->day_count; i++ {
        if habit->days[i].day_index == day_index {
            return i
        }
    }
    return -1
}

habit_counting_enabled :: (habit: const InbeHabit*) -> int {
    return habit != nil && habit->counter_enabled
}

habit_reserve_days :: (habit: InbeHabit*, capacity: int) -> int {
    days: InbeHabitDay*
    new_capacity: int

    if habit == nil || capacity <= habit->day_capacity {
        return habit != nil
    }
    new_capacity = habit->day_capacity > 0 ? habit->day_capacity : 16
    while new_capacity < capacity {
        if new_capacity > 1073741823 / 2 {
            return 0
        }
        new_capacity *= 2
    }
    days = realloc(habit->days, (size_t)new_capacity * sizeof(*days))
    if days == nil {
        return 0
    }
    memset(days + habit->day_capacity, 0,
              (size_t)(new_capacity - habit->day_capacity) * sizeof(*days))
    habit->days = days
    habit->day_capacity = new_capacity
    return 1
}

habits_free :: (habits: InbeHabits*) {
    if habits == nil {
        return
    }
    for int i = 0; i < INBE_HABIT_MAX; i++ {
        free(habits->items[i].days)
        habits->items[i].days = nil
        habits->items[i].day_count = 0
        habits->items[i].day_capacity = 0
    }
}

habits_today_index :: () -> int {
    now: time_t = time(nil)
    tm: struct tm* = localtime(&now)
    if tm == nil {
        return 0
    }
    return (tm->tm_year + 1900) * 10000 +
           (tm->tm_mon + 1) * 100 +
           tm->tm_mday
}

# Weekday cadence: bit0=Mon .. bit6=Sun; 0 = every day.
habit_weekday_bit :: (day_index: int) -> int {
    tm_value := (struct tm){0}

    tm_value.tm_year = day_index / 10000 - 1900
    tm_value.tm_mon = (day_index / 100) % 100 - 1
    tm_value.tm_mday = day_index % 100
    tm_value.tm_hour = 12
    mktime(&tm_value)
    return (tm_value.tm_wday + 6) % 7
}

habit_scheduled_day :: (habit: const InbeHabit*, day_index: int) -> int {
    if habit == nil || habit->weekdays == 0 {
        return 1
    }
    return (habit->weekdays & (1 << habit_weekday_bit(day_index))) != 0
}

habit_completed_day :: (habit: const InbeHabit*, day_index: int) -> int {
    index := habit_find_day(habit, day_index)
    return index >= 0 &&
           (habit->days[index].completed || habit->days[index].count > 0)
}

habit_day_count :: (habit: const InbeHabit*, day_index: int) -> int {
    index := habit_find_day(habit, day_index)
    if index < 0 {
        return 0
    }
    if habit->days[index].count > 0 {
        return habit->days[index].count
    }
    return habit->days[index].completed ? 1 : 0
}

habit_completed_today :: (habit: const InbeHabit*) -> int {
    return habit_completed_day(habit, habits_today_index())
}

habits_save :: (habits: InbeHabits*) {
    if habits != nil {
        habits->dirty = 0
        habits->pending_day_save_count = 0
    }
    storage_habits_save(habits)
    if habits != nil {
        habits->loaded_count = habits->count
        for int i = 0; i < habits->loaded_count; i++ {
            copy_text(habits->loaded_ids[i], sizeof(habits->loaded_ids[i]),
                         habits->items[i].id)
        }
        for int i = habits->loaded_count; i < INBE_HABIT_MAX; i++ {
            habits->loaded_ids[i][0] = '\0'
        }
    }
}

habits_queue_day_save :: (habits: InbeHabits*, habit: const InbeHabit*,
                              day_index: int, completed: int,
                              count: int) #private {
    pending: InbeHabitDaySave*

    if habits == nil || habit == nil || habit->id[0] == '\0' ||
       day_index <= 0 {
        return
    }
    if count < 0 {
        count = 0
    }
    completed = completed || count > 0
    for int i = 0; i < habits->pending_day_save_count; i++ {
        pending = &habits->pending_day_saves[i]
        if pending->day_index == day_index &&
           strcmp(pending->habit_id, habit->id) == 0 {
            pending->completed = completed ? 1 : 0
            pending->count = count
            return
        }
    }
    if habits->pending_day_save_count >= INBE_HABIT_PENDING_DAY_SAVE_MAX {
        habits->dirty = 1
        return
    }
    pending = &habits->pending_day_saves[habits->pending_day_save_count]
    copy_text(pending->habit_id, sizeof(pending->habit_id), habit->id)
    pending->day_index = day_index
    pending->completed = completed ? 1 : 0
    pending->count = count
    habits->pending_day_save_count++
}

habits_flush_day_saves :: (habits: InbeHabits*) #private {
    pending: [INBE_HABIT_PENDING_DAY_SAVE_MAX] InbeHabitDaySave
    count: int

    if habits == nil || habits->pending_day_save_count <= 0 {
        return
    }
    count = habits->pending_day_save_count
    if count > INBE_HABIT_PENDING_DAY_SAVE_MAX {
        count = INBE_HABIT_PENDING_DAY_SAVE_MAX
    }
    memcpy(pending, habits->pending_day_saves,
              (size_t)count * sizeof(pending[0]))
    habits->pending_day_save_count = 0
    for int i = 0; i < count; i++ {
        if !storage_habit_day_save(pending[i].habit_id,
                                      pending[i].day_index,
                                      pending[i].completed,
                                      pending[i].count) {
            habits->dirty = 1
        }
    }
}

habits_flush_save :: (app: InbeApp*) {
    if app == nil {
        return
    }
    if app->habits.dirty {
        habits_save(&app->habits)
    } else {
        habits_flush_day_saves(&app->habits)
    }
}

habits_clear_days :: (habits: InbeHabits*) -> int {
    cleared := 0

    if habits == nil {
        return 0
    }
    for int i = 0; i < habits->count; i++ {
        habit: InbeHabit* = &habits->items[i]
        for int d = 0; d < habit->day_count; d++ {
            if habit->days[d].day_index > 0 ||
               habit->days[d].completed ||
               habit->days[d].count > 0 {
                cleared++
            }
        }
        habit->day_count = 0
    }
    return cleared
}

habits_add_default :: (habits: InbeHabits*) {
    name: [INBE_HABIT_NAME_SIZE] char

    if habits == nil || habits->count >= INBE_HABIT_MAX {
        return
    }

    number := habits->count + 1
    snprintf(name, sizeof(name), GetLocaleText("habit_default_name_format"), number)
    habits_add_custom(habits, name, (Color){99, 196, 165, 255},
                         INBE_HABIT_SYNC_NONE, 0)
}

habits_add_seed :: (habits: InbeHabits*, id: const char*, name: const char*,
                   description: const char*, color: Color, activity_mask: int) #private {
    habit: InbeHabit*

    if habits == nil || habits->count >= INBE_HABIT_MAX {
        return
    }

    habit = &habits->items[habits->count++]
    memset(habit, 0, sizeof(*habit))
    copy_text(habit->id, sizeof(habit->id), id)
    copy_text(habit->name, sizeof(habit->name), name)
    copy_text(habit->description, sizeof(habit->description), description)
    habit->color = color
    habit->sync_mode = INBE_HABIT_SYNC_ACTIVITIES
    habit->sync_activity = activity_mask
    habit->counter_enabled = 0
}

habits_add_default_set :: (habits: InbeHabits*) {
    if habits == nil {
        return
    }

    habits_free(habits)
    memset(habits, 0, sizeof(*habits))
    habits_add_seed(habits,
                       "meditation",
                       GetLocaleText("habit_default_meditation_name"),
                       GetLocaleText("habit_default_meditation_description"),
                       (Color){126, 183, 230, 255},
                       habit_activity_mask_for(EXERCISE_WIM_HOF) |
                       habit_activity_mask_for(EXERCISE_MEDITATION) |
                       habit_activity_mask_for(EXERCISE_PATTERNS))
    habits_add_seed(habits,
                       "yoga",
                       GetLocaleText("habit_default_yoga_name"),
                       GetLocaleText("habit_default_yoga_description"),
                       (Color){239, 178, 102, 255},
                       habit_activity_mask_for(EXERCISE_SUN_SALUTATION))
    habits->selected = 0
    habits->loaded = 1
    habits_save(habits)
}

habits_seed_default_set_if_needed :: (habits: InbeHabits*) -> int {
    if habits == nil || habits->count > 0 {
        return 0
    }
    habits_add_default_set(habits)
    return habits->count > 0
}

habits_delete :: (habits: InbeHabits*, index: int) {
    if habits == nil || index < 0 || index >= habits->count {
        return
    }

    free(habits->items[index].days)
    for int i = index; i < habits->count - 1; i++ {
        habits->items[i] = habits->items[i + 1]
    }
    habits->count--
    memset(&habits->items[habits->count], 0, sizeof(habits->items[habits->count]))

    if habits->selected > index {
        habits->selected--
    } else if habits->selected >= habits->count {
        habits->selected = habits->count - 1
    }
    if habits->selected < 0 && habits->count > 0 {
        habits->selected = 0
    }

    habits_save(habits)
}

habits_move :: (habits: InbeHabits*, from_index: int, to_index: int) -> int {
    moved: InbeHabit

    if habits == nil || from_index < 0 || to_index < 0 ||
       from_index >= habits->count || to_index >= habits->count ||
       from_index == to_index {
        return 0
    }

    moved = habits->items[from_index]
    if from_index < to_index {
        for int i = from_index; i < to_index; i++ {
            habits->items[i] = habits->items[i + 1]
        }
    } else {
        for int i = from_index; i > to_index; i-- {
            habits->items[i] = habits->items[i - 1]
        }
    }
    habits->items[to_index] = moved

    if habits->selected == from_index {
        habits->selected = to_index
    } else if from_index < to_index &&
              habits->selected > from_index &&
              habits->selected <= to_index {
        habits->selected--
    } else if from_index > to_index &&
              habits->selected >= to_index &&
              habits->selected < from_index {
        habits->selected++
    }

    habits_save(habits)
    return 1
}

habits_name_exists :: (habits: const InbeHabits*, name: const char*, exclude_index: int) -> int {
    if habits == nil || name == nil {
        return 0
    }

    for int i = 0; i < habits->count; i++ {
        if i == exclude_index {
            continue
        }
        if strcmp(habits->items[i].name, name) == 0 {
            return 1
        }
    }
    return 0
}

habits_generate_unique_name :: (habits: InbeHabits*, name_buffer: char*,
                                   buffer_size: size_t, base_name: const char*) {
    if habits == nil || name_buffer == nil || base_name == nil {
        return
    }

    snprintf(name_buffer, buffer_size, "%s", base_name)
    if !habits_name_exists(habits, name_buffer, -1) {
        return
    }

    for int i = 2; i < 100; i++ {
        snprintf(name_buffer, buffer_size, "%s %d", base_name, i)
        if !habits_name_exists(habits, name_buffer, -1) {
            return
        }
    }

    snprintf(name_buffer, buffer_size, "%s %ld", base_name, (long)time(nil))
}

habits_add_custom :: (habits: InbeHabits*, name: const char*, color: Color,
                         sync_mode: int, sync_activity: int) -> int {
    habit: InbeHabit*
    unique_name: [INBE_HABIT_NAME_SIZE] char
    final_name := name != nil && name[0] != '\0' ? name : "Habit"

    if habits == nil || habits->count >= INBE_HABIT_MAX {
        return -1
    }

    if habits_name_exists(habits, final_name, -1) {
        habits_generate_unique_name(habits, unique_name, sizeof(unique_name), final_name)
        final_name = unique_name
    }

    habit = &habits->items[habits->count]
    memset(habit, 0, sizeof(*habit))
    storage_make_uuid(habit->id)
    copy_text(habit->name, sizeof(habit->name), final_name)
    habit->color = color
    habit->color.a = 255
    habit->sync_mode = sync_mode
    habit->sync_activity = sync_activity
    habit->counter_enabled = 0
    habits->selected = habits->count
    habits->count++
    habits_save(habits)
    return habits->selected
}

habits_init_with_defaults :: (habits: InbeHabits*, seed_defaults: int) {
    if habits == nil {
        return
    }
    if habits->hold_stats_range_days != 31 {
        habits->hold_stats_range_days = 7
    }
    data_init()
    if storage_habits_load(habits) {
        if habits->hold_stats_range_days != 31 {
            habits->hold_stats_range_days = 7
        }
        if habits->count <= 0 {
            if seed_defaults {
                habits_seed_default_set_if_needed(habits)
            }
            habits->loaded = 1
            return
        }
        if habits->count == 3 &&
           strcmp(habits->items[0].id, "mind") == 0 &&
           strcmp(habits->items[1].id, "yoga") == 0 &&
           strcmp(habits->items[2].id, "fitness") == 0 {
            if seed_defaults {
                habits_add_default_set(habits)
            }
            return
        }
        if habits->selected < 0 || habits->selected >= habits->count {
            habits->selected = 0
        }
        habits->loaded = 1
        return
    }
    if seed_defaults {
        habits_add_default_set(habits)
    } else {
        habits_free(habits)
        memset(habits, 0, sizeof(*habits))
        habits->loaded = 1
    }
    if habits->hold_stats_range_days != 31 {
        habits->hold_stats_range_days = 7
    }
}

habits_init :: (habits: InbeHabits*) {
    habits_init_with_defaults(habits, 1)
}

habit_set_day :: (habits: InbeHabits*, index: int, day_index: int, completed: int) {
    habit: InbeHabit*
    existing_index: int
    count: int

    if habits == nil || index < 0 || index >= habits->count || day_index <= 0 {
        return
    }

    habit = &habits->items[index]
    count = completed ? 1 : 0
    existing_index = habit_find_day(habit, day_index)
    if existing_index >= 0 {
        habit->days[existing_index].completed = completed != 0
        habit->days[existing_index].count = count
    } else if completed && habit_reserve_days(habit, habit->day_count + 1) {
        habit->days[habit->day_count].day_index = day_index
        habit->days[habit->day_count].completed = 1
        habit->days[habit->day_count].count = count
        habit->day_count++
    }
    habits->selected = index
    habits_queue_day_save(habits, habit, day_index, completed != 0, count)
}

habit_set_day_count :: (habits: InbeHabits*, index: int, day_index: int, count: int) {
    habit: InbeHabit*
    existing_index: int

    if habits == nil || index < 0 || index >= habits->count || day_index <= 0 {
        return
    }
    if count < 0 {
        count = 0
    }

    habit = &habits->items[index]
    existing_index = habit_find_day(habit, day_index)
    if existing_index >= 0 {
        habit->days[existing_index].count = count
        habit->days[existing_index].completed = count > 0
    } else if count > 0 && habit_reserve_days(habit, habit->day_count + 1) {
        habit->days[habit->day_count].day_index = day_index
        habit->days[habit->day_count].count = count
        habit->days[habit->day_count].completed = 1
        habit->day_count++
    }
    habits->selected = index
    habits_queue_day_save(habits, habit, day_index, count > 0, count)
}

habit_toggle_day :: (habits: InbeHabits*, index: int, day_index: int) {
    habit: InbeHabit*
    existing_index: int

    if habits == nil || index < 0 || index >= habits->count || day_index <= 0 {
        return
    }

    habit = &habits->items[index]
    existing_index = habit_find_day(habit, day_index)
    if existing_index >= 0 {
        completed := !(habit->days[existing_index].completed ||
                       habit->days[existing_index].count > 0)
        habit->days[existing_index].completed = completed
        habit->days[existing_index].count = completed ? 1 : 0
    } else if habit_reserve_days(habit, habit->day_count + 1) {
        habit->days[habit->day_count].day_index = day_index
        habit->days[habit->day_count].completed = 1
        habit->days[habit->day_count].count = 1
        habit->day_count++
    }
    habits->selected = index
    habits_queue_day_save(habits, habit, day_index,
                             habit_completed_day(habit, day_index),
                             habit_day_count(habit, day_index))
}

habit_increment_day :: (habits: InbeHabits*, index: int, day_index: int, delta: int) {
    if habits == nil || index < 0 || index >= habits->count || day_index <= 0 {
        return
    }
    count := habit_day_count(&habits->items[index], day_index) + delta
    habit_set_day_count(habits, index, day_index, count)
}

habit_toggle_today :: (habits: InbeHabits*, index: int) {
    habit_toggle_day(habits, index, habits_today_index())
}

habit_activity_mask_for :: (exercise: int) -> int {
    if exercise < 0 || exercise >= EXERCISE_COUNT {
        return 0
    }
    return 1 << exercise
}

habit_matches_activity :: (habit: const InbeHabit*, exercise_type: int) -> int {
    if habit == nil {
        return 0
    }
    if habit->sync_mode == INBE_HABIT_SYNC_ACTIVITIES {
        return (habit->sync_activity & habit_activity_mask_for(exercise_type)) != 0
    }
    return 0
}

sync_habits_for_activity :: (app: InbeApp*, exercise_type: int) {
    changed := 0

    if app == nil {
        return
    }

    today := habits_today_index()
    selected := app->habits.selected
    for int i = 0; i < app->habits.count; i++ {
        habit: InbeHabit* = &app->habits.items[i]
        if habit_matches_activity(habit, exercise_type) {
            if !habit_completed_day(habit, today) {
                habit_set_day(&app->habits, i, today, 1)
                changed = 1
            }
        }
    }
    if changed {
        app->habits.selected = selected
        habits_save(&app->habits)
    }
}

habit_is_linked :: (habit: const InbeHabit*) -> int {
    return habit != nil && habit->sync_mode != INBE_HABIT_SYNC_NONE
}

habit_format_date :: (day_index: int, out: char*, out_size: size_t) {
    if out == nil || out_size == 0 {
        return
    }
    snprintf(out, out_size, "%04d-%02d-%02d",
                day_index / 10000, (day_index / 100) % 100, day_index % 100)
}

habit_format_duration :: (seconds: int, out: char*, out_size: size_t) {
    if out == nil || out_size == 0 {
        return
    }
    if seconds < 0 {
        seconds = 0
    }

    hours := seconds / 3600
    minutes := (seconds % 3600) / 60
    seconds = seconds % 60

    if hours > 0 {
        snprintf(out, out_size, "%dh %02dm", hours, minutes)
    } else {
        snprintf(out, out_size, "%dm %02ds", minutes, seconds)
    }
}

habit_tm_date_index :: (tm: const struct tm*) -> int {
    if tm == nil {
        return 0
    }
    return (tm->tm_year + 1900) * 10000 +
           (tm->tm_mon + 1) * 100 +
           tm->tm_mday
}
