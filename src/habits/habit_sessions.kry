#import "app.h"
#import "screens/habits_screen.h"
#import "screens/habits/habits.h"
#import "data.h"
#import "storage.h"
#import "stdio.h"
#import "string.h"

habit_linked_session_callback :: (path: const char*, year: int, month: int,
                                 day: int, hour: int, minute: int, second: int,
                                 topic: int, activity: int,
                                 round_times: const int*, round_count: int,
                                 user: void*) #private {
    ctx: HabitLinkedContext* = user
    entry: HabitLinkedEntry*
    day_index := year * 10000 + month * 100 + day

    unused topic
    if ctx == nil || round_times == nil || round_count <= 0 {
        return
    }
    if ctx->day_filter > 0 && ctx->day_filter != day_index {
        return
    }
    if activity < 0 || activity >= EXERCISE_COUNT {
        activity = EXERCISE_WIM_HOF
    }
    if ctx->sync_mode == INBE_HABIT_SYNC_ACTIVITIES &&
       (ctx->sync_activity & habit_activity_mask_for(activity)) == 0 {
        return
    }
    if ctx->count >= HABIT_LINKED_ENTRY_MAX {
        return
    }

    entry = &ctx->entries[ctx->count++]
    memset(entry, 0, sizeof(*entry))
    snprintf(entry->path, sizeof(entry->path), "%s", path != nil ? path : "")
    entry->year = year
    entry->month = month
    entry->day = day
    entry->hour = hour
    entry->minute = minute
    entry->second = second
    entry->activity = activity
    entry->round_count = round_count > MaxRounds ? MaxRounds : round_count
    for int i = 0; i < entry->round_count; i++ {
        entry->rounds[i] = round_times[i]
        entry->total_seconds += round_times[i]
        if round_times[i] > entry->best_seconds {
            entry->best_seconds = round_times[i]
        }
    }
    ctx->total_seconds += entry->total_seconds
    if entry->best_seconds > ctx->best_seconds {
        ctx->best_seconds = entry->best_seconds
    }
}

habit_collect_linked_entries :: (habit: const InbeHabit*, day_filter: int,
                                    ctx: HabitLinkedContext*) {
    if ctx == nil {
        return
    }
    memset(ctx, 0, sizeof(*ctx))
    ctx->day_filter = day_filter
    ctx->sync_mode = habit != nil ? habit->sync_mode : INBE_HABIT_SYNC_NONE
    ctx->sync_activity = habit != nil ? habit->sync_activity : EXERCISE_WIM_HOF
    data_list_session_records(habit_linked_session_callback, ctx)
}

habit_session_cancel_edit :: (app: InbeApp*) {
    if app == nil {
        return
    }
    app->habit_session_edit = (HabitSessionEditState){.round = -1}
    SetUIFocusTextInputActive(0)
}

habit_linked_has_day :: (ctx: const HabitLinkedContext*, day_index: int) -> int {
    if ctx == nil {
        return 0
    }
    for int i = 0; i < ctx->count; i++ {
        if ctx->entries[i].year * 10000 +
           ctx->entries[i].month * 100 +
           ctx->entries[i].day == day_index {
            return 1
        }
    }
    return 0
}

habit_linked_session_count_for_day :: (ctx: const HabitLinkedContext*, day_index: int) -> int {
    count := 0

    if ctx == nil {
        return 0
    }
    for int i = 0; i < ctx->count; i++ {
        entry_day := ctx->entries[i].year * 10000 +
                     ctx->entries[i].month * 100 +
                     ctx->entries[i].day
        if entry_day == day_index {
            count++
        }
    }
    return count
}

habit_effective_day_count :: (habit: const InbeHabit*, day_index: int,
                                 linked_ctx: const HabitLinkedContext*) -> int {
    manual_count := habit_day_count(habit, day_index)
    session_count := habit_linked_session_count_for_day(linked_ctx, day_index)
    return manual_count > session_count ? manual_count : session_count
}

habit_session_changed :: (app: InbeApp*, old_session_count: int) {
    ctx: HabitLinkedContext
    habit: InbeHabit*

    if app == nil || app->habit_detail_index < 0 ||
       app->habit_detail_index >= app->habits.count ||
       app->habit_detail_day <= 0 {
        return
    }

    habit = &app->habits.items[app->habit_detail_index]
    if old_session_count < 0 {
        app_auto_sync(app)
        return
    }

    manual_count := habit_day_count(habit, app->habit_detail_day)
    extra_count := manual_count - old_session_count
    if extra_count < 0 {
        extra_count = 0
    }

    habit_collect_linked_entries(habit, app->habit_detail_day, &ctx)
    new_count := ctx.count + extra_count
    if new_count != manual_count {
        habit_set_day_count(&app->habits,
                               app->habit_detail_index,
                               app->habit_detail_day,
                               new_count)
    }
    app_auto_sync(app)
}

habit_apply_count_action :: (app: InbeApp*, index: int, day_index: int,
                                delta: int, minimum_count: int) {
    if app == nil {
        return
    }
    habits: InbeHabits* = &app->habits
    if habits == nil || index < 0 || index >= habits->count || day_index <= 0 {
        return
    }
    count := habit_day_count(&habits->items[index], day_index) + delta
    if count < minimum_count {
        count = minimum_count
    }
    habit_set_day_count(habits, index, day_index, count)
}

habit_open_linked_edit_page :: (app: InbeApp*, habit_index: int, day_index: int) {
    if app == nil {
        return
    }
    app->habit_detail_index = habit_index
    app->habit_detail_day = day_index
    app->habit_detail_session_path[0] = '\0'
    app->habit_session_edit = (HabitSessionEditState){.round = -1}
    app_close_modal(app)
    app_switch_screen(app, InbeScreenHabitSessionEdit)
}
