#import "kryon.h"
#import "core/types"

#enum {
    HABIT_SESSION_EDIT_NONE = 0
    HABIT_SESSION_EDIT_ROUND = 1
}

#enum {
    HABIT_MAX = 32
    HABIT_ID_SIZE = 40
    HABIT_PENDING_DAY_SAVE_MAX = 128
    HABIT_NAME_SIZE = 40
    HABIT_DESCRIPTION_SIZE = 256
    HABIT_LINKED_ENTRY_MAX = 128
    HABIT_LINKED_PATH_SIZE = 80
}

#enum {
    HABIT_VIEW_CALENDAR = 0
    HABIT_VIEW_WEEKLY = 1
}

#enum {
    HABITS_SCREEN_OVERVIEW = 0
    HABITS_SCREEN_HISTORY = 1
    HABITS_SCREEN_STATISTICS = 2
}

#enum {
    HABIT_TAB_WEEKLY = 0
    HABIT_TAB_MONTHLY
    HABIT_TAB_STATISTICS
    HABIT_TAB_EDIT
    HABIT_TAB_COUNT
}

HabitSyncMode :: enum {
    HABIT_SYNC_NONE = 0
    HABIT_SYNC_ACTIVITIES = 1
}

HABIT_SCHEDULE_OFF :: (1 << 7)

#enum {
    HABIT_WEEKLY_MONTH_DAYS = 31
    HABIT_WEEKLY_INITIAL_DAYS = HABIT_WEEKLY_MONTH_DAYS
    HABIT_WEEKLY_LOAD_DAYS = HABIT_WEEKLY_MONTH_DAYS
    HABIT_WEEKLY_MAX_DAYS = 36500
    HABIT_COUNTER_LONG_PRESS_FRAMES = 30
}

HabitDay :: struct {
    day_index: int
    completed: int
    count: int
    session_count: int
}

Habit :: struct {
    id: [HABIT_ID_SIZE]char
    name: [HABIT_NAME_SIZE]char
    description: [HABIT_DESCRIPTION_SIZE]char
    color: Color
    sync_mode: int
    sync_activity: int
    counter_enabled: int
    counter_target: int
    weekdays: int
    reminder_hour: int
    days: HabitDay*
    day_count: int
    day_capacity: int
}

HabitDaySave :: struct {
    habit_id: [HABIT_ID_SIZE]char
    day_index: int
    completed: int
    count: int
}

HabitLinkedEntry :: struct {
    path: [HABIT_LINKED_PATH_SIZE]char
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    activity: int
    rounds: [MaxRounds]int
    round_count: int
    total_seconds: int
    best_seconds: int
}

HabitLinkedContext :: struct {
    entries: [HABIT_LINKED_ENTRY_MAX]HabitLinkedEntry
    count: int
    day_filter: int
    sync_mode: int
    sync_activity: int
    total_seconds: int
    best_seconds: int
}

Habits :: struct {
    items: [HABIT_MAX]Habit
    loaded_ids: [HABIT_MAX][HABIT_ID_SIZE]char
    pending_day_saves: [HABIT_PENDING_DAY_SAVE_MAX]HabitDaySave
    linked_cache: HabitLinkedContext*
    linked_cache_habit_id: [HABIT_ID_SIZE]char
    linked_cache_session_clock: long long
    linked_cache_index: int
    linked_cache_day_filter: int
    linked_cache_sync_mode: int
    linked_cache_sync_activity: int
    linked_cache_valid: int
    count: int
    loaded_count: int
    pending_day_save_count: int
    selected: int
    scroll: int
    tab_scroll: int
    focus_selected_tab: int
    month_offset: int
    selector_open: int
    screen_mode: int
    view_mode: int
    tab: int
    weekly_days: int
    hold_stats_range_days: int
    loaded: int
    dirty: int
}
