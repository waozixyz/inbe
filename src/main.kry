#import "kryon.h"
#import "app.h"
#import "app/app_update_check.h"
#import "breaks/app_breaks.h"
#import "breaks/break_engine.h"
#import "platform/app_desktop_tray.h"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
TRAY :: #defined(DESKTOP_TRAY_ENABLED)

native_prepare :: (argc: int, argv: char**) #extern
native_window_size :: (window_w: int*, window_h: int*) #extern
native_configure_window :: () #extern
native_before_window :: () #extern
native_after_window :: () -> int #extern
native_after_app_init :: (app: InnerBreeze*, argc: int, argv: char**) #extern
native_screenshot_active :: () -> int #extern
native_run_screenshot :: (app: InnerBreeze*) -> int #extern
native_should_start_hidden :: (app: InnerBreeze*) -> int #extern
native_platform_shutdown :: () #extern
native_update_apply_at_exit :: () -> int #extern
app_frame :: (app: InnerBreeze*) #extern

#if WEB {
    native_start_web_loop :: (app: InnerBreeze*) #extern
} #else {
    native_install_shutdown_handlers :: () #extern
    native_shutdown_requested :: () -> int #extern
}

app :: InnerBreeze #global

app_shutdown :: () {
    # Desktop self-update may re-exec a staged AppImage after state is saved
    # and the window/audio stack is down.
    native_platform_shutdown()
    if native_update_apply_at_exit() {
        return
    }
}

cleanup_window :: () {
    #if TRAY {
        desktop_tray_shutdown()
    }
    app_destroy(&app)
    set_global_app(nil)
    CloseWindow()
    native_platform_shutdown()
}

run_screenshot_if_requested :: () -> int {
    result := native_run_screenshot(&app)
    if result == 0 {
        return 0
    }
    # Positive means screenshot saved; negative means capture/save failure.
    cleanup_window()
    if result > 0 {
        return 0
    }
    return 1
}

#if TRAY {
    run_tray_loop :: () {
        quit := 0

        # With a tray, the close button asks whether to keep running in the
        # background or quit. The native window pump exposes close requests
        # through StealUICoreWindowClose().
        while !quit {
            tray_action: DesktopTrayAction = desktop_tray_poll_action()
            close_result: AppClosePromptResult = AppClosePromptNone

            if native_shutdown_requested() {
                TraceLog(LOG_INFO, "APP: quit requested by shutdown signal")
                quit = 1
            }
            if tray_action != DESKTOP_TRAY_ACTION_NONE {
                desktop_tray_apply_action(&app, tray_action, &quit)
            }
            if StealUICoreWindowClose() {
                desktop_tray_apply_action(&app,
                                               DESKTOP_TRAY_ACTION_CLOSE_REQUEST,
                                               &quit)
            }
            if !quit {
                app_frame(&app)
                desktop_tray_update_status(&app)
            }

            close_result = app_consume_close_prompt_result(&app)
            if close_result == AppClosePromptKeepRunning {
                desktop_tray_keep_running()
            } else if close_result == AppClosePromptQuit {
                TraceLog(LOG_INFO, "APP: quit requested by close prompt")
                quit = 1
            }

            if app.request_quit {
                TraceLog(LOG_INFO, "APP: quit requested by app layer")
                quit = 1
            }

            tray_action = desktop_tray_poll_action()
            if tray_action != DESKTOP_TRAY_ACTION_NONE {
                desktop_tray_apply_action(&app, tray_action, &quit)
            }
            if StealUICoreWindowClose() && !app.close_prompt_open {
                app_request_desktop_close(&app)
            }
        }
    }
} #else {
    run_plain_loop :: () {
        quit := 0

        # No tray: there is nothing to keep running in the background, so any
        # close request just exits.
        while !native_shutdown_requested() && !quit {
            app_frame(&app)
            if WindowShouldClose() || StealUICoreWindowClose() ||
               native_shutdown_requested() || app.request_quit {
                quit = 1
            }
        }
    }
}

main :: (argc: int, argv: char**) -> int {
    window_w: int = 0
    window_h: int = 0

    native_prepare(argc, argv)
    native_window_size(&window_w, &window_h)
    native_configure_window()
    native_before_window()

    InitWindow(window_w, window_h, config.title)
    if !native_after_window() {
        return 1
    }

    app_init(&app)
    native_after_app_init(&app, argc, argv)

    #if WEB {
        native_start_web_loop(&app)
        return 0
    } #else {
        native_install_shutdown_handlers()

        #if TRAY {
            desktop_tray_init()
            if native_should_start_hidden(&app) {
                TraceLog(LOG_INFO, "APP: starting hidden in the tray (startup mode)")
                desktop_tray_keep_running()
            }
            KryonMemReport("after-tray-init")
        }

        screenshot_exit := run_screenshot_if_requested()
        if screenshot_exit != 0 || native_screenshot_active() {
            return screenshot_exit
        }

        #if TRAY {
            run_tray_loop()
        } #else {
            run_plain_loop()
        }

        cleanup_window()
        app_shutdown()
        return 0
    }
}
