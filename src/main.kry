#import "kryon.h"
#import "app.h"
host :: #import "platform/app_host"
tray :: #import "platform/tray"

WEB_BUILD :: #defined(PLATFORM_WEB)
DESKTOP_TRAY_BUILD :: #defined(DESKTOP_TRAY_ENABLED)

app :: InnerBreeze #global

destroy_app_window :: () {
    #if DESKTOP_TRAY_BUILD {
        tray.desktop_tray_shutdown()
    }
    app_destroy(&app)
    set_global_app(nil)
    CloseWindow()
    host.Shutdown()
}

shutdown_application :: () {
    destroy_app_window()

    # A desktop update may replace the process only after state, audio, and
    # the platform window have shut down cleanly.
    host.ApplyPendingUpdate()
}

run_screenshot_if_requested :: () -> int {
    result := host.CaptureScreenshot(&app)
    if result == 0 {
        return 0
    }

    shutdown_application()
    if result > 0 {
        return 0
    }
    return 1
}

#if DESKTOP_TRAY_BUILD {
    run_desktop_tray_loop :: () {
        quit := 0

        while !quit {
            tray_action: tray.DesktopTrayAction = tray.desktop_tray_poll_action()
            close_result: AppClosePromptResult = AppClosePromptNone
            close_requested := StealCoreWindowClose()

            if host.ShutdownRequested() {
                TraceLog(LOG_INFO, "APP: quit requested by shutdown signal")
                quit = 1
            }
            if (IsWindowHidden() || IsWindowMinimized()) &&
               !tray.desktop_tray_ready() {
                TraceLog(LOG_INFO, "APP: tray indicator unavailable; stopping background execution")
                quit = 1
            }
            if !quit && tray_action != tray.DESKTOP_TRAY_ACTION_NONE {
                tray.desktop_tray_apply_action(&app, tray_action, &quit)
            }
            if close_requested != 0 && !app.close_prompt_open {
                tray.desktop_tray_apply_action(&app,
                                      tray.DESKTOP_TRAY_ACTION_CLOSE_REQUEST,
                                      &quit)
            }
            if !quit {
                host.DrawFrame(&app)
                tray.desktop_tray_update_status(&app)
            }

            close_result = app_consume_close_prompt_result(&app)
            if close_result == AppClosePromptKeepRunning {
                if !tray.desktop_tray_keep_running() {
                    quit = 1
                }
            } else if close_result == AppClosePromptQuit {
                TraceLog(LOG_INFO, "APP: quit requested by close prompt")
                quit = 1
            }

            if app.request_quit {
                TraceLog(LOG_INFO, "APP: quit requested by app layer")
                quit = 1
            }

            tray_action = tray.desktop_tray_poll_action()
            if tray_action != tray.DESKTOP_TRAY_ACTION_NONE {
                tray.desktop_tray_apply_action(&app, tray_action, &quit)
            }
            close_requested = StealCoreWindowClose()
            if close_requested != 0 && !app.close_prompt_open {
                tray.desktop_tray_apply_action(&app,
                                      tray.DESKTOP_TRAY_ACTION_CLOSE_REQUEST,
                                      &quit)
            }
        }
    }
}

#if !WEB_BUILD && !DESKTOP_TRAY_BUILD {
    run_desktop_window_loop :: () {
        quit := 0

        while !host.ShutdownRequested() && !quit {
            #if #defined(PLATFORM_DESKTOP) {
                if IsWindowHidden() || IsWindowMinimized() {
                    TraceLog(LOG_INFO, "APP: no tray indicator; stopping background execution")
                    break
                }
            }
            host.DrawFrame(&app)
            if WindowShouldClose() || StealCoreWindowClose() ||
               host.ShutdownRequested() || app.request_quit {
                quit = 1
            }
        }
    }
}

main :: (argc: int, argv: char**) -> int {
    window_size: host.WindowSize

    host.Prepare(argc, argv)
    window_size = host.InitialWindowSize()
    host.ConfigureWindow()

    InitWindow(window_size.width, window_size.height, config.title)
    if !host.FinishWindowSetup() {
        return 1
    }

    app_init(&app)
    host.FinishAppSetup(&app, argc, argv)

    #if WEB_BUILD {
        host.StartWebLoop(&app)
        return 0
    } #else {
        host.InstallShutdownHandlers()

        #if DESKTOP_TRAY_BUILD {
            tray.desktop_tray_init()
            if host.ShouldStartHidden(&app) {
                TraceLog(LOG_INFO, "APP: starting hidden in the tray (startup mode)")
                tray.desktop_tray_keep_running()
            }
            KryonMemReport("after-tray-init")
        }

        screenshot_exit := run_screenshot_if_requested()
        if screenshot_exit != 0 || host.ScreenshotRequested() {
            return screenshot_exit
        }

        #if DESKTOP_TRAY_BUILD {
            run_desktop_tray_loop()
        } #else {
            run_desktop_window_loop()
        }

        shutdown_application()
        return 0
    }
}
