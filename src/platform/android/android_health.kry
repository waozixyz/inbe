#module "platform.android.health"

ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "app.h"
    #import "platform/android/android_jni"
    #import "data.h"
    #import "storage.h"
    #import "stdio.h" #private
    #import "kryon.h" #private
    #import <android/log.h>

    static health_log_tag: const char* = "INBE_HEALTH"

    # Writes the session list (start,end,activity per line) and asks the
    # activity to run the Health Connect permission flow and insert the
    # records. Java owns the incremental marker, toasts and error states.
    export :: () -> int {
        path: [128] char

        snprintf(path, sizeof(path), "%s/health-connect-export.csv",
                 data_root())
        if !storage_export_health_connect_csv(path) {
            __android_log_write(ANDROID_LOG_WARN, health_log_tag,
                                "nothing to export")
            return 0
        }

        session := platform_android_jni_attach()
        if !platform_android_jni_valid(&session) {
            return 0
        }
        arg := platform_android_jni_new_string(&session, path)
        called := platform_android_jni_call_void_string(&session,
                                                        "healthConnectExport",
                                                        arg)
        platform_android_jni_delete_local(&session, arg)
        platform_android_jni_detach(&session)
        return called
    }
} #else {
    export :: () -> int {
        return 0
    }
}
