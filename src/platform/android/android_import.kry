ANDROID :: ANDROID_BUILD

#import "platform/android/android_import.h"
#import "platform.h" #private
#import "kryon.h" #private
#import <string.h>

#if ANDROID {
    #import <android/native_activity.h>
    #import <android_native_app_glue.h>
    #import <pthread.h>

    ANDROID_IMPORT_PATH_MAX :: #define 512

    GetAndroidApp :: () -> struct android_app* #extern

    import_mutex :: pthread_mutex_t = PTHREAD_MUTEX_INITIALIZER #global
    pending_result :: int = ANDROID_IMPORT_RESULT_NONE #global
    pending_kind :: int = ANDROID_IMPORT_KIND_DATA #global
    pending_path :: [ANDROID_IMPORT_PATH_MAX] char #global

    android_import_set_result :: (kind: int, result: int, path: const char*) #private {
        pthread_mutex_lock(&import_mutex)
        pending_result = result
        pending_kind = kind
        if path != nil {
            strncpy(pending_path, path, sizeof(pending_path) - 1)
            pending_path[sizeof(pending_path) - 1] = '\0'
        } else {
            pending_path[0] = '\0'
        }
        pthread_mutex_unlock(&import_mutex)
    }

    android_import_open_picker_for :: (kind: int, mime_types: const char*) -> int #export {
        app := GetAndroidApp()
        if app == nil || app->activity == nil {
            TraceLog(LOG_ERROR, "ANDROID_IMPORT: GetAndroidApp failed")
            return 0
        }

        activity := app->activity
        jvm := activity->vm
        env: JNIEnv* = nil

        if (*jvm)->AttachCurrentThread(jvm, &env, nil) != JNI_OK {
            TraceLog(LOG_ERROR, "ANDROID_IMPORT: failed to attach thread")
            return 0
        }

        activity_class := (*env)->GetObjectClass(env, activity->clazz)
        if activity_class == nil {
            TraceLog(LOG_ERROR, "ANDROID_IMPORT: MainActivity class not found")
            (*jvm)->DetachCurrentThread(jvm)
            return 0
        }

        method := (*env)->GetMethodID(env, activity_class, "openImportPicker",
                                      "(Ljava/lang/String;I)V")
        if method == nil {
            TraceLog(LOG_ERROR, "ANDROID_IMPORT: openImportPicker method not found")
            (*jvm)->DetachCurrentThread(jvm)
            return 0
        }

        mime_string := (*env)->NewStringUTF(env, mime_types != nil ? mime_types : "")
        if mime_string == nil {
            TraceLog(LOG_ERROR, "ANDROID_IMPORT: failed to allocate MIME string")
            (*jvm)->DetachCurrentThread(jvm)
            return 0
        }

        (*env)->CallVoidMethod(env, activity->clazz, method, mime_string, kind)
        (*env)->DeleteLocalRef(env, mime_string)
        if (*env)->ExceptionCheck(env) {
            (*env)->ExceptionDescribe(env)
            (*env)->ExceptionClear(env)
            (*jvm)->DetachCurrentThread(jvm)
            return 0
        }

        (*jvm)->DetachCurrentThread(jvm)
        TraceLog(LOG_INFO, "ANDROID_IMPORT: file picker opened")
        return 1
    }

    android_import_open_picker :: (mime_types: const char*) -> int #export {
        return android_import_open_picker_for(ANDROID_IMPORT_KIND_DATA, mime_types)
    }

    android_import_native_selected :: (env: JNIEnv*, thiz: jobject,
                                      kind: jint, path: jstring) #export {
        unused thiz
        if path == nil {
            android_import_set_result(kind, ANDROID_IMPORT_RESULT_SELECTED, "")
            return
        }

        import_path := (*env)->GetStringUTFChars(env, path, nil)
        if import_path == nil || import_path[0] == '\0' {
            if import_path != nil {
                (*env)->ReleaseStringUTFChars(env, path, import_path)
            }
            android_import_set_result(kind, ANDROID_IMPORT_RESULT_SELECTED, "")
            return
        }

        android_import_set_result(kind, ANDROID_IMPORT_RESULT_SELECTED, import_path)
        (*env)->ReleaseStringUTFChars(env, path, import_path)
    }

    android_import_native_cancelled :: (env: JNIEnv*, thiz: jobject, kind: jint) #export {
        unused env
        unused thiz
        android_import_set_result(kind, ANDROID_IMPORT_RESULT_CANCELLED, nil)
    }

    android_import_poll_result_for :: (kind: int, path: char*, path_size: size_t) -> int #export {
        result: int

        pthread_mutex_lock(&import_mutex)
        if pending_result != ANDROID_IMPORT_RESULT_NONE && pending_kind == kind {
            result = pending_result
        } else {
            result = ANDROID_IMPORT_RESULT_NONE
        }
        if result != ANDROID_IMPORT_RESULT_NONE && path != nil && path_size > 0 {
            strncpy(path, pending_path, path_size - 1)
            path[path_size - 1] = '\0'
        }
        if result != ANDROID_IMPORT_RESULT_NONE {
            pending_result = ANDROID_IMPORT_RESULT_NONE
            pending_path[0] = '\0'
        }
        pthread_mutex_unlock(&import_mutex)

        return result
    }

    android_import_poll_result :: (path: char*, path_size: size_t) -> int #export {
        return android_import_poll_result_for(ANDROID_IMPORT_KIND_DATA, path, path_size)
    }
} #else {
    android_import_open_picker :: (mime_types: const char*) -> int #export {
        unused mime_types
        return 0
    }

    android_import_open_picker_for :: (kind: int, mime_types: const char*) -> int #export {
        unused kind
        unused mime_types
        return 0
    }

    android_import_poll_result :: (path: char*, path_size: size_t) -> int #export {
        if path != nil && path_size > 0 {
            path[0] = '\0'
        }
        return ANDROID_IMPORT_RESULT_NONE
    }

    android_import_poll_result_for :: (kind: int, path: char*, path_size: size_t) -> int #export {
        unused kind
        if path != nil && path_size > 0 {
            path[0] = '\0'
        }
        return ANDROID_IMPORT_RESULT_NONE
    }
}
