#module "platform.android.jni"

ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "kryon.h" #private
    #import <android/log.h>
    #import <android_native_app_glue.h>
    #import <jni.h>

    GetAndroidApp :: () -> struct android_app* #extern

    AndroidJni :: struct {
        env: JNIEnv*
        jvm: JavaVM*
        activity: jobject
        attached: int
    }

    attach :: () -> AndroidJni  {
        session: AndroidJni = {0}
        app := GetAndroidApp()

        if app == nil {
            return session
        }
        if app->activity == nil || app->activity->vm == nil || app->activity->clazz == nil {
            return session
        }
        session.jvm = app->activity->vm
        session.activity = app->activity->clazz

        if (*session.jvm)->GetEnv(session.jvm, &session.env, JNI_VERSION_1_6) != JNI_OK {
            if (*session.jvm)->AttachCurrentThread(session.jvm, &session.env, nil) != JNI_OK ||
               session.env == nil {
                session.jvm = nil
                session.env = nil
                session.activity = nil
                return session
            }
            session.attached = 1
        }
        return session
    }

    valid :: (session: const AndroidJni*) -> int  {
        return session != nil && session->env != nil && session->activity != nil
    }

    detach :: (session: const AndroidJni*)  {
        if session == nil {
            return
        }
        if session->env != nil && (*session->env)->ExceptionCheck(session->env) {
            (*session->env)->ExceptionDescribe(session->env)
            (*session->env)->ExceptionClear(session->env)
        }
        if session->attached != 0 && session->jvm != nil {
            (*session->jvm)->DetachCurrentThread(session->jvm)
        }
    }

    call_void :: (session: const AndroidJni*, method_name: const char*,
                  signature: const char*) -> int  {
        if !valid(session) {
            return 0
        }
        called := 0
        clazz := (*session->env)->GetObjectClass(session->env, session->activity)
        if clazz {
            method := (*session->env)->GetMethodID(session->env, clazz, method_name,
                                                  signature)
            if method {
                (*session->env)->CallVoidMethod(session->env, session->activity,
                                               method)
                called = 1
            } else {
                __android_log_write(ANDROID_LOG_ERROR, "INBE_JNI",
                                    "method not found")
            }
        }
        return called
    }

    call_void_string :: (session: const AndroidJni*, method_name: const char*,
                         arg: jstring) -> int  {
        if !valid(session) || arg == nil {
            return 0
        }
        called := 0
        clazz := (*session->env)->GetObjectClass(session->env, session->activity)
        if clazz {
            method := (*session->env)->GetMethodID(session->env, clazz, method_name,
                                                  "(Ljava/lang/String;)V")
            if method {
                (*session->env)->CallVoidMethod(session->env, session->activity,
                                               method, arg)
                called = 1
            } else {
                __android_log_write(ANDROID_LOG_ERROR, "INBE_JNI",
                                    "method not found")
            }
        }
        return called
    }

    call_bool :: (session: const AndroidJni*, method_name: const char*) -> int  {
        if !valid(session) {
            return 0
        }
        result := 0
        clazz := (*session->env)->GetObjectClass(session->env, session->activity)
        if clazz {
            method := (*session->env)->GetMethodID(session->env, clazz, method_name,
                                                  "()Z")
            if method {
                result = (*session->env)->CallBooleanMethod(session->env,
                                                            session->activity,
                                                            method) ? 1 : 0
            } else {
                __android_log_write(ANDROID_LOG_ERROR, "INBE_JNI",
                                    "method not found")
            }
        }
        return result
    }

    call_string_array :: (session: const AndroidJni*, method_name: const char*,
                          dst: char*, dst_stride: int, count: int) -> int  {
        array: jobjectArray
        copied := 0

        if !valid(session) || dst == nil || count <= 0 {
            return 0
        }
        array = nil
        clazz := (*session->env)->GetObjectClass(session->env, session->activity)
        if clazz {
            method := (*session->env)->GetMethodID(session->env, clazz, method_name,
                                                  "()[Ljava/lang/String;")
            if method {
                array = (jobjectArray)(*session->env)->CallObjectMethod(
                    session->env, session->activity, method)
            } else {
                __android_log_write(ANDROID_LOG_ERROR, "INBE_JNI",
                                    "string array method not found")
            }
        }
        if array == nil {
            return 0
        }
        for int i = 0; i < count; i++ {
            s := (jstring)(*session->env)->GetObjectArrayElement(session->env,
                                                                array, i)
            if s == nil {
                continue
            }
            text := (*session->env)->GetStringUTFChars(session->env, s, nil)
            if text != nil {
                row := dst + i * dst_stride
                for int c = 0; c < dst_stride - 1 && text[c] != 0; c++ {
                    row[c] = text[c]
                }
                row[dst_stride - 1] = 0
                (*session->env)->ReleaseStringUTFChars(session->env, s, text)
                copied += 1
            }
            (*session->env)->DeleteLocalRef(session->env, s)
        }
        (*session->env)->DeleteLocalRef(session->env, array)
        return copied
    }

    new_string :: (session: const AndroidJni*, text: const char*) -> jstring  {
        if !valid(session) || text == nil {
            return nil
        }
        return (*session->env)->NewStringUTF(session->env, text)
    }

    delete_local :: (session: const AndroidJni*, ref: jobject)  {
        if valid(session) && ref != nil {
            (*session->env)->DeleteLocalRef(session->env, ref)
        }
    }
}
