#module "platform.android.lifecycle"

#if ANDROID_BUILD {
    #import "app.h"
    #import "platform/android/android_timer.h"
    #import "practices/practice_registry.h"
    #import "practices/meditation/meditation_practice.h"

    static background_execution_active: int
    static auto_paused_for_lifecycle: int

    android_lifecycle_reset :: () #export {
        background_execution_active = 0
        auto_paused_for_lifecycle = 0
    }

    android_play_in_background :: () -> int #private {
        app := get_global_app()
        if app == nil {
            return 0
        }
        return get_play_in_background(&app->breathing)
    }

    android_set_background_active :: (active: int) #private {
        app := get_global_app()
        if active != 0 {
            if app != nil {
                app->backgrounded = 1
            }
            android_timer_activate()
        } else {
            android_timer_deactivate()
            if app != nil {
                app->backgrounded = 0
            }
        }
    }

    android_pause_session :: () -> int #private {
        app := get_global_app()
        if app == nil {
            TraceLog(LOG_ERROR, "APP_JNI: nativePauseSession: app is nil")
            return 0
        }
        if app->session_paused {
            return 0
        }
        app->session_paused = 1
        app->backgrounded = 1
        return 1
    }

    android_resume_session :: () #private {
        app := get_global_app()
        if app == nil {
            TraceLog(LOG_ERROR, "APP_JNI: nativeResumeSession: app is nil")
            return
        }
        if !app->session_paused {
            return
        }
        app->session_paused = 0
        app->backgrounded = 0
    }

    android_sync_lifecycle :: (activity_paused: int,
                               indicator_visible: int) -> int #export {
        run_in_background := 0
        if android_play_in_background() != 0 &&
           activity_paused != 0 && indicator_visible != 0 {
            run_in_background = 1
        }
        pause_for_lifecycle := activity_paused != 0 && run_in_background == 0

        if background_execution_active != run_in_background {
            android_set_background_active(run_in_background)
            background_execution_active = run_in_background
        }

        if pause_for_lifecycle && !auto_paused_for_lifecycle {
            auto_paused_for_lifecycle = android_pause_session()
        } else if !pause_for_lifecycle && auto_paused_for_lifecycle {
            android_resume_session()
            auto_paused_for_lifecycle = 0
        }
        return background_execution_active
    }

    android_invalidate_graphics_resources :: () #export {
        app := get_global_app()
        if app != nil {
            app_request_graphics_reload(app)
        }
    }

    android_practice_to_start :: (practice_id: int) -> int #export {
        app := get_global_app()
        if app == nil {
            return -1
        }
        if practice_id < 0 {
            practice_id = app->exercise_type
        }
        return practice_clamp_id(practice_id)
    }

    android_debug_import_music_for_practice :: (path: const char*,
                                                  practice_id: int) -> int #export {
        app := get_global_app()
        if app == nil || path == nil {
            return 0
        }

        error_code := AUDIO_IMPORT_ERROR_UNKNOWN
        app_audio_ensure_ready(app)
        if !app_audio_import_custom_music_ex(app, path, &error_code) {
            TraceLog(LOG_ERROR,
                     "ANDROID_DEBUG_MUSIC: import failed error=%d path=%s",
                     error_code, path)
            return 0
        }

        practice_id = practice_clamp_id(practice_id)
        track := AUDIO_BUILTIN_MUSIC_COUNT + app->audio_custom_music_count - 1
        app->meditation.music_practice_tracks[practice_id] = track
        app->meditation.music_track = track
        app_audio_music_sanitize_selection(app)
        app->sound_volume = 0
        app->music_volume = 100
        save_settings(app)
        TraceLog(LOG_INFO,
                 "ANDROID_DEBUG_MUSIC: imported and selected track=%d practice=%d path=%s",
                 track, practice_id,
                 app->audio_custom_music[track - AUDIO_BUILTIN_MUSIC_COUNT].path)
        return 1
    }

    android_debug_start_music_download :: () -> int #export {
        app := get_global_app()
        if app == nil {
            return 0
        }
        meditation_music_start_download(app)
        return 1
    }

    android_can_open_donation_reminder :: () -> int #export {
        if get_global_app() == nil {
            return 0
        }
        return 1
    }
}
