#module "platform.android.push"

ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "app.h"
    #import "platform/android/android_jni"
    #import "kryon.h" #private
    #import <android/log.h>

    static push_log_tag: const char* = "INBE_PUSH"

    static push_registered_cache: int = -1
    static push_registered_frames: int = 0

    refresh_distributors :: (inbe: InbeApp*) {
        session: AndroidJni
        count := 0

        if inbe == nil {
            return
        }
        inbe->push_distributor_count = 0
        session = platform_android_jni_attach()
        if !platform_android_jni_valid(&session) {
            return
        }

        array: jobjectArray = nil
        clazz := (*session.env)->GetObjectClass(session.env, session.activity)
        if clazz {
            method := (*session.env)->GetMethodID(session.env, clazz,
                                                  "getUnifiedPushDistributors",
                                                  "()[Ljava/lang/String;")
            if method {
                array = (jobjectArray)(*session.env)->CallObjectMethod(
                    session.env, session.activity, method)
            } else {
                __android_log_write(ANDROID_LOG_ERROR, push_log_tag,
                                    "getUnifiedPushDistributors not found")
            }
        }

        if array != nil {
            count = (*session.env)->GetArrayLength(session.env, array)
            if count > APP_PUSH_DISTRIBUTOR_MAX {
                count = APP_PUSH_DISTRIBUTOR_MAX
            }
            for int i = 0; i < count; i++ {
                s := (jstring)(*session.env)->GetObjectArrayElement(session.env,
                                                                    array, i)
                if s == nil {
                    continue
                }
                text := (*session.env)->GetStringUTFChars(session.env, s, nil)
                if text != nil {
                    for int c = 0; c < 95 && text[c] != 0; c++ {
                        inbe->push_distributors[i][c] = text[c]
                    }
                    inbe->push_distributors[i][95] = 0
                    (*session.env)->ReleaseStringUTFChars(session.env, s, text)
                }
                (*session.env)->DeleteLocalRef(session.env, s)
            }
            inbe->push_distributor_count = count
            (*session.env)->DeleteLocalRef(session.env, array)
        }

        if count > 0 {
            platform_android_jni_call_string_array(
                &session, "getUnifiedPushDistributorLabels",
                &inbe->push_distributor_labels[0][0], 64, count)
            platform_android_jni_call_string_array(
                &session, "getUnifiedPushDistributorIcons",
                &inbe->push_distributor_icons[0][0], 256, count)
        }
        platform_android_jni_detach(&session)
    }

    configure_with :: (inbe: InbeApp*, index: int) {
        session: AndroidJni

        if inbe == nil || index < 0 || index >= inbe->push_distributor_count {
            return
        }
        session = platform_android_jni_attach()
        if !platform_android_jni_valid(&session) {
            return
        }
        arg := platform_android_jni_new_string(
            &session, &inbe->push_distributors[index][0])
        if arg != nil {
            platform_android_jni_call_void_string(&session,
                                                  "configureUnifiedPushWith",
                                                  arg)
            platform_android_jni_delete_local(&session, arg)
        }
        platform_android_jni_detach(&session)
    }

    configure :: () {
        session: AndroidJni

        session = platform_android_jni_attach()
        if platform_android_jni_valid(&session) {
            platform_android_jni_call_void(&session, "configureUnifiedPush",
                                           "()V")
        }
        platform_android_jni_detach(&session)
    }

    registered :: () -> int {
        session: AndroidJni

        push_registered_frames += 1
        if push_registered_cache >= 0 && push_registered_frames < 30 {
            return push_registered_cache
        }
        push_registered_frames = 0

        session = platform_android_jni_attach()
        if !platform_android_jni_valid(&session) {
            return push_registered_cache >= 0 ? push_registered_cache : 0
        }
        push_registered_cache = platform_android_jni_call_bool(
            &session, "isUnifiedPushRegistered")
        platform_android_jni_detach(&session)
        return push_registered_cache
    }
}
