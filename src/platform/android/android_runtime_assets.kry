ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "runtime_assets.h" #private
    #import "kryon.h" #private
    #import <android/native_activity.h>
    #import <android_native_app_glue.h>
    #import <stdint.h>
    #import <stdio.h>

    GetAndroidApp :: () -> struct android_app* #extern

    android_runtime_asset_download :: (download: RuntimeAssetDownload*,
                                      url: const char*,
                                      path: const char*) -> int #private {
        app: struct android_app*
        jvm: JavaVM*
        env: JNIEnv* = nil
        did_attach: int = 0
        activity_class: jclass
        method: jmethodID
        jurl: jstring
        jpath: jstring

        if download == nil || url == nil || path == nil {
            return 0
        }

        app = GetAndroidApp()
        if app == nil || app->activity == nil || app->activity->vm == nil ||
           app->activity->clazz == nil {
            snprintf(download->error, sizeof(download->error),
                     "Android activity is not ready")
            download->status = RUNTIME_ASSET_ERROR
            return 0
        }

        jvm = app->activity->vm
        if (*jvm)->GetEnv(jvm, (void **)&env, JNI_VERSION_1_6) != JNI_OK {
            if (*jvm)->AttachCurrentThread(jvm, &env, nil) != JNI_OK ||
               env == nil {
                snprintf(download->error, sizeof(download->error),
                         "failed to attach Android thread")
                download->status = RUNTIME_ASSET_ERROR
                return 0
            }
            did_attach = 1
        }

        activity_class = (*env)->GetObjectClass(env, app->activity->clazz)
        if activity_class == nil {
            snprintf(download->error, sizeof(download->error),
                     "Android activity class not found")
            download->status = RUNTIME_ASSET_ERROR
            if did_attach {
                (*jvm)->DetachCurrentThread(jvm)
            }
            return 0
        }

        method = (*env)->GetMethodID(env, activity_class,
                                     "startRuntimeAssetDownload",
                                     "(Ljava/lang/String;Ljava/lang/String;J)V")
        if method == nil {
            snprintf(download->error, sizeof(download->error),
                     "Android downloader method not found")
            download->status = RUNTIME_ASSET_ERROR
            (*env)->DeleteLocalRef(env, activity_class)
            if did_attach {
                (*jvm)->DetachCurrentThread(jvm)
            }
            return 0
        }

        jurl = (*env)->NewStringUTF(env, url)
        jpath = (*env)->NewStringUTF(env, path)
        if jurl == nil || jpath == nil {
            snprintf(download->error, sizeof(download->error),
                     "failed to allocate Android strings")
            download->status = RUNTIME_ASSET_ERROR
            if jurl != nil {
                (*env)->DeleteLocalRef(env, jurl)
            }
            if jpath != nil {
                (*env)->DeleteLocalRef(env, jpath)
            }
            (*env)->DeleteLocalRef(env, activity_class)
            if did_attach {
                (*jvm)->DetachCurrentThread(jvm)
            }
            return 0
        }

        (*env)->CallVoidMethod(env, app->activity->clazz, method, jurl, jpath,
                               (jlong)(intptr_t)download)
        (*env)->DeleteLocalRef(env, jurl)
        (*env)->DeleteLocalRef(env, jpath)
        (*env)->DeleteLocalRef(env, activity_class)

        if (*env)->ExceptionCheck(env) {
            (*env)->ExceptionDescribe(env)
            (*env)->ExceptionClear(env)
            snprintf(download->error, sizeof(download->error),
                     "Android downloader failed to start")
            download->status = RUNTIME_ASSET_ERROR
            if did_attach {
                (*jvm)->DetachCurrentThread(jvm)
            }
            return 0
        }

        if did_attach {
            (*jvm)->DetachCurrentThread(jvm)
        }
        return 1
    }

    android_runtime_assets_init :: () #export {
        SetRuntimeAssetDownloadBackend(android_runtime_asset_download)
    }

    android_runtime_asset_native_succeeded :: (env: JNIEnv*, thiz: jobject,
                                              handle: jlong, bytes: jlong,
                                              http_status: jint) #export {
        download := (RuntimeAssetDownload *)(intptr_t)handle

        unused env
        unused thiz
        if download == nil {
            return
        }

        download->http_status = (long)http_status
        download->bytes = bytes > 0 ? (size_t)bytes : 0
        if download->total_bytes == 0 {
            download->total_bytes = download->bytes
        }
        download->error[0] = '\0'
        download->status = RUNTIME_ASSET_READY
    }

    android_runtime_asset_native_progress :: (env: JNIEnv*, thiz: jobject,
                                             handle: jlong, bytes: jlong,
                                             total_bytes: jlong) #export {
        download := (RuntimeAssetDownload *)(intptr_t)handle

        unused env
        unused thiz
        if download == nil {
            return
        }

        download->bytes = bytes > 0 ? (size_t)bytes : 0
        download->total_bytes = total_bytes > 0 ? (size_t)total_bytes : 0
    }

    android_runtime_asset_native_failed :: (env: JNIEnv*, thiz: jobject,
                                           handle: jlong, http_status: jint,
                                           error: jstring) #export {
        download := (RuntimeAssetDownload *)(intptr_t)handle
        message: const char* = nil

        unused thiz
        if download == nil {
            return
        }

        if error != nil {
            message = (*env)->GetStringUTFChars(env, error, nil)
        }

        download->http_status = (long)http_status
        snprintf(download->error, sizeof(download->error), "%s",
                 message != nil && message[0] != '\0'
                    ? message
                    : "Android download failed")
        download->status = RUNTIME_ASSET_ERROR

        if message != nil {
            (*env)->ReleaseStringUTFChars(env, error, message)
        }
    }
}
