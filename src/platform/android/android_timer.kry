ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "platform/android/android_timer.h"
    #import "app.h" #private
    #import "practices/practice_registry.h" #private
    #import "kryon.h" #private
    #import <time.h>
    #import <pthread.h>
    #import <android/log.h>
    #import <unistd.h>

    static timer_log_tag: const char* = "INBE_TIMER"
    TARGET_FPS :: #define 60
    FRAME_TIME_US :: #define (1000000 / TARGET_FPS)

    timer_thread :: pthread_t #global
    timer_mutex :: pthread_mutex_t = PTHREAD_MUTEX_INITIALIZER #global
    inbe_state_mutex :: pthread_mutex_t = PTHREAD_MUTEX_INITIALIZER #global
    timer_running :: int = 0 #global
    timer_active :: int = 0 #global
    g_app :: void* = nil #global

    monotonic_elapsed_ms :: (last_tick: struct timespec*) -> int #private {
        now: struct timespec
        elapsed_ms: long long

        clock_gettime(CLOCK_MONOTONIC, &now)
        if last_tick->tv_sec == 0 && last_tick->tv_nsec == 0 {
            *last_tick = now
            return FRAME_TIME_US / 1000
        }

        elapsed_ms = (long long)(now.tv_sec - last_tick->tv_sec) * 1000LL +
                     (now.tv_nsec - last_tick->tv_nsec) / 1000000LL
        *last_tick = now
        if elapsed_ms <= 0 {
            return FRAME_TIME_US / 1000
        }
        if elapsed_ms > 5 * 60 * 1000 {
            return 5 * 60 * 1000
        }
        return (int)elapsed_ms
    }

    timer_thread_func :: (arg: void*) -> void* #private {
        frame_count := 0
        last_tick: struct timespec = {0}

        unused arg
        while 1 {
            pthread_mutex_lock(&timer_mutex)

            if !timer_running {
                pthread_mutex_unlock(&timer_mutex)
                __android_log_write(ANDROID_LOG_INFO, timer_log_tag,
                                    "Timer thread: stopping")
                break
            }

            should_run := timer_active && g_app != nil
            pthread_mutex_unlock(&timer_mutex)

            if should_run {
                frame_count++

                pthread_mutex_lock(&inbe_state_mutex)
                app := (InbeApp*)g_app
                practice_active_advance_elapsed(app,
                    monotonic_elapsed_ms(&last_tick))
                pthread_mutex_unlock(&inbe_state_mutex)

                usleep(FRAME_TIME_US)
            } else {
                if frame_count > 0 {
                    __android_log_write(ANDROID_LOG_INFO, timer_log_tag,
                                        "Timer: Paused (inactive)")
                    frame_count = 0
                }
                last_tick = (struct timespec){0}
                usleep(50000)
            }
        }

        __android_log_write(ANDROID_LOG_INFO, timer_log_tag, "Timer thread stopped")
        return nil
    }

    android_timer_set_app :: (app_ptr: void*) #export {
        pthread_mutex_lock(&timer_mutex)
        g_app = app_ptr
        pthread_mutex_unlock(&timer_mutex)
    }

    android_timer_get_mutex :: () -> pthread_mutex_t* #export {
        return &inbe_state_mutex
    }

    android_timer_start :: () #export {
        pthread_mutex_lock(&timer_mutex)

        if timer_running {
            timer_active = 1
            pthread_mutex_unlock(&timer_mutex)
            return
        }

        timer_running = 1
        timer_active = 0
        pthread_mutex_unlock(&timer_mutex)

        result := pthread_create(&timer_thread, nil, timer_thread_func, nil)
        if result != 0 {
            __android_log_write(ANDROID_LOG_ERROR, timer_log_tag,
                                "Failed to create timer thread")
        }
    }

    android_timer_stop :: () #export {
        pthread_mutex_lock(&timer_mutex)

        if !timer_running {
            g_app = nil
            pthread_mutex_unlock(&timer_mutex)
            return
        }

        timer_running = 0
        timer_active = 0
        g_app = nil
        pthread_mutex_unlock(&timer_mutex)

        if pthread_equal(pthread_self(), timer_thread) {
            pthread_detach(timer_thread)
        } else {
            pthread_join(timer_thread, nil)
        }
    }

    android_timer_activate :: () #export {
        pthread_mutex_lock(&timer_mutex)
        timer_active = 1
        pthread_mutex_unlock(&timer_mutex)
    }

    android_timer_deactivate :: () #export {
        pthread_mutex_lock(&timer_mutex)
        timer_active = 0
        pthread_mutex_unlock(&timer_mutex)
    }
}
