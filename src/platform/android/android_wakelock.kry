ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "platform/android/android_wakelock.h"
    #import "kryon.h" #private
    #import <pthread.h>
    #import <android/log.h>
    #import <jni.h>

    LOG_TAG :: #define "INBE_WAKE"

    g_jvm :: JavaVM* = nil #global
    g_activity :: jobject = nil #global
    g_acquire_method :: jmethodID = nil #global
    g_release_method :: jmethodID = nil #global
    g_update_notification_method :: jmethodID = nil #global
    g_keep_screen_on_method :: jmethodID = nil #global
    g_allow_screen_off_method :: jmethodID = nil #global
    wakelock_mutex :: pthread_mutex_t = PTHREAD_MUTEX_INITIALIZER #global

    android_wakelock_init :: () #export {
    }

    android_wakelock_set_activity :: (env: JNIEnv*, activity: jobject) #export {
        pthread_mutex_lock(&wakelock_mutex)

        if g_activity {
            (*env)->DeleteGlobalRef(env, g_activity)
        }

        g_activity = (*env)->NewGlobalRef(env, activity)

        if g_activity {
            clazz := (*env)->GetObjectClass(env, activity)
            if clazz {
                g_acquire_method =
                    (*env)->GetMethodID(env, clazz, "acquireWakeLock", "()V")
                g_release_method =
                    (*env)->GetMethodID(env, clazz, "releaseWakeLock", "()V")
                g_update_notification_method =
                    (*env)->GetMethodID(env, clazz, "updateSessionNotification",
                                        "(Ljava/lang/String;)V")
                g_keep_screen_on_method =
                    (*env)->GetMethodID(env, clazz, "keepScreenOn", "()V")
                g_allow_screen_off_method =
                    (*env)->GetMethodID(env, clazz, "allowScreenOff", "()V")
                (*env)->DeleteLocalRef(env, clazz)
            }
        }

        pthread_mutex_unlock(&wakelock_mutex)
    }

    wakelock_get_env :: (env_out: JNIEnv**) -> int #private {
        result: jint

        if env_out == nil {
            return 0
        }
        *env_out = nil
        if !g_jvm || !g_activity {
            return 0
        }
        result = (*g_jvm)->GetEnv(g_jvm, (void**)env_out, JNI_VERSION_1_6)
        if result == JNI_EDETACHED {
            result = (*g_jvm)->AttachCurrentThread(g_jvm, env_out, nil)
        }
        return *env_out != nil
    }

    android_wakelock_acquire :: () #export {
        env: JNIEnv* = nil

        pthread_mutex_lock(&wakelock_mutex)
        if !wakelock_get_env(&env) {
            __android_log_write(ANDROID_LOG_ERROR, LOG_TAG,
                                "ACQUIRE: JNI not initialized - skipping wake lock")
            pthread_mutex_unlock(&wakelock_mutex)
            return
        }
        if g_acquire_method {
            (*env)->CallVoidMethod(env, g_activity, g_acquire_method)
        }
        pthread_mutex_unlock(&wakelock_mutex)
    }

    android_wakelock_update_session_notification :: (status_text: const char*) #export {
        env: JNIEnv* = nil

        if status_text == nil {
            return
        }

        pthread_mutex_lock(&wakelock_mutex)
        if !wakelock_get_env(&env) {
            pthread_mutex_unlock(&wakelock_mutex)
            return
        }

        if g_update_notification_method {
            text := (*env)->NewStringUTF(env, status_text)
            if text != nil {
                (*env)->CallVoidMethod(env, g_activity,
                                       g_update_notification_method, text)
                (*env)->DeleteLocalRef(env, text)
            }
        }

        pthread_mutex_unlock(&wakelock_mutex)
    }

    android_wakelock_release :: () #export {
        env: JNIEnv* = nil

        pthread_mutex_lock(&wakelock_mutex)
        if !wakelock_get_env(&env) {
            __android_log_write(ANDROID_LOG_ERROR, LOG_TAG,
                                "RELEASE: JNI not initialized - skipping wake lock")
            pthread_mutex_unlock(&wakelock_mutex)
            return
        }
        if g_release_method {
            (*env)->CallVoidMethod(env, g_activity, g_release_method)
        }
        pthread_mutex_unlock(&wakelock_mutex)
    }

    android_keep_screen_on :: () #export {
        env: JNIEnv* = nil

        pthread_mutex_lock(&wakelock_mutex)
        if !wakelock_get_env(&env) {
            __android_log_write(ANDROID_LOG_ERROR, LOG_TAG,
                                "KEEP_SCREEN_ON: JNI not initialized - skipping")
            pthread_mutex_unlock(&wakelock_mutex)
            return
        }
        if g_keep_screen_on_method {
            (*env)->CallVoidMethod(env, g_activity, g_keep_screen_on_method)
        }
        pthread_mutex_unlock(&wakelock_mutex)
    }

    android_allow_screen_off :: () #export {
        env: JNIEnv* = nil

        pthread_mutex_lock(&wakelock_mutex)
        if !wakelock_get_env(&env) {
            __android_log_write(ANDROID_LOG_ERROR, LOG_TAG,
                                "ALLOW_SCREEN_OFF: JNI not initialized - skipping")
            pthread_mutex_unlock(&wakelock_mutex)
            return
        }
        if g_allow_screen_off_method {
            (*env)->CallVoidMethod(env, g_activity, g_allow_screen_off_method)
        }
        pthread_mutex_unlock(&wakelock_mutex)
    }

    android_wakelock_set_jvm :: (vm: JavaVM*) #export {
        g_jvm = vm
    }
}
