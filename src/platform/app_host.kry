#module "platform.app_host"

#import "app/app"
#import "app/screenshots"
#import "breaks/app_breaks"
#import "desktop.h"
#import "platform/app_desktop_tray.h"
#import <stdio.h>
#import <stdlib.h>
#import <string.h>

#if ANDROID_BUILD {
    #import "platform/android/android_insets.h"
}

WindowSize :: struct {
    width: int
    height: int
}

#if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
    DesktopIdentity :: () -> DesktopAppInfo #export {
        override_root := getenv("APP_DATA_ROOT")
        if override_root != nil && override_root[0] != '\0' {
            return (DesktopAppInfo){
                .app_id = "xyz.waozi.inbe.debug",
                .name = "inbe-debug",
                .display_name = "Inner Breeze (Debug)",
                .summary = "Syncable breathing, meditation, and habit practice app.",
                .icon_name = "xyz.waozi.inbe.debug",
                .wm_class = "xyz.waozi.inbe.debug",
                .single_instance = 0
            }
        }
        return (DesktopAppInfo){
            .app_id = "xyz.waozi.inbe",
            .name = "inbe",
            .display_name = "Inner Breeze",
            .summary = "Syncable breathing, meditation, and habit practice app.",
            .icon_name = "xyz.waozi.inbe",
            .wm_class = "xyz.waozi.inbe",
            .single_instance = 0
        }
    }
}

native_limit_allocators :: () #extern #private
native_screenshot_data_root :: () #extern #private
native_install_trace_log_filter :: () #extern #private
native_init_desktop_identity :: () #extern #private
native_window_environment :: () #extern #private
native_before_window :: () #extern #private
native_after_window :: (icon_path: const char*) -> int #extern #private
native_platform_shutdown :: () #extern #private
native_update_apply_at_exit :: () -> int #extern #private
native_frame_diagnostics :: () #extern #private

#if #defined(_WIN32) && !ANDROID_BUILD {
    WindowsStartupErrorMessage :: (detail: const char*,
                                   output: char*, capacity: size_t) #export {
        if output == nil || capacity == 0 {
            return
        }
        actual_detail := detail
        if actual_detail == nil || actual_detail[0] == '\0' {
            actual_detail = "No detailed startup error was reported."
        }
        hint: const char* = ""
        if strstr(actual_detail, "OpenGL") != nil ||
           strstr(actual_detail, "WGL") != nil ||
           strstr(actual_detail, "GLFW") != nil {
            hint = "\nThis is usually a graphics driver or virtual GPU problem. "
                   "Update the GPU driver, enable VM 3D acceleration, or install the VM guest graphics driver.\n"
        }
        snprintf(output, capacity,
                 "Inner Breeze could not create a window.\n\n%s%s\nA full log was written to inbe.log next to the executable.",
                 actual_detail, hint)
    }
}

#if ANDROID_BUILD {
    native_android_frame_viewport :: (viewport: AndroidViewport*) -> int #extern #private
}

#if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
    native_screenshot_arm_readback :: () #extern #private
    kry_write_png_file :: (path: const char*, rgba: const u8*,
                           width: int, height: int) -> int #extern #private
}

#if #defined(PLATFORM_WEB) {
    native_start_web_loop :: (app: InnerBreeze*) #extern #private
} #else {
    native_install_shutdown_handlers :: () #extern #private
    native_shutdown_requested :: () -> int #extern #private
}

Prepare :: (argc: int, argv: char**) {
    native_limit_allocators()
    screenshot := current_screenshot_request()
    parse_screenshot_args(argc, argv, screenshot)
    if screenshot->active {
        native_screenshot_data_root()
    }
    native_install_trace_log_filter()
    if getenv("APP_NO_SINGLE_INSTANCE") != nil || screenshot->active {
        SetSingleInstance(0)
    }
    if !screenshot->active {
        # A separate data root identifies a debug desktop profile.
        #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
            override_root := getenv("APP_DATA_ROOT")
            if override_root != nil && override_root[0] != '\0' {
                identity := DesktopIdentity()
                snprintf(config.title, sizeof(config.title), "%s",
                         identity.display_name)
                config.title_custom = 1
            }
        }
        native_init_desktop_identity()
    } else {
        SetTraceLogLevel(LOG_WARNING)
        config.width = screenshot->width
        config.height = screenshot->height
    }
}

InitialWindowSize :: () -> WindowSize {
    size := (WindowSize){config.width, config.height}
    #if ANDROID_BUILD {
        size.width = 0
        size.height = 0
    }
    #if #defined(PLATFORM_WEB) {
        GetWebViewportSize(config.width, config.height,
                           &size.width, &size.height)
        config.width = size.width
        config.height = size.height
    }
    return size
}

ConfigureWindow :: () {
    native_window_environment()
    #if #defined(PLATFORM_WEB) {
        SetConfigFlags(GetWebWindowFlags())
    } #else {
        #if !ANDROID_BUILD {
            SetConfigFlags(FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_ALWAYS_RUN)
        }
    }
    native_before_window()
}

FinishWindowSetup :: () -> int {
    if !native_after_window("assets/app/icon.png") {
        return 0
    }
    #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
        # ESC belongs to Inbe's screen and close-prompt handling.
        SetExitKey(0)
    }
    InitDPI()
    return 1
}

FinishAppSetup :: (app: InnerBreeze*, argc: int, argv: char**) {
    native_after_app_init(app, argc, argv)
}

DrawFrame :: (app: InnerBreeze*) {
    app_frame(app)
}

app_frame :: (app: InnerBreeze*) #export {
    #if #defined(PLATFORM_WEB) {
        SyncWebWindowSize()
    }
    native_frame_diagnostics()

    width := GetScreenWidth()
    height := GetScreenHeight()

    #if !ANDROID_BUILD && !#defined(PLATFORM_WEB) {
        render_width := GetRenderWidth()
        render_height := GetRenderHeight()
        if render_width > width {
            width = render_width
        }
        if render_height > height {
            height = render_height
        }
    }

    #if ANDROID_BUILD {
        viewport: AndroidViewport
        if !native_android_frame_viewport(&viewport) {
            return
        }
        GetAndroidSurfaceSize(&width, &height)
        BeginDrawing()
        ClearBackground((Color){0, 0, 0, 255})
        BeginClip(viewport.x, viewport.y, viewport.width, viewport.height)
        app_update_draw(app, (Rectangle){(float)viewport.x, (float)viewport.y,
                                         (float)viewport.width, (float)viewport.height})
        EndClip()
    } #else {
        BeginDrawing()
        ClearBackground(StyleTokenColor("canvas"))
        app_update_draw(app, (Rectangle){0, 0, (float)width, (float)height})
    }
    EndDrawing()
    app_breaks_hud_update(app)
    app_breaks_window_update(app)
}

ScreenshotRequested :: () -> int {
    return current_screenshot_request()->active
}

CaptureScreenshot :: (app: InnerBreeze*) -> int {
    #if #defined(PLATFORM_WEB) || ANDROID_BUILD {
        unused app
        return 0
    } #else {
        request := current_screenshot_request()
        if request == nil || !request->active {
            return 0
        }

        # The renderer reads pixels before swap when screenshot mode arms it.
        native_screenshot_arm_readback()
        setup_screenshot_scene(app, request)
        warmup_frames := screenshot_warmup_frames(request)
        for int frame = 0; frame < warmup_frames; frame++ {
            app_frame(app)
        }
        screenshot_after_warmup(app, request)

        # External capture on GL stacks where the direct readback is blank.
        if getenv("APP_SHOT_WINDOW") != nil {
            while 1 {
                app_frame(app)
            }
        }

        capture: Image = LoadImageFromScreen()
        if capture.data == nil {
            TraceLog(LOG_ERROR, "APP: screenshot readback failed")
            return -1
        }
        saved := kry_write_png_file(request->output,
                                    (const u8*)capture.data,
                                    capture.width, capture.height) == 0
        UnloadImage(capture)
        return saved ? 1 : -1
    }
}

ShouldStartHidden :: (app: InnerBreeze*) -> int {
    return native_should_start_hidden(app)
}

Shutdown :: () {
    native_platform_shutdown()
}

ApplyPendingUpdate :: () -> int {
    return native_update_apply_at_exit()
}

#if #defined(PLATFORM_WEB) {
    StartWebLoop :: (app: InnerBreeze*) {
        native_start_web_loop(app)
    }
} #else {
    InstallShutdownHandlers :: () {
        native_install_shutdown_handlers()
    }

    ShutdownRequested :: () -> int {
        return native_shutdown_requested()
    }
}

native_after_app_init :: (app: InnerBreeze*, argc: int, argv: char**) #export {
    if app == nil {
        return
    }
    set_global_app(app)
    TraceLog(LOG_INFO, "APP: Global app pointer set")
    for int argi = 1; argi < argc; argi++ {
        if strcmp(argv[argi], "--break-now") == 0 {
            app->breaks_enabled = 1
            break_engine_force_break(&app->breaks, BREAK_MICRO)
            TraceLog(LOG_INFO, "APP: forced micro break from --break-now")
        }
    }
    KryonMemReport("after-app-init")
    TextFontMemoryReport("after-app-init")
    #if ANDROID_BUILD {
        app->fullscreen_enabled = 0
    }
    #if ANDROID_BUILD {
        ConfigureFramePacing(15, 60)
    } #else {
        ConfigureFramePacing(30, 60)
    }
    SetFramePacingActive(1)
    UpdateFramePacing()
}

native_should_start_hidden :: (app: InnerBreeze*) -> int #export {
    #if #defined(DESKTOP_TRAY_ENABLED) {
        return app != nil &&
        app->desktop_startup_mode == STARTUP_HIDDEN &&
        !ScreenshotRequested() &&
        desktop_tray_ready()
    } #else {
        unused app
        return 0
    }
}
