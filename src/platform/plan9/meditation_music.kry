#module "platform.plan9.meditation_music"

#import "app/app"
#import "practices/meditation/meditation_music"
#import "runtime_assets.h"
#import "storage.h"
#import <stdio.h>

#if #defined(KRYON_PLATFORM_PLAN9) {
    plan9_music_set_status :: (app: InnerBreeze*,
    message: const char*) #private {
        if app == nil {
            return
        }
        snprintf(app->meditation.music_status,
                 sizeof(app->meditation.music_status),
                 "%s", message != nil ? message : "")
    }

    plan9_music_track_available :: (app: InnerBreeze*,
    track: int) -> int #private {
        path: [FS_PATH_MAX] char
        return app_audio_music_path(app, track, path, sizeof(path)) != 0 &&
               app_audio_music_file_valid(path) != 0 ? 1 : 0
    }

    plan9_music_load_track :: (app: InnerBreeze*,
    track: int) -> int #private {
        path: [FS_PATH_MAX] char
        if app == nil {
            return 0
        }
        app_audio_ensure_ready(app)
        if !app->audio_ready {
            TraceLog(LOG_ERROR,
                     "AUDIO: Cannot load meditation music because audio device is not ready")
            plan9_music_set_status(app,
                GetLocaleText("meditation_music_device_not_ready"))
            return 0
        }
        if track < 0 || track >= app_audio_music_count(app) {
            track = 0
        }
        meditation_music_unload(app)
        if !app_audio_music_path(app, track, path, sizeof(path)) ||
           !app_audio_music_file_valid(path) {
            plan9_music_set_status(app,
                GetLocaleText("meditation_music_track_not_installed"))
            return 0
        }
        app->meditation.music = LoadMusicStream(path)
        if !IsMusicValid(app->meditation.music) {
            TraceLog(LOG_ERROR, "AUDIO: Could not load meditation track: %s", path)
            plan9_music_set_status(app,
                GetLocaleText("meditation_music_track_load_failed"))
            app->meditation.music_loaded = 0
            return 0
        }
        app->meditation.music_loaded = 1
        app->meditation.music_track = track
        app->meditation.music_fade_out_ticks = 0
        app->meditation.music_fade_out_total_ticks = 0
        SetMusicVolume(app->meditation.music, (float)app->music_volume / 100.0f)
        TraceLog(LOG_INFO, "AUDIO: Loaded meditation track: %s", path)
        return 1
    }

    meditation_music_format_download_status :: (out: char*, out_size: size_t,
    download: const RuntimeAssetDownload*) #export {
        unused download
        if out != nil && out_size > 0 {
            out[0] = '\0'
        }
    }

    meditation_music_draw_download_progress :: (app: InnerBreeze*,
    x: int, y: int, w: int) #export {
        unused app
        unused x
        unused y
        unused w
    }

    meditation_music_available :: (app: InnerBreeze*) -> int #export {
        if app == nil {
            return 0
        }
        for int index = 0; index < MEDITATION_MUSIC_TRACK_COUNT; index++ {
            if !plan9_music_track_available(app, index) {
                return 0
            }
        }
        return 1
    }

    meditation_music_selected_label :: (app: InnerBreeze*) -> const char* #export {
        if app == nil {
            return ""
        }
        track: int = app->meditation.music_track
        if track < 0 || track >= app_audio_music_count(app) {
            track = 0
        }
        return app_audio_music_label(app, track)
    }

    meditation_music_init :: (app: InnerBreeze*) #export {
        if app == nil {
            return
        }
        app_audio_music_sanitize_selection(app)
        if app->meditation.music_status[0] == '\0' {
            if meditation_music_available(app) {
                plan9_music_set_status(app,
                    GetLocaleText("meditation_music_installed"))
            } else {
                plan9_music_set_status(app,
                    GetLocaleText("meditation_music_not_installed"))
            }
        }
    }

    meditation_music_unload :: (app: InnerBreeze*) #export {
        if app == nil {
            return
        }
        if app->meditation.music_loaded {
            StopMusicStream(app->meditation.music)
            UnloadMusicStream(app->meditation.music)
            app->meditation.music_loaded = 0
        }
        app->meditation.music_playing = 0
        app->meditation.music_test_playing = 0
        app->meditation.music_fade_out_ticks = 0
        app->meditation.music_fade_out_total_ticks = 0
    }

    meditation_music_stop :: (app: InnerBreeze*) #export {
        if app == nil {
            return
        }
        if app->meditation.music_loaded {
            StopMusicStream(app->meditation.music)
        }
        app->meditation.music_playing = 0
        app->meditation.music_test_playing = 0
        app->meditation.music_fade_out_ticks = 0
        app->meditation.music_fade_out_total_ticks = 0
    }

    meditation_music_fade_out :: (app: InnerBreeze*) #export {
        if app == nil || !app->meditation.music_loaded ||
           !app->meditation.music_playing ||
           app->meditation.music_fade_out_ticks > 0 {
            return
        }
        app->meditation.music_fade_out_ticks = 180
        app->meditation.music_fade_out_total_ticks = 180
    }

    meditation_music_start_session :: (app: InnerBreeze*) #export {
        if app == nil {
            return
        }
        app_audio_music_sanitize_selection(app)
        practice: int = app->exercise_type
        if practice < 0 || practice >= EXERCISE_COUNT {
            practice = EXERCISE_MEDITATION
        }
        track: int = app->meditation.music_practice_tracks[practice]
        if track == AUDIO_MUSIC_NONE {
            return
        }
        if !plan9_music_load_track(app, track) {
            return
        }
        PlayMusicStream(app->meditation.music)
        app->meditation.music_playing = 1
        app->meditation.music_test_playing = 0
    }

    meditation_music_update :: (app: InnerBreeze*) #export {
        if app == nil || !app->meditation.music_loaded {
            return
        }
        volume: float = (float)app->music_volume / 100.0f
        if app->meditation.music_fade_out_ticks > 0 &&
           app->meditation.music_fade_out_total_ticks > 0 {
            volume *= (float)app->meditation.music_fade_out_ticks /
                      (float)app->meditation.music_fade_out_total_ticks
            app->meditation.music_fade_out_ticks--
            if app->meditation.music_fade_out_ticks <= 0 {
                meditation_music_stop(app)
                return
            }
        }
        SetMusicVolume(app->meditation.music, volume)
        UpdateMusicStream(app->meditation.music)
    }

    meditation_music_start_download :: (app: InnerBreeze*) #export {
        unused app
    }

    meditation_music_draw_practice_settings :: (app: InnerBreeze*,
    practice: int, content_x: int, content_w: int, y: int*,
    show_installed_download: int, show_status: int) #export {
        unused app
        unused practice
        unused content_x
        unused content_w
        unused y
        unused show_installed_download
        unused show_status
    }

    meditation_music_measure_practice_settings :: (app: InnerBreeze*,
    practice: int, content_w: int, show_installed_download: int,
    show_status: int) -> int #export {
        unused app
        unused practice
        unused content_w
        unused show_installed_download
        unused show_status
        return 0
    }
}
