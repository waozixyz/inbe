#module "platform.tray"
#import "app.h"

DesktopTrayAction :: enum {
    DESKTOP_TRAY_ACTION_NONE = 0
    DESKTOP_TRAY_ACTION_SHOW
    DESKTOP_TRAY_ACTION_HIDE
    DESKTOP_TRAY_ACTION_MINIMIZE
    DESKTOP_TRAY_ACTION_CLOSE_REQUEST
    DESKTOP_TRAY_ACTION_START_WHM
    DESKTOP_TRAY_ACTION_START_MEDITATION
    DESKTOP_TRAY_ACTION_START_SUN_SALUTATION
    DESKTOP_TRAY_ACTION_START_PATTERNS
    DESKTOP_TRAY_ACTION_QUIT
    DESKTOP_TRAY_ACTION_MARK_HABIT_0
    DESKTOP_TRAY_ACTION_MARK_HABIT_1
    DESKTOP_TRAY_ACTION_MARK_HABIT_2
    DESKTOP_TRAY_ACTION_MARK_HABIT_3
    DESKTOP_TRAY_ACTION_MARK_HABIT_4
    DESKTOP_TRAY_ACTION_MARK_HABIT_5
    DESKTOP_TRAY_ACTION_MARK_HABIT_6
    DESKTOP_TRAY_ACTION_MARK_HABIT_7
    DESKTOP_TRAY_ACTION_MARK_HABIT_8
    DESKTOP_TRAY_ACTION_MARK_HABIT_9
    DESKTOP_TRAY_ACTION_BREAK_REST_NOW
    DESKTOP_TRAY_ACTION_BREAK_MODE_NORMAL
    DESKTOP_TRAY_ACTION_BREAK_MODE_QUIET
    DESKTOP_TRAY_ACTION_BREAK_MODE_SUSPENDED
    DESKTOP_TRAY_ACTION_BREAK_READING_TOGGLE
    DESKTOP_TRAY_ACTION_BREAK_SETTINGS
}

#import "desktop_tray.h"
#import "kryon.h"

#if #defined(DESKTOP_TRAY_ENABLED) {
    #import "app.h"
    #import "breaks/app_breaks.h"
    #import "habits_screen.h"
    #import "practices/patterns/patterns_practice.h"
    #import "practices/practice_registry.h"
    #import "practices/sun_salutation/sun_salutation_practice.h"
    #import <stdio.h>
    #import <string.h>
    AppTraySnapshot :: struct {
        window_visible: int
        count: int
        break_mode: int
        break_reading_mode: int
        status_label: [128] char
        show_hide_label: [96] char
        start_practice_label: [96] char
        habits_label: [96] char
        quit_label: [96] char
        whm_label: [96] char
        meditation_label: [96] char
        sun_salutation_label: [96] char
        patterns_label: [96] char
        break_label: [96] char
        break_rest_now_label: [96] char
        break_mode_label: [96] char
        break_mode_normal_label: [96] char
        break_mode_quiet_label: [96] char
        break_mode_suspended_label: [96] char
        break_reading_label: [96] char
        break_settings_label: [96] char
        habit_labels: [HABIT_MAX] [128] char
        habit_indices: [HABIT_MAX] int
        habit_enabled: [HABIT_MAX] int
    }
    static app_tray_snapshot: AppTraySnapshot
    static TrayReady: int
    static TrayNextStatusUpdateTime: double
    static TrayStatusUpdateInitialized: int
    static TrayLastWindowVisible: int = -1
    static TrayLastStatusText: [128] char
    static TrayIconPaths: [5] const char* const = {
        "inbe.png",
        "packaging/linux/appimage/inbe.png",
        "packaging/snap/snap/gui/inbe.png",
        "web-assets/icons/inbe.png",
        nil
    }
    GetTrayHabitAction :: (index: int) -> DesktopTrayAction #private {
        if index < 0 || index >= HABIT_MAX {
            return DESKTOP_TRAY_ACTION_NONE
        }
        return (DesktopTrayAction)(DESKTOP_TRAY_ACTION_MARK_HABIT_0 + index)
    }
    GetTrayHabitIndex :: (action: DesktopTrayAction) -> int #private {
        if action < DESKTOP_TRAY_ACTION_MARK_HABIT_0 ||
        action > DESKTOP_TRAY_ACTION_MARK_HABIT_9 {
            return -1
        }
        return (int)(action - DESKTOP_TRAY_ACTION_MARK_HABIT_0)
    }
    GetTrayWindowLabelKey :: (visible: int) -> const char* #private {
        return visible ? "tray_hide_inner_breeze" : "tray_show_inner_breeze"
    }
    GetTrayWindowAction :: (visible: int) -> DesktopTrayAction #private {
        return visible ? DESKTOP_TRAY_ACTION_HIDE : DESKTOP_TRAY_ACTION_SHOW
    }
    TraySunSalutationStepSeconds :: (app: const InnerBreeze*) -> int #private {
        start_seconds: int
        end_seconds: int
        repetitions: int
        repetition: int
        if app == nil {
            return SUN_SALUTATION_DEFAULT_START_SECONDS
        }
        start_seconds = app->sun_salutation.start_seconds
        end_seconds = app->sun_salutation.end_seconds
        repetitions = app->sun_salutation.repetitions
        repetition = app->sun_salutation.repetition
        if start_seconds < SUN_SALUTATION_SECONDS_MIN ||
        start_seconds > SUN_SALUTATION_SECONDS_MAX {
            start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
        }
        if end_seconds < SUN_SALUTATION_SECONDS_MIN ||
        end_seconds > SUN_SALUTATION_SECONDS_MAX {
            end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
        }
        if start_seconds < end_seconds {
            end_seconds = start_seconds
        }
        if repetitions < 2 {
            return start_seconds
        }
        if repetition < 0 {
            repetition = 0
        }
        if repetition >= repetitions {
            repetition = repetitions - 1
        }
        return start_seconds + ((end_seconds - start_seconds) * repetition) /
        (repetitions - 1)
    }
    BuildTrayStatusText :: (app: InnerBreeze*, text: char*, text_size: size_t) #private {
        if text == nil || text_size == 0 {
            return
        }
        snprintf(text, text_size, "Inner Breeze")
        if app == nil {
            return
        }
        if app->breathing.screen == ScreenSession {
            count: int = int_from_count(app->breathing.count)
            max_breaths: int = int_from_count(app->breathing.maxbreaths)
            if app->session_paused {
                snprintf(text, text_size, "%s", GetLocaleText("tray_wim_hof_paused"))
            } else {
                switch app->breathing.phase {
                    case BreathPhaseBreathe:
                    FormatLocaleText(text, text_size, "tray_wim_hof_breath",
                    count, max_breaths)
                    break
                    case BreathPhaseHold:
                    FormatLocaleText(text, text_size, "tray_wim_hof_hold", count)
                    break
                    case BreathPhaseRecover:
                    count = 15 - count
                    if count < 0 {
                        count = 0
                    }
                    FormatLocaleText(text, text_size, "tray_wim_hof_breathe_in",
                    count)
                    break
                    case BreathPhaseNext:
                    snprintf(text, text_size, "%s", GetLocaleText("tray_wim_hof_next_round"))
                    break
                    case BreathPhaseStarting:

                    default:
                    {
                        pause: int = app->breathing.round == 0 ? 3 : app->breathing.pause_seconds
                        remaining: int = pause > 0 ? pause - app->breathing.sectick / 60 : 0
                        if remaining < 0 {
                            remaining = 0
                        }
                        FormatLocaleText(text, text_size,
                        "tray_wim_hof_starting_seconds",
                        remaining)
                    }
                    break
                }
            }
        } else if app->breathing.screen == ScreenMeditation {
            remaining: int = app->meditation.remaining_seconds
            if remaining < 0 {
                remaining = 0
            }
            FormatLocaleText(text, text_size,
            app->session_paused ? "tray_meditation_paused"
            : "tray_meditation_left",
            remaining / 60, remaining % 60)
        } else if app->breathing.screen == ScreenSunSalutation {
            step_seconds: int = TraySunSalutationStepSeconds(app)
            elapsed: int = app->sun_salutation.step_ticks / 60
            if elapsed < 0 {
                elapsed = 0
            }
            if elapsed > step_seconds {
                elapsed = step_seconds
            }
            FormatLocaleText(text, text_size,
            app->session_paused ? "tray_sun_salutation_paused"
            : "tray_sun_salutation",
            sun_salutation_step_label(app->sun_salutation.step),
            app->sun_salutation.repetition + 1,
            app->sun_salutation.repetitions,
            elapsed,
            step_seconds)
        } else if app->breathing.screen == ScreenPatterns && app->patterns.active {
            phase: int = app->patterns.phase
            left: int = patterns_phase_remaining_seconds(app)
            session_time: int
            if app->patterns.duration_minutes > 0 {
                session_time = app->patterns.duration_minutes * 60 -
                app->patterns.elapsed_seconds
                if session_time < 0 {
                    session_time = 0
                }
                FormatLocaleText(text, text_size,
                app->patterns.paused ? "tray_patterns_left_paused"
                : "tray_patterns_left",
                GetLocaleText(patterns_phase_label_key(phase)),
                left, session_time / 60, session_time % 60)
            } else {
                session_time = app->patterns.elapsed_seconds
                if session_time < 0 {
                    session_time = 0
                }
                FormatLocaleText(text, text_size,
                app->patterns.paused ? "tray_patterns_elapsed_paused"
                : "tray_patterns_elapsed",
                GetLocaleText(patterns_phase_label_key(phase)),
                left, session_time / 60, session_time % 60)
            }
        } else if app->breaks_enabled {
            if app->breaks.mode == BreakModeSuspended {
                snprintf(text, text_size, "%s", GetLocaleText("settings_breaks_mode_suspended"))
            } else if app->breaks.mode == BreakModeQuiet {
                snprintf(text, text_size, "%s", GetLocaleText("settings_breaks_mode_quiet"))
            } else {
                next_break: int = -1
                for int t = 0; t < BREAK_TYPE_COUNT; t++ {
                    due: int = break_timer_next_due_s(&app->breaks, t)
                    if due > 0 && (next_break < 0 || due < next_break) {
                        next_break = due
                    }
                }
                if next_break > 0 {
                    due: [16] char
                    break_format_duration(due, sizeof(due), next_break)
                    FormatLocaleText(text, text_size, "tray_next_break", due)
                }
            }
        }
    }
    FillTraySnapshotLabels :: (snapshot: AppTraySnapshot*) #private {
        if snapshot == nil {
            return
        }
        snprintf(snapshot->show_hide_label, sizeof(snapshot->show_hide_label), "%s",
        GetLocaleText(GetTrayWindowLabelKey(snapshot->window_visible)))
        snprintf(snapshot->start_practice_label, sizeof(snapshot->start_practice_label), "%s",
        GetLocaleText("tray_start_practice"))
        snprintf(snapshot->habits_label, sizeof(snapshot->habits_label), "%s",
        GetLocaleText("tray_mark_complete"))
        snprintf(snapshot->quit_label, sizeof(snapshot->quit_label), "%s",
        GetLocaleText("tray_quit_inner_breeze"))
        snprintf(snapshot->whm_label, sizeof(snapshot->whm_label), "%s",
        GetLocaleText("exercise_wim_hof"))
        snprintf(snapshot->meditation_label, sizeof(snapshot->meditation_label), "%s",
        GetLocaleText("exercise_meditation"))
        snprintf(snapshot->sun_salutation_label, sizeof(snapshot->sun_salutation_label), "%s",
        GetLocaleText("exercise_sun_salutation"))
        snprintf(snapshot->patterns_label, sizeof(snapshot->patterns_label), "%s",
        GetLocaleText("exercise_patterns"))
        snprintf(snapshot->break_label, sizeof(snapshot->break_label), "%s",
        GetLocaleText("settings_tab_breaks"))
        snprintf(snapshot->break_rest_now_label, sizeof(snapshot->break_rest_now_label), "%s",
        GetLocaleText("settings_breaks_rest_now"))
        snprintf(snapshot->break_mode_label, sizeof(snapshot->break_mode_label), "%s",
        GetLocaleText("settings_breaks_mode"))
        snprintf(snapshot->break_mode_normal_label, sizeof(snapshot->break_mode_normal_label), "%s",
        GetLocaleText("settings_breaks_mode_normal"))
        snprintf(snapshot->break_mode_quiet_label, sizeof(snapshot->break_mode_quiet_label), "%s",
        GetLocaleText("settings_breaks_mode_quiet"))
        snprintf(snapshot->break_mode_suspended_label, sizeof(snapshot->break_mode_suspended_label), "%s",
        GetLocaleText("settings_breaks_mode_suspended"))
        snprintf(snapshot->break_reading_label, sizeof(snapshot->break_reading_label), "%s",
        GetLocaleText("settings_breaks_reading_mode"))
        snprintf(snapshot->break_settings_label, sizeof(snapshot->break_settings_label), "%s",
        GetLocaleText("tray_break_settings"))
    }
    SeedTraySnapshot :: () #private {
        next: AppTraySnapshot
        app: InnerBreeze* = get_global_app()
        memset(&next, 0, sizeof(next))
        next.window_visible = !IsWindowHidden()
        if app != nil {
            next.break_mode = app->breaks.mode
            next.break_reading_mode = app->breaks.reading_mode
        }
        BuildTrayStatusText(app, next.status_label, sizeof(next.status_label))
        FillTraySnapshotLabels(&next)
        app_tray_snapshot = next
    }
    BuildTrayMenu :: (snapshot: const AppTraySnapshot*, items: DesktopTrayMenuItem*, item_count: int, start_items: DesktopTrayMenuItem*, start_item_count: int, habit_items: DesktopTrayMenuItem*, habit_item_count: int, break_items: DesktopTrayMenuItem*, break_item_count: int, break_mode_items: DesktopTrayMenuItem*, break_mode_item_count: int) -> int #private {
        local_snapshot: AppTraySnapshot
        item_index: int = 0
        if items == nil || item_count < 7 ||
        start_items == nil || start_item_count < 4 ||
        habit_items == nil || habit_item_count < HABIT_MAX ||
        break_items == nil || break_item_count < 4 ||
        break_mode_items == nil || break_mode_item_count < 3 {
            return 0
        }
        memset(&local_snapshot, 0, sizeof(local_snapshot))
        FillTraySnapshotLabels(&local_snapshot)
        if snapshot != nil {
            local_snapshot = *snapshot
        }
        start_items[0] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.whm_label,
            .action = DESKTOP_TRAY_ACTION_START_WHM,
            .enabled = 1
        }
        start_items[1] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.meditation_label,
            .action = DESKTOP_TRAY_ACTION_START_MEDITATION,
            .enabled = 1
        }
        start_items[2] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.sun_salutation_label,
            .action = DESKTOP_TRAY_ACTION_START_SUN_SALUTATION,
            .enabled = 1
        }
        start_items[3] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.patterns_label,
            .action = DESKTOP_TRAY_ACTION_START_PATTERNS,
            .enabled = 1
        }
        for int i = 0; i < local_snapshot.count && i < HABIT_MAX &&
        i < 10; i++ {
            habit_items[i] = (DesktopTrayMenuItem){
                .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
                .label = local_snapshot.habit_labels[i],
                .action = GetTrayHabitAction(i),
                .enabled = local_snapshot.habit_enabled[i]
            }
        }
        break_mode_items[0] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_mode_normal_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_MODE_NORMAL,
            .enabled = local_snapshot.break_mode != BreakModeNormal
        }
        break_mode_items[1] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_mode_quiet_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_MODE_QUIET,
            .enabled = local_snapshot.break_mode != BreakModeQuiet
        }
        break_mode_items[2] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_mode_suspended_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_MODE_SUSPENDED,
            .enabled = local_snapshot.break_mode != BreakModeSuspended
        }
        break_items[0] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_rest_now_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_REST_NOW,
            .enabled = 1
        }
        break_items[1] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
            .label = local_snapshot.break_mode_label,
            .enabled = 1,
            .children = break_mode_items,
            .child_count = 3
        }
        break_items[2] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_reading_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_READING_TOGGLE,
            .enabled = 1
        }
        break_items[3] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.break_settings_label,
            .action = DESKTOP_TRAY_ACTION_BREAK_SETTINGS,
            .enabled = 1
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.status_label[0] != '\0'
            ? local_snapshot.status_label
            : "Inner Breeze",
            .enabled = 0
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SEPARATOR
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
            .label = local_snapshot.start_practice_label,
            .enabled = 1,
            .children = start_items,
            .child_count = 4
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
            .label = local_snapshot.habits_label,
            .enabled = local_snapshot.count > 0,
            .children = habit_items,
            .child_count = local_snapshot.count
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
            .label = local_snapshot.break_label,
            .enabled = 1,
            .children = break_items,
            .child_count = 4
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_SEPARATOR
        }
        items[item_index++] = (DesktopTrayMenuItem){
            .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
            .label = local_snapshot.quit_label,
            .action = DESKTOP_TRAY_ACTION_QUIT,
            .enabled = 1
        }
        return item_index
    }
    ApplyTrayMenuSnapshot :: (snapshot: const AppTraySnapshot*) #private {
        items: [7] DesktopTrayMenuItem
        start_items: [4] DesktopTrayMenuItem
        habit_items: [HABIT_MAX] DesktopTrayMenuItem
        break_items: [4] DesktopTrayMenuItem
        break_mode_items: [3] DesktopTrayMenuItem
        count: int
        memset(items, 0, sizeof(items))
        memset(start_items, 0, sizeof(start_items))
        memset(habit_items, 0, sizeof(habit_items))
        memset(break_items, 0, sizeof(break_items))
        memset(break_mode_items, 0, sizeof(break_mode_items))
        count = BuildTrayMenu(snapshot, items, 7, start_items, 4,
        habit_items, HABIT_MAX,
        break_items, 4, break_mode_items, 3)
        SetDesktopTrayMenu(items, count)
        SetDesktopTrayActivateAction(GetTrayWindowAction(snapshot != nil
        ? snapshot->window_visible
        : !IsWindowHidden()))
    }
    desktop_tray_init :: () -> int #export {
        spec: DesktopTraySpec
        items: [7] DesktopTrayMenuItem
        start_items: [4] DesktopTrayMenuItem
        habit_items: [HABIT_MAX] DesktopTrayMenuItem
        break_items: [4] DesktopTrayMenuItem
        break_mode_items: [3] DesktopTrayMenuItem
        item_count: int
        # APP_NO_TRAY = 1 skips the tray entirely. With the lazy-GTK tray build
        # this also keeps libgtk-3 and its dependency chain out of the process;
        # closing or minimizing the window then quits instead of hiding.
        if getenv("APP_NO_TRAY") != nil {
            return 0
        }
        SeedTraySnapshot()
        memset(items, 0, sizeof(items))
        memset(start_items, 0, sizeof(start_items))
        memset(habit_items, 0, sizeof(habit_items))
        memset(break_items, 0, sizeof(break_items))
        memset(break_mode_items, 0, sizeof(break_mode_items))
        item_count = BuildTrayMenu(&app_tray_snapshot, items, 7, start_items, 4,
        habit_items, HABIT_MAX,
        break_items, 4, break_mode_items, 3)
        memset(&spec, 0, sizeof(spec))
        spec.id = "inbe"
        spec.title = "Inner Breeze"
        spec.icon_name = "inbe"
        spec.icon_paths = TrayIconPaths
        spec.close_action = DESKTOP_TRAY_ACTION_CLOSE_REQUEST
        spec.activate_action = GetTrayWindowAction(app_tray_snapshot.window_visible)
        spec.menu_items = items
        spec.menu_item_count = item_count
        TrayReady = InitDesktopTray(&spec)
        return TrayReady
    }
    desktop_tray_shutdown :: () #export {
        ShutdownDesktopTray()
        TrayReady = 0
    }
    desktop_tray_poll_action :: () -> DesktopTrayAction #export {
        return (DesktopTrayAction)PollDesktopTrayAction()
    }
    desktop_tray_ready :: () -> int #export {
        return TrayReady && IsDesktopTrayVisible()
    }
    RestoreTrayWindow :: () #private {
        ClearWindowState(FLAG_WINDOW_HIDDEN)
        RestoreWindow()
    }
    HideTrayWindow :: () #private {
        if !desktop_tray_ready() {
            return
        }
        # The window vanishing with the process still running is the single
        # most confusing failure mode this app has; always say why it hid.
        TraceLog(LOG_INFO, "APP: hiding main window (tray action)")
        SetWindowState(FLAG_WINDOW_HIDDEN)
    }
    desktop_tray_keep_running :: () -> int #export {
        if !desktop_tray_ready() {
            return 0
        }
        HideTrayWindow()
        return 1
    }
    StartTrayPractice :: (app: InnerBreeze*, practice_id: int) #private {
        practice: const PracticeDefinition*
        if app == nil {
            return
        }
        app->exercise_type = practice_clamp_id(practice_id)
        app->main_tab = APP_MAIN_TAB_PRACTICE
        app->practice_tab = PRACTICE_TAB_PLAY
        if app->modal.active {
            app_close_modal(app)
        }
        RestoreTrayWindow()
        practice = practice_get(app->exercise_type)
        if practice->start != nil {
            practice->start(app)
        }
    }
    MarkTrayHabit :: (app: InnerBreeze*, index: int) #private {
        today: int
        habit: Habit*
        if app == nil || index < 0 || index >= app->habits.count ||
        index >= HABIT_MAX {
            return
        }
        today = habits_today_index()
        habit = &app->habits.items[index]
        if habit->counter_enabled {
            habit_set_day_count(&app->habits, index, today,
            habit_day_count(habit, today) + 1)
        } else {
            habit_set_day(&app->habits, index, today, 1)
        }
    }
    UpdateTrayMenuSnapshot :: (app: InnerBreeze*) #private {
        next: AppTraySnapshot
        today: int
        if app == nil {
            return
        }
        memset(&next, 0, sizeof(next))
        next.window_visible = !IsWindowHidden()
        next.break_mode = app->breaks.mode
        next.break_reading_mode = app->breaks.reading_mode
        BuildTrayStatusText(app, next.status_label, sizeof(next.status_label))
        FillTraySnapshotLabels(&next)
        today = habits_today_index()
        for int i = 0; i < app->habits.count && i < HABIT_MAX &&
        next.count < HABIT_MAX; i++ {
            habit: Habit* = &app->habits.items[i]
            count: int = habit_day_count(habit, today)
            completed: int = habit_completed_day(habit, today) || count > 0
            if completed {
                continue
            }
            snprintf(next.habit_labels[next.count], sizeof(next.habit_labels[next.count]),
            "%s", habit->name)
            next.habit_indices[next.count] = i
            next.habit_enabled[next.count] = 1
            next.count++
        }
        if memcmp(&app_tray_snapshot, &next, sizeof(next)) != 0 {
            app_tray_snapshot = next
            ApplyTrayMenuSnapshot(&app_tray_snapshot)
        }
    }
    desktop_tray_apply_action :: (app: InnerBreeze*, action: DesktopTrayAction, quit: int*) #export {
        habit_index: int = GetTrayHabitIndex(action)
        if habit_index >= 0 {
            if habit_index < app_tray_snapshot.count {
                MarkTrayHabit(app, app_tray_snapshot.habit_indices[habit_index])
            }
            return
        }
        switch action {
            case DESKTOP_TRAY_ACTION_SHOW:
            RestoreTrayWindow()
            break
            case DESKTOP_TRAY_ACTION_HIDE:
            HideTrayWindow()
            break
            case DESKTOP_TRAY_ACTION_MINIMIZE:
            MinimizeWindow()
            break
            case DESKTOP_TRAY_ACTION_CLOSE_REQUEST:
            app_request_desktop_close(app)
            break
            case DESKTOP_TRAY_ACTION_START_WHM:
            StartTrayPractice(app, PRACTICE_WHM)
            break
            case DESKTOP_TRAY_ACTION_START_MEDITATION:
            StartTrayPractice(app, PRACTICE_MEDITATION)
            break
            case DESKTOP_TRAY_ACTION_START_SUN_SALUTATION:
            StartTrayPractice(app, PRACTICE_SUN_SALUTATION)
            break
            case DESKTOP_TRAY_ACTION_START_PATTERNS:
            StartTrayPractice(app, PRACTICE_PATTERNS)
            break
            case DESKTOP_TRAY_ACTION_QUIT:
            if quit != nil {
                *quit = 1
            }
            break
            case DESKTOP_TRAY_ACTION_BREAK_REST_NOW:
            if app->breaks_enabled {
                app_breaks_rest_break_now(app)
            }
            break
            case DESKTOP_TRAY_ACTION_BREAK_MODE_NORMAL:
            app_breaks_set_mode(app, BreakModeNormal, 0)
            break
            case DESKTOP_TRAY_ACTION_BREAK_MODE_QUIET:
            app_breaks_set_mode(app, BreakModeQuiet, 0)
            break
            case DESKTOP_TRAY_ACTION_BREAK_MODE_SUSPENDED:
            app_breaks_set_mode(app, BreakModeSuspended, 0)
            break
            case DESKTOP_TRAY_ACTION_BREAK_READING_TOGGLE:
            app->breaks.reading_mode = !app->breaks.reading_mode
            app->settings_dirty = 1
            break
            case DESKTOP_TRAY_ACTION_BREAK_SETTINGS:
            if app->modal.active {
                app_close_modal(app)
            }
            RestoreTrayWindow()
            app->settings_tab = SETTINGS_TAB_BREAKS
            app_switch_screen(app, ScreenSettings)
            break
            case DESKTOP_TRAY_ACTION_NONE:

            default:
            break
        }
    }
    desktop_tray_update_status :: (app: InnerBreeze*) #export {
        text: [128] char
        now: double
        window_visible: int
        if app == nil || !TrayReady {
            return
        }
        now = GetTime()
        window_visible = !IsWindowHidden()
        if TrayStatusUpdateInitialized &&
        window_visible == TrayLastWindowVisible &&
        now < TrayNextStatusUpdateTime {
            return
        }
        UpdateTrayMenuSnapshot(app)
        BuildTrayStatusText(app, text, sizeof(text))
        if !TrayStatusUpdateInitialized ||
        strcmp(TrayLastStatusText, text) != 0 {
            SetDesktopTrayStatus(text)
        }
        snprintf(TrayLastStatusText, sizeof(TrayLastStatusText), "%s", text)
        TrayStatusUpdateInitialized = 1
        TrayLastWindowVisible = window_visible
        TrayNextStatusUpdateTime = now + 1.0
    }
} #else {
    desktop_tray_init :: () -> int #export {
        return 0
    }
    desktop_tray_ready :: () -> int #export {
        return 0
    }
    desktop_tray_shutdown :: () #export {

    }
    desktop_tray_poll_action :: () -> DesktopTrayAction #export {
        return DESKTOP_TRAY_ACTION_NONE
    }
    desktop_tray_apply_action :: (app: InnerBreeze*, action: DesktopTrayAction, quit: int*) #export {
        unused app
        unused action
        unused quit
    }
    desktop_tray_update_status :: (app: InnerBreeze*) #export {
        unused app
    }
    desktop_tray_keep_running :: () -> int #export {
        return 0
    }
}
