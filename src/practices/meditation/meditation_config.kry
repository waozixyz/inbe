#import "app/app"
#import "practices/meditation/meditation_music"
#import "practices/meditation/meditation_practice"
#import "screens/practice_screen"
#import "stdio.h"

meditation_config_preset_count :: () -> int #private {
    return 5
}

meditation_config_duration_height :: (content_w: int) -> int #private {
    columns := content_w >= Scale(520) ? 3 : 2
    count := meditation_config_preset_count() + 1
    rows := (count + columns - 1) / columns

    return Scale(30) + rows * Scale(56) +
           (rows - 1) * Scale(8) +
           Scale(108) + Scale(84) + Scale(18) + Scale(112)
}

meditation_config_content_height :: (app: InnerBreeze*, content_w: int) -> int #private {
    bottom_padding := (practice_screen_subscreen_integrated(app, UIModalPracticeConfig)
                           ? app_content_bottom_reserved(app)
                           : 0) +
                      Scale(24)

    return meditation_config_duration_height(content_w) +
           meditation_music_measure_practice_settings(app, EXERCISE_MEDITATION,
                                                      content_w, 0, 1) +
           bottom_padding
}

meditation_config_save :: (app: InnerBreeze*) #private {
    if app == NULL {
        return
    }
    app->settings_dirty = 1
    save_settings(app)
}

meditation_config_draw_duration :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    labels: [6] const char* = {
        GetLocaleText("duration_5m"),
        GetLocaleText("duration_15m"),
        GetLocaleText("duration_30m"),
        GetLocaleText("duration_1h"),
        GetLocaleText("duration_2h"),
        GetLocaleText("meditation_duration_custom")
    }
    adjust_labels: [4] const char* = {"-5", "-1", "+1", "+5"}
    adjust_values: [4] const int = {-5, -1, 1, 5}
    mode := 0
    columns := 0
    gap := Scale(8)
    btn_h := Scale(48)
    btn_w := 0
    row_y := 0
    custom_row_y := 0
    toggle_value := 0

    custom_text: [64] char = {0}

    if app == NULL || y == NULL {
        return
    }

    mode = clampi(app->meditation.duration_mode, 0, meditation_config_preset_count())
    app->meditation.duration_mode = mode
    app->meditation.custom_minutes = clampi(app->meditation.custom_minutes, 1, 240)

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("meditation_duration_setting")),
        .wrap=TextWrapNone
    })
    *y += Scale(30)

    columns = w >= Scale(520) ? 3 : 2
    btn_w = (w - gap * (columns - 1)) / columns
    for int i = 0; i < meditation_config_preset_count() + 1; i++ {
        col := i % columns
        row := i / columns
        bx := x + col * (btn_w + gap)
        by := *y + row * (btn_h + gap)
        style := i == mode ? ButtonToneAccent : ButtonToneNeutral

        if Button((ButtonProps){
            .bounds = {(float)(bx), (float)(by), (float)(btn_w), (float)(btn_h)},
            .label = labels[i],
            .tone = style,
            .emphasis = (style) == ButtonToneAccent ? ButtonEmphasisFilled : ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app->meditation.duration_mode = i
            meditation_config_save(app)
        }
    }

    row_y = *y + ((meditation_config_preset_count() + 1 + columns - 1) / columns) *
                 (btn_h + gap)
    *y = row_y + Scale(8)

    custom_row_y = *y
    snprintf(custom_text, sizeof(custom_text), "%s: %d min",
                GetLocaleText("meditation_custom_minutes"),
                app->meditation.custom_minutes)
    Text((TextProps){
        .bounds={(x), (custom_row_y), 0, 0},
        .text=(custom_text),
        .wrap=TextWrapNone
    })

    adjust_w := Scale(50)
    adjust_total := adjust_w * 4 + gap * 3
    adjust_x := x + (w - adjust_total) / 2
    adjust_y := custom_row_y + Scale(34)

    for int i = 0; i < 4; i++ {
        if Button((ButtonProps){
            .bounds = {(float)(adjust_x + i * (adjust_w + gap)), (float)(adjust_y), (float)(adjust_w), (float)(btn_h)},
            .label = adjust_labels[i],
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app->meditation.custom_minutes =
                clampi(app->meditation.custom_minutes + adjust_values[i], 1, 240)
            app->meditation.duration_mode = meditation_config_preset_count()
            meditation_config_save(app)
        }
    }
    *y += Scale(108)

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("meditation_extend_controls_label")),
        .wrap=TextWrapNone
    })
    toggle_value = app->meditation.show_extend_controls
    if Toggle((ToggleProps){.id = 0,
        .bounds = {x, *y + Scale(26), Scale(56), Scale(30)},
        .value = &toggle_value, .off_label = GetLocaleText("toggle_off"),
        .on_label = GetLocaleText("toggle_on")}) {
        app->meditation.show_extend_controls = toggle_value
        meditation_config_save(app)
    }
    *y += Scale(84)

    # interval bell: a soft bell every N minutes (0 = off)
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("meditation_interval_bell_label")),
        .wrap=TextWrapNone
    })
    bell_labels: [7] const char* = {
        GetLocaleText("meditation_interval_bell_off"),
        "1", "2", "5", "10", "15", "30"
    }
    bell_values: [7] const int = {0, 1, 2, 5, 10, 15, 30}
    bell_selected := 0
    for int i = 0; i < 7; i++ {
        if app->meditation.interval_bell_minutes == bell_values[i] {
            bell_selected = i
        }
    }
    bell_columns := w >= Scale(460) ? 7 : 4
    bell_w := (w - gap * (bell_columns - 1)) / bell_columns
    if bell_w > Scale(72) {
        bell_w = Scale(72)
    }
    for int i = 0; i < 7; i++ {
        bx := x + (i % bell_columns) * (bell_w + gap)
        by := *y + Scale(26) + (i / bell_columns) * (btn_h + gap)
        style := i == bell_selected ? ButtonToneAccent : ButtonToneNeutral
        if Button((ButtonProps){
            .bounds = {(float)(bx), (float)(by), (float)(bell_w), (float)(btn_h)},
            .label = bell_labels[i],
            .tone = style,
            .emphasis = (style) == ButtonToneAccent ? ButtonEmphasisFilled : ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app->meditation.interval_bell_minutes = bell_values[i]
            meditation_config_save(app)
        }
    }
    bell_rows := (7 + bell_columns - 1) / bell_columns
    *y += Scale(26) + bell_rows * btn_h +
          (bell_rows - 1) * gap + Scale(12)
}

meditation_config_screen_draw :: (app: InnerBreeze*) {
    layout := (PracticeSubscreenLayout){0}
    side_padding := GetPageSidePadding()
    max_content_w := Scale(CONTENT_MAX_W)
    content_x := 0
    content_w := 0
    y: int

    app->practice_config_tab = 0

    practice_screen_config_layout(app, UIModalPracticeConfig, Scale(18), &layout)
    practice_screen_handle_config_title(app, GetLocaleText("practice_configure_button"),
                                           UIModalPracticeConfig,
                                           meditation_practice_leave_config)

    if max_content_w > view_width - side_padding * 2 {
        max_content_w = view_width - side_padding * 2
    }
    if max_content_w < Scale(320) {
        max_content_w = Scale(320)
    }
    GetCenteredColumn(max_content_w, side_padding, &content_x, &content_w)
    content_h := meditation_config_content_height(app, content_w)

    Scroll page: {
        bounds = (Rectangle){(float)0, (float)layout.scroll_y,
                             (float)view_width, (float)layout.scroll_h}
        content_height = content_h
        scroll_offset = &app->settings_scroll

        y := (int)page.y
        meditation_config_draw_duration(app, content_x, content_w, &y)
        meditation_music_draw_practice_settings(app, EXERCISE_MEDITATION,
                                                content_x, content_w,
                                                &y, 0, 1)
    }
}
