#import "app.h"
#import "practices/meditation/meditation_practice.h"
#import "screens/manual_screen.h"
#import "screens/practice_screen.h"

#enum {
    MEDITATION_MANUAL_PAGES = 2
}

MeditationManualPageContext :: struct {
    page: int
}

meditation_manual_start :: (app: InnerBreeze*) #private {
    mark_exercise_manual_seen(app, EXERCISE_MEDITATION)
    app->tutorial_step = 0
    app->manual_scroll = 0
    app->practice_tab = PRACTICE_TAB_PLAY
    meditation_practice_start(app)
}

meditation_manual_close :: (app: InnerBreeze*, mark_seen: int) {
    if app == NULL {
        return
    }
    if mark_seen {
        mark_exercise_manual_seen(app, EXERCISE_MEDITATION)
    }
    if app->modal.active && app->modal.type == UIModalPracticeManual {
        app_close_modal(app)
        return
    }
    app->tutorial_step = 0
    app->manual_scroll = 0
    app->practice_tab = PRACTICE_TAB_PLAY
    app_switch_screen(app, ScreenStart)
}

meditation_manual_paragraph :: (key: const char*, content_w: int) -> ParagraphSpec #private {
    return manual_screen_tutorial_paragraph(GetLocaleText(key), content_w)
}

meditation_manual_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (MeditationManualPageContext*)user_data
    paragraph := meditation_manual_paragraph(
        ctx->page == 0 ? "meditation_manual_intro_text" :
                         "meditation_manual_customize_text", content_w)

    if ctx->page == 0 {
        return Scale(230 + 12 + 54) +
               GetNodeHeight(NodeParagraph(paragraph, 0, 0))
    }
    return Scale(230 + 12 + 54) +
           GetNodeHeight(NodeParagraph(paragraph, 0, 0))
}

meditation_manual_draw_page :: (app: InnerBreeze*, page: UIScrollPage,
                                step: int, y: int*) #private {
    title_key := step == 0 ? "meditation_title" : "practice_configure_button"
    paragraph_key := step == 0 ? "meditation_manual_intro_text" :
                                 "meditation_manual_customize_text"

    hero_y := *y
    hero_h := Scale(230)
    hero := manual_screen_hero_bounds(page.content_x, page.content_w,
                                      hero_y, hero_h)

    if step == 0 {
        TutorialImage(app->meditation.image_1,
                      "practices/meditation/1.png",
                      (int)hero.x, hero_y, (int)hero.width, hero_h)
    } else {
        center_x := page.content_x + page.content_w / 2
        center_y := hero_y + hero_h / 2

        DrawRectangleRounded(hero, 0.08f, 10, GetThemeSurface())
        DrawCircle(center_x, center_y, Scale(68),
                   Fade(GetThemeCircle(), 0.24f))
        DrawCircle(center_x, center_y, Scale(48), GetThemeCircle())
        Text((TextProps){
            .bounds = {(float)(center_x - Scale(48)),
                       (float)(center_y - Scale(48)),
                       (float)Scale(96), (float)Scale(96)},
            .text = GetLocaleText("meditation_title"),
            .color = GetThemeReadableText(GetThemeCircle()),
            .wrap = TextWrapNone,
            .align = TextAlignCenter,
            .vertical_align = TextAlignCenter
        })
    }
    manual_screen_draw_hero_progress(hero, step, MEDITATION_MANUAL_PAGES)
    *y += hero_h + Scale(12)
    manual_screen_draw_guide_header(GetLocaleText(title_key), step,
                                    MEDITATION_MANUAL_PAGES,
                                    page.content_x, y, page.content_w)
    Paragraph(meditation_manual_paragraph(paragraph_key, page.content_w),
              page.content_x, y)
}

meditation_manual_draw :: (app: InnerBreeze*) {
    layout := (PracticeManualLayout){0}
    responsive_max_w := (int)(view_width * 0.96f)
    step := clampi(app->tutorial_step, 0, MEDITATION_MANUAL_PAGES - 1)

    app->tutorial_step = step
    if responsive_max_w > manual_screen_tutorial_max_width() {
        responsive_max_w = manual_screen_tutorial_max_width()
    }
    practice_screen_manual_layout(app, UIModalPracticeManual,
                                  MEDITATION_MANUAL_PAGES,
                                  manual_screen_tutorial_top_gap(), 0,
                                  Scale(120), &layout)
    manual_screen_draw_title_bar(app, GetLocaleText("meditation_manual_title"),
                                 layout.title_h, meditation_manual_close)
    page_ctx := (MeditationManualPageContext){step}
    page := BeginUIScrollPage((UIScrollPageSpec){
        .y = layout.content_y,
        .height = layout.content_h,
        .max_content_width = responsive_max_w,
        .min_content_width = Scale(200),
        .side_padding = manual_screen_tutorial_side_padding(),
        .scroll_offset = &app->manual_scroll,
        .content_height = meditation_manual_content_height,
        .user_data = &page_ctx
    })
    y := page.content_y

    meditation_manual_draw_page(app, page, step, &y)
    EndUIScrollPage(page)

    manual_screen_guide_controls(app, (ManualGuideNav){
        .page = step,
        .page_count = MEDITATION_MANUAL_PAGES,
        .y = layout.nav_y,
        .h = layout.nav_h,
        .content_y = layout.content_y,
        .content_h = layout.content_h,
        .focus_id = 420,
        .start = meditation_manual_start,
        .close = meditation_manual_close
    })
}
