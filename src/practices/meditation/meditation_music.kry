#import "app.h"
#import "locale.h"
#import "miniz.h"
#import "practices/practice_registry.h"
#import "runtime_assets.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "theme.h"
#import "ui.h"
#import "ui_color.h"
#import "ui_text.h"

WEB :: #defined(PLATFORM_WEB)
HAS_DEBUG_LOCAL_ASSETS :: #defined(DEBUG_LOCAL_ASSETS)

MeditationMusicConstants :: enum {
    MEDITATION_MUSIC_TRACK_COUNT = 3
}

MeditationTrack :: struct {
    title: const char*
    file: const char*
}

static tracks: [MEDITATION_MUSIC_TRACK_COUNT] const MeditationTrack = {
    {"Deep Meditation", "Elijah_K/deep-meditation.ogg"},
    {"Path Of Meditation", "Elijah_K/path-of-meditation.ogg"},
    {"Truth Of Silence", "Elijah_K/truth-of-silence.ogg"}
}

static track_options: [MEDITATION_MUSIC_TRACK_COUNT] const char* = {
    "Deep Meditation",
    "Path Of Meditation",
    "Truth Of Silence"
}

practice_mask_all :: () -> int #private {
    return (1 << EXERCISE_COUNT) - 1
}

sanitize_practice_music :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    app->meditation.music_practice_mask &= practice_mask_all()
    for int i = 0; i < EXERCISE_COUNT; i++ {
        if app->meditation.music_practice_tracks[i] < 0 ||
           app->meditation.music_practice_tracks[i] >= MEDITATION_MUSIC_TRACK_COUNT {
            app->meditation.music_practice_tracks[i] = 0
        }
    }
    if app->meditation.music_track < 0 ||
       app->meditation.music_track >= MEDITATION_MUSIC_TRACK_COUNT {
        app->meditation.music_track = 0
    }
}

audio_file_looks_valid :: (path: const char*) -> int #private {
    file: FILE*
    magic: [4] unsigned char
    got: size_t

    if path == nil || path[0] == '\0' {
        return 0
    }

    file = fopen(path, "rb")
    if file == nil {
        return 0
    }

    got = fread(magic, 1, sizeof(magic), file)
    fclose(file)
    return got == sizeof(magic) &&
           magic[0] == 'O' && magic[1] == 'g' &&
           magic[2] == 'g' && magic[3] == 'S'
}

safe_archive_member :: (path: const char*) -> int #private {
    if path == nil || path[0] == '\0' {
        return 0
    }
    if path[0] == '/' || strstr(path, "..") != nil {
        return 0
    }
    return 1
}

known_track_archive_member :: (path: const char*) -> int #private {
    if path == nil {
        return 0
    }

    for int i = 0; i < MEDITATION_MUSIC_TRACK_COUNT; i++ {
        if strcmp(path, tracks[i].file) == 0 {
            return 1
        }
    }
    return 0
}

copy_text_checked :: (out: char*, out_size: size_t, text: const char*) -> int #private {
    len: size_t

    if out == nil || out_size == 0 {
        return 0
    }
    if text == nil {
        text = ""
    }

    len = strlen(text)
    if len >= out_size {
        out[0] = '\0'
        return 0
    }

    memcpy(out, text, len + 1)
    return 1
}

join_path2 :: (out: char*, out_size: size_t,
              base: const char*, suffix: const char*) -> int #private {
    base_len: size_t
    suffix_len: size_t

    if out == nil || out_size == 0 || base == nil || suffix == nil {
        return 0
    }

    base_len = strlen(base)
    suffix_len = strlen(suffix)
    if base_len + suffix_len >= out_size {
        out[0] = '\0'
        return 0
    }

    memcpy(out, base, base_len)
    memcpy(out + base_len, suffix, suffix_len + 1)
    return 1
}

append_text_checked :: (out: char*, out_size: size_t, suffix: const char*) -> int #private {
    base_len: size_t
    suffix_len: size_t

    if out == nil || out_size == 0 || suffix == nil {
        return 0
    }

    base_len = strlen(out)
    suffix_len = strlen(suffix)
    if base_len + suffix_len >= out_size {
        out[0] = '\0'
        return 0
    }

    memcpy(out + base_len, suffix, suffix_len + 1)
    return 1
}

set_status :: (app: InbeApp*, message: const char*) #private {
    if app == nil {
        return
    }
    copy_text_checked(app->meditation.music_status,
                         sizeof(app->meditation.music_status),
                         message)
}

missing_audio_message :: () -> const char* #private {
    return "Download audio before playing music"
}

is_network_download_error :: (download: const RuntimeAssetDownload*) -> int #private {
    error: const char*

    if download == nil {
        return 0
    }
    error = download->error
    if error == nil || error[0] == '\0' {
        return 0
    }

    if strcmp(error, "NETWORK_UNAVAILABLE") == 0 {
        return 1
    }
    if strstr(error, "Unable to resolve host") != nil ||
       strstr(error, "No address associated with hostname") != nil ||
       strstr(error, "Could not resolve host") != nil ||
       strstr(error, "Couldn't resolve host") != nil ||
       strstr(error, "Name or service not known") != nil ||
       strstr(error, "Temporary failure in name resolution") != nil {
        return 1
    }
    return 0
}

format_download_status :: (out: char*, out_size: size_t,
                          download: const RuntimeAssetDownload*) #private {
    percent: int

    if out == nil || out_size == 0 || download == nil {
        return
    }

    if download->status == RUNTIME_ASSET_DOWNLOADING &&
       download->total_bytes > 0 {
        percent = (int)((download->bytes * 100u) / download->total_bytes)
        if percent < 0 {
            percent = 0
        }
        if percent > 100 {
            percent = 100
        }
        FormatLocaleText(out, out_size, "meditation_music_downloading_progress", percent)
        return
    }

    snprintf(out, out_size, "%s", GetLocaleText("meditation_music_downloading"))
}

draw_download_progress :: (app: InbeApp*, x: int, y: int, w: int) #private {
    download: RuntimeAssetDownload*
    bar_h := ScaleUIPx(10)
    fill_w := 0
    bg := GetThemeBackground()
    button := GetThemeButton()

    if app == nil || w <= 0 {
        return
    }

    download = &app->meditation.music_download
    if download->status != RUNTIME_ASSET_DOWNLOADING {
        return
    }

    if download->total_bytes > 0 {
        fill_w = (int)((download->bytes * (size_t)w) / download->total_bytes)
    }
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }

    DrawRectangle(x, y, w, bar_h, DarkenUIColor(bg, 28))
    DrawUIBevel(x, y, w, bar_h, DarkenUIColor(bg, 55), LightenUIColor(bg, 35))
    if fill_w > 0 {
        inner_w := fill_w - ScaleUIPx(4)

        if inner_w < ScaleUIPx(2) {
            inner_w = ScaleUIPx(2)
        }
        DrawRectangle(x + ScaleUIPx(2),
                         y + ScaleUIPx(2),
                         inner_w,
                         bar_h - ScaleUIPx(4),
                         button)
    }
}

attribution_paragraph :: (content_w: int) -> UIParagraph #private {
    return (UIParagraph){
        .text = GetLocaleText("meditation_music_attribution"),
        .width = content_w,
        .font = UI_TEXT_12,
        .color = DarkenUIColor(GetThemeText(), 34),
    }
}

attribution_height :: (content_w: int) -> int #private {
    if content_w <= 0 {
        return 0
    }
    return GetUIParagraphHeight(attribution_paragraph(content_w))
}

draw_attribution :: (content_x: int, content_w: int, y: int*) #private {
    if y == nil || content_w <= 0 {
        return
    }
    DrawUIParagraph(attribution_paragraph(content_w), content_x, y)
}

archive_path :: (app: InbeApp*, out: char*, out_size: size_t) #private {
    if !join_path2(out,
                   out_size,
                   app->meditation.music_cache_dir,
                   "/inbe-meditation-audio-v1.zip") {
        set_status(app, "Audio cache path is too long")
    }
}

track_path :: (app: InbeApp*, track: int, out: char*, out_size: size_t) #private {
    if track < 0 || track >= MEDITATION_MUSIC_TRACK_COUNT {
        track = 0
    }

    #if HAS_DEBUG_LOCAL_ASSETS {
        snprintf(out,
                    out_size,
                    "unpackaged_assets/audio/%s",
                    tracks[track].file)
        if audio_file_looks_valid(out) {
            return
        }
    }

    if join_path2(out, out_size, app->meditation.music_cache_dir, "/audio/") &&
       append_text_checked(out, out_size, tracks[track].file) &&
       audio_file_looks_valid(out) {
        return
    }

    #if WEB {
        out[0] = '\0'
    } #else {
        snprintf(out,
                    out_size,
                    "unpackaged_assets/audio/%s",
                    tracks[track].file)
    }
}

extract_audio_archive :: (app: InbeApp*, archive_file_path: const char*) -> int #private {
    archive: mz_zip_archive
    file_count: int
    extracted := 0

    memset(&archive, 0, sizeof(archive))
    if !mz_zip_reader_init_file(&archive, archive_file_path, 0) {
        set_status(app, "Failed to open audio archive")
        return 0
    }

    EnsureRuntimeAssetDir(app->meditation.music_cache_dir)
    audio_dir: [FS_PATH_MAX] char
    if join_path2(audio_dir,
                  sizeof(audio_dir),
                  app->meditation.music_cache_dir,
                  "/audio") {
        EnsureRuntimeAssetDir(audio_dir)
    } else {
        set_status(app, "Audio cache path is too long")
    }

    file_count = (int)mz_zip_reader_get_num_files(&archive)
    for int i = 0; i < file_count; i++ {
        stat: mz_zip_archive_file_stat
        out_path: [FS_PATH_MAX] char

        if !mz_zip_reader_file_stat(&archive, i, &stat) {
            continue
        }
        if mz_zip_reader_is_file_a_directory(&archive, i) {
            continue
        }
        if !safe_archive_member(stat.m_filename) {
            continue
        }
        if !known_track_archive_member(stat.m_filename) {
            continue
        }

        if !join_path2(out_path,
                       sizeof(out_path),
                       app->meditation.music_cache_dir,
                       "/audio/") ||
           !append_text_checked(out_path, sizeof(out_path), stat.m_filename) {
            set_status(app, "Audio file path is too long")
            continue
        }

        dir: [FS_PATH_MAX] char
        slash: char*
        if !copy_text_checked(dir, sizeof(dir), out_path) {
            continue
        }
        slash = strrchr(dir, '/')
        if slash != nil {
            *slash = '\0'
            EnsureRuntimeAssetDir(dir)
        }

        if mz_zip_reader_extract_to_file(&archive, i, out_path, 0) {
            if audio_file_looks_valid(out_path) {
                extracted++
            } else {
                remove(out_path)
            }
        }
    }

    mz_zip_reader_end(&archive)
    if extracted != MEDITATION_MUSIC_TRACK_COUNT {
        snprintf(app->meditation.music_status,
                    sizeof(app->meditation.music_status),
                    "Audio archive did not contain usable audio")
        return 0
    }

    snprintf(app->meditation.music_status,
                sizeof(app->meditation.music_status),
                "Installed %d audio files",
                extracted)
    SyncRuntimeAssets()
    return 1
}

meditation_music_available :: (app: InbeApp*) -> int {
    path: [FS_PATH_MAX] char

    if app == nil {
        return 0
    }

    for int i = 0; i < MEDITATION_MUSIC_TRACK_COUNT; i++ {
        track_path(app, i, path, sizeof(path))
        if !audio_file_looks_valid(path) {
            return 0
        }
    }
    return 1
}

meditation_music_selected_label :: (app: InbeApp*) -> const char* {
    track: int

    if app == nil {
        return ""
    }
    track = app->meditation.music_track
    if track < 0 || track >= MEDITATION_MUSIC_TRACK_COUNT {
        track = 0
    }
    return tracks[track].title
}

meditation_music_init :: (app: InbeApp*) {
    if app == nil {
        return
    }

    InitRuntimeAssets("inbe")
    if !GetRuntimeAssetCacheRoot("inbe",
                                 app->meditation.music_cache_dir,
                                 sizeof(app->meditation.music_cache_dir)) {
        snprintf(app->meditation.music_cache_dir,
                    sizeof(app->meditation.music_cache_dir),
                    "runtime-assets")
        EnsureRuntimeAssetDir(app->meditation.music_cache_dir)
    }

    if app->meditation.music_track < 0 ||
       app->meditation.music_track >= MEDITATION_MUSIC_TRACK_COUNT {
        app->meditation.music_track = 0
    }

    if app->meditation.music_status[0] == '\0' {
        if meditation_music_available(app) {
            set_status(app, "Audio installed")
        } else {
            set_status(app, "Audio not installed")
        }
    }
}

meditation_music_unload :: (app: InbeApp*) {
    if app == nil {
        return
    }
    if app->meditation.music_loaded {
        StopMusicStream(app->meditation.music)
        UnloadMusicStream(app->meditation.music)
        app->meditation.music_loaded = 0
    }
    app->meditation.music_playing = 0
    app->meditation.music_test_playing = 0
    app->meditation.music_fade_out_ticks = 0
    app->meditation.music_fade_out_total_ticks = 0
}

meditation_music_stop :: (app: InbeApp*) {
    if app == nil {
        return
    }
    if app->meditation.music_loaded {
        StopMusicStream(app->meditation.music)
    }
    app->meditation.music_playing = 0
    app->meditation.music_test_playing = 0
    app->meditation.music_fade_out_ticks = 0
    app->meditation.music_fade_out_total_ticks = 0
}

meditation_music_fade_out :: (app: InbeApp*) {
    fade_ticks := 180

    if app == nil || !app->meditation.music_loaded ||
       !app->meditation.music_playing {
        return
    }
    if app->meditation.music_fade_out_ticks > 0 {
        return
    }

    app->meditation.music_fade_out_ticks = fade_ticks
    app->meditation.music_fade_out_total_ticks = fade_ticks
}

load_track :: (app: InbeApp*, track: int) -> int #private {
    path: [FS_PATH_MAX] char

    if app == nil {
        return 0
    }
    if !app->audio_ready {
        TraceLog(LOG_ERROR,
                    "AUDIO: Cannot load meditation music because audio device is not ready")
        set_status(app, "Audio device is not ready")
        return 0
    }

    if track < 0 || track >= MEDITATION_MUSIC_TRACK_COUNT {
        track = 0
    }

    meditation_music_unload(app)
    track_path(app, track, path, sizeof(path))
    if !audio_file_looks_valid(path) {
        set_status(app, "Track is not installed")
        return 0
    }

    app->meditation.music = LoadMusicStream(path)
    if app->meditation.music.ctxData == nil {
        TraceLog(LOG_ERROR, "AUDIO: Could not load meditation track: %s", path)
        set_status(app, "Could not load track")
        app->meditation.music_loaded = 0
        return 0
    }

    app->meditation.music_loaded = 1
    app->meditation.music_track = track
    app->meditation.music_fade_out_ticks = 0
    app->meditation.music_fade_out_total_ticks = 0
    SetMusicVolume(app->meditation.music, (float)app->sound_volume / 100.0f)
    TraceLog(LOG_INFO, "AUDIO: Loaded meditation track: %s", path)
    return 1
}

test_track :: (app: InbeApp*) #private {
    track: int

    if app == nil {
        return
    }
    if app->meditation.music_playing {
        meditation_music_unload(app)
        set_status(app, "Test audio stopped")
        return
    }
    if !meditation_music_available(app) {
        set_status(app, missing_audio_message())
        return
    }

    track = app->meditation.music_track
    if track < 0 || track >= MEDITATION_MUSIC_TRACK_COUNT {
        track = 0
    }
    if !load_track(app, track) {
        return
    }

    PlayMusicStream(app->meditation.music)
    if !IsMusicStreamPlaying(app->meditation.music) {
        TraceLog(LOG_ERROR,
                    "AUDIO: PlayMusicStream returned but test music is not playing")
    }
    app->meditation.music_playing = 1
    app->meditation.music_test_playing = 1
    set_status(app, "Playing test audio")
}

meditation_music_start_session :: (app: InbeApp*) {
    track: int
    practice: int

    if app == nil {
        return
    }

    sanitize_practice_music(app)
    practice = practice_clamp_id(app->exercise_type)
    if (app->meditation.music_practice_mask & (1 << practice)) == 0 {
        return
    }
    if !meditation_music_available(app) {
        set_status(app, missing_audio_message())
        return
    }

    track = app->meditation.music_practice_tracks[practice]
    if !load_track(app, track) {
        return
    }
    PlayMusicStream(app->meditation.music)
    if !IsMusicStreamPlaying(app->meditation.music) {
        TraceLog(LOG_ERROR,
                    "AUDIO: PlayMusicStream returned but session music is not playing")
    }
    app->meditation.music_playing = 1
    app->meditation.music_test_playing = 0
}

meditation_music_update :: (app: InbeApp*) {
    archive_file_path: [FS_PATH_MAX] char

    if app == nil {
        return
    }
    if app->meditation.music_test_playing &&
       !((app->inbe.screen == InbeScreenStart &&
          app->practice_tab == PRACTICE_TAB_CONFIG) ||
         app->inbe.screen == InbeScreenPracticeConfig ||
         app->inbe.screen == InbeScreenManual) {
        meditation_music_stop(app)
        return
    }

    if app->meditation.music_download.status == RUNTIME_ASSET_READY &&
       !app->meditation.music_archive_extracted {
        archive_path(app, archive_file_path, sizeof(archive_file_path))
        app->meditation.music_archive_extracted = 1
        if !extract_audio_archive(app, archive_file_path) {
            snprintf(app->meditation.music_download.error,
                        sizeof(app->meditation.music_download.error),
                        "%s",
                        app->meditation.music_status)
            app->meditation.music_download.status = RUNTIME_ASSET_ERROR
        }
    } else if app->meditation.music_download.status == RUNTIME_ASSET_ERROR {
        if is_network_download_error(&app->meditation.music_download) {
            set_status(app, GetLocaleText("meditation_music_network_error_title"))
            if !app->meditation.music_network_error_notified && !app->modal.active {
                app_open_modal(app, UIModalMeditationNetworkError)
                app->meditation.music_network_error_notified = 1
            }
        } else if app->meditation.music_download.error[0] != '\0' {
            set_status(app, app->meditation.music_download.error)
        }
    }

    if app->meditation.music_loaded {
        volume := (float)app->sound_volume / 100.0f

        if app->meditation.music_fade_out_ticks > 0 &&
           app->meditation.music_fade_out_total_ticks > 0 {
            volume *= (float)app->meditation.music_fade_out_ticks /
                      (float)app->meditation.music_fade_out_total_ticks
            app->meditation.music_fade_out_ticks--
            if app->meditation.music_fade_out_ticks <= 0 {
                meditation_music_stop(app)
                return
            }
        }
        SetMusicVolume(app->meditation.music, volume)
        UpdateMusicStream(app->meditation.music)
    }
}

start_download :: (app: InbeApp*) #private {
    archive_file_path: [FS_PATH_MAX] char
    audio_url: const char*

    if app == nil {
        return
    }

    #if WEB {
        audio_url = "web-assets/dl/inbe-meditation-audio-v1.zip"
    } #else {
        audio_url = "https://inbe.waozi.xyz/web-assets/dl/inbe-meditation-audio-v1.zip"
    }

    archive_path(app, archive_file_path, sizeof(archive_file_path))
    app->meditation.music_archive_extracted = 0
    app->meditation.music_network_error_notified = 0
    set_status(app, "Downloading audio...")
    DownloadRuntimeAsset(&app->meditation.music_download,
                            audio_url,
                            archive_file_path)
}

meditation_music_draw_practice_settings :: (app: InbeApp*,
                                               practice: int,
                                               content_x: int,
                                               content_w: int,
                                               y: int*,
                                               show_installed_download: int,
                                               show_status: int) {
    toggle_w := ScaleUIPx(56)
    toggle_h := ScaleUIPx(30)
    button_h := ScaleUIPx(36)
    button_w: int
    hover := 0
    installed: int
    enabled: int
    test_label: const char*
    download_status: [96] char

    if app == nil || y == nil {
        return
    }

    sanitize_practice_music(app)
    practice = practice_clamp_id(practice)
    enabled = (app->meditation.music_practice_mask & (1 << practice)) != 0

    DrawUIText(GetLocaleText("practice_music_enabled_label"),
                  content_x,
                  *y,
                  GetUIFontSize(),
                  GetThemeText())
    if DrawUIToggleSwitch(content_x,
                          *y + ScaleUIPx(26),
                          toggle_w,
                          toggle_h,
                          &enabled,
                          GetLocaleText("toggle_off"),
                          GetLocaleText("toggle_on")) {
        if enabled {
            app->meditation.music_practice_mask |= 1 << practice
        } else {
            app->meditation.music_practice_mask &= ~(1 << practice)
        }
        app->settings_dirty = 1
        meditation_music_unload(app)
    }
    *y += ScaleUIPx(76)

    if !enabled {
        return
    }

    if DrawUIDropdownButton(451 + practice,
                            content_x,
                            *y,
                            content_w,
                            ScaleUIPx(36),
                            track_options,
                            MEDITATION_MUSIC_TRACK_COUNT,
                            &app->meditation.music_practice_tracks[practice]) {
        app->settings_dirty = 1
        app->meditation.music_track =
            app->meditation.music_practice_tracks[practice]
        meditation_music_unload(app)
    }
    *y += ScaleUIPx(48)

    installed = meditation_music_available(app)
    if installed {
        if app->meditation.music_playing {
            test_label = GetLocaleText("meditation_music_stop_test_button")
        } else {
            test_label = GetLocaleText("meditation_music_test_button")
        }
        button_w = MeasureUIText(test_label, GetUIFontSize()) + ScaleUIPx(24)
        if button_w > content_w {
            button_w = content_w
        }
        if DrawUIGenericButton(content_x,
                               *y,
                               button_w,
                               button_h,
                               test_label,
                               UI_BUTTON_STYLE_SECONDARY,
                               0,
                               &hover) {
            app->meditation.music_track =
                app->meditation.music_practice_tracks[practice]
            test_track(app)
        }
        *y += button_h + ScaleUIPx(12)
    }

    if !installed || show_installed_download {
        download_label: const char*

        if installed {
            download_label = GetLocaleText("meditation_music_redownload_button")
        } else {
            download_label = GetLocaleText("meditation_music_download_button")
        }
        button_w = MeasureUIText(download_label, GetUIFontSize()) + ScaleUIPx(24)
        if button_w > content_w {
            button_w = content_w
        }
        if DrawUIGenericButton(content_x,
                               *y,
                               button_w,
                               button_h,
                               download_label,
                               UI_BUTTON_STYLE_PRIMARY,
                               0,
                               &hover) {
            start_download(app)
        }
        *y += button_h + ScaleUIPx(12)
    }

    if show_status &&
       (!installed ||
        app->meditation.music_download.status != RUNTIME_ASSET_IDLE) {
        if app->meditation.music_download.status == RUNTIME_ASSET_DOWNLOADING {
            format_download_status(download_status,
                                      sizeof(download_status),
                                      &app->meditation.music_download)
            DrawUIText(download_status, content_x, *y,
                          GetUIFontSize(), GetThemeText())
            *y += ScaleUIPx(28)
            draw_download_progress(app, content_x, *y, content_w)
            *y += ScaleUIPx(22)
        } else {
            DrawUIText(app->meditation.music_status,
                          content_x,
                          *y,
                          GetUIFontSize(),
                          GetThemeText())
            *y += ScaleUIPx(34)
        }
    }

    draw_attribution(content_x, content_w, y)
    *y += ScaleUIPx(10)
}

meditation_music_measure_practice_settings :: (app: InbeApp*,
                                                  practice: int,
                                                  content_w: int,
                                                  show_installed_download: int,
                                                  show_status: int) -> int {
    installed: int
    h := ScaleUIPx(76)
    enabled: int

    if app == nil {
        return 0
    }

    sanitize_practice_music(app)
    practice = practice_clamp_id(practice)
    enabled = (app->meditation.music_practice_mask & (1 << practice)) != 0
    if !enabled {
        return h
    }

    h += ScaleUIPx(48)
    installed = meditation_music_available(app)
    if installed {
        h += ScaleUIPx(48)
    }
    if !installed || show_installed_download {
        h += ScaleUIPx(48)
    }

    if show_status &&
       (!installed ||
        app->meditation.music_download.status != RUNTIME_ASSET_IDLE) {
        if app->meditation.music_download.status == RUNTIME_ASSET_DOWNLOADING {
            h += ScaleUIPx(50)
        } else {
            h += ScaleUIPx(34)
        }
    }

    h += attribution_height(content_w) + ScaleUIPx(10)
    return h
}

meditation_music_draw_dropdown_menu :: (app: InbeApp*) -> int {
    changed := 0

    if app == nil {
        return 0
    }

    for int i = 0; i < EXERCISE_COUNT; i++ {
        if DrawUIDropdownMenu(451 + i) {
            app->settings_dirty = 1
            app->meditation.music_track = app->meditation.music_practice_tracks[i]
            meditation_music_unload(app)
            changed = 1
        }
    }
    return changed
}
