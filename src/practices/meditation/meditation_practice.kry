#import "app.h"
#import "practices/meditation/meditation_music.h"
#import "practices/meditation/meditation_practice.h"

meditation_practice_init :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    meditation_music_init(app)
}

meditation_practice_destroy :: (app: InnerBreeze*) {
    meditation_music_unload(app)
}

meditation_practice_start :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_MEDITATION)
    meditation_start_configured(app)
}

meditation_practice_update :: (app: InnerBreeze*) {
    meditation_music_update(app)
}

meditation_practice_leave_config :: (app: InnerBreeze*) {
    meditation_music_unload(app)
}
