#import "app.h"
#import "practices/meditation/meditation_music.h"
#import "practices/meditation/meditation_practice.h"

meditation_practice_init :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    if app->meditation.image_1.id == 0 {
        app->meditation.image_1 = app_load_asset_texture("practices/meditation/1.png")
    }
    meditation_music_init(app)
}

meditation_practice_destroy :: (app: InbeApp*) {
    if app != NULL {
        app_unload_texture(app->meditation.image_1)
        app->meditation.image_1 = (Texture2D){0}
    }
    meditation_music_unload(app)
}

meditation_practice_start :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_MEDITATION)
    meditation_start_configured(app)
}

meditation_practice_update :: (app: InbeApp*) {
    meditation_music_update(app)
}

meditation_practice_leave_config :: (app: InbeApp*) {
    meditation_music_unload(app)
}
