#import "app/app_notifications"
#import "app.h"
#import "data.h"
#import "practices/meditation/meditation_music.h"
#import "practices/meditation/meditation_practice.h"
#import "practices/practice_audio_controls.h"
#import "practices/practice_registry.h"
#import "stdio.h"

static background_remainder_ms: int = 0

static duration_presets: [5] const int = {
    5 * 60,
    15 * 60,
    30 * 60,
    60 * 60,
    2 * 60 * 60
}

meditation_start_seconds :: (app: InbeApp*, seconds: int) #private {
    if app == nil {
        return
    }

    if seconds < 60 {
        seconds = 60
    }

    app->meditation.duration_seconds = seconds
    app->meditation.remaining_seconds = seconds
    app->meditation.frame_ticks = 0
    app->meditation.complete_waiting = 0
    background_remainder_ms = 0
    last_bell_index = 0
    app->session_paused = 0
    app->volume_popup_active = 0
    app_close_modal(app)
    app_switch_screen(app, InbeScreenMeditation)
    app_play_bell_cue(app, 1.0f)
    meditation_music_start_session(app)
    practice_background_start(app, PRACTICE_MEDITATION)
}

# Interval bell: ring once for every completed interval while the session
# runs (foreground tick and background advance both funnel through here).
static last_bell_index: int = 0

maybe_interval_bell :: (app: InbeApp*) #private {
    interval := app->meditation.interval_bell_minutes * 60

    if interval <= 0 || app->meditation.complete_waiting {
        return
    }
    index := elapsed_seconds(app) / interval
    if index > last_bell_index {
        last_bell_index = index
        app_play_bell_cue(app, 0.85f)
    }
}

meditation_configured_duration_seconds :: (app: const InbeApp*) -> int {
    mode: int

    if app == nil {
        return duration_presets[1]
    }

    mode = app->meditation.duration_mode
    if mode >= 0 && mode < 5 {
        return duration_presets[mode]
    }
    return clampi(app->meditation.custom_minutes, 1, 240) * 60
}

meditation_start_configured :: (app: InbeApp*) {
    meditation_start_seconds(app, meditation_configured_duration_seconds(app))
}

finish :: (app: InbeApp*) #private {
    duration: int
    result_path: [FS_PATH_MAX] char = {0}

    if app == nil {
        return
    }
    app_notifications_send_session_complete(app)

    duration = app->meditation.duration_seconds
    if duration >= 60 {
        session_duration := duration

        if data_save_session_path_for_activity(&session_duration,
                                               1,
                                               0,
                                               EXERCISE_MEDITATION,
                                               result_path,
                                               sizeof(result_path)) {
            sync_habits_for_activity(app, EXERCISE_MEDITATION)
            app_auto_sync(app)
        }
    }

    if !app->meditation.complete_waiting {
        app_play_bell_cue(app, 1.0f)
    }

    app->meditation.duration_seconds = 0
    app->meditation.remaining_seconds = 0
    app->meditation.frame_ticks = 0
    app->meditation.complete_waiting = 0
    background_remainder_ms = 0
    app->session_paused = 0
    app->volume_popup_active = 0
    meditation_music_stop(app)
    practice_active_background_stop(app)
    app_prepare_session_results(app, EXERCISE_MEDITATION, duration, 0, nil,
                                nil, 0, result_path)
    app_switch_screen(app, InbeScreenResults)
}

timer_complete :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    if app->meditation.show_extend_controls {
        app->meditation.remaining_seconds = 0
        app->meditation.frame_ticks = 0
        if !app->meditation.complete_waiting {
            app->meditation.complete_waiting = 1
            meditation_music_fade_out(app)
            app_play_bell_cue(app, 1.0f)
        }
        return
    }

    finish(app)
}

meditation_advance_elapsed :: (app: InbeApp*, elapsed_ms: int) {
    elapsed_total: int
    elapsed_seconds: int

    if app == nil || elapsed_ms <= 0 {
        return
    }
    if app->inbe.screen != InbeScreenMeditation || app->session_paused {
        background_remainder_ms = 0
        return
    }

    elapsed_total = elapsed_ms + background_remainder_ms
    elapsed_seconds = elapsed_total / 1000
    background_remainder_ms = elapsed_total % 1000
    if elapsed_seconds <= 0 {
        return
    }

    if elapsed_seconds >= app->meditation.remaining_seconds {
        app->meditation.remaining_seconds = 0
    } else {
        app->meditation.remaining_seconds -= elapsed_seconds
        maybe_interval_bell(app)
    }
    app->meditation.frame_ticks = 0

    if app->meditation.remaining_seconds <= 0 {
        timer_complete(app)
    }
}

elapsed_seconds :: (app: InbeApp*) -> int #private {
    elapsed: int

    if app == nil {
        return 0
    }

    elapsed = app->meditation.duration_seconds -
              app->meditation.remaining_seconds
    if elapsed < 0 {
        elapsed = 0
    }
    if elapsed > app->meditation.duration_seconds {
        elapsed = app->meditation.duration_seconds
    }
    return elapsed
}

save_elapsed :: (app: InbeApp*) -> int #private {
    elapsed: int

    if app == nil {
        return 0
    }

    elapsed = elapsed_seconds(app)
    if elapsed < 60 {
        return 0
    }
    if data_save_session_path_for_activity(&elapsed,
                                           1,
                                           0,
                                           EXERCISE_MEDITATION,
                                           nil,
                                           0) {
        sync_habits_for_activity(app, EXERCISE_MEDITATION)
        app_auto_sync(app)
        return 1
    }
    return 0
}

exit_to_start :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    meditation_music_stop(app)
    app->meditation.duration_seconds = 0
    app->meditation.remaining_seconds = 0
    app->meditation.frame_ticks = 0
    app->meditation.complete_waiting = 0
    background_remainder_ms = 0
    app->session_paused = 0
    app->volume_popup_active = 0
    app_close_modal(app)
    practice_active_background_stop(app)
    app_switch_screen(app, InbeScreenStart)
}

meditation_request_exit :: (app: InbeApp*) {
    if app == nil {
        return
    }
    app_open_modal(app, UIModalConfirmExitSession)
}

handle_exit_modal :: (app: InbeApp*) -> int #private {
    elapsed: int
    result: SessionExitModalResult

    if app == nil || !app->modal.active ||
       app->modal.type != UIModalConfirmExitSession {
        return 0
    }

    elapsed = elapsed_seconds(app)
    result = app_draw_session_exit_modal(
        elapsed >= 60,
        GetLocaleText("meditation_save_elapsed_message"),
        GetLocaleText("meditation_under_minute_exit_message")
    )

    if result == SessionExitModalCancel {
        app_close_modal(app)
    } else if result == SessionExitModalSave ||
              result == SessionExitModalDiscard {
        if result == SessionExitModalSave {
            save_elapsed(app)
        }
        exit_to_start(app)
    }
    return 1
}

format_time :: (dst: char*, dst_size: size_t, seconds: int) #private {
    hours: int
    minutes: int
    secs: int

    if dst == nil || dst_size == 0 {
        return
    }
    if seconds < 0 {
        seconds = 0
    }

    hours = seconds / 3600
    minutes = (seconds / 60) % 60
    secs = seconds % 60

    if hours > 0 {
        snprintf(dst, dst_size, "%d:%02d:%02d", hours, minutes, secs)
    } else {
        snprintf(dst, dst_size, "%d:%02d", minutes, secs)
    }
}

draw_duration_button :: (x: int, y: int, w: int, h: int,
                        label: const char*) -> int #private {
    hover := 0
    return StyledButton(x, y, w, h, label,
                               ButtonStylePrimary, 0, &hover)
}

extend_session :: (app: InbeApp*, seconds: int) #private {
    was_complete: int

    if app == nil || seconds <= 0 {
        return
    }

    was_complete = app->meditation.complete_waiting
    app->meditation.duration_seconds += seconds
    app->meditation.remaining_seconds += seconds
    app->meditation.complete_waiting = 0
    app->meditation.frame_ticks = 0
    if was_complete {
        meditation_music_start_session(app)
    }
}

meditation_draw_setup_modal :: (app: InbeApp*) {
    labels: [5] const char* = {
        GetLocaleText("duration_5m"),
        GetLocaleText("duration_15m"),
        GetLocaleText("duration_30m"),
        GetLocaleText("duration_1h"),
        GetLocaleText("duration_2h")
    }
    modal_w := ScaleUIPx(320)
    modal_h := ScaleUIPx(236)
    modal_x: int
    modal_y: int
    title_font: int
    title_w: int
    btn_h := ScaleUIPx(38)
    gap := ScaleUIPx(10)
    side := ScaleUIPx(18)
    row_y: int
    btn_w: int
    cancel_w := ScaleUIPx(120)
    cancel_x: int
    cancel_y: int
    cancel_hover := 0

    if modal_w > view_width - ScaleUIPx(24) {
        modal_w = view_width - ScaleUIPx(24)
    }
    if modal_h > view_height - ScaleUIPx(24) {
        modal_h = view_height - ScaleUIPx(24)
    }

    modal_x = (view_width - modal_w) / 2
    modal_y = (view_height - modal_h) / 2
    btn_w = (modal_w - side * 2 - gap * 2) / 3
    if btn_w < ScaleUIPx(64) {
        btn_w = ScaleUIPx(64)
    }

    SetUIModalCapture((Rectangle){
        (float)modal_x,
        (float)modal_y,
        (float)modal_w,
        (float)modal_h
    })
    DrawRectangle(0, 0, view_width, view_height, (Color){0, 0, 0, 180})
    DrawRectangle(modal_x, modal_y, modal_w, modal_h, GetThemeSurface())
    Bevel(modal_x,
                   modal_y,
                   modal_w,
                   modal_h,
                   LightenUIColor(GetThemeSurface(), 40),
                   DarkenUIColor(GetThemeSurface(), 40))

    title_font = GetUITitleFontSize(GetLocaleText("meditation_title"),
                                    modal_w - side * 2)
    title_w = TextWidth(GetLocaleText("meditation_title"), title_font)
    Text(GetLocaleText("meditation_title"),
                  modal_x + (modal_w - title_w) / 2,
                  modal_y + ScaleUIPx(16),
                  title_font,
                  GetThemeText())

    row_y = modal_y + ScaleUIPx(62)
    for int i = 0; i < 3; i++ {
        x := modal_x + side + i * (btn_w + gap)

        if draw_duration_button(x, row_y, btn_w, btn_h, labels[i]) {
            meditation_start_seconds(app, duration_presets[i])
        }
    }

    row_y += btn_h + gap
    for int i = 3; i < 5; i++ {
        two_w := (modal_w - side * 2 - gap) / 2
        x := modal_x + side + (i - 3) * (two_w + gap)

        if draw_duration_button(x, row_y, two_w, btn_h, labels[i]) {
            meditation_start_seconds(app, duration_presets[i])
        }
    }

    cancel_y = modal_y + modal_h - btn_h - ScaleUIPx(16)
    cancel_x = modal_x + (modal_w - cancel_w) / 2
    if StyledButton(cancel_x,
                           cancel_y,
                           cancel_w,
                           btn_h,
                           GetLocaleText("cancel_button"),
                           ButtonStyleSecondary,
                           0,
                           &cancel_hover) {
        app_close_modal(app)
    }
}

draw_extend_controls :: (app: InbeApp*, center_x: int, y: int) #private {
    add_seconds: [3] const int = {60, 5 * 60, 10 * 60}
    labels: [3] const char* = {"+1", "+5", "+10"}
    gap := ScaleUIPx(8)
    btn_h := ScaleUIPx(34)
    btn_w := ScaleUIPx(58)
    finish_w := ScaleUIPx(96)
    total_w := btn_w * 3 + gap * 2
    x := center_x - total_w / 2
    hover := 0

    if app == nil || !app->meditation.show_extend_controls {
        return
    }

    if x < ScaleUIPx(12) {
        x = ScaleUIPx(12)
    }
    if x + total_w > view_width - ScaleUIPx(12) {
        x = view_width - ScaleUIPx(12) - total_w
    }

    for int i = 0; i < 3; i++ {
        if StyledButton(x + i * (btn_w + gap),
                               y,
                               btn_w,
                               btn_h,
                               labels[i],
                               ButtonStyleSecondary,
                               0,
                               &hover) {
            extend_session(app, add_seconds[i])
        }
    }

    if app->meditation.complete_waiting {
        finish_x := center_x - finish_w / 2
        finish_y := y + btn_h + ScaleUIPx(10)

        if finish_x < ScaleUIPx(12) {
            finish_x = ScaleUIPx(12)
        }
        if finish_x + finish_w > view_width - ScaleUIPx(12) {
            finish_x = view_width - ScaleUIPx(12) - finish_w
        }

        if StyledButton(finish_x,
                               finish_y,
                               finish_w,
                               btn_h,
                               GetLocaleText("finish_button"),
                               ButtonStylePrimary,
                               0,
                               &hover) {
            finish(app)
        }
    }
}

meditation_draw_screen :: (app: InbeApp*, center_x: int, center_y: int) {
    time_text: [32] char
    font := Text24
    max_w: int
    text_w: int
    title_h := UIGetNodeHeight(UINodeTitleBar(0))

    if app_draw_close_title_bar(app, GetLocaleText("meditation_title"), title_h) {
        meditation_request_exit(app)
        return
    }

    if handle_exit_modal(app) {
        return
    }

    practice_draw_audio_controls(app)

    format_time(time_text, sizeof(time_text), app->meditation.remaining_seconds)
    max_w = view_width - ScaleUIPx(48)
    if TextWidth(time_text, font) > max_w {
        font = Text16
    }
    text_w = TextWidth(time_text, font)
    Text(time_text,
                  center_x - text_w / 2,
                  GetUIControlTextY(time_text,
                                    center_y - font,
                                    font * 2,
                                    font),
                  font,
                  GetThemeText())

    draw_extend_controls(app, center_x, center_y + ScaleUIPx(42))
    if app->meditation.complete_waiting {
        return
    }

    if !app->backgrounded {
        app->meditation.frame_ticks++
        if app->meditation.frame_ticks >= 60 {
            app->meditation.frame_ticks = 0
            if app->meditation.remaining_seconds > 0 {
                app->meditation.remaining_seconds--
                maybe_interval_bell(app)
            }
            if app->meditation.remaining_seconds <= 0 {
                timer_complete(app)
            }
        }
    }
}

route meditation {
    title "Meditation Session"
    group "Practice"
    page meditation
}

meditation :: (app: InbeApp*) #ui {
    Screen root: {
    meditation_draw_screen(app, view_width / 2, view_height / 2)
    }
}
