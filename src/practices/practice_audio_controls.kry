#import "app/app.h"
#import "app_nav.h"

#enum {
    PRACTICE_AUDIO_SOUND_POPUP_ID = 15000
    PRACTICE_AUDIO_MUSIC_POPUP_ID = 15001
}

practice_audio_sound_icon_for_volume :: (app: InnerBreeze*) -> IconType #private {
    vol: int

    if app == nil {
        return ICON_NONE
    }

    vol = app->sound_volume
    if vol <= 0 {
        return ICON_SOUND0
    }
    if vol <= 25 {
        return ICON_SOUND1
    }
    if vol <= 75 {
        return ICON_SOUND2
    }
    return ICON_SOUND3
}

practice_audio_music_icon :: (app: InnerBreeze*) -> IconType #private {
    if app == nil {
        return ICON_NONE
    }
    return ICON_MUSIC
}

practice_draw_audio_controls :: (app: InnerBreeze*) {
    title_h := app_active_practice_title_height()
    icon_size := Scale(24)
    icon_padding := Scale(10)
    control_y := (title_h - (icon_size + icon_padding * 2)) / 2

    if app == nil {
        return
    }
    if control_y < 0 {
        control_y = 0
    }

    if AppIconSliderPopup((IconSliderPopupProps){
        .id = PRACTICE_AUDIO_SOUND_POPUP_ID,
        .x = Scale(8),
        .y = control_y,
        .icon_size = icon_size,
        .icon_padding = icon_padding,
        .icon_type = practice_audio_sound_icon_for_volume(app),
        .open = &app->volume_popup_active,
        .value = &app->sound_volume,
        .min = SETTINGS_VOLUME_MIN,
        .max = SETTINGS_VOLUME_MAX,
        .popup_width = Scale(40),
        .popup_height = Scale(176)
    }) {
        app->settings_dirty = 1
        save_settings(app)
    }

    if AppIconSliderPopup((IconSliderPopupProps){
        .id = PRACTICE_AUDIO_MUSIC_POPUP_ID,
        .x = Scale(60),
        .y = control_y,
        .icon_size = icon_size,
        .icon_padding = icon_padding,
        .icon_type = practice_audio_music_icon(app),
        .open = &app->music_volume_popup_active,
        .value = &app->music_volume,
        .min = SETTINGS_VOLUME_MIN,
        .max = SETTINGS_VOLUME_MAX,
        .popup_width = Scale(40),
        .popup_height = Scale(176)
    }) {
        app->settings_dirty = 1
        save_settings(app)
    }
}
