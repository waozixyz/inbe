    static android_background_session_started: int = 0
}

PracticeId :: enum {
    PRACTICE_WHM = 0
    PRACTICE_MEDITATION = 1
    PRACTICE_SUN_SALUTATION = 2
    PRACTICE_PATTERNS = 3
    PRACTICE_COUNT = 4
}

#enum {
    SESSION_RESULT_MOOD_COUNT = 5
}

PracticeVoidFn :: void (*)(InbeApp*) #type
PracticeCloseManualFn :: void (*)(InbeApp*, int) #type
PracticeDrawSessionFn :: void (*)(InbeApp*, int, int) #type
PracticeIsActiveFn :: int (*)(const InbeApp*) #type
PracticeAdvanceElapsedFn :: void (*)(InbeApp*, int) #type

PracticeDefinition :: struct {
    id: PracticeId
    label_key: const char*
    init: PracticeVoidFn
    destroy: PracticeVoidFn
    start: PracticeVoidFn
    draw_manual: PracticeVoidFn
    close_manual: PracticeCloseManualFn
    draw_config: PracticeVoidFn
    leave_config: PracticeVoidFn
    update: PracticeVoidFn
    draw_setup_modal: PracticeVoidFn
    draw_active_session: PracticeDrawSessionFn
    request_exit: PracticeVoidFn
    is_active: PracticeIsActiveFn
    background_start: PracticeVoidFn
    background_stop: PracticeVoidFn
    advance_elapsed: PracticeAdvanceElapsedFn
}

