#import "app.h"
#import "practices/meditation/meditation_practice.h"
#import "practices/sun_salutation/sun_salutation_practice.h"
#import "practices/patterns/patterns_practice.h"
#import "practices/whm/whm_practice.h"
#import "practices/whm/whm_session.h"

ANDROID :: ANDROID_BUILD

#if ANDROID {
    #import "android_timer.h" #private
    #import "android_wakelock.h"
#private
    set_global_inbe_app :: (app: InbeApp*) #extern
}

PracticeId :: enum {
    PRACTICE_WHM = 0
    PRACTICE_MEDITATION = 1
    PRACTICE_SUN_SALUTATION = 2
    PRACTICE_PATTERNS = 3
    PRACTICE_COUNT = 4
}

PracticeVoidFn :: void (*)(InbeApp*) #type
PracticeCloseManualFn :: void (*)(InbeApp*, int) #type
PracticeDrawSessionFn :: void (*)(InbeApp*, int, int) #type
PracticeIsActiveFn :: int (*)(const InbeApp*) #type
PracticeAdvanceElapsedFn :: void (*)(InbeApp*, int) #type

PracticeDefinition :: struct {
    id: PracticeId
    label_key: const char*
    init: PracticeVoidFn
    destroy: PracticeVoidFn
    start: PracticeVoidFn
    draw_manual: PracticeVoidFn
    close_manual: PracticeCloseManualFn
    draw_config: PracticeVoidFn
    leave_config: PracticeVoidFn
    update: PracticeVoidFn
    draw_setup_modal: PracticeVoidFn
    draw_active_session: PracticeDrawSessionFn
    request_exit: PracticeVoidFn
    is_active: PracticeIsActiveFn
    background_start: PracticeVoidFn
    background_stop: PracticeVoidFn
    advance_elapsed: PracticeAdvanceElapsedFn
}

static android_background_session_started: int = 0

static practices: [PRACTICE_COUNT] const PracticeDefinition = {
    {
        .id = PRACTICE_WHM,
        .label_key = "exercise_wim_hof",
        .init = whm_practice_init,
        .destroy = whm_practice_destroy,
        .start = whm_practice_start,
        .draw_manual = whm_manual_draw,
        .close_manual = whm_manual_close,
        .draw_config = whm_config_screen_draw,
        .leave_config = whm_practice_leave_config,
        .update = nil,
        .draw_setup_modal = nil,
        .draw_active_session = nil,
        .request_exit = nil,
        .is_active = practice_whm_is_active,
        .background_start = session_background_start,
        .background_stop = nil,
        .advance_elapsed = session_advance_elapsed,
    },
    {
        .id = PRACTICE_MEDITATION,
        .label_key = "exercise_meditation",
        .init = meditation_practice_init,
        .destroy = meditation_practice_destroy,
        .start = meditation_practice_start,
        .draw_manual = meditation_manual_draw,
        .close_manual = meditation_manual_close,
        .draw_config = meditation_config_screen_draw,
        .leave_config = meditation_practice_leave_config,
        .update = meditation_practice_update,
        .draw_setup_modal = meditation_draw_setup_modal,
        .draw_active_session = meditation_draw_screen,
        .request_exit = meditation_request_exit,
        .is_active = practice_meditation_is_active,
        .background_start = nil,
        .background_stop = nil,
        .advance_elapsed = meditation_advance_elapsed,
    },
    {
        .id = PRACTICE_SUN_SALUTATION,
        .label_key = "exercise_sun_salutation",
        .init = sun_salutation_practice_init,
        .destroy = sun_salutation_practice_destroy,
        .start = sun_salutation_practice_start,
        .draw_manual = nil,
        .close_manual = nil,
        .draw_config = sun_salutation_config_screen_draw,
        .leave_config = nil,
        .update = nil,
        .draw_setup_modal = nil,
        .draw_active_session = sun_salutation_draw_screen,
        .request_exit = sun_salutation_request_exit,
        .is_active = practice_sun_salutation_is_active,
        .background_start = nil,
        .background_stop = nil,
        .advance_elapsed = nil,
    },
    {
        .id = PRACTICE_PATTERNS,
        .label_key = "exercise_patterns",
        .init = patterns_practice_init,
        .destroy = patterns_practice_destroy,
        .start = patterns_practice_start,
        .draw_manual = nil,
        .close_manual = nil,
        .draw_config = patterns_config_screen_draw,
        .leave_config = patterns_practice_leave_config,
        .update = nil,
        .draw_setup_modal = nil,
        .draw_active_session = patterns_draw_screen,
        .request_exit = patterns_request_exit,
        .is_active = practice_patterns_is_active,
        .background_start = nil,
        .background_stop = nil,
        .advance_elapsed = nil,
    },
}

practice_whm_is_active :: (app: const InbeApp*) -> int #private {
    return app != nil && app->inbe.screen == InbeScreenSession
}

practice_meditation_is_active :: (app: const InbeApp*) -> int #private {
    return app != nil && app->inbe.screen == InbeScreenMeditation
}

practice_sun_salutation_is_active :: (app: const InbeApp*) -> int #private {
    return app != nil && app->inbe.screen == InbeScreenSunSalutation
}

practice_patterns_is_active :: (app: const InbeApp*) -> int #private {
    return app != nil && app->inbe.screen == InbeScreenPatterns
}

practice_get :: (id: int) -> const PracticeDefinition* {
    id = practice_clamp_id(id)
    return &practices[id]
}

practice_count :: () -> int {
    return PRACTICE_COUNT
}

practice_clamp_id :: (id: int) -> int {
    if id < 0 || id >= PRACTICE_COUNT {
        return PRACTICE_WHM
    }
    return id
}

practice_label :: (id: int) -> const char* {
    return GetLocaleText(practice_get(id)->label_key)
}

practice_active :: (app: const InbeApp*) -> const PracticeDefinition* {
    for int i = 0; i < practice_count(); i++ {
        practice := practice_get(i)
        if practice->is_active != nil && practice->is_active(app) {
            return practice
        }
    }
    return nil
}

practice_active_supports_background :: (app: const InbeApp*) -> int {
    practice := practice_active(app)
    return practice != nil && practice->advance_elapsed != nil
}

practice_background_start :: (app: InbeApp*, id: int) {
    practice: const PracticeDefinition* = nil

    if app == nil {
        return
    }

    practice = practice_get(id)

    #if ANDROID {
        set_global_inbe_app(app)
    }

    if practice == nil || practice->advance_elapsed == nil {
        return
    }

    if practice->background_start != nil {
        practice->background_start(app)
    }

    #if ANDROID {
        if app->inbe.play_in_background {
            android_wakelock_acquire()
            android_timer_set_app(app)
            android_timer_start()
            android_background_session_started = 1
        }
    }
}

practice_active_background_start :: (app: InbeApp*) {
    practice := practice_active(app)

    if practice == nil {
        return
    }
    practice_background_start(app, practice->id)
}

practice_active_background_stop :: (app: InbeApp*) {
    practice := practice_active(app)

    if app == nil {
        return
    }

    if practice != nil && practice->background_stop != nil {
        practice->background_stop(app)
    }

    #if ANDROID {
        if android_background_session_started {
            android_background_session_started = 0
            android_timer_deactivate()
            android_timer_stop()
            android_timer_set_app(nil)
            android_wakelock_release()
        }
    }
}

practice_active_advance_elapsed :: (app: InbeApp*, elapsed_ms: int) {
    practice: const PracticeDefinition* = nil

    if app == nil || elapsed_ms <= 0 || !app->inbe.play_in_background {
        return
    }

    practice = practice_active(app)
    if practice == nil || practice->advance_elapsed == nil {
        return
    }

    practice->advance_elapsed(app, elapsed_ms)
    if practice->update != nil && practice->is_active != nil &&
       practice->is_active(app) {
        practice->update(app)
    }
}

practice_update_circle_bounds :: (app: InbeApp*, top_reserve: int, bottom_reserve: int) {
    if app != nil {
        session_update_circle_bounds_for_view(&app->inbe, top_reserve, bottom_reserve)
    }
}

practice_update_session_sounds :: (app: InbeApp*) {
    update_session_sounds(app)
}

practice_ensure_results_saved :: (app: InbeApp*) -> int {
    return session_ensure_results_saved(app)
}

practice_draw_start_preview :: (app: InbeApp*, center_x: int, center_y: int) -> int {
    return session_draw_start_preview(app, center_x, center_y)
}

practice_draw_active_breathing :: (app: InbeApp*, center_x: int, center_y: int) {
    session_draw_inbe(app, center_x, center_y)
}

practice_update_active_breathing :: (app: InbeApp*, center_x: int, center_y: int, hover: int*) {
    session_update_screen(app, center_x, center_y, hover)
}

practice_draw_results :: (app: InbeApp*, center_x: int, center_y: int, hover: int*) {
    session_draw_results_screen(app, center_x, center_y, hover)
}
