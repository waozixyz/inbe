#import "app.h"
#import "practices/practice_registry.h"
#import "data.h"
#import "stdio.h"
#import "string.h"

app_prepare_session_results :: (app: InbeApp*, activity: int,
                                primary_value: int, secondary_value: int,
                                detail: const char*, round_values: const int*,
                                round_count: int, saved_path: const char*) {
    result: InbeSessionResult*

    if app == nil {
        return
    }
    result = &app->session_result
    memset(result, 0, sizeof(*result))
    result->active = 1
    result->activity = practice_clamp_id(activity)
    result->primary_value = primary_value
    result->secondary_value = secondary_value
    if detail != nil {
        snprintf(result->detail, sizeof(result->detail), "%s", detail)
    }
    if round_values != nil && round_count > 0 {
        if round_count > MaxRounds {
            round_count = MaxRounds
        }
        result->round_count = round_count
        for int i = 0; i < round_count; i++ {
            result->round_values[i] = round_values[i]
        }
    }
    if saved_path != nil && saved_path[0] != '\0' {
        result->saved = 1
        snprintf(result->path, sizeof(result->path), "%s", saved_path)
    }
}

session_result_discard :: (app: InbeApp*) {
    if app == nil || !app->session_result.active {
        return
    }
    if app->session_result.saved && app->session_result.path[0] != '\0' {
        if !data_discard_session(app->session_result.path) {
            app->session_result.write_failed = 1
            return
        }
        app_auto_sync(app)
    }
    memset(&app->session_result, 0, sizeof(app->session_result))
    app_switch_screen(app, InbeScreenStart)
}

session_result_done :: (app: InbeApp*) {
    checkin: InbeStorageSessionCheckin = {0}

    if app == nil || !app->session_result.active {
        return
    }
    if app->session_result.saved && app->session_result.path[0] != '\0' &&
       app->session_result.mood > 0 {
        checkin.mood_after = app->session_result.mood
        if !data_save_session_checkin(app->session_result.path, &checkin) {
            app->session_result.write_failed = 1
            return
        }
        app_auto_sync(app)
    }
    memset(&app->session_result, 0, sizeof(app->session_result))
    app_switch_screen(app, InbeScreenStart)
}
