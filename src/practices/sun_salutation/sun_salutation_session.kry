#import "app/app_notifications"
#import "app.h"
#import "data.h"
#import "practices/meditation/meditation_music.h"
#import "practices/practice_audio_controls.h"
#import "practices/practice_registry.h"
#import "practices/sun_salutation/sun_salutation_practice.h"
#import "stdio.h"

exit_to_start :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_switch_screen(app, InbeScreenStart)
}

finish :: (app: InbeApp*) #private {
    repetitions := 0
    result_path: [FS_PATH_MAX] char = {0}

    if app == nil {
        return
    }
    app_notifications_send_session_complete(app)

    repetitions = app->sun_salutation.repetitions
    if repetitions < 1 {
        repetitions = 1
    }
    if data_save_session_path_for_activity(&repetitions, 1, 0,
                                           EXERCISE_SUN_SALUTATION,
                                           result_path, sizeof(result_path)) {
        sync_habits_for_activity(app, EXERCISE_SUN_SALUTATION)
        app_auto_sync(app)
    }
    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_prepare_session_results(app, EXERCISE_SUN_SALUTATION, repetitions, 0,
                                nil, nil, 0, result_path)
    app_switch_screen(app, InbeScreenResults)
}

sun_salutation_practice_start :: (app: InbeApp*) {
    if app == nil {
        return
    }

    mark_exercise_manual_seen(app, EXERCISE_SUN_SALUTATION)
    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    if app->sun_salutation.repetitions < 2 || app->sun_salutation.repetitions > 12 {
        app->sun_salutation.repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if app->sun_salutation.start_seconds < SUN_SALUTATION_SECONDS_MIN ||
       app->sun_salutation.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if app->sun_salutation.end_seconds < SUN_SALUTATION_SECONDS_MIN ||
       app->sun_salutation.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if app->sun_salutation.start_seconds < app->sun_salutation.end_seconds {
        app->sun_salutation.end_seconds = app->sun_salutation.start_seconds
    }
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    app_close_modal(app)
    app_switch_screen(app, InbeScreenSunSalutation)
    meditation_music_start_session(app)
}

sun_salutation_request_exit :: (app: InbeApp*) {
    if app == nil {
        return
    }
    app_open_modal(app, UIModalConfirmExitSession)
}

step_seconds :: (app: InbeApp*) -> int #private {
    start_seconds: int
    end_seconds: int
    repetitions: int
    repetition: int

    if app == nil {
        return SUN_SALUTATION_DEFAULT_START_SECONDS
    }

    start_seconds = app->sun_salutation.start_seconds
    end_seconds = app->sun_salutation.end_seconds
    repetitions = app->sun_salutation.repetitions
    repetition = app->sun_salutation.repetition

    if start_seconds < SUN_SALUTATION_SECONDS_MIN ||
       start_seconds > SUN_SALUTATION_SECONDS_MAX {
        start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if end_seconds < SUN_SALUTATION_SECONDS_MIN ||
       end_seconds > SUN_SALUTATION_SECONDS_MAX {
        end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if start_seconds < end_seconds {
        end_seconds = start_seconds
    }
    if repetitions < 2 {
        return start_seconds
    }
    if repetition < 0 {
        repetition = 0
    }
    if repetition >= repetitions {
        repetition = repetitions - 1
    }
    return start_seconds + ((end_seconds - start_seconds) * repetition) /
                               (repetitions - 1)
}

step_forward :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step_ticks = 0
    if app->sun_salutation.step >= SUN_SALUTATION_STEP_COUNT - 1 {
        if app->sun_salutation.repetition >= app->sun_salutation.repetitions - 1 {
            finish(app)
        } else {
            app->sun_salutation.repetition++
            app->sun_salutation.step = 0
        }
    } else {
        app->sun_salutation.step++
    }
}

step_back :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step_ticks = 0
    if app->sun_salutation.step > 0 {
        app->sun_salutation.step--
    } else if app->sun_salutation.repetition > 0 {
        app->sun_salutation.repetition--
        app->sun_salutation.step = SUN_SALUTATION_STEP_COUNT - 1
    }
}

update_timer :: (app: InbeApp*) #private {
    ticks_per_step := 0

    if app == nil || app->inbe.screen != InbeScreenSunSalutation ||
       app->session_paused {
        return
    }

    ticks_per_step = step_seconds(app) * 60
    if ticks_per_step <= 0 {
        ticks_per_step = SUN_SALUTATION_DEFAULT_START_SECONDS * 60
    }
    app->sun_salutation.step_ticks++
    if app->sun_salutation.step_ticks >= ticks_per_step {
        step_forward(app)
    }
}

draw_pose_image :: (texture: Texture2D, pose_index: int, top_y: int, bottom_y: int) #private {
    src: Rectangle
    dst: Rectangle
    max_w: float
    max_h: float
    scale: float
    w: float
    h: float

    if texture.id == 0 || bottom_y <= top_y {
        return
    }
    if pose_index < 0 {
        pose_index = 0
    }
    if pose_index >= SUN_SALUTATION_POSE_COUNT {
        pose_index = SUN_SALUTATION_POSE_COUNT - 1
    }

    max_w = (float)(view_width - ScaleUIPx(48))
    max_h = (float)(bottom_y - top_y)
    scale = max_w / (float)SUN_SALUTATION_POSE_FRAME_W
    if (float)SUN_SALUTATION_POSE_FRAME_H * scale > max_h {
        scale = max_h / (float)SUN_SALUTATION_POSE_FRAME_H
    }
    if scale <= 0.0f {
        return
    }

    w = (float)SUN_SALUTATION_POSE_FRAME_W * scale
    h = (float)SUN_SALUTATION_POSE_FRAME_H * scale
    src = (Rectangle){
        (float)((pose_index % SUN_SALUTATION_POSE_SHEET_COLS) *
                SUN_SALUTATION_POSE_FRAME_W),
        (float)((pose_index / SUN_SALUTATION_POSE_SHEET_COLS) *
                SUN_SALUTATION_POSE_FRAME_H),
        (float)SUN_SALUTATION_POSE_FRAME_W,
        (float)SUN_SALUTATION_POSE_FRAME_H
    }
    dst = (Rectangle){
        ((float)view_width - w) * 0.5f,
        (float)top_y + (max_h - h) * 0.5f,
        w,
        h
    }
    DrawTexturePro(texture, src, dst, (Vector2){0}, 0.0f, WHITE)
}

draw_transition_image :: (texture: Texture2D, frame_index: int,
                          top_y: int, bottom_y: int) #private {
    src: Rectangle
    dst: Rectangle
    max_w: float
    max_h: float
    scale: float
    w: float
    h: float

    if texture.id == 0 || bottom_y <= top_y {
        return
    }
    if frame_index < 0 {
        frame_index = 0
    }
    if frame_index >= SUN_SALUTATION_TRANSITION_FRAME_COUNT {
        frame_index = SUN_SALUTATION_TRANSITION_FRAME_COUNT - 1
    }

    max_w = (float)(view_width - ScaleUIPx(48))
    max_h = (float)(bottom_y - top_y)
    scale = max_w / (float)SUN_SALUTATION_POSE_FRAME_W
    if (float)SUN_SALUTATION_POSE_FRAME_H * scale > max_h {
        scale = max_h / (float)SUN_SALUTATION_POSE_FRAME_H
    }
    if scale <= 0.0f {
        return
    }

    w = (float)SUN_SALUTATION_POSE_FRAME_W * scale
    h = (float)SUN_SALUTATION_POSE_FRAME_H * scale
    src = (Rectangle){
        (float)((frame_index % SUN_SALUTATION_TRANSITION_SHEET_COLS) *
                SUN_SALUTATION_POSE_FRAME_W),
        (float)((frame_index / SUN_SALUTATION_TRANSITION_SHEET_COLS) *
                SUN_SALUTATION_POSE_FRAME_H),
        (float)SUN_SALUTATION_POSE_FRAME_W,
        (float)SUN_SALUTATION_POSE_FRAME_H
    }
    dst = (Rectangle){
        ((float)view_width - w) * 0.5f,
        (float)top_y + (max_h - h) * 0.5f,
        w,
        h
    }
    DrawTexturePro(texture, src, dst, (Vector2){0}, 0.0f, WHITE)
}

sun_salutation_transition_index_for_step :: (step: int) -> int #private {
    if step == 0 {
        return 0
    }
    if step == 1 {
        return 1
    }
    return -1
}

sun_salutation_transition_frame_for_tick :: (step_ticks: int,
                                            ticks_per_step: int) -> int #private {
    frame_index: int

    if ticks_per_step <= 0 {
        return 0
    }
    if step_ticks < 0 {
        step_ticks = 0
    }
    frame_index = (step_ticks * SUN_SALUTATION_TRANSITION_FRAME_COUNT) /
                  ticks_per_step
    if frame_index >= SUN_SALUTATION_TRANSITION_FRAME_COUNT {
        frame_index = SUN_SALUTATION_TRANSITION_FRAME_COUNT - 1
    }
    return frame_index
}

draw_pose_timer :: (app: InbeApp*, seconds: int, top_y: int, bottom_y: int) #private {
    timer_text: [24] char
    elapsed_seconds: int
    text_w: int
    x: int
    y: int
    w: int
    h := ScaleUIPx(5)
    fill_w: int
    font := GetUISmallFontSize()
    muted := DarkenUIColor(GetThemeText(), 32)

    if app == nil || seconds <= 0 || bottom_y <= top_y {
        return
    }

    elapsed_seconds = app->sun_salutation.step_ticks / 60
    if elapsed_seconds > seconds {
        elapsed_seconds = seconds
    }
    snprintf(timer_text, sizeof(timer_text), "%ds / %ds", elapsed_seconds, seconds)

    text_w = TextWidth(timer_text, font)
    x = (view_width - text_w) / 2
    y = top_y + ScaleUIPx(4)
    Text(timer_text, x, y, font, muted)

    w = view_width / 3
    if w < ScaleUIPx(96) {
        w = ScaleUIPx(96)
    }
    if w > ScaleUIPx(220) {
        w = ScaleUIPx(220)
    }
    x = (view_width - w) / 2
    y += font + ScaleUIPx(6)
    fill_w = (w * app->sun_salutation.step_ticks) / (seconds * 60)
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }
    DrawRectangle(x, y, w, h, DarkenUIColor(GetThemeBackground(), 12))
    DrawRectangle(x, y, fill_w, h, GetThemeButtonHover())
}

sun_salutation_draw_screen :: (app: InbeApp*, center_x: int, center_y: int) {
    controls: [3] IconRowItem
    row: IconRowResult
    step_label: const char*
    step: int
    repetition: int
    repetitions: int
    figure: int
    pose_index: int
    transition_index: int
    transition_frame: int
    current_step_seconds: int
    ticks_per_step: int
    pause_icon: Texture2D
    title_h := UIGetNodeHeight(UINodeTitleBar(0))
    content_top := title_h + ScaleUIPx(8)
    image_bottom: int
    min_view_dim := view_width < view_height ? view_width : view_height

    if app == nil {
        return
    }

    if app->modal.active && app->modal.type == UIModalConfirmExitSession {
        modal_result := Modal(GetLocaleText("exit_session_title"),
                                    GetLocaleText("all_progress_lost_message"),
                                    GetLocaleText("cancel_button"),
                                    GetLocaleText("exit_button"))
        if modal_result == 1 {
            app_close_modal(app)
        } else if modal_result == 2 {
            exit_to_start(app)
        }
        return
    }

    step = app->sun_salutation.step
    repetition = app->sun_salutation.repetition
    repetitions = app->sun_salutation.repetitions
    if repetitions < 2 || repetitions > 12 {
        repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if app->sun_salutation.start_seconds < SUN_SALUTATION_SECONDS_MIN ||
       app->sun_salutation.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if app->sun_salutation.end_seconds < SUN_SALUTATION_SECONDS_MIN ||
       app->sun_salutation.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if app->sun_salutation.start_seconds < app->sun_salutation.end_seconds {
        app->sun_salutation.end_seconds = app->sun_salutation.start_seconds
    }
    if step < 0 {
        step = 0
    }
    if step >= SUN_SALUTATION_STEP_COUNT {
        step = SUN_SALUTATION_STEP_COUNT - 1
    }
    if repetition < 0 {
        repetition = 0
    }
    if repetition >= repetitions {
        repetition = repetitions - 1
    }
    figure = app->sun_salutation.figure
    if figure < 0 || figure >= SUN_SALUTATION_ACTIVE_FIGURE_COUNT {
        figure = SUN_SALUTATION_FIGURE_MAN
    }

    app->sun_salutation.step = step
    app->sun_salutation.repetition = repetition
    app->sun_salutation.repetitions = repetitions
    app->sun_salutation.figure = figure

    pose_index = sun_salutation_step_pose_index(step)
    current_step_seconds = step_seconds(app)
    ticks_per_step = current_step_seconds * 60
    if ticks_per_step <= 0 {
        ticks_per_step = SUN_SALUTATION_DEFAULT_START_SECONDS * 60
    }

    step_label = sun_salutation_step_label(step)
    if app_draw_close_title_bar(app, step_label, title_h) {
        sun_salutation_request_exit(app)
        return
    }
    practice_draw_audio_controls(app)

    controls[0] = (IconRowItem){
        app->icons[UI_ICON_TYPE_BACKWARD],
        step <= 0 && repetition <= 0
    }
    pause_icon = app->icons[UI_ICON_TYPE_PAUSE]
    if app->session_paused {
        pause_icon = app->icons[UI_ICON_TYPE_PLAY]
    }
    controls[1] = (IconRowItem){
        pause_icon,
        0
    }
    controls[2] = (IconRowItem){
        app->icons[UI_ICON_TYPE_FORWARD],
        0
    }
    row = BottomIconRow((BottomIconRowProps){
        .center_x = center_x,
        .view_width = view_width,
        .view_height = view_height,
        .count = 3,
        .items = controls,
        .icon_size = ScaleUIPx(24),
        .icon_padding = ScaleUIPx(10),
        .gap = ScaleUIPx(12),
        .side_margin = ScaleUIPx(24),
        .bottom_margin = ScaleUIPx(6),
        .max_button_width = min_view_dim / 6,
        .min_icon_size = ScaleUIPx(16),
        .min_icon_padding = ScaleUIPx(6),
        .min_gap = ScaleUIPx(8)
    })

    image_bottom = row.y - ScaleUIPx(18)
    draw_pose_timer(app, current_step_seconds, content_top, image_bottom)
    transition_index = sun_salutation_transition_index_for_step(step)
    if transition_index >= 0 &&
       transition_index < SUN_SALUTATION_TRANSITION_COUNT &&
       app->sun_salutation.transition_sheets[figure][transition_index].id != 0 {
        transition_frame =
            sun_salutation_transition_frame_for_tick(app->sun_salutation.step_ticks,
                                                     ticks_per_step)
        draw_transition_image(app->sun_salutation.transition_sheets[figure][transition_index],
                              transition_frame,
                              content_top + ScaleUIPx(28), image_bottom)
    } else {
        draw_pose_image(app->sun_salutation.pose_sheets[figure], pose_index,
                           content_top + ScaleUIPx(28), image_bottom)
    }

    if row.clicked_index == 0 {
        step_back(app)
    } else if row.clicked_index == 1 {
        app->session_paused = !app->session_paused
    } else if row.clicked_index == 2 {
        step_forward(app)
    }

    update_timer(app)
    unused center_y
}

route sun_salutation {
    title "Sun Salutation"
    group "Practice"
    page sun_salutation
}

sun_salutation :: (app: InbeApp*) #ui {
    Screen root: {
    sun_salutation_draw_screen(app, view_width / 2, view_height / 2)
    }
}
