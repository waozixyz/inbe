#import "app/app_notifications"
#import "app/app.h"
#import "app_nav.h" #private
#import "data.h"
#import "practices/meditation/meditation_music.h"
#import "practices/practice_audio_controls.h"
#import "practices/practice_registry.h"
#import "practices/sun_salutation/sun_salutation_practice.h"
#import "stdio.h"

exit_to_start :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_switch_screen(app, ScreenStart)
}

finish :: (app: InnerBreeze*) #private {
    repetitions := 0
    result_path: [FS_PATH_MAX] char = {0}

    if app == nil {
        return
    }
    app_notifications_send_session_complete(app)

    repetitions = app->sun_salutation.repetitions
    if repetitions < 1 {
        repetitions = 1
    }
    if data_save_session_path_for_activity(&repetitions, 1, 0,
    EXERCISE_SUN_SALUTATION,
    result_path, sizeof(result_path)) {
        sync_habits_for_activity(app, EXERCISE_SUN_SALUTATION)
        app_auto_sync(app)
    }
    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_prepare_session_results(app, EXERCISE_SUN_SALUTATION, repetitions, 0,
    nil, nil, 0, result_path)
    app_switch_screen(app, ScreenResults)
}

sun_salutation_practice_start :: (app: InnerBreeze*) {
    if app == nil {
        return
    }

    mark_exercise_manual_seen(app, EXERCISE_SUN_SALUTATION)
    app->sun_salutation.step = 0
    app->sun_salutation.repetition = 0
    if app->sun_salutation.repetitions < 2 || app->sun_salutation.repetitions > 12 {
        app->sun_salutation.repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if app->sun_salutation.start_seconds < SUN_SALUTATION_SECONDS_MIN ||
    app->sun_salutation.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if app->sun_salutation.end_seconds < SUN_SALUTATION_SECONDS_MIN ||
    app->sun_salutation.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if app->sun_salutation.start_seconds < app->sun_salutation.end_seconds {
        app->sun_salutation.end_seconds = app->sun_salutation.start_seconds
    }
    app->sun_salutation.step_ticks = 0
    app->session_paused = 0
    app_close_modal(app)
    app_switch_screen(app, ScreenSunSalutation)
    meditation_music_start_session(app)
}

sun_salutation_request_exit :: (app: InnerBreeze*) {
    if app == nil {
        return
    }
    app_open_modal(app, UIModalConfirmExitSession)
}

step_seconds :: (app: InnerBreeze*) -> int #private {
    start_seconds: int
    end_seconds: int
    repetitions: int
    repetition: int

    if app == nil {
        return SUN_SALUTATION_DEFAULT_START_SECONDS
    }

    start_seconds = app->sun_salutation.start_seconds
    end_seconds = app->sun_salutation.end_seconds
    repetitions = app->sun_salutation.repetitions
    repetition = app->sun_salutation.repetition

    if start_seconds < SUN_SALUTATION_SECONDS_MIN ||
    start_seconds > SUN_SALUTATION_SECONDS_MAX {
        start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if end_seconds < SUN_SALUTATION_SECONDS_MIN ||
    end_seconds > SUN_SALUTATION_SECONDS_MAX {
        end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if start_seconds < end_seconds {
        end_seconds = start_seconds
    }
    if repetitions < 2 {
        return start_seconds
    }
    if repetition < 0 {
        repetition = 0
    }
    if repetition >= repetitions {
        repetition = repetitions - 1
    }
    return start_seconds + ((end_seconds - start_seconds) * repetition) /
    (repetitions - 1)
}

step_forward :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step_ticks = 0
    if app->sun_salutation.step >= SUN_SALUTATION_STEP_COUNT - 1 {
        if app->sun_salutation.repetition >= app->sun_salutation.repetitions - 1 {
            finish(app)
        } else {
            app->sun_salutation.repetition++
            app->sun_salutation.step = 0
        }
    } else {
        app->sun_salutation.step++
    }
}

step_back :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }

    app->sun_salutation.step_ticks = 0
    if app->sun_salutation.step > 0 {
        app->sun_salutation.step--
    } else if app->sun_salutation.repetition > 0 {
        app->sun_salutation.repetition--
        app->sun_salutation.step = SUN_SALUTATION_STEP_COUNT - 1
    }
}

update_timer :: (app: InnerBreeze*) #private {
    ticks_per_step := 0

    if app == nil || app->breathing.screen != ScreenSunSalutation ||
    app->session_paused {
        return
    }

    ticks_per_step = step_seconds(app) * 60
    if ticks_per_step <= 0 {
        ticks_per_step = SUN_SALUTATION_DEFAULT_START_SECONDS * 60
    }
    app->sun_salutation.step_ticks++
    if app->sun_salutation.step_ticks >= ticks_per_step {
        step_forward(app)
    }
}

draw_pose_frame :: (asset_path: const char*, frame_index: int, columns: int,
top_y: int, bottom_y: int) #private {
    if asset_path == nil || bottom_y <= top_y {
        return
    }
    Image((ImageProps){
        .asset_path = asset_path,
        .source = {
            (float)((frame_index % columns) * SUN_SALUTATION_POSE_FRAME_W),
            (float)((frame_index / columns) * SUN_SALUTATION_POSE_FRAME_H),
            (float)SUN_SALUTATION_POSE_FRAME_W, (float)SUN_SALUTATION_POSE_FRAME_H},
        .bounds = {(float)Scale(24), (float)top_y,
            (float)(view_width - Scale(48)), (float)(bottom_y - top_y)},
        .fit = ImageFitContain
    })
}

sun_salutation_transition_index_for_step :: (step: int) -> int #private {
    if step == 0 {
        return 0
    }
    if step == 1 {
        return 1
    }
    return -1
}

sun_salutation_transition_frame_for_tick :: (step_ticks: int,
ticks_per_step: int) -> int #private {
    frame_index: int

    if ticks_per_step <= 0 {
        return 0
    }
    if step_ticks < 0 {
        step_ticks = 0
    }
    frame_index = (step_ticks * SUN_SALUTATION_TRANSITION_FRAME_COUNT) /
    ticks_per_step
    if frame_index >= SUN_SALUTATION_TRANSITION_FRAME_COUNT {
        frame_index = SUN_SALUTATION_TRANSITION_FRAME_COUNT - 1
    }
    return frame_index
}

draw_pose_timer :: (app: InnerBreeze*, seconds: int, top_y: int, bottom_y: int) #private {
    timer_text: [24] char
    elapsed_seconds: int
    text_w: int
    x: int
    y: int
    w: int
    h := Scale(5)
    fill_w: int
    font := AppSmallFontSize()

    if app == nil || seconds <= 0 || bottom_y <= top_y {
        return
    }

    elapsed_seconds = app->sun_salutation.step_ticks / 60
    if elapsed_seconds > seconds {
        elapsed_seconds = seconds
    }
    snprintf(timer_text, sizeof(timer_text), "%ds / %ds", elapsed_seconds, seconds)

    text_w = AppTextWidth(timer_text, font)
    x = (view_width - text_w) / 2
    y = top_y + Scale(4)
    Text((TextProps){
        .bounds = {(x), (y), 0, 0},
        .text = (timer_text),
        .wrap = TextWrapNone
    })

    w = view_width / 3
    if w < Scale(96) {
        w = Scale(96)
    }
    if w > Scale(220) {
        w = Scale(220)
    }
    x = (view_width - w) / 2
    y += font + Scale(6)
    fill_w = (w * app->sun_salutation.step_ticks) / (seconds * 60)
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }
    DrawRectangle(x, y, w, h, DarkenColor(StyleTokenColor("canvas"), 12))
    DrawRectangle(x, y, fill_w, h, StyleTokenColor("accent-hover"))
}

sun_salutation_draw_screen :: (app: InnerBreeze*, center_x: int, center_y: int) {
    controls: [3] IconRowAction
    row: IconRowResult
    step_label: const char*
    step: int
    repetition: int
    repetitions: int
    figure: int
    pose_index: int
    transition_index: int
    transition_frame: int
    current_step_seconds: int
    ticks_per_step: int
    pause_icon: IconType
    title_h := app_active_practice_title_height()
    content_top := title_h + Scale(8)
    image_bottom: int

    if app == nil {
        return
    }

    if app->modal.active && app->modal.type == UIModalConfirmExitSession {
        actions: [2] ModalAction = {
            {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
            {GetLocaleText("exit_button"), ButtonToneDanger, ButtonEmphasisFilled, 0},
        }
        modal_result := Modal((ModalProps){
            .title = GetLocaleText("exit_session_title"),
            .message = GetLocaleText("all_progress_lost_message"),
            .actions = actions,
            .action_count = 2
        })
        if modal_result == 1 {
            app_close_modal(app)
        } else if modal_result == 2 {
            exit_to_start(app)
        }
        return
    }

    step = app->sun_salutation.step
    repetition = app->sun_salutation.repetition
    repetitions = app->sun_salutation.repetitions
    if repetitions < 2 || repetitions > 12 {
        repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if app->sun_salutation.start_seconds < SUN_SALUTATION_SECONDS_MIN ||
    app->sun_salutation.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if app->sun_salutation.end_seconds < SUN_SALUTATION_SECONDS_MIN ||
    app->sun_salutation.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        app->sun_salutation.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if app->sun_salutation.start_seconds < app->sun_salutation.end_seconds {
        app->sun_salutation.end_seconds = app->sun_salutation.start_seconds
    }
    if step < 0 {
        step = 0
    }
    if step >= SUN_SALUTATION_STEP_COUNT {
        step = SUN_SALUTATION_STEP_COUNT - 1
    }
    if repetition < 0 {
        repetition = 0
    }
    if repetition >= repetitions {
        repetition = repetitions - 1
    }
    figure = app->sun_salutation.figure
    if figure < 0 || figure >= SUN_SALUTATION_ACTIVE_FIGURE_COUNT {
        figure = SUN_SALUTATION_FIGURE_MAN
    }

    app->sun_salutation.step = step
    app->sun_salutation.repetition = repetition
    app->sun_salutation.repetitions = repetitions
    app->sun_salutation.figure = figure

    pose_index = sun_salutation_step_pose_index(step)
    current_step_seconds = step_seconds(app)
    ticks_per_step = current_step_seconds * 60
    if ticks_per_step <= 0 {
        ticks_per_step = SUN_SALUTATION_DEFAULT_START_SECONDS * 60
    }

    step_label = sun_salutation_step_label(step)
    if app_draw_active_practice_title_bar(app, step_label, title_h) {
        sun_salutation_request_exit(app)
        return
    }
    practice_draw_audio_controls(app)

    controls[0] = (IconRowAction){
        ICON_BACKWARD,
        step <= 0 && repetition <= 0
    }
    pause_icon = ICON_PAUSE
    if app->session_paused {
        pause_icon = ICON_PLAY
    }
    controls[1] = (IconRowAction){
        pause_icon,
        0
    }
    controls[2] = (IconRowAction){
        ICON_FORWARD,
        0
    }
    row = AppBottomIconRow((IconRowRequest){
        .center_x = center_x,
        .view_width = view_width,
        .view_height = view_height,
        .count = 3,
        .items = controls
    })

    image_bottom = row.y - Scale(18)
    draw_pose_timer(app, current_step_seconds, content_top, image_bottom)
    transition_index = sun_salutation_transition_index_for_step(step)
    transition_asset := sun_salutation_transition_asset(figure, transition_index)
    if transition_asset != nil {
        transition_frame =
        sun_salutation_transition_frame_for_tick(app->sun_salutation.step_ticks,
        ticks_per_step)
        draw_pose_frame(transition_asset, transition_frame,
        SUN_SALUTATION_TRANSITION_SHEET_COLS,
        content_top + Scale(28), image_bottom)
    } else {
        draw_pose_frame(sun_salutation_pose_asset(figure), pose_index,
        SUN_SALUTATION_POSE_SHEET_COLS,
        content_top + Scale(28), image_bottom)
    }

    if row.clicked_index == 0 {
        step_back(app)
    } else if row.clicked_index == 1 {
        app->session_paused = !app->session_paused
    } else if row.clicked_index == 2 {
        step_forward(app)
    }

    update_timer(app)
    unused center_y
}

route sun_salutation {
    title "Sun Salutation"
    group "Practice"
    page sun_salutation
}

sun_salutation :: (app: InnerBreeze*) #ui {
    Screen root: {
        sun_salutation_draw_screen(app, view_width / 2, view_height / 2)
    }
}
