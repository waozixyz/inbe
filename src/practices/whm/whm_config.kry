#import "app.h"
#import "practices/meditation/meditation_music.h"
#import "practices/whm/whm_practice.h"
#import "practices/whm/whm_session.h"
#import "screens/practice_screen.h"
#import "src/screens/settings/settings_ui.h"

whm_draw_exact_speed_preview :: (preview: BreathSession*, preview_speed: int*,
                                speed: int, max_rounds: int, max_breaths: int,
                                pause_seconds: int, content_w: int,
                                content_h: int, center_x: int, center_y: int) #private {
    if preview == nil || preview_speed == nil {
        return
    }

    if preview->phase != BreathPhaseBreathe {
        breath_session_init(preview)
        apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
        preview->progressive_speed = 0
        session_reset_round_breathe(preview)
    } else if *preview_speed != speed {
        apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
        preview->progressive_speed = 0
    }

    if *preview_speed != speed {
        *preview_speed = speed
    }

    update_preview_bounds(preview, content_w, content_h)
    breath_session_step(preview)
    draw_breath_preview(preview, center_x, center_y)
}

whm_draw_progressive_start_speed_editor :: (app: InnerBreeze*) #private {
    modal_w := Scale(340)
    modal_h := Scale(360)
    modal_x := 0
    modal_y := 0
    title_font := AppFontSize()
    title_y := 0
    close_size := Scale(22)
    close_padding := Scale(8)
    close_w := close_size + close_padding * 2

    max_speed := app->breathing.speed_level
    start_speed := clampi(app->breathing.progressive_start_speed,
                          SETTINGS_SPEED_MIN, max_speed)
    title: const char* = nil
    title_w := 0
    title_max_w := 0

    if modal_w > view_width - Scale(24) {
        modal_w = view_width - Scale(24)
    }
    if modal_h > view_height - Scale(24) {
        modal_h = view_height - Scale(24)
    }
    modal_x = (view_width - modal_w) / 2
    modal_y = (view_height - modal_h) / 2
    title_y = modal_y + Scale(14)

    SetModalCapture((Rectangle){
        (float)modal_x,
        (float)modal_y,
        (float)modal_w,
        (float)modal_h
    })
    DrawRectangle(0, 0, view_width, view_height, (Color){0, 0, 0, 180})
    DrawRectangle(modal_x, modal_y, modal_w, modal_h, GetThemeSurface())
    Bevel(modal_x, modal_y, modal_w, modal_h,
                   LightenColor(GetThemeSurface(), 40),
                   DarkenColor(GetThemeSurface(), 40))

    title = GetLocaleText("progressive_start_speed_editor_title")
    title_w = AppTextWidth(title, title_font)
    title_max_w = modal_w - close_w * 2 - Scale(24)
    while title_font > Text12 && title_w > title_max_w {
        title_font--
        title_w = AppTextWidth(title, title_font)
    }
    Text((TextProps){
        .bounds={(modal_x + (modal_w - title_w) / 2), (title_y), 0, 0},
        .text=(title),
        .wrap=TextWrapNone
    })

    if Button((ButtonProps){
        .id = 0,
        .bounds = {(float)(modal_x + modal_w - close_w - Scale(6)), (float)(modal_y + Scale(6)),
                   (float)((close_size) + (close_padding) * 2),
                   (float)((close_size) + (close_padding) * 2)},
        .icon_type = ICON_X, .icon_only = 1,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        app_close_modal(app)
        return
    }

    whm_draw_exact_speed_preview(&app->start_speed_preview,
                                    &app->start_speed_preview_speed,
                                    start_speed,
                                    app->breathing.max_rounds,
                                    int_from_count(app->breathing.maxbreaths),
                                    app->breathing.pause_seconds,
                                    modal_w - Scale(48),
                                    Scale(210),
                                    modal_x + modal_w / 2,
                                    modal_y + Scale(150))

    if Slider((SliderProps){.id = 12,
                    .bounds = {modal_x + Scale(24), modal_y + Scale(250),
                               modal_w - Scale(48), Scale(56)},
                    .label = GetLocaleText("progressive_start_speed_label"),
                    .kind = NumericInt, .int_values = &start_speed,
                    .value_count = 1, .min = SETTINGS_SPEED_MIN,
                    .max = max_speed, .format = "%d"}) {
        app->breathing.progressive_start_speed = start_speed
        app->settings_dirty = 1
    }
}

whm_config_draw_section_title :: (x: int, y: int*, title: const char*) #private {
    if y == NULL {
        return
    }

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(title),
        .wrap=TextWrapNone
    })
    *y += Scale(34)
}

whm_config_draw_card :: (x: int, y: int, w: int, h: int) #private {
    bounds := (Rectangle){(float)x, (float)y, (float)w, (float)h}

    DrawRectangleRounded(bounds, 0.08f, 10, GetThemeSurface())
    DrawRectangleRoundedLinesEx(bounds, 0.08f, 10, 1.0f, GetThemeBorder())
}

whm_config_breath_card_height :: (app: InnerBreeze*) -> int #private {
    h := Scale(70) + Scale(152) + Scale(68) +
         Scale(72)

    if app != nil && app->breathing.progressive_speed {
        h += Scale(62)
    }
    return h
}

whm_config_session_card_height :: () -> int #private {
    return Scale(70) * 3
}

whm_config_options_card_height :: () -> int #private {
    return Scale(72) * 3
}

whm_config_draw_breath_card :: (app: InnerBreeze*, content_x: int, content_w: int,
                               y: int, draw_breath_animation_menu: int*) -> int #private {
    animation_options: [BreathAnimationCount] const char* = {0}
    card_h := whm_config_breath_card_height(app)
    card_pad := Scale(18)
    card_x := content_x
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad
    preview_h := Scale(132)
    preview_radius := 0
    speed := app->breathing.speed_level
    max_rounds := app->breathing.max_rounds
    max_breaths := int_from_count(app->breathing.maxbreaths)
    pause_seconds := app->breathing.pause_seconds
    progressive_start_speed := app->breathing.progressive_start_speed
    progressive_speed := app->breathing.progressive_speed
    toggle_w := Scale(56)
    toggle_h := Scale(30)

    animation_options[BreathAnimationLinear] = GetLocaleText("breath_animation_linear")
    animation_options[BreathAnimationInOut] = GetLocaleText("breath_animation_in_out")
    app->breathing.breath_animation = clampi(app->breathing.breath_animation,
                                        BreathAnimationLinear,
                                        BreathAnimationCount - 1)

    whm_config_draw_card(card_x, y, content_w, card_h)

    Text((TextProps){
        .bounds={(inner_x), (inner_y), 0, 0},
        .text=(GetLocaleText("breath_animation_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 104,
                            .bounds = {inner_x, inner_y + Scale(26), inner_w, Scale(48)},
                            .options = animation_options,
                            .option_count = BreathAnimationCount,
                            .selected_index = &app->breathing.breath_animation}) {
        app->breathing.breath_animation = clampi(app->breathing.breath_animation,
                                            BreathAnimationLinear,
                                            BreathAnimationCount - 1)
        app->settings_preview.breath_animation = app->breathing.breath_animation
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    if draw_breath_animation_menu != nil {
        *draw_breath_animation_menu = 1
    }
    inner_y += Scale(70)

    update_preview_bounds(&app->settings_preview, inner_w, preview_h)
    apply_settings(&app->settings_preview, speed, max_rounds,
                      max_breaths, pause_seconds)
    app->settings_preview.progressive_speed = 0
    breath_session_step(&app->settings_preview)
    if app->settings_preview.phase != BreathPhaseBreathe {
        reset_settings_preview(app)
        update_preview_bounds(&app->settings_preview, inner_w, preview_h)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_preview.progressive_speed = 0
    }

    preview_radius = (int)((float)app->settings_preview.rmax * 0.52f + 1.0f)
    draw_breath_preview(&app->settings_preview, inner_x + inner_w / 2,
                         inner_y + Scale(10) + preview_radius)
    inner_y += preview_radius * 2 + Scale(34)

    if Slider((SliderProps){.id = 1,
                    .bounds = {inner_x, inner_y, inner_w, Scale(56)},
                    .label = GetLocaleText("speed_label"),
                    .kind = NumericInt, .int_values = &speed,
                    .value_count = 1, .min = SETTINGS_SPEED_MIN,
                    .max = SETTINGS_SPEED_MAX, .format = "%d"}) {
        apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    inner_y += Scale(68)

    Text((TextProps){
        .bounds={(inner_x), (inner_y), 0, 0},
        .text=(GetLocaleText("progressive_speed_label")),
        .wrap=TextWrapNone
    })
    if Toggle((ToggleProps){.id = 0,
                       .bounds = {inner_x + inner_w - toggle_w,
                                  inner_y + (Scale(52) - toggle_h) / 2,
                                  toggle_w, toggle_h},
                       .value = &progressive_speed,
                       .off_label = GetLocaleText("toggle_off"),
                       .on_label = GetLocaleText("toggle_on")}) {
        app->breathing.progressive_speed = progressive_speed
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    inner_y += Scale(72)

    if app->breathing.progressive_speed {
        modify_w := AppTextWidth(GetLocaleText("modify_start_speed_button"),
                                       AppFontSize()) + Scale(24)


        if modify_w > inner_w {
            modify_w = inner_w
        }
        if progressive_start_speed != clampi(progressive_start_speed,
                                             SETTINGS_SPEED_MIN, speed) {
            app->breathing.progressive_start_speed =
                clampi(progressive_start_speed, SETTINGS_SPEED_MIN, speed)
            app->settings_preview.progressive_start_speed =
                app->breathing.progressive_start_speed
            app->settings_dirty = 1
        }
        if Button((ButtonProps){
            .bounds = {(float)(inner_x), (float)(inner_y), (float)(modify_w), (float)(Scale(48))},
            .label = GetLocaleText("modify_start_speed_button"),
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app_open_modal(app, UIModalEditProgressiveStartSpeed)
        }
    }

    return y + card_h + Scale(16)
}

whm_config_draw_session_card :: (app: InnerBreeze*, content_x: int, content_w: int,
                                y: int) -> int #private {
    speed := app->breathing.speed_level
    max_rounds := app->breathing.max_rounds
    max_breaths := int_from_count(app->breathing.maxbreaths)
    pause_seconds := app->breathing.pause_seconds
    card_h := whm_config_session_card_height()
    card_pad := Scale(18)
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad

    whm_config_draw_card(content_x, y, content_w, card_h)

    if Slider((SliderProps){.id = 2,
                    .bounds = {inner_x, inner_y, inner_w, Scale(56)},
                    .label = GetLocaleText("max_rounds_label"),
                    .kind = NumericInt, .int_values = &max_rounds,
                    .value_count = 1, .min = 1, .max = MaxRounds,
                    .format = "%d"}) {
        apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    inner_y += Scale(70)

    if Slider((SliderProps){.id = 3,
                    .bounds = {inner_x, inner_y, inner_w, Scale(56)},
                    .label = GetLocaleText("max_breaths_label"),
                    .kind = NumericInt, .int_values = &max_breaths,
                    .value_count = 1, .min = SETTINGS_BREATHS_MIN,
                    .max = SETTINGS_BREATHS_MAX, .format = "%d"}) {
        apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    inner_y += Scale(70)

    if Slider((SliderProps){.id = 4,
                    .bounds = {inner_x, inner_y, inner_w, Scale(56)},
                    .label = GetLocaleText("pause_after_round_label"),
                    .kind = NumericInt, .int_values = &pause_seconds,
                    .value_count = 1, .min = SETTINGS_PAUSE_MIN,
                    .max = SETTINGS_PAUSE_MAX, .format = "%ds"}) {
        apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }

    return y + card_h + Scale(16)
}

whm_config_draw_options_card :: (app: InnerBreeze*, content_x: int, content_w: int,
                                y: int) -> int #private {
    double_tap_to_breathe := app->double_tap_to_breathe
    advanced_session_controls := app->advanced_session_controls
    retention_marker_enabled := app->retention_marker_enabled
    card_h := whm_config_options_card_height()
    card_pad := Scale(18)
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad
    toggle_w := Scale(56)
    toggle_h := Scale(30)

    whm_config_draw_card(content_x, y, content_w, card_h)

    Text((TextProps){
        .bounds={(inner_x), (inner_y), 0, 0},
        .text=(GetLocaleText("double_tap_to_breathe_label")),
        .wrap=TextWrapNone
    })
    if Toggle((ToggleProps){.id = 0,
                       .bounds = {inner_x + inner_w - toggle_w,
                                  inner_y + (Scale(52) - toggle_h) / 2,
                                  toggle_w, toggle_h},
                       .value = &double_tap_to_breathe,
                       .off_label = GetLocaleText("toggle_off"),
                       .on_label = GetLocaleText("toggle_on")}) {
        app->double_tap_to_breathe = double_tap_to_breathe
        app->settings_dirty = 1
    }
    inner_y += Scale(72)

    Text((TextProps){
        .bounds={(inner_x), (inner_y), 0, 0},
        .text=(GetLocaleText("advanced_session_controls_label")),
        .wrap=TextWrapNone
    })
    if Toggle((ToggleProps){.id = 0,
                       .bounds = {inner_x + inner_w - toggle_w,
                                  inner_y + (Scale(52) - toggle_h) / 2,
                                  toggle_w, toggle_h},
                       .value = &advanced_session_controls,
                       .off_label = GetLocaleText("toggle_off"),
                       .on_label = GetLocaleText("toggle_on")}) {
        app->advanced_session_controls = advanced_session_controls
        app->settings_dirty = 1
    }
    inner_y += Scale(72)

    Text((TextProps){
        .bounds={(inner_x), (inner_y), 0, 0},
        .text=(GetLocaleText("retention_marker_label")),
        .wrap=TextWrapNone
    })
    if Toggle((ToggleProps){.id = 0,
                       .bounds = {inner_x + inner_w - toggle_w,
                                  inner_y + (Scale(52) - toggle_h) / 2,
                                  toggle_w, toggle_h},
                       .value = &retention_marker_enabled,
                       .off_label = GetLocaleText("toggle_off"),
                       .on_label = GetLocaleText("toggle_on")}) {
        app->retention_marker_enabled = retention_marker_enabled
        app->retention_marker_last_bucket = 0
        app->settings_dirty = 1
    }

    return y + card_h + Scale(16)
}

whm_config_draw_reset_button :: (app: InnerBreeze*, content_x: int, content_w: int,
                                y: int) -> int #private {
    speed := app->breathing.speed_level
    max_rounds := app->breathing.max_rounds
    max_breaths := int_from_count(app->breathing.maxbreaths)
    pause_seconds := app->breathing.pause_seconds
    reset_w := AppTextWidth(GetLocaleText("reset_to_defaults_label"),
                          AppFontSize()) + Scale(24)
    reset_h := Scale(48)


    if reset_w > content_w {
        reset_w = content_w
    }
    if Button((ButtonProps){
        .bounds = {(float)(content_x + content_w - reset_w), (float)(y), (float)(reset_w), (float)(reset_h)},
        .label = GetLocaleText("reset_to_defaults_label"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        speed = DefaultSpeedLevel
        max_rounds = DefaultMaxRounds
        max_breaths = DefaultMaxBreaths
        pause_seconds = DefaultPauseSeconds
        app->breathing.progressive_start_speed = DefaultProgressiveStartSpeed
        app->settings_preview.progressive_start_speed = DefaultProgressiveStartSpeed
        app->breathing.breath_animation = BreathAnimationLinear
        app->settings_preview.breath_animation = BreathAnimationLinear
        app->advanced_session_controls = 0
        app->double_tap_to_breathe = 0
        apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    return y + reset_h + Scale(24)
}

whm_config_draw_combined :: (app: InnerBreeze*, content_x: int, content_w: int,
                            y: int, draw_breath_animation_menu: int*) -> int #private {
    y = whm_config_draw_breath_card(app, content_x, content_w, y,
                                    draw_breath_animation_menu)
    y = whm_config_draw_session_card(app, content_x, content_w, y)
    y = whm_config_draw_options_card(app, content_x, content_w, y)
    y += Scale(24)

    meditation_music_draw_practice_settings(app, EXERCISE_WIM_HOF,
                                            content_x, content_w, &y, 0, 1)
    y += Scale(12)
    y = whm_config_draw_reset_button(app, content_x, content_w, y)

    return y
}

whm_config_content_height :: (app: InnerBreeze*, content_w: int) -> int #private {
    integrated := app->breathing.screen == ScreenStart &&
                  app->modal.type != UIModalPracticeConfig
    bottom_padding := (integrated ? app_content_bottom_reserved(app) : 0) +
                      Scale(24)

    return whm_config_breath_card_height(app) + Scale(16) +
           whm_config_session_card_height() + Scale(16) +
           whm_config_options_card_height() + Scale(40) +
           meditation_music_measure_practice_settings(app, EXERCISE_WIM_HOF,
                                                      content_w, 0, 1) +
           Scale(12) +
           Scale(48) + Scale(24) +
           bottom_padding
}

whm_config_screen_draw :: (app: InnerBreeze*) {
    layout := (PracticeSubscreenLayout){0}
    draw_breath_animation_menu := 0
    side_padding := GetPageSidePadding()
    max_content_w := Scale(CONTENT_MAX_W)
    content_x := 0
    content_w := 0

    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        app->settings_drag_slider = 0
    }
    if app->practice_config_tab < 0 || app->practice_config_tab > 1 {
        app->practice_config_tab = 0
    }

    practice_screen_config_layout(app, UIModalPracticeConfig, 0, &layout)
    practice_screen_handle_config_title(app, GetLocaleText("practice_configure_button"),
                                           UIModalPracticeConfig, nil)

    if max_content_w > view_width - side_padding * 2 {
        max_content_w = view_width - side_padding * 2
    }
    if max_content_w < Scale(320) {
        max_content_w = Scale(320)
    }
    GetCenteredColumn(max_content_w, side_padding, &content_x, &content_w)
    content_h := whm_config_content_height(app, content_w)

    Scroll page: {
        bounds = (Rectangle){(float)0, (float)layout.scroll_y,
                             (float)view_width, (float)layout.scroll_h}
        content_height = content_h
        scroll_offset = &app->settings_scroll

        whm_config_draw_combined(app, content_x, content_w,
                                 (int)page.y, &draw_breath_animation_menu)
    }

    if app->modal.active && app->modal.type == UIModalEditProgressiveStartSpeed {
        whm_draw_progressive_start_speed_editor(app)
    }
}
