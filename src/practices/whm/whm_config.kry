#import "app.h"
#import "practices/meditation/meditation_music.h"
#import "practices/whm/whm_practice.h"
#import "practices/whm/whm_session.h"
#import "screens/practice_screen.h"
#import "src/screens/settings/settings_ui.h"

whm_draw_exact_speed_preview :: (preview: Inbe*, preview_speed: int*,
                                speed: int, max_rounds: int, max_breaths: int,
                                pause_seconds: int, content_w: int,
                                content_h: int, center_x: int, center_y: int) #private {
    if preview == nil || preview_speed == nil {
        return
    }

    if preview->phase != InbePhaseBreathe {
        inbeinit(preview)
        apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
        preview->progressive_speed = 0
        session_reset_round_breathe(preview)
    } else if *preview_speed != speed {
        apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
        preview->progressive_speed = 0
    }

    if *preview_speed != speed {
        *preview_speed = speed
    }

    update_preview_bounds(preview, content_w, content_h)
    inbestep(preview)
    draw_preview_inbe(preview, center_x, center_y)
}

whm_draw_progressive_start_speed_editor :: (app: InbeApp*) #private {
    modal_w := ScaleUIPx(340)
    modal_h := ScaleUIPx(360)
    modal_x := 0
    modal_y := 0
    title_font := GetUIFontSize()
    title_y := 0
    close_size := ScaleUIPx(22)
    close_padding := ScaleUIPx(8)
    close_w := close_size + close_padding * 2
    close_hover := 0
    max_speed := app->inbe.speed_level
    start_speed := clampi(app->inbe.progressive_start_speed,
                          SETTINGS_SPEED_MIN, max_speed)
    title: const char* = nil
    title_w := 0
    title_max_w := 0

    if modal_w > view_width - ScaleUIPx(24) {
        modal_w = view_width - ScaleUIPx(24)
    }
    if modal_h > view_height - ScaleUIPx(24) {
        modal_h = view_height - ScaleUIPx(24)
    }
    modal_x = (view_width - modal_w) / 2
    modal_y = (view_height - modal_h) / 2
    title_y = modal_y + ScaleUIPx(14)

    SetUIModalCapture((Rectangle){
        (float)modal_x,
        (float)modal_y,
        (float)modal_w,
        (float)modal_h
    })
    DrawRectangle(0, 0, view_width, view_height, (Color){0, 0, 0, 180})
    DrawRectangle(modal_x, modal_y, modal_w, modal_h, GetThemeSurface())
    Bevel(modal_x, modal_y, modal_w, modal_h,
                   LightenUIColor(GetThemeSurface(), 40),
                   DarkenUIColor(GetThemeSurface(), 40))

    title = GetLocaleText("progressive_start_speed_editor_title")
    title_w = TextWidth(title, title_font)
    title_max_w = modal_w - close_w * 2 - ScaleUIPx(24)
    while title_font > Text12 && title_w > title_max_w {
        title_font--
        title_w = TextWidth(title, title_font)
    }
    Text(title, modal_x + (modal_w - title_w) / 2, title_y,
                  title_font, GetThemeText())

    if PaddedIconBtn(0, modal_x + modal_w - close_w - ScaleUIPx(6),
                           modal_y + ScaleUIPx(6), close_size, close_padding,
                           app->icons[UI_ICON_TYPE_X], &close_hover) {
        app_close_modal(app)
        return
    }

    whm_draw_exact_speed_preview(&app->start_speed_preview,
                                    &app->start_speed_preview_speed,
                                    start_speed,
                                    app->inbe.max_rounds,
                                    int_from_count(app->inbe.maxbreaths),
                                    app->inbe.pause_seconds,
                                    modal_w - ScaleUIPx(48),
                                    ScaleUIPx(210),
                                    modal_x + modal_w / 2,
                                    modal_y + ScaleUIPx(150))

    if Slider(12, modal_x + ScaleUIPx(24), modal_y + ScaleUIPx(250),
                    modal_w - ScaleUIPx(48),
                    GetLocaleText("progressive_start_speed_label"),
                    SETTINGS_SPEED_MIN, max_speed, &start_speed, "", nil) {
        app->inbe.progressive_start_speed = start_speed
        app->settings_dirty = 1
    }
}

whm_draw_subtab_bar :: (y: int, h: int, tab_names: const char**,
                       tab_count: int, selected_tab: int) -> int #private {
    tabs: [8] Subtab = {0}

    if tab_count <= 0 || tab_count > 8 {
        return -1
    }
    for int i = 0; i < tab_count; i++ {
        tabs[i] = (Subtab){0}
        tabs[i].label = tab_names[i]
        tabs[i].disabled = 0
    }
    return SubtabBar((SubtabBarProps){
        .bounds = {0, (float)y, (float)view_width, (float)h},
        .tabs = tabs,
        .count = tab_count,
        .selected_index = selected_tab
    })
}

whm_config_draw_breathing_tab :: (app: InbeApp*, content_x: int, content_w: int,
                                 y: int, draw_breath_animation_menu: int*) -> int #private {
    animation_options: [InbeBreathAnimationCount] const char* = {0}
    preview_h := ScaleUIPx(240)
    preview_radius := 0
    preview_padding := ScaleUIPx(12)
    speed := app->inbe.speed_level
    max_rounds := app->inbe.max_rounds
    max_breaths := int_from_count(app->inbe.maxbreaths)
    pause_seconds := app->inbe.pause_seconds
    progressive_start_speed := app->inbe.progressive_start_speed
    progressive_speed := app->inbe.progressive_speed
    toggle_w := ScaleUIPx(56)
    toggle_h := ScaleUIPx(30)

    animation_options[InbeBreathAnimationLinear] = GetLocaleText("breath_animation_linear")
    animation_options[InbeBreathAnimationInOut] = GetLocaleText("breath_animation_in_out")
    app->inbe.breath_animation = clampi(app->inbe.breath_animation,
                                        InbeBreathAnimationLinear,
                                        InbeBreathAnimationCount - 1)

    Text(GetLocaleText("breath_animation_label"), content_x, y,
                  GetUIFontSize(), GetThemeText())
    if Dropdown(104, content_x, y + ScaleUIPx(26), content_w,
                            ScaleUIPx(36), animation_options,
                            InbeBreathAnimationCount,
                            &app->inbe.breath_animation) {
        app->inbe.breath_animation = clampi(app->inbe.breath_animation,
                                            InbeBreathAnimationLinear,
                                            InbeBreathAnimationCount - 1)
        app->settings_preview.breath_animation = app->inbe.breath_animation
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    if draw_breath_animation_menu != nil {
        *draw_breath_animation_menu = 1
    }
    y += ScaleUIPx(76)

    update_preview_bounds(&app->settings_preview, content_w, preview_h)
    apply_settings(&app->settings_preview, speed, max_rounds,
                      max_breaths, pause_seconds)
    app->settings_preview.progressive_speed = 0
    inbestep(&app->settings_preview)
    if app->settings_preview.phase != InbePhaseBreathe {
        reset_settings_preview(app)
        update_preview_bounds(&app->settings_preview, content_w, preview_h)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_preview.progressive_speed = 0
    }

    preview_radius = (int)((float)app->settings_preview.rmax * 0.72f + 1.0f)
    draw_preview_inbe(&app->settings_preview, content_x + content_w / 2,
                         y + preview_padding + preview_radius)
    if Slider(1, content_x, y + preview_padding + preview_radius * 2 +
                       ScaleUIPx(28), content_w, GetLocaleText("speed_label"),
                    SETTINGS_SPEED_MIN, SETTINGS_SPEED_MAX, &speed, "", nil) {
        apply_settings(&app->inbe, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    y += preview_padding + preview_radius * 2 + ScaleUIPx(102)

    Text(GetLocaleText("progressive_speed_label"), content_x, y,
                  GetUIFontSize(), GetThemeText())
    if Toggle(0, content_x, y + ScaleUIPx(26), toggle_w, toggle_h,
                          &progressive_speed, GetLocaleText("toggle_off"),
                          GetLocaleText("toggle_on")) {
        app->inbe.progressive_speed = progressive_speed
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    y += ScaleUIPx(66)

    if app->inbe.progressive_speed {
        modify_w := TextWidth(GetLocaleText("modify_start_speed_button"),
                                  GetUIFontSize()) + ScaleUIPx(24)
        modify_hover := 0

        if modify_w > content_w {
            modify_w = content_w
        }
        if progressive_start_speed != clampi(progressive_start_speed,
                                             SETTINGS_SPEED_MIN, speed) {
            app->inbe.progressive_start_speed =
                clampi(progressive_start_speed, SETTINGS_SPEED_MIN, speed)
            app->settings_preview.progressive_start_speed =
                app->inbe.progressive_start_speed
            app->settings_dirty = 1
        }
        if StyledButton(content_x, y, modify_w, ScaleUIPx(36),
                               GetLocaleText("modify_start_speed_button"),
                               ButtonStyleSecondary, 0, &modify_hover) {
            app_open_modal(app, UIModalEditProgressiveStartSpeed)
        }
        y += ScaleUIPx(58)
    }

    return y
}

whm_config_draw_session_tab :: (app: InbeApp*, content_x: int, content_w: int,
                               y: int) -> int #private {
    speed := app->inbe.speed_level
    max_rounds := app->inbe.max_rounds
    max_breaths := int_from_count(app->inbe.maxbreaths)
    pause_seconds := app->inbe.pause_seconds
    double_tap_to_breathe := app->double_tap_to_breathe
    advanced_session_controls := app->advanced_session_controls
    retention_marker_enabled := app->retention_marker_enabled
    toggle_w := ScaleUIPx(56)
    toggle_h := ScaleUIPx(30)
    reset_w := TextWidth(GetLocaleText("reset_to_defaults_label"),
                             GetUIFontSize()) + ScaleUIPx(24)
    reset_h := ScaleUIPx(36)
    reset_hover := 0

    if Slider(2, content_x, y, content_w, GetLocaleText("max_rounds_label"),
                    1, MaxRounds, &max_rounds, "", nil) {
        apply_settings(&app->inbe, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    y += ScaleUIPx(66)

    if Slider(3, content_x, y, content_w, GetLocaleText("max_breaths_label"),
                    SETTINGS_BREATHS_MIN, SETTINGS_BREATHS_MAX,
                    &max_breaths, "", nil) {
        apply_settings(&app->inbe, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    y += ScaleUIPx(66)

    if Slider(4, content_x, y, content_w,
                    GetLocaleText("pause_after_round_label"),
                    SETTINGS_PAUSE_MIN, SETTINGS_PAUSE_MAX,
                    &pause_seconds, "s", nil) {
        apply_settings(&app->inbe, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    y += ScaleUIPx(66)

    Text(GetLocaleText("double_tap_to_breathe_label"), content_x, y,
                  GetUIFontSize(), GetThemeText())
    if Toggle(0, content_x, y + ScaleUIPx(26), toggle_w, toggle_h,
                          &double_tap_to_breathe, GetLocaleText("toggle_off"),
                          GetLocaleText("toggle_on")) {
        app->double_tap_to_breathe = double_tap_to_breathe
        app->settings_dirty = 1
    }
    y += ScaleUIPx(76)

    Text(GetLocaleText("advanced_session_controls_label"), content_x, y,
                  GetUIFontSize(), GetThemeText())
    if Toggle(0, content_x, y + ScaleUIPx(26), toggle_w, toggle_h,
                          &advanced_session_controls, GetLocaleText("toggle_off"),
                          GetLocaleText("toggle_on")) {
        app->advanced_session_controls = advanced_session_controls
        app->settings_dirty = 1
    }
    y += ScaleUIPx(76)

    Text(GetLocaleText("retention_marker_label"), content_x, y,
                  GetUIFontSize(), GetThemeText())
    if Toggle(0, content_x, y + ScaleUIPx(26), toggle_w, toggle_h,
                          &retention_marker_enabled, GetLocaleText("toggle_off"),
                          GetLocaleText("toggle_on")) {
        app->retention_marker_enabled = retention_marker_enabled
        app->retention_marker_last_bucket = 0
        app->settings_dirty = 1
    }
    y += ScaleUIPx(76)

    if reset_w > content_w {
        reset_w = content_w
    }
    if StyledButton(content_x + content_w - reset_w, y, reset_w, reset_h,
                           GetLocaleText("reset_to_defaults_label"),
                           ButtonStyleSecondary, 0, &reset_hover) {
        speed = DefaultSpeedLevel
        max_rounds = DefaultMaxRounds
        max_breaths = DefaultMaxBreaths
        pause_seconds = DefaultPauseSeconds
        app->inbe.progressive_start_speed = DefaultProgressiveStartSpeed
        app->settings_preview.progressive_start_speed = DefaultProgressiveStartSpeed
        app->inbe.breath_animation = InbeBreathAnimationLinear
        app->settings_preview.breath_animation = InbeBreathAnimationLinear
        app->advanced_session_controls = 0
        app->double_tap_to_breathe = 0
        apply_settings(&app->inbe, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(&app->settings_preview, speed, max_rounds,
                          max_breaths, pause_seconds)
        app->settings_dirty = 1
    }
    y += reset_h + ScaleUIPx(28)

    meditation_music_draw_practice_settings(app, EXERCISE_WIM_HOF,
                                            content_x, content_w, &y, 0, 1)

    return y
}

whm_config_content_height :: (app: InbeApp*, content_w: int) -> int #private {
    integrated := app->inbe.screen == InbeScreenStart &&
                  app->modal.type != UIModalPracticeConfig
    bottom_padding := (integrated ? app_content_bottom_reserved(app) : 0) +
                      ScaleUIPx(24)

    if app->practice_config_tab == 0 {
        span := content_w < ScaleUIPx(240) ? content_w : ScaleUIPx(240)
        preview_radius := span / 2
        h := 0

        if preview_radius < ScaleUIPx(60) {
            preview_radius = ScaleUIPx(60)
        }
        if preview_radius > ScaleUIPx(120) {
            preview_radius = ScaleUIPx(120)
        }
        preview_radius = (int)((float)preview_radius * 0.72f + 1.0f)
        h = ScaleUIPx(12) + preview_radius * 2 + ScaleUIPx(102)
        h += ScaleUIPx(66)
        if app->inbe.progressive_speed {
            h += ScaleUIPx(58)
        }
        h += ScaleUIPx(76)
        return h + bottom_padding
    }

    if app->practice_config_tab > 1 {
        app->practice_config_tab = 1
    }

    return ScaleUIPx(66) * 3 +
           ScaleUIPx(76) +
           ScaleUIPx(76) +
           ScaleUIPx(76) +
           ScaleUIPx(36) + ScaleUIPx(28) +
           meditation_music_measure_practice_settings(app, EXERCISE_WIM_HOF,
                                                      content_w, 0, 1) +
           bottom_padding
}

whm_config_scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    app := (InbeApp*)user_data

    return whm_config_content_height(app, content_w)
}

whm_config_screen_draw :: (app: InbeApp*) {
    layout := (PracticeSubscreenLayout){0}
    config_tab_h := ScaleUIPx(40)
    config_tab_gap := ScaleUIPx(14)
    draw_breath_animation_menu := 0
    clicked_config_tab := -1
    config_tabs: [2] const char* = {
        GetLocaleText("settings_section_breathing"),
        GetLocaleText("settings_section_session")
    }

    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        app->settings_drag_slider = 0
    }
    if app->practice_config_tab < 0 || app->practice_config_tab > 1 {
        app->practice_config_tab = 0
    }

    practice_screen_config_layout(app, UIModalPracticeConfig,
                                     config_tab_h + config_tab_gap, &layout)
    practice_screen_handle_config_title(app, GetLocaleText("practice_config_title"),
                                           UIModalPracticeConfig, nil)

    clicked_config_tab = whm_draw_subtab_bar(layout.title_h, config_tab_h,
                                             config_tabs, 2,
                                             app->practice_config_tab)
    if clicked_config_tab >= 0 && clicked_config_tab != app->practice_config_tab {
        route := app_current_route(app)
        route.practice_config_tab = clicked_config_tab
        app->settings_scroll = 0
        app_switch_route(app, route)
    }

    page := BeginUIScrollPage((UIScrollPageSpec){
        .y = layout.scroll_y,
        .height = layout.scroll_h,
        .max_content_width = ScaleUIPx(CONTENT_MAX_W),
        .min_content_width = ScaleUIPx(320),
        .scroll_offset = &app->settings_scroll,
        .content_height = whm_config_scroll_page_content_height,
        .user_data = app
    })

    if app->practice_config_tab == 0 {
        whm_config_draw_breathing_tab(app, page.content_x, page.content_w,
                                         page.content_y,
                                         &draw_breath_animation_menu)
    } else {
        whm_config_draw_session_tab(app, page.content_x, page.content_w,
                                       page.content_y)
    }
    EndUIScrollPage(page)

    if app->modal.active && app->modal.type == UIModalEditProgressiveStartSpeed {
        whm_draw_progressive_start_speed_editor(app)
    }
}
