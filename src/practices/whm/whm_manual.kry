#import "app.h"
#import "app/app_settings.h"
#import "practices/whm/whm_practice.h"
#import "practices/whm/whm_session.h"
#import "screens/manual_screen.h"
#import "screens/practice_screen.h"

static tutorial_keys: [4] const char* = {
    "tutorial_step_intro",
    "tutorial_step_breathe",
    "tutorial_step_exhale_hold",
    "tutorial_step_inhale_hold"
}

static tutorial_title_keys: [4] const char* = {
    "tutorial_title_before_begin",
    "tutorial_title_breathe",
    "tutorial_title_exhale_hold",
    "tutorial_title_recovery_breath"
}

WhmManualScrollPageContext :: struct {
    app: InnerBreeze*
    step: int
}

tutorial_steps_count :: () -> int #private {
    return 4
}

manual_text_color_for_background :: (background: Color) -> Color #private {
    luma := background.r * 299 + background.g * 587 + background.b * 114

    return luma >= 128000 ? BLACK : WHITE
}

draw_tutorial_hold_preview :: (app: InnerBreeze*, center_x: int, center_y: int, radius: int) #private {
    previous_phase := app->breathing.phase
    previous_count: [CountSize] char = {0}
    previous_sectick := app->breathing.sectick
    previous_r := app->breathing.r
    text_color := manual_text_color_for_background(GetThemeCircle())
    text: [CountSize] char = {0}
    display_text: [8] char = {0}

    cpcount(previous_count, app->breathing.count)
    snprintf(text, sizeof(text), "0")
    snprintf(display_text, sizeof(display_text), "0:00")

    app->breathing.phase = BreathPhaseHold
    cpcount(app->breathing.count, text)
    app->breathing.sectick = app->breathing.frame % 60
    app->breathing.r = (float)radius
    draw_session_progress_circle(app, center_x, center_y, (float)radius)
    Text((TextProps){
        .bounds = {(float)(center_x - radius), (float)(center_y - radius),
                   (float)(radius * 2), (float)(radius * 2)},
        .text = display_text,
        .color = text_color,
        .wrap = TextWrapNone,
        .align = TextAlignCenter,
        .vertical_align = TextAlignCenter
    })

    app->breathing.phase = previous_phase
    cpcount(app->breathing.count, previous_count)
    app->breathing.sectick = previous_sectick
    app->breathing.r = previous_r
}

tutorial_paragraph :: (app: InnerBreeze*, step: int, content_w: int) -> ParagraphSpec #private {
    paragraph := manual_screen_tutorial_paragraph(
        GetLocaleText(tutorial_keys[step]), content_w)

    return paragraph
}

tutorial_header_height :: () -> int #private {
    return manual_screen_guide_header_height()
}

draw_tutorial_header :: (step: int, content_x: int, y: int*, content_w: int) #private {
    manual_screen_draw_guide_header(GetLocaleText(tutorial_title_keys[step]),
                                    step, tutorial_steps_count(),
                                    content_x, y, content_w)
}

tutorial_paragraph_height :: (app: InnerBreeze*, step: int, content_w: int) -> int #private {
    return GetNodeHeight(NodeParagraph(tutorial_paragraph(app, step, content_w), 0, 0))
}

tutorial_safety_warning :: (content_w: int) -> ParagraphSpec #private {
    warning := manual_screen_tutorial_paragraph(
        GetLocaleText("tutorial_safety_warning"), content_w - Scale(84))

    warning.color = GetThemeText()
    return warning
}

tutorial_safety_warning_top_gap :: () -> int #private {
    return Scale(34)
}

tutorial_safety_warning_height :: (content_w: int) -> int #private {
    return GetNodeHeight(NodeParagraph(
               tutorial_safety_warning(content_w), 0, 0)) + Scale(36)
}

whm_manual_breath_visual_height :: () -> int #private {
    return Scale(238)
}

whm_manual_breath_info_height :: () -> int #private {
    return Scale(86)
}

whm_manual_hold_visual_height :: () -> int #private {
    return Scale(238)
}

whm_manual_hint :: (text: const char*, content_w: int) -> ParagraphSpec #private {
    hint_w := content_w - Scale(72)

    if hint_w < Scale(160) {
        hint_w = content_w - Scale(32)
    }
    hint := manual_screen_tutorial_paragraph(text, hint_w)

    hint.icon_type = UI_ICON_TYPE_ACTIVITY
    hint.icon_size = Scale(28)
    hint.align = TextAlignCenter
    return hint
}

whm_manual_hint_height :: (text_key: const char*, content_w: int) -> int #private {
    hint_text: [512] char = {0}

    snprintf(hint_text, sizeof(hint_text), "%%i %s", GetLocaleText(text_key))
    text_h := GetNodeHeight(NodeParagraph(
        whm_manual_hint(hint_text, content_w), 0, 0))
    min_h := Scale(112)
    h := text_h + Scale(42)

    if h < min_h {
        h = min_h
    }
    return h
}

draw_tutorial_paragraph :: (app: InnerBreeze*, step: int, content_x: int, y: int*, content_w: int) #private {
    Paragraph(tutorial_paragraph(app, step, content_w), content_x, y)
}

manual_tutorial_content_height :: (app: InnerBreeze*, step: int, content_w: int) -> int #private {
    actual_content_h := tutorial_header_height()

    if step == 0 {
        actual_content_h += Scale(242) + Scale(16) +
                            tutorial_paragraph_height(app, 0, content_w) +
                            tutorial_safety_warning_top_gap() +
                            tutorial_safety_warning_height(content_w)
    } else if step == 1 {
        actual_content_h += whm_manual_breath_visual_height() +
                            Scale(18) +
                            tutorial_paragraph_height(app, 1, content_w) +
                            Scale(24) +
                            whm_manual_breath_info_height()
    } else if step == 2 {
        actual_content_h += whm_manual_hold_visual_height() +
                            Scale(18) +
                            tutorial_paragraph_height(app, 2, content_w) +
                            Scale(24) +
                            whm_manual_hint_height(
                                "tutorial_step_exhale_hold_hint", content_w)
    } else {
        actual_content_h += Scale(242) + Scale(16) +
                            tutorial_paragraph_height(app, 3, content_w) +
                            Scale(24) +
                            whm_manual_hint_height(
                                "tutorial_step_inhale_hold_hint", content_w)
    }

    return actual_content_h
}

whm_manual_scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (WhmManualScrollPageContext*)user_data

    return manual_tutorial_content_height(ctx->app, ctx->step, content_w)
}

whm_manual_close :: (app: InnerBreeze*, mark_seen: int) {
    if mark_seen {
        mark_exercise_manual_seen(app, EXERCISE_WIM_HOF)
    }
    if app != NULL && app->modal.active && app->modal.type == UIModalPracticeManual {
        app_close_modal(app)
        return
    }
    app->tutorial_step = 0
    app->manual_scroll = 0
    app->practice_tab = PRACTICE_TAB_PLAY
    app_switch_screen(app, ScreenStart)
}

manual_screen_start_exercise :: (app: InnerBreeze*) #private {
    mark_exercise_manual_seen(app, EXERCISE_WIM_HOF)
    app->tutorial_step = 0
    app->manual_scroll = 0
    app->practice_tab = PRACTICE_TAB_PLAY
    session_start(app)
}

whm_manual_draw_breath_visual :: (app: InnerBreeze*, page: UIScrollPage, y: int*) #private {
    speed := app->breathing.speed_level
    visual_h := whm_manual_breath_visual_height()
    hero := manual_screen_hero_bounds(page.content_x, page.content_w,
                                      *y, visual_h)
    center_x := page.content_x + page.content_w / 2
    center_y := *y + visual_h / 2 - Scale(8)
    outer := Scale(104)
    ring_thick := Scale(4)

    DrawRectangleGradientV((int)hero.x, (int)hero.y,
                           (int)hero.width, (int)hero.height,
                           Fade(GetThemeLink(), 0.10f),
                           Fade(GetThemeBackground(), 0.0f))
    DrawCircleGradient((Vector2){(float)center_x, (float)center_y},
                       (float)outer + Scale(18),
                       Fade(GetThemeLink(), 0.20f),
                       Fade(GetThemeBackground(), 0.0f))
    apply_settings(&app->settings_preview, speed, app->breathing.max_rounds,
                      int_from_count(app->breathing.maxbreaths),
                      app->breathing.pause_seconds)
    update_preview_bounds(&app->settings_preview, page.content_w, visual_h)
    app->settings_preview.progressive_speed = 0
    breath_session_step(&app->settings_preview)
    if app->settings_preview.phase != BreathPhaseBreathe {
        reset_settings_preview(app)
        apply_settings(&app->settings_preview, speed, app->breathing.max_rounds,
                          int_from_count(app->breathing.maxbreaths),
                          app->breathing.pause_seconds)
        update_preview_bounds(&app->settings_preview, page.content_w, visual_h)
        app->settings_preview.progressive_speed = 0
    }
    draw_breath_preview(&app->settings_preview, center_x, center_y)
    DrawRing((Vector2){(float)center_x, (float)center_y},
             (float)(outer - ring_thick), (float)outer,
             0.0f, 360.0f, 64, Fade(GetThemeLink(), 0.60f))
    manual_screen_draw_hero_progress(hero, 1, tutorial_steps_count())
    *y += visual_h
}

whm_manual_draw_breath_info :: (app: InnerBreeze*, page: UIScrollPage, y: int*) #private {
    speed := app->breathing.speed_level
    row_h := whm_manual_breath_info_height()
    pad := Scale(18)

    DrawRectangleRounded((Rectangle){(float)page.content_x, (float)*y,
                                     (float)page.content_w, (float)row_h},
                         0.14f, 10, Fade(GetThemeSurface(), 0.54f))
    if Slider(490, page.content_x + pad, *y + Scale(12),
                    page.content_w - pad * 2,
                    GetLocaleText("speed_label"),
                    SETTINGS_SPEED_MIN, SETTINGS_SPEED_MAX,
                    &speed, "", nil) {
        apply_settings(&app->breathing, speed, app->breathing.max_rounds,
                          int_from_count(app->breathing.maxbreaths),
                          app->breathing.pause_seconds)
        apply_settings(&app->settings_preview, speed, app->breathing.max_rounds,
                          int_from_count(app->breathing.maxbreaths),
                          app->breathing.pause_seconds)
        app->settings_preview.progressive_speed = 0
        app->settings_dirty = 1
    }
    *y += row_h
}

whm_manual_draw_hold_preview :: (app: InnerBreeze*, page: UIScrollPage, y: int*) #private {
    visual_h := whm_manual_hold_visual_height()
    hero := manual_screen_hero_bounds(page.content_x, page.content_w,
                                      *y, visual_h)
    hold_preview_radius := Scale(68)
    center_x := page.content_x + page.content_w / 2
    center_y := *y + visual_h / 2 - Scale(8)

    DrawRectangleGradientV((int)hero.x, (int)hero.y,
                           (int)hero.width, (int)hero.height,
                           Fade(GetThemeLink(), 0.10f),
                           Fade(GetThemeBackground(), 0.0f))
    DrawCircleGradient((Vector2){(float)center_x, (float)center_y},
                       (float)hold_preview_radius + Scale(34),
                       Fade(GetThemeLink(), 0.18f),
                       Fade(GetThemeBackground(), 0.0f))
    draw_tutorial_hold_preview(app, center_x, center_y, hold_preview_radius)
    manual_screen_draw_hero_progress(hero, 2, tutorial_steps_count())
    *y += visual_h
}

whm_manual_draw_hint_card :: (page: UIScrollPage, y: int*, text_key: const char*) #private {
    card_h := whm_manual_hint_height(text_key, page.content_w)
    hint_text: [512] char = {0}
    pad := Scale(36)
    text_x := page.content_x + pad
    text_w := page.content_w - pad * 2
    hint: ParagraphSpec
    hint_h: int
    hint_y: int

    snprintf(hint_text, sizeof(hint_text), "%%i %s", GetLocaleText(text_key))
    hint = whm_manual_hint(hint_text, page.content_w)
    hint_h = GetNodeHeight(NodeParagraph(hint, 0, 0))
    hint_y = *y + (card_h - hint_h) / 2

    if text_w < Scale(160) {
        pad = Scale(16)
        text_x = page.content_x + pad
        text_w = page.content_w - pad * 2
        hint.width = text_w
        hint_h = GetNodeHeight(NodeParagraph(hint, 0, 0))
        hint_y = *y + (card_h - hint_h) / 2
    }

    DrawRectangleRounded((Rectangle){(float)page.content_x, (float)*y,
                                     (float)page.content_w, (float)card_h},
                         0.16f, 10, Fade(GetThemeSurface(), 0.58f))
    DrawRectangleRoundedLinesEx(
        (Rectangle){(float)page.content_x, (float)*y,
                    (float)page.content_w, (float)card_h},
        0.16f, 10, (float)Scale(1), Fade(GetThemeLink(), 0.46f))

    Paragraph(hint, text_x, &hint_y)
    *y += card_h
}

whm_manual_draw_page :: (app: InnerBreeze*, page: UIScrollPage, step: int, y: int*) #private {
    if step == 0 {
        img_h := Scale(242)
        warning_h := tutorial_safety_warning_height(page.content_w)
        warning_y := 0
        hero := manual_screen_hero_bounds(page.content_x, page.content_w,
                                          *y, img_h)

        TutorialImage(app->whm.image_1, "practices/whm/1.png",
                               (int)hero.x, *y, (int)hero.width, img_h)
        manual_screen_draw_hero_progress(hero, step, tutorial_steps_count())
        *y += img_h + Scale(16)
        draw_tutorial_header(step, page.content_x, y, page.content_w)
        draw_tutorial_paragraph(app, 0, page.content_x, y, page.content_w)
        *y += tutorial_safety_warning_top_gap()
        warning_bounds := (Rectangle){(float)page.content_x, (float)*y,
                                      (float)page.content_w, (float)warning_h}
        warning_color := GetThemeLink()
        icon_center_x := page.content_x + Scale(34)
        icon_center_y := *y + warning_h / 2
        icon_size := Scale(30)

        DrawRectangleRounded((Rectangle){(float)page.content_x, (float)*y,
                                         (float)page.content_w, (float)warning_h},
                             0.16f, 10, Fade(warning_color, 0.14f))
        DrawRectangleRoundedLinesEx(
            warning_bounds, 0.16f, 10, (float)Scale(1),
            Fade(warning_color, 0.64f))
        Icon(0, icon_center_x - icon_size / 2, icon_center_y - icon_size / 2,
             icon_size, UI_ICON_TYPE_WARNING, warning_color)
        warning_y = *y + Scale(18)
        Paragraph(tutorial_safety_warning(page.content_w),
                  page.content_x + Scale(64), &warning_y)
        *y += warning_h + Scale(6)
    } else if step == 1 {
        whm_manual_draw_breath_visual(app, page, y)
        *y += Scale(18)
        draw_tutorial_header(step, page.content_x, y, page.content_w)
        draw_tutorial_paragraph(app, 1, page.content_x, y, page.content_w)
        *y += Scale(24)
        whm_manual_draw_breath_info(app, page, y)
    } else if step == 2 {
        whm_manual_draw_hold_preview(app, page, y)
        *y += Scale(18)
        draw_tutorial_header(step, page.content_x, y, page.content_w)
        draw_tutorial_paragraph(app, 2, page.content_x, y, page.content_w)
        *y += Scale(24)
        whm_manual_draw_hint_card(page, y, "tutorial_step_exhale_hold_hint")
    } else {
        img_h := Scale(242)
        hero := manual_screen_hero_bounds(page.content_x, page.content_w,
                                          *y, img_h)

        TutorialImage(app->whm.image_2, "practices/whm/2.png",
                               (int)hero.x, *y, (int)hero.width, img_h)
        manual_screen_draw_hero_progress(hero, step, tutorial_steps_count())
        *y += img_h + Scale(16)
        draw_tutorial_header(step, page.content_x, y, page.content_w)
        draw_tutorial_paragraph(app, 3, page.content_x, y, page.content_w)
        *y += Scale(24)
        whm_manual_draw_hint_card(page, y, "tutorial_step_inhale_hold_hint")
    }
}

whm_manual_draw :: (app: InnerBreeze*) {
    layout := (PracticeManualLayout){0}
    footer_content_pad := 0
    step := clampi(app->tutorial_step, 0, tutorial_steps_count() - 1)

    app->tutorial_step = step

    practice_screen_manual_layout(app, UIModalPracticeManual,
                                     tutorial_steps_count(),
                                     manual_screen_tutorial_top_gap(),
                                     footer_content_pad, 0, &layout)
    manual_screen_draw_title_bar(app, GetLocaleText("practice_manual_button"),
                                 layout.title_h, whm_manual_close)
    responsive_max_w := (int)(view_width * 0.96f)
    max_content_w := manual_screen_tutorial_max_width()
    page_ctx := (WhmManualScrollPageContext){app, step}
    page := (UIScrollPage){0}
    y := 0

    if responsive_max_w > max_content_w {
        responsive_max_w = max_content_w
    }
    if responsive_max_w < Scale(280) {
        responsive_max_w = Scale(280)
    }

    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = layout.content_y,
        .height = layout.content_h,
        .max_content_width = responsive_max_w,
        .min_content_width = Scale(200),
        .side_padding = manual_screen_tutorial_side_padding(),
        .scroll_offset = &app->manual_scroll,
        .content_height = whm_manual_scroll_page_content_height,
        .user_data = &page_ctx
    })
    y = page.content_y
    whm_manual_draw_page(app, page, step, &y)
    EndUIScrollPage(page)

    manual_screen_guide_controls(app, (ManualGuideNav){
        .page = step,
        .page_count = tutorial_steps_count(),
        .y = layout.nav_y,
        .h = layout.nav_h,
        .content_y = layout.content_y,
        .content_h = layout.content_h,
        .focus_id = 400,
        .start = manual_screen_start_exercise,
        .close = whm_manual_close
    })
}
