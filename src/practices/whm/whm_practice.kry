#import "app.h"
#import "practices/whm/whm_practice.h"
#import "practices/whm/whm_session.h"

whm_practice_start :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_WIM_HOF)
    session_start(app)
}

whm_practice_leave_config :: (app: InnerBreeze*) {
    unused app
}
