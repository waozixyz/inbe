}

route session {
    title "Wim Hof Session"
    group "Practice"
    page session
}

session :: (app: InnerBreeze*) #ui {
    Screen root: {
    hover: int = 0
    practice_draw_active_breathing(app, view_width / 2, view_height / 2)
    practice_update_active_breathing(app, view_width / 2, view_height / 2, &hover)
    }
}

static whm_background_remainder_ms: int = 0
#if ANDROID {
    static whm_last_notification_text: [96] char = ""
}
text_color_for_background :: (background: Color) -> Color #private {
    luma: int = background.r * 299 + background.g * 587 + background.b * 114

    return luma >= 128000 ? BLACK : WHITE
}

set_circle_bounds :: (breathing: BreathSession*, rmin: int, rmax: int) #private {
    old_rmin: int
    old_rmax: int
    old_span: int
    new_span: int

    if breathing == nil {
        return
    }

    if rmin < 8 {
        rmin = 8
    }
    if rmax < rmin + 8 {
        rmax = rmin + 8
    }

    old_rmin = breathing->rmin
    old_rmax = breathing->rmax
    old_span = old_rmax - old_rmin
    new_span = rmax - rmin

    if old_span > 0 {
        t: float = (float)(breathing->r - old_rmin) / (float)old_span

        if t < 0.0f {
            t = 0.0f
        }
        if t > 1.0f {
            t = 1.0f
        }

        breathing->r = rmin + t * (float)new_span
    } else {
        breathing->r = rmin
    }

    breathing->rmin = rmin
    breathing->rmax = rmax
    if breathing->r < rmin {
        breathing->r = rmin
    }
    if breathing->r > rmax {
        breathing->r = rmax
    }
}

session_update_circle_bounds_for_view :: (breathing: BreathSession*, top_reserve: int, bottom_reserve: int) {
    available_w: int = view_width - CIRCLE_SIDE_PAD * 2
    available_h: int = view_height - top_reserve - bottom_reserve - CIRCLE_SIDE_PAD * 2
    rmax: int
    rmin: int

    if available_w < 0 {
        available_w = 0
    }
    if available_h < 0 {
        available_h = 0
    }

    rmax = available_w / 2
    if available_h / 2 < rmax {
        rmax = available_h / 2
    }
    if rmax < 24 {
        rmax = 24
    }

    rmin = rmax / 2
    if rmin < 16 {
        rmin = 16
    }
    if rmin > rmax - 8 {
        rmin = rmax - 8
    }
    set_circle_bounds(breathing, rmin, rmax)
}

update_preview_bounds :: (breathing: BreathSession*, content_w: int, content_h: int) {
    span: int = content_w
    rmax: int
    rmin: int

    if content_h > 0 && content_h < span {
        span = content_h
    }

    rmax = span / 2
    if rmax < Scale(60) {
        rmax = Scale(60)
    }
    if rmax > Scale(120) {
        rmax = Scale(120)
    }
    rmin = rmax / 2
    if rmin < Scale(24) {
        rmin = Scale(24)
    }
    if rmin > rmax - Scale(10) {
        rmin = rmax - Scale(10)
    }
    set_circle_bounds(breathing, rmin, rmax)
}

session_reset_round_breathe :: (breathing: BreathSession*) {
    breathing->phase = BreathPhaseBreathe
    breathing->dir = 0
    breathing->r = breathing->rmin
    breathing->breath_frame = 0
    breathing->breathtick = 0
    breathing->sectick = 0
    breathing->halftick = 0
    cpcount(breathing->count, "000")
}

reset_round_start :: (breathing: BreathSession*) #private {
    session_reset_round_breathe(breathing)
    if breathing->pause_seconds > 0 {
        breathing->phase = BreathPhaseStarting
    }
}

remember_sound_state :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }

    if app->breathing.screen != ScreenSession ||
       app->breathing.phase != BreathPhaseHold {
        app->retention_marker_last_bucket = 0
    }
    app->sound_last_screen = app->breathing.screen
    app->sound_last_phase = app->breathing.phase
    app->sound_last_dir = app->breathing.dir
    cpcount(app->sound_last_count, app->breathing.count)
}

update_retention_marker :: (app: InnerBreeze*, phase_changed: int) #private {
    seconds: int
    bucket: int

    if app == nil {
        return
    }
    if !app->retention_marker_enabled ||
       app->breathing.phase != BreathPhaseHold {
        app->retention_marker_last_bucket = 0
        return
    }
    if phase_changed {
        app->retention_marker_last_bucket = 0
    }

    seconds = int_from_count(app->breathing.count)
    bucket = seconds / 30
    if bucket <= 0 || bucket <= app->retention_marker_last_bucket {
        return
    }

    app->retention_marker_last_bucket = bucket
    app_play_bell_cue(app, 0.45f)
}

#if ANDROID {
session_update_notification :: (app: InnerBreeze*) #private {
    text: [96] char = ""
    count: int
    notification_pause: int

    if app == nil {
        return
    }

    if app->breathing.screen == ScreenResults {
        FormatLocaleText(text, sizeof(text), "notification_results")
    } else if app->breathing.screen == ScreenSession {
        count = int_from_count(app->breathing.count)
        switch app->breathing.phase {
        case BreathPhaseBreathe:
            FormatLocaleText(text, sizeof(text), "notification_breathing_count", count)
            break
        case BreathPhaseHold:
            FormatLocaleText(text, sizeof(text), "notification_hold_seconds", count)
            break
        case BreathPhaseRecover:
            FormatLocaleText(text, sizeof(text), "notification_breath_in_seconds", count)
            break
        case BreathPhaseStarting:
            notification_pause = effective_pause_seconds(&app->breathing)
            FormatLocaleText(text, sizeof(text), "notification_starting_seconds",
                          notification_pause > 0
                              ? notification_pause - app->breathing.sectick / 60
                              : 0)
            break
        case BreathPhaseNext:
        default:
            break
        }
    } else {
        return
    }

    if strcmp(text, whm_last_notification_text) == 0 {
        return
    }

    snprintf(whm_last_notification_text, sizeof(whm_last_notification_text), "%s", text)
    android_wakelock_update_session_notification(text)
}
}

update_session_sounds :: (app: InnerBreeze*) {
    if app == nil {
        return
    }

    if app->breathing.screen != ScreenSession ||
       (app->session_paused && !(app->backgrounded && app->breathing.play_in_background)) {
        remember_sound_state(app)
        return
    }

    screen_changed: int = app->sound_last_screen != ScreenSession
    phase_changed: int = app->sound_last_phase != app->breathing.phase
    dir_changed: int = app->sound_last_dir != app->breathing.dir
    count_changed: int = !(app->sound_last_count[0] == app->breathing.count[0] &&
                          app->sound_last_count[1] == app->breathing.count[1] &&
                          app->sound_last_count[2] == app->breathing.count[2])

    if app->breathing.phase == BreathPhaseBreathe {
        if screen_changed || phase_changed || dir_changed {
            app_play_breath_cue(app, app->breathing.dir)
        }
        if count_changed {
            count_value: int = int_from_count(app->breathing.count)
            maxbreaths_value: int = int_from_count(app->breathing.maxbreaths)
            if count_value == maxbreaths_value - 1 {
                app_play_bell_cue(app, 0.8f)
            }
        }
    } else if phase_changed {
        if app->breathing.phase == BreathPhaseNext && app->sound_last_phase == BreathPhaseRecover {
            app_play_breath_cue(app, 1)
        }
    }

    update_retention_marker(app, phase_changed)
    remember_sound_state(app)
}

session_background_start :: (app: InnerBreeze*) {
    if app == nil {
        return
    }
    whm_background_remainder_ms = 0
#if ANDROID {
    whm_last_notification_text[0] = '\0'
}
    remember_sound_state(app)
}

session_advance_elapsed :: (app: InnerBreeze*, elapsed_ms: int) {
    elapsed_total: int
    frame_count: int

    if app == nil || elapsed_ms <= 0 {
        return
    }
    if app->breathing.screen != ScreenSession || app->session_paused {
        return
    }

    elapsed_total = elapsed_ms + whm_background_remainder_ms
    if elapsed_total > 5 * 60 * 1000 {
        elapsed_total = 5 * 60 * 1000
    }

    frame_count = (elapsed_total * 60) / 1000
    whm_background_remainder_ms = elapsed_total - (frame_count * 1000) / 60

    for int i = 0; i < frame_count && app->breathing.screen == ScreenSession; i++ {
        breath_session_step(&app->breathing)
        if just_completed(&app->breathing) {
            session_complete(app)
            break
        }
        practice_update_session_sounds(app)
#if ANDROID {
        session_update_notification(app)
}
    }
}

session_start :: (app: InnerBreeze*) {
    speed: int = app->breathing.speed_level
    max_rounds: int = app->breathing.max_rounds
    max_breaths: int = int_from_count(app->breathing.maxbreaths)
    pause_seconds: int = app->breathing.pause_seconds
    progressive_speed: int = app->breathing.progressive_speed
    progressive_start_speed: int = app->breathing.progressive_start_speed
    play_in_background: int = app->breathing.play_in_background

    breath_session_init(&app->breathing)
    app->breathing.progressive_speed = progressive_speed
    app->breathing.progressive_start_speed = progressive_start_speed
    app->breathing.play_in_background = play_in_background
    apply_settings(&app->breathing, speed, max_rounds, max_breaths, pause_seconds)
    session_update_circle_bounds_for_view(&app->breathing, GetNodeHeight(NodeTitleBar(0)), Scale(56) + 80)
    app_switch_screen(app, ScreenSession)
    app->session_paused = 0
    app->results_saved = 0
    app->results_path[0] = '\0'
    app->retention_marker_last_bucket = 0
    remember_sound_state(app)

#if ANDROID {
    android_keep_screen_on()
}
    TraceLog(LOG_INFO, "APP: Starting session - play_in_background = %d", app->breathing.play_in_background)
    meditation_music_start_session(app)
    practice_background_start(app, PRACTICE_WHM)
#if ANDROID {
    whm_last_notification_text[0] = '\0'
    session_update_notification(app)
}
}

collect_result_rounds :: (app: InnerBreeze*, round_times: int*, max_rounds: int) -> int #private {
    rounds: int
    count: int = 0

    if app == nil || round_times == nil || max_rounds <= 0 {
        return 0
    }

    rounds = app->breathing.round + 1
    if rounds < 1 {
        rounds = 1
    }
    if rounds > app->breathing.max_rounds {
        rounds = app->breathing.max_rounds
    }
    if rounds > max_rounds {
        rounds = max_rounds
    }

    for int i = 0; i < rounds; i++ {
        seconds: int = int_from_count(app->breathing.results[i])
        if seconds > 0 {
            round_times[count++] = seconds
        }
    }

    return count
}

session_ensure_results_saved :: (app: InnerBreeze*) -> int {
    round_times: [MaxRounds] int
    rounds: int

    if app == nil {
        return 0
    }
    if app->results_saved {
        return 1
    }

    rounds = collect_result_rounds(app, round_times, MaxRounds)
    if rounds <= 0 {
        return 0
    }

    if data_save_session_path_for_activity(round_times, rounds,
                                           0,
                                           app != nil ? app->exercise_type : 0,
                                           app->results_path, sizeof(app->results_path)) {
        app->results_saved = 1
        sync_habits_for_activity(app, app->exercise_type)
        app_auto_sync(app)
        TraceLog(LOG_INFO, "APP: session saved successfully")
        return 1
    }

    TraceLog(LOG_WARNING, "APP: session save failed")
    return 0
}

session_discard_saved_results :: (app: InnerBreeze*) {
    if app == nil {
        return
    }

    if app->results_saved && app->results_path[0] != '\0' {
        if data_discard_session(app->results_path) {
            app->results_saved = 0
            app->results_path[0] = '\0'
        }
    }
}

session_has_completed_rounds :: (app: InnerBreeze*) -> int {
    round_times: [MaxRounds] int
    return collect_result_rounds(app, round_times, MaxRounds) > 0
}

finish_hold :: (app: InnerBreeze*) #private {
    end_hold(&app->breathing)
    app_play_breath_cue(app, 0)
}

finish_round :: (app: InnerBreeze*) #private {
    app->breathing.breathtick = 0
    app->breathing.sectick = 0
    cpcount(app->breathing.count, "000")

    if app->breathing.round < app->breathing.max_rounds - 1 {
        app->breathing.round++
        reset_round_start(&app->breathing)
    } else {
        clear_completed(&app->breathing)
        session_complete(app)
    }
}

session_complete :: (app: InnerBreeze*) #private {
    if session_ensure_results_saved(app) {
        round_times: [MaxRounds] int
        rounds := collect_result_rounds(app, round_times, MaxRounds)
        meditation_music_stop(app)
#if ANDROID {
        android_allow_screen_off()
        stop_android_background_session(app)
}
        app_notifications_send_session_complete(app)
        app_prepare_session_results(app, EXERCISE_WIM_HOF, 0, 0, nil,
                                    round_times, rounds, app->results_path)
        app_switch_screen(app, ScreenResults)
    } else {
        app_init(app)
    }
}

clear_round_results_from :: (app: InnerBreeze*, first_round: int) #private {
    if app == nil {
        return
    }

    if first_round < 0 {
        first_round = 0
    }
    if first_round >= MaxRounds {
        return
    }

    for int i = first_round; i < MaxRounds; i++ {
        cpcount(app->breathing.results[i], "000")
    }
    app->results_saved = 0
    app->results_path[0] = '\0'
}

session_round_has_starting_step :: (app: InnerBreeze*) -> int #private {
    if app == nil {
        return 0
    }

    return app->breathing.round == 0 || app->breathing.pause_seconds > 0
}

session_enter_starting_step :: (app: InnerBreeze*) #private {
    app->breathing.phase = BreathPhaseStarting
    app->breathing.dir = 0
    app->breathing.r = app->breathing.rmin
    app->breathing.breath_frame = 0
    app->breathing.breathtick = 0
    app->breathing.sectick = 0
    app->breathing.halftick = 0
    cpcount(app->breathing.count, "000")
}

session_enter_previous_round_last_step :: (app: InnerBreeze*) #private {
    if app->breathing.round <= 0 {
        return
    }

    clear_round_results_from(app, app->breathing.round)
    app->breathing.round--
    app->breathing.phase = BreathPhaseNext
    app->breathing.dir = 0
    app->breathing.r = app->breathing.rmax
    app->breathing.breath_frame = 0
    app->breathing.breathtick = 0
    app->breathing.sectick = 0
    app->breathing.halftick = 0
    cpcount(app->breathing.count, "000")
}

session_step_back :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }

    switch app->breathing.phase {
    case BreathPhaseStarting:
        if app->breathing.round > 0 {
            session_enter_previous_round_last_step(app)
        }
        else {
            session_enter_starting_step(app)
        }
        break
    case BreathPhaseBreathe:
        clear_round_results_from(app, app->breathing.round)
        if session_round_has_starting_step(app) {
            session_enter_starting_step(app)
        }
        else if app->breathing.round > 0 {
            session_enter_previous_round_last_step(app)
        }
        else {
            session_reset_round_breathe(&app->breathing)
        }
        break
    case BreathPhaseHold:
        clear_round_results_from(app, app->breathing.round)
        session_reset_round_breathe(&app->breathing)
        break
    case BreathPhaseRecover:
        app->breathing.phase = BreathPhaseHold
        app->breathing.dir = 0
        app->breathing.r = app->breathing.rmin
        app->breathing.breath_frame = 0
        app->breathing.breathtick = 0
        app->breathing.sectick = 0
        app->breathing.halftick = 0
        cpcount(app->breathing.count, app->breathing.results[app->breathing.round])
        clear_round_results_from(app, app->breathing.round)
        break
    case BreathPhaseNext:
        app->breathing.phase = BreathPhaseRecover
        app->breathing.dir = 0
        app->breathing.r = app->breathing.rmax
        app->breathing.breath_frame = 0
        app->breathing.breathtick = 0
        app->breathing.sectick = 0
        app->breathing.halftick = 0
        count_from_int(app->breathing.count, 14)
        break
    }

    remember_sound_state(app)
}

session_step_forward :: (app: InnerBreeze*) #private {
    switch app->breathing.phase {
    case BreathPhaseStarting:
        session_reset_round_breathe(&app->breathing)
        break
    case BreathPhaseBreathe:
        app->breathing.phase = BreathPhaseHold
        app->breathing.r = app->breathing.rmin
        app->breathing.breath_frame = 0
        app->breathing.breathtick = 0
        app->breathing.sectick = 0
        cpcount(app->breathing.count, "000")
        break
    case BreathPhaseHold:
        finish_hold(app)
        break
    case BreathPhaseRecover:
        app->breathing.phase = BreathPhaseNext
        app->breathing.breath_frame = 0
        app->breathing.sectick = 0
        cpcount(app->breathing.count, "000")
        break
    case BreathPhaseNext:
        finish_round(app)
        break
    }
}

draw_session_counter :: (app: InnerBreeze*, center_x: int, center_y: int) #private {
    text: [16] char
    count: int
    font: int = Text24
    text_color: Color = text_color_for_background(GetThemeCircle())
    display_text: const char* = app->breathing.count

    if app->breathing.phase == BreathPhaseStarting {
        total_seconds: int = effective_pause_seconds(&app->breathing)
        remaining: int

        if total_seconds <= 0 {
            remaining = 0
        }
        else {
            remaining = total_seconds - app->breathing.sectick / 60
            if remaining < 1 {
                remaining = 1
            }
        }
        snprintf(text, sizeof(text), "%d", remaining)
        display_text = text
    } else if app->breathing.phase == BreathPhaseRecover {
        if app->breathing.r < app->breathing.rmax {
            display_text = "000"
        } else {
            count = int_from_count(app->breathing.count)
            if count < 15 {
                count_from_int(text, 15 - count)
                display_text = text
            } else {
                display_text = "000"
            }
        }
    } else if app->breathing.phase == BreathPhaseNext {
        display_text = "000"
    }

    Text((TextProps){
        .bounds = {(float)(center_x - Scale(60)),
                   (float)(center_y - Scale(30)),
                   (float)Scale(120), (float)Scale(60)},
        .text = display_text,
        .font = font,
        .color = text_color,
        .wrap = TextWrapNone,
        .align = TextAlignCenter,
        .vertical_align = TextAlignCenter
    })
}

color_with_alpha :: (color: Color, alpha: unsigned char) -> Color #private {
    color.a = alpha
    return color
}

session_circle_progress :: (app: InnerBreeze*, total_ticks: int*, progress: float*,
                           countdown: int*) #private {
    total: int = int_from_count(app->breathing.maxbreaths)
    amount: float = 0.0f
    is_countdown: int = 0
    total_seconds: int = 0
    total_frames: int = 0
    frame_in_minute: int = 0
    count: int = 0

    if total < 1 {
        total = 1
    }

    if total_ticks == nil || progress == nil || countdown == nil {
        return
    }

    switch app->breathing.phase {
    case BreathPhaseStarting:
        total_seconds = effective_pause_seconds(&app->breathing)
        total_frames = total_seconds * 60

        total = total_seconds > 0 ? total_seconds : 1
        if total_frames > 0 {
            amount = (float)app->breathing.sectick / (float)total_frames
        }
        is_countdown = 1
        break
    case BreathPhaseBreathe:
        amount = ((float)clampi(int_from_count(app->breathing.count), 0, total) +
                  current_breath_progress(&app->breathing)) / (float)total
        break
    case BreathPhaseHold:
        total_frames = 60 * 60
        frame_in_minute = (int_from_count(app->breathing.count) * 60 + app->breathing.sectick) %
                          total_frames

        total = 60
        amount = (float)frame_in_minute / (float)total_frames
        break
    case BreathPhaseRecover:
        count = int_from_count(app->breathing.count)

        total = 15
        if app->breathing.r >= app->breathing.rmax {
            amount = ((float)clampi(count, 0, total) +
                      (float)clampi(app->breathing.sectick, 0, 59) / 60.0f) /
                     (float)total
        }
        is_countdown = 1
        break
    case BreathPhaseNext:
    default:
        amount = 0.0f
        break
    }

    if amount < 0.0f {
        amount = 0.0f
    }
    if amount > 1.0f {
        amount = 1.0f
    }

    *total_ticks = total
    *progress = amount
    *countdown = is_countdown
}

draw_session_progress_circle :: (app: InnerBreeze*, center_x: int, center_y: int, radius: float) {
    total_ticks: int = 1
    countdown: int = 0
    progress: float = 0.0f
    gap: int = Scale(5)
    band_width: int
    thickness: int
    inner_radius: float
    outer_radius: float
    circle: Color = GetThemeCircle()
    contrast: Color = text_color_for_background(circle)
    band_bg: Color
    band_fill: Color
    tick_done: Color
    tick_pending: Color
    ring: Color

    if app == nil {
        return
    }

    session_circle_progress(app, &total_ticks, &progress, &countdown)

    if total_ticks <= 20 {
        band_width = Scale(14)
    }
    else if total_ticks <= 40 {
        band_width = Scale(11)
    }
    else {
        band_width = Scale(8)
    }
    if band_width < 5 {
        band_width = 5
    }

    thickness = total_ticks <= 40 ? Scale(3) : Scale(2)
    if thickness < 1 {
        thickness = 1
    }

    outer_radius = radius - (float)gap
    inner_radius = outer_radius - (float)band_width
    if inner_radius < radius * 0.66f {
        inner_radius = radius * 0.66f
    }
    if outer_radius <= inner_radius {
        return
    }

    band_bg = color_with_alpha(contrast, 30)
    band_fill = color_with_alpha(contrast, 72)
    tick_pending = color_with_alpha(contrast, 96)
    tick_done = color_with_alpha(contrast, 235)
    ring = color_with_alpha(contrast, 175)

    DrawCircleV((Vector2){(float)center_x, (float)center_y}, radius, circle)
    DrawRing((Vector2){(float)center_x, (float)center_y}, inner_radius, outer_radius,
             0.0f, 360.0f, 128, band_bg)
    if countdown {
        if progress < 1.0f {
            DrawRing((Vector2){(float)center_x, (float)center_y}, inner_radius,
                     outer_radius, -450.0f, -90.0f - 360.0f * progress,
                     128, band_fill)
        }
    } else if progress > 0.0f {
        DrawRing((Vector2){(float)center_x, (float)center_y}, inner_radius, outer_radius,
                 -90.0f, -90.0f + 360.0f * progress, 128, band_fill)
    }
    DrawRing((Vector2){(float)center_x, (float)center_y}, inner_radius - 0.75f,
             inner_radius + 0.75f, 0.0f, 360.0f, 128, ring)
    DrawRing((Vector2){(float)center_x, (float)center_y}, outer_radius - 0.75f,
             outer_radius + 0.75f, 0.0f, 360.0f, 128, ring)

    for int i = 0; i < total_ticks; i++ {
        tick_progress: float = (float)i / (float)total_ticks
        direction: float = countdown ? -1.0f : 1.0f
        angle: float = -PI * 0.5f +
                      direction * ((float)i * 2.0f * PI) / (float)total_ticks
        s: float = sinf(angle)
        c: float = cosf(angle)
        if countdown && i == 0 {
            tick_progress = 1.0f
        }
        tick_colored: int = countdown ? tick_progress > progress + 0.0001f
                                     : tick_progress <= progress + 0.0001f
        start: Vector2 = {
            (float)center_x + c * inner_radius,
            (float)center_y + s * inner_radius
        }
        end: Vector2 = {
            (float)center_x + c * outer_radius,
            (float)center_y + s * outer_radius
        }

        DrawLineEx(start, end, (float)thickness,
                   tick_colored ? tick_done : tick_pending)
    }
}

session_draw_inbe :: (app: InnerBreeze*, center_x: int, center_y: int) {
    radius: float = draw_radius(&app->breathing)

    draw_session_progress_circle(app, center_x, center_y, radius)
    draw_session_counter(app, center_x, center_y)
}

session_draw_start_preview :: (app: InnerBreeze*, center_x: int, center_y: int) -> int {
    hovered: int = 0
    clicked: int = 0
    play_text: const char* = GetLocaleText("play_button")
    practice_text: const char* = practice_label(app->exercise_type)
    font: int = Text16
    practice_font: int = GetFontSize()
    practice_w: int
    practice_y: int
    scale: float = 1.0f

    radius: int = Scale(44)

    clicked = UIHandleCircleClick((Vector2){(float)center_x, (float)center_y},
                                  (float)radius, 0, &hovered)
    app->play_circle_hover = hovered


    target_scale: float = hovered ? 1.08f : 1.0f
    app->play_circle_scale += (target_scale - app->play_circle_scale) * 0.2f
    if app->play_circle_scale < 1.0f {
        app->play_circle_scale = 1.0f
    }
    if app->play_circle_scale > 1.08f {
        app->play_circle_scale = 1.08f
    }

    scale = app->play_circle_scale


    scaled_radius: int = (int)(radius * scale)
    practice_w = TextWidth(practice_text, practice_font)
    if practice_w > view_width - Scale(48) {
        practice_font = GetSmallFontSize()
    }
    practice_w = TextWidth(practice_text, practice_font)
    practice_y = center_y - scaled_radius - Scale(42)
    if practice_y < Scale(8) {
        practice_y = Scale(8)
    }
    Text((TextProps){
        .bounds={(center_x - practice_w / 2), (GetUIControlTextY(practice_text, practice_y, Scale(32), practice_font)), 0, 0},
        .text=(practice_text),
        .font=(practice_font),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })

    DrawCircle(center_x, center_y, scaled_radius, GetThemeCircle())
    DrawCircleLines(center_x, center_y, scaled_radius, GetThemeText())


    Text((TextProps){
        .bounds = {(float)(center_x - scaled_radius),
                   (float)(center_y - scaled_radius),
                   (float)(scaled_radius * 2), (float)(scaled_radius * 2)},
        .text = play_text,
        .font = font,
        .color = text_color_for_background(GetThemeCircle()),
        .wrap = TextWrapNone,
        .align = TextAlignCenter,
        .vertical_align = TextAlignCenter
    })

    return clicked
}

draw_session_status :: (app: InnerBreeze*, center_x: int, center_y: int) #private {
    unused app
    unused center_x
    unused center_y
}

session_round_label :: (app: InnerBreeze*, text: char*, text_size: size_t) #private {
    if text == nil || text_size == 0 {
        return
    }
    FormatLocaleText(text, text_size, "session_round_label", app->breathing.round + 1)
}

session_draw_round_title_bar :: (app: InnerBreeze*, title: const char*, height: int) -> int #private {
    return app_draw_active_practice_title_bar(app, title, height)
}

draw_breath_preview :: (breathing: BreathSession*, center_x: int, center_y: int) {
    r: float = draw_radius(breathing) * 0.72f
    DrawCircleV((Vector2){(float)center_x, (float)center_y}, r, GetThemeCircle())
    DrawRing((Vector2){(float)center_x, (float)center_y}, r - 0.75f, r + 0.75f,
             0.0f, 360.0f, 96, GetThemeText())
}

stop_android_background_session :: (app: InnerBreeze*) #private {
    meditation_music_stop(app)
    practice_active_background_stop(app)
}

session_request_exit :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    if app->session_paused {
        stop_android_background_session(app)
        app_init(app)
        return
    }
    app_open_modal(app, UIModalConfirmExitSession)
}

session_handle_exit_modal :: (app: InnerBreeze*) -> int #private {
    result: SessionExitModalResult

    if app == nil || !app->modal.active ||
       app->modal.type != UIModalConfirmExitSession {
        return 0
    }

    result = app_draw_session_exit_modal(
        session_has_completed_rounds(app),
        GetLocaleText("save_completed_rounds_message"),
        GetLocaleText("all_progress_lost_message"))
    if result == SessionExitModalCancel {
        app_close_modal(app)
    } else if result == SessionExitModalSave || result == SessionExitModalDiscard {
        if result == SessionExitModalSave {
            session_ensure_results_saved(app)
        }
        stop_android_background_session(app)
        app_close_modal(app)
        app_init(app)
    }
    return 1
}

session_update_screen :: (app: InnerBreeze*, center_x: int, center_y: int, hover: int*) {
    breath_max_y: int = view_height - Scale(44)
    title_h: int = app_active_practice_title_height()
    title: [32] char

    session_round_label(app, title, sizeof(title))
    if session_draw_round_title_bar(app, title, title_h) {
        session_request_exit(app)
        return
    }

    if session_handle_exit_modal(app) {
        return
    }

    practice_draw_audio_controls(app)

    if app->advanced_session_controls {
        min_view_dim: int = view_width < view_height ? view_width : view_height
        controls: [3] IconRowItem = {
            {app->icons[UI_ICON_TYPE_BACKWARD], 0},
            {app->session_paused ? app->icons[UI_ICON_TYPE_PLAY] : app->icons[UI_ICON_TYPE_PAUSE], 0},
            {app->icons[UI_ICON_TYPE_FORWARD], 0}
        }
        row: IconRowResult = BottomIconRow((BottomIconRowProps){
            .center_x = center_x,
            .view_width = view_width,
            .view_height = view_height,
            .count = 3,
            .items = controls,
            .icon_size = Scale(24),
            .icon_padding = Scale(10),
            .gap = Scale(12),
            .side_margin = Scale(24),
            .bottom_margin = Scale(6),
            .max_button_width = min_view_dim / 6,
            .min_icon_size = Scale(16),
            .min_icon_padding = Scale(6),
            .min_gap = Scale(8)
        })

        breath_max_y = row.y - Scale(44)
        if row.clicked_index == 0 {
            session_step_back(app)
        }
        else if row.clicked_index == 1 {
            app->session_paused = !app->session_paused
        }
        else if row.clicked_index == 2 {
            session_step_forward(app)
        }
    }

    draw_session_status(app, center_x, center_y)

    if !app->session_paused && !app->backgrounded {
#if ANDROID {
        pthread_mutex_t*timer_mutex = android_timer_get_mutex()
        if timer_mutex {
            pthread_mutex_lock(timer_mutex)
            breath_session_step(&app->breathing)
            update_session_sounds(app)
            pthread_mutex_unlock(timer_mutex)
        } else {
            breath_session_step(&app->breathing)
            update_session_sounds(app)
        }
        session_update_notification(app)
} #else {
        elapsed_ms: int = (int)(GetFrameTime() * 1000.0f + 0.5f)
        if elapsed_ms < 1 {
            elapsed_ms = 1
        }
        session_advance_elapsed(app, elapsed_ms)
}
    }

    if just_completed(&app->breathing) {
        session_complete(app)
        return
    }

    if app->breathing.phase != BreathPhaseHold {
        app->breath_tap_last_time = 0.0
    }

    if app->breathing.phase == BreathPhaseHold {
        breath_label: const char* = GetLocaleText("breath_button")
        breath_font: int = Text16
        breath_w: int = TextWidth(breath_label, breath_font) + Scale(72)
        breath_h: int = TextLineHeight(breath_font) + Scale(28)
        breath_y: int = center_y + app->breathing.rmax - Scale(42)
        breath_x: int
        breath_hover: int = 0

        if app->double_tap_to_breathe {
            hint: const char* = GetLocaleText("double_tap_to_breathe_hint")
            hint_font: int = GetFontSize()
            hint_w: int = TextWidth(hint, hint_font)
            hint_y: int = center_y + app->breathing.rmax + Scale(12)

            if hint_y > breath_max_y {
                hint_y = breath_max_y
            }
            Text((TextProps){
                .bounds={(center_x - hint_w / 2), (hint_y), 0, 0},
                .text=(hint),
                .font=(hint_font),
                .color=(GetThemeText()),
                .wrap=TextWrapNone
            })
            if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
                now: double = GetTime()
                if app->breath_tap_last_time > 0.0 &&
                   now - app->breath_tap_last_time <= 0.35 {
                    app->breath_tap_last_time = 0.0
                    finish_hold(app)
                } else {
                    app->breath_tap_last_time = now
                }
            }
            return
        }

        if breath_w < Scale(184) {
            breath_w = Scale(184)
        }
        if breath_w > view_width - Scale(24) {
            breath_w = view_width - Scale(24)
        }
        if breath_y > breath_max_y {
            breath_y = breath_max_y
        }
        breath_x = center_x - breath_w / 2
        if StyledButton(breath_x, breath_y, breath_w, breath_h,
                                  breath_label, ButtonStylePrimary, 0,
                                  &breath_hover) {
            finish_hold(app)
        }
        if hover != nil {
            *hover = breath_hover
        }
    }
}

session_draw_results_screen :: (app: InnerBreeze*, center_x: int, center_y: int, hover: int*) {
    box_x: int
    box_y: int = Scale(78)
    box_w: int
    row_y: int = Scale(215)
    row_h: int = Scale(32)
    total: int = 0
    best: int = -1
    round_times: [MaxRounds] int
    rounds: int = collect_result_rounds(app, round_times, MaxRounds)
    discard_hover: int = 0
    save_hover: int = 0
    action_y: int = view_height - Scale(40)
    title_font: int
    title_w: int

    unused center_y

    if rounds <= 0 {
        app_init(app)
        return
    }

    responsive_max_w: int = (int)(view_width * 0.96f)
    min_content_w: int = Scale(320)
    if responsive_max_w < min_content_w {
        responsive_max_w = min_content_w
    }
    GetUICenteredColumn(responsive_max_w, GetUIPageSidePadding(), &box_x, &box_w)

    title_font = GetTitleFontSize(GetLocaleText("results_title"), view_width - Scale(48))
    title_w = TextWidth(GetLocaleText("results_title"), title_font)
    Text((TextProps){
        .bounds={(center_x - title_w / 2), (Scale(34)), 0, 0},
        .text=(GetLocaleText("results_title")),
        .font=(title_font),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })

    for int i = 0; i < rounds; i++ {
        seconds: int = round_times[i]
        total += seconds
        if best < 0 || seconds > best {
            best = seconds
        }
    }
    if best < 0 {
        best = 0
    }

    {
        lines: [3][64] char
        rows: [3] UIInfoRow
        summary_font: int = Text16

        FormatLocaleText(lines[0], sizeof(lines[0]), "results_rounds", rounds)
        FormatLocaleText(lines[1], sizeof(lines[1]), "results_best", best)
        FormatLocaleText(lines[2], sizeof(lines[2]), "results_avg",
                      rounds > 0 ? total / rounds : 0)
        if view_width < 420 && TextWidth(lines[2], summary_font) > box_w - Scale(20) {
            snprintf(lines[2], sizeof(lines[2]), "%ds", rounds > 0 ? total / rounds : 0)
        }
        for int i = 0; i < 3; i++ {
            rows[i] = (UIInfoRow){lines[i], summary_font, GetThemeText()}
        }
        InfoRows((InfoRowsProps){
            .x = box_x,
            .y = box_y,
            .width = box_w,
            .row_height = Scale(29),
            .rows = rows,
            .row_count = 3,
            .background = DarkenUIColor(GetThemeBackground(), 6),
            .separator = DarkenUIColor(GetThemeBackground(), 30),
            .default_text = GetThemeText()
        })
    }

    DrawLeftUIControlTextInRect(GetLocaleText("round_times_title"),
                                    (Rectangle){(float)box_x, (float)Scale(181),
                                                (float)box_w, (float)Scale(28)},
                                    GetFontSize(), DarkenUIColor(GetThemeText(), 20))
    for int i = 0; i < rounds; i++ {
        row: [48] char
        info_row: UIInfoRow
        row_font: int = GetFontSize()
        FormatLocaleText(row, sizeof(row), "round_result_label", i + 1, round_times[i])
        info_row = (UIInfoRow){row, row_font, GetThemeText()}
        InfoRows((InfoRowsProps){
            .x = box_x,
            .y = row_y - 1,
            .width = box_w,
            .row_height = row_h,
            .rows = &info_row,
            .row_count = 1,
            .background = DarkenUIColor(GetThemeBackground(), 4),
            .separator = DarkenUIColor(GetThemeBackground(), 26),
            .default_text = GetThemeText()
        })
        row_y += row_h
    }

    if TextButton(0, center_x - box_w / 4, action_y, GetLocaleText("discard_button"), &discard_hover) {
        session_discard_saved_results(app)
        app_init(app)
    }
    if TextButton(0, center_x + box_w / 4, action_y, GetLocaleText("save_results_button"), &save_hover) {
        if session_ensure_results_saved(app) {
            app_init(app)
        }
    }
    if discard_hover || save_hover {
        *hover = 1
    }
}
