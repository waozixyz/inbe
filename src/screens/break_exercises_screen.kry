#import "app.h"
#import "breaks/break_exercises.h"

break_exercises_step_text :: (index: int, step: int) -> const char* #private {
    key := break_exercise_step(index, step)
    if key[0] == '\0' {
        return ""
    }
    return GetLocaleText(key)
}

break_exercises_title_text :: (index: int) -> const char* #private {
    return GetLocaleText(break_exercise_title(index))
}

break_exercises_screen_draw :: (app: InbeApp*) {
    reserved_bottom := app_content_bottom_reserved(app)
    content_h := view_height - reserved_bottom
    x := GetUIPageSidePadding()
    w := view_width - x * 2
    y := 0
    clock_second := (int)GetTime()
    muted := DarkenUIColor(GetThemeText(), 40)
    page := (UIScrollPage){0}

    if app == nil {
        return
    }
    if content_h < ScaleUIPx(120) {
        content_h = ScaleUIPx(120)
    }
    if app_draw_close_title_bar(app, GetLocaleText("break_exercises_title"), ScaleUIPx(48)) {
        app_switch_screen(app, InbeScreenSettings)
        return
    }

    page = BeginUIScrollPage((UIScrollPageSpec){.y = ScaleUIPx(48), .height = content_h - ScaleUIPx(48), .max_content_width = ScaleUIPx(560), .min_content_width = ScaleUIPx(280), .scroll_offset = &app->break_exercises_scroll})
    y = page.content_y

    Text(GetLocaleText("break_exercises_intro"), page.content_x, y, Text12, muted)
    y += ScaleUIPx(26)

    for int i = 0; i < BREAK_EXERCISE_COUNT; i++ {
        paragraph := (ParagraphSpec){0}
        duration := break_exercise_total_s(i)
        step_count := 0
        header: [96] char

        for step_count = 0; step_count < BREAK_EXERCISE_MAX_STEPS; step_count++ {
            if break_exercise_step(i, step_count)[0] == '\0' {
                break
            }
        }

        snprintf(header, sizeof(header), "%s  (%d s)",
                 break_exercises_title_text(i), duration)
        Text(header, page.content_x, y, GetUIFontSize(), GetThemeText())
        y += ScaleUIPx(26)

        for int s = 0; s < step_count; s++ {
            step_duration := break_exercise_step_duration_s(i)
            active := (clock_second / step_duration) % step_count == s
            color := active ? GetThemeText() : muted
            marker := active ? "> " : "  "
            line: [160] char
            snprintf(line, sizeof(line), "%s%s", marker,
                     break_exercises_step_text(i, s))
            paragraph = (ParagraphSpec){.text = line, .width = page.content_w - ScaleUIPx(12), .font = Text12, .line_gap = ScaleUIPx(3), .color = color}
            Paragraph(paragraph, page.content_x + ScaleUIPx(6), &y)
            y += ScaleUIPx(6)
        }
        y += ScaleUIPx(14)
    }

    EndUIScrollPage(page)
}
