#import "app.h"
#import "breaks/break_exercises.h"
pscr :: #import "screens/practice_screen"

# Defined in breaks/app_breaks.kry; declared extern to keep the module
# graph acyclic (app_breaks imports this module for the overlay window).
app_breaks_start_practice :: (app: InbeApp*, t: int, practice_id: int) #extern
app_breaks_open_habits :: (app: InbeApp*, t: int) #extern

#enum {
    BREAK_OVERLAY_HABITS_CHIP_ID = -1
    BREAK_OVERLAY_CHIP_MAX = 5
}

break_overlay_active :: (app: const InbeApp*) -> int {
    if app == nil {
        return 0
    }
    return app->inbe.screen == InbeScreenBreak
}

break_overlay_remaining_s :: (app: const InbeApp*, t: int) -> int {
    timer := &app->breaks.timers[t]
    left := timer->duration_s - timer->idle_s
    if left < 0 {
        left = 0
    }
    return left
}

break_overlay_draw_bar :: (x: int, y: int, w: int, h: int, fraction: int) #private {
    track := DarkenUIColor(GetThemeBackground(), 26)
    border := DarkenUIColor(GetThemeText(), 60)
    fill := (Color){74, 178, 102, 255}

    Rect(x, y, w, h, track, border)

    filled := w * fraction / 100
    if filled > 0 {
        if filled > w {
            filled = w
        }
        Rect(x + 1, y + 1, filled, h - 2, fill, fill)
    }
}

# Practice chips below the panel: running a practice replaces the break
# (app_breaks_start_practice takes it and freezes scheduling for the
# session). Shared by the draw path and both click paths so the geometry
# has a single source of truth.
break_overlay_practice_chips :: (app: InbeApp*, view_w: int, view_h: int,
                                 out_rects: Rectangle*, out_ids: int*) -> int {
    if app == nil || out_rects == nil || out_ids == nil {
        return 0
    }
    ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    widths: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    count := 0
    for int i = 0; i < practice_count() && count < BREAK_OVERLAY_CHIP_MAX - 1; i++ {
        id := practice_ordered_id(i)
        ids[count] = id
        widths[count] = TextWidth(pscr.practice_label(id), Text12) +
                        ScaleUIPx(24)
        count++
    }
    ids[count] = BREAK_OVERLAY_HABITS_CHIP_ID
    widths[count] = TextWidth(GetLocaleText("tab_habits"), Text12) +
                    ScaleUIPx(24)
    count++
    if count == 0 {
        return 0
    }

    panel_w := view_w * 72 / 100
    if panel_w > ScaleUIPx(560) {
        panel_w = ScaleUIPx(560)
    }
    if panel_w < ScaleUIPx(280) {
        panel_w = ScaleUIPx(280)
    }
    panel_h := view_h * 46 / 100
    if panel_h > ScaleUIPx(420) {
        panel_h = ScaleUIPx(420)
    }
    if panel_h < ScaleUIPx(240) {
        panel_h = ScaleUIPx(240)
    }
    panel_y := view_h / 2 - panel_h / 2

    avail := panel_w - ScaleUIPx(48)
    gap := ScaleUIPx(8)
    chip_h := ScaleUIPx(34)
    y := panel_y + panel_h + ScaleUIPx(14)

    total := (count - 1) * gap
    for int i = 0; i < count; i++ {
        total += widths[i]
    }
    if total <= avail {
        x := view_w / 2 - total / 2
        for int i = 0; i < count; i++ {
            out_rects[i] = (Rectangle){(float)x, (float)y,
                                       (float)widths[i], (float)chip_h}
            out_ids[i] = ids[i]
            x += widths[i] + gap
        }
        return count
    }

    cols := count > 1 ? 2 : 1
    chip_w := (avail - (cols - 1) * gap) / cols
    row_w := cols * chip_w + (cols - 1) * gap
    for int i = 0; i < count; i++ {
        col := i % cols
        row := i / cols
        x := view_w / 2 - row_w / 2 + col * (chip_w + gap)
        out_rects[i] = (Rectangle){(float)x, (float)(y + row * (chip_h + gap)),
                                   (float)chip_w, (float)chip_h}
        out_ids[i] = ids[i]
    }
    return count
}

break_overlay_draw_practice_chips :: (app: InbeApp*, w: int, h: int) #private {
    rects: [BREAK_OVERLAY_CHIP_MAX] Rectangle
    ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    chips := break_overlay_practice_chips(app, w, h, rects, ids)

    if chips <= 0 {
        return
    }
    chip_fill := DarkenUIColor(GetThemeBackground(), 18)
    chip_border := DarkenUIColor(GetThemeText(), 55)
    for int i = 0; i < chips; i++ {
        r := rects[i]
        Rect((int)r.x, (int)r.y, (int)r.width, (int)r.height,
             chip_fill, chip_border)
        label := ids[i] == BREAK_OVERLAY_HABITS_CHIP_ID
            ? GetLocaleText("tab_habits")
            : pscr.practice_label(ids[i])
        lw := TextWidth(label, Text12)
        Text(label, (int)r.x + ((int)r.width - lw) / 2,
             (int)r.y + ScaleUIPx(10), Text12, GetThemeText())
    }
}

break_overlay_draw_sized :: (app: InbeApp*, w: int, h: int) {
    if app == nil {
        return
    }

    t := break_engine_active_break(&app->breaks)
    if t < 0 {
        return
    }

    timer := &app->breaks.timers[t]
    panel_w := w * 72 / 100
    if panel_w > ScaleUIPx(560) {
        panel_w = ScaleUIPx(560)
    }
    if panel_w < ScaleUIPx(280) {
        panel_w = ScaleUIPx(280)
    }
    panel_h := h * 46 / 100
    if panel_h > ScaleUIPx(420) {
        panel_h = ScaleUIPx(420)
    }
    if panel_h < ScaleUIPx(240) {
        panel_h = ScaleUIPx(240)
    }
    panel_x := w / 2 - panel_w / 2
    panel_y := h / 2 - panel_h / 2

    scrim := DarkenUIColor(DarkenUIColor(GetThemeBackground(), 8), 30)
    Rect(0, 0, w, h, scrim, scrim)

    muted := DarkenUIColor(GetThemeText(), 40)
    activity_flash := app->break_input_active != 0 && (app->inbe.frame / 30) % 2 == 0
    border := activity_flash ? (Color){222, 140, 44, 255} : DarkenUIColor(GetThemeText(), 62)
    fill := DarkenUIColor(GetThemeBackground(), 12)

    Rect(panel_x, panel_y, panel_w, panel_h, fill, border)

    title_font := Text24
    body_font := Text16
    title: const char*
    body: const char*
    if t == BREAK_REST {
        title = GetLocaleText("break_rest_title")
    } else if t == BREAK_DAILY {
        title = GetLocaleText("break_daily_title")
    } else {
        title = GetLocaleText("break_micro_title")
    }
    if t == BREAK_REST {
        body = GetLocaleText("break_rest_body")
    } else if t == BREAK_DAILY {
        body = GetLocaleText("break_daily_body")
    } else {
        body = GetLocaleText("break_micro_body")
    }
    title_w := TextWidth(title, title_font)
    text_x := w / 2

    Text(title, text_x - title_w / 2, panel_y + ScaleUIPx(28), title_font, GetThemeText())

    remaining := break_overlay_remaining_s(app, t)
    time_text_w := 0
    if timer->duration_s > 0 {
        time_text: [16] char
        time_label: [96] char
        break_format_duration(time_text, sizeof(time_text), remaining)
        snprintf(time_label, sizeof(time_label), GetLocaleText("break_time_remaining"), time_text)
        time_text_w = TextWidth(time_label, body_font)
        Text(time_label, text_x - time_text_w / 2, panel_y + ScaleUIPx(64), body_font, muted)
    }

    if timer->duration_s > 0 {
        fraction := timer->idle_s * 100 / timer->duration_s
        if fraction > 100 {
            fraction = 100
        }
        bar_w := panel_w - ScaleUIPx(48)
        break_overlay_draw_bar(panel_x + ScaleUIPx(24),
                               panel_y + ScaleUIPx(96),
                               bar_w, ScaleUIPx(16), fraction)
    }

    paragraph := (ParagraphSpec){0}
    paragraph = (ParagraphSpec){.text = body, .width = panel_w - ScaleUIPx(48), .font = body_font, .line_gap = ScaleUIPx(3), .color = muted}
    body_y := panel_y + ScaleUIPx(132)
    Paragraph(paragraph, panel_x + ScaleUIPx(24), &body_y)

    if activity_flash {
        active_note := GetLocaleText("break_stay_idle_note")
        active_w := TextWidth(active_note, body_font)
        Text(active_note, text_x - active_w / 2, panel_y + panel_h - ScaleUIPx(96), body_font,
             (Color){222, 140, 44, 255})
    }

    button_y := panel_y + panel_h - ScaleUIPx(56)
    button_w := ScaleUIPx(132)
    gap := ScaleUIPx(12)
    count := 0
    if timer->show_postpone != 0 {
        count++
    }
    if timer->show_skip != 0 {
        count++
    }
    if t == BREAK_MICRO {
        count++
    }
    row_w := count * button_w + (count - 1) * gap
    button_x := w / 2 - row_w / 2
    locked := timer->lock_buttons_s > 0
    hover := 0

    if timer->show_postpone != 0 {
        if locked {
            locked_label: [64] char
            snprintf(locked_label, sizeof(locked_label), GetLocaleText("break_lock_note"), timer->lock_buttons_s)
            DrawCenteredUIControlText(locked_label, button_x + button_w / 2, button_y + ScaleUIPx(16), Text12, muted)
        } else {
            if TextButton(4101, button_x, button_y, GetLocaleText("break_postpone_button"), &hover) {
                break_engine_postpone(&app->breaks, t)
                return
            }
        }
        button_x += button_w + gap
    }

    if timer->show_skip != 0 {
        if !locked {
            if TextButton(4102, button_x, button_y, GetLocaleText("break_skip_button"), &hover) {
                break_engine_skip(&app->breaks, t)
                return
            }
        }
        button_x += button_w + gap
    }

    if t == BREAK_MICRO {
        if TextButton(4103, button_x, button_y, GetLocaleText("break_rest_now_button"), &hover) {
            break_engine_force_break(&app->breaks, BREAK_REST)
            return
        }
    }

    break_overlay_draw_practice_chips(app, w, h)
}

# Main-window route (InbeScreenBreak): the overlay sized to the app view.
break_overlay_draw :: (app: InbeApp*) {
    if app == nil {
        return
    }
    t := break_engine_active_break(&app->breaks)
    if t < 0 {
        app_switch_screen(app, app->break_prev_screen != 0 ? app->break_prev_screen : InbeScreenStart)
        return
    }
    break_overlay_draw_sized(app, view_width, view_height)

    # Practice chip clicks for this route; the overlay-window route
    # hit-tests the same geometry in app_breaks_window_click.
    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        mouse := GetMousePosition()
        if UIInputCapturesClick(mouse) {
            return
        }
        rects: [BREAK_OVERLAY_CHIP_MAX] Rectangle
        ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
        chips := break_overlay_practice_chips(app, view_width, view_height,
                                              rects, ids)
        for int i = 0; i < chips; i++ {
            if CheckCollisionPointRec(mouse, rects[i]) {
                if ids[i] == BREAK_OVERLAY_HABITS_CHIP_ID {
                    app_breaks_open_habits(app, t)
                } else {
                    app_breaks_start_practice(app, t, ids[i])
                }
                return
            }
        }
    }
}
