#import "app/app.h"
pscr :: #import "screens/practice_screen"

# Defined in breaks/app_breaks.kry; declared extern to keep the module
# graph acyclic (app_breaks imports this module for the overlay window).
app_breaks_start_practice :: (app: InnerBreeze*, t: int, practice_id: int) #extern
app_breaks_open_habits :: (app: InnerBreeze*, t: int) #extern

#enum {
    BREAK_OVERLAY_HABITS_CHIP_ID = -1
    BREAK_OVERLAY_CHIP_MAX = 5
}

break_overlay_active :: (app: const InnerBreeze*) -> int {
    if app == nil {
        return 0
    }
    return app->breathing.screen == ScreenBreak
}

break_overlay_remaining_s :: (app: const InnerBreeze*, t: int) -> int {
    timer: const BreakTimer* = &app->breaks.timers[t]
    left := timer->duration_s - timer->idle_s
    if left < 0 {
        left = 0
    }
    return left
}

break_overlay_draw_bar :: (x: int, y: int, w: int, h: int, fraction: int) #private {
    track := DarkenColor(GetThemeBackground(), 26)
    border := DarkenColor(GetThemeText(), 60)
    fill := (Color){74, 178, 102, 255}

    Box((Rectangle){(float)(x), (float)(y), (float)(w), (float)(h)}, track, border)

    filled := w * fraction / 100
    if filled > 0 {
        if filled > w {
            filled = w
        }
        Box((Rectangle){(float)(x + 1), (float)(y + 1), (float)(filled), (float)(h - 2)}, fill, fill)
    }
}

# Practice chips below the panel: running a practice replaces the break
# (app_breaks_start_practice takes it and freezes scheduling for the
# session). Shared by the draw path and both click paths so the geometry
# has a single source of truth.
break_overlay_practice_chips :: (app: InnerBreeze*, view_w: int, view_h: int,
                                 out_rects: Rectangle*, out_ids: int*) -> int {
    if app == nil || out_rects == nil || out_ids == nil {
        return 0
    }
    ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    widths: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    count := 0
    for int i = 0; i < practice_count() && count < BREAK_OVERLAY_CHIP_MAX - 1; i++ {
        id := practice_ordered_id(i)
        ids[count] = id
        widths[count] = AppTextWidth(pscr.practice_label(id), Text12) +
                        Scale(24)
        count++
    }
    ids[count] = BREAK_OVERLAY_HABITS_CHIP_ID
    widths[count] = AppTextWidth(GetLocaleText("tab_habits"), Text12) +
                    Scale(24)
    count++
    if count == 0 {
        return 0
    }

    panel_w := view_w * 72 / 100
    if panel_w > Scale(560) {
        panel_w = Scale(560)
    }
    if panel_w < Scale(280) {
        panel_w = Scale(280)
    }
    panel_h := view_h * 46 / 100
    if panel_h > Scale(420) {
        panel_h = Scale(420)
    }
    if panel_h < Scale(240) {
        panel_h = Scale(240)
    }
    panel_y := view_h / 2 - panel_h / 2

    avail := panel_w - Scale(48)
    gap := Scale(8)
    chip_h := Scale(34)
    y := panel_y + panel_h + Scale(14)

    total := (count - 1) * gap
    for int i = 0; i < count; i++ {
        total += widths[i]
    }
    if total <= avail {
        x := view_w / 2 - total / 2
        for int i = 0; i < count; i++ {
            out_rects[i] = (Rectangle){(float)x, (float)y,
                                       (float)widths[i], (float)chip_h}
            out_ids[i] = ids[i]
            x += widths[i] + gap
        }
        return count
    }

    cols := count > 1 ? 2 : 1
    chip_w := (avail - (cols - 1) * gap) / cols
    row_w := cols * chip_w + (cols - 1) * gap
    for int i = 0; i < count; i++ {
        col := i % cols
        row := i / cols
        x := view_w / 2 - row_w / 2 + col * (chip_w + gap)
        out_rects[i] = (Rectangle){(float)x, (float)(y + row * (chip_h + gap)),
                                   (float)chip_w, (float)chip_h}
        out_ids[i] = ids[i]
    }
    return count
}

break_overlay_draw_practice_chips :: (app: InnerBreeze*, w: int, h: int) #private {
    rects: [BREAK_OVERLAY_CHIP_MAX] Rectangle
    ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
    chips := break_overlay_practice_chips(app, w, h, rects, ids)

    if chips <= 0 {
        return
    }
    chip_fill := DarkenColor(GetThemeBackground(), 18)
    chip_border := DarkenColor(GetThemeText(), 55)
    for int i = 0; i < chips; i++ {
        r: Rectangle = rects[i]
        Box((Rectangle){(float)((int)r.x), (float)((int)r.y), (float)((int)r.width), (float)((int)r.height)}, chip_fill, chip_border)
        label: const char* = ids[i] == BREAK_OVERLAY_HABITS_CHIP_ID
            ? GetLocaleText("tab_habits")
            : pscr.practice_label(ids[i])
        lw := AppTextWidth(label, Text12)
        Text((TextProps){
            .bounds={((int)r.x + ((int)r.width - lw) / 2), ((int)r.y + Scale(10)), 0, 0},
            .text=(label),
            .wrap=TextWrapNone
        })
    }
}

break_overlay_draw_sized :: (app: InnerBreeze*, w: int, h: int) {
    if app == nil {
        return
    }

    t := break_engine_active_break(&app->breaks)
    if t < 0 {
        return
    }

    timer: BreakTimer* = &app->breaks.timers[t]
    panel_w := w * 72 / 100
    if panel_w > Scale(560) {
        panel_w = Scale(560)
    }
    if panel_w < Scale(280) {
        panel_w = Scale(280)
    }
    panel_h := h * 46 / 100
    if panel_h > Scale(420) {
        panel_h = Scale(420)
    }
    if panel_h < Scale(240) {
        panel_h = Scale(240)
    }
    panel_x := w / 2 - panel_w / 2
    panel_y := h / 2 - panel_h / 2

    scrim := DarkenColor(DarkenColor(GetThemeBackground(), 8), 30)
    Box((Rectangle){(float)(0), (float)(0), (float)(w), (float)(h)}, scrim, scrim)

    activity_flash := app->break_input_active != 0 && (app->breathing.frame / 30) % 2 == 0
    border: Color = activity_flash ? (Color){222, 140, 44, 255} : DarkenColor(GetThemeText(), 62)
    fill := DarkenColor(GetThemeBackground(), 12)

    Box((Rectangle){(float)(panel_x), (float)(panel_y), (float)(panel_w), (float)(panel_h)}, fill, border)

    title_font := Text24
    body_font := Text16
    title: const char*
    body: const char*
    if t == BREAK_REST {
        title = GetLocaleText("break_rest_title")
    } else if t == BREAK_DAILY {
        title = GetLocaleText("break_daily_title")
    } else {
        title = GetLocaleText("break_micro_title")
    }
    if t == BREAK_REST {
        body = GetLocaleText("break_rest_body")
    } else if t == BREAK_DAILY {
        body = GetLocaleText("break_daily_body")
    } else {
        body = GetLocaleText("break_micro_body")
    }
    title_w := AppTextWidth(title, title_font)
    text_x := w / 2

    Text((TextProps){
        .bounds={(text_x - title_w / 2), (panel_y + Scale(28)), 0, 0},
        .text=(title),
        .wrap=TextWrapNone
    })

    remaining := break_overlay_remaining_s(app, t)
    time_text_w := 0
    if timer->duration_s > 0 {
        time_text: [16] char
        time_label: [96] char
        break_format_duration(time_text, sizeof(time_text), remaining)
        snprintf(time_label, sizeof(time_label), GetLocaleText("break_time_remaining"), time_text)
        time_text_w = AppTextWidth(time_label, body_font)
        Text((TextProps){
            .bounds={(text_x - time_text_w / 2), (panel_y + Scale(64)), 0, 0},
            .text=(time_label),
            .wrap=TextWrapNone
        })
    }

    if timer->duration_s > 0 {
        fraction := timer->idle_s * 100 / timer->duration_s
        if fraction > 100 {
            fraction = 100
        }
        bar_w := panel_w - Scale(48)
        break_overlay_draw_bar(panel_x + Scale(24),
                               panel_y + Scale(96),
                               bar_w, Scale(16), fraction)
    }

    paragraph := (ParagraphSpec){0}
    paragraph = (ParagraphSpec){.text = body, .width = panel_w - Scale(48), .font = body_font, .line_gap = Scale(3)}
    body_y := panel_y + Scale(132)
    Paragraph(paragraph, panel_x + Scale(24), &body_y)

    if activity_flash {
        active_note := GetLocaleText("break_stay_idle_note")
        active_w := AppTextWidth(active_note, body_font)
        Text((TextProps){
            .bounds={(text_x - active_w / 2), (panel_y + panel_h - Scale(96)), 0, 0},
            .text=(active_note),
            .wrap=TextWrapNone
        })
    }

    button_y := panel_y + panel_h - Scale(56)
    button_w := Scale(132)
    gap := Scale(12)
    count := 0
    if timer->show_postpone != 0 {
        count++
    }
    if timer->show_skip != 0 {
        count++
    }
    if t == BREAK_MICRO {
        count++
    }
    row_w := count * button_w + (count - 1) * gap
    button_x := w / 2 - row_w / 2
    locked := timer->lock_buttons_s > 0


    if timer->show_postpone != 0 {
        if locked {
            locked_label: [64] char
            snprintf(locked_label, sizeof(locked_label), GetLocaleText("break_lock_note"), timer->lock_buttons_s)
            Text((TextProps){
                .bounds = {(float)button_x, (float)button_y,
                           (float)button_w, (float)Scale(32)},
                .text = locked_label,
                .wrap = TextWrapNone,
                .align = TextAlignCenter,
                .vertical_align = TextAlignCenter
            })
        } else {
            if Button((ButtonProps){
        .id = 4101, .label = GetLocaleText("break_postpone_button"),
        .bounds = {(button_x) - fmaxf(AppTextWidth(GetLocaleText("break_postpone_button"), AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(button_y), fmaxf(AppTextWidth(GetLocaleText("break_postpone_button"), AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
                break_engine_postpone(&app->breaks, t)
                return
            }
        }
        button_x += button_w + gap
    }

    if timer->show_skip != 0 {
        if !locked {
            if Button((ButtonProps){
        .id = 4102, .label = GetLocaleText("break_skip_button"),
        .bounds = {(button_x) - fmaxf(AppTextWidth(GetLocaleText("break_skip_button"), AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(button_y), fmaxf(AppTextWidth(GetLocaleText("break_skip_button"), AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
                break_engine_skip(&app->breaks, t)
                return
            }
        }
        button_x += button_w + gap
    }

    if t == BREAK_MICRO {
        if Button((ButtonProps){
        .id = 4103, .label = GetLocaleText("break_rest_now_button"),
        .bounds = {(button_x) - fmaxf(AppTextWidth(GetLocaleText("break_rest_now_button"), AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(button_y), fmaxf(AppTextWidth(GetLocaleText("break_rest_now_button"), AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
            break_engine_force_break(&app->breaks, BREAK_REST)
            return
        }
    }

    break_overlay_draw_practice_chips(app, w, h)
}

# Main-window route (ScreenBreak): the overlay sized to the app view.
break_overlay_draw :: (app: InnerBreeze*) {
    if app == nil {
        return
    }
    t := break_engine_active_break(&app->breaks)
    if t < 0 {
        app_switch_screen(app, app->break_prev_screen != 0 ? app->break_prev_screen : ScreenStart)
        return
    }
    break_overlay_draw_sized(app, view_width, view_height)

    # Practice chip clicks for this route; the overlay-window route
    # hit-tests the same geometry in app_breaks_window_click.
    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        mouse := GetMousePosition()
        if InputCapturesClick(mouse) {
            return
        }
        rects: [BREAK_OVERLAY_CHIP_MAX] Rectangle
        ids: [BREAK_OVERLAY_CHIP_MAX] int = {0, 0, 0, 0, 0}
        chips := break_overlay_practice_chips(app, view_width, view_height,
                                              rects, ids)
        for int i = 0; i < chips; i++ {
            if CheckCollisionPointRec(mouse, rects[i]) {
                if ids[i] == BREAK_OVERLAY_HABITS_CHIP_ID {
                    app_breaks_open_habits(app, t)
                } else {
                    app_breaks_start_practice(app, t, ids[i])
                }
                return
            }
        }
    }
}
