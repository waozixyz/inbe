#import "app.h"
#import "app_nav.h"
#import "storage.h"
elist_types :: #import "screens/elist_types"
#import <stdio.h>
#import <string.h>

elist_field :: (app: InnerBreeze*, bounds: Rectangle) -> TextFieldProps #private {
    return (TextFieldProps){
        .bounds = bounds,
        .text = app->elist.input,
        .text_size = sizeof(app->elist.input),
        .cursor_position = &app->elist.input_cursor,
        .focused = &app->elist.input_focused,
        .focus_id = 6501,
        .commit_pressed = &app->elist.input_committed,
        .max_codepoints = elist_types.ELIST_TITLE_SIZE - 1,
        .font = GetFontSize(),
        .style = (TextInputStyle){
            .background = DarkenUIColor(GetThemeBackground(), 4),
            .border = Fade(GetThemeText(), 0.22f),
            .focus_border = GetThemeButtonHover(),
            .text = GetThemeText(),
            .cursor = GetThemeText(),
            .radius = 0.08f,
            .padding_x = Scale(12)
        }
    }
}

elist_reload :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    storage_elist_load(&app->elist)
    app->elist.loaded = 1
}

elist_begin_input :: (app: InnerBreeze*, editing_item: int,
                       text: const char*) #private {
    snprintf(app->elist.input, sizeof(app->elist.input), "%s",
             text != nil ? text : "")
    app->elist.input_cursor = (int)strlen(app->elist.input)
    app->elist.input_focused = 1
    app->elist.input_error = 0
    SetUIFocus(6501)
    app->elist.editing_item = editing_item
}

elist_commit_input :: (app: InnerBreeze*) #private {
    state := &app->elist
    saved: int = 0
    created_id: [37]char = {0}

    if state->input[0] == '\0' {
        return
    }
    if state->editing_item == -2 {
        saved = storage_elist_create_list(state->input, created_id)
    } else if state->editing_item == -3 && state->selected_list >= 0 &&
              state->selected_list < state->list_count {
        list := &state->lists[state->selected_list]
        saved = storage_elist_update_list(list->id, state->input, list->sort_order)
    } else if state->editing_item >= 0 &&
              state->editing_item < state->item_count {
        item := &state->items[state->editing_item]
        saved = storage_elist_update_item(item->id, state->input, item->comment,
                                  item->done, item->sort_order)
    } else if state->selected_list >= 0 &&
              state->selected_list < state->list_count {
        saved = storage_elist_create_item(state->lists[state->selected_list].id,
                                  state->input, "", nil)
    }
    if !saved {
        state->input_error = 1
        return
    }
    state->input_error = 0
    state->input[0] = '\0'
    state->input_cursor = 0
    state->input_focused = 0
    state->editing_item = -1
    elist_reload(app)
    if created_id[0] != '\0' {
        for int i = 0; i < state->list_count; i++ {
            if strcmp(state->lists[i].id, created_id) == 0 {
                state->selected_list = i
                break
            }
        }
    }
    app_auto_sync(app)
}

elist_content_bounds :: () -> Rectangle #private {
    pad := Scale(16)
    return (Rectangle){(float)pad, 0, (float)(view_width - pad * 2), (float)view_height}
}

elist_select_list :: (app: InnerBreeze*, index: int) #private {
    state := &app->elist
    if index < 0 || index >= state->list_count || index == state->selected_list {
        return
    }
    state->selected_list = index
    state->editing_item = -1
    state->input[0] = '\0'
    state->input_cursor = 0
    state->input_focused = 0
    state->input_error = 0
    state->input_committed = 0
    SetUIFocus(0)
}

elist_draw_empty :: (x: int, y: int, w: int) #private {
    title := GetLocaleText("elist_empty_title")
    detail := GetLocaleText("elist_empty_detail")

    Text((TextProps){
        .bounds = {(float)x, (float)y, (float)w, (float)Scale(30)},
        .text = title,
        .font = Text20,
        .color = GetThemeText(),
        .align = TextAlignCenter,
        .wrap = TextWrapAuto
    })
    Text((TextProps){
        .bounds = {(float)x, (float)(y + Scale(40)), (float)w, (float)Scale(48)},
        .text = detail,
        .font = GetSmallFontSize(),
        .color = GetThemeMutedText(),
        .align = TextAlignCenter,
        .wrap = TextWrapAuto
    })
}

draw_elist_screen :: (app: InnerBreeze*) {
    state: elist_types.EListState*
    content := elist_content_bounds()
    x := (int)content.x
    content_w := (int)content.width
    y := Scale(12)

    tab_h := Scale(44)
    list_tabs: [elist_types.ELIST_LIST_MAX] Tab = {0}

    if app == nil {
        return
    }
    state = &app->elist
    if !state->loaded {
        elist_reload(app)
    }

    if state->list_count > 0 && state->selected_list >= 0 &&
       Button((ButtonProps){
           .id = 0,
           .bounds = {(float)(view_width - Scale(88)), (float)(Scale(15)),
                      (float)((Scale(22)) + (Scale(8)) * 2),
                      (float)((Scale(22)) + (Scale(8)) * 2)},
           .icon = app->icons[UI_ICON_TYPE_EDIT], .icon_only = 1,
           .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
           .style = {.normal = {
               .fields = StyleIconSize,
               .icon_size = (float)(Scale(22)) * 1000.0f / Scale(1000)
           }}
       }) {
        elist_begin_input(app, -3, state->lists[state->selected_list].title)
    }
    if state->list_count > 0 && state->selected_list >= 0 &&
       Button((ButtonProps){
           .id = 0,
           .bounds = {(float)(view_width - Scale(48)), (float)(Scale(15)),
                      (float)((Scale(22)) + (Scale(8)) * 2),
                      (float)((Scale(22)) + (Scale(8)) * 2)},
           .icon = app->icons[UI_ICON_TYPE_TRASH], .icon_only = 1,
           .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
           .style = {.normal = {
               .fields = StyleIconSize,
               .icon_size = (float)(Scale(22)) * 1000.0f / Scale(1000)
           }}
       }) {
        storage_elist_delete_list(state->lists[state->selected_list].id)
        state->selected_list = 0
        elist_reload(app)
        app_auto_sync(app)
        return
    }
    for int i = 0; i < state->list_count; i++ {
        list_tabs[i] = (Tab){.label = state->lists[i].title}
    }
    selector_w := content_w - Scale(200)
    if state->list_count > 0 {
        selected := TabBar((TabBarProps){
            .id = 6500,
            .bounds = {(float)x, (float)y, (float)selector_w, (float)tab_h},
            .tabs = list_tabs,
            .count = state->list_count,
            .selected_index = state->selected_list,
            .font = GetFontSize(),
            .min_tab_width = Scale(88),
            .max_tab_width = Scale(180)
        })
        elist_select_list(app, selected)
    }
    if Button((ButtonProps){
        .bounds = {(float)(x + selector_w + Scale(8)), (float)(y), (float)(Scale(104)), (float)(tab_h)},
        .label = GetLocaleText("elist_new_list"),
        .font = GetFontSize(),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        elist_begin_input(app, -2, "")
        return
    }
    y += tab_h + Scale(16)

    if state->input_error {
        Text((TextProps){
            .bounds = {(float)x, (float)y, (float)content_w, (float)Scale(40)},
            .text = GetLocaleText("results_write_failed"),
            .font = GetSmallFontSize(),
            .color = GetThemeText(),
            .wrap = TextWrapAuto
        })
        y += Scale(48)
    }

    if state->editing_item == -2 || state->editing_item == -3 {
        TextField(elist_field(app, (Rectangle){(float)x, (float)y,
                                               (float)content_w, (float)Scale(44)}))
        y += Scale(52)
        if Button((ButtonProps){
            .bounds = {(float)(x), (float)(y), (float)(content_w), (float)(Scale(40))},
            .label = state->editing_item == -3 ? GetLocaleText("done_button") :
                                                    GetLocaleText("elist_create_list"),
            .font = GetFontSize(),
            .tone = ButtonToneAccent,
            .emphasis = ButtonEmphasisFilled,
            .disabled = state->input[0] == '\0'
        }) ||
           state->input_committed {
            elist_commit_input(app)
        }
        return
    }

    if state->list_count == 0 {
        elist_draw_empty(x, y + Scale(48), content_w)
        return
    }

    field_w := content_w - Scale(92)
    TextField(elist_field(app, (Rectangle){(float)x, (float)y,
                                           (float)field_w, (float)Scale(44)}))
    if Button((ButtonProps){
        .bounds = {(float)(x + field_w + Scale(8)), (float)(y), (float)(Scale(84)), (float)(Scale(44))},
        .label = state->editing_item >= 0 ? GetLocaleText("done_button") :
                                               GetLocaleText("elist_add_item"),
        .font = GetFontSize(),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = state->input[0] == '\0'
    }) ||
       state->input_committed {
        elist_commit_input(app)
    }
    y += Scale(52)

    selected_id := state->lists[state->selected_list].id
    row_h := Scale(58)
    for int i = 0; i < state->item_count; i++ {
        item := &state->items[i]
        if strcmp(item->list_id, selected_id) != 0 {
            continue
        }
        if y + row_h > view_height - app_content_bottom_reserved(app) - Scale(8) {
            break
        }
        bounds := (Rectangle){(float)x, (float)y, (float)content_w, (float)row_h}
        DrawRectangleRounded(bounds, 0.08f, 8,
                             DarkenUIColor(GetThemeBackground(), 5))
        done := item->done
        if Checkbox(6400 + i, x + Scale(10), y + Scale(17), "", &done) {
            storage_elist_update_item(item->id, item->title, item->comment,
                                      done, item->sort_order)
            elist_reload(app)
            app_auto_sync(app)
            return
        }
        text_color := item->done ? GetThemeMutedText() : GetThemeText()
        Text((TextProps){
            .bounds = {(float)(x + Scale(46)), (float)(y + Scale(9)),
                       (float)(content_w - Scale(132)), (float)Scale(24)},
            .text = item->title,
            .font = GetFontSize(),
            .color = text_color,
            .wrap = TextWrapNone
        })
        if item->comment[0] != '\0' {
            Text((TextProps){
                .bounds = {(float)(x + Scale(46)), (float)(y + Scale(32)),
                           (float)(content_w - Scale(132)), (float)Scale(18)},
                .text = item->comment,
                .font = GetSmallFontSize(),
                .color = GetThemeMutedText(),
                .wrap = TextWrapNone
            })
        }
        if Button((ButtonProps){
            .id = 0,
            .bounds = {(float)(x + content_w - Scale(78)), (float)(y + Scale(12)),
                       (float)((Scale(20)) + (Scale(7)) * 2),
                       (float)((Scale(20)) + (Scale(7)) * 2)},
            .icon = app->icons[UI_ICON_TYPE_EDIT], .icon_only = 1,
            .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
            .style = {.normal = {
                .fields = StyleIconSize,
                .icon_size = (float)(Scale(20)) * 1000.0f / Scale(1000)
            }}
        }) {
            elist_begin_input(app, i, item->title)
        }
        if Button((ButtonProps){
            .id = 0,
            .bounds = {(float)(x + content_w - Scale(40)), (float)(y + Scale(12)),
                       (float)((Scale(20)) + (Scale(7)) * 2),
                       (float)((Scale(20)) + (Scale(7)) * 2)},
            .icon = app->icons[UI_ICON_TYPE_TRASH], .icon_only = 1,
            .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
            .style = {.normal = {
                .fields = StyleIconSize,
                .icon_size = (float)(Scale(20)) * 1000.0f / Scale(1000)
            }}
        }) {
            storage_elist_delete_item(item->id)
            elist_reload(app)
            app_auto_sync(app)
            return
        }
        y += row_h + Scale(8)
    }
}

route elist {
    title "EList"
    group "App"
    page elist
}

elist :: (app: InnerBreeze*) #ui {
    Screen root: {
        draw_elist_screen(app)
    }
}
