#import "app.h"
#import "app_nav.h"
#import "storage.h"
elist_types :: #import "screens/elist_types"
#import <stdio.h>
#import <string.h>

elist_field :: (app: InnerBreeze*, bounds: Rectangle) -> TextFieldProps #private {
    return (TextFieldProps){
        .bounds = bounds,
        .text = app->elist.input,
        .text_size = sizeof(app->elist.input),
        .cursor_position = &app->elist.input_cursor,
        .focused = &app->elist.input_focused,
        .max_codepoints = elist_types.ELIST_TITLE_SIZE - 1,
        .font = GetFontSize(),
        .style = (TextInputStyle){
            .background = DarkenUIColor(GetThemeBackground(), 4),
            .border = Fade(GetThemeText(), 0.22f),
            .focus_border = GetThemeButtonHover(),
            .text = GetThemeText(),
            .cursor = GetThemeText(),
            .radius = 0.08f,
            .padding_x = Scale(12)
        }
    }
}

elist_comment_field :: (app: InnerBreeze*, bounds: Rectangle) -> TextFieldProps #private {
    field := elist_field(app, bounds)

    field.text = app->elist.comment_input
    field.text_size = sizeof(app->elist.comment_input)
    field.cursor_position = &app->elist.comment_cursor
    field.focused = &app->elist.comment_focused
    field.max_codepoints = elist_types.ELIST_COMMENT_SIZE - 1
    return field
}

elist_reload :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    storage_elist_load(&app->elist)
    app->elist.loaded = 1
}

elist_begin_input :: (app: InnerBreeze*, editing_item: int,
                       text: const char*) #private {
    snprintf(app->elist.input, sizeof(app->elist.input), "%s",
             text != nil ? text : "")
    app->elist.input_cursor = (int)strlen(app->elist.input)
    app->elist.comment_input[0] = '\0'
    app->elist.comment_cursor = 0
    app->elist.input_focused = 1
    app->elist.editing_item = editing_item
}

elist_commit_input :: (app: InnerBreeze*) #private {
    state := &app->elist

    if state->input[0] == '\0' {
        return
    }
    if state->editing_item == -2 {
        storage_elist_create_list(state->input, nil)
    } else if state->editing_item == -3 && state->selected_list >= 0 &&
              state->selected_list < state->list_count {
        list := &state->lists[state->selected_list]
        storage_elist_update_list(list->id, state->input, list->sort_order)
    } else if state->editing_item >= 0 &&
              state->editing_item < state->item_count {
        item := &state->items[state->editing_item]
        storage_elist_update_item(item->id, state->input, state->comment_input,
                                  item->done, item->sort_order)
    } else if state->selected_list >= 0 &&
              state->selected_list < state->list_count {
        storage_elist_create_item(state->lists[state->selected_list].id,
                                  state->input, state->comment_input, nil)
    }
    state->input[0] = '\0'
    state->input_cursor = 0
    state->comment_input[0] = '\0'
    state->comment_cursor = 0
    state->input_focused = 0
    state->editing_item = -1
    elist_reload(app)
    app_auto_sync(app)
}

elist_draw_empty :: (x: int, y: int, w: int) #private {
    title := GetLocaleText("elist_empty_title")
    detail := GetLocaleText("elist_empty_detail")

    Text((TextProps){
        .bounds = {(float)x, (float)y, (float)w, (float)Scale(30)},
        .text = title,
        .font = Text20,
        .color = GetThemeText(),
        .align = TextAlignCenter,
        .wrap = TextWrapAuto
    })
    Text((TextProps){
        .bounds = {(float)x, (float)(y + Scale(40)), (float)w, (float)Scale(48)},
        .text = detail,
        .font = GetSmallFontSize(),
        .color = GetThemeMutedText(),
        .align = TextAlignCenter,
        .wrap = TextWrapAuto
    })
}

draw_elist_screen :: (app: InnerBreeze*) {
    state: elist_types.EListState*
    left := app_nav_desktop_rail_enabled(app) ? app_nav_desktop_content_offset() : 0
    width := view_width - left
    pad := Scale(16)
    x := left + pad
    content_w := width - pad * 2
    title_h := Scale(58)
    y := title_h + Scale(12)
    hover := 0
    tab_h := Scale(36)
    list_options: [elist_types.ELIST_LIST_MAX] const char* = {0}

    if app == nil {
        return
    }
    state = &app->elist
    if !state->loaded {
        elist_reload(app)
    }

    TitleBar(GetLocaleText("elist_title"), title_h)
    if state->list_count > 0 && state->selected_list >= 0 &&
       PaddedIconBtn(0, left + width - Scale(88), Scale(9), Scale(22), Scale(8),
                     app->icons[UI_ICON_TYPE_EDIT], &hover) {
        elist_begin_input(app, -3, state->lists[state->selected_list].title)
    }
    if state->list_count > 0 && state->selected_list >= 0 &&
       PaddedIconBtn(0, left + width - Scale(48), Scale(9), Scale(22), Scale(8),
                     app->icons[UI_ICON_TYPE_TRASH], &hover) {
        storage_elist_delete_list(state->lists[state->selected_list].id)
        state->selected_list = 0
        elist_reload(app)
        app_auto_sync(app)
        return
    }
    for int i = 0; i < state->list_count; i++ {
        list_options[i] = state->lists[i].title
    }
    selector_w := content_w - Scale(112)
    if state->list_count > 0 {
        Dropdown(6500, x, y, selector_w, tab_h, list_options,
                 state->list_count, &state->selected_list)
    }
    if StyledButton(x + selector_w + Scale(8), y, Scale(104), tab_h,
                    GetLocaleText("elist_new_list"),
                    ButtonStyleSecondary, 0, &hover) {
        elist_begin_input(app, -2, "")
    }
    y += tab_h + Scale(16)

    if state->editing_item == -2 || state->editing_item == -3 {
        TextField(elist_field(app, (Rectangle){(float)x, (float)y,
                                               (float)content_w, (float)Scale(44)}))
        y += Scale(52)
        if StyledButton(x, y, content_w, Scale(40),
                        state->editing_item == -3 ? GetLocaleText("done_button") :
                                                    GetLocaleText("elist_create_list"),
                        ButtonStylePrimary, state->input[0] == '\0', &hover) {
            elist_commit_input(app)
        }
        return
    }

    if state->list_count == 0 {
        elist_draw_empty(x, y + Scale(48), content_w)
        return
    }

    field_w := content_w - Scale(92)
    TextField(elist_field(app, (Rectangle){(float)x, (float)y,
                                           (float)field_w, (float)Scale(44)}))
    if StyledButton(x + field_w + Scale(8), y, Scale(84), Scale(44),
                    state->editing_item >= 0 ? GetLocaleText("done_button") :
                                               GetLocaleText("elist_add_item"),
                    ButtonStylePrimary, state->input[0] == '\0', &hover) {
        elist_commit_input(app)
    }
    y += Scale(52)
    TextField(elist_comment_field(app, (Rectangle){(float)x, (float)y,
                                                   (float)content_w, (float)Scale(40)}))
    y += Scale(52)

    selected_id := state->lists[state->selected_list].id
    row_h := Scale(58)
    for int i = 0; i < state->item_count; i++ {
        item := &state->items[i]
        if strcmp(item->list_id, selected_id) != 0 {
            continue
        }
        if y + row_h > view_height - app_content_bottom_reserved(app) - Scale(8) {
            break
        }
        bounds := (Rectangle){(float)x, (float)y, (float)content_w, (float)row_h}
        DrawRectangleRounded(bounds, 0.08f, 8,
                             DarkenUIColor(GetThemeBackground(), 5))
        check_bounds := (Rectangle){(float)(x + Scale(10)),
                                    (float)(y + Scale(17)),
                                    (float)Scale(24), (float)Scale(24)}
        DrawRectangleRoundedLines(check_bounds, 0.24f, 6,
                                  item->done ? GetThemeButton() : GetThemeMutedText())
        if item->done {
            DrawLineEx((Vector2){check_bounds.x + Scale(5),
                                 check_bounds.y + Scale(12)},
                       (Vector2){check_bounds.x + Scale(10),
                                 check_bounds.y + Scale(17)},
                       Scale(2), GetThemeButton())
            DrawLineEx((Vector2){check_bounds.x + Scale(10),
                                 check_bounds.y + Scale(17)},
                       (Vector2){check_bounds.x + Scale(20),
                                 check_bounds.y + Scale(7)},
                       Scale(2), GetThemeButton())
        }
        if InvisibleButton((InvisibleButtonProps){.bounds = check_bounds,
                                                   .id = 6400 + i}) {
            storage_elist_update_item(item->id, item->title, item->comment,
                                      !item->done, item->sort_order)
            elist_reload(app)
            app_auto_sync(app)
            return
        }
        text_color := item->done ? GetThemeMutedText() : GetThemeText()
        Text((TextProps){
            .bounds = {(float)(x + Scale(46)), (float)(y + Scale(9)),
                       (float)(content_w - Scale(132)), (float)Scale(24)},
            .text = item->title,
            .font = GetFontSize(),
            .color = text_color,
            .wrap = TextWrapNone
        })
        if item->comment[0] != '\0' {
            Text((TextProps){
                .bounds = {(float)(x + Scale(46)), (float)(y + Scale(32)),
                           (float)(content_w - Scale(132)), (float)Scale(18)},
                .text = item->comment,
                .font = GetSmallFontSize(),
                .color = GetThemeMutedText(),
                .wrap = TextWrapNone
            })
        }
        if PaddedIconBtn(0, x + content_w - Scale(78), y + Scale(12),
                         Scale(20), Scale(7), app->icons[UI_ICON_TYPE_EDIT], &hover) {
            elist_begin_input(app, i, item->title)
            snprintf(state->comment_input, sizeof(state->comment_input), "%s",
                     item->comment)
            state->comment_cursor = (int)strlen(state->comment_input)
        }
        if PaddedIconBtn(0, x + content_w - Scale(40), y + Scale(12),
                         Scale(20), Scale(7), app->icons[UI_ICON_TYPE_TRASH], &hover) {
            storage_elist_delete_item(item->id)
            elist_reload(app)
            app_auto_sync(app)
            return
        }
        y += row_h + Scale(8)
    }
}

route elist {
    title "EList"
    group "App"
    page elist
}

elist :: (app: InnerBreeze*) #ui {
    Screen root: {
        draw_elist_screen(app)
    }
}
