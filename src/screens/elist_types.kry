#module "screens.elist_types"

ELIST_LIST_MAX :: 32
ELIST_ITEM_MAX :: 256
ELIST_TITLE_SIZE :: 128
ELIST_COMMENT_SIZE :: 512

EListList :: struct {
    id: [37]char
    title: [ELIST_TITLE_SIZE]char
    sort_order: int
    deleted_at: long long
    updated_at: long long
}

EListItem :: struct {
    id: [37]char
    list_id: [37]char
    title: [ELIST_TITLE_SIZE]char
    comment: [ELIST_COMMENT_SIZE]char
    done: int
    sort_order: int
    deleted_at: long long
    updated_at: long long
}

EListState :: struct {
    lists: [ELIST_LIST_MAX]EListList
    items: [ELIST_ITEM_MAX]EListItem
    list_count: int
    item_count: int
    selected_list: int
    loaded: int
    scroll: int
    input_cursor: int
    input_focused: int
    comment_cursor: int
    comment_focused: int
    editing_item: int
    input: [ELIST_TITLE_SIZE]char
    comment_input: [ELIST_COMMENT_SIZE]char
}
