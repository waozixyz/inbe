#module "habit_edit"

#import "app/app"
#import "habits/habit_model"
#import "habits/habit_sessions"
#import "practices/practice_registry"

static reminder_hour_texts: [24 * 8] char = {0}
#import "stddef.h"
#import "stdio.h"
#import "string.h"

begin_new :: (app: InnerBreeze*) {
    default_color: Color = {99, 196, 165, 255}

    if app == nil {
        return
    }

    app->habit_edit = (HabitEditState){
        .active = 1,
        .is_new = 1,
        .index = -1,
        .color = default_color,
        .sync_mode = HABIT_SYNC_NONE,
        .counter_target = 1,
        .reminder_hour = -1,
        .weekdays = HABIT_SCHEDULE_OFF,
        .sections = {1, 0, 1, 0}
    }
    app->habit_edit.cursor = (int)strlen(app->habit_edit.text)
    app->habit_edit.focused = 0
    app->habits.scroll = 0
    app->habits.tab = HABIT_TAB_EDIT
    app_switch_screen(app, ScreenHabitEdit)
}

begin :: (app: InnerBreeze*, index: int) {
    if app == nil || index < 0 || index >= app->habits.count {
        return
    }

    app->habit_edit = (HabitEditState){
        .active = 1,
        .index = index,
        .color = app->habits.items[index].color,
        .sync_mode = app->habits.items[index].sync_mode,
        .sync_activity = app->habits.items[index].sync_activity,
        .counter_enabled = app->habits.items[index].counter_enabled,
        .counter_target = app->habits.items[index].counter_target > 0
            ? app->habits.items[index].counter_target : 1,
        .weekdays = app->habits.items[index].weekdays,
        .reminder_hour = app->habits.items[index].reminder_hour,
        .sections = {1, 0, 1, 0}
    }
    snprintf(app->habit_edit.text, sizeof(app->habit_edit.text), "%s",
                app->habits.items[index].name)
    snprintf(app->habit_edit.description,
                sizeof(app->habit_edit.description), "%s",
                app->habits.items[index].description)
    app->habit_edit.cursor = (int)strlen(app->habit_edit.text)
    app->habit_edit.description_cursor =
        (int)strlen(app->habit_edit.description)
    app->habits.tab = HABIT_TAB_EDIT
    app->habits.scroll = 0
    app_switch_screen(app, ScreenHabitEdit)
}

cancel :: (app: InnerBreeze*) {
    if app == nil {
        return
    }

    app->habit_edit = (HabitEditState){
        .index = -1,
        .color = {99, 196, 165, 255},
        .sync_mode = HABIT_SYNC_NONE
    }
    SetFocusTextInputActive(0)
    if app->breathing.screen == ScreenHabitEdit {
        app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
        app->habits.selected = -1
        app->habits.tab = HABIT_TAB_WEEKLY
        app->habits.view_mode = HABIT_VIEW_WEEKLY
        app->habits.scroll = 0
    }
}

trimmed_text :: (app: InnerBreeze*) -> const char* #private {
    start: char* = nil
    end: char* = nil

    if app == nil {
        return ""
    }

    start = app->habit_edit.text
    while *start == ' ' || *start == '\t' {
        start++
    }
    end = start + strlen(start)
    while end > start && (end[-1] == ' ' || end[-1] == '\t') {
        end--
    }
    *end = '\0'
    return start
}

practice_picker :: (app: InnerBreeze*) -> int #private {
    modal_w := view_width - Scale(32)
    modal_h := Scale(344)

    result := 0
    if modal_w > Scale(400) { modal_w = Scale(400) }
    frame := AppModalFrame(modal_w, modal_h, GetLocaleText("habit_link_practices"),
                              0, 0)
    y := frame.content_y
    Text((TextProps){
        .bounds={(frame.content_x), (y), 0, 0},
        .text=(GetLocaleText("habit_link_practices_hint")),
        .wrap=TextWrapNone
    })
    y += Scale(28)
    for int i = 0; i < EXERCISE_COUNT; i++ {
        id := practice_ordered_id(i)
        mask := habit_activity_mask_for(id)
        enabled := (app->habit_edit.sync_activity & mask) != 0
        if Checkbox((CheckboxProps){
            .id = 9120 + i,
            .bounds = {(float)frame.content_x, (float)y,
                       (float)frame.content_w, (float)Scale(38)},
            .label = practice_activity_label(id),
            .value = &enabled
        }) {
            app->habit_edit.sync_activity = enabled
                ? (app->habit_edit.sync_activity | mask)
                : (app->habit_edit.sync_activity & ~mask)
        }
        y += Scale(42)
    }
    if Button((ButtonProps){
        .bounds = {(float)(frame.content_x), (float)(frame.y + frame.h - Scale(56)), (float)(frame.content_w), (float)(Scale(40))},
        .label = GetLocaleText("done_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        result = 1
    }
    if frame.right_clicked { result = 1 }
    return result
}

commit :: (app: InnerBreeze*) {
    name_text: const char* = nil
    index := 0
    if app == nil || !app->habit_edit.active {
        return
    }

    index = app->habit_edit.index
    if !app->habit_edit.is_new && (index < 0 || index >= app->habits.count) {
        cancel(app)
        return
    }

    name_text = trimmed_text(app)
    {
        app->habit_edit.name_error = name_text[0] == '\0' ? 1 :
            (habits_name_exists(&app->habits, name_text, app->habit_edit.is_new ? -1 : index) ? 2 : 0)
        if app->habit_edit.name_error {
            app->habit_edit.sections[0] = 1
            app->habits.scroll = 0
            return
        }
    }
    if name_text[0] != '\0' {
        if app->habit_edit.sync_activity != 0 {
            app->habit_edit.sync_mode = HABIT_SYNC_ACTIVITIES
        } else {
            app->habit_edit.sync_mode = HABIT_SYNC_NONE
        }
        if app->habit_edit.is_new {
            created := habits_add_custom(&app->habits, name_text,
                                         app->habit_edit.color,
                                         app->habit_edit.sync_mode,
                                         app->habit_edit.sync_activity)
            if created >= 0 && created < app->habits.count {
                app->habits.items[created].counter_enabled =
                    app->habit_edit.counter_enabled != 0
                app->habits.items[created].counter_target =
                    app->habit_edit.counter_target
                app->habits.items[created].weekdays =
                    app->habit_edit.weekdays & 0xff
                app->habits.items[created].reminder_hour =
                    app->habit_edit.reminder_hour
                snprintf(app->habits.items[created].description,
                            sizeof(app->habits.items[created].description),
                            "%s", app->habit_edit.description)
                habits_save(&app->habits)
            }
        } else {
            snprintf(app->habits.items[index].name,
                        sizeof(app->habits.items[index].name), "%s", name_text)
            snprintf(app->habits.items[index].description,
                        sizeof(app->habits.items[index].description), "%s",
                        app->habit_edit.description)
            app->habits.items[index].color = app->habit_edit.color
            app->habits.items[index].color.a = 255
            app->habits.items[index].sync_mode = app->habit_edit.sync_mode
            app->habits.items[index].sync_activity =
                app->habit_edit.sync_activity
            app->habits.items[index].counter_enabled =
                app->habit_edit.counter_enabled != 0
            app->habits.items[index].counter_target =
                app->habit_edit.counter_target
            app->habits.items[index].weekdays =
                app->habit_edit.weekdays & 0xff
            app->habits.items[index].reminder_hour =
                app->habit_edit.reminder_hour
            habits_save(&app->habits)
        }
        app_auto_sync(app)
    }

    cancel(app)
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = -1
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    app->habits.scroll = 0
    save_settings(app)
    app_switch_screen(app, ScreenHabits)
}

text_field :: (text: char*, text_size: size_t, cursor: int*,
                         focused: int*, max_codepoints: int) -> TextFieldProps #private {
    return (TextFieldProps){
        .bounds = {0},
        .text = text,
        .text_size = text_size,
        .cursor_position = cursor,
        .focused = focused,
        .max_codepoints = max_codepoints
    }
}

text_area :: (text: char*, text_size: size_t, cursor: int*,
                          focused: int*, scroll_y: int*, max_codepoints: int) -> TextAreaProps #private {
    return (TextAreaProps){
        .bounds = {0},
        .text = text,
        .text_size = text_size,
        .cursor_position = cursor,
        .focused = focused,
        .scroll_y = scroll_y,
        .max_codepoints = max_codepoints,
        .wrap = 1
    }
}

section_header_height :: (section: int) -> int #private {
    body_line := AppTextLineHeight(AppFontSize())
    if section == 2 {
        return body_line + AppTextLineHeight(AppSmallFontSize()) + Scale(22)
    }
    return body_line + Scale(24)
}

section_height :: (app: InnerBreeze*, section: int, width: int) -> int #private {
    header := section_header_height(section)
    if !app->habit_edit.sections[section] {
        return header
    }
    columns := width / Scale(48)
    if columns < 1 { columns = 1 }
    if section == 0 {
        count := app->habit_edit.more_colors ? 12 : 7
        label_lines := AppTextLineHeight(AppSmallFontSize()) * 3
        return header + label_lines + Scale(132) +
            ((count + columns - 1) / columns) * Scale(44)
    }
    if section == 1 {
        scheduled := (app->habit_edit.weekdays & HABIT_SCHEDULE_OFF) == 0
        return header + Scale(scheduled ? 196 : 108)
    }
    return header + Scale(app->habit_edit.counter_enabled ? 156 : 104)
}

content_height :: (width: int, user_data: void*) -> int #private {
    app := (InnerBreeze*)user_data
    height := Scale(16)
    for int i = 0; i < 3; i++ {
        height += section_height(app, i, width - Scale(24)) + Scale(12)
    }
    return height
}

# Scrolls the edit form so a focused field stays inside the viewport. Mirrors
# the clamp-adjust-clamp policy kryon's internal scroll-rect helper used.
ensure_field_visible :: (scroll_offset: int*, viewport_y: int, viewport_h: int,
                         content_h: int, rect: Rectangle, margin: int) #private {
    max_scroll := content_h - viewport_h
    next := 0
    viewport_top := 0
    viewport_bottom := 0

    if scroll_offset == nil || max_scroll <= 0 {
        return
    }

    next = clampi(*scroll_offset, 0, max_scroll)
    viewport_top = viewport_y + margin
    viewport_bottom = viewport_y + viewport_h - margin
    if viewport_bottom < viewport_top {
        viewport_bottom = viewport_top
    }
    if (int)rect.y + (int)rect.height > viewport_bottom {
        next += (int)rect.y + (int)rect.height - viewport_bottom
    }
    if (int)rect.y < viewport_top {
        next -= viewport_top - (int)rect.y
    }
    *scroll_offset = clampi(next, 0, max_scroll)
}

draw_form :: (app: InnerBreeze*) #private {
    if app->modal.active {
        if app->modal.type == UIModalHabitPracticePicker {
            if practice_picker(app) { app_close_modal(app) }
        } else if app->modal.type == UIModalConfirmDeleteHabit {
            actions: [2] ModalAction = {
                {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
                {GetLocaleText("delete_button"), ButtonToneDanger, ButtonEmphasisFilled, 0},
            }
            result := Modal((ModalProps){
                .title = GetLocaleText("habit_delete_title"),
                .message = GetLocaleText("habit_delete_message"),
                .actions = actions,
                .action_count = 2
            })
            if result == 1 { app_close_modal(app) }
            if result == 2 {
                index := app->habit_edit.index
                app_close_modal(app)
                cancel(app)
                habits_delete(&app->habits, index)
                app_auto_sync(app)
                save_settings(app)
                app_switch_screen(app, ScreenHabits)
            }
        }
        return
    }
    top := Scale(56)
    footer := Scale(app->habit_edit.name_error ? 92 : 64)

    font := AppFontSize()
    small := AppSmallFontSize()
    if IsKeyPressed(KEY_ESCAPE) {
        cancel(app)
        app_switch_screen(app, ScreenHabits)
        return
    }
    title := GetLocaleText(app->habit_edit.is_new ? "habit_new_title" : "habit_edit_title")
    if TitleBar((TitleBarProps){.title = title, .height = top,
                                .has_leading_action = 1}) {
        cancel(app)
        app_switch_screen(app, ScreenHabits)
        return
    }

    viewport_h := view_height - top - footer
    content_x := 0
    content_w := 0
    GetCenteredColumn(Scale(CONTENT_MAX_W), GetPageSidePadding(),
                      &content_x, &content_w)
    page_content_h := content_height(content_w, app)
    resized := app->habit_edit.form_viewport_height != view_height
    app->habit_edit.form_viewport_height = view_height
    x := content_x
    w := content_w
    y := 0
    titles: [3] const char* = {
        GetLocaleText("habit_details_title"), GetLocaleText("habit_routine_title"),
        GetLocaleText("habit_tracking_title")
    }
    Scroll page: {
        bounds = (Rectangle){(float)0, (float)top, (float)view_width, (float)viewport_h}
        content_height = page_content_h
        scroll_offset = &app->habits.scroll

        y := page.y + Scale(8)
        for int section = 0; section < 3; section++ {
        header := section_header_height(section)
        height := section_height(app, section, w - Scale(24))
        open := app->habit_edit.sections[section]
        DrawRectangleRounded((Rectangle){(float)x, (float)y, (float)w, (float)height},
                             0.08f, 10, StyleTokenColor("surface"))
        if Button((ButtonProps){
            .bounds = {(float)x, (float)y, (float)w, (float)header}, .id = 7510 + section,
            .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
        }) {
            app->habit_edit.sections[section] = !app->habit_edit.sections[section]
            SetFocusTextInputActive(0)
            app->habit_edit.focused = 0
            app->habit_edit.description_focused = 0
        }
        px := x + Scale(12)
        inner := w - Scale(24)
        if section == 2 {
            title_y := y + Scale(10)
            Text((TextProps){
                .bounds={(px), (title_y), 0, 0},
                .text=(titles[section]),
                .font=font,
                .wrap=TextWrapNone
            })
            Text((TextProps){
                .bounds={(px), (title_y + AppTextLineHeight(font) + Scale(2)), 0, 0},
                .text=(GetLocaleText("habit_tracking_hint")),
                .wrap=TextWrapNone
            })
        } else {
            Text((TextProps){
                .bounds={(float)px, (float)y, (float)inner, (float)header},
                .text=(titles[section]),
                .font=font,
                .wrap=TextWrapNone,
                .vertical_align=TextAlignCenter
            })
        }
        if section == 1 && !app->habit_edit.sections[section] {
            summary: [16] char = {0}
            status: const char* = GetLocaleText("habit_reminder_off")
            if (app->habit_edit.weekdays & HABIT_SCHEDULE_OFF) == 0 {
                status = app->habit_edit.weekdays == 0 ? GetLocaleText("habit_every_day") : GetLocaleText("habit_schedule_custom")
            } else if app->habit_edit.reminder_hour >= 0 {
                snprintf(summary, sizeof(summary), "%02d:00", app->habit_edit.reminder_hour)
                status = summary
            }
            status_width := AppTextWidth(status, small)
            Text((TextProps){
                .bounds={(float)(x + w - Scale(44) - status_width),
                         (float)y, (float)status_width, (float)header},
                .text=(status),
                .font=small,
                .wrap=TextWrapNone,
                .vertical_align=TextAlignCenter
            })
        }
        cx := x + w - Scale(24)
        cy := y + header / 2
        direction := app->habit_edit.sections[section] ? -1 : 1
        DrawLineEx((Vector2){(float)(cx - Scale(5)), (float)(cy - direction * Scale(2))},
                   (Vector2){(float)cx, (float)(cy + direction * Scale(3))}, Scale(2), StyleTokenColor("text"))
        DrawLineEx((Vector2){(float)cx, (float)(cy + direction * Scale(3))},
                   (Vector2){(float)(cx + Scale(5)), (float)(cy - direction * Scale(2))}, Scale(2), StyleTokenColor("text"))
        row := y + header + Scale(4)
        columns := inner / Scale(48)
        if columns < 1 { columns = 1 }
        if open && section == 0 {
            label_line := AppTextLineHeight(small)
            Text((TextProps){
                .bounds={(px), (row), 0, 0},
                .text=(GetLocaleText("habit_name_label")),
                .wrap=TextWrapNone
            })
            field := text_field(app->habit_edit.text, sizeof(app->habit_edit.text),
                                &app->habit_edit.cursor, &app->habit_edit.focused, HABIT_NAME_SIZE - 1)
            field_y := row + label_line + Scale(4)
            field.bounds = (Rectangle){(float)px, (float)field_y,
                                       (float)inner, (float)Scale(44)}
            name_focused := app->habit_edit.focused
            TextField(field)
            if app->habit_edit.focused && (!name_focused || resized) {
                ensure_field_visible(&app->habits.scroll, top, viewport_h,
                                     page_content_h, field.bounds, Scale(12))
            }
            row = field_y + Scale(54)
            Text((TextProps){
                .bounds={(px), (row), 0, 0},
                .text=(GetLocaleText("habit_description_label")),
                .wrap=TextWrapNone
            })
            area := text_area(app->habit_edit.description, sizeof(app->habit_edit.description),
                              &app->habit_edit.description_cursor, &app->habit_edit.description_focused,
                              &app->habit_edit.description_scroll_y, HABIT_DESCRIPTION_SIZE - 1)
            area_y := row + label_line + Scale(4)
            area.bounds = (Rectangle){(float)px, (float)area_y,
                                      (float)inner, (float)Scale(48)}
            description_focused := app->habit_edit.description_focused
            TextArea(area)
            if app->habit_edit.description_focused && (!description_focused || resized) {
                ensure_field_visible(&app->habits.scroll, top, viewport_h,
                                     page_content_h, area.bounds, Scale(12))
            }
            row = area_y + Scale(58)
            Text((TextProps){
                .bounds={(px), (row), 0, 0},
                .text=(GetLocaleText("habit_color_label")),
                .wrap=TextWrapNone
            })
            row += label_line + Scale(4)
            colors: [12] Color = {
                {99,196,165,255}, {94,166,232,255}, {180,132,220,255},
                {216,116,164,255}, {232,150,74,255}, {160,196,82,255},
                {224,92,92,255}, {224,124,104,255}, {210,180,72,255},
                {74,186,198,255}, {116,132,224,255}, {198,96,118,255}
            }
            count := app->habit_edit.more_colors ? 12 : 7
            for int c = 0; c < count; c++ {
                cell: Rectangle = {(float)(px + (c % columns) * Scale(48)),
                    (float)(row + (c / columns) * Scale(44)), (float)Scale(48), (float)Scale(44)}
                more := c == 6 && !app->habit_edit.more_colors
                chosen := !more && app->habit_edit.color.r == colors[c].r &&
                    app->habit_edit.color.g == colors[c].g &&
                    app->habit_edit.color.b == colors[c].b
                color := more ? StyleTokenColor("accent") : colors[c]
                if Button((ButtonProps){
                    .bounds = {cell.x + Scale(4), cell.y + Scale(2),
                               (float)Scale(40), (float)Scale(40)},
                    .id = 7530 + c, .label = more ? "..." : "",
                    .circle = 1, .selected = chosen,
                    .icon_type = chosen ? ICON_CHECK : ICON_NONE,
                    .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisFilled,
                    .swatch = 1, .swatch_color = color
                }) {
                    if more {
                        app->habit_edit.more_colors = 1
                    } else {
                        app->habit_edit.color = colors[c]
                    }
                }
            }
        }
        if open && section == 1 {
            schedule_enabled := (app->habit_edit.weekdays & HABIT_SCHEDULE_OFF) == 0
            Text((TextProps){
                .bounds={(px), (row + Scale(14)), 0, 0},
                .text=(GetLocaleText("habit_schedule_enabled")),
                .wrap=TextWrapNone
            })
            if Toggle((ToggleProps){.id = 7600,
                      .bounds = {px + inner - Scale(56), row + Scale(7),
                                 Scale(56), Scale(30)},
                      .value = &schedule_enabled,
                      .off_label = GetLocaleText("toggle_off"),
                      .on_label = GetLocaleText("toggle_on")}) {
                app->habit_edit.weekdays = schedule_enabled ? 0 : HABIT_SCHEDULE_OFF
            }
            row += Scale(52)
            if schedule_enabled {
                if Button((ButtonProps){
                    .bounds = {(float)(px), (float)(row), (float)(inner), (float)(Scale(40))},
                    .label = GetLocaleText("habit_every_day"),
                    .tone = app->habit_edit.weekdays == 0 ? ButtonToneAccent : ButtonToneNeutral,
                    .emphasis = (app->habit_edit.weekdays == 0 ? ButtonToneAccent : ButtonToneNeutral) == ButtonToneAccent ? ButtonEmphasisFilled : ButtonEmphasisSoft,
                    .disabled = 0
                }) {
                    app->habit_edit.weekdays = 0
                }
                row += Scale(44)
                days: [7] const char* = {GetLocaleText("habit_day_mon"), GetLocaleText("habit_day_tue"),
                    GetLocaleText("habit_day_wed"), GetLocaleText("habit_day_thu"), GetLocaleText("habit_day_fri"),
                    GetLocaleText("habit_day_sat"), GetLocaleText("habit_day_sun")}
                for int d = 0; d < 7; d++ {
                    mask := app->habit_edit.weekdays == 0 ? 127 : app->habit_edit.weekdays
                    dx := px + (d % columns) * Scale(48)
                    dy := row + (d / columns) * Scale(44)
                    selected := (mask & (1 << d)) != 0
                    if Button((ButtonProps){
                        .bounds = {(float)(dx + Scale(4)), (float)(dy + Scale(4)),
                                   (float)Scale(40), (float)Scale(40)},
                        .id = 7560 + d, .label = days[d],
                        .circle = 1, .selected = selected,
                        .tone = selected ? ButtonToneAccent : ButtonToneNeutral,
                        .emphasis = ButtonEmphasisSoft
                    }) {
                        mask = mask ^ (1 << d)
                        if mask != 0 {
                            app->habit_edit.weekdays = mask == 127 ? 0 : mask
                        }
                    }
                }
                row += Scale(44)
            }
            Text((TextProps){
                .bounds={(px), (row + Scale(15)), 0, 0},
                .text=(GetLocaleText("habit_reminder_label")),
                .wrap=TextWrapNone
            })
            labels: [25] const char* = {0}
            labels[0] = GetLocaleText("habit_reminder_off")
            for int h = 0; h < 24; h++ {
                snprintf(&reminder_hour_texts[h * 8], 8, "%02d:00", h)
                labels[h + 1] = &reminder_hour_texts[h * 8]
            }
            selected := app->habit_edit.reminder_hour + 1
            dropdown_w := Scale(136)
            if Dropdown((DropdownProps){.id = 7400,
                        .bounds = {px + inner - dropdown_w, row + Scale(4), dropdown_w, Scale(44)},
                        .options = labels, .option_count = 25,
                        .selected_index = &selected}) {
                app->habit_edit.reminder_hour = selected - 1
            }
        }
        if open && section == 2 {
            Text((TextProps){
                .bounds={(px), (row + Scale(14)), 0, 0},
                .text=(GetLocaleText("habit_counter_mode")),
                .wrap=TextWrapNone
            })
            Toggle((ToggleProps){.id = 7610,
                   .bounds = {px + inner - Scale(56), row + Scale(7),
                              Scale(56), Scale(30)},
                   .value = &app->habit_edit.counter_enabled,
                   .off_label = GetLocaleText("toggle_off"),
                   .on_label = GetLocaleText("toggle_on")})
            row += Scale(52)
            if app->habit_edit.counter_enabled {
                target_label := GetLocaleText("habit_counter_target")
                target_text: [16] char = {0}
                control_w := Scale(136)
                button_w := Scale(44)
                control_x := px + inner - control_w

                Text((TextProps){
                    .bounds={(px), (row + Scale(14)), 0, 0},
                    .text=(target_label),
                    .wrap=TextWrapNone
                })
                if Button((ButtonProps){
                    .bounds = {(float)(control_x), (float)(row), (float)(button_w), (float)(Scale(44))},
                    .label = "-",
                    .tone = ButtonToneNeutral,
                    .emphasis = ButtonEmphasisSoft,
                    .disabled = app->habit_edit.counter_target <= 1
                }) {
                    app->habit_edit.counter_target--
                }
                snprintf(target_text, sizeof(target_text), "%d",
                         app->habit_edit.counter_target)
                Text((TextProps){
                    .bounds={(control_x + button_w + (control_w - button_w * 2 - AppTextWidth(target_text, font)) / 2), (AppControlTextY(target_text, row, Scale(44), font)), 0, 0},
                    .text=(target_text),
                    .wrap=TextWrapNone
                })
                if Button((ButtonProps){
                    .bounds = {(float)(control_x + control_w - button_w), (float)(row), (float)(button_w), (float)(Scale(44))},
                    .label = "+",
                    .tone = ButtonToneNeutral,
                    .emphasis = ButtonEmphasisSoft,
                    .disabled = app->habit_edit.counter_target >= 99
                }) {
                    app->habit_edit.counter_target++
                }
                row += Scale(52)
            }
            linked_count := 0
            for int i = 0; i < EXERCISE_COUNT; i++ {
                if (app->habit_edit.sync_activity & habit_activity_mask_for(practice_ordered_id(i))) != 0 { linked_count++ }
            }
            linked_summary: [32] char = {0}
            snprintf(linked_summary, sizeof(linked_summary), "%s · %d",
                     GetLocaleText("habit_link_practices"), linked_count)
            if Button((ButtonProps){
                .bounds = {(float)(px), (float)(row), (float)(inner), (float)(Scale(44))},
                .label = linked_summary,
                .tone = ButtonToneNeutral,
                .emphasis = ButtonEmphasisSoft,
                .disabled = 0
            }) {
                app_open_modal(app, UIModalHabitPracticePicker)
            }
        }
        y += height + Scale(12)
        }
    }
    DrawRectangle(0, view_height - footer, view_width, footer, StyleTokenColor("canvas"))
    if app->habit_edit.name_error {
        message := GetLocaleText(app->habit_edit.name_error == 1 ? "habit_name_required" : "habit_name_duplicate")
        Text((TextProps){
            .bounds={(x), (view_height - footer + Scale(8)), 0, 0},
            .text=(message),
            .wrap=TextWrapNone
        })
    }
    action_x := x
    action_w := w
    if !app->habit_edit.is_new {
        delete_w := Scale(104)
        if Button((ButtonProps){
            .bounds = {(float)(x), (float)(view_height - Scale(54)), (float)(delete_w), (float)(Scale(44))},
            .label = GetLocaleText("habit_delete_button"),
            .tone = ButtonToneDanger,
            .emphasis = ButtonEmphasisFilled,
            .disabled = 0
        }) {
            app_open_modal(app, UIModalConfirmDeleteHabit)
        }
        action_x += delete_w + Scale(8)
        action_w -= delete_w + Scale(8)
    }
    if Button((ButtonProps){
        .bounds = {(float)(action_x), (float)(view_height - Scale(54)), (float)(action_w), (float)(Scale(44))},
        .label = GetLocaleText(app->habit_edit.is_new ? "habit_create_button" : "save_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        commit(app)
    }
}

draw :: (app: InnerBreeze*) {
    if app == nil { return }
    if !app->habit_edit.active {
        app_switch_screen(app, ScreenHabits)
        return
    }
    draw_form(app)
}

route habit_edit {
    title "Edit Habit"
    group "Habits"
    page habit_edit
}

habit_edit :: (app: InnerBreeze*) #ui {
    Screen root: {
    habit_edit_draw(app)
    }
}
