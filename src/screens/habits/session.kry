#module "habit_session"

#import "app/app"
#import "habits/habit_model"
#import "habits/habit_sessions"
#import "platform.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

ANDROID :: ANDROID_BUILD

ScrollPageContext :: struct {
    app: InnerBreeze*
    linked: HabitLinkedContext*
    y: int
}

begin_round_edit :: (app: InnerBreeze*, entry: const HabitLinkedEntry*,
                    round: int) #private {
    if app == nil || entry == nil || round < 0 || round >= entry->round_count {
        return
    }

    app->habit_session_edit.active = 1
    app->habit_session_edit.kind = HABIT_SESSION_EDIT_ROUND
    app->habit_session_edit.round = round
    snprintf(app->habit_session_edit.path,
                sizeof(app->habit_session_edit.path), "%s", entry->path)
    snprintf(app->habit_session_edit.text,
                sizeof(app->habit_session_edit.text), "%d",
                entry->rounds[round])
    app->habit_session_edit.cursor =
        (int)strlen(app->habit_session_edit.text)
}

text_filter :: (codepoint: int, user_data: void*) -> int #private {
    if codepoint >= '0' && codepoint <= '9' {
        return 1
    }

    unused user_data
    return 0
}

delete_round :: (entry: const HabitLinkedEntry*, round: int) -> int #private {
    rounds: [MaxRounds] int
    out_count := 0

    if entry == nil || round < 0 || round >= entry->round_count {
        return 0
    }
    if entry->round_count <= 1 {
        return data_delete_session(entry->path)
    }

    for int i = 0; i < entry->round_count; i++ {
        if i != round {
            rounds[out_count++] = entry->rounds[i]
        }
    }

    return data_replace_session(entry->path, rounds, out_count)
}

handle_physical_keyboard :: (app: InnerBreeze*,
                            entry: const HabitLinkedEntry*) -> int #private {
    commit_pressed := 0

    if app == nil || entry == nil || !app->habit_session_edit.active {
        return 0
    }

    if IsKeyPressed(KEY_ESCAPE) {
        habit_session_cancel_edit(app)
        return 1
    }

    EditText((TextEdit){
        .text = app->habit_session_edit.text,
        .text_size = sizeof(app->habit_session_edit.text),
        .cursor_position = &app->habit_session_edit.cursor,
        .max_codepoints = 3,
        .filter = habit_session_text_filter,
        .filter_user_data = app,
        .commit_pressed = &commit_pressed
    })

    if commit_pressed {
        return habit_session_commit_edit(app, entry)
    }

    return 0
}

scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (ScrollPageContext*)user_data

    return habit_session_draw_edit_content(ctx->app, ctx->linked,
                                           0, content_w, ctx->y, 0) -
           ctx->y
}

draw_edit_screen :: (app: InnerBreeze*) {
    ctx: HabitLinkedContext
    habit: Habit* = nil
    date_text: [32] char = {0}
    top_h := Scale(58)
    bottom_reserved := 0
    keyboard_h := 0
    viewport_h := 0
    max_w := Scale(400)
    y := top_h + Scale(14)

    if app == nil {
        return
    }

    bottom_reserved = app_content_bottom_reserved(app)
    if app->habit_detail_index < 0 ||
       app->habit_detail_index >= app->habits.count {
        app_switch_screen(app, ScreenHabits)
        return
    }

    habit = &app->habits.items[app->habit_detail_index]
    habit_collect_linked_entries(habit, app->habit_detail_day, &ctx)
    if ctx.count <= 0 {
        habit_session_cancel_edit(app)
        app_switch_screen(app, ScreenHabits)
        return
    }
    habit_format_date(app->habit_detail_day, date_text, sizeof(date_text))

    keyboard_h = habit_session_keyboard_height(app)
    viewport_h = view_height - top_h - bottom_reserved - keyboard_h
    if viewport_h < Scale(80) {
        viewport_h = Scale(80)
    }

    if app_draw_close_title_bar(app, date_text, top_h) {
        habit_session_cancel_edit(app)
        app_switch_screen(app, ScreenHabits)
        return
    }

    page_ctx: ScrollPageContext = {app, &ctx, y}
    content_x := 0
    content_w := 0
    GetCenteredColumn(max_w, GetPageSidePadding(), &content_x, &content_w)
    content_h := scroll_page_content_height(content_w, &page_ctx)
    Scroll page: {
        bounds = (Rectangle){(float)0, (float)y, (float)view_width, (float)viewport_h}
        content_height = content_h
        scroll_offset = &app->habit_session_edit.scroll

        habit_session_draw_edit_content(app, &ctx, content_x,
                                           content_w, page.y, 1)
    }

    if app->habit_session_edit.active {
        active_entry: HabitLinkedEntry* = nil

        for int i = 0; i < ctx.count; i++ {
            if strcmp(app->habit_session_edit.path, ctx.entries[i].path) == 0 {
                active_entry = &ctx.entries[i]
                break
            }
        }
        if active_entry != nil {
            if handle_physical_keyboard(app, active_entry) {
                return
            }
            if habit_session_draw_keyboard(app, active_entry) {
                return
            }
        }
    }
}

draw_edit_content :: (app: InnerBreeze*, ctx: HabitLinkedContext*,
                         content_x: int, content_w: int, y: int,
                         draw: int) -> int {
    row_h := Scale(48)
    section_gap := Scale(22)
    title_h := Scale(38)
    summary_h := Scale(40)

    if app == nil || ctx == nil {
        return y
    }

    if ctx->count <= 0 {
        if draw {
            Text((TextProps){
                .bounds={(content_x), (y), 0, 0},
                .text=(GetLocaleText("no_sessions")),
                .wrap=TextWrapNone
            })
        }
        return y + summary_h
    }

    for int activity = 0; activity < EXERCISE_COUNT; activity++ {
        has_activity := 0

        for int i = 0; i < ctx->count; i++ {
            if ctx->entries[i].activity == activity {
                has_activity = 1
                break
            }
        }
        if !has_activity {
            continue
        }

        title := practice_activity_label(activity)
        if draw {
            Text((TextProps){
                .bounds={(content_x), (y), (content_w), (title_h)},
                .text=(title),
                .font=AppTitleFontSize(title, content_w),
                .wrap=TextWrapNone
            })
        }
        y += Scale(16)

        for int i = 0; i < ctx->count; i++ {
            time_text: [16] char = {0}
            summary_text: [32] char = {0}
            icon_w := Scale(40)
            trash_x := content_x + content_w - icon_w
            row_font := AppFontSize()
            summary_x := content_x + Scale(100)

            if ctx->entries[i].activity != activity {
                continue
            }

            snprintf(time_text, sizeof(time_text), "%02d:%02d",
                        ctx->entries[i].hour, ctx->entries[i].minute)
            if activity == EXERCISE_SUN_SALUTATION {
                FormatLocaleText(summary_text, sizeof(summary_text),
                                    "practice_home_repetitions",
                                    ctx->entries[i].round_count > 0
                                        ? ctx->entries[i].rounds[0]
                                        : 1)
            } else if activity == EXERCISE_MEDITATION {
                habit_format_duration(ctx->entries[i].total_seconds,
                                         summary_text, sizeof(summary_text))
            } else {
                FormatLocaleText(summary_text, sizeof(summary_text),
                                    "results_rounds",
                                    ctx->entries[i].round_count)
            }
            summary_too_wide := summary_x + AppTextWidth(summary_text, row_font) > trash_x - Scale(8)
            if summary_too_wide {
                summary_x = content_x + Scale(68)
            }

            if draw {
                Text((TextProps){
                    .bounds={(content_x), (y), (summary_x - content_x - Scale(8)), (summary_h)},
                    .text=(time_text),
                    .font=row_font,
                    .wrap=TextWrapNone, .vertical_align=TextAlignCenter
                })
                Text((TextProps){
                    .bounds={(summary_x), (y), (trash_x - summary_x - Scale(8)), (summary_h)},
                    .text=(summary_text),
                    .font=row_font,
                    .wrap=TextWrapNone, .vertical_align=TextAlignCenter
                })
                if !app->habit_session_edit.active && Button((ButtonProps){
                    .id = 0,
                    .bounds = {(float)(trash_x), (float)(y + (summary_h - icon_w) / 2),
                               (float)(icon_w), (float)(icon_w)},
                    .icon_type = ICON_TRASH, .icon_only = 1,
                    .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
                }) {
                    if data_delete_session(ctx->entries[i].path) {
                        habit_session_changed(app, ctx->count)
                    }
                    habit_session_cancel_edit(app)
                    return y
                }
                Line(content_x, y + summary_h + Scale(8),
                     content_x + content_w, y + summary_h + Scale(8),
                     Fade(StyleTokenColor("text"), 0.22f))
            }
            y += summary_h + Scale(18)

            if activity == EXERCISE_MEDITATION ||
               activity == EXERCISE_SUN_SALUTATION {
                y += Scale(4)
                continue
            }

            for int r = 0; r < ctx->entries[i].round_count; r++ {
                round_label: [64] char = {0}
                round_value: [24] char = {0}
                round_trash_x := content_x + content_w - icon_w
                round_edit_x := round_trash_x - icon_w - Scale(8)
                value_x := content_x + content_w / 3
                value_w := round_edit_x - value_x - Scale(8)
                editing_round: int = app->habit_session_edit.active &&
                                 app->habit_session_edit.kind == HABIT_SESSION_EDIT_ROUND &&
                                 app->habit_session_edit.round == r &&
                                 strcmp(app->habit_session_edit.path,
                                        ctx->entries[i].path) == 0
                value_text_x := editing_round ? value_x - Scale(8) : value_x
                value_text_w := editing_round ? Scale(78) : value_w

                FormatLocaleText(round_label, sizeof(round_label),
                                    "round_number_label", r + 1)
                if editing_round {
                    snprintf(round_value, sizeof(round_value), "%s",
                             app->habit_session_edit.text)
                } else {
                    FormatLocaleText(round_value, sizeof(round_value),
                                     "results_metric_seconds",
                                     ctx->entries[i].rounds[r])
                }
                if draw {
                    if editing_round {
                        selection: Rectangle = {(float)content_x, (float)y,
                                                (float)content_w, (float)row_h}
                        DrawRectangleRounded(selection, 0.12f, 8,
                                             Fade(StyleTokenColor("surface"), 0.75f))
                        DrawRectangleRoundedLinesEx(selection, 0.12f, 8, 1.0f,
                                                     Fade(StyleTokenColor("text"), 0.55f))
                        value_field: Rectangle = {(float)(value_x - Scale(8)),
                                                  (float)(y + Scale(5)),
                                                  (float)Scale(78),
                                                  (float)(row_h - Scale(10))}
                        DrawRectangleRoundedLinesEx(value_field, 0.12f, 8, 1.0f,
                                                     StyleTokenColor("text"))
                    }
                    Text((TextProps){
                        .bounds={(content_x), (y),
                                 (value_x - content_x - Scale(8)), (row_h)},
                        .text=(round_label), .font=row_font,
                        .wrap=TextWrapNone, .vertical_align=TextAlignCenter
                    })
                    Text((TextProps){
                        .bounds={(value_text_x), (y), (value_text_w), (row_h)},
                        .text=(round_value), .font=Scale(19),
                        .wrap=TextWrapNone,
                        .align=editing_round ? TextAlignCenter : TextAlignStart,
                        .vertical_align=TextAlignCenter
                    })
                    if !app->habit_session_edit.active && Button((ButtonProps){
                        .id = 0,
                        .bounds = {(float)(round_edit_x), (float)(y + (row_h - icon_w) / 2),
                                   (float)(icon_w), (float)(icon_w)},
                        .icon_type = ICON_EDIT,
                        .icon_only = 1,
                        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
                    }) {
                        begin_round_edit(app, &ctx->entries[i], r)
                        return y
                    }
                    if !app->habit_session_edit.active && Button((ButtonProps){
                        .id = 0,
                        .bounds = {(float)(round_trash_x), (float)(y + (row_h - icon_w) / 2),
                                   (float)(icon_w), (float)(icon_w)},
                        .icon_type = ICON_TRASH, .icon_only = 1,
                        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
                    }) {
                        if delete_round(&ctx->entries[i], r) {
                            habit_session_changed(app, ctx->count)
                        }
                        habit_session_cancel_edit(app)
                        return y
                    }
                    Line(content_x, y + row_h, content_x + content_w,
                         y + row_h, Fade(StyleTokenColor("text"), 0.22f))
                }
                y += row_h
            }
            y += Scale(12)
        }
        y += section_gap
    }

    if ctx->day_filter > 0 &&
       app->habit_detail_index >= 0 &&
       app->habit_detail_index < app->habits.count {
        habit: Habit* = &app->habits.items[app->habit_detail_index]

        if habit_counting_enabled(habit) {
            minimum_count := ctx->count
            total_count := habit_effective_day_count(habit, ctx->day_filter, ctx)
            button_h := Scale(34)
            step_w := Scale(42)
            gap := Scale(8)
            minus_x := content_x
            plus_x := content_x + content_w - step_w
            label_x := minus_x + step_w + gap
            label_w := plus_x - label_x - gap

            total_text: [64] char = {0}

            y += Scale(6)
            if draw {
                FormatLocaleText(total_text, sizeof(total_text),
                                    "habit_session_total_count", total_count)
                if Button((ButtonProps){
                    .bounds = {(float)(minus_x), (float)(y), (float)(step_w), (float)(button_h)},
                    .label = "-",
                    .tone = ButtonToneNeutral,
                    .emphasis = ButtonEmphasisSoft,
                    .disabled = total_count <= minimum_count
                }) {
                    habit_apply_count_action(app, app->habit_detail_index,
                                                ctx->day_filter, -1,
                                                minimum_count)
                    app_auto_sync(app)
                    return y
                }
                DrawRectangle(label_x, y, label_w, button_h,
                                 DarkenColor(StyleTokenColor("canvas"), 5))
                Text((TextProps){
                    .bounds={(label_x + Scale(8)), (AppControlTextY(total_text, y, button_h, AppSmallFontSize())), 0, 0},
                    .text=(total_text),
                    .wrap=TextWrapNone
                })
                if Button((ButtonProps){
                    .bounds = {(float)(plus_x), (float)(y), (float)(step_w), (float)(button_h)},
                    .label = "+",
                    .tone = ButtonToneNeutral,
                    .emphasis = ButtonEmphasisSoft,
                    .disabled = 0
                }) {
                    habit_apply_count_action(app, app->habit_detail_index,
                                                ctx->day_filter, 1,
                                                minimum_count)
                    app_auto_sync(app)
                    return y
                }
            }
            y += button_h + Scale(8)
        }
    }

    return y
}

keyboard_height :: (app: InnerBreeze*) -> int {
    key_h := Scale(48)
    gap := Scale(6)
    pad := Scale(10)
    header_h := Scale(54)
    action_h := Scale(44)

    #if !ANDROID {
        if app == nil || !app->on_screen_keyboard_enabled {
            return 0
        }
    }
    if app == nil || !app->habit_session_edit.active {
        return 0
    }
    return pad * 2 + header_h + key_h * 4 + gap * 4 + action_h
}

draw_keyboard :: (app: InnerBreeze*, entry: const HabitLinkedEntry*) -> int {
    labels: [12] const char* = {
        "1", "2", "3",
        "4", "5", "6",
        "7", "8", "9",
        "DEL", "0", ""
    }
    key_h := Scale(48)
    gap := Scale(6)
    pad := Scale(10)
    header_h := Scale(54)
    action_h := Scale(44)
    keyboard_h := habit_session_keyboard_height(app)
    x := GetPageSidePadding()
    y := view_height - keyboard_h
    w := view_width - x * 2
    key_w := (w - gap * 2) / 3
    round_label: [64] char = {0}
    value_label: [24] char = {0}

    #if !ANDROID {
        if app == nil || !app->on_screen_keyboard_enabled {
            return 0
        }
    }
    if app == nil || !app->habit_session_edit.active || keyboard_h <= 0 {
        return 0
    }

    DrawRectangle(0, y, view_width, keyboard_h,
                     DarkenColor(StyleTokenColor("canvas"), 10))
    DrawLine(0, y, view_width, y, DarkenColor(StyleTokenColor("canvas"), 42))

    FormatLocaleText(round_label, sizeof(round_label),
                     "round_number_label", app->habit_session_edit.round + 1)
    snprintf(value_label, sizeof(value_label), "%s",
             app->habit_session_edit.text)
    Text((TextProps){
        .bounds={(x), (y + pad), (w), (Scale(22))},
        .text=(round_label), .font=AppFontSize(),
        .wrap=TextWrapNone, .align=TextAlignCenter
    })
    Text((TextProps){
        .bounds={(x), (y + pad + Scale(24)), (w), (Scale(28))},
        .text=(value_label), .font=Scale(24),
        .wrap=TextWrapNone, .align=TextAlignCenter
    })

    for int i = 0; i < 11; i++ {
        col := i % 3
        row := i / 3
        key_x := x + col * (key_w + gap)
        key_y := y + pad + header_h + row * (key_h + gap)

        if Button((ButtonProps){
            .bounds = {(float)(key_x), (float)(key_y), (float)(key_w), (float)(key_h)},
            .label = (labels[i]),
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = 0
        }) {
            if i == 9 {
                habit_session_delete_before_cursor(app)
            } else {
                habit_session_insert_char(app, labels[i][0])
            }
        }
    }

    action_y := y + pad + header_h + key_h * 4 + gap * 4
    action_w := (w - gap) / 2
    if Button((ButtonProps){
        .bounds={(float)x, (float)action_y, (float)action_w, (float)action_h},
        .label=GetLocaleText("cancel_button"),
        .tone=ButtonToneNeutral, .emphasis=ButtonEmphasisSoft
    }) {
        habit_session_cancel_edit(app)
        return 1
    }
    if Button((ButtonProps){
        .bounds={(float)(x + action_w + gap), (float)action_y,
                 (float)action_w, (float)action_h},
        .label=GetLocaleText("save_button")
    }) {
        if habit_session_commit_edit(app, entry) {
            return 1
        }
    }

    return 0
}

clamp_cursor :: (app: InnerBreeze*) {
    len := 0

    if app == nil {
        return
    }
    len = (int)strlen(app->habit_session_edit.text)
    if app->habit_session_edit.cursor < 0 {
        app->habit_session_edit.cursor = 0
    }
    if app->habit_session_edit.cursor > len {
        app->habit_session_edit.cursor = len
    }
}

delete_before_cursor :: (app: InnerBreeze*) {
    len: size_t = 0
    cursor := 0

    if app == nil {
        return
    }
    habit_session_clamp_cursor(app)
    len = strlen(app->habit_session_edit.text)
    cursor = app->habit_session_edit.cursor
    if cursor <= 0 || len == 0 {
        return
    }
    memmove(app->habit_session_edit.text + cursor - 1,
               app->habit_session_edit.text + cursor,
               len - (size_t)cursor + 1)
    app->habit_session_edit.cursor--
}

insert_char :: (app: InnerBreeze*, c: char) {
    len: size_t = 0
    cursor := 0

    if app == nil {
        return
    }
    habit_session_clamp_cursor(app)
    len = strlen(app->habit_session_edit.text)
    cursor = app->habit_session_edit.cursor

    if len < 3 {
        memmove(app->habit_session_edit.text + cursor + 1,
                   app->habit_session_edit.text + cursor,
                   len - (size_t)cursor + 1)
        app->habit_session_edit.text[cursor] = c
        app->habit_session_edit.cursor = cursor + 1
        return
    }

    if cursor < (int)len {
        app->habit_session_edit.text[cursor] = c
        app->habit_session_edit.cursor = cursor + 1
    }
}

parse_seconds :: (text_value: const char*, seconds: int*) -> int {
    value := 0
    tail: char

    if text_value == nil || sscanf(text_value, "%d%c", &value, &tail) != 1 {
        return 0
    }
    if value <= 0 || value > 999 {
        return 0
    }
    if seconds != nil {
        *seconds = value
    }
    return 1
}

commit_edit :: (app: InnerBreeze*, entry: const HabitLinkedEntry*) -> int {
    if app == nil || entry == nil || !app->habit_session_edit.active {
        return 0
    }

    if app->habit_session_edit.kind == HABIT_SESSION_EDIT_ROUND {
        seconds := 0
        rounds: [MaxRounds] int

        if app->habit_session_edit.round < 0 ||
           app->habit_session_edit.round >= entry->round_count {
            return 0
        }
        if !habit_session_parse_seconds(app->habit_session_edit.text, &seconds) {
            return 0
        }
        for int i = 0; i < entry->round_count; i++ {
            rounds[i] = entry->rounds[i]
        }
        rounds[app->habit_session_edit.round] = seconds
        if !data_replace_session(entry->path, rounds, entry->round_count) {
            return 0
        }
        habit_session_changed(app, -1)
        habit_session_cancel_edit(app)
        return 1
    }

    return 0
}

route habit_session_edit {
    title "Edit Habit Session"
    group "Habits"
    page habit_session_edit
}

habit_session_edit :: (app: InnerBreeze*) #ui {
    Screen root: {
    habit_session_draw_edit_screen(app)
    }
}
