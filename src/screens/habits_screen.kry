WEB :: #defined(PLATFORM_WEB)

#if WEB {
    #import <emscripten.h>
    web_context_click_in_bounds :: (x0: int, y0: int, x1: int, y1: int) -> int #intrinsic "web"
}

#enum {
    HABITS_GUIDE_STEPS = 6
    HABITS_TOP_H = 36
    HABITS_OVERVIEW_MIN_DAY_COLUMNS = 2
    HABITS_OVERVIEW_DETAIL_COLUMNS = 1
}

static habits_top_options: [INBE_HABIT_MAX + 2] const char* = {0}
static habits_top_dropdown_selected: int = 0

HabitsScrollPageContext :: struct {
    view_mode: int
    weekly_days: int
    month_h: int
    grid_gap: int
}

habit_web_context_click_in_bounds :: (app: InbeApp*, bounds: Rectangle) -> int #private {
    #if WEB {
        top_left: Vector2
        bottom_right: Vector2

        if app == nil {
            return 0
        }
        top_left = GetWorldToScreen2D((Vector2){bounds.x, bounds.y}, app->camera)
        bottom_right = GetWorldToScreen2D((Vector2){
            bounds.x + bounds.width,
            bounds.y + bounds.height
        }, app->camera)
        return web_context_click_in_bounds((int)top_left.x,
                                           (int)top_left.y,
                                           (int)bottom_right.x,
                                           (int)bottom_right.y)
    } #else {
        unused app
        unused bounds
        return 0
    }
}

habit_counter_day_action :: (app: InbeApp*, habit_index: int, day_index: int,
                                x: int, y: int, w: int, h: int,
                                disabled: int, allow_left_increment: int) -> int {
    mouse := GetScreenToWorld2D(GetMousePosition(), app->camera)
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    inside: int = !disabled && CheckCollisionPointRec(mouse, bounds)
    same := app->habit_counter_press_index == habit_index &&
            app->habit_counter_press_day == day_index
    captured := UIInputCapturesClick(mouse)

    if disabled || captured {
        return 0
    }
    if (inside && IsMouseButtonReleased(MOUSE_BUTTON_RIGHT)) ||
       habit_web_context_click_in_bounds(app, bounds) {
        return -1
    }

    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) && inside {
        app->habit_counter_press_index = habit_index
        app->habit_counter_press_day = day_index
        app->habit_counter_press_frames = 0
        app->habit_counter_press_long_done = 0
        app->habit_counter_press_start_x = (int)mouse.x
        app->habit_counter_press_start_y = (int)mouse.y
        same = 1
    }

    if same && IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        dx := (int)mouse.x - app->habit_counter_press_start_x
        dy := (int)mouse.y - app->habit_counter_press_start_y
        threshold := ScaleUIPx(8)

        if dx > threshold || dx < -threshold ||
           dy > threshold || dy < -threshold {
            app->habit_counter_press_day = 0
            app->habit_counter_press_index = -1
            return 0
        }
        app->habit_counter_press_frames++
        if inside && !app->habit_counter_press_long_done &&
           app->habit_counter_press_frames >= HABIT_COUNTER_LONG_PRESS_FRAMES {
            app->habit_counter_press_long_done = 1
            return -1
        }
    }

    if same && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        action: int
        if inside && app->habit_counter_press_long_done {
            action = -2
        } else {
            action = inside && allow_left_increment ? 1 : 0
        }
        app->habit_counter_press_day = 0
        app->habit_counter_press_index = -1
        app->habit_counter_press_frames = 0
        app->habit_counter_press_long_done = 0
        return action
    }

    return 0
}

habit_weekly_visible_days :: (habits: InbeHabits*) -> int {
    if habits == nil {
        return HABIT_WEEKLY_INITIAL_DAYS
    }
    if habits->weekly_days < HABIT_WEEKLY_INITIAL_DAYS {
        habits->weekly_days = HABIT_WEEKLY_INITIAL_DAYS
    }
    if habits->weekly_days > HABIT_WEEKLY_MAX_DAYS {
        habits->weekly_days = HABIT_WEEKLY_MAX_DAYS
    }
    return habits->weekly_days
}

habits_screen_selector_height :: (app: InbeApp*) -> int {
    unused app
    return ScaleUIPx(HABITS_TOP_H)
}

habits_screen_top_reserved :: (app: InbeApp*) -> int {
    if app != nil && app->habits.screen_mode == HABITS_SCREEN_DETAIL {
        return habits_screen_selector_height(app) +
               UIGetNodeHeight(UINodeTabBar((TabBarProps){
                   .bounds = (Rectangle){0, 0, 0, 0}
               }))
    }
    return habits_screen_selector_height(app)
}

habits_select_detail_tab :: (app: InbeApp*, tab: int) #private {
    route: AppRoute

    if app == nil {
        return
    }

    tab = clampi(tab, HABIT_TAB_WEEKLY, HABIT_TAB_COUNT - 1)
    if app->habit_edit.active && tab != HABIT_TAB_EDIT {
        habit_edit_commit(app)
    }

    route = app_current_route(app)
    route.screen = InbeScreenHabits
    route.habits_screen_mode = HABITS_SCREEN_DETAIL
    route.habits_tab = tab
    app->habits.scroll = 0

    if tab == HABIT_TAB_WEEKLY {
        app->habits.view_mode = HABIT_VIEW_WEEKLY
        if app->habits.weekly_days < HABIT_WEEKLY_INITIAL_DAYS {
            app->habits.weekly_days = HABIT_WEEKLY_INITIAL_DAYS
        }
    } else if tab == HABIT_TAB_MONTHLY {
        app->habits.view_mode = HABIT_VIEW_CALENDAR
    } else if tab == HABIT_TAB_EDIT {
        if app->habits.count > 0 {
            habit_edit_begin(app, app->habits.selected)
        } else {
            habit_edit_begin_new(app)
        }
    }

    app_switch_route(app, route)
    save_settings(app)
}

habits_select_habit :: (app: InbeApp*, selected_habit: int) #private {
    was_edit_tab: int

    if app == nil ||
       selected_habit < 0 ||
       selected_habit >= app->habits.count {
        return
    }

    was_edit_tab = app->habits.tab == HABIT_TAB_EDIT
    if was_edit_tab && app->habit_edit.active {
        habit_edit_commit(app)
    }
    app->habits.selected = selected_habit
    app->habits.scroll = 0
    app->habits.weekly_days = HABIT_WEEKLY_INITIAL_DAYS
    if was_edit_tab {
        habit_edit_begin(app, app->habits.selected)
    }
    save_settings(app)
}

habits_enter_detail :: (app: InbeApp*, selected_habit: int) {
    route: AppRoute

    if app == nil {
        return
    }
    if selected_habit >= 0 && selected_habit < app->habits.count {
        habits_select_habit(app, selected_habit)
    }

    route = app_current_route(app)
    route.habits_screen_mode = HABITS_SCREEN_DETAIL
    app->habits.scroll = 0
    app_switch_route(app, route)
    save_settings(app)
}

habits_return_to_overview :: (app: InbeApp*) #private {
    route: AppRoute

    if app == nil {
        return
    }
    if app->habit_edit.active {
        habit_edit_commit(app)
    }

    route = app_current_route(app)
    route.habits_screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.scroll = 0
    app_switch_route(app, route)
    save_settings(app)
}

habits_enter_reorder :: (app: InbeApp*) {
    route: AppRoute

    if app == nil {
        return
    }
    if app->habit_edit.active {
        habit_edit_commit(app)
    }

    route = app_current_route(app)
    route.habits_screen_mode = HABITS_SCREEN_REORDER
    app->habits.scroll = 0
    app_switch_route(app, route)
}

habits_begin_new_detail :: (app: InbeApp*) {
    route: AppRoute

    if app == nil {
        return
    }

    habit_edit_begin_new(app)
    route = app_current_route(app)
    route.habits_screen_mode = HABITS_SCREEN_DETAIL
    route.habits_tab = HABIT_TAB_EDIT
    app_switch_route(app, route)
    save_settings(app)
}

draw_habits_top_bar :: (app: InbeApp*, draw_menu: int) {
    tabs: [HABIT_TAB_COUNT] Tab
    actions: [1] TopNavAction
    nav_result: TopNavResult
    option_count: int
    habit_offset: int = 0
    draft_new: int
    selected: int
    top_h: int = ScaleUIPx(HABITS_TOP_H)
    clicked_tab: int

    if app == nil {
        return
    }

    draft_new = app->habit_edit.active && app->habit_edit.is_new
    option_count = 0
    if draft_new {
        habits_top_options[option_count++] = ""
        habit_offset = 1
    }
    for int i = 0; i < app->habits.count && i < INBE_HABIT_MAX; i++ {
        habits_top_options[option_count++] = app->habits.items[i].name
    }

    selected = draft_new ? 0 : app->habits.selected + habit_offset
    if !draft_new &&
       (app->habits.selected < 0 ||
        app->habits.selected >= app->habits.count) {
        selected = 0
    }

    if app->habits.screen_mode == HABITS_SCREEN_REORDER {
        if draw_menu {
            return
        }
        if app_draw_close_title_bar(app, GetLocaleText("habit_reorder_title"),
                                    top_h) {
            habits_return_to_overview(app)
        }
        return
    }

    if app->habits.screen_mode != HABITS_SCREEN_DETAIL {
        if draw_menu {
            return
        }
        TopNav((TopNavProps){
            .id = 300,
            .width = view_width,
            .height = top_h,
            .title = GetLocaleText("tab_habits")
        })
        return
    }

    if !draw_menu {
        dropdown_h: int = ScaleUIPx(32)

        habits_top_dropdown_selected = selected
        actions[0] = (TopNavAction){
            .icon = app->icons[UI_ICON_TYPE_X],
            .disabled = app->modal.active
        }
        nav_result = TopNav((TopNavProps){
            .id = 301,
            .width = view_width,
            .height = top_h,
            .options = habits_top_options,
            .option_count = option_count,
            .selected_index = &habits_top_dropdown_selected,
            .disabled = app->modal.active,
            .dropdown_min_width = ScaleUIPx(120),
            .dropdown_height = dropdown_h,
            .actions = actions,
            .action_count = 1
        })
        if nav_result.clicked_action == 0 {
            habits_return_to_overview(app)
        }
        selected_habit: int = habits_top_dropdown_selected - habit_offset
        if !(draft_new && habits_top_dropdown_selected == 0) &&
           selected_habit >= 0 &&
           selected_habit < app->habits.count &&
           app->habits.selected != selected_habit {
            habits_select_habit(app, selected_habit)
        }

        tabs[HABIT_TAB_WEEKLY] = (Tab){
            .icon = app->icons[UI_ICON_TYPE_WEEKLY],
            .icon_size = ScaleUIPx(20),
            .disabled = app->modal.active || app->habits.count <= 0
        }
        tabs[HABIT_TAB_MONTHLY] = (Tab){
            .icon = app->icons[UI_ICON_TYPE_CALENDAR],
            .icon_size = ScaleUIPx(20),
            .disabled = app->modal.active || app->habits.count <= 0
        }
        tabs[HABIT_TAB_STATISTICS] = (Tab){
            .icon = app->icons[UI_ICON_TYPE_STAT],
            .icon_size = ScaleUIPx(20),
            .disabled = app->modal.active || app->habits.count <= 0
        }
        tabs[HABIT_TAB_EDIT] = (Tab){
            .icon = app->icons[UI_ICON_TYPE_EDIT],
            .icon_size = ScaleUIPx(20),
            .disabled = app->modal.active
        }
        clicked_tab = TabBar((TabBarProps){
            .bounds = (Rectangle){
                0,
                (float)habits_screen_selector_height(app),
                (float)view_width,
                (float)UIGetNodeHeight(UINodeTabBar((TabBarProps){
                    .bounds = (Rectangle){0, 0, 0, 0}
                }))
            },
            .tabs = tabs,
            .count = HABIT_TAB_COUNT,
            .selected_index = app->habits.tab,
            .min_tab_width = ScaleUIPx(64),
            .max_tab_width = ScaleUIPx(96),
            .scroll_offset = &app->habits.tab_scroll,
            .focus_selected = app->habits.focus_selected_tab
        })
        if clicked_tab >= 0 &&
           clicked_tab < HABIT_TAB_COUNT &&
           clicked_tab != app->habits.tab {
            habits_select_detail_tab(app, clicked_tab)
        }
        return
    }

    return
}

habits_overview_day_columns :: (content_w: int) -> int {
    max_label_w: int = ScaleUIPx(136)
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    gap: int = ScaleUIPx(material ? 6 : 4)
    preferred_cell: int = ScaleUIPx(material ? 30 : 28)
    columns: int

    if content_w <= 0 {
        return HABITS_OVERVIEW_MIN_DAY_COLUMNS
    }

    columns = (content_w - max_label_w + gap) / (preferred_cell + gap) -
        HABITS_OVERVIEW_DETAIL_COLUMNS
    if columns < HABITS_OVERVIEW_MIN_DAY_COLUMNS {
        columns = HABITS_OVERVIEW_MIN_DAY_COLUMNS
    }
    return columns
}

habits_overview_total_columns :: (content_w: int) -> int #private {
    return habits_overview_day_columns(content_w) +
        HABITS_OVERVIEW_DETAIL_COLUMNS
}

habits_overview_label_width :: (content_w: int) -> int {
    min_label_w: int = ScaleUIPx(56)
    max_label_w: int = ScaleUIPx(136)
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    gap: int = ScaleUIPx(material ? 6 : 4)
    cell: int = ScaleUIPx(material ? 30 : 28)
    columns: int = habits_overview_total_columns(content_w)
    label_w: int = content_w - gap * columns - cell * columns

    if label_w < min_label_w {
        label_w = min_label_w
    }
    if label_w > max_label_w {
        label_w = max_label_w
    }
    return label_w
}

habits_overview_cell_size :: (content_w: int) -> int {
    label_w: int = habits_overview_label_width(content_w)
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    gap: int = ScaleUIPx(material ? 6 : 4)
    columns: int = habits_overview_total_columns(content_w)
    cell: int = (content_w - label_w - gap * columns) / columns

    if cell > ScaleUIPx(material ? 30 : 28) {
        cell = ScaleUIPx(material ? 30 : 28)
    }
    if cell < ScaleUIPx(18) {
        cell = ScaleUIPx(18)
    }
    return cell
}

habits_button_label_fits :: (label: const char*, button_w: int) -> int #private {
    pad: int = ScaleUIPx(20)

    return TextWidth(label != nil ? label : "", GetUISmallFontSize()) +
        pad <= button_w
}

habits_overview_actions_stack :: (content_w: int) -> int {
    btn_gap: int = ScaleUIPx(8)
    half_w: int = (content_w - btn_gap) / 2

    return !habits_button_label_fits(GetLocaleText("habit_new_button"),
                                     half_w) ||
        !habits_button_label_fits(GetLocaleText("habit_reorder_title"),
                                  half_w)
}

habits_overview_day_index :: (days_ago: int) -> int {
    now: time_t = time(nil)
    day: struct tm
    local: struct tm* = localtime(&now)

    if local == nil {
        return habits_today_index()
    }

    day = *local
    day.tm_hour = 12
    day.tm_min = 0
    day.tm_sec = 0
    day.tm_mday -= days_ago
    if mktime(&day) == (time_t)-1 {
        return habits_today_index()
    }
    return (day.tm_year + 1900) * 10000 + (day.tm_mon + 1) * 100 +
        day.tm_mday
}

habits_overview_date_label :: (day_index: int, out: char*,
                                  out_size: size_t) {
    month: int
    day: int

    if out == nil || out_size == 0 {
        return
    }

    month = (day_index / 100) % 100
    day = day_index % 100
    snprintf(out, out_size, "%d/%d", month, day)
}

habits_overview_content_height :: (content_w: int,
                                      user_data: void*) -> int {
    app: InbeApp* = user_data
    rows: int = app != nil && app->habits.count > 0 ? app->habits.count : 1
    cell: int = habits_overview_cell_size(content_w)
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    row_gap: int = ScaleUIPx(material ? 10 : 8)
    action_h: int = ScaleUIPx(34)

    if habits_overview_actions_stack(content_w) {
        action_h = action_h * 2 + ScaleUIPx(8)
    }

    return ScaleUIPx(52) + ScaleUIPx(20) +
        rows * (cell + row_gap) +
        ScaleUIPx(24) + action_h
}

habits_reorder_content_height :: (content_w: int,
                                     user_data: void*) -> int {
    app: InbeApp* = user_data
    count: int = app != nil ? app->habits.count : 0

    unused content_w
    return ScaleUIPx(70) + ScaleUIPx(48) * (count > 0 ? count : 1)
}

habits_screen_dismiss_first_run_guide :: (app: InbeApp*) {
    if app == nil {
        return
    }

    app->habits_guide_seen = 1
    app->habits_guide_step = 0
    save_settings(app)
    sync_web_storage_critical()
}

habits_screen_first_run_guide_active :: (app: const InbeApp*) -> int {
    account: KsyncAccount

    return app != nil &&
        !app->habits_guide_seen &&
        !app->modal.active &&
        app->inbe.screen == InbeScreenHabits &&
        !sync_account_load(&account)
}

habits_screen_prepare_first_run_guide :: (app: InbeApp*) {
    step: int
    meditation_index: int = 0

    if !habits_screen_first_run_guide_active(app) {
        return
    }

    step = clampi(app->habits_guide_step, 0, HABITS_GUIDE_STEPS - 1)
    app->habits_guide_step = step

    if app->habit_edit.active {
        habit_edit_cancel(app)
    }
    for int i = 0; i < app->habits.count; i++ {
        if strcmp(app->habits.items[i].id, "meditation") == 0 {
            meditation_index = i
            break
        }
    }

    if step <= 1 {
        app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
        app->habits.scroll = 0
    } else if step == 2 {
        app->habits.screen_mode = HABITS_SCREEN_DETAIL
        if app->habits.count > 0 {
            app->habits.selected =
                clampi(meditation_index, 0, app->habits.count - 1)
        }
        app->habits.tab = HABIT_TAB_WEEKLY
        app->habits.view_mode = HABIT_VIEW_WEEKLY
        app->habits.scroll = 0
    } else if step == 3 || step == 5 {
        app->habits.screen_mode = HABITS_SCREEN_DETAIL
        if app->habits.count > 0 {
            app->habits.selected =
                clampi(meditation_index, 0, app->habits.count - 1)
        }
        app->habits.tab = HABIT_TAB_STATISTICS
        app->habits.scroll = 0
    } else if step == 4 {
        app->habits.screen_mode = HABITS_SCREEN_DETAIL
        if app->habits.count > 0 {
            app->habits.selected =
                clampi(meditation_index, 0, app->habits.count - 1)
        }
        app->habits.tab = HABIT_TAB_EDIT
        app->habits.scroll = 0
    }
}

habits_screen_tab_anchor :: (app: InbeApp*, first_tab: int,
                            tab_count: int) -> Rectangle #private {
    bar_x: int = 0
    bar_y: int = habits_screen_selector_height(app)
    bar_w: int = view_width
    tab_h: int = UIGetNodeHeight(UINodeTabBar((TabBarProps){
        .bounds = (Rectangle){0, 0, 0, 0}
    }))
    tab_w: int = bar_w / HABIT_TAB_COUNT
    x: int
    w: int = tab_count * tab_w

    if first_tab < 0 {
        first_tab = 0
    }
    if tab_count < 1 {
        tab_count = 1
    }
    if first_tab >= HABIT_TAB_COUNT {
        first_tab = HABIT_TAB_COUNT - 1
    }
    if first_tab + tab_count > HABIT_TAB_COUNT {
        tab_count = HABIT_TAB_COUNT - first_tab
    }

    x = bar_x + first_tab * tab_w
    if first_tab + tab_count >= HABIT_TAB_COUNT {
        w = bar_x + bar_w - x
    }
    if w < 1 {
        w = 1
    }

    return (Rectangle){(float)x, (float)bar_y, (float)w, (float)tab_h}
}

habits_overview_scroll_metrics :: (app: InbeApp*, content_x: int*,
                                  content_y: int*, content_w: int*) #private {
    content_top: int = habits_screen_top_reserved(app)
    content_bottom: int = app_content_bottom_reserved(app)
    max_content_w: int = ScaleUIPx(CONTENT_MAX_W)
    side_padding: int = GetUIPageSidePadding()
    base_x: int = 0
    base_w: int = 0
    draw_w: int
    area_h: int = view_height - content_top - content_bottom - ScaleUIPx(4)
    area: UIScrollArea
    measured: UIScrollView

    if max_content_w > view_width - side_padding * 2 {
        max_content_w = view_width - side_padding * 2
    }
    if max_content_w < 0 {
        max_content_w = 0
    }
    if area_h < 0 {
        area_h = 0
    }

    GetUICenteredColumn(max_content_w, side_padding, &base_x, &base_w)
    draw_w = base_w
    area = (UIScrollArea){
        .bounds = {
            0.0f,
            (float)(content_top + ScaleUIPx(4)),
            (float)view_width,
            (float)area_h
        },
        .content_x = base_x,
        .content_width = base_w,
        .scroll_offset = app != nil ? &app->habits.scroll : nil,
        .wheel_step = ScaleUIPx(42),
        .scrollbar_x = view_width - ScaleUIPx(8)
    }

    for int i = 0; i < 3; i++ {
        area.content_height = habits_overview_content_height(draw_w, app)
        measured = MeasureUIScrollContainer(area)
        if measured.content_w == draw_w {
            break
        }
        draw_w = measured.content_w
    }
    area.content_height = habits_overview_content_height(draw_w, app)
    measured = MeasureUIScrollContainer(area)

    if content_x != nil {
        *content_x = measured.content_x
    }
    if content_y != nil {
        *content_y = measured.content_y
    }
    if content_w != nil {
        *content_w = measured.content_w
    }
}

habits_overview_progress_anchor :: (app: InbeApp*) -> Rectangle #private {
    content_x: int
    content_y: int
    y: int
    pad: int = ScaleUIPx(5)
    font: int = GetUIFontSize()
    done_count: int = habits_overview_done_today(app)
    progress: [64] char = {0}
    text_w: int
    text_h: int = ScaleUIPx(22)

    habits_overview_scroll_metrics(app, &content_x, &content_y, nil)
    y = content_y + ScaleUIPx(12)
    snprintf(progress, sizeof(progress),
                GetLocaleText("habits_done_count_label"),
                done_count, app != nil ? app->habits.count : 0)
    text_w = TextWidth(progress, font)
    if text_h < font {
        text_h = font
    }
    return (Rectangle){(float)(content_x - pad), (float)(y - pad),
                       (float)(text_w + pad * 2),
                       (float)(text_h + pad * 2)}
}

habits_overview_grid_anchor :: (app: InbeApp*) -> Rectangle #private {
    content_x: int
    content_w: int
    content_y: int
    label_w: int
    cell: int
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    cell_gap: int = ScaleUIPx(material ? 6 : 4)
    row_gap: int = ScaleUIPx(material ? 10 : 8)
    grid_total_w: int
    total_columns: int
    rows: int = app != nil && app->habits.count > 0 ? app->habits.count : 1
    y: int

    habits_overview_scroll_metrics(app, &content_x, &content_y, &content_w)
    y = content_y + ScaleUIPx(12) + ScaleUIPx(28)
    label_w = habits_overview_label_width(content_w)
    cell = habits_overview_cell_size(content_w)
    total_columns = habits_overview_total_columns(content_w)
    grid_total_w = label_w + cell_gap * total_columns + cell * total_columns

    return (Rectangle){
        (float)(content_x + (content_w - grid_total_w) / 2 - ScaleUIPx(4)),
        (float)(y - ScaleUIPx(4)),
        (float)(grid_total_w + ScaleUIPx(8)),
        (float)(ScaleUIPx(20) + rows * (cell + row_gap))
    }
}

habits_draw_divider :: (x: int, w: int, y: int) #private {
    DrawLine(x, y, x + w, y, DarkenUIColor(GetThemeBackground(), 28))
}

habits_draw_fitted_text :: (text: const char*, x: int, y: int,
                           max_w: int, font: int, color: Color) #private {
    fitted: [INBE_HABIT_NAME_SIZE + 4] char = {0}

    if text == nil || max_w <= 0 {
        return
    }
    inbe_text_fit_ellipsis(text, fitted, sizeof(fitted), max_w, font)
    Text(fitted, x, y, font, color)
}

draw_habits_reorder :: (app: InbeApp*, content_top: int) {
    content_bottom: int = 0
    max_w: int = ScaleUIPx(CONTENT_MAX_W)
    page: UIScrollPage
    x: int
    w: int
    y: int
    font: int = GetUIFontSize()
    small: int = GetUISmallFontSize()
    row_h: int = ScaleUIPx(48)
    handle_w: int = ScaleUIPx(34)
    reorder_items: [INBE_HABIT_MAX] UIReorderItem
    reorder: UIReorderListResult
    row_y: [INBE_HABIT_MAX] int
    count: int

    if app == nil {
        return
    }

    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = content_top + ScaleUIPx(4),
        .height = view_height - content_top - content_bottom - ScaleUIPx(4),
        .max_content_width = max_w,
        .scroll_offset = &app->habits.scroll,
        .content_height = habits_reorder_content_height,
        .user_data = app
    })
    x = page.content_x
    w = page.content_w
    y = page.content_y + ScaleUIPx(16)
    count = app->habits.count

    if app->habits.count <= 0 {
        Text(GetLocaleText("habit_empty_title"), x, y, small,
                      DarkenUIColor(GetThemeText(), 35))
        EndUIScrollPage(page)
        return
    }

    if count > INBE_HABIT_MAX {
        count = INBE_HABIT_MAX
    }
    for int i = 0; i < count; i++ {
        row_y[i] = y + i * row_h
        reorder_items[i] = (UIReorderItem){
            .id = i + 1,
            .bounds = {
                (float)x,
                (float)row_y[i],
                (float)w,
                (float)row_h
            },
            .disabled = 0
        }
    }

    reorder = UpdateUIReorderList((UIReorderList){
        .id = 801,
        .bounds = {(float)x, (float)y, (float)w, (float)(row_h * count)},
        .items = reorder_items,
        .item_count = count,
        .handle_width = handle_w,
        .scroll_offset = &app->habits.scroll,
        .max_scroll = page.view.max_scroll,
        .viewport_top = (int)page.area.bounds.y,
        .viewport_bottom = (int)(page.area.bounds.y + page.area.bounds.height)
    })
    if reorder.committed &&
       habits_move(&app->habits, reorder.from_index, reorder.to_index) {
        save_settings(app)
        app_auto_sync(app)
        EndUIScrollPage(page)
        return
    }

    for int i = 0; i < count; i++ {
        if reorder.dragging && i == reorder.active_index {
            continue
        }
        ReorderHandle(0, x, row_y[i], handle_w, row_h,
                               reorder.active && i == reorder.active_index)
        habits_draw_fitted_text(app->habits.items[i].name,
                                   x + handle_w,
                                   row_y[i] + ScaleUIPx(13),
                                   w - handle_w,
                                   font,
                                   GetThemeText())
        habits_draw_divider(x, w, row_y[i] + row_h - ScaleUIPx(4))
    }

    if reorder.dragging &&
       reorder.target_index >= 0 &&
       reorder.target_index < count {
        ReorderPlaceholder(reorder_items[reorder.target_index].bounds)
    }
    if reorder.dragging &&
       reorder.active_index >= 0 &&
       reorder.active_index < count {
        i: int = reorder.active_index
        overlay_y: int = row_y[i] + reorder.drag_delta_y

        DrawRectangle(x, overlay_y, w, row_h,
                         LightenUIColor(GetThemeBackground(), 8))
        ReorderHandle(0, x, overlay_y, handle_w, row_h, 1)
        habits_draw_fitted_text(app->habits.items[i].name,
                                   x + handle_w,
                                   overlay_y + ScaleUIPx(13),
                                   w - handle_w,
                                   font,
                                   GetThemeText())
    }

    EndUIScrollPage(page)
}

habits_overview_session_count :: (habit: InbeHabit*, day_index: int) -> int #private {
    if habit == nil {
        return 0
    }
    for int i = 0; i < habit->day_count; i++ {
        if habit->days[i].day_index == day_index {
            return habit->days[i].session_count
        }
    }
    return 0
}

habits_overview_done_today :: (app: InbeApp*) -> int #private {
    today: int = habits_today_index()
    done: int = 0

    if app == nil {
        return 0
    }
    for int i = 0; i < app->habits.count; i++ {
        habit: InbeHabit* = &app->habits.items[i]
        ctx: HabitLinkedContext
        linked_ctx: HabitLinkedContext* = nil
        completed: int

        if !habit_scheduled_day(habit, today) {
            continue
        }
        if habit_is_linked(habit) {
            memset(&ctx, 0, sizeof(ctx))
            habit_collect_linked_entries(habit, today, &ctx)
            linked_ctx = &ctx
        }
        completed = habit_completed_day(habit, today)
        if !completed &&
           linked_ctx != nil &&
           habit_linked_has_day(linked_ctx, today) {
            completed = 1
        }
        if !completed &&
           habit_counting_enabled(habit) &&
           habit_effective_day_count(habit, today, linked_ctx) > 0 {
            completed = 1
        }
        if completed {
            done++
        }
    }
    return done
}

habits_overview_test_click_point :: (app: InbeApp*, out_x: int*,
                                    out_y: int*) -> int {
    content_x: int
    content_w: int
    content_y: int
    label_w: int
    cell: int
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    cell_gap: int = ScaleUIPx(material ? 6 : 4)
    grid_total_w: int
    overview_x: int
    grid_x: int
    grid_y: int
    day_columns: int
    total_columns: int

    if app == nil || out_x == nil || out_y == nil ||
       app->inbe.screen != InbeScreenHabits ||
       app->habits.screen_mode != HABITS_SCREEN_OVERVIEW ||
       app->habits.count <= 0 {
        return 0
    }

    habits_overview_scroll_metrics(app, &content_x, &content_y, &content_w)
    label_w = habits_overview_label_width(content_w)
    cell = habits_overview_cell_size(content_w)
    day_columns = habits_overview_day_columns(content_w)
    if day_columns <= 0 || cell <= 0 {
        return 0
    }
    total_columns = day_columns + HABITS_OVERVIEW_DETAIL_COLUMNS
    grid_total_w = label_w + cell_gap * total_columns + cell * total_columns
    overview_x = content_x + (content_w - grid_total_w) / 2
    grid_x = overview_x + label_w
    grid_y = content_y + ScaleUIPx(12) + ScaleUIPx(28) + ScaleUIPx(20)

    *out_x = grid_x + cell / 2
    *out_y = grid_y + cell / 2
    return 1
}

habits_overview_cell_clicked :: (app: InbeApp*, x: int, y: int,
                                w: int, h: int, disabled: int) -> int #private {
    mouse: Vector2
    inside: int

    if app == nil {
        return 0
    }

    mouse = GetScreenToWorld2D(GetMousePosition(), app->camera)
    inside = CheckCollisionPointRec(
        mouse,
        (Rectangle){(float)x, (float)y, (float)w, (float)h}
    ) && !UIInputCapturesClick(mouse)
    if !inside {
        return 0
    }
    if disabled {
        MarkUIDisabled()
        return 0
    }
    MarkUIClickable()
    return IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
}

draw_habits_overview :: (app: InbeApp*, content_top: int) {
    content_bottom: int
    max_w: int = ScaleUIPx(CONTENT_MAX_W)
    content_x: int
    content_w: int
    y: int
    font: int = GetUIFontSize()
    small: int = GetUISmallFontSize()
    btn_h: int = ScaleUIPx(34)
    btn_gap: int = ScaleUIPx(8)
    half_w: int
    add_hover: int = 0
    reorder_hover: int = 0
    done_count: int
    progress: [64] char = {0}
    label_w: int
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    cell_gap: int = ScaleUIPx(material ? 6 : 4)
    row_gap: int = ScaleUIPx(material ? 10 : 8)
    cell: int
    grid_total_w: int
    overview_x: int
    grid_x: int
    grid_y: int
    today_index: int = habits_today_index()
    day_columns: int
    total_columns: int
    page: UIScrollPage

    if app == nil {
        return
    }

    content_bottom = app_content_bottom_reserved(app)
    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = content_top + ScaleUIPx(4),
        .height = view_height - content_top - content_bottom - ScaleUIPx(4),
        .max_content_width = max_w,
        .scroll_offset = &app->habits.scroll,
        .content_height = habits_overview_content_height,
        .user_data = app
    })
    content_x = page.content_x
    content_w = page.content_w
    y = page.content_y + ScaleUIPx(12)

    done_count = habits_overview_done_today(app)
    snprintf(progress, sizeof(progress),
                GetLocaleText("habits_done_count_label"),
                done_count, app->habits.count)
    Text(progress, content_x, y, font, GetThemeText())
    y += ScaleUIPx(28)

    if app->habits.count <= 0 {
        Text(GetLocaleText("habit_empty_title"), content_x, y, font,
                      DarkenUIColor(GetThemeText(), 35))
        y += ScaleUIPx(36)
        if StyledButton(content_x, y, content_w, btn_h,
                               GetLocaleText("habit_new_button"),
                               ButtonStyleSecondary,
                               app->habits.count >= INBE_HABIT_MAX,
                               &add_hover) {
            habits_begin_new_detail(app)
        }
        EndUIScrollPage(page)
        return
    }

    label_w = habits_overview_label_width(content_w)
    cell = habits_overview_cell_size(content_w)
    day_columns = habits_overview_day_columns(content_w)
    total_columns = day_columns + HABITS_OVERVIEW_DETAIL_COLUMNS
    grid_total_w = label_w + cell_gap * total_columns + cell * total_columns
    overview_x = content_x + (content_w - grid_total_w) / 2
    grid_x = overview_x + label_w
    grid_y = y

    for int day = 0; day < day_columns; day++ {
        day_index: int = habits_overview_day_index(day)
        day_x: int = grid_x + day * (cell + cell_gap)
        date_label: [16] char = {0}
        text_w: int

        habits_overview_date_label(day_index, date_label,
                                      sizeof(date_label))
        text_w = TextWidth(date_label, small)
        if text_w > cell {
            snprintf(date_label, sizeof(date_label), "%d", day_index % 100)
            text_w = TextWidth(date_label, small)
        }
        Text(date_label, day_x + (cell - text_w) / 2,
                      grid_y, small, DarkenUIColor(GetThemeText(), 34))
    }
    y += ScaleUIPx(20)

    for int i = 0; i < app->habits.count; i++ {
        habit: InbeHabit* = &app->habits.items[i]
        row_y: int = y
        swatch: int = ScaleUIPx(8)
        label_text_w: int = label_w - swatch - ScaleUIPx(8)
        label: const char* = habit->name
        short_name: [8] char
        fitted_label: [INBE_HABIT_NAME_SIZE + 4] char
        mouse: Vector2 = GetScreenToWorld2D(GetMousePosition(), app->camera)
        row_bounds: Rectangle = {
            (float)(overview_x - ScaleUIPx(4)),
            (float)(row_y - ScaleUIPx(3)),
            (float)(grid_total_w + ScaleUIPx(8)),
            (float)(cell + ScaleUIPx(6))
        }
        label_bounds: Rectangle = {
            (float)overview_x,
            (float)row_y,
            (float)label_w,
            (float)cell
        }
        row_hover: int = CheckCollisionPointRec(mouse, row_bounds) &&
            !UIInputCapturesClick(mouse)
        label_hover: int = CheckCollisionPointRec(mouse, label_bounds) &&
            !UIInputCapturesClick(mouse)

        if label_w <= ScaleUIPx(62) {
            inbe_text_short_label(habit->name, 3, 1,
                                     short_name, sizeof(short_name))
            label = short_name
        } else if TextWidth(label, small) > label_text_w {
            inbe_text_fit_ellipsis(habit->name, fitted_label,
                                      sizeof(fitted_label),
                                      label_text_w, small)
            label = fitted_label
        }

        if row_hover {
            DrawRectangleRec(row_bounds, DarkenUIColor(GetThemeBackground(), 10))
        }
        DrawRectangle(overview_x, row_y + (cell - swatch) / 2,
                         swatch, swatch, habit->color)
        Text(label, overview_x + swatch + ScaleUIPx(5),
                      GetUIControlTextY(label, row_y, cell, small),
                      small, GetThemeText())
        if label_hover {
            MarkUIClickable()
            if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
                habits_enter_detail(app, i)
            }
        }

        for int day = 0; day < day_columns; day++ {
            day_index: int = habits_overview_day_index(day)
            day_x: int = grid_x + day * (cell + cell_gap)
            future_day: int = day_index > today_index
            off_schedule: int = !habit_scheduled_day(habit, day_index)
            session_count: int = habits_overview_session_count(habit, day_index)
            has_linked_day: int = session_count > 0
            counting_enabled: int = habit_counting_enabled(habit)
            minimum_count: int = session_count
            manual_count: int = habit_day_count(habit, day_index)
            count: int = counting_enabled
                ? (manual_count > session_count ? manual_count : session_count)
                : 0
            completed: int = habit_completed_day(habit, day_index)
            action: int = 0
            fill: Color
            border: Color = DarkenUIColor(GetThemeText(), 46)
            cell_bounds: Rectangle = {
                (float)day_x,
                (float)row_y,
                (float)cell,
                (float)cell
            }
            cell_active: int = CheckCollisionPointRec(mouse, cell_bounds) &&
                !UIInputCapturesClick(mouse)
            cell_hover: int = cell_active &&
                !future_day &&
                !off_schedule &&
                UIHoverEffectsEnabled()

            if !completed && !future_day && (has_linked_day || count > 0) {
                completed = 1
            }
            if off_schedule && !completed {
                # outside the habit's weekly schedule: visibly muted
                if material {
                    DrawRectangleRounded(cell_bounds, 0.42f, 8,
                                          Fade(GetThemeSurface(), 0.35f))
                } else {
                    DrawRectangle(day_x, row_y, cell, cell,
                                  Fade(DarkenUIColor(GetThemeBackground(), 7), 0.35f))
                }
                if day_index == today_index {
                    DrawRectangleLinesEx(cell_bounds, 1.0f,
                                         Fade(GetThemeText(), 0.30f))
                }
                continue
            }
            if material {
                fill = completed
                    ? habit->color
                    : GetThemeSurface()
                border = day_index == today_index
                    ? GetThemeButtonHover()
                    : Fade(GetThemeText(), 0.18f)
                if cell_hover {
                    fill = completed
                        ? LightenUIColor(fill, 18)
                        : Fade(GetThemeButtonHover(), 0.22f)
                }

                DrawRectangleRounded(cell_bounds, 0.42f, 8, fill)
                if day_index == today_index || cell_hover {
                    DrawRectangleRoundedLinesEx(cell_bounds, 0.42f, 8,
                                                  day_index == today_index ? 2.0f : 1.0f,
                                                  border)
                }
            } else {
                fill = completed
                    ? habit->color
                    : DarkenUIColor(GetThemeBackground(), 7)
                if day_index == today_index {
                    fill = completed
                        ? LightenUIColor(fill, 12)
                        : DarkenUIColor(GetThemeBackground(), 14)
                }
                if cell_hover {
                    fill = completed
                        ? LightenUIColor(fill, 22)
                        : GetThemeButtonHover()
                }

                DrawRectangle(day_x, row_y, cell, cell, fill)
                DrawRectangleLinesEx(cell_bounds, 1.0f, border)
                if day == 0 {
                    DrawRectangle(day_x, row_y, cell, ScaleUIPx(3),
                                     GetThemeText())
                }
            }

            if counting_enabled {
                action = habit_counter_day_action(app, i, day_index,
                                                  day_x, row_y, cell, cell,
                                                  future_day,
                                                  !has_linked_day)
                if action == 0 &&
                   has_linked_day &&
                   !future_day &&
                   habits_overview_cell_clicked(app, day_x, row_y,
                                                cell, cell, 0) {
                    habit_open_linked_edit_page(app, i, day_index)
                }
            } else if habits_overview_cell_clicked(app, day_x, row_y,
                                                   cell, cell, future_day) {
                if has_linked_day {
                    habit_open_linked_edit_page(app, i, day_index)
                } else {
                    habit_toggle_day(&app->habits, i, day_index)
                    app_auto_sync(app)
                }
            }
            if action == 1 || action == -1 {
                habit_apply_count_action(app, i, day_index,
                                            action, minimum_count)
                app_auto_sync(app)
            }
            if counting_enabled && count > 0 && !future_day {
                draw_habit_day_count_label(day_x, row_y,
                                              cell, cell, count)
            }
            if !future_day && has_linked_day {
                draw_habit_link_dot(day_x, row_y, cell, habit->color)
            }
        }

        detail_x: int = grid_x + day_columns * (cell + cell_gap)
        detail_bounds: Rectangle = {
            (float)detail_x,
            (float)row_y,
            (float)cell,
            (float)cell
        }
        detail_active: int = CheckCollisionPointRec(mouse, detail_bounds) &&
            !UIInputCapturesClick(mouse)
        detail_hover: int = detail_active && UIHoverEffectsEnabled()
        detail_fill: Color = material
            ? GetThemeSurface()
            : DarkenUIColor(GetThemeBackground(), 7)
        detail_border: Color = DarkenUIColor(GetThemeText(), 46)
        more: const char* = "..."
        more_w: int

        if detail_hover {
            detail_fill = DarkenUIColor(GetThemeButtonHover(), 8)
            detail_border = GetThemeText()
        }
        if detail_active {
            MarkUIClickable()
        }
        if material {
            detail_bounds = (Rectangle){
                (float)detail_x,
                (float)row_y,
                (float)cell,
                (float)cell
            }
            DrawRectangleRounded(detail_bounds, 0.42f, 8, detail_fill)
            if detail_hover {
                DrawRectangleRoundedLinesEx(detail_bounds, 0.42f, 8,
                                              1.0f, detail_border)
            }
        } else {
            DrawRectangle(detail_x, row_y, cell, cell, detail_fill)
            Bevel(detail_x, row_y, cell, cell,
                           LightenUIColor(detail_fill, detail_hover ? 34 : 24),
                           DarkenUIColor(detail_fill, detail_hover ? 38 : 28))
            DrawRectangleLines(detail_x, row_y, cell, cell, detail_border)
        }
        if detail_active && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
            habits_enter_detail(app, i)
            EndUIScrollPage(page)
            return
        }
        more_w = TextWidth(more, Text16)
        Text(more, detail_x + (cell - more_w) / 2,
                      GetUIControlTextY(more, row_y, cell, Text16),
                      Text16, GetThemeText())

        y += cell + row_gap
    }

    y += ScaleUIPx(10)
    if habits_overview_actions_stack(content_w) {
        if StyledButton(content_x, y, content_w, btn_h,
                               GetLocaleText("habit_new_button"),
                               ButtonStyleSecondary,
                               app->habits.count >= INBE_HABIT_MAX,
                               &add_hover) {
            habits_begin_new_detail(app)
        }
        y += btn_h + btn_gap
        if StyledButton(content_x, y, content_w, btn_h,
                               GetLocaleText("habit_reorder_title"),
                               ButtonStyleSecondary,
                               app->habits.count <= 0,
                               &reorder_hover) {
            habits_enter_reorder(app)
        }
    } else {
        half_w = (content_w - btn_gap) / 2
        if StyledButton(content_x, y, half_w, btn_h,
                               GetLocaleText("habit_new_button"),
                               ButtonStyleSecondary,
                               app->habits.count >= INBE_HABIT_MAX,
                               &add_hover) {
            habits_begin_new_detail(app)
        }
        if StyledButton(content_x + half_w + btn_gap,
                               y, half_w, btn_h,
                               GetLocaleText("habit_reorder_title"),
                               ButtonStyleSecondary,
                               app->habits.count <= 0,
                               &reorder_hover) {
            habits_enter_reorder(app)
        }
    }

    EndUIScrollPage(page)
}

habits_screen_draw_first_run_guide :: (app: InbeApp*) {
    steps: [HABITS_GUIDE_STEPS] UIGuideStep
    result: UIGuideResult

    if !habits_screen_first_run_guide_active(app) {
        return
    }

    steps[0] = (UIGuideStep){
        habits_overview_progress_anchor(app),
        GetLocaleText("habits_guide_overview_progress")
    }
    steps[1] = (UIGuideStep){
        habits_overview_grid_anchor(app),
        GetLocaleText("habits_guide_overview_grid")
    }
    steps[2] = (UIGuideStep){
        habits_screen_tab_anchor(app, HABIT_TAB_WEEKLY, 2),
        GetLocaleText("habits_guide_meditation_views")
    }
    steps[3] = (UIGuideStep){
        habits_screen_tab_anchor(app, HABIT_TAB_STATISTICS, 1),
        GetLocaleText("habits_guide_meditation_statistics")
    }
    steps[4] = (UIGuideStep){
        habits_screen_tab_anchor(app, HABIT_TAB_EDIT, 1),
        GetLocaleText("habits_guide_meditation_edit")
    }
    steps[5] = (UIGuideStep){
        habits_screen_tab_anchor(app, HABIT_TAB_STATISTICS, 1),
        GetLocaleText("habits_guide_meditation_session_data")
    }

    result = GuideOverlay((GuideOverlayProps){
        .steps = steps,
        .count = HABITS_GUIDE_STEPS,
        .step = &app->habits_guide_step,
        .view_width = view_width,
        .view_height = view_height,
        .reserved_top = habits_screen_top_reserved(app),
        .reserved_bottom = app_content_bottom_reserved(app),
        .max_width = ScaleUIPx(300),
        .paragraph_font = GetUISmallFontSize(),
        .close_icon = app->icons[UI_ICON_TYPE_X],
        .back_icon = app->icons[UI_ICON_TYPE_BACKWARD],
        .next_icon = app->icons[UI_ICON_TYPE_FORWARD],
        .done_icon = app->icons[UI_ICON_TYPE_CHECK]
    })
    if result.changed {
        save_settings(app)
        sync_web_storage_critical()
    }
    if result.closed || result.finished {
        habits_screen_dismiss_first_run_guide(app)
    }
}

habit_text_color_for_background :: (background: Color) -> Color #private {
    luma := background.r * 299 +
            background.g * 587 +
            background.b * 114

    return luma >= 128000 ? BLACK : WHITE
}

draw_habit_completion_underline :: (x: int, y: int, w: int, h: int,
                                       color: Color) {
    DrawRectangle(x + ScaleUIPx(4),
                     y + h - ScaleUIPx(6),
                     w - ScaleUIPx(8),
                     ScaleUIPx(3),
                     color)
}

draw_habit_link_dot :: (x: int, y: int, w: int, color: Color) {
    unused color

    DrawCircle(x + w - ScaleUIPx(8),
                  y + ScaleUIPx(8),
                  ScaleUIPx(5),
                  DarkenUIColor(GetThemeBackground(), 35))
    DrawCircle(x + w - ScaleUIPx(8),
                  y + ScaleUIPx(8),
                  ScaleUIPx(3),
                  GetThemeText())
}

draw_habit_day_count_label :: (x: int, y: int, w: int, h: int,
                                  count: int) {
    count_label: [16] char = {0}
    count_font: int = Text12
    count_w: int
    padding: int = ScaleUIPx(3)

    if count <= 0 {
        return
    }

    snprintf(count_label, sizeof(count_label), "%d", count)
    count_w = TextWidth(count_label, count_font)
    Text(count_label,
                  x + (w - count_w) / 2,
                  y + h - count_font - padding,
                  count_font,
                  GetThemeText())
}

habit_calendar_day_cell :: (app: InbeApp*, x: int, y: int, w: int, h: int,
                               label: const char*, completed: int,
                               disabled: int, current_day: int) -> int {
    mouse_world: Vector2
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    inside: int
    hovered: int
    fill: Color = completed
        ? GetThemeButton()
        : (material ? GetThemeSurface() : DarkenUIColor(GetThemeBackground(), 10))
    border: Color = current_day
        ? GetThemeButtonHover()
        : Fade(GetThemeText(), 0.18f)
    text_color: Color = disabled
        ? DarkenUIColor(GetThemeText(), 35)
        : GetThemeText()
    font: int = Text16
    text_w: int

    if app != nil {
        mouse_world = GetScreenToWorld2D(GetMousePosition(), app->camera)
    } else {
        mouse_world = GetMousePosition()
    }

    inside = !disabled &&
             CheckCollisionPointRec(mouse_world, bounds) &&
             !UIInputCapturesClick(mouse_world)
    hovered = inside && UIHoverEffectsEnabled()

    if material {
        if hovered {
            fill = completed
                ? LightenUIColor(fill, 18)
                : Fade(GetThemeButtonHover(), 0.22f)
        } else if current_day && completed {
            fill = LightenUIColor(fill, 10)
        }
    } else {
        if hovered {
            fill = GetThemeButtonHover()
        } else if current_day {
            fill = completed
                ? LightenUIColor(fill, 12)
                : DarkenUIColor(GetThemeBackground(), 14)
        }
    }
    if !disabled && completed {
        text_color = habit_text_color_for_background(fill)
    }

    if material {
        DrawRectangleRounded(bounds, 0.32f, 10, fill)
        if current_day || hovered {
            DrawRectangleRoundedLinesEx(bounds, 0.32f, 10,
                                          current_day ? 2.0f : 1.0f,
                                          border)
        }
    } else {
        DrawRectangle(x, y, w, h, fill)
        Bevel(x, y, w, h,
                       LightenUIColor(fill, hovered ? 36 : 28),
                       DarkenUIColor(fill, hovered ? 42 : 34))
    }

    text_w = TextWidth(label, font)
    Text(label,
                  x + (w - text_w) / 2,
                  GetUIControlTextY(label, y, h, font),
                  font,
                  text_color)

    if inside && app != nil {
        MarkUIClickable()
    }

    return inside && IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
}

habit_weekly_row_height :: () -> int #private {
    return ScaleUIPx(GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL ? 58 : 52)
}

habit_weekly_draw_text_line :: (text: const char*, x: int, y: int,
                               w: int, h: int, text_size: int,
                               color: Color) #private {
    font_size: int
    draw_text: const char* = text
    fitted: [128] char = {0}

    if text == nil || text[0] == '\0' || w <= 0 || h <= 0 {
        return
    }

    font_size = text_size
    while font_size > Text8 &&
          TextWidth(text, font_size) > w {
        font_size -= 1
    }

    if TextWidth(text, font_size) > w {
        inbe_text_fit_ellipsis(text, fitted, sizeof(fitted), w, font_size)
        draw_text = fitted
    }

    Text(draw_text,
                  x + (w - TextWidth(draw_text, font_size)) / 2,
                  TextBaselineY(draw_text, y, h, font_size),
                  font_size,
                  color)
}

habit_weekly_summary :: (ctx: const HabitLinkedContext*, day_index: int,
                        primary: char*, primary_size: size_t,
                        secondary: char*, secondary_size: size_t) -> int #private {
    count: int = 0
    first_activity: int = -1
    mixed: int = 0

    if primary != nil && primary_size > 0 {
        primary[0] = '\0'
    }
    if secondary != nil && secondary_size > 0 {
        secondary[0] = '\0'
    }
    if ctx == nil {
        return 0
    }

    for int i = 0; i < ctx->count; i++ {
        entry_day: int = ctx->entries[i].year * 10000 +
                         ctx->entries[i].month * 100 +
                         ctx->entries[i].day

        if entry_day != day_index {
            continue
        }
        if first_activity < 0 {
            first_activity = ctx->entries[i].activity
        } else if first_activity != ctx->entries[i].activity {
            mixed = 1
        }
        count++
    }

    if count <= 0 {
        return 0
    }

    if primary != nil && primary_size > 0 {
        snprintf(primary, primary_size, "%s",
                    mixed
                        ? GetLocaleText("habit_mixed_practice_label")
                        : practice_activity_label(first_activity))
    }
    if secondary != nil && secondary_size > 0 {
        FormatLocaleText(secondary, secondary_size,
                            count == 1
                                ? "session_count_singular"
                                : "session_count_plural",
                            count)
    }

    return count
}

habit_weekly_summary_button :: (app: InbeApp*, x: int, y: int,
                               w: int, h: int, completed: int,
                               disabled: int, primary: const char*,
                               secondary: const char*) -> int #private {
    mouse_world: Vector2
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    material: int = GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    active: int
    hovered: int
    fill: Color = completed
        ? GetThemeButton()
        : (material ? GetThemeSurface() : DarkenUIColor(GetThemeBackground(), 10))
    text_color: Color = disabled
        ? DarkenUIColor(GetThemeText(), 35)
        : GetThemeText()
    pad: int = ScaleUIPx(9)
    text_x: int
    text_w: int
    line1: const char* = primary != nil ? primary : ""
    line2: const char* = secondary != nil ? secondary : ""

    if app == nil {
        return 0
    }

    mouse_world = GetScreenToWorld2D(GetMousePosition(), app->camera)
    active = CheckCollisionPointRec(mouse_world, bounds) &&
             !UIInputCapturesClick(mouse_world)
    hovered = active && UIHoverEffectsEnabled()

    if active {
        if disabled {
            MarkUIDisabled()
        } else {
            MarkUIClickable()
        }
    }

    active = active && !disabled
    hovered = hovered && !disabled

    if hovered {
        fill = material && !completed
            ? Fade(GetThemeButtonHover(), 0.22f)
            : GetThemeButtonHover()
    }
    if !disabled && completed {
        text_color = habit_text_color_for_background(fill)
    }

    if material {
        DrawRectangleRounded(bounds, 0.18f, 10, fill)
        if hovered {
            DrawRectangleRoundedLinesEx(bounds, 0.18f, 10, 1.0f,
                                          Fade(GetThemeText(), 0.22f))
        }
    } else {
        DrawRectangle(x, y, w, h, fill)
        Bevel(x, y, w, h,
                       LightenUIColor(fill, 36),
                       DarkenUIColor(fill, 42))
    }

    text_x = x + pad
    text_w = w - pad * 2

    if line1[0] != '\0' {
        if line2[0] != '\0' {
            line1_h: int = ScaleUIPx(24)
            line2_h: int = ScaleUIPx(18)
            underline_space: int = completed ? ScaleUIPx(5) : 0
            block_h: int = line1_h + line2_h
            block_y: int = y + (h - block_h - underline_space) / 2

            habit_weekly_draw_text_line(line1, text_x, block_y,
                                           text_w, line1_h,
                                           Text16, text_color)
            habit_weekly_draw_text_line(line2, text_x,
                                           block_y + line1_h,
                                           text_w, line2_h,
                                           Text12,
                                           DarkenUIColor(text_color, 16))
        } else {
            habit_weekly_draw_text_line(line1, text_x,
                                           y + ScaleUIPx(3),
                                           text_w,
                                           h - ScaleUIPx(6),
                                           Text16, text_color)
        }
    }

    if active {
        return IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
    }
    return 0
}

habit_weekly_content_height :: (visible_days: int) -> int #private {
    row_h: int = habit_weekly_row_height()
    row_gap: int = ScaleUIPx(GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL ? 10 : 6)
    load_h: int = ScaleUIPx(38)

    if visible_days < HABIT_WEEKLY_INITIAL_DAYS {
        visible_days = HABIT_WEEKLY_INITIAL_DAYS
    }

    return ScaleUIPx(26) +
           row_h * visible_days +
           row_gap * (visible_days - 1) +
           ScaleUIPx(14) +
           load_h +
           ScaleUIPx(16)
}

draw_habits_weekly_view :: (app: InbeApp*, active: InbeHabit*,
                               selected: int,
                               linked_ctx: HabitLinkedContext*,
                               content_x: int, content_w: int,
                               y: int, visible_days: int) {
    now: time_t = time(nil)
    day_tm: struct tm
    today_index: int = habits_today_index()
    label_w: int = ScaleUIPx(88)
    gap: int = ScaleUIPx(8)
    button_x: int
    button_w: int
    row_h: int = habit_weekly_row_height()
    row_gap: int = ScaleUIPx(GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL ? 10 : 6)
    day_font: int = Text16
    date_font: int = Text12
    load_h: int = ScaleUIPx(38)
    load_hover: int = 0
    local: struct tm* = localtime(&now)

    if local != nil {
        day_tm = *local
    } else {
        memset(&day_tm, 0, sizeof(day_tm))
    }
    day_tm.tm_hour = 12
    day_tm.tm_min = 0
    day_tm.tm_sec = 0
    mktime(&day_tm)

    if label_w > content_w / 2 {
        label_w = content_w / 2
    }

    button_x = content_x + label_w + gap
    button_w = content_w - label_w - gap
    if button_w < ScaleUIPx(80) {
        button_w = content_w
        label_w = 0
        button_x = content_x
    }

    if visible_days < HABIT_WEEKLY_INITIAL_DAYS {
        visible_days = HABIT_WEEKLY_INITIAL_DAYS
    }
    if visible_days > HABIT_WEEKLY_MAX_DAYS {
        visible_days = HABIT_WEEKLY_MAX_DAYS
    }

    for int i = 0; i < visible_days; i++ {
        row_tm: struct tm = day_tm
        day_label: [16] char = {0}
        date_label: [32] char = {0}
        day_index: int
        completed: int
        has_linked_day: int
        future_day: int
        count: int = 0
        action: int = 0
        counting_enabled: int
        minimum_count: int
        primary: [64] char = ""
        secondary: [64] char = ""
        session_count: int

        row_tm.tm_mday -= i
        mktime(&row_tm)

        day_index = habit_tm_date_index(&row_tm)
        future_day = day_index > today_index
        has_linked_day = linked_ctx != nil &&
            habit_linked_has_day(linked_ctx, day_index)
        counting_enabled = habit_counting_enabled(active)
        minimum_count = habit_linked_session_count_for_day(linked_ctx,
                                                           day_index)
        session_count = habit_weekly_summary(linked_ctx, day_index,
                                             primary, sizeof(primary),
                                             secondary, sizeof(secondary))

        if counting_enabled {
            count = habit_effective_day_count(active, day_index, linked_ctx)
        }

        completed = habit_completed_day(active, day_index)
        if !completed && !future_day && (has_linked_day || count > 0) {
            completed = 1
        }

        if counting_enabled &&
           count > 0 &&
           session_count > 0 &&
           secondary[0] != '\0' {
            len: size_t = strlen(secondary)

            FormatLocaleText(secondary + len,
                                sizeof(secondary) - len,
                                "habit_day_total_count_suffix",
                                count)
        }

        if session_count <= 0 && completed {
            snprintf(primary, sizeof(primary), "%s",
                        GetLocaleText("habit_day_completed"))
            secondary[0] = '\0'
        }

        strftime(day_label, sizeof(day_label), "%a", &row_tm)
        for char* p = day_label; *p != '\0'; p++ {
            if *p >= 'a' && *p <= 'z' {
                *p = (char)(*p - 'a' + 'A')
            }
        }
        snprintf(date_label, sizeof(date_label), "%02d/%02d/%02d",
                    row_tm.tm_mday,
                    row_tm.tm_mon + 1,
                    (row_tm.tm_year + 1900) % 100)

        if label_w > 0 {
            if GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL {
                DrawRectangleRounded((Rectangle){
                    (float)content_x,
                    (float)y,
                    (float)label_w,
                    (float)row_h
                }, 0.18f, 10, GetThemeSurface())
            } else {
                DrawRectangle(content_x, y, label_w, row_h,
                                 DarkenUIColor(GetThemeBackground(), 5))
            }
            Text(day_label,
                          content_x + ScaleUIPx(8),
                          y + ScaleUIPx(7),
                          day_font,
                          GetThemeText())
            Text(date_label,
                          content_x + ScaleUIPx(8),
                          y + ScaleUIPx(33),
                          date_font,
                          DarkenUIColor(GetThemeText(), 18))
        }

        if counting_enabled {
            habit_weekly_summary_button(app, button_x, y,
                                           button_w, row_h,
                                           completed, future_day,
                                           primary, secondary)
            action = habit_counter_day_action(app, selected, day_index,
                                              button_x, y,
                                              button_w, row_h,
                                              future_day,
                                              !has_linked_day)
            if action == 0 && has_linked_day && !future_day {
                mouse_world: Vector2 =
                    GetScreenToWorld2D(GetMousePosition(), app->camera)
                bounds: Rectangle = {
                    (float)button_x,
                    (float)y,
                    (float)button_w,
                    (float)row_h
                }

                if CheckCollisionPointRec(mouse_world, bounds) &&
                   !UIInputCapturesClick(mouse_world) &&
                   IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
                    habit_open_linked_edit_page(app, selected, day_index)
                }
            }
        } else if habit_weekly_summary_button(app, button_x, y,
                                              button_w, row_h,
                                              completed, future_day,
                                              primary, secondary) {
            if has_linked_day {
                habit_open_linked_edit_page(app, selected, day_index)
            } else {
                habit_toggle_day(&app->habits, selected, day_index)
                active = &app->habits.items[selected]
                app_auto_sync(app)
            }
        }

        if action == 1 || action == -1 {
            habit_apply_count_action(app, selected, day_index,
                                        action, minimum_count)
            active = &app->habits.items[selected]
            count = habit_effective_day_count(active, day_index, linked_ctx)
            completed = count > 0
            app_auto_sync(app)
        }

        if completed && !future_day {
            draw_habit_completion_underline(button_x, y,
                                               button_w, row_h,
                                               active->color)
        }

        if counting_enabled &&
           count > 0 &&
           !future_day &&
           !has_linked_day {
            count_label: [16] char = {0}
            count_font: int = Text12
            count_w: int

            snprintf(count_label, sizeof(count_label), "%d", count)
            count_w = TextWidth(count_label, count_font)
            Text(count_label,
                          button_x + button_w - count_w - ScaleUIPx(6),
                          y + ScaleUIPx(5),
                          count_font,
                          GetThemeText())
        }

        if !future_day && has_linked_day {
            draw_habit_link_dot(button_x, y, button_w, active->color)
        }

        y += row_h + row_gap
    }

    y += ScaleUIPx(8)
    if StyledButton(content_x, y, content_w, load_h,
                           GetLocaleText("habit_load_more_button"),
                           ButtonStyleSecondary,
                           app->habits.weekly_days >= HABIT_WEEKLY_MAX_DAYS,
                           &load_hover) {
        app->habits.weekly_days += HABIT_WEEKLY_LOAD_DAYS
        if app->habits.weekly_days > HABIT_WEEKLY_MAX_DAYS {
            app->habits.weekly_days = HABIT_WEEKLY_MAX_DAYS
        }
    }
}

habits_scroll_page_content_height :: (content_w: int,
                                         user_data: void*) -> int {
    ctx: HabitsScrollPageContext* = user_data

    if ctx->view_mode == HABIT_VIEW_WEEKLY {
        return habit_weekly_content_height(ctx->weekly_days)
    }

    planned_cell_w := (content_w - ctx->grid_gap * 6) / 7
    if planned_cell_w < ScaleUIPx(28) {
        planned_cell_w = ScaleUIPx(28)
    }

    return ScaleUIPx(8) +
           ctx->month_h +
           ScaleUIPx(12) +
           planned_cell_w * 6 +
           ctx->grid_gap * 5 +
           ScaleUIPx(16)
}

draw_habits_screen :: (app: InbeApp*) {
    content_top: int
    content_bottom: int
    content_x: int
    content_w: int
    y: int
    viewport_h: int
    hover: int = 0
    side_padding: int = GetUIPageSidePadding()
    max_w: int = ScaleUIPx(CONTENT_MAX_W)
    month_h: int = ScaleUIPx(42)
    grid_gap: int = ScaleUIPx(4)
    selected: int
    active: InbeHabit* = nil
    now: time_t
    month_local: struct tm* = nil
    month: struct tm
    next_month: struct tm
    month_label: [64] char = {0}
    year: int
    mon: int
    first_wday: int
    days_in_month: int
    today_index: int = habits_today_index()
    cell_w: int
    cell_h: int
    grid_x: int
    grid_y: int
    linked_ctx: HabitLinkedContext* = nil
    active_is_linked: int
    forward_disabled: int
    scroll_y: int
    scroll_h: int
    cell_bounds: Rectangle
    cell_clicked: int
    page_ctx: HabitsScrollPageContext
    page: UIScrollPage
    weekly_days: int = HABIT_WEEKLY_INITIAL_DAYS

    if app == nil {
        return
    }

    if app->habits.tab < HABIT_TAB_WEEKLY ||
       app->habits.tab >= HABIT_TAB_COUNT {
        app->habits.tab = app->habits.view_mode == HABIT_VIEW_WEEKLY
            ? HABIT_TAB_WEEKLY
            : HABIT_TAB_MONTHLY
    }
    if app->habits.tab == HABIT_TAB_WEEKLY {
        app->habits.view_mode = HABIT_VIEW_WEEKLY
    } else if app->habits.tab == HABIT_TAB_MONTHLY {
        app->habits.view_mode = HABIT_VIEW_CALENDAR
    }

    content_top = habits_screen_top_reserved(app)
    content_bottom = app_content_bottom_reserved(app)
    y = content_top + ScaleUIPx(8)
    viewport_h = view_height - content_top - content_bottom

    GetUICenteredColumn(max_w, side_padding, &content_x, &content_w)

    if app->habits.screen_mode == HABITS_SCREEN_REORDER {
        draw_habits_reorder(app, content_top)
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    if app->habits.screen_mode != HABITS_SCREEN_DETAIL {
        draw_habits_overview(app, content_top)
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    if app->habits.count <= 0 {
        empty_text: const char* = GetLocaleText("habit_empty_title")
        create_text: const char* = GetLocaleText("habit_create_button")
        empty_font: int = Text16
        button_w: int = content_w < ScaleUIPx(240) ? content_w : ScaleUIPx(240)
        button_h: int = ScaleUIPx(42)
        empty_y: int = content_top + viewport_h / 2 - ScaleUIPx(46)
        empty_w: int = TextWidth(empty_text, empty_font)
        hover_empty_create: int = 0

        BeginUIClip((int)app->camera.offset.x,
                       (int)(app->camera.offset.y +
                             content_top * app->camera.zoom),
                       (int)(view_width * app->camera.zoom),
                       (int)(viewport_h * app->camera.zoom))
        Text(empty_text, content_x + (content_w - empty_w) / 2,
                      empty_y, empty_font, GetThemeText())
        if StyledButton(content_x + (content_w - button_w) / 2,
                               empty_y + ScaleUIPx(38),
                               button_w, button_h, create_text,
                               ButtonStylePrimary, 0,
                               &hover_empty_create) {
            habits_begin_new_detail(app)
        }
        EndUIClip()
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    if app->habits.selected < 0 ||
       app->habits.selected >= app->habits.count {
        app->habits.selected = 0
    }

    selected = app->habits.selected
    active = &app->habits.items[selected]
    active_is_linked = habit_is_linked(active)
    if app->habits.view_mode != HABIT_VIEW_WEEKLY {
        app->habits.view_mode = HABIT_VIEW_CALENDAR
    }
    weekly_days = habit_weekly_visible_days(&app->habits)

    if app->habits.tab == HABIT_TAB_STATISTICS {
        draw_statistics_content(app, content_top)
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    if app->habits.tab == HABIT_TAB_EDIT {
        if !app->habit_edit.active ||
           (!app->habit_edit.is_new &&
            app->habit_edit.index != app->habits.selected) {
            habit_edit_begin(app, app->habits.selected)
        }
        habit_edit_draw(app)
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    if app->habits.month_offset > 0 {
        app->habits.month_offset = 0
    }

    now = time(nil)
    month_local = localtime(&now)
    if month_local != nil {
        month = *month_local
    } else {
        memset(&month, 0, sizeof(month))
    }
    month.tm_mday = 1
    month.tm_hour = 12
    month.tm_min = 0
    month.tm_sec = 0
    month.tm_mon += app->habits.month_offset
    mktime(&month)

    year = month.tm_year + 1900
    mon = month.tm_mon + 1
    first_wday = month.tm_wday
    next_month = month
    next_month.tm_mon++
    next_month.tm_mday = 0
    mktime(&next_month)
    days_in_month = next_month.tm_mday
    strftime(month_label, sizeof(month_label), "%B %Y", &month)

    if active_is_linked {
        linked_ctx = calloc(1, sizeof(*linked_ctx))
        if linked_ctx != nil {
            habit_collect_linked_entries(active, 0, linked_ctx)
        }
    }

    scroll_y = content_top + ScaleUIPx(4)
    scroll_h = viewport_h - ScaleUIPx(4)
    if scroll_h < 0 {
        scroll_h = 0
    }

    page_ctx = (HabitsScrollPageContext){
        app->habits.view_mode,
        weekly_days,
        month_h,
        grid_gap
    }
    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = scroll_y,
        .height = scroll_h,
        .max_content_width = max_w,
        .scroll_offset = &app->habits.scroll,
        .content_height = habits_scroll_page_content_height,
        .user_data = &page_ctx
    })

    content_x = page.content_x
    content_w = page.content_w
    y = page.content_y + ScaleUIPx(8)

    if app->habits.view_mode == HABIT_VIEW_WEEKLY {
        draw_habits_weekly_view(app, active, selected, linked_ctx,
                                   content_x, content_w, y, weekly_days)
        EndUIScrollPage(page)
        free(linked_ctx)
        draw_habits_top_bar(app, 0)
        if app->inbe.screen == InbeScreenHabits {
            draw_habits_top_bar(app, 1)
        }
        return
    }

    forward_disabled = app->habits.month_offset >= 0
    if StyledButton(content_x, y, ScaleUIPx(44), month_h, "<",
                           ButtonStyleSecondary, 0, &hover) {
        app->habits.month_offset--
    }
    if StyledButton(content_x + content_w - ScaleUIPx(44), y,
                           ScaleUIPx(44), month_h, ">",
                           ButtonStyleSecondary,
                           forward_disabled, &hover) {
        app->habits.month_offset++
    }
    Text(month_label,
                  content_x +
                      (content_w -
                       TextWidth(month_label, Text24)) / 2,
                  GetUIControlTextY(month_label, y, month_h, Text24),
                  Text24, GetThemeText())

    grid_x = content_x
    grid_y = y + month_h + ScaleUIPx(12)
    cell_w = (content_w - grid_gap * 6) / 7
    cell_h = cell_w
    if cell_h < ScaleUIPx(28) {
        cell_h = ScaleUIPx(28)
    }

    for int row = 0; row < 6; row++ {
        for int col = 0; col < 7; col++ {
                slot: int = row * 7 + col
                day: int = slot - first_wday + 1
                cell_x: int = grid_x + col * (cell_w + grid_gap)
                cell_y: int = grid_y + row * (cell_h + grid_gap)
                day_label: [16] char = {0}
                day_index: int
                completed: int
                future_day: int
                has_linked_day: int
                count: int = 0
                action: int = 0
                counting_enabled: int
                minimum_count: int

                if day < 1 || day > days_in_month {
                    DrawRectangle(cell_x, cell_y, cell_w, cell_h,
                                     DarkenUIColor(GetThemeBackground(), 5))
                    continue
                }

                snprintf(day_label, sizeof(day_label), "%d", day)
                day_index = year * 10000 + mon * 100 + day
                future_day = day_index > today_index
                has_linked_day = linked_ctx != nil &&
                    habit_linked_has_day(linked_ctx, day_index)
                counting_enabled = habit_counting_enabled(active)
                minimum_count =
                    habit_linked_session_count_for_day(linked_ctx, day_index)
                if counting_enabled {
                    count = habit_effective_day_count(active, day_index,
                                                      linked_ctx)
                }
                completed = habit_completed_day(active, day_index)
                if !completed && !future_day && (has_linked_day || count > 0) {
                    completed = 1
                }

                if counting_enabled {
                    habit_calendar_day_cell(app, cell_x, cell_y,
                                               cell_w, cell_h, day_label,
                                               completed, future_day,
                                               day_index == today_index)
                    action = habit_counter_day_action(app, selected, day_index,
                                                      cell_x, cell_y,
                                                      cell_w, cell_h,
                                                      future_day,
                                                      !has_linked_day)
                    if action == 0 && has_linked_day && !future_day {
                        mouse_world: Vector2 =
                            GetScreenToWorld2D(GetMousePosition(), app->camera)

                        cell_bounds = (Rectangle){
                            (float)cell_x,
                            (float)cell_y,
                            (float)cell_w,
                            (float)cell_h
                        }
                        cell_clicked =
                            CheckCollisionPointRec(mouse_world, cell_bounds) &&
                            !UIInputCapturesClick(mouse_world) &&
                            IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
                        if cell_clicked {
                            habit_open_linked_edit_page(app, selected,
                                                           day_index)
                        }
                    }
                } else if habit_calendar_day_cell(app, cell_x, cell_y,
                                                  cell_w, cell_h, day_label,
                                                  completed, future_day,
                                                  day_index == today_index) {
                    if has_linked_day {
                        habit_open_linked_edit_page(app, selected, day_index)
                    } else {
                        habit_toggle_day(&app->habits, selected, day_index)
                        active = &app->habits.items[selected]
                        app_auto_sync(app)
                    }
                }

                if action == 1 || action == -1 {
                    habit_apply_count_action(app, selected, day_index,
                                                action, minimum_count)
                    active = &app->habits.items[selected]
                    count = habit_effective_day_count(active, day_index,
                                                      linked_ctx)
                    completed = count > 0
                    app_auto_sync(app)
                }
                if completed && !future_day {
                    draw_habit_completion_underline(cell_x, cell_y,
                                                       cell_w, cell_h,
                                                       active->color)
                }
                if counting_enabled && count > 0 && !future_day {
                    draw_habit_day_count_label(cell_x, cell_y,
                                                  cell_w, cell_h, count)
                }
                if !future_day && has_linked_day {
                    draw_habit_link_dot(cell_x, cell_y, cell_w,
                                           active->color)
                }
        }
    }

    EndUIScrollPage(page)

    free(linked_ctx)
    draw_habits_top_bar(app, 0)
    if app->inbe.screen == InbeScreenHabits {
        draw_habits_top_bar(app, 1)
    }
}

route habits {
    title "Habits"
    group "Habits"
    page habits
}

habits :: (app: InbeApp*) #ui {
    Screen root: {
    draw_habits_screen(app)
    }
}
