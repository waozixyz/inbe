#enum {
    HABITS_GUIDE_STEPS = 6
    HABITS_TOP_H = 36
}

HabitsScrollPageContext :: struct {
    view_mode: int
    weekly_days: int
    month_h: int
    grid_gap: int
}

habit_web_context_click_in_bounds :: (app: InnerBreeze*, bounds: Rectangle) -> int #private {
    #if WEB {
        top_left: Vector2
        bottom_right: Vector2

        if app == nil {
            return 0
        }
        top_left = GetWorldToScreen2D((Vector2){bounds.x, bounds.y}, app->camera)
        bottom_right = GetWorldToScreen2D((Vector2){
            bounds.x + bounds.width,
            bounds.y + bounds.height
        }, app->camera)
        return web_context_click_in_bounds((int)top_left.x,
                                           (int)top_left.y,
                                           (int)bottom_right.x,
                                           (int)bottom_right.y)
    } #else {
        unused app
        unused bounds
        return 0
    }
}

habit_counter_day_action :: (app: InnerBreeze*, habit_index: int, day_index: int,
                                x: int, y: int, w: int, h: int,
                                disabled: int, allow_left_increment: int) -> int {
    mouse := GetScreenToWorld2D(GetMousePosition(), app->camera)
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    inside: int = !disabled && CheckCollisionPointRec(mouse, bounds)
    same := app->habit_counter_press_index == habit_index &&
            app->habit_counter_press_day == day_index
    captured := InputCapturesClick(mouse)

    if disabled || captured {
        return 0
    }
    if (inside && IsMouseButtonReleased(MOUSE_BUTTON_RIGHT)) ||
       habit_web_context_click_in_bounds(app, bounds) {
        return -1
    }

    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) && inside {
        app->habit_counter_press_index = habit_index
        app->habit_counter_press_day = day_index
        app->habit_counter_press_frames = 0
        app->habit_counter_press_long_done = 0
        app->habit_counter_press_start_x = (int)mouse.x
        app->habit_counter_press_start_y = (int)mouse.y
        same = 1
    }

    if same && IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        dx := (int)mouse.x - app->habit_counter_press_start_x
        dy := (int)mouse.y - app->habit_counter_press_start_y
        threshold := Scale(8)

        if dx > threshold || dx < -threshold ||
           dy > threshold || dy < -threshold {
            app->habit_counter_press_day = 0
            app->habit_counter_press_index = -1
            return 0
        }
        app->habit_counter_press_frames++
        if inside && !app->habit_counter_press_long_done &&
           app->habit_counter_press_frames >= HABIT_COUNTER_LONG_PRESS_FRAMES {
            app->habit_counter_press_long_done = 1
            return -1
        }
    }

    if same && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        action: int
        if inside && app->habit_counter_press_long_done {
            action = -2
        } else {
            action = inside && allow_left_increment ? 1 : 0
        }
        app->habit_counter_press_day = 0
        app->habit_counter_press_index = -1
        app->habit_counter_press_frames = 0
        app->habit_counter_press_long_done = 0
        return action
    }

    return 0
}

habit_weekly_visible_days :: (habits: Habits*) -> int {
    if habits == nil {
        return HABIT_WEEKLY_INITIAL_DAYS
    }
    if habits->weekly_days < HABIT_WEEKLY_INITIAL_DAYS {
        habits->weekly_days = HABIT_WEEKLY_INITIAL_DAYS
    }
    if habits->weekly_days > HABIT_WEEKLY_MAX_DAYS {
        habits->weekly_days = HABIT_WEEKLY_MAX_DAYS
    }
    return habits->weekly_days
}

habits_screen_selector_height :: (app: InnerBreeze*) -> int {
    unused app
    return 0
}

habits_screen_top_reserved :: (app: InnerBreeze*) -> int {
    unused app
    return 0
}

habits_expand_card :: (app: InnerBreeze*, index: int) #private {
    if app == nil || index < 0 || index >= app->habits.count {
        return
    }
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = index
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    app->habits.scroll = 0
    app->habits.weekly_days = HABIT_WEEKLY_INITIAL_DAYS
    save_settings(app)
}

habits_return_to_focus :: (app: InnerBreeze*) #private {
    route: AppRoute

    if app == nil {
        return
    }
    route = app_current_route(app)
    route.screen = ScreenHabits
    route.habits_screen_mode = HABITS_SCREEN_OVERVIEW
    route.habits_tab = HABIT_TAB_WEEKLY
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = -1
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    app->habits.scroll = 0
    app_switch_route(app, route)
    save_settings(app)
}

habits_open_history :: (app: InnerBreeze*) #private {
    route: AppRoute

    if app == nil || app->habits.count <= 0 ||
       app->habits.selected < 0 ||
       app->habits.selected >= app->habits.count {
        return
    }
    route = app_current_route(app)
    route.screen = ScreenHabits
    route.habits_screen_mode = HABITS_SCREEN_HISTORY
    route.habits_tab = app->habits.view_mode == HABIT_VIEW_CALENDAR
        ? HABIT_TAB_MONTHLY : HABIT_TAB_WEEKLY
    app->habits.screen_mode = HABITS_SCREEN_HISTORY
    app->habits.scroll = 0
    app_switch_route(app, route)
    save_settings(app)
}

habits_open_statistics :: (app: InnerBreeze*) #private {
    route: AppRoute

    if app == nil || app->habits.count <= 0 ||
       app->habits.selected < 0 ||
       app->habits.selected >= app->habits.count {
        return
    }
    route = app_current_route(app)
    route.screen = ScreenHabits
    route.habits_screen_mode = HABITS_SCREEN_STATISTICS
    route.habits_tab = HABIT_TAB_STATISTICS
    app->habits.screen_mode = HABITS_SCREEN_STATISTICS
    app->habits.tab = HABIT_TAB_STATISTICS
    app->habits.scroll = 0
    app_switch_route(app, route)
    save_settings(app)
}

habits_return_to_overview :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    if app->habit_edit.active {
        habit_edit_cancel(app)
    }
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = -1
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    save_settings(app)
}

habits_begin_new_detail :: (app: InnerBreeze*) {
    if app == nil {
        return
    }
    habit_edit_begin_new(app)
}

habits_card_description :: (description: const char*, out: char*, out_size: size_t) {
    line: [HABIT_DESCRIPTION_SIZE + 4] char = {0}
    snprintf(line, sizeof(line), "%s", description != nil ? description : "")
    for int i = 0; line[i] != '\0'; i++ {
        if line[i] == '\n' || line[i] == '\r' || line[i] == '\t' {
            line[i] = ' '
        }
    }
    snprintf(out, out_size, "%s", line)
}

habits_day_index :: (days_ago: int) -> int {
    now: time_t = time(nil)
    day: struct tm
    local: struct tm* = localtime(&now)

    if local == nil {
        return habits_today_index()
    }

    day = *local
    day.tm_hour = 12
    day.tm_min = 0
    day.tm_sec = 0
    day.tm_mday -= days_ago
    if mktime(&day) == (time_t)-1 {
        return habits_today_index()
    }
    return (day.tm_year + 1900) * 10000 + (day.tm_mon + 1) * 100 +
        day.tm_mday
}

habits_screen_dismiss_first_run_guide :: (app: InnerBreeze*) {
    if app == nil {
        return
    }
    app->habits_guide_seen = 1
    app->habits_guide_step = 0
    save_settings(app)
    sync_web_storage_critical()
}

habits_screen_first_run_guide_active :: (app: const InnerBreeze*) -> int {
    return app != nil &&
        !app->habits_guide_seen &&
    app->habits.count > 0 &&
        !app->modal.active &&
        app->breathing.screen == ScreenHabits &&
        !storage_has_sync_account()
}

habits_screen_prepare_first_run_guide :: (app: InnerBreeze*) {
    step: int

    if !habits_screen_first_run_guide_active(app) {
        return
    }

    step = clampi(app->habits_guide_step, 0, HABITS_GUIDE_STEPS - 1)
    app->habits_guide_step = step

    if app->habit_edit.active {
        habit_edit_cancel(app)
    }
    app->habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app->habits.selected = step >= 2 && app->habits.count > 0 ? 0 : -1
    app->habits.tab = HABIT_TAB_WEEKLY
    app->habits.view_mode = HABIT_VIEW_WEEKLY
    app->habits.scroll = 0
}

habits_draw_fitted_text :: (text: const char*, x: int, y: int,
                           max_w: int, preferred: int, minimum: int,
                           color: Color) #private {
    font: int

    if text == nil || max_w <= 0 {
        return
    }
    font = AppFitFontSize(text, max_w, preferred, minimum)
    Text((TextProps){
        .bounds={(x), (y), (max_w), 0},
        .font = font,
        .text = text,
        .wrap=TextWrapNone
    })
}


habits_done_today :: (app: InnerBreeze*) -> int #private {
    today: int = habits_today_index()
    done: int = 0

    if app == nil {
        return 0
    }
    for int i = 0; i < app->habits.count; i++ {
        habit: Habit* = &app->habits.items[i]
        ctx: HabitLinkedContext
        linked_ctx: HabitLinkedContext* = nil
        completed: int

        if !habit_scheduled_day(habit, today) {
            continue
        }
        if habit_is_linked(habit) {
            memset(&ctx, 0, sizeof(ctx))
            habit_collect_linked_entries(habit, today, &ctx)
            linked_ctx = &ctx
        }
        completed = habit_completed_day(habit, today)
        if !completed &&
           !habit_counting_enabled(habit) &&
           linked_ctx != nil &&
           habit_linked_has_day(linked_ctx, today) {
            completed = 1
        }
        if !completed &&
           habit_counting_enabled(habit) &&
           habit_effective_day_count(habit, today, linked_ctx) >=
               habit_counter_target(habit) {
            completed = 1
        }
        if completed {
            done++
        }
    }
    return done
}


habits_due_today :: (app: InnerBreeze*) -> int #private {
    due: int = 0
    for int i = 0; i < app->habits.count; i++ {
        if habit_scheduled_day(&app->habits.items[i], habits_today_index()) {
            due++
        }
    }
    return due
}


habits_screen_draw_first_run_guide :: (app: InnerBreeze*) {
    steps: [HABITS_GUIDE_STEPS] UIGuideStep
    result: UIGuideResult

    if !habits_screen_first_run_guide_active(app) {
        return
    }

    steps[0] = (UIGuideStep){
        app->habits_guide_anchors[0],
        GetLocaleText("habits_guide_overview_progress")
    }
    steps[1] = (UIGuideStep){
        app->habits_guide_anchors[1],
        GetLocaleText("habits_guide_overview_grid")
    }
    steps[2] = (UIGuideStep){
        app->habits_guide_anchors[2],
        GetLocaleText("habits_guide_meditation_views")
    }
    steps[3] = (UIGuideStep){
        app->habits_guide_anchors[3],
        GetLocaleText("habits_guide_meditation_statistics")
    }
    steps[4] = (UIGuideStep){
        app->habits_guide_anchors[4],
        GetLocaleText("habits_guide_meditation_edit")
    }
    steps[5] = (UIGuideStep){
        app->habits_guide_anchors[5],
        GetLocaleText("habits_guide_meditation_session_data")
    }

    result = AppGuideOverlay((GuideOverlayProps){
        .steps = steps,
        .count = HABITS_GUIDE_STEPS,
        .step = &app->habits_guide_step,
        .view_width = view_width,
        .view_height = view_height,
        .reserved_top = habits_screen_top_reserved(app),
        .reserved_bottom = app_content_bottom_reserved(app),
        .max_width = Scale(300),
        .paragraph_font = AppSmallFontSize(),
        .close_icon_type = ICON_X,
        .back_icon_type = ICON_BACKWARD,
        .next_icon_type = ICON_FORWARD,
        .done_icon_type = ICON_CHECK
    })
    if result.changed {
        save_settings(app)
        sync_web_storage_critical()
    }
    if result.closed || result.finished {
        habits_screen_dismiss_first_run_guide(app)
    }
}

habit_text_color_for_background :: (background: Color) -> Color #private {
    luma := background.r * 299 +
            background.g * 587 +
            background.b * 114

    return luma >= 128000 ? BLACK : WHITE
}

habits_draw_day_marker :: (cx: int, cy: int, radius: int,
                           complete: int, counting: int, count: int,
                           session_count: int,
                           hovered: int, surface: Color,
                           foreground: Color, accent: Color) #private {
    ring := Fade(foreground, 0.54f)
    ring_hover := Fade(accent, 0.24f)
    fill := surface
    text := habit_text_color_for_background(accent)

    if hovered {
        Circle(cx, cy, radius + Scale(5), ring_hover)
    }
    Circle(cx, cy + Scale(1), radius + Scale(2), Fade(BLACK, 0.16f))
    if complete {
        Circle(cx, cy, radius + Scale(1), LightenColor(accent, 16))
        Circle(cx, cy, radius, accent)
    } else {
        Circle(cx, cy, radius + Scale(1), ring)
        Circle(cx, cy, radius - Scale(2), fill)
        Circle(cx - Scale(2), cy - Scale(3),
               (radius / 3 > Scale(2) ? radius / 3 : Scale(2)),
               Fade(WHITE, 0.16f))
    }
    if complete && !counting && session_count > 0 {
        # Session derived progress has a waveform; a manual check keeps its tick.
        DrawLineEx((Vector2){(float)(cx - radius * 2 / 3), (float)cy},
                   (Vector2){(float)(cx - radius / 3), (float)cy},
                   (float)Scale(2), text)
        DrawLineEx((Vector2){(float)(cx - radius / 3), (float)cy},
                   (Vector2){(float)(cx - radius / 6), (float)(cy - radius / 3)},
                   (float)Scale(2), text)
        DrawLineEx((Vector2){(float)(cx - radius / 6), (float)(cy - radius / 3)},
                   (Vector2){(float)(cx + radius / 8), (float)(cy + radius / 3)},
                   (float)Scale(2), text)
        DrawLineEx((Vector2){(float)(cx + radius / 8), (float)(cy + radius / 3)},
                   (Vector2){(float)(cx + radius / 3), (float)(cy - radius / 5)},
                   (float)Scale(2), text)
        DrawLineEx((Vector2){(float)(cx + radius / 3), (float)(cy - radius / 5)},
                   (Vector2){(float)(cx + radius * 2 / 3), (float)(cy - radius / 5)},
                   (float)Scale(2), text)
    } else if complete && !counting {
        DrawLineEx((Vector2){(float)(cx - radius / 2), (float)cy},
                   (Vector2){(float)(cx - radius / 8),
                             (float)(cy + radius / 3)},
                   (float)Scale(2), text)
        DrawLineEx((Vector2){(float)(cx - radius / 8),
                             (float)(cy + radius / 3)},
                   (Vector2){(float)(cx + radius / 2),
                             (float)(cy - radius / 3)},
                   (float)Scale(2), text)
    }
    if counting && count > 0 {
        value: [16] char = {0}
        snprintf(value, sizeof(value), "%d", count)
        value_font := AppFitFontSize(value, radius * 2 - Scale(4),
                                  Text12, Text8)
        Text((TextProps){
            .bounds={(cx - AppTextWidth(value, value_font) / 2),
                     (AppControlTextY(value, cy - radius, radius * 2,
                                        value_font)), 0, 0},
            .text=(value),
            .wrap=TextWrapNone
        })
    }
}

draw_habit_completion_underline :: (x: int, y: int, w: int, h: int,
                                       color: Color) {
    DrawRectangle(x + Scale(4),
                     y + h - Scale(6),
                     w - Scale(8),
                     Scale(3),
                     color)
}

draw_habit_link_dot :: (x: int, y: int, w: int, color: Color) {
    unused color

    DrawCircle(x + w - Scale(8),
                  y + Scale(8),
                  Scale(5),
                  DarkenColor(GetThemeBackground(), 35))
    DrawCircle(x + w - Scale(8),
                  y + Scale(8),
                  Scale(3),
                  GetThemeText())
}

habit_calendar_day_cell :: (app: InnerBreeze*, x: int, y: int, w: int, h: int,
                               label: const char*, progress: float,
                               disabled: int, current_day: int,
                               accent: Color) -> int {
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    ring: Color = Fade(GetThemeText(), disabled ? 0.16f : 0.28f)
    progress_ring: Color = accent
    today_ring: Color = GetThemeButtonHover()
    text_color: Color = disabled
        ? DarkenColor(GetThemeText(), 35)
        : GetThemeText()
    font: int = Text16
    text_w: int
    center_x: float = x + w / 2.0f
    center_y: float = y + Scale(20)
    radius: float = Scale(15)
    ring_width: float = (float)Scale(2)

    if progress < 0.0f {
        progress = 0.0f
    }
    if progress > 1.0f {
        progress = 1.0f
    }

    if radius > w / 2.0f - Scale(5) {
        radius = w / 2.0f - Scale(5)
    }
    if radius < Scale(10) {
        radius = Scale(10)
    }

    clicked := Button((ButtonProps){
        .bounds = bounds, .disabled = disabled,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    })

    DrawCircleLinesEx((Vector2){center_x, center_y}, radius,
                      ring_width, ring)
    if progress > 0.0f {
        DrawRing((Vector2){center_x, center_y},
                 radius - ring_width / 2.0f,
                 radius + ring_width / 2.0f,
                 -90.0f, -90.0f + 360.0f * progress,
                 36, progress_ring)
    }
    if current_day {
        DrawCircleLinesEx((Vector2){center_x, center_y},
                          radius + Scale(3),
                          (float)Scale(2), today_ring)
    }

    text_w = AppTextWidth(label, font)
    Text((TextProps){
        .bounds={((int)center_x - text_w / 2), ((int)center_y - AppTextLineHeight(font) / 2), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })

    return clicked
}

habit_calendar_day_metadata :: (app: InnerBreeze*, x: int, y: int,
                                  w: int, h: int, counting: int,
                                  count: int, linked_count: int,
                                  disabled: int, accent: Color) #private {
    label: [16] char = {0}
    icon_size: int = Scale(12)
    gap: int = Scale(2)
    label_font: int = Text12
    label_w: int = 0
    total_w: int = 0
    draw_x: int
    draw_y: int = y + h - AppTextLineHeight(label_font) - Scale(4)
    show_icon: int = linked_count > 0
    show_count: int = (counting && count > 0) || linked_count > 1

    if disabled || (!show_icon && !show_count) {
        return
    }
    if show_count {
        snprintf(label, sizeof(label), "%d×", counting ? count : linked_count)
        label_w = AppTextWidth(label, label_font)
    }
    total_w = label_w
    if show_icon {
        total_w += icon_size
        if show_count {
            total_w += gap
        }
    }
    draw_x = x + (w - total_w) / 2
    if show_icon {
        Icon(0, draw_x, draw_y, icon_size, ICON_LINK,
             LightenColor(accent, 16))
        draw_x += icon_size + (show_count ? gap : 0)
    }
    if show_count {
        Text((TextProps){
            .bounds={(draw_x), (draw_y), 0, 0},
            .text=(label),
            .wrap=TextWrapNone
        })
    }
}

habit_calendar_draw_weekdays :: (x: int, y: int, w: int,
                                   gap: int) #private {
    weekdays: [7] const char* = {
        "habit_day_sun", "habit_day_mon", "habit_day_tue", "habit_day_wed",
        "habit_day_thu", "habit_day_fri", "habit_day_sat"
    }

    for int col = 0; col < 7; col++ {
        cell_w := (w - gap * 6) / 7
        cell_x := x + col * (cell_w + gap)
        label := GetLocaleText(weekdays[col])
        font := AppFitFontSize(label, cell_w, Text12, Text8)

        Text((TextProps){
            .bounds={(cell_x + (cell_w - AppTextWidth(label, font)) / 2), (y), 0, 0},
            .text=(label),
            .wrap=TextWrapNone
        })
    }
}

habit_weekly_row_height :: () -> int #private {
    return Scale(58)
}

habit_weekly_draw_text_line :: (text: const char*, x: int, y: int,
                               w: int, h: int, text_size: int,
                               color: Color) #private {
    font_size: int

    if text == nil || text[0] == '\0' || w <= 0 || h <= 0 {
        return
    }

    font_size = text_size
    while font_size > Text8 &&
          AppTextWidth(text, font_size) > w {
        font_size -= 1
    }


    Text((TextProps){
        .bounds={(x), (y), (w), (h)},
        .font = font_size,
        .align = TextAlignCenter,
        .vertical_align = TextAlignCenter,
        .text = text,
        .wrap=TextWrapNone
    })
}

habit_weekly_summary :: (ctx: const HabitLinkedContext*, day_index: int,
                        primary: char*, primary_size: size_t,
                        secondary: char*, secondary_size: size_t) -> int #private {
    count: int = 0
    first_activity: int = -1
    mixed: int = 0

    if primary != nil && primary_size > 0 {
        primary[0] = '\0'
    }
    if secondary != nil && secondary_size > 0 {
        secondary[0] = '\0'
    }
    if ctx == nil {
        return 0
    }

    for int i = 0; i < ctx->count; i++ {
        entry_day: int = ctx->entries[i].year * 10000 +
                         ctx->entries[i].month * 100 +
                         ctx->entries[i].day

        if entry_day != day_index {
            continue
        }
        if first_activity < 0 {
            first_activity = ctx->entries[i].activity
        } else if first_activity != ctx->entries[i].activity {
            mixed = 1
        }
        count++
    }

    if count <= 0 {
        return 0
    }

    if primary != nil && primary_size > 0 {
        snprintf(primary, primary_size, "%s",
                    mixed
                        ? GetLocaleText("habit_mixed_practice_label")
                        : practice_activity_label(first_activity))
    }
    if secondary != nil && secondary_size > 0 {
        FormatLocaleText(secondary, secondary_size,
                            count == 1
                                ? "session_count_singular"
                                : "session_count_plural",
                            count)
    }

    return count
}

habit_weekly_summary_button :: (app: InnerBreeze*, x: int, y: int,
                               w: int, h: int, completed: int,
                               disabled: int, primary: const char*,
                               secondary: const char*) -> int #private {
    bounds: Rectangle = {(float)x, (float)y, (float)w, (float)h}
    text_color: Color = disabled
        ? DarkenColor(GetThemeText(), 35)
        : GetThemeText()
    pad: int = Scale(9)
    text_x: int
    text_w: int
    line1: const char* = primary != nil ? primary : ""
    line2: const char* = secondary != nil ? secondary : ""

    if app == nil {
        return 0
    }

    clicked := Button((ButtonProps){
        .bounds = bounds, .disabled = disabled,
        .tone = completed ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft, .selected = completed
    })

    text_x = x + pad
    text_w = w - pad * 2

    if line1[0] != '\0' {
        if line2[0] != '\0' {
            line1_h: int = Scale(24)
            line2_h: int = Scale(18)
            underline_space: int = completed ? Scale(5) : 0
            block_h: int = line1_h + line2_h
            block_y: int = y + (h - block_h - underline_space) / 2

            habit_weekly_draw_text_line(line1, text_x, block_y,
                                           text_w, line1_h,
                                           Text16, text_color)
            habit_weekly_draw_text_line(line2, text_x,
                                           block_y + line1_h,
                                           text_w, line2_h,
                                           Text12,
                                           DarkenColor(text_color, 16))
        } else {
            habit_weekly_draw_text_line(line1, text_x,
                                           y + Scale(3),
                                           text_w,
                                           h - Scale(6),
                                           Text16, text_color)
        }
    }

    return clicked
}

habit_weekly_content_height :: (visible_days: int) -> int #private {
    row_h: int = habit_weekly_row_height()
    row_gap: int = Scale(10)
    load_h: int = Scale(38)

    if visible_days < HABIT_WEEKLY_INITIAL_DAYS {
        visible_days = HABIT_WEEKLY_INITIAL_DAYS
    }

    return Scale(26) +
           row_h * visible_days +
           row_gap * (visible_days - 1) +
           Scale(14) +
           load_h +
           Scale(16)
}

draw_habits_weekly_view :: (app: InnerBreeze*, active: Habit*,
                               selected: int,
                               linked_ctx: HabitLinkedContext*,
                               content_x: int, content_w: int,
                               y: int, visible_days: int) {
    now: time_t = time(nil)
    day_tm: struct tm
    today_index: int = habits_today_index()
    label_w: int = Scale(88)
    gap: int = Scale(8)
    button_x: int
    button_w: int
    row_h: int = habit_weekly_row_height()
    row_gap: int = Scale(10)
    day_font: int = Text16
    date_font: int = Text12
    load_h: int = Scale(38)

    local: struct tm* = localtime(&now)

    if local != nil {
        day_tm = *local
    } else {
        memset(&day_tm, 0, sizeof(day_tm))
    }
    day_tm.tm_hour = 12
    day_tm.tm_min = 0
    day_tm.tm_sec = 0
    mktime(&day_tm)

    if label_w > content_w / 2 {
        label_w = content_w / 2
    }

    button_x = content_x + label_w + gap
    button_w = content_w - label_w - gap
    if button_w < Scale(80) {
        button_w = content_w
        label_w = 0
        button_x = content_x
    }

    if visible_days < HABIT_WEEKLY_INITIAL_DAYS {
        visible_days = HABIT_WEEKLY_INITIAL_DAYS
    }
    if visible_days > HABIT_WEEKLY_MAX_DAYS {
        visible_days = HABIT_WEEKLY_MAX_DAYS
    }

    for int i = 0; i < visible_days; i++ {
        row_tm: struct tm = day_tm
        day_label: [16] char = {0}
        date_label: [32] char = {0}
        day_index: int
        completed: int
        has_linked_day: int
        future_day: int
        count: int = 0
        action: int = 0
        counting_enabled: int
        minimum_count: int
        primary: [64] char = ""
        secondary: [64] char = ""
        session_count: int

        row_tm.tm_mday -= i
        mktime(&row_tm)

        day_index = habit_tm_date_index(&row_tm)
        future_day = day_index > today_index
        has_linked_day = linked_ctx != nil &&
            habit_linked_has_day(linked_ctx, day_index)
        counting_enabled = habit_counting_enabled(active)
        minimum_count = habit_linked_session_count_for_day(linked_ctx,
                                                           day_index)
        session_count = habit_weekly_summary(linked_ctx, day_index,
                                             primary, sizeof(primary),
                                             secondary, sizeof(secondary))

        if counting_enabled {
            count = habit_effective_day_count(active, day_index, linked_ctx)
        }

        completed = habit_completed_day(active, day_index)
        if !completed && !future_day &&
           ((!counting_enabled && has_linked_day) ||
            (counting_enabled && count >= habit_counter_target(active))) {
            completed = 1
        }

        if counting_enabled &&
           count > 0 &&
           session_count > 0 &&
           secondary[0] != '\0' {
            len: size_t = strlen(secondary)

            FormatLocaleText(secondary + len,
                                sizeof(secondary) - len,
                                "habit_day_total_count_suffix",
                                count)
        }

        if session_count <= 0 && completed {
            snprintf(primary, sizeof(primary), "%s",
                        GetLocaleText("habit_day_completed"))
            secondary[0] = '\0'
        }

        strftime(day_label, sizeof(day_label), "%a", &row_tm)
        for char* p = day_label; *p != '\0'; p++ {
            if *p >= 'a' && *p <= 'z' {
                *p = (char)(*p - 'a' + 'A')
            }
        }
        snprintf(date_label, sizeof(date_label), "%02d/%02d/%02d",
                    row_tm.tm_mday,
                    row_tm.tm_mon + 1,
                    (row_tm.tm_year + 1900) % 100)

        if label_w > 0 {
            DrawRectangleRounded((Rectangle){
                (float)content_x,
                (float)y,
                (float)label_w,
                (float)row_h
            }, 0.18f, 10, GetThemeSurface())
            Text((TextProps){
                .bounds={(content_x + Scale(8)), (y + Scale(7)), 0, 0},
                .text=(day_label),
                .wrap=TextWrapNone
            })
            Text((TextProps){
                .bounds={(content_x + Scale(8)), (y + Scale(33)), 0, 0},
                .text=(date_label),
                .wrap=TextWrapNone
            })
        }

        if counting_enabled {
            action = habit_counter_day_action(app, selected, day_index,
                                              button_x, y,
                                              button_w, row_h,
                                              future_day,
                                              !has_linked_day)
            summary_clicked := habit_weekly_summary_button(app, button_x, y,
                button_w, row_h, completed, future_day, primary, secondary)
            if action == 0 && has_linked_day && !future_day && summary_clicked {
                habit_open_linked_edit_page(app, selected, day_index)
            }
        } else if habit_weekly_summary_button(app, button_x, y,
                                              button_w, row_h,
                                              completed, future_day,
                                              primary, secondary) {
            if has_linked_day {
                habit_open_linked_edit_page(app, selected, day_index)
            } else {
                habit_toggle_day(&app->habits, selected, day_index)
                active = &app->habits.items[selected]
                app_auto_sync(app)
                app_block_current_click(app)
                ConsumeRelease()
            }
        }

        if action == 1 || action == -1 {
            habit_apply_count_action(app, selected, day_index,
                                        action, minimum_count)
            active = &app->habits.items[selected]
            count = habit_effective_day_count(active, day_index, linked_ctx)
            completed = count >= habit_counter_target(active)
            app_auto_sync(app)
            app_block_current_click(app)
            ConsumeRelease()
        }

        if completed && !future_day {
            draw_habit_completion_underline(button_x, y,
                                               button_w, row_h,
                                               active->color)
        }

        if counting_enabled &&
           count > 0 &&
           !future_day &&
           !has_linked_day {
            count_label: [16] char = {0}
            count_font: int = Text12
            count_w: int

            snprintf(count_label, sizeof(count_label), "%d", count)
            count_w = AppTextWidth(count_label, count_font)
            Text((TextProps){
                .bounds={(button_x + button_w - count_w - Scale(6)), (y + Scale(5)), 0, 0},
                .text=(count_label),
                .wrap=TextWrapNone
            })
        }

        if !future_day && has_linked_day {
            draw_habit_link_dot(button_x, y, button_w, active->color)
        }

        y += row_h + row_gap
    }

    y += Scale(8)
    if Button((ButtonProps){
        .bounds = {(float)(content_x), (float)(y), (float)(content_w), (float)(load_h)},
        .label = GetLocaleText("habit_load_more_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = app->habits.weekly_days >= HABIT_WEEKLY_MAX_DAYS
    }) {
        app->habits.weekly_days += HABIT_WEEKLY_LOAD_DAYS
        if app->habits.weekly_days > HABIT_WEEKLY_MAX_DAYS {
            app->habits.weekly_days = HABIT_WEEKLY_MAX_DAYS
        }
    }
}

habits_scroll_page_content_height :: (content_w: int,
                                         user_data: void*) -> int {
    ctx: HabitsScrollPageContext* = user_data

    if ctx->view_mode == HABIT_VIEW_WEEKLY {
        return habit_weekly_content_height(ctx->weekly_days)
    }

    planned_cell_h := (content_w - ctx->grid_gap * 6) / 7
    if planned_cell_h < Scale(28) {
        planned_cell_h = Scale(28)
    }
    if planned_cell_h < Scale(58) {
        planned_cell_h = Scale(58)
    }

    return Scale(8) +
           ctx->month_h +
           Scale(12) +
           Scale(22) +
           planned_cell_h * 6 +
           ctx->grid_gap * 5 +
           Scale(16)
}

HabitsFocusPageContext :: struct {
    app: InnerBreeze*
}

habits_focus_card_height :: () -> int #private {
    return Scale(400)
}

habits_focus_collapsed_height :: () -> int #private {
    return Scale(140)
}

habits_focus_grid_max_width :: () -> int #private {
    return Scale(1120)
}

habits_focus_grid_props :: (x: int, y: int, w: int) -> GridProps #private {
    return (GridProps){
        .bounds = {(float)x, (float)y, (float)w, 0},
        .min_item_width = Scale(300),
        .gap = Scale(12),
        .padding = 0
    }
}

habits_focus_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (HabitsFocusPageContext*)user_data
    count := ctx != nil && ctx->app != nil ? ctx->app->habits.count : 0
    selected := ctx != nil && ctx->app != nil ? ctx->app->habits.selected : -1
    grid := BeginGridCursor(habits_focus_grid_props(0, 0, content_w))

    for int i = 0; i < count; i++ {
        item_h := i == selected
            ? habits_focus_card_height() : habits_focus_collapsed_height()
        grid = GridStep(grid, item_h, 1)
    }

    return Scale(82) + GridCursorHeight(grid) + Scale(24)
}

habit_focus_day_complete :: (habit: const Habit*, day_index: int,
                             linked_ctx: const HabitLinkedContext*) -> int #private {
    if habit == nil {
        return 0
    }
    return habit_completed_day(habit, day_index) ||
        habit_linked_session_count_for_day(linked_ctx, day_index) > 0 ||
        (habit_counting_enabled(habit) &&
         habit_effective_day_count(habit, day_index, linked_ctx) > 0)
}

habit_focus_streak :: (habit: const Habit*,
                       linked_ctx: const HabitLinkedContext*) -> int #private {
    streak := 0

    for int ago = 0; ago < 370; ago++ {
        day := habits_day_index(ago)
        if !habit_scheduled_day(habit, day) {
            continue
        }
        if !habit_focus_day_complete(habit, day, linked_ctx) {
            break
        }
        streak++
    }
    return streak
}

habit_focus_completion_count :: (habit: const Habit*,
                                  linked_ctx: const HabitLinkedContext*,
                                  days: int, scheduled: int*) -> int #private {
    completed := 0
    due := 0

    for int ago = 0; ago < days; ago++ {
        day := habits_day_index(ago)
        if !habit_scheduled_day(habit, day) {
            continue
        }
        due++
        if habit_focus_day_complete(habit, day, linked_ctx) {
            completed++
        }
    }
    if scheduled != nil {
        *scheduled = due
    }
    return completed
}

habits_focus_draw_metric :: (x: int, y: int, w: int, h: int,
                             label: const char*, value: const char*,
                             accent: Color) #private {
    surface := GetThemeSurface()
    foreground := GetThemeReadableText(surface)
    DrawRectangleRounded((Rectangle){(float)x, (float)y, (float)w, (float)h},
                         0.12f, 8, DarkenColor(surface, 3))
    DrawRectangle(x, y, Scale(4), h, accent)
    Text((TextProps){
        .bounds={(x + Scale(14)), (y + Scale(8)), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    Text((TextProps){
        .bounds={(x + Scale(14)), (y + Scale(34)), 0, 0},
        .text=(value),
        .wrap=TextWrapNone
    })
}

habits_focus_draw_week :: (app: InnerBreeze*, habit: Habit*, selected: int,
                           linked_ctx: HabitLinkedContext*,
                           x: int, y: int, w: int) #private {
    weekdays: [7] const char* = {
        "habit_day_mon", "habit_day_tue", "habit_day_wed", "habit_day_thu",
        "habit_day_fri", "habit_day_sat", "habit_day_sun"
    }
    today := habits_today_index()
    counting := habit_counting_enabled(habit)
    today_count := habit_effective_day_count(habit, today, linked_ctx)
    linked_today := habit_linked_session_count_for_day(linked_ctx, today)
    today_complete := habit_focus_day_complete(habit, today, linked_ctx)
    today_label: [80] char = {0}
    due := 0
    done := habit_focus_completion_count(habit, linked_ctx, 7, &due)
    streak := habit_focus_streak(habit, linked_ctx)
    streak_value: [32] char = {0}
    week_value: [32] char = {0}
    action_y := y
    action_h := Scale(42)
    row_y := action_y + action_h + Scale(14)
    row_h := Scale(62)
    metric_y := row_y + row_h + Scale(14)
    metric_gap := Scale(10)
    metric_w := (w - metric_gap) / 2
    columns := clampi(w / Scale(44), 5, 7)
    if selected == 0 {
        app->habits_guide_anchors[5] = (Rectangle){
            (float)x, (float)row_y, (float)w, (float)row_h
        }
    }

    if counting {
        snprintf(today_label, sizeof(today_label), "%s  %d",
                 GetLocaleText("habits_today"), today_count)
    } else {
        snprintf(today_label, sizeof(today_label), "%s",
                 GetLocaleText(today_complete
                     ? "habit_day_completed" : "habit_complete_today_button"))
    }
    if Button((ButtonProps){
        .bounds = {(float)x, (float)action_y, (float)w, (float)action_h},
        .label = today_label, .id = 24200,
        .tone = ButtonToneAccent, .emphasis = ButtonEmphasisFilled,
        .disabled = app->modal.active ||
            (!habit_scheduled_day(habit, today) && !today_complete)
    }) {
        if linked_today > 0 {
            habit_open_linked_edit_page(app, selected, today)
        } else if counting {
            habit_apply_count_action(app, selected, today, 1, 0)
            app_auto_sync(app)
        } else {
            habit_toggle_day(&app->habits, selected, today)
            app_auto_sync(app)
        }
    }

    for int col = 0; col < columns; col++ {
        day := habits_day_index(col)
        cell_x := x + w * col / columns
        cell_right := x + w * (col + 1) / columns
        cell_w := cell_right - cell_x
        cell := (Rectangle){(float)cell_x, (float)row_y,
                            (float)cell_w, (float)row_h}
        if selected == 0 && col == 0 {
            habits_first_day_bounds = cell
        }
        complete := habit_focus_day_complete(habit, day, linked_ctx)
        off := !habit_scheduled_day(habit, day)
        linked := habit_linked_session_count_for_day(linked_ctx, day)
        count := habit_effective_day_count(habit, day, linked_ctx)
        label := col == 0 ? GetLocaleText("habits_today")
                          : GetLocaleText(weekdays[habit_weekday_bit(day)])
        label_font := AppFitFontSize(label, cell_w - Scale(4),
                                  Scale(Text12), Scale(10))
        cx := cell_x + cell_w / 2
        cy := row_y + Scale(44)
        radius := Scale(col == 0 ? 11 : 9)
        action := 0

        mouse := GetScreenToWorld2D(GetMousePosition(), app->camera)
        input_captured := InputCapturesClick(mouse)
        interactive := !app->modal.active && !input_captured && (!off || complete)
        cell_hovered := interactive && CheckCollisionPointRec(mouse, cell)

        if cell_hovered {
            MarkClickable()
        }
        if counting && interactive {
            action = habit_counter_day_action(app, selected, day,
                cell_x, row_y, cell_w, row_h, 0, linked == 0)
        }
        clicked := cell_hovered && IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
        Text((TextProps){
            .bounds={(cx - AppTextWidth(label, label_font) / 2), (row_y), 0, 0},
            .text=(label),
            .wrap=TextWrapNone
        })
        if off && !complete {
            Line(cx - Scale(5), cy, cx + Scale(5), cy,
                 Fade(GetThemeText(), 0.35f))
        } else {
            habits_draw_day_marker(cx, cy, radius, complete, counting, count, linked,
                                   cell_hovered, GetThemeSurface(),
                                   GetThemeText(), habit->color)
        }
        if !app->modal.active && (!off || complete) {
            handled := 0
            if action == 1 || action == -1 {
                habit_apply_count_action(app, selected, day, action, linked)
                app_auto_sync(app)
                handled = 1
            } else if clicked && action != -2 {
                if linked > 0 {
                    habit_open_linked_edit_page(app, selected, day)
                    handled = 1
                } else if !counting {
                    habit_toggle_day(&app->habits, selected, day)
                    app_auto_sync(app)
                    handled = 1
                }
            }
            if handled {
                app_block_current_click(app)
                ConsumeRelease()
                return
            }
        }
    }

    statistics_format_day_count(streak_value, sizeof(streak_value), streak)
    snprintf(week_value, sizeof(week_value), "%d / %d", done, due)
    habits_focus_draw_metric(x, metric_y, metric_w, Scale(64),
                             GetLocaleText("habit_stats_current_streak"),
                             streak_value, habit->color)
    habits_focus_draw_metric(x + metric_w + metric_gap, metric_y,
                             w - metric_w - metric_gap, Scale(64),
                             GetLocaleText("profile_progress_title"),
                             week_value, LightenColor(habit->color, 18))
}

habit_focus_chevron_control :: (center_x: int, center_y: int, size: int,
                              expanded: int, color: Color,
                              disabled: int) -> int #private {
    bounds := (Rectangle){
        (float)(center_x - size / 2),
        (float)(center_y - size / 2),
        (float)size,
        (float)size
    }
    hover := 0
    clicked := HandleCircleClick((Vector2){(float)center_x, (float)center_y},
                                   (float)size / 2.0f, disabled, &hover)
    style := (Style){
        .fields = StyleBackground | StyleBorder | StyleRadius |
                  StyleBorderWidth | StyleOpacity,
        .background = GetThemeSurfaceAlt(),
        .border = GetThemeBorder(),
        .radius = (float)size / 2.0f,
        .border_width = 1.0f,
        .opacity = disabled ? 0.45f : 1.0f
    }
    span := Scale(14)
    drop := Scale(6)

    if hover && !disabled {
        style.background = GetThemeButtonHover()
    }
    Surface(bounds, style)
    if expanded {
        DrawLineEx((Vector2){(float)(center_x - span / 2),
                             (float)(center_y + drop / 2)},
                   (Vector2){(float)center_x,
                             (float)(center_y - drop / 2)},
                   (float)Scale(2), color)
        DrawLineEx((Vector2){(float)(center_x + span / 2),
                             (float)(center_y + drop / 2)},
                   (Vector2){(float)center_x,
                             (float)(center_y - drop / 2)},
                   (float)Scale(2), color)
    } else {
        DrawLineEx((Vector2){(float)(center_x - span / 2),
                             (float)(center_y - drop / 2)},
                   (Vector2){(float)center_x,
                             (float)(center_y + drop / 2)},
                   (float)Scale(2), color)
        DrawLineEx((Vector2){(float)(center_x + span / 2),
                             (float)(center_y - drop / 2)},
                   (Vector2){(float)center_x,
                             (float)(center_y + drop / 2)},
                   (float)Scale(2), color)
    }
    return clicked
}

habits_focus_draw_card :: (app: InnerBreeze*, selected: int,
                           x: int, y: int, w: int) #private {
    habit := &app->habits.items[selected]
    linked_ctx := habit_cached_linked_entries(app, selected, 0)
    surface := GetThemeSurface()
    foreground := GetThemeReadableText(surface)
    muted := Fade(foreground, 0.68f)
    card_h := habits_focus_card_height()
    header_h := Scale(144)
    section_y := y + header_h
    body_y := section_y + AppTextLineHeight(AppSmallFontSize()) + Scale(12)
    action_size := (float)Scale(52)
    actions := BeginFlexCursor((FlexProps){
        .bounds = {(float)(x + Scale(14)), (float)(y + Scale(78)),
                   (float)(w - Scale(28)), action_size},
        .justify_content = JustifySpaceAround,
        .align_items = AlignCenter
    }, 3, action_size * 3.0f)

    card_bounds := (Rectangle){(float)x, (float)y, (float)w, (float)card_h}
    chevron_cx := x + w - Scale(34)
    chevron_cy := y + Scale(31)
    chevron_size := Scale(40)
    chevron_color := Fade(foreground, 0.72f)

    Card focus_card: {
        bounds = card_bounds
    }
    collapse_clicked := habit_focus_chevron_control(chevron_cx, chevron_cy, chevron_size,
                                                    1,
                                                    chevron_color,
                                                    app->modal.active)
    if collapse_clicked {
        app_block_current_click(app)
        ConsumeRelease()
        habits_return_to_overview(app)
        return
    }
    DrawRectangle(x + Scale(16), y + Scale(20),
                  Scale(10), Scale(10), habit->color)
    habits_draw_fitted_text(habit->name, x + Scale(38), y + Scale(12),
                            w - Scale(54),
                            AppFontSize(),
                            Text14,
                            foreground)
    if habit->description[0] != '\0' {
        description: [HABIT_DESCRIPTION_SIZE + 4] char = {0}
        habits_card_description(habit->description, description,
                                sizeof(description))
        Text((TextProps){
            .bounds={(x + Scale(38)), (y + Scale(46)), (w - Scale(54)), 0},
            .font = AppSmallFontSize(),
            .text=(description),
            .wrap=TextWrapNone
        })
    }
    actions = FlexStep(actions, action_size, action_size)
    if selected == 0 {
        app->habits_guide_anchors[2] = actions.item
    }
    if Button((ButtonProps){
        .bounds = actions.item,
        .icon_type = ICON_CALENDAR,
        .icon_only = 1, .circle = 0,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        habits_open_history(app)
        return
    }
    actions = FlexStep(actions, action_size, action_size)
    if selected == 0 {
        app->habits_guide_anchors[3] = actions.item
    }
    if Button((ButtonProps){
        .bounds = actions.item,
        .icon_type = ICON_STAT,
        .icon_only = 1, .circle = 0,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        habits_open_statistics(app)
        return
    }
    actions = FlexStep(actions, action_size, action_size)
    if selected == 0 {
        app->habits_guide_anchors[4] = actions.item
    }
    if Button((ButtonProps){
        .bounds = actions.item,
        .icon_type = ICON_EDIT,
        .icon_only = 1, .circle = 0,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        habit_edit_begin(app, selected)
        return
    }
    Text((TextProps){
        .bounds={(x + Scale(14)), (section_y), 0, 0},
        .text=(GetLocaleText("habit_focus_week")),
        .wrap=TextWrapNone
    })
    habits_focus_draw_week(app, habit, selected, linked_ctx,
                           x + Scale(14), body_y,
                           w - Scale(28))
}

habits_focus_draw_collapsed :: (app: InnerBreeze*, index: int,
                                x: int, y: int, w: int) #private {
    habit := &app->habits.items[index]
    linked_ctx := habit_cached_linked_entries(app, index, 0)
    h := habits_focus_collapsed_height()
    surface := GetThemeSurface()
    foreground := GetThemeReadableText(surface)
    muted := Fade(foreground, 0.66f)
    bounds := (Rectangle){(float)x, (float)y, (float)w, (float)h}
    description: [HABIT_DESCRIPTION_SIZE + 4] char = {0}
    session_summary: [160] char = {0}
    session_badge: [64] char = {0}
    session_badge_w: int = 0
    weekdays: [7] const char* = {
        "habit_day_mon", "habit_day_tue", "habit_day_wed", "habit_day_thu",
        "habit_day_fri", "habit_day_sat", "habit_day_sun"
    }
    counting := habit_counting_enabled(habit)
    columns := clampi(w / Scale(48), 5, 7)
    row_y := y + Scale(78)
    row_bounds := (Rectangle){(float)(x + Scale(12)), (float)row_y,
                              (float)(w - Scale(24)), (float)Scale(62)}
    chevron_cx := x + w - Scale(34)
    chevron_cy := y + Scale(31)
    chevron_color := Fade(foreground, 0.68f)
    chevron_size := Scale(40)
    mouse := GetScreenToWorld2D(GetMousePosition(), app->camera)
    input_captured := InputCapturesClick(mouse)
    expand_clicked := 0

    if linked_ctx != nil && linked_ctx->count > 0 {
        latest_day := 0
        latest_count := 0
        latest_seconds := 0
        latest_date: [32] char = {0}
        latest_count_text: [64] char = {0}
        duration: [32] char = {0}
        for int i = 0; i < linked_ctx->count; i++ {
            entry := &linked_ctx->entries[i]
            day := entry->year * 10000 + entry->month * 100 + entry->day
            if day > latest_day {
                latest_day = day
                latest_count = 0
                latest_seconds = 0
            }
            if day == latest_day {
                latest_count++
                latest_seconds += entry->total_seconds
            }
        }
        FormatLocaleText(session_badge, sizeof(session_badge),
                         linked_ctx->count == 1 ? "session_count_singular"
                                                : "session_count_plural",
                         linked_ctx->count)
        session_badge_w = AppTextWidth(session_badge, AppSmallFontSize()) + Scale(18)
        FormatLocaleText(latest_count_text, sizeof(latest_count_text),
                         latest_count == 1 ? "session_count_singular"
                                           : "session_count_plural",
                         latest_count)
        habit_format_date(latest_day, latest_date, sizeof(latest_date))
        habit_format_duration(latest_seconds, duration, sizeof(duration))
        snprintf(session_summary, sizeof(session_summary), "%s · %s · %s",
                 latest_date, latest_count_text, duration)
    }

    Card collapsed_card: {
        bounds = bounds
    }
    DrawRectangle(x + Scale(16), y + Scale(20),
                  Scale(9), Scale(9), habit->color)
    habits_draw_fitted_text(habit->name, x + Scale(36), y + Scale(10),
                            w - Scale(76) -
                                (session_badge_w > 0 ? session_badge_w + Scale(8) : 0),
                            AppFontSize(), Text12,
                            foreground)
    if session_badge_w > 0 {
        badge_x := x + w - Scale(60) - session_badge_w
        badge_font := AppFitFontSize(session_badge,
                                    session_badge_w - Scale(12),
                                    AppSmallFontSize(), Scale(10))
        DrawRectangleRounded((Rectangle){(float)badge_x, (float)(y + Scale(11)),
                            (float)session_badge_w, (float)Scale(22)},
                            0.45f, 8, Fade(habit->color, 0.22f))
        Text((TextProps){
            .bounds={(float)(badge_x + Scale(9)), (float)(y + Scale(14)),
                     (float)(session_badge_w - Scale(18)), 0},
            .font=badge_font, .text=session_badge, .wrap=TextWrapNone
        })
    }
    habits_card_description(habit->description, description,
                            sizeof(description))
    Text((TextProps){
        .bounds={(x + Scale(36)), (y + Scale(39)), (w - Scale(76)), 0},
        .font = AppFitFontSize(session_summary[0] != '\0' ? session_summary : description,
                               w - Scale(76), AppSmallFontSize(), Scale(10)),
        .text=(session_summary[0] != '\0' ? session_summary : description),
        .wrap=TextWrapNone
    })
    for int col = 0; col < columns; col++ {
        day := habits_day_index(col)
        cell_x := x + Scale(12) +
            (w - Scale(24)) * col / columns
        cell_right := x + Scale(12) +
            (w - Scale(24)) * (col + 1) / columns
        cell_w := cell_right - cell_x
        cell := (Rectangle){(float)cell_x, (float)row_y,
                            (float)cell_w, (float)Scale(62)}
        if index == 0 && col == 0 {
            habits_first_day_bounds = cell
        }
        label := col == 0 ? GetLocaleText("habits_today")
                          : GetLocaleText(weekdays[habit_weekday_bit(day)])
        label_font := AppFitFontSize(label, cell_w - Scale(4),
                                  AppSmallFontSize(), Scale(10))
        cx := cell_x + cell_w / 2
        cy := row_y + Scale(42)
        linked := habit_linked_session_count_for_day(linked_ctx, day)
        count := habit_effective_day_count(habit, day, linked_ctx)
        complete := habit_focus_day_complete(habit, day, linked_ctx)
        off := !habit_scheduled_day(habit, day)
        action := 0
        cell_clicked := 0

        interactive := !app->modal.active && !input_captured && (!off || complete)
        cell_hovered := interactive && CheckCollisionPointRec(mouse, cell)
        if cell_hovered {
            MarkClickable()
        }

        if counting && interactive {
            action = habit_counter_day_action(app, index, day,
                cell_x, row_y, cell_w, Scale(62), 0, linked == 0)
        } else if cell_hovered && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) &&
                  !ReleaseConsumed() {
            cell_clicked = 1
        }

        Text((TextProps){
            .bounds={(cx - AppTextWidth(label, label_font) / 2), (row_y), 0, 0},
            .text=(label),
            .wrap=TextWrapNone
        })
        if off && !complete {
            Line(cx - Scale(5), cy, cx + Scale(5), cy,
                 Fade(foreground, 0.32f))
        } else {
            radius := Scale(col == 0 ? 10 : 9)
            habits_draw_day_marker(cx, cy, radius, complete, counting, count, linked,
                                   cell_hovered, surface, foreground,
                                   habit->color)
        }
        if !app->modal.active && (!off || complete) {
            handled := 0
            if action == 1 || action == -1 {
                habit_apply_count_action(app, index, day, action, linked)
                app_auto_sync(app)
                handled = 1
            } else if cell_clicked && action != -2 {
                if linked > 0 {
                    habit_open_linked_edit_page(app, index, day)
                    handled = 1
                } else if !counting {
                    habit_toggle_day(&app->habits, index, day)
                    app_auto_sync(app)
                    handled = 1
                }
            }
            if handled || cell_clicked || action != 0 {
                app_block_current_click(app)
                ConsumeRelease()
                return
            }
        }
    }
    if !app->modal.active && !input_captured &&
       CheckCollisionPointRec(mouse, row_bounds) &&
       IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        app_block_current_click(app)
        ConsumeRelease()
        return
    }
    expand_clicked = habit_focus_chevron_control(chevron_cx, chevron_cy, chevron_size,
                                                 0,
                                                 chevron_color,
                                                 app->modal.active)
    if expand_clicked {
        app_block_current_click(app)
        ConsumeRelease()
        habits_expand_card(app, index)
        app->habits.tab = HABIT_TAB_WEEKLY
        app->habits.scroll = 0
        save_settings(app)
    }
}

draw_habits_focus :: (app: InnerBreeze*, content_top: int) #private {
    context := (HabitsFocusPageContext){app}
    for int i = 0; i < HABITS_GUIDE_STEPS; i++ {
        app->habits_guide_anchors[i] = (Rectangle){0}
    }
    measure_x: int
    measure_w: int
    content_h: int
    grid: GridCursor
    max_content_w := habits_focus_grid_max_width()

    GetCenteredColumn(max_content_w, GetPageSidePadding(),
                        &measure_x, &measure_w)
    content_h = habits_focus_content_height(measure_w, &context)
    Scroll page: {
        bounds = {0, (float)(content_top + Scale(4)), (float)view_width,
                  (float)(view_height - content_top -
                          app_content_bottom_reserved(app) - Scale(4))}
        content_height = content_h
        scroll_offset = &app->habits.scroll
        x := measure_x
        w := measure_w
        y := (int)page.y + Scale(12)
        title := GetLocaleText("tab_habits")
        title_font := AppTitleFontSize(title, w / 2)
        progress: [64] char = {0}
        button_w := AppTextWidth(GetLocaleText("habit_new_button"), AppFontSize()) +
            Scale(32)

        Text((TextProps){
            .bounds={(x), (y), 0, 0},
            .text=(title),
            .wrap=TextWrapNone
        })
        snprintf(progress, sizeof(progress), GetLocaleText("habits_done_count_label"),
                 habits_done_today(app), habits_due_today(app))
        progress_font := AppSmallFontSize()
        app->habits_guide_anchors[0] = (Rectangle){
            (float)x, (float)(y + Scale(35)),
            (float)AppTextWidth(progress, progress_font),
            (float)(progress_font + Scale(4))
        }
        Text((TextProps){
            .bounds = app->habits_guide_anchors[0],
            .font = progress_font, .text = progress, .wrap = TextWrapNone
        })
        if Button((ButtonProps){
            .bounds = {(float)(x + w - button_w), (float)y,
                       (float)button_w, (float)Scale(48)},
            .label = GetLocaleText("habit_new_button"), .id = 24000,
            .disabled = app->habits.count >= HABIT_MAX || app->modal.active
        }) {
            habits_begin_new_detail(app)
            return
        }
        grid = BeginGridCursor(habits_focus_grid_props(x, page.y + Scale(82), w))
        for int i = 0; i < app->habits.count; i++ {
            if i == app->habits.selected {
                grid = GridStep(grid, habits_focus_card_height(), 1)
                cell := grid.item
                habits_focus_draw_card(app, i, (int)cell.x, (int)cell.y, (int)cell.width)
            } else {
                grid = GridStep(grid, habits_focus_collapsed_height(), 1)
                cell := grid.item
                if i == 0 {
                    app->habits_guide_anchors[1] = cell
                }
                habits_focus_draw_collapsed(app, i, (int)cell.x, (int)cell.y, (int)cell.width)
            }
        }
    }
}

habits_draw_subpage_header :: (app: InnerBreeze*, statistics: int) -> int #private {
    top_h := Scale(58)
    selector_h := Scale(40)
    selector_y := top_h + Scale(10)
    side := GetPageSidePadding()
    selector_w := view_width - side * 2
    selected_view := app->habits.view_mode == HABIT_VIEW_CALENDAR ? 1 : 0
    views: [2] const char* = {
        GetLocaleText("habit_focus_week"),
        GetLocaleText("habit_focus_calendar")
    }
    active: Habit* = nil

    if app->habits.selected >= 0 && app->habits.selected < app->habits.count {
        active = &app->habits.items[app->habits.selected]
    }
    if TitleBar((TitleBarProps){
            .title = active != nil ? active->name : GetLocaleText("tab_habits"),
            .height = top_h,
            .has_leading_action = 1}) {
        habits_return_to_focus(app)
        return -1
    }
    if statistics {
        return top_h
    }
    if selector_w > Scale(CONTENT_MAX_W) {
        selector_w = Scale(CONTENT_MAX_W)
    }
    selector_x := (view_width - selector_w) / 2
    if Dropdown((DropdownProps){.id = 24600,
                .bounds = {selector_x, selector_y, selector_w, selector_h},
                .options = views, .option_count = 2,
                .selected_index = &selected_view}) {
        app->habits.view_mode = selected_view == 1
            ? HABIT_VIEW_CALENDAR : HABIT_VIEW_WEEKLY
        app->habits.tab = selected_view == 1
            ? HABIT_TAB_MONTHLY : HABIT_TAB_WEEKLY
        app->habits.scroll = 0
        save_settings(app)
    }
    return selector_y + selector_h + Scale(12)
}

draw_habits_screen :: (app: InnerBreeze*) {
    habits_first_day_bounds = (Rectangle){0}
    content_top: int
    content_bottom: int
    content_x: int
    content_w: int
    y: int
    viewport_h: int

    side_padding: int = GetPageSidePadding()
    max_w: int = Scale(CONTENT_MAX_W)
    month_h: int = Scale(42)
    grid_gap: int = Scale(4)
    selected: int
    active: Habit* = nil
    now: time_t
    month_local: struct tm* = nil
    month: struct tm
    next_month: struct tm
    month_label: [64] char = {0}
    year: int
    mon: int
    first_wday: int
    days_in_month: int
    today_index: int = habits_today_index()
    cell_w: int
    cell_h: int
    grid_x: int
    grid_y: int
    linked_ctx: HabitLinkedContext* = nil
    active_is_linked: int
    forward_disabled: int
    scroll_y: int
    scroll_h: int

    cell_clicked: int
    page_ctx: HabitsScrollPageContext
    weekly_days: int = HABIT_WEEKLY_INITIAL_DAYS

    if app == nil {
        return
    }

    if app->habits.tab < HABIT_TAB_WEEKLY ||
       app->habits.tab >= HABIT_TAB_COUNT {
        app->habits.tab = app->habits.view_mode == HABIT_VIEW_WEEKLY
            ? HABIT_TAB_WEEKLY
            : HABIT_TAB_MONTHLY
    }
    if app->habits.tab == HABIT_TAB_WEEKLY {
        app->habits.view_mode = HABIT_VIEW_WEEKLY
    } else if app->habits.tab == HABIT_TAB_MONTHLY {
        app->habits.view_mode = HABIT_VIEW_CALENDAR
    }

    content_top = habits_screen_top_reserved(app)
    content_bottom = app_content_bottom_reserved(app)
    y = content_top + Scale(8)
    viewport_h = view_height - content_top - content_bottom

    GetCenteredColumn(max_w, side_padding, &content_x, &content_w)

    if app->habits.count > 0 &&
       app->habits.screen_mode == HABITS_SCREEN_OVERVIEW {
        if app->habits.selected >= app->habits.count {
            app->habits.selected = -1
        }
        if app->habits.tab != HABIT_TAB_STATISTICS {
            app->habits.tab = HABIT_TAB_WEEKLY
        }
        draw_habits_focus(app, content_top)
        return
    }

    if app->habits.count <= 0 {
        empty_text: const char* = GetLocaleText("habit_empty_title")
        create_text: const char* = GetLocaleText("habit_create_button")
        empty_font: int = Text16
        button_w: int = content_w < Scale(240) ? content_w : Scale(240)
        button_h: int = Scale(42)
        empty_y: int = content_top + viewport_h / 2 - Scale(46)
        empty_w: int = AppTextWidth(empty_text, empty_font)


        BeginClip((int)app->camera.offset.x,
                       (int)(app->camera.offset.y +
                             content_top * app->camera.zoom),
                       (int)(view_width * app->camera.zoom),
                       (int)(viewport_h * app->camera.zoom))
        Text((TextProps){
            .bounds={(content_x + (content_w - empty_w) / 2), (empty_y), 0, 0},
            .text=(empty_text),
            .wrap=TextWrapNone
        })
        if Button((ButtonProps){
            .bounds = {(float)(content_x + (content_w - button_w) / 2), (float)(empty_y + Scale(38)), (float)(button_w), (float)(button_h)},
            .label = create_text,
            .tone = ButtonToneAccent,
            .emphasis = ButtonEmphasisFilled,
            .disabled = 0
        }) {
            habits_begin_new_detail(app)
        }
        EndClip()
        return
    }

    if app->habits.selected < 0 ||
       app->habits.selected >= app->habits.count {
        app->habits.selected = -1
    }

    selected = app->habits.selected
    active = selected >= 0 ? &app->habits.items[selected] : nil

    if app->habits.screen_mode == HABITS_SCREEN_STATISTICS {
        content_top = habits_draw_subpage_header(app, 1)
        if content_top >= 0 {
            draw_statistics_content(app, content_top)
        }
        return
    }

    if app->habits.screen_mode == HABITS_SCREEN_HISTORY {
        content_top = habits_draw_subpage_header(app, 0)
        if content_top < 0 {
            return
        }
        content_bottom = app_content_bottom_reserved(app)
        viewport_h = view_height - content_top - content_bottom
        app->habits.tab = app->habits.view_mode == HABIT_VIEW_CALENDAR
            ? HABIT_TAB_MONTHLY : HABIT_TAB_WEEKLY
    }
    active_is_linked = habit_is_linked(active)
    if app->habits.view_mode != HABIT_VIEW_WEEKLY {
        app->habits.view_mode = HABIT_VIEW_CALENDAR
    }
    weekly_days = habit_weekly_visible_days(&app->habits)

    if app->habits.tab == HABIT_TAB_EDIT {
        if !app->habit_edit.active ||
           (!app->habit_edit.is_new &&
            app->habit_edit.index != app->habits.selected) {
            habit_edit_begin(app, app->habits.selected)
        }
        app_switch_screen(app, ScreenHabitEdit)
        return
    }

    if app->habits.month_offset > 0 {
        app->habits.month_offset = 0
    }

    now = time(nil)
    month_local = localtime(&now)
    if month_local != nil {
        month = *month_local
    } else {
        memset(&month, 0, sizeof(month))
    }
    month.tm_mday = 1
    month.tm_hour = 12
    month.tm_min = 0
    month.tm_sec = 0
    month.tm_mon += app->habits.month_offset
    mktime(&month)

    year = month.tm_year + 1900
    mon = month.tm_mon + 1
    first_wday = month.tm_wday
    next_month = month
    next_month.tm_mon++
    next_month.tm_mday = 0
    mktime(&next_month)
    days_in_month = next_month.tm_mday
    strftime(month_label, sizeof(month_label), "%B %Y", &month)

    linked_ctx = active_is_linked ? habit_cached_linked_entries(app, selected, 0) : nil

    scroll_y = content_top + Scale(4)
    scroll_h = viewport_h - Scale(4)
    if scroll_h < 0 {
        scroll_h = 0
    }

    page_ctx = (HabitsScrollPageContext){
        app->habits.view_mode,
        weekly_days,
        month_h,
        grid_gap
    }
    page_h := habits_scroll_page_content_height(content_w, &page_ctx)
    Scroll page: {
        bounds = {0, (float)scroll_y, (float)view_width, (float)scroll_h}
        content_height = page_h
        scroll_offset = &app->habits.scroll

        content_x := (int)page.x
        content_w := (int)page.width
        y := (int)page.y + Scale(8)

        if app->habits.view_mode == HABIT_VIEW_WEEKLY {
            draw_habits_weekly_view(app, active, selected, linked_ctx,
                                       content_x, content_w, y, weekly_days)
            return
        }

        forward_disabled = app->habits.month_offset >= 0
        if Button((ButtonProps){
            .bounds = {(float)(content_x), (float)(y), (float)(Scale(44)), (float)(month_h)},
            .label = "<",
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = 0
        }) {
            app->habits.month_offset--
        }
        if Button((ButtonProps){
            .bounds = {(float)(content_x + content_w - Scale(44)), (float)(y), (float)(Scale(44)), (float)(month_h)},
            .label = ">",
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = forward_disabled
        }) {
            app->habits.month_offset++
        }
        Text((TextProps){
            .bounds={(content_x + (content_w - AppTextWidth(month_label, Text24)) / 2), (AppControlTextY(month_label, y, month_h, Text24)), 0, 0},
            .text=(month_label),
            .wrap=TextWrapNone
        })

        grid_x = content_x
        grid_y = y + month_h + Scale(12)
        cell_w = (content_w - grid_gap * 6) / 7
        cell_h = Scale(58)
        if cell_h < cell_w {
            cell_h = cell_w
        }
        habit_calendar_draw_weekdays(grid_x, grid_y, content_w, grid_gap)
        grid_y += Scale(22)

        for int row = 0; row < 6; row++ {
            for int col = 0; col < 7; col++ {
                    slot: int = row * 7 + col
                    day: int = slot - first_wday + 1
                    cell_x: int = grid_x + col * (cell_w + grid_gap)
                    cell_y: int = grid_y + row * (cell_h + grid_gap)
                    day_label: [16] char = {0}
                    day_index: int
                    completed: int
                    future_day: int
                    has_linked_day: int
                    count: int = 0
                    action: int = 0
                    counting_enabled: int
                    minimum_count: int

                    if day < 1 || day > days_in_month {
                        continue
                    }

                    snprintf(day_label, sizeof(day_label), "%d", day)
                    day_index = year * 10000 + mon * 100 + day
                    future_day = day_index > today_index
                    has_linked_day = linked_ctx != nil &&
                        habit_linked_has_day(linked_ctx, day_index)
                    counting_enabled = habit_counting_enabled(active)
                    minimum_count =
                        habit_linked_session_count_for_day(linked_ctx, day_index)
                    if counting_enabled {
                        count = habit_effective_day_count(active, day_index,
                                                          linked_ctx)
                    }
                    completed = habit_completed_day(active, day_index)
                    if !completed && !future_day &&
                       ((!counting_enabled && has_linked_day) ||
                        (counting_enabled && count >= habit_counter_target(active))) {
                        completed = 1
                    }

                    if counting_enabled {
                        target: int = habit_counter_target(active)
                        progress: float = (float)count / (float)target

                        action = habit_counter_day_action(app, selected, day_index,
                                                          cell_x, cell_y,
                                                          cell_w, cell_h,
                                                          future_day,
                                                          !has_linked_day)
                        cell_clicked = habit_calendar_day_cell(app, cell_x, cell_y,
                            cell_w, cell_h, day_label, progress, future_day,
                            day_index == today_index, active->color)
                        if action == 0 && has_linked_day && !future_day && cell_clicked {
                            habit_open_linked_edit_page(app, selected, day_index)
                        }
                    } else if habit_calendar_day_cell(app, cell_x, cell_y,
                                                      cell_w, cell_h, day_label,
                                                      completed ? 1.0f : 0.0f,
                                                      future_day,
                                                      day_index == today_index,
                                                      active->color) {
                        if has_linked_day {
                            habit_open_linked_edit_page(app, selected, day_index)
                        } else {
                            habit_toggle_day(&app->habits, selected, day_index)
                            active = &app->habits.items[selected]
                            app_auto_sync(app)
                            app_block_current_click(app)
                            ConsumeRelease()
                        }
                    }

                    if action == 1 || action == -1 {
                        habit_apply_count_action(app, selected, day_index,
                                                    action, minimum_count)
                        active = &app->habits.items[selected]
                        count = habit_effective_day_count(active, day_index,
                                                          linked_ctx)
                        completed = count >= habit_counter_target(active)
                        app_auto_sync(app)
                        app_block_current_click(app)
                        ConsumeRelease()
                    }
                    habit_calendar_day_metadata(app, cell_x, cell_y,
                                                cell_w, cell_h,
                                                counting_enabled, count,
                                                minimum_count, future_day,
                                                active->color)
            }
        }
    }
}

route habits {
    title "Habits"
    group "Habits"
    page habits
}

habits :: (app: InnerBreeze*) #ui {
    Screen root: {
    draw_habits_screen(app)
    }
}
