#import "app.h"

language_screen_draw :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }

    title_font := 0
    title_w := 0
    content_x := 0
    content_w := 0
    dropdown_h := Scale(36)
    dropdown_w := 0
    dropdown_x := 0
    dropdown_y := 0
    button_x := 0
    button_y := 0

    selected_index: int* = &app->language_index
    language_count := GetLocaleCount()
    selection_changed := 0

    if language_count <= 0 {
        language_count = 1
    }
    if *selected_index < 0 || *selected_index >= language_count {
        *selected_index = 0
    }

    GetCenteredColumn(Scale(340), GetPageSidePadding(), &content_x, &content_w)
    dropdown_w = content_w
    dropdown_x = content_x
    dropdown_y = view_height / 2 - dropdown_h / 2
    button_x = view_width / 2
    button_y = dropdown_y + Scale(64)

    if app_locale_dropdown(260, dropdown_x, dropdown_y, dropdown_w, dropdown_h, selected_index) {
        selection_changed = 1
    }
    if selection_changed {
        apply_language_selection(app, *selected_index, 0)
        app->settings_dirty = 1
        app->settings_save_delay_ticks = 18
    }

    title_font = AppTitleFontSize(GetLocaleText("language_picker_title"), content_w)
    title_w = AppTextWidth(GetLocaleText("language_picker_title"), title_font)
    Text((TextProps){
        .bounds={(view_width / 2 - title_w / 2), (Scale(28)), 0, 0},
        .text=(GetLocaleText("language_picker_title")),
        .wrap=TextWrapNone
    })
    Text((TextProps){
        .bounds={(dropdown_x), (dropdown_y - Scale(24)), 0, 0},
        .text=(GetLocaleText("language_label")),
        .wrap=TextWrapNone
    })
    if Button((ButtonProps){
        .id = 0, .label = GetLocaleText("next_button"),
        .bounds = {(button_x) - fmaxf(AppTextWidth(GetLocaleText("next_button"), AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(button_y), fmaxf(AppTextWidth(GetLocaleText("next_button"), AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        app_accept_language_selection(app)
        app->main_tab = APP_MAIN_TAB_PRACTICE
        app->practice_tab = PRACTICE_TAB_PLAY
        app_switch_screen(app, ScreenStart)
    }
}

route language {
    title "Language"
    group "App"
    page language
}

language :: (app: InnerBreeze*) #ui {
    language_screen_draw(app)
}
