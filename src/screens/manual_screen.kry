#import "app.h"
#import "core/breath_engine.h"
#import "practices/practice_registry.h"
#import "stdio.h"

ManualGuideStartFn :: void (*)(InbeApp*) #type
ManualGuideCloseFn :: void (*)(InbeApp*, int) #type

ManualGuideNav :: struct {
    page: int
    page_count: int
    y: int
    h: int
    show_left_on_first: int
    start: ManualGuideStartFn
    close: ManualGuideCloseFn
}

manual_screen_reset_layouts :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    app->manual_scroll = 0
}

manual_screen_tutorial_body_font :: () -> int #private {
    return 14
}

manual_screen_tutorial_line_gap :: () -> int #private {
    return ScaleUIPx(6)
}

manual_screen_tutorial_side_padding :: () -> int {
    return ScaleUIPx(24)
}

manual_screen_tutorial_top_gap :: () -> int {
    return ScaleUIPx(4)
}

manual_screen_tutorial_max_width :: () -> int {
    return ScaleUIPx(480)
}

manual_screen_tutorial_paragraph :: (text: const char*, content_w: int) -> ParagraphSpec {
    return (ParagraphSpec){.text = text, .width = content_w, .font = manual_screen_tutorial_body_font(), .line_gap = manual_screen_tutorial_line_gap()}
}

manual_screen_guide_update_page :: (app: InbeApp*, page_count: int, start: ManualGuideStartFn, close: ManualGuideCloseFn) -> int {
    if app == NULL || page_count <= 0 {
        return 0
    }

    page := clampi(app->tutorial_step, 0, page_count - 1)
    previous_page := page

    if IsKeyPressed(KEY_RIGHT) || IsKeyPressed(KEY_ENTER) {
        if page < page_count - 1 {
            page++
        } else if close != NULL {
            close(app, 1)
        } else if start != NULL {
            start(app)
        }
    }
    if IsKeyPressed(KEY_LEFT) && page > 0 {
        page--
    }
    if IsKeyPressed(KEY_ESCAPE) && close != NULL {
        close(app, 0)
    }

    page = clampi(page, 0, page_count - 1)
    if page != previous_page {
        app->manual_scroll = 0
    }
    app->tutorial_step = page
    return page
}

manual_screen_guide_nav_height :: () -> int {
    return ScaleUIPx(34)
}

manual_screen_guide_draw_nav :: (app: InbeApp*, nav: ManualGuideNav) {
    if app == NULL || nav.page_count <= 1 || nav.start == NULL {
        return
    }

    page := clampi(nav.page, 0, nav.page_count - 1)
    button_size := view_width < ScaleUIPx(360) ? ScaleUIPx(28) : ScaleUIPx(30)
    button_pad := ScaleUIPx(7)
    side_pad := ScaleUIPx(10)
    button_y := nav.y + (nav.h - button_size) / 2
    page_font := Text16
    page_label: [32] char = {0}

    if nav.h <= 0 {
        return
    }

    snprintf(page_label, sizeof(page_label), "%d / %d", page + 1, nav.page_count)
    DrawCenteredUIControlText(page_label, view_width / 2, nav.y + nav.h / 2, page_font, GetThemeText())
    if page > 0 || nav.show_left_on_first {
        if IconButton((IconButtonProps){
            .bounds = {
                (float)side_pad,
                (float)button_y,
                (float)button_size,
                (float)button_size
            },
            .icon = app->icons[UI_ICON_TYPE_LEFT],
            .icon_size = ScaleUIPx(20),
            .icon_padding = button_pad
        }) {
            if page > 0 {
                app->tutorial_step = page - 1
                app->manual_scroll = 0
            } else if nav.close != NULL {
                app_block_pointer_frame(app)
                nav.close(app, 0)
            }
        }
    }

    if IconButton((IconButtonProps){
        .bounds = {
            (float)(view_width - side_pad - button_size),
            (float)button_y,
            (float)button_size,
            (float)button_size
        },
        .icon = app->icons[page >= nav.page_count - 1 ?
                           UI_ICON_TYPE_CHECK : UI_ICON_TYPE_RIGHT],
        .icon_size = ScaleUIPx(20),
        .icon_padding = button_pad
    }) {
        if page == nav.page_count - 1 {
            app_block_pointer_frame(app)
            if nav.close != NULL {
                nav.close(app, 1)
            } else {
                nav.start(app)
            }
        } else {
            app->tutorial_step = page + 1
            app->manual_scroll = 0
        }
    }
}

manual_screen_close_tutorial :: (app: InbeApp*, mark_seen: int) {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    if practice->close_manual != NULL {
        practice->close_manual(app, mark_seen)
    }
}

manual_screen_draw :: (app: InbeApp*) {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    if practice->draw_manual != NULL {
        practice->draw_manual(app)
    }
}

route manual {
    title "Manual"
    group "Practice"
    page manual
}

manual :: (app: InbeApp*) #ui {
    Screen root: {
    manual_screen_draw(app)
    }
}
