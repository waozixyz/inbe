#import "app.h"
#import "app_nav.h"
#import "core/breath_engine.h"
#import "practices/practice_registry.h"
#import "stdio.h"

ManualGuideStartFn :: void (*)(InbeApp*) #type
ManualGuideCloseFn :: void (*)(InbeApp*, int) #type

ManualGuideNav :: struct {
    page: int
    page_count: int
    y: int
    h: int
    content_y: int
    content_h: int
    focus_id: int
    start: ManualGuideStartFn
    close: ManualGuideCloseFn
}

manual_screen_reset_layouts :: (app: InbeApp*) {
    if app == NULL {
        return
    }
    app->manual_scroll = 0
}

manual_screen_tutorial_line_gap :: () -> int #private {
    return Scale(6)
}

manual_screen_tutorial_side_padding :: () -> int {
    return Scale(24)
}

manual_screen_tutorial_top_gap :: () -> int {
    return 0
}

manual_screen_guide_header_height :: () -> int {
    title_h := Scale(42)
    title_step_gap := Scale(10)
    step_h := Scale(24)
    content_gap := Scale(16)

    return title_h + title_step_gap + step_h + content_gap
}

manual_screen_tutorial_max_width :: () -> int {
    return Scale(480)
}

manual_screen_hero_bounds :: (content_x: int, content_w: int,
                              y: int, h: int) -> Rectangle {
    bleed := manual_screen_tutorial_side_padding()
    x := content_x - bleed
    w := content_w + bleed * 2

    if x < 0 {
        w += x
        x = 0
    }
    if x + w > view_width {
        w = view_width - x
    }
    return (Rectangle){(float)x, (float)y, (float)w, (float)h}
}

manual_screen_tutorial_paragraph :: (text: const char*, content_w: int) -> ParagraphSpec {
    return (ParagraphSpec){.text = text, .width = content_w, .line_gap = manual_screen_tutorial_line_gap()}
}

manual_screen_draw_guide_header :: (title: const char*, page: int,
                                    page_count: int, content_x: int,
                                    y: int*, content_w: int) {
    progress: [48] char = {0}
    title_h := Scale(42)
    title_step_gap := Scale(10)
    step_h := Scale(24)
    content_gap := Scale(16)
    if title == NULL || y == NULL || page_count <= 0 {
        return
    }
    page = clampi(page, 0, page_count - 1)
    snprintf(progress, sizeof(progress), GetLocaleText("tutorial_step_progress"),
             page + 1, page_count)

    Text((TextProps){
        .bounds={(float)content_x, (float)*y, (float)content_w,
                 (float)title_h},
        .text=(title),
        .font=(Scale(Text20)),
        .color=(GetThemeText()),
        .wrap=TextWrapNone,
        .vertical_align=TextAlignCenter
    })
    Text((TextProps){
        .bounds={(float)content_x, (float)(*y + title_h + title_step_gap),
                 (float)content_w, (float)step_h},
        .text=(progress),
        .font=(GetSmallFontSize()),
        .color=(GetThemeLink()),
        .wrap=TextWrapNone
    })
    *y += title_h + title_step_gap + step_h + content_gap
}

manual_screen_draw_hero_progress :: (bounds: Rectangle, page: int,
                                     page_count: int) {
    fade_h := Scale(58)
    dot_gap := Scale(18)
    dots_w := (page_count - 1) * dot_gap
    center_x := (int)(bounds.x + bounds.width / 2)
    dots_y := (int)(bounds.y + bounds.height - Scale(15))

    if page_count <= 0 || bounds.width <= 0 || bounds.height <= 0 {
        return
    }
    page = clampi(page, 0, page_count - 1)
    if fade_h > (int)bounds.height {
        fade_h = (int)bounds.height
    }
    DrawRectangleGradientV((int)bounds.x,
                           (int)(bounds.y + bounds.height) - fade_h,
                           (int)bounds.width, fade_h,
                           Fade(GetThemeBackground(), 0.0f),
                           GetThemeBackground())
    for int i = 0; i < page_count; i++ {
        dot_x := center_x - dots_w / 2 + i * dot_gap

        DrawCircle(dot_x, dots_y, Scale(i == page ? 4 : 3),
                   i == page ? GetThemeButton() : GetThemeMutedText())
    }
}

manual_screen_draw_title_bar :: (app: InbeApp*, title: const char*,
                                 title_h: int, close: ManualGuideCloseFn) -> int {
    if app == NULL || close == NULL {
        return 0
    }
    if app_nav_desktop_rail_enabled(app) {
        return 0
    }
    if !ReturnTitleBar(app->icons[UI_ICON_TYPE_LEFT], title, title_h) {
        return 0
    }
    app_block_current_click(app)
    close(app, 0)
    return 1
}

manual_screen_guide_nav_height :: () -> int {
    return Scale(68)
}

manual_screen_guide_controls :: (app: InbeApp*, nav: ManualGuideNav) {
    if app == NULL || nav.page_count < 1 {
        return
    }
    page := clampi(nav.page, 0, nav.page_count - 1)
    swipe := UpdateUISwipe(&app->manual_swipe, (UISwipeSpec){
        .bounds = {0, (float)nav.content_y, (float)view_width, (float)nav.content_h},
        .directions = UI_SWIPE_HORIZONTAL,
        .min_distance = (float)Scale(48),
        .axis_bias = 1.25f,
        .max_duration = 0.8f
    })
    previous := IsKeyPressed(KEY_LEFT) || swipe.direction == UI_SWIPE_RIGHT
    next := IsKeyPressed(KEY_RIGHT) || swipe.direction == UI_SWIPE_LEFT
    finish := IsKeyPressed(KEY_ENTER)
    close := IsKeyPressed(KEY_BACK) || IsKeyPressed(KEY_ESCAPE)
    pad := Scale(12)
    width := (view_width - pad * 3) / 2
    height := nav.h - pad * 2
    if height > Scale(48) {
        height = Scale(48)
    }
    if !close && width > 0 && height > 0 {
        DrawRectangle(0, nav.y, view_width, nav.h, GetThemeBackground())
        y := nav.y + (nav.h - height) / 2
        if Button((ButtonProps){
            .bounds = {(float)pad, (float)y, (float)width, (float)height},
            .id = nav.focus_id,
            .label = GetLocaleText("back_button"),
            .style = ButtonStyleSecondary
        }) {
            if page == 0 {
                close = 1
            } else {
                previous = 1
            }
        }
        if Button((ButtonProps){
            .bounds = {(float)(pad * 2 + width), (float)y, (float)width, (float)height},
            .id = nav.focus_id + 1,
            .label = GetLocaleText(page == nav.page_count - 1 ? "practice_start_button" : "next_button"),
            .style = ButtonStylePrimary
        }) {
            finish = 1
        }
    }
    if close {
        app_block_current_click(app)
        if nav.close != NULL {
            nav.close(app, 0)
        }
        return
    }
    if previous && page > 0 {
        page--
    } else if (next || finish) && page < nav.page_count - 1 {
        page++
    } else if (finish || IsKeyPressed(KEY_RIGHT)) && page == nav.page_count - 1 && nav.start != NULL {
        app_block_current_click(app)
        nav.start(app)
        return
    }
    if page != app->tutorial_step {
        app->manual_scroll = 0
    }
    app->tutorial_step = page
}

manual_screen_close_tutorial :: (app: InbeApp*, mark_seen: int) {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    if practice->close_manual != NULL {
        practice->close_manual(app, mark_seen)
    }
}

manual_screen_draw :: (app: InbeApp*) {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    if practice->draw_manual != NULL {
        practice->draw_manual(app)
    }
}

route manual {
    title "Manual"
    group "Practice"
    page manual
}

manual :: (app: InbeApp*) #ui {
    Screen root: {
    manual_screen_draw(app)
    }
}
