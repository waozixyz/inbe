#import "app.h"
#import "kryon.h"
#import "locale.h"
#import "theme.h"
#import "ui.h"
#import "ui_color.h"
#import "ui_scaling.h"
#import "ui_text.h"

pet :: #import "src/widgets/pet_egg"

pet_screen_draw :: (app: InbeApp*) {
    if app == NULL {
        return
    }

    text := GetLocaleText("pet_gamification_title")
    subtext := GetLocaleText("pet_gamification_subtitle")
    paragraph := (UIParagraph){0}
    reserved_bottom := app_content_bottom_reserved(app)
    content_h := view_height - reserved_bottom
    center_x := view_width / 2
    center_y := 0
    egg_size := 0
    text_w := 0
    text_x := 0
    text_y := 0
    muted := DarkenUIColor(GetThemeText(), 34)

    if content_h < ScaleUIPx(120) {
        content_h = ScaleUIPx(120)
    }
    center_y = content_h / 2 - ScaleUIPx(18)

    egg_size = view_width < view_height ? view_width : view_height
    egg_size = egg_size * 42 / 100
    if egg_size < ScaleUIPx(120) {
        egg_size = ScaleUIPx(120)
    }
    if egg_size > ScaleUIPx(240) {
        egg_size = ScaleUIPx(240)
    }

    pet.draw_egg(app, center_x, center_y, egg_size)
    text_w = view_width - ScaleUIPx(48)
    if text_w > ScaleUIPx(360) {
        text_w = ScaleUIPx(360)
    }
    if text_w < ScaleUIPx(160) {
        text_w = ScaleUIPx(160)
    }
    text_x = center_x - text_w / 2
    text_y = center_y + egg_size / 2 + ScaleUIPx(28)

    paragraph = (UIParagraph){.text = text, .width = text_w, .font = UI_TEXT_16, .line_gap = ScaleUIPx(3), .color = GetThemeText()}
    DrawUIParagraph(paragraph, text_x, &text_y)
    text_y += ScaleUIPx(6)
    paragraph = (UIParagraph){.text = subtext, .width = text_w, .font = UI_TEXT_12, .line_gap = ScaleUIPx(3), .color = muted}
    DrawUIParagraph(paragraph, text_x, &text_y)
}

route pet {
    title "Pet"
    group "App"
    page pet
}

screen pet {
    args InbeApp *app
    pet_screen_draw(app)
}
