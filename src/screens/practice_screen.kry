#import "app.h"
#import "app_nav.h"
#import "app/app_settings.h"
#import "screens/manual_screen.h"
#import "practices/practice_registry.h"
#import "practices/patterns/patterns_practice.h"
#import "storage.h"

#enum {
    PRACTICE_CATEGORY_TAB_H = 40
    PRACTICE_CATEGORY_TOAST_TICKS = 120
    PRACTICE_CONFIG_TAB_LIST = -1
}

PracticeSubscreenLayout :: struct {
    integrated: int
    title_h: int
    scroll_y: int
    scroll_h: int
}

PracticeManualLayout :: struct {
    integrated: int
    title_h: int
    nav_y: int
    nav_h: int
    content_y: int
    content_h: int
}

PracticeLeaveConfigFn :: void (*)(InnerBreeze*) #type

practice_activity_count_for_tab :: (tab: int) -> int {
    unused tab
    return practice_count()
}

practice_activity_for_tab :: (tab: int, index: int) -> int {
    unused tab
    if index < 0 {
        return EXERCISE_WIM_HOF
    }
    if index >= practice_count() {
        return practice_ordered_id(practice_count() - 1)
    }
    return practice_ordered_id(index)
}

practice_screen_subscreen_integrated :: (app: const InnerBreeze*, modal_type: int) -> int {
    return app != NULL && app->breathing.screen == ScreenStart && (int)app->modal.type != modal_type
}

practice_screen_config_layout :: (app: InnerBreeze*, modal_type: int, content_top_gap: int, layout: PracticeSubscreenLayout*) {
    integrated := practice_screen_subscreen_integrated(app, modal_type)
    title_h := integrated ? app_content_top_reserved(app) : GetNodeHeight(NodeTitleBar(0))
    scroll_y := title_h + content_top_gap
    bottom_reserved := integrated ? app_content_bottom_reserved(app) : 0
    scroll_h := view_height - scroll_y - bottom_reserved - (integrated ? Scale(8) : 0)

    if layout == NULL {
        return
    }
    if scroll_h < 0 {
        scroll_h = 0
    }
    *layout = (PracticeSubscreenLayout){integrated, title_h, scroll_y, scroll_h}
}

practice_screen_manual_layout :: (app: InnerBreeze*, modal_type: int, page_count: int, content_top_gap: int, content_bottom_gap: int, min_content_h: int, layout: PracticeManualLayout*) {
    integrated := practice_screen_subscreen_integrated(app, modal_type)
    title_h := app_nav_desktop_rail_enabled(app) ? 0 :
               (integrated ? app_content_top_reserved(app) : GetNodeHeight(NodeTitleBar(0)))
    nav_h := page_count > 1 ? manual_screen_guide_nav_height() : 0
    bottom_reserved := integrated ? app_content_bottom_reserved(app) : 0
    content_y := title_h + content_top_gap
    nav_y := view_height - bottom_reserved - nav_h
    content_h := nav_y - content_y - content_bottom_gap

    if layout == NULL {
        return
    }
    if content_h < min_content_h {
        content_h = min_content_h
    }
    *layout = (PracticeManualLayout){integrated, title_h, nav_y, nav_h, content_y, content_h}
}

practice_screen_handle_config_title :: (app: InnerBreeze*, title: const char*, modal_type: int, leave_config: PracticeLeaveConfigFn) -> int {
    title_h := 0

    if app == NULL {
        return 0
    }
    title_h = practice_screen_subscreen_integrated(app, modal_type) ? app_content_top_reserved(app) : GetNodeHeight(NodeTitleBar(0))
    if !ReturnTitleBar(app->icons[UI_ICON_TYPE_LEFT], title, title_h) {
        return 0
    }
    if app->modal.active && (int)app->modal.type == modal_type {
        app_close_modal(app)
    } else {
        if app->settings_dirty {
            save_settings(app)
        }
        if leave_config != NULL {
            leave_config(app)
        }
        app->settings_scroll = 0
        app->practice_tab = PRACTICE_TAB_PLAY
        app_switch_screen(app, ScreenStart)
    }
    return 1
}

practice_card_banner_bottom_padding :: () -> int #private {
    return Scale(6)
}

practice_card_banner_asset_path :: (app: const InnerBreeze*, exercise: int) -> const char* #private {
    id := practice_clamp_id(exercise)
    dark := app != NULL && ((app->theme_mode == APP_THEME_DARK) ||
        (app->theme_mode != APP_THEME_LIGHT && app->dark_mode != 0))

    if id == EXERCISE_WIM_HOF {
        return dark ? "assets/practices/whm/banner-dark.png" : "assets/practices/whm/banner-light.png"
    }
    if id == EXERCISE_SUN_SALUTATION {
        return dark ? "assets/practices/sunsalutation/banner-dark.png" : "assets/practices/sunsalutation/banner-light.png"
    }
    if id == EXERCISE_MEDITATION {
        return dark ? "assets/practices/meditation/banner-dark.png" : "assets/practices/meditation/banner-light.png"
    }
    if id == EXERCISE_PATTERNS {
        return dark ? "assets/practices/patterns/banner-dark.png" : "assets/practices/patterns/banner-light.png"
    }
    return NULL
}

practice_draw_card_banner :: (asset_path: const char*, dest: Rectangle) {
    if asset_path == NULL || asset_path[0] == '\0' || dest.width <= 0 || dest.height <= 0 {
        return
    }
    Picture((PictureProps){
        .asset_path = asset_path,
        .bounds = dest,
        .tint = WHITE,
        .fit = PICTURE_FIT_COVER
    })
}

practice_next_ordered :: (app: InnerBreeze*, dir: int) -> int {
    if app == NULL {
        return EXERCISE_WIM_HOF
    }
    current := practice_clamp_id(app->exercise_type)
    current_order := practice_ordered_index(app, current)
    total := practice_count()

    if total <= 0 {
        return current
    }
    next_index := (current_order + dir + total * 2) % total
    return practice_ordered_id(next_index)
}

practice_home_count :: (app: const InnerBreeze*) -> int {
    unused app
    return practice_count()
}

practice_ordered_index :: (app: const InnerBreeze*, exercise: int) -> int {
    unused app
    for int i = 0; i < practice_count(); i++ {
        id := practice_ordered_id(i)
        if id == exercise {
            return i
        }
    }
    return 0
}

practice_home_dots_height :: (app: const InnerBreeze*) -> int #private {
    return practice_home_count(app) > 1 ? Scale(32) : 0
}

practice_home_carousel_controls_height :: (app: const InnerBreeze*) -> int #private {
    return practice_home_dots_height(app)
}

practice_select_home_card :: (app: InnerBreeze*, exercise: int) #private {
    route := (AppRoute){0}

    if app == NULL {
        return
    }
    if app->practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    route = app_current_route(app)
    route.screen = ScreenStart
    route.exercise_type = practice_clamp_id(exercise)
    route.practice_tab = PRACTICE_TAB_PLAY
    route.practice_config_tab = 0
    app->manual_scroll = 0
    app->settings_scroll = 0
    app->practice_home_scroll = 0
    app->tutorial_step = 0
    app_switch_route(app, route)
}


practice_home_below_card_height :: (app: const InnerBreeze*, content_w: int) -> int #private {
    practice := practice_get(app != NULL ? app->exercise_type : 0)
    tokens := GetUIStyleTokens()
    gap := Scale(12)
    btn_h := Scale(tokens.touch_target_min + 8)
    height: int = practice_card_banner_bottom_padding() +
              practice_home_carousel_controls_height(app) +
              Scale(10) + btn_h
    if practice_home_actions_share_row(practice, content_w) {
        height += gap + btn_h
    } else {
        if practice != NULL && practice->draw_manual != NULL {
            height += gap + btn_h
        }
        if practice != NULL && practice->draw_config != NULL {
            height += gap + btn_h
        }
    }
    return height + Scale(14)
}

practice_home_card_height :: (app: const InnerBreeze*, y: int, bottom_reserved: int,
                             content_w: int) -> int #private {
    card_h: int = view_height - y - bottom_reserved -
              practice_home_below_card_height(app, content_w)
    tokens := GetUIStyleTokens()
    max_card_h := view_height >= Scale(640)
        ? view_height * 52 / 100
        : view_height * 58 / 100

    if card_h < Scale(240) {
        card_h = Scale(240)
    }
    if card_h < Scale(tokens.touch_target_min * 5) {
        card_h = Scale(tokens.touch_target_min * 5)
    }
    if card_h > max_card_h {
        card_h = max_card_h
    }
    return card_h
}

practice_home_action_gap :: (content_w: int) -> int #private {
    return content_w < Scale(340) ? Scale(8) : Scale(12)
}

practice_home_action_button :: (app: InnerBreeze*, bounds: Rectangle,
                                label: const char*, primary: int) -> int #private {
    mouse := GetScreenToWorld2D(GetMousePosition(), app->camera)
    disabled := app != NULL && app->modal.active
    hover := !disabled && CheckCollisionPointRec(mouse, bounds) &&
             !UIInputCapturesClick(mouse)
    fill := primary ? Fade(GetThemeButton(), 0.72f)
                    : Fade(GetThemeSurface(), 0.66f)
    text_color := primary ? WHITE : Fade(GetThemeText(), 0.88f)
    font := GetFontSize()
    label_w := TextWidth(label, font)
    shadow := bounds

    shadow.y += Scale(3)

    if hover {
        fill = primary ? Fade(GetThemeButtonHover(), 0.78f)
                       : Fade(GetThemeSurface(), 0.82f)
    }

    DrawRectangleRounded(shadow, 0.10f, 12, Fade(BLACK, 0.22f))
    DrawRectangleRounded(bounds, 0.10f, 12, fill)
    Text((TextProps){
        .bounds = {(float)(bounds.x + (bounds.width - label_w) / 2),
                   (float)GetUIControlTextY(label, (int)bounds.y,
                                            (int)bounds.height, font),
                   0, 0},
        .text = label,
        .font = font,
        .color = text_color,
        .wrap = TextWrapNone
    })

    if hover {
        MarkUIClickable()
        if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
            UIConsumeRelease()
            return 1
        }
    }
    return 0
}

practice_home_quiet_action_button :: (bounds: Rectangle, label: const char*) -> int #private {
    return Button((ButtonProps){
        .bounds = bounds,
        .label = label,
        .font = GetFontSize(),
        .id = 7100 + (int)bounds.x,
        .style = ButtonStyleSecondary
    })
}

practice_home_subtitle :: (exercise: int) -> const char* #private {
    unused exercise
    return NULL
}

practice_home_meditation_minutes :: (app: const InnerBreeze*) -> int #private {
    mode := app != NULL ? app->meditation.duration_mode : 1

    if mode == 0 {
        return 5
    }
    if mode == 1 {
        return 15
    }
    if mode == 2 {
        return 30
    }
    if mode == 3 {
        return 60
    }
    if mode == 4 {
        return 120
    }
    return app != NULL ? clampi(app->meditation.custom_minutes, 1, 240) : 15
}

practice_home_metadata :: (app: InnerBreeze*, out: char*, out_size: size_t) #private {
    if out == NULL || out_size == 0 {
        return
    }
    out[0] = '\0'
    if app == NULL {
        return
    }
    id := practice_clamp_id(app->exercise_type)
    if id == EXERCISE_MEDITATION {
        FormatLocaleText(out, out_size, "practice_home_minutes", practice_home_meditation_minutes(app))
    } else if id == EXERCISE_SUN_SALUTATION {
        FormatLocaleText(out, out_size, "practice_home_repetitions", app->sun_salutation.repetitions)
    } else if id == EXERCISE_PATTERNS {
        ratio: [24] char = {0}
        patterns_ratio_text(app, ratio, sizeof(ratio))
        if app->patterns.duration_minutes > 0 {
            FormatLocaleText(out, out_size, "practice_home_patterns_metadata", ratio, app->patterns.duration_minutes)
        } else {
            snprintf(out, out_size, "%s", ratio)
        }
    } else {
        FormatLocaleText(out, out_size, "practice_home_wim_hof_metadata", app->breathing.max_rounds, int_from_count(app->breathing.maxbreaths))
    }
}

practice_home_title_height :: (app: const InnerBreeze*) -> int #private {
    subtitle: const char* = app != NULL ? practice_home_subtitle(app->exercise_type) : NULL
    return subtitle != NULL ? Scale(80) : Scale(58)
}

practice_draw_home_title :: (app: InnerBreeze*, x: int, y: int, w: int) #private {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    title := practice->label_key != NULL ? practice_label(app->exercise_type) : ""
    subtitle := practice_home_subtitle(app->exercise_type)
    metadata: [96] char = {0}
    title_font := 0
    title_w := 0
    metadata_font := 0
    metadata_w := 0

    practice_home_metadata(app, metadata, sizeof(metadata))
    title_font = 28
    while title_font > GetFontSize() && TextWidth(title, title_font) > w {
        title_font--
    }
    title_w = TextWidth(title, title_font)
    Text((TextProps){
        .bounds={(x + (w - title_w) / 2), (GetUIControlTextY(title, y, Scale(34), title_font)), 0, 0},
        .text=(title),
        .font=(title_font),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })
    metadata_font = GetFontSize()
    metadata_w = TextWidth(metadata, metadata_font)
    Text((TextProps){
        .bounds={(x + (w - metadata_w) / 2), (GetUIControlTextY(metadata, y + Scale(34), Scale(18), metadata_font)), 0, 0},
        .text=(metadata),
        .font=(metadata_font),
        .color=(DarkenUIColor(GetThemeText(), 22)),
        .wrap=TextWrapNone
    })
    if subtitle != NULL {
        subtitle_font := GetFontSize()
        subtitle_w := TextWidth(subtitle, subtitle_font)
        Text((TextProps){
            .bounds={(x + (w - subtitle_w) / 2), (GetUIControlTextY(subtitle, y + Scale(56), Scale(18), subtitle_font)), 0, 0},
            .text=(subtitle),
            .font=(subtitle_font),
            .color=(DarkenUIColor(GetThemeText(), 22)),
            .wrap=TextWrapNone
        })
    }
}

practice_home_action_row_widths :: (content_w: int, manual_w: int*, config_w: int*) -> int #private {
    font := GetFontSize()
    pad := Scale(20)
    gap := practice_home_action_gap(content_w)
    manual_min := TextWidth(GetLocaleText("practice_manual_button"), font) + pad * 2
    config_min := TextWidth(GetLocaleText("practice_configure_button"), font) + pad * 2
    half_w := 0
    available_w := 0

    if content_w < manual_min + config_min + gap {
        return 0
    }
    available_w = content_w - gap
    half_w = available_w / 2
    if half_w >= manual_min && available_w - half_w >= config_min {
        *manual_w = half_w
        *config_w = available_w - half_w
        return 1
    }
    *manual_w = manual_min
    *config_w = available_w - *manual_w
    if *config_w < config_min {
        *config_w = config_min
        *manual_w = available_w - *config_w
    }
    return *manual_w >= manual_min && *config_w >= config_min
}

practice_home_actions_share_row :: (practice: const PracticeDefinition*, content_w: int) -> int #private {
    manual_w := 0
    config_w := 0
    return practice != NULL && practice->draw_manual != NULL && practice->draw_config != NULL && practice_home_action_row_widths(content_w, &manual_w, &config_w)
}

practice_draw_desktop_home_title :: (app: InnerBreeze*, x: int, y: int, w: int) #private {
    if app == NULL {
        return
    }

    practice := practice_get(app->exercise_type)
    title := practice != NULL && practice->label_key != NULL
        ? practice_label(app->exercise_type)
        : ""
    metadata: [96] char = {0}
    title_font := 34
    metadata_font := GetFontSize()
    title_w := 0
    metadata_w := 0

    practice_home_metadata(app, metadata, sizeof(metadata))
    while title_font > 24 && TextWidth(title, title_font) > w {
        title_font--
    }
    title_w = TextWidth(title, title_font)
    Text((TextProps){
        .bounds = {(x + (w - title_w) / 2), y, 0, 0},
        .text = title,
        .font = title_font,
        .color = WHITE,
        .wrap = TextWrapNone
    })

    metadata_w = TextWidth(metadata, metadata_font)
    Text((TextProps){
        .bounds = {(x + (w - metadata_w) / 2), y + Scale(42), 0, 0},
        .text = metadata,
        .font = metadata_font,
        .color = Fade(WHITE, 0.88f),
        .wrap = TextWrapNone
    })
}

practice_screen_draw_desktop_home :: (app: InnerBreeze*) -> int #private {
    if app == NULL || !IsUIDesktopMode() {
        return 0
    }

    practice := practice_get(app->exercise_type)
    tokens := GetUIStyleTokens()
    bottom_reserved := app_content_bottom_reserved(app)
    left_reserved := app_content_left_reserved(app)
    content_view_x := left_reserved
    content_view_w := view_width - left_reserved
    if content_view_w < Scale(320) {
        content_view_x = 0
        content_view_w = view_width
    }
    content_w := content_view_w - Scale(80)
    if content_w > Scale(940) {
        content_w = Scale(940)
    }
    if content_w < Scale(520) {
        content_w = content_view_w - Scale(32)
    }
    x := content_view_x + (content_view_w - content_w) / 2
    hero_h := view_height - bottom_reserved
    if hero_h < Scale(340) {
        hero_h = Scale(340)
    }
    hero := (Rectangle){(float)content_view_x, 0, (float)content_view_w, (float)hero_h}
    title_y := hero_h - Scale(226)
    dots_y := hero_h - Scale(140)
    button_y := hero_h - Scale(102)
    button_h := Scale(tokens.touch_target_min + 14)
    action_gap := Scale(14)
    total_w := content_w
    if total_w > Scale(700) {
        total_w = Scale(700)
    }
    if total_w > content_view_w - Scale(32) {
        total_w = content_view_w - Scale(32)
    }
    if total_w < Scale(360) {
        total_w = content_view_w - Scale(24)
    }
    secondary_count := 0
    if practice != NULL && practice->draw_manual != NULL {
        secondary_count += 1
    }
    if practice != NULL && practice->draw_config != NULL {
        secondary_count += 1
    }
    button_count := 1 + secondary_count
    primary_w := (total_w - action_gap * (button_count - 1)) / button_count
    secondary_w := primary_w
    action_x := content_view_x + (content_view_w - total_w) / 2

    app->practice_home_bounds_valid = 1
    app->practice_home_bounds_card = hero
    app->practice_home_bounds_start = (Rectangle){0}
    app->practice_home_bounds_manual = (Rectangle){0}
    app->practice_home_bounds_config = (Rectangle){0}

    swipe := UpdateUISwipe(&app->practice_home_swipe, (UISwipeSpec){
        .bounds = hero,
        .directions = UI_SWIPE_HORIZONTAL,
        .min_distance = (float)Scale(48),
        .axis_bias = 1.4f,
        .max_duration = 1.2f
    })
    if !app->modal.active && (swipe.direction == UI_SWIPE_LEFT || IsKeyPressed(KEY_RIGHT)) {
        practice_select_home_card(app, practice_next_ordered(app, 1))
    } else if !app->modal.active && (swipe.direction == UI_SWIPE_RIGHT || IsKeyPressed(KEY_LEFT)) {
        practice_select_home_card(app, practice_next_ordered(app, -1))
    }

    banner_path := practice_card_banner_asset_path(app, app->exercise_type)
    if banner_path != NULL {
        practice_draw_card_banner(banner_path, hero)
    } else {
        DrawRectangleRec(hero, GetThemeSurface())
    }

    overlay_h := Scale(260)
    overlay_y := hero_h - overlay_h
    DrawRectangleGradientV(content_view_x, overlay_y, content_view_w, overlay_h,
                           Fade(BLACK, 0.0f), Fade(BLACK, 0.62f))
    DrawRectangleGradientV(content_view_x, hero_h - Scale(116), content_view_w,
                           Scale(116), Fade(BLACK, 0.10f),
                           Fade(GetThemeBackground(), 0.92f))

    practice_draw_desktop_home_title(app, x, title_y, content_w)

    current_index := practice_ordered_index(app, app->exercise_type)
    selected_index := CarouselControls((CarouselControlsProps){
        .bounds = {(float)content_view_x, 0, (float)content_view_w, (float)(hero_h - Scale(112))},
        .indicators = {(float)x, (float)dots_y, (float)content_w, Scale(34)},
        .count = practice_home_count(app),
        .selected = current_index,
        .disabled = app->modal.active,
        .id = 7090
    })
    if selected_index >= 0 && selected_index != current_index {
        practice_select_home_card(app, practice_ordered_id(selected_index))
    }

    app->practice_home_bounds_start = (Rectangle){(float)action_x, (float)button_y,
                                                 (float)primary_w, (float)button_h}
    if practice_home_action_button(app, app->practice_home_bounds_start,
                                   GetLocaleText("practice_start_button"), 1) {
        if practice != NULL && practice->start != NULL {
            practice->start(app)
        }
    }
    action_x += primary_w + action_gap

    if practice != NULL && practice->draw_manual != NULL {
        app->practice_home_bounds_manual = (Rectangle){(float)action_x, (float)button_y,
                                                       (float)secondary_w, (float)button_h}
        if practice_home_action_button(app, app->practice_home_bounds_manual,
                                       GetLocaleText("practice_manual_button"), 0) {
            practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
        }
        action_x += secondary_w + action_gap
    }

    if practice != NULL && practice->draw_config != NULL {
        app->practice_home_bounds_config = (Rectangle){(float)action_x, (float)button_y,
                                                       (float)secondary_w, (float)button_h}
        if practice_home_action_button(app, app->practice_home_bounds_config,
                                       GetLocaleText("practice_configure_button"), 0) {
            practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
        }
    }

    return 1
}

practice_home_content_height :: (content_w: int, user_data: void*) -> int #private {
    app := (InnerBreeze*)user_data
    if app == NULL {
        return 0
    }
    y := 0
    y += practice_home_card_height(app, y, app_content_bottom_reserved(app),
                                  content_w)
    y += practice_home_below_card_height(app, content_w)
    return y
}

practice_screen_draw_home :: (app: InnerBreeze*) {
    start(app)
}

practice_activity_label :: (exercise: int) -> const char* {
    return practice_label(exercise)
}

practice_clamp_activity_to_tab :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    app->exercise_type = practice_clamp_id(app->exercise_type)
}

practice_screen_open_tab :: (app: InnerBreeze*, tab: int) {
    route := (AppRoute){0}

    if app == NULL || app->modal.active {
        return
    }
    if tab == PRACTICE_TAB_PLAY {
        route = app_current_route(app)
        if app->practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_PLAY
        route.screen = ScreenStart
        if app->modal.type == UIModalPracticeManual || app->modal.type == UIModalPracticeConfig {
            app_close_modal(app)
        }
        app_switch_route(app, route)
    } else if tab == PRACTICE_TAB_MANUAL {
        route = app_current_route(app)
        if practice_get(app->exercise_type)->draw_manual == NULL {
            return
        }
        if app->practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_MANUAL
        route.screen = ScreenStart
        app->tutorial_step = 0
        app->manual_scroll = 0
        app_switch_route(app, route)
    } else if tab == PRACTICE_TAB_CONFIG {
        route = app_current_route(app)
        if practice_get(app->exercise_type)->draw_config == NULL {
            return
        }
        if app->practice_tab != PRACTICE_TAB_CONFIG {
            reset_settings_preview(app)
            app->settings_scroll = 0
            app->practice_config_tab = 0
        }
        route.practice_tab = PRACTICE_TAB_CONFIG
        route.practice_config_tab = 0
        route.screen = ScreenStart
        app_switch_route(app, route)
    }
}

practice_screen_draw_desktop_tab_bar :: (app: InnerBreeze*, y: int) -> int #private {
    tabs := (Tab[EXERCISE_COUNT]){0}
    values := (int[EXERCISE_COUNT]){0}
    tab_count := 0
    selected_index := 0
    clicked := 0

    if app == NULL {
        return -1
    }
    for int i = 0; i < practice_count(); i++ {
        id := practice_ordered_id(i)
        if id == app->exercise_type {
            selected_index = tab_count
        }
        values[tab_count] = id
        tabs[tab_count] = (Tab){.label = practice_activity_label(id), .icon = (Texture2D){0}, .icon_size = 0, .disabled = app->modal.active}
        tab_count++
    }
    if tab_count <= 0 {
        return -1
    }
    clicked = TabBar((TabBarProps){.bounds = (Rectangle){0, (float)y, (float)view_width, (float)GetNodeHeight(NodeTabBar((TabBarProps){.bounds = (Rectangle){0, 0, 0, 0}}))}, .tabs = tabs, .count = tab_count, .selected_index = selected_index, .min_tab_width = Scale(120), .max_tab_width = Scale(180)})
    return clicked >= 0 && clicked < tab_count ? values[clicked] : -1
}

practice_screen_draw_top_bar :: (app: InnerBreeze*, draw_menu: int) {
    exercise_options := (const char*[EXERCISE_COUNT]){0}
    exercise_values := (int[EXERCISE_COUNT]){0}
    activity_count := 0
    activity_index := 0
    route := (AppRoute){0}

    if app == NULL {
        return
    }
    practice_clamp_activity_to_tab(app)
    for int i = 0; i < practice_count(); i++ {
        id := practice_ordered_id(i)
        if id == app->exercise_type {
            activity_index = activity_count
        }
        exercise_values[activity_count] = id
        exercise_options[activity_count] = practice_activity_label(id)
        activity_count++
    }
    if activity_count <= 0 {
        return
    }
    if draw_menu {
        header_result := ToolbarHeader((ToolbarHeaderProps){.toolbar = (ToolbarProps){.id = 300, .draw_menu = 1, .options = exercise_options, .option_count = activity_count, .selected_index = &activity_index}})
        menu_result: ToolbarResult = header_result.toolbar
        if !app->modal.active && menu_result.selected_menu_item >= 0 {
            route = app_current_route(app)
            if app->practice_tab == PRACTICE_TAB_CONFIG {
                app_leave_practice_config(app)
            }
            route.exercise_type = exercise_values[activity_index]
            route.practice_tab = PRACTICE_TAB_PLAY
            route.practice_config_tab = 0
            route.screen = ScreenStart
            app->manual_scroll = 0
            app->settings_scroll = 0
            app->practice_home_scroll = 0
            app->tutorial_step = 0
            app->practice_config_tab = 0
            app_switch_route(app, route)
        }
        return
    }
    if app_should_use_tab_bar(app) {
        clicked_exercise := practice_screen_draw_desktop_tab_bar(app, 0)
        if clicked_exercise >= 0 && clicked_exercise != app->exercise_type {
            route = app_current_route(app)
            if app->practice_tab == PRACTICE_TAB_CONFIG {
                app_leave_practice_config(app)
            }
            route.exercise_type = clicked_exercise
            route.practice_tab = PRACTICE_TAB_PLAY
            route.practice_config_tab = 0
            route.screen = ScreenStart
            app->manual_scroll = 0
            app->settings_scroll = 0
            app->practice_home_scroll = 0
            app->tutorial_step = 0
            app->practice_config_tab = 0
            app_switch_route(app, route)
        }
    } else {
        ToolbarHeader((ToolbarHeaderProps){.leading_icon = (Texture2D){0}, .toolbar = (ToolbarProps){.id = 300, .height = GetNodeHeight(NodeTabBar((TabBarProps){.bounds = (Rectangle){0, 0, 0, 0}})), .options = app->modal.active ? NULL : exercise_options, .option_count = app->modal.active ? 0 : activity_count, .selected_index = &activity_index, .dropdown_min_width = Scale(160), .dropdown_height = Scale(36), .side_padding = -1}})
    }
    if !app->modal.active {
        app->practice_tab = PRACTICE_TAB_PLAY
    }
}

practice_screen_draw_floating_actions :: (app: InnerBreeze*) {
    icon_size := Scale(22)
    icon_padding := Scale(9)
    button_w := icon_size + icon_padding * 2
    gap := Scale(10)
    margin := Scale(14)
    y := app_content_top_reserved(app) + Scale(10)
    x := view_width - margin

    if app == NULL || app->modal.active || app->breathing.screen != ScreenStart {
        return
    }
    practice := practice_get(app->exercise_type)
    if practice->draw_config != NULL {
        hover := 0
        x -= button_w
        if PaddedIconBtn(0, x, y, icon_size, icon_padding, app->icons[UI_ICON_TYPE_WRENCH], &hover) {
            practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
        }
        x -= gap
    }
    if practice->draw_manual != NULL {
        hover := 0
        x -= button_w
        if PaddedIconBtn(0, x, y, icon_size, icon_padding, app->icons[UI_ICON_TYPE_MANUAL], &hover) {
            practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
        }
    }
}

practice_screen_draw_modal :: (app: InnerBreeze*) {
    if app == NULL || !app->modal.active {
        return
    }
    if app->modal.type != UIModalPracticeManual && app->modal.type != UIModalPracticeConfig && app->modal.type != UIModalEditProgressiveStartSpeed {
        return
    }
    DrawRectangle(0, 0, view_width, view_height, GetThemeBackground())
    if app->modal.type == UIModalEditProgressiveStartSpeed {
        practice := practice_get(app->exercise_type)
        if practice->draw_config != NULL {
            practice->draw_config(app)
        }
        return
    }
    if app->modal.type == UIModalPracticeManual {
        app->practice_tab = PRACTICE_TAB_MANUAL
        manual_screen_draw(app)
    } else {
        practice := practice_get(app->exercise_type)
        app->practice_tab = PRACTICE_TAB_CONFIG
        if practice->draw_config != NULL {
            practice->draw_config(app)
        }
    }
}

practice_screen_dismiss_first_run_guide :: (app: InnerBreeze*) {
    if app == NULL {
        return
    }
    app->tutorial_seen = 1
    app->tutorial_step = 0
    save_settings(app)
    sync_web_storage_critical()
}

practice_screen_first_run_guide_active :: (app: const InnerBreeze*) -> int {
    return app != NULL && !app->tutorial_seen && !app->modal.active && app->exercise_type != EXERCISE_SUN_SALUTATION && app->breathing.screen == ScreenStart && app->main_tab != APP_MAIN_TAB_NONE && !storage_has_sync_account()
}

practice_screen_prepare_first_run_guide :: (app: InnerBreeze*) {
    if !practice_screen_first_run_guide_active(app) {
        return
    }
    app->practice_tab = PRACTICE_TAB_PLAY
}

practice_home_rect_valid :: (rect: Rectangle) -> int #private {
    return rect.width > 0 && rect.height > 0
}

practice_home_action_guide_anchor :: (manual: Rectangle, config: Rectangle) -> Rectangle #private {
    manual_valid := practice_home_rect_valid(manual)
    config_valid := practice_home_rect_valid(config)

    if !manual_valid {
        return config_valid ? config : (Rectangle){0}
    }
    if !config_valid {
        return manual
    }

    left: float = manual.x < config.x ? manual.x : config.x
    top: float = manual.y < config.y ? manual.y : config.y
    right := manual.x + manual.width
    bottom := manual.y + manual.height
    config_right: float = config.x + config.width
    config_bottom: float = config.y + config.height

    if config_right > right {
        right = config_right
    }
    if config_bottom > bottom {
        bottom = config_bottom
    }
    return (Rectangle){left, top, right - left, bottom - top}
}

practice_home_carousel_guide_anchor :: (app: const InnerBreeze*) -> Rectangle #private {
    card := app->practice_home_bounds_card
    anchor_w := Scale(140)
    anchor_h := Scale(34)
    anchor_x := (int)(card.x + (card.width - anchor_w) / 2)
    anchor_y: int

    if IsUIDesktopMode() {
        anchor_y = (int)(card.y + card.height) - Scale(140)
    } else {
        anchor_y = (int)(card.y + card.height) +
                   practice_card_banner_bottom_padding()
    }

    return (Rectangle){
        (float)anchor_x,
        (float)anchor_y,
        (float)anchor_w,
        (float)anchor_h
    }
}

practice_screen_draw_first_run_guide :: (app: InnerBreeze*) {
    steps: [3] UIGuideStep = {0}
    result := (UIGuideResult){0}

    if !practice_screen_first_run_guide_active(app) {
        return
    }
    if !app->practice_home_bounds_valid {
        return
    }
    steps[0] = (UIGuideStep){
        practice_home_carousel_guide_anchor(app),
        GetLocaleText("practice_guide_carousel")
    }
    steps[1] = (UIGuideStep){app->practice_home_bounds_start, GetLocaleText("practice_guide_start")}
    steps[2] = (UIGuideStep){practice_home_action_guide_anchor(app->practice_home_bounds_manual, app->practice_home_bounds_config), GetLocaleText("practice_guide_manual_config")}
    result = GuideOverlay((GuideOverlayProps){.steps = steps, .count = 3, .step = &app->tutorial_step, .view_width = view_width, .view_height = view_height, .reserved_top = app_content_top_reserved(app), .reserved_bottom = app_content_bottom_reserved(app), .max_width = Scale(300), .close_icon = app->icons[UI_ICON_TYPE_X], .back_icon = app->icons[UI_ICON_TYPE_BACKWARD], .next_icon = app->icons[UI_ICON_TYPE_FORWARD], .done_icon = app->icons[UI_ICON_TYPE_CHECK]})
    if result.changed {
        save_settings(app)
        sync_web_storage_critical()
    }
    if result.closed || result.finished {
        practice_screen_dismiss_first_run_guide(app)
    }
}

route start {
    title "Practice"
    group "Practice"
    page start
}

start :: (app: InnerBreeze*) #ui {
    Screen root: {
    guard app == NULL

    practice := (const PracticeDefinition*)NULL
    scroll_y := 0
    scroll_h := 0
    bottom_reserved := 0
    page := (UIScrollPage){0}
    use_scroll := 0
    content_w := 0
    x := 0
    y := 0
    layout_y := 0
    card_w := 0
    card_h := 0
    tokens := GetUIStyleTokens()
    gap := Scale(12)
    btn_h := Scale(tokens.touch_target_min + 8)
    carousel_count := 0
    row_gap := 0
    manual_w := 0
    config_w := 0

    practice_clamp_activity_to_tab(app)
    app->practice_home_bounds_valid = 0
    app->practice_home_bounds_start = (Rectangle){0}
    app->practice_home_bounds_manual = (Rectangle){0}
    app->practice_home_bounds_config = (Rectangle){0}

    if practice_screen_draw_desktop_home(app) {
        return
    }

    bottom_reserved = app_content_bottom_reserved(app)
    scroll_y = 0
    scroll_h = view_height - scroll_y - bottom_reserved
    if scroll_h < 0 {
        scroll_h = 0
    }

    practice = practice_get(app->exercise_type)
    content_w = view_width - Scale(40)
    if content_w > Scale(480) {
        content_w = Scale(480)
    }
    if content_w < Scale(260) {
        content_w = view_width - Scale(16)
    }
    x = (view_width - content_w) / 2
    y = scroll_y
    layout_y = y

    if practice_home_content_height(content_w, app) > scroll_h {
        use_scroll = 1
        page = BeginUIScrollPage((UIScrollPageSpec){.y = scroll_y, .height = scroll_h, .max_content_width = Scale(480), .min_content_width = Scale(260), .scroll_offset = &app->practice_home_scroll, .content_height = practice_home_content_height, .user_data = app})
        content_w = page.content_w
        x = page.content_x
        y = page.content_y
        layout_y = scroll_y
    } else {
        app->practice_home_scroll = 0
    }

    card_w = IsUIDesktopMode() ? content_w : view_width
    card_h = practice_home_card_height(app, layout_y, bottom_reserved, content_w)
    title_h := practice_home_title_height(app) + Scale(10)
    card := (Rectangle){(float)((view_width - card_w) / 2), (float)y,
                         (float)card_w, (float)card_h}
    app->practice_home_bounds_card = card
    app->practice_home_bounds_valid = 1
    swipe := UpdateUISwipe(&app->practice_home_swipe, (UISwipeSpec){
        .bounds = card,
        .directions = UI_SWIPE_HORIZONTAL,
        .min_distance = (float)Scale(48),
        .axis_bias = 1.4f,
        .max_duration = 1.2f
    })
    if !app->modal.active && (swipe.direction == UI_SWIPE_LEFT || IsKeyPressed(KEY_RIGHT)) {
        practice_select_home_card(app, practice_next_ordered(app, 1))
    } else if !app->modal.active && (swipe.direction == UI_SWIPE_RIGHT || IsKeyPressed(KEY_LEFT)) {
        practice_select_home_card(app, practice_next_ordered(app, -1))
    }
    practice = practice_get(app->exercise_type)
    banner_path := practice_card_banner_asset_path(app, app->exercise_type)
    if banner_path != NULL {
        practice_draw_card_banner(banner_path, card)
    } else {
        DrawRectangleRec(card, GetThemeSurface())
    }

    fade_h := Scale(120)
    fade_y := y + card_h - title_h - fade_h
    DrawRectangleGradientV((int)card.x, fade_y, card_w, fade_h,
                           Fade(GetThemeBackground(), 0.0f), GetThemeBackground())
    DrawRectangle((int)card.x, y + card_h - title_h, card_w, title_h,
                  GetThemeBackground())
    practice_draw_home_title(app, x, y + card_h - title_h + Scale(4), content_w)
    current_index := practice_ordered_index(app, app->exercise_type)
    selected_index := CarouselControls((CarouselControlsProps){
        .bounds = {card.x, card.y, card.width, card.height - title_h},
        .indicators = {(float)x, (float)(y + card_h + practice_card_banner_bottom_padding()),
                       (float)content_w, (float)practice_home_carousel_controls_height(app)},
        .count = practice_home_count(app),
        .selected = current_index,
        .disabled = app->modal.active,
        .id = 7090
    })
    if selected_index >= 0 && selected_index != current_index {
        practice_select_home_card(app, practice_ordered_id(selected_index))
    }

    carousel_count = practice_home_count(app)
    y += card_h
    y += practice_card_banner_bottom_padding()
    if carousel_count > 1 {
        y += practice_home_carousel_controls_height(app)
    }
    y += Scale(10)

    app->practice_home_bounds_start = (Rectangle){(float)x, (float)y,
                                                 (float)content_w, (float)btn_h}
    if Button((ButtonProps){
        .bounds = app->practice_home_bounds_start,
        .label = GetLocaleText("practice_start_button"),
        .font = GetFontSize(),
        .style = ButtonStylePrimary,
    }) {
        if practice->start != NULL {
            practice->start(app)
        }
    }
    y += btn_h + gap

    if practice_home_actions_share_row(practice, content_w) {
        row_gap = practice_home_action_gap(content_w)
        practice_home_action_row_widths(content_w, &manual_w, &config_w)
        app->practice_home_bounds_manual = (Rectangle){(float)x, (float)y,
                                                       (float)manual_w, (float)btn_h}
        if practice_home_quiet_action_button(app->practice_home_bounds_manual,
                                              GetLocaleText("practice_manual_button")) {
            practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
        }

        app->practice_home_bounds_config = (Rectangle){(float)(x + manual_w + row_gap), (float)y,
                                                       (float)config_w, (float)btn_h}
        if practice_home_quiet_action_button(app->practice_home_bounds_config,
                                              GetLocaleText("practice_configure_button")) {
            practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
        }
        y += btn_h + gap
    } else {
        if practice->draw_manual != NULL {
            app->practice_home_bounds_manual = (Rectangle){(float)x, (float)y,
                                                           (float)content_w, (float)btn_h}
            if practice_home_quiet_action_button(app->practice_home_bounds_manual,
                                                  GetLocaleText("practice_manual_button")) {
                practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
            }
            y += btn_h + gap
        }
        if practice->draw_config != NULL {
            app->practice_home_bounds_config = (Rectangle){(float)x, (float)y,
                                                           (float)content_w, (float)btn_h}
            if practice_home_quiet_action_button(app->practice_home_bounds_config,
                                                  GetLocaleText("practice_configure_button")) {
                practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
            }
            y += btn_h + gap
        }
    }

    if use_scroll {
        EndUIScrollPage(page)
    }
    }
}
