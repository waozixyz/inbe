ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)

profile_format_size :: (out: char*, out_size: size_t, bytes: long long) #private {
    if bytes >= 1024LL * 1024LL {
        snprintf(out, out_size, "%lld MB",
                    (bytes + 1024LL * 1024LL / 2) / (1024LL * 1024LL))
    } else if bytes >= 1024 {
        snprintf(out, out_size, "%lld KB", (bytes + 1024 / 2) / 1024)
    } else {
        snprintf(out, out_size, "%lld B", bytes)
    }
}

profile_data_content_height :: (content_w: int) -> int #private {
    height := settings_data_content_height(content_w) + Scale(64)

    if sync_account_load(&(SyncAccount){0}) {
        height += Scale(86)
    }

    return height
}

profile_sync_content_height :: (content_w: int) -> int #private {
    return settings_sync_account_config_content_height(content_w)
}

profile_habits_content_height :: (app: InnerBreeze*, content_w: int) -> int #private {
    row_h := content_w < Scale(260) ? Scale(78) : Scale(48)
    count := app != nil ? app->habits.count : 0

    return Scale(16) + (count > 0 ? count * row_h : Scale(24))
}

profile_content_height :: (content_w: int, user_data: void*) -> int {
    app := (InnerBreeze*)user_data

    if app != nil && app->profile_view == PROFILE_VIEW_HABITS {
        return Scale(12) + profile_habits_content_height(app, content_w)
    }
    if app != nil && app->profile_view == PROFILE_VIEW_DATA {
        return Scale(12) + profile_data_content_height(content_w)
    }
    if app != nil && app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT {
        return Scale(12) + profile_sync_content_height(content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_OVERVIEW {
        return Scale(680)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_DATA {
        return Scale(12) + profile_data_content_height(content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_FRIENDS {
        return Scale(12) + profile_social_friends_content_height(app, content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_LEADERBOARD {
        return Scale(12) +
               profile_social_leaderboard_content_height(app, content_w)
    }

    return Scale(12) + profile_sync_content_height(content_w)
}

profile_save_identity :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    save_settings(app)
}

profile_compact_public_id :: (public_id: const char*, out: char*, out_size: size_t) #private {
    len: size_t

    if out == nil || out_size == 0 {
        return
    }
    out[0] = '\0'
    if public_id == nil {
        return
    }
    len = strlen(public_id)
    if len <= 12 {
        snprintf(out, out_size, "%s", public_id)
        return
    }
    snprintf(out, out_size, "%.*s...%.*s", 4, public_id, 4, public_id + len - 4)
}

profile_draw_identity :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    account: SyncAccount = {0}
    account_text: [80] char = {0}
    alias: const char* = nil
    icon_size := Scale(54)
    gap := Scale(12)
    field_x := x + icon_size + gap
    field_w := w - icon_size - gap
    field_h := Scale(36)
    name_commit := 0
    intention_commit := 0
    name_was_focused := app->profile_name_focused
    intention_was_focused := app->profile_intention_focused

    if sync_account_load(&account) {
        alias = storage_get_setting_text("sync_account_alias")
        if alias != nil && alias[0] != '\0' {
            snprintf(account_text, sizeof(account_text), "@%s", alias)
        } else {
            profile_compact_public_id(account.public_id, account_text,
                                      sizeof(account_text))
        }
    } else {
        snprintf(account_text, sizeof(account_text), "%s",
                 GetLocaleText("profile_no_account"))
    }

    if Button((ButtonProps){
        .bounds = {(float)x, (float)(*y + Scale(18)),
                   (float)icon_size, (float)icon_size},
        .icon = app->icons[app->profile_picture_icon],
        .icon_only = 1, .circle = 1,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        app->profile_picture_picker_scroll = 0
        app_open_modal(app, UIModalProfilePicturePicker)
    }

    Text((TextProps){
        .bounds={(field_x), (*y), 0, 0},
        .text=(account_text),
        .wrap=TextWrapNone
    })
    *y += Scale(22)

    Text((TextProps){
        .bounds={(field_x), (*y), 0, 0},
        .text=(GetLocaleText("profile_name_label")),
        .wrap=TextWrapNone
    })
    TextField((TextFieldProps){
        .bounds = {field_x, *y + Scale(18), field_w, field_h},
        .text = app->profile_display_name,
        .text_size = sizeof(app->profile_display_name),
        .cursor_position = &app->profile_name_cursor,
        .focused = &app->profile_name_focused,
        .max_codepoints = 40,
        .focus_id = 813,
        .commit_pressed = &name_commit
    })
    *y += Scale(64)

    Text((TextProps){
        .bounds={(field_x), (*y), 0, 0},
        .text=(GetLocaleText("profile_intention_label")),
        .wrap=TextWrapNone
    })
    TextField((TextFieldProps){
        .bounds = {field_x, *y + Scale(18), field_w, field_h},
        .text = app->profile_intention,
        .text_size = sizeof(app->profile_intention),
        .cursor_position = &app->profile_intention_cursor,
        .focused = &app->profile_intention_focused,
        .max_codepoints = 90,
        .focus_id = 814,
        .commit_pressed = &intention_commit
    })
    *y += Scale(58)

    if name_commit || intention_commit ||
       (name_was_focused && !app->profile_name_focused) ||
       (intention_was_focused && !app->profile_intention_focused) {
        profile_save_identity(app)
    }
}

profile_draw_metric_card :: (x: int, w: int, y: int*, label: const char*,
                             value: const char*) #private {
    h := Scale(58)
    value_w := AppTextWidth(value, AppFontSize())

    DrawRectangleRounded((Rectangle){(float)x, (float)*y, (float)w, (float)h},
                         0.12f, 8, DarkenColor(GetThemeBackground(), 7))
    Text((TextProps){
        .bounds={(x + Scale(12)), (*y + Scale(20)), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    Text((TextProps){
        .bounds={(x + w - value_w - Scale(12)), (*y + Scale(17)), 0, 0},
        .text=(value),
        .wrap=TextWrapNone
    })
    *y += h + Scale(8)
}

profile_open_tab_card :: (app: InnerBreeze*, tab: int) #private {
    if app == nil {
        return
    }
    if app->profile_tab == PROFILE_TAB_OVERVIEW {
        profile_save_identity(app)
    }
    app->profile_view = PROFILE_VIEW_MAIN
    app->profile_tab = clampi(tab, PROFILE_TAB_OVERVIEW,
                              PROFILE_TAB_COUNT - 1)
    app->profile_scroll = 0
    app->sync_server_url_focused = 0
    if tab == PROFILE_TAB_FRIENDS || tab == PROFILE_TAB_LEADERBOARD {
        app->profile_leaderboard_loaded = 0
        app_request_social_refresh(app)
    }
}

profile_draw_hub_section_label :: (x: int, y: int*, label: const char*) #private {
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    *y += Scale(32)
}

profile_draw_hub_stat_card :: (x: int, y: int, w: int, h: int,
                               icon_type: IconType, label: const char*,
                               value: const char*, icon_color: Color) #private {
    icon_box := Scale(34)
    icon_size := Scale(18)
    center_x := x + w / 2
    icon_x := center_x - icon_box / 2
    value_font := Scale(22)
    label_font := AppSmallFontSize()
    value_w := AppTextWidth(value, value_font)
    label_w := AppTextWidth(label, label_font)

    Card((CardProps){
        .bounds={(float)x, (float)y, (float)w, (float)h}
    })
    Circle(center_x, y + Scale(26), icon_box / 2,
           LightenColor(icon_color, 12))
    Icon(0, icon_x + (icon_box - icon_size) / 2,
         y + Scale(26) - icon_size / 2, icon_size, icon_type, WHITE)
    Text((TextProps){
        .bounds={(center_x - label_w / 2), (y + Scale(54)), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    Text((TextProps){
        .bounds={(center_x - value_w / 2), (y + Scale(78)), 0, 0},
        .text=(value),
        .wrap=TextWrapNone
    })
}

profile_draw_hub_route_card :: (app: InnerBreeze*, x: int, y: int*, w: int,
                                h: int, icon_type: IconType, title: const char*,
                                subtitle: const char*, value: const char*,
                                tab: int) #private {
    bounds := (Rectangle){(float)x, (float)*y, (float)w, (float)h}
    icon_box := Scale(40)
    icon_size := Scale(22)
    icon_x := x + Scale(14)
    text_x := icon_x + icon_box + Scale(12)
    arrow := "›"
    arrow_w := AppTextWidth(arrow, Scale(Text24))
    value_w := value != nil ? AppTextWidth(value, AppSmallFontSize()) : 0
    text_w := w - (text_x - x) - Scale(48)

    if value_w > 0 {
        text_w -= value_w + Scale(12)
    }
    if Button((ButtonProps){
        .bounds = bounds,
        .label = "",
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft
        }) {
        profile_open_tab_card(app, tab)
    }
    Circle(icon_x + icon_box / 2, *y + h / 2, icon_box / 2,
           DarkenColor(GetThemeButton(), 12))
    Icon(0, icon_x + (icon_box - icon_size) / 2,
         *y + h / 2 - icon_size / 2, icon_size, icon_type, WHITE)
    profile_draw_fitted_text(title, text_x, *y + Scale(16), text_w,
                             AppFontSize())
    profile_draw_fitted_text(subtitle, text_x, *y + Scale(42), text_w,
                             AppSmallFontSize())
    if value_w > 0 {
        Text((TextProps){
            .bounds={(x + w - Scale(42) - value_w),
                     (*y + h / 2 - Scale(9)), 0, 0},
            .text=(value),
            .wrap=TextWrapNone
        })
    }
    Text((TextProps){
        .bounds={(x + w - Scale(24) - arrow_w / 2),
                 (*y + h / 2 - Scale(18)), 0, 0},
        .text=(arrow),
        .wrap=TextWrapNone
    })
    *y += h + Scale(10)
}

profile_draw_hub_identity :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    account: SyncAccount = {0}
    alias: const char* = nil
    has_account := sync_account_load(&account)
    card_h := Scale(158)
    bounds := (Rectangle){(float)x, (float)*y, (float)w, (float)card_h}
    avatar := Scale(78)
    avatar_x := x + Scale(18)
    avatar_y := *y + Scale(28)
    text_x := avatar_x + avatar + Scale(18)
    title: [96] char = {0}
    subtitle: [160] char = {0}

    subtitle_y := *y + Scale(64)

    if has_account {
        alias = storage_get_setting_text("sync_account_alias")
        if alias != nil && alias[0] != '\0' {
            snprintf(title, sizeof(title), "@%s", alias)
        } else {
            profile_compact_public_id(account.public_id, title,
                                      sizeof(title))
        }
        snprintf(subtitle, sizeof(subtitle), "%s",
                 GetLocaleText("profile_sync_ready_body"))
    } else {
        snprintf(title, sizeof(title), "%s",
                 app->profile_display_name[0] != '\0'
                     ? app->profile_display_name
                     : GetLocaleText("profile_no_account"))
        snprintf(subtitle, sizeof(subtitle), "%s",
                 GetLocaleText("profile_sync_prompt_body"))
    }

    DrawRectangleRounded(bounds, 0.14f, 12, DarkenColor(GetThemeBackground(), 8))
    DrawRectangleGradientV(x, *y, w, card_h,
                           Fade(GetThemeButton(), 0.32f),
                           Fade(GetThemeBackground(), 0.0f))
    DrawRectangleRoundedLinesEx(bounds, 0.14f, 12, 1.0f,
                                DarkenColor(GetThemeButton(), 18))
    if Button((ButtonProps){
        .bounds = {(float)avatar_x, (float)avatar_y,
                   (float)avatar, (float)avatar},
        .icon = app->icons[app->profile_picture_icon],
        .icon_only = 1, .circle = 1,
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        app->profile_picture_picker_scroll = 0
        app_open_modal(app, UIModalProfilePicturePicker)
    }
    profile_draw_fitted_text(title, text_x, *y + Scale(34),
                             w - (text_x - x) - Scale(18),
                             Scale(Text18))
    Paragraph((ParagraphSpec){
        .text = subtitle,
        .width = w - (text_x - x) - Scale(18),
        .font = AppSmallFontSize(),
        .line_gap = Scale(3)
    }, text_x, &subtitle_y)
    if Button((ButtonProps){
        .bounds = {(float)(text_x), (float)(*y + Scale(108)), (float)(w - (text_x - x) - Scale(18)), (float)(Scale(38))},
        .label = GetLocaleText(has_account ? "sync_account_title"
                                               : "sync_create_account_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        profile_open_tab_card(app, PROFILE_TAB_SYNC)
    }
    *y += card_h + Scale(18)
}

profile_draw_overview :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    today := habits_today_index()
    due := 0
    done := 0
    active_days := 0
    practice_sessions := 0
    value: [64] char = {0}
    insight: [160] char = {0}
    friends_value: [64] char = {0}
    storage_value: [64] char = {0}
    loading := app_sync_loading()
    stat_gap := Scale(8)
    stat_w := (w - stat_gap * 2) / 3
    stat_h := Scale(112)
    friend_count := profile_social_friends_count(app)
    pending_count := profile_social_pending_count(app)

    profile_draw_hub_identity(app, x, w, y)
    for int i = 0; i < app->habits.count; i++ {
        if habit_scheduled_day(&app->habits.items[i], today) {
            due++
            if habit_completed_day(&app->habits.items[i], today) {
                done++
            }
        }
    }
    storage_profile_week_stats(today, &active_days, &practice_sessions)

    profile_draw_hub_section_label(x, y, GetLocaleText("profile_progress_title"))
    snprintf(value, sizeof(value), loading ? "…" : "%d/%d", done, due)
    profile_draw_hub_stat_card(x, *y, stat_w, stat_h,
                               ICON_CALENDAR,
                               GetLocaleText("profile_today_short"), value,
                               GetThemeButton())
    if loading {
        snprintf(value, sizeof(value), "…")
    } else {
        snprintf(value, sizeof(value), "%d", active_days)
    }
    profile_draw_hub_stat_card(x + stat_w + stat_gap, *y, stat_w, stat_h,
                               ICON_ACTIVITY,
                               GetLocaleText("profile_active_days_short"),
                               value, GetThemeCircle())
    snprintf(value, sizeof(value), loading ? "…" : "%d", practice_sessions)
    profile_draw_hub_stat_card(x + (stat_w + stat_gap) * 2, *y,
                               w - (stat_w + stat_gap) * 2, stat_h,
                               ICON_STAT,
                               GetLocaleText("profile_sessions_short"),
                               value, GetThemeLink())
    *y += stat_h + Scale(14)

    if loading {
        snprintf(insight, sizeof(insight), "%s…",
                 GetLocaleText("profile_updating_status"))
    } else {
        FormatLocaleText(insight, sizeof(insight), "profile_weekly_insight", active_days)
    }

    profile_draw_hub_route_card(app, x, y, w, Scale(76),
                                ICON_PROFILE,
                                GetLocaleText("profile_friends_title"),
                                insight, nil, PROFILE_TAB_FRIENDS)
    if pending_count > 0 {
        FormatLocaleText(friends_value, sizeof(friends_value),
                         "profile_friends_pending_summary", friend_count,
                         pending_count)
    } else {
        FormatLocaleText(friends_value, sizeof(friends_value),
                         "profile_friends_summary", friend_count)
    }
    profile_draw_hub_route_card(app, x, y, w, Scale(76),
                                ICON_STAT,
                                GetLocaleText("profile_leaderboard_title"),
                                GetLocaleText("profile_leaderboard_preview_body"),
                                GetLocaleText("profile_no_rank_short"),
                                PROFILE_TAB_LEADERBOARD)
    profile_format_size(storage_value, sizeof(storage_value),
                        storage_total_size())
    profile_draw_hub_route_card(app, x, y, w, Scale(68),
                                ICON_SAVE,
                                GetLocaleText("profile_data_management_title"),
                                GetLocaleText("profile_data_management_body"),
                                storage_value, PROFILE_TAB_DATA)
    profile_draw_hub_route_card(app, x, y, w, Scale(68),
                                ICON_GLOBE,
                                GetLocaleText("profile_account_sync_title"),
                                GetLocaleText("profile_account_sync_body"),
                                friends_value, PROFILE_TAB_SYNC)
}

profile_draw_stat_row :: (x: int, w: int, y: int*, label: const char*,
                         value: const char*) #private {
    font := AppFontSize()
    value_w := 0

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    value_w = AppTextWidth(value, font)
    Text((TextProps){
        .bounds={(x + w - value_w), (*y - Scale(2)), 0, 0},
        .text=(value),
        .wrap=TextWrapNone
    })
    *y += Scale(28)
}

profile_draw_data_summary :: (x: int, w: int, y: int*) #private {
    value: [64] char = {0}

    snprintf(value, sizeof(value), "%d", storage_habit_count())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_habits_label"), value)
    snprintf(value, sizeof(value), "%d", storage_session_count())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_sessions_label"), value)
    profile_format_size(value, sizeof(value), storage_total_size())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_storage_label"), value)
}

profile_draw_divider :: (x: int, w: int, y: int) #private {
    DrawLine(x, y, x + w, y, DarkenColor(GetThemeBackground(), 28))
}

profile_tab_title :: (tab: int) -> const char* #private {
    if tab == PROFILE_TAB_OVERVIEW {
        return GetLocaleText("tab_profile")
    }
    if tab == PROFILE_TAB_SYNC {
        return GetLocaleText("profile_sync_tab")
    }
    if tab == PROFILE_TAB_DATA {
        return GetLocaleText("profile_data")
    }
    if tab == PROFILE_TAB_FRIENDS {
        return GetLocaleText("profile_friends_title")
    }
    if tab == PROFILE_TAB_LEADERBOARD {
        return GetLocaleText("profile_leaderboard_title")
    }

    return GetLocaleText("tab_profile")
}

profile_draw_tabs :: (app: InnerBreeze*, y: int, h: int) -> int #private {
    clicked := -1
    tab_w := view_width / PROFILE_TAB_COUNT

    DrawRectangle(0, y, view_width, h, DarkenColor(GetThemeBackground(), 6))
    DrawLine(0, y + h - 1, view_width, y + h - 1,
             DarkenColor(GetThemeBackground(), 24))
    for int i = 0; i < PROFILE_TAB_COUNT; i++ {
        x := i * tab_w
        w := i == PROFILE_TAB_COUNT - 1 ? view_width - x : tab_w
        selected := i == app->profile_tab
        if Button((ButtonProps){
            .bounds = {(float)x, (float)y, (float)w, (float)h},
            .label = profile_tab_title(i),
            .tone = selected ? ButtonToneAccent : ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft, .selected = selected
        }) {
            clicked = i
        }
        if selected {
            line_w := w - Scale(24)
            if line_w < Scale(24) {
                line_w = Scale(24)
            }
            DrawRectangle(x + (w - line_w) / 2, y + h - Scale(2),
                          line_w, Scale(2), GetThemeText())
        }
    }
    return clicked
}

profile_draw_fitted_text :: (text: const char*, x: int, y: int, max_w: int,
                            font: int) #private {
    fitted: [HABIT_NAME_SIZE + 4] char = {0}

    if text == nil || max_w <= 0 {
        return
    }

    text_fit_ellipsis(text, fitted, sizeof(fitted), max_w, font)
    Text((TextProps){
        .bounds={(x), (y), 0, 0},
        .text=(fitted),
        .wrap=TextWrapNone
    })
}

profile_draw_data :: (app: InnerBreeze*, x: int, w: int, y: int*) {
    profile_draw_data_summary(x, w, y)
    settings_data_draw_sync_status(x, w, y)
    *y += Scale(10)
    settings_data_draw_actions(app, x, w, y)
}

profile_draw_habits :: (app: InnerBreeze*, x: int, w: int, y: int*) {
    font := AppFontSize()
    btn_h := Scale(32)
    btn_w := Scale(74)
    gap := Scale(8)
    stack_rows := w < Scale(260)

    *y += Scale(16)

    for int i = 0; i < app->habits.count; i++ {
        row_y := *y


        controls_w := btn_w * 2 + gap
        name_w := stack_rows ? w : w - controls_w - gap

        profile_draw_fitted_text(app->habits.items[i].name, x,
                                    row_y + Scale(7), name_w, font)
        if stack_rows {
            row_y += Scale(36)
        }
        if Button((ButtonProps){
            .bounds = {(float)(stack_rows ? x : x + w - btn_w * 2 - gap), (float)(row_y), (float)(btn_w), (float)(btn_h)},
            .label = GetLocaleText("move_up_button"),
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = i == 0
        }) {
            if habits_move(&app->habits, i, i - 1) {
                app_auto_sync(app)
            }
            return
        }
        if Button((ButtonProps){
            .bounds = {(float)(stack_rows ? x + btn_w + gap : x + w - btn_w), (float)(row_y), (float)(btn_w), (float)(btn_h)},
            .label = GetLocaleText("move_down_button"),
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft,
            .disabled = i == app->habits.count - 1
        }) {
            if habits_move(&app->habits, i, i + 1) {
                app_auto_sync(app)
            }
            return
        }
        *y += stack_rows ? Scale(78) : Scale(46)
        profile_draw_divider(x, w, *y - Scale(6))
    }

    if app->habits.count <= 0 {
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(GetLocaleText("habit_empty_title")),
            .wrap=TextWrapNone
        })
    }
}

profile_screen_draw_remove_friend_modal :: (app: InnerBreeze*) {
    message: [384] char = {0}
    modal_result := 0

    if app == nil || !app->modal.active ||
       app->modal.type != UIModalConfirmRemoveFriend {
        return
    }

    snprintf(message, sizeof(message),
                GetLocaleText("profile_friend_remove_message"),
                app->profile_pending_friend_remove_name[0] != '\0'
                    ? app->profile_pending_friend_remove_name
                    : "this friend")
    actions: [2] ModalAction = {
        {GetLocaleText("cancel_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("delete_button"), ButtonToneDanger, ButtonEmphasisFilled, 0},
    }
    modal_result = Modal((ModalProps){
        .title = GetLocaleText("profile_friend_remove_title"),
        .message = message,
        .actions = actions,
        .action_count = 2
    })
    if modal_result == 1 {
        app->profile_pending_friend_remove_id[0] = '\0'
        app->profile_pending_friend_remove_name[0] = '\0'
        app_close_modal(app)
    } else if modal_result == 2 {
        url: [256] char = {0}

        if profile_social_sync_url(url, sizeof(url)) {
            app_request_friend_remove(app,
                                         app->profile_pending_friend_remove_id)
            settings_screen_set_status_success(
                GetLocaleText("profile_updating_status"), nil)
        } else {
            settings_screen_set_status_error(
                GetLocaleText("sync_server_url_invalid"))
        }
        app->profile_pending_friend_remove_id[0] = '\0'
        app->profile_pending_friend_remove_name[0] = '\0'
        app_close_modal(app)
    }
}

profile_screen_handle_platform_import :: (app: InnerBreeze*) #private {
    #if ANDROID {
        settings_data_handle_android_import(app)
    } #else_if WEB {
        settings_data_handle_web_import(app)
    }
}

profile_screen_draw :: (app: InnerBreeze*) -> int {
    if app == nil {
        return 0
    }

    header_h := AppTitleBarHeight()
    content_y := header_h + Scale(8)
    content_h := view_height - content_y - app_content_bottom_reserved(app)
    content_x := 0
    content_w := 0
    page_content_h := 0
    max_w := Scale(CONTENT_MAX_W)
    y := 0
    title := GetLocaleText("tab_profile")

    profile_screen_handle_platform_import(app)

    if app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT ||
       (app->profile_view == PROFILE_VIEW_MAIN && app->profile_tab == PROFILE_TAB_SYNC) {
        settings_data_register_sync_key_dialogs()
    }

    if app->profile_tab < 0 || app->profile_tab >= PROFILE_TAB_COUNT {
        app->profile_tab = PROFILE_TAB_OVERVIEW
    }
    if app->profile_view == PROFILE_VIEW_DATA {
        title = GetLocaleText("profile_data")
    } else if app->profile_view == PROFILE_VIEW_HABITS {
        title = GetLocaleText("profile_my_habits_title")
    } else if app->profile_view == PROFILE_VIEW_MAIN &&
              app->profile_tab != PROFILE_TAB_OVERVIEW {
        title = profile_tab_title(app->profile_tab)
    }

    if TitleBar((TitleBarProps){.title = title, .height = header_h,
                                .leading_icon = app->icons[ICON_LEFT],
                                .has_leading_action = 1}) {
        app_block_current_click(app)
        if app->profile_view == PROFILE_VIEW_MAIN &&
           app->profile_tab != PROFILE_TAB_OVERVIEW {
            app->profile_tab = PROFILE_TAB_OVERVIEW
            app->profile_scroll = 0
            app->sync_server_url_focused = 0
            return 1
        }
        if app->profile_tab == PROFILE_TAB_OVERVIEW {
            profile_save_identity(app)
        }
        app->profile_scroll = 0
        app->sync_server_url_focused = 0
        if app_return_to_nav_sidebar_if_needed(app) {
            return 1
        }
        app_switch_screen(app, app->main_tab == APP_MAIN_TAB_HABITS ? ScreenHabits : ScreenStart)
        return 1
    }

    if content_h < 0 {
        content_h = 0
    }
    if max_w > view_width - GetPageSidePadding() * 2 {
        max_w = view_width - GetPageSidePadding() * 2
    }
    if max_w < Scale(320) {
        max_w = Scale(320)
    }
    GetCenteredColumn(max_w, GetPageSidePadding(), &content_x, &content_w)
    page_content_h = profile_content_height(content_w, app)
    Scroll page: {
        bounds = (Rectangle){(float)0, (float)content_y, (float)view_width, (float)content_h}
        content_height = page_content_h
        scroll_offset = &app->profile_scroll

        y := (int)page.y + Scale(12)

        if app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT {
            settings_sync_account_draw_config(app, content_x, content_w, &y)
        } else if app->profile_view == PROFILE_VIEW_DATA {
            profile_draw_data(app, content_x, content_w, &y)
        } else if app->profile_view == PROFILE_VIEW_HABITS {
            profile_draw_habits(app, content_x, content_w, &y)
        } else if app->profile_tab == PROFILE_TAB_OVERVIEW {
            profile_draw_overview(app, content_x, content_w, &y)
        } else if app->profile_tab == PROFILE_TAB_DATA {
            profile_draw_data(app, content_x, content_w, &y)
        } else if app->profile_tab == PROFILE_TAB_FRIENDS {
            profile_social_draw_friends(app, content_x, content_w, &y)
        } else if app->profile_tab == PROFILE_TAB_LEADERBOARD {
            profile_social_draw_leaderboard(app, content_x, content_w, &y)
        } else {
            settings_sync_account_draw_config(app, content_x, content_w, &y)
        }
    }

    return 0
}

route profile {
    title "Profile"
    group "App"
    page profile
}

profile :: (app: InnerBreeze*) #ui {
    Screen root: {
    unused profile_screen_draw(app)
    }
}
