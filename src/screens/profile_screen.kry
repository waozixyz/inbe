ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)

profile_format_size :: (out: char*, out_size: size_t, bytes: long long) #private {
    if bytes >= 1024LL * 1024LL {
        snprintf(out, out_size, "%lld MB",
                    (bytes + 1024LL * 1024LL / 2) / (1024LL * 1024LL))
    } else if bytes >= 1024 {
        snprintf(out, out_size, "%lld KB", (bytes + 1024 / 2) / 1024)
    } else {
        snprintf(out, out_size, "%lld B", bytes)
    }
}

profile_data_content_height :: (content_w: int) -> int #private {
    height := settings_data_content_height(content_w) + ScaleUIPx(64)

    if sync_account_load(&(KsyncAccount){0}) {
        height += ScaleUIPx(86)
    }

    return height
}

profile_sync_content_height :: (content_w: int) -> int #private {
    return settings_sync_account_config_content_height(content_w)
}

profile_habits_content_height :: (app: InbeApp*, content_w: int) -> int #private {
    row_h := content_w < ScaleUIPx(260) ? ScaleUIPx(78) : ScaleUIPx(48)
    count := app != nil ? app->habits.count : 0

    return ScaleUIPx(16) + (count > 0 ? count * row_h : ScaleUIPx(24))
}

profile_content_height :: (content_w: int, user_data: void*) -> int {
    app := (InbeApp*)user_data

    if app != nil && app->profile_view == PROFILE_VIEW_HABITS {
        return ScaleUIPx(12) + profile_habits_content_height(app, content_w)
    }
    if app != nil && app->profile_view == PROFILE_VIEW_DATA {
        return ScaleUIPx(12) + profile_data_content_height(content_w)
    }
    if app != nil && app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT {
        return ScaleUIPx(12) + profile_sync_content_height(content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_OVERVIEW {
        return ScaleUIPx(460)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_DATA {
        return ScaleUIPx(12) + profile_data_content_height(content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_FRIENDS {
        return ScaleUIPx(12) + profile_social_friends_content_height(app, content_w)
    }
    if app != nil && app->profile_tab == PROFILE_TAB_LEADERBOARD {
        return ScaleUIPx(12) +
               profile_social_leaderboard_content_height(app, content_w)
    }

    return ScaleUIPx(12) + profile_sync_content_height(content_w)
}

profile_text_style :: () -> TextInputStyle #private {
    border := DarkenUIColor(GetThemeBackground(), 22)
    return (TextInputStyle){
        .background = DarkenUIColor(GetThemeBackground(), 4),
        .border = border,
        .focus_border = border,
        .text = GetThemeText(),
        .cursor = GetThemeText(),
        .radius = 0.12f,
        .padding_x = ScaleUIPx(10)
    }
}

profile_save_identity :: (app: InbeApp*) #private {
    if app == nil {
        return
    }
    save_settings(app)
}

profile_draw_identity :: (app: InbeApp*, x: int, w: int, y: int*) #private {
    account: KsyncAccount = {0}
    account_text: [80] char = {0}
    alias: const char* = nil
    icon_size := ScaleUIPx(54)
    gap := ScaleUIPx(12)
    field_x := x + icon_size + gap
    field_w := w - icon_size - gap
    field_h := ScaleUIPx(36)
    name_commit := 0
    intention_commit := 0
    name_was_focused := app->profile_name_focused
    intention_was_focused := app->profile_intention_focused
    style := profile_text_style()

    if sync_account_load(&account) {
        alias = storage_get_setting_text("sync_account_alias")
        if alias != nil && alias[0] != '\0' {
            snprintf(account_text, sizeof(account_text), "@%s", alias)
        } else {
            snprintf(account_text, sizeof(account_text), "%.12s...",
                     account.public_id)
        }
    } else {
        snprintf(account_text, sizeof(account_text), "%s",
                 GetLocaleText("profile_no_account"))
    }

    if IconButton((IconButtonProps){
        .bounds = {(float)x, (float)(*y + ScaleUIPx(18)),
                   (float)icon_size, (float)icon_size},
        .icon = app->icons[app->profile_picture_icon],
        .icon_size = icon_size - ScaleUIPx(18),
        .icon_padding = ScaleUIPx(9),
        .background = DarkenUIColor(GetThemeBackground(), 7),
        .hover_background = DarkenUIColor(GetThemeBackground(), 14),
        .border = DarkenUIColor(GetThemeBackground(), 22),
        .icon_color = WHITE,
        .radius = 0.5f
    }) {
        app->profile_picture_picker_scroll = 0
        app_open_modal(app, UIModalProfilePicturePicker)
    }

    Text(account_text, field_x, *y, GetUISmallFontSize(),
         DarkenUIColor(GetThemeText(), 20))
    *y += ScaleUIPx(22)

    Text(GetLocaleText("profile_name_label"), field_x, *y,
         GetUISmallFontSize(), DarkenUIColor(GetThemeText(), 35))
    TextField((TextFieldProps){
        .bounds = {field_x, *y + ScaleUIPx(18), field_w, field_h},
        .text = app->profile_display_name,
        .text_size = sizeof(app->profile_display_name),
        .cursor_position = &app->profile_name_cursor,
        .focused = &app->profile_name_focused,
        .max_codepoints = 40,
        .font = GetUIFontSize(),
        .focus_id = 813,
        .style = style,
        .commit_pressed = &name_commit
    })
    *y += ScaleUIPx(64)

    Text(GetLocaleText("profile_intention_label"), field_x, *y,
         GetUISmallFontSize(), DarkenUIColor(GetThemeText(), 35))
    TextField((TextFieldProps){
        .bounds = {field_x, *y + ScaleUIPx(18), field_w, field_h},
        .text = app->profile_intention,
        .text_size = sizeof(app->profile_intention),
        .cursor_position = &app->profile_intention_cursor,
        .focused = &app->profile_intention_focused,
        .max_codepoints = 90,
        .font = GetUIFontSize(),
        .focus_id = 814,
        .style = style,
        .commit_pressed = &intention_commit
    })
    *y += ScaleUIPx(58)

    if name_commit || intention_commit ||
       (name_was_focused && !app->profile_name_focused) ||
       (intention_was_focused && !app->profile_intention_focused) {
        profile_save_identity(app)
    }
}

profile_draw_metric_card :: (x: int, w: int, y: int*, label: const char*,
                             value: const char*) #private {
    h := ScaleUIPx(58)
    value_w := TextWidth(value, GetUIFontSize())

    DrawRectangleRounded((Rectangle){(float)x, (float)*y, (float)w, (float)h},
                         0.12f, 8, DarkenUIColor(GetThemeBackground(), 7))
    Text(label, x + ScaleUIPx(12), *y + ScaleUIPx(20), GetUISmallFontSize(),
         DarkenUIColor(GetThemeText(), 28))
    Text(value, x + w - value_w - ScaleUIPx(12), *y + ScaleUIPx(17),
         GetUIFontSize(), GetThemeText())
    *y += h + ScaleUIPx(8)
}

profile_draw_overview :: (app: InbeApp*, x: int, w: int, y: int*) #private {
    today := habits_today_index()
    due := 0
    done := 0
    active_days := 0
    practice_sessions := 0
    value: [64] char = {0}
    insight: [160] char = {0}
    fitted_insight: [160] char = {0}
    loading := app_sync_loading()

    profile_draw_identity(app, x, w, y)
    *y += ScaleUIPx(8)
    Text(GetLocaleText("profile_progress_title"), x, *y, GetUIFontSize(),
         GetThemeText())
    *y += ScaleUIPx(30)

    for int i = 0; i < app->habits.count; i++ {
        if habit_scheduled_day(&app->habits.items[i], today) {
            due++
            if habit_completed_day(&app->habits.items[i], today) {
                done++
            }
        }
    }
    storage_profile_week_stats(today, &active_days, &practice_sessions)

    snprintf(value, sizeof(value), loading ? "…" : "%d/%d", done, due)
    profile_draw_metric_card(x, w, y, GetLocaleText("profile_today_habits"), value)
    if loading {
        snprintf(value, sizeof(value), "…")
    } else {
        FormatLocaleText(value, sizeof(value), "profile_days_value", active_days)
    }
    profile_draw_metric_card(x, w, y, GetLocaleText("profile_active_days"), value)
    snprintf(value, sizeof(value), loading ? "…" : "%d", practice_sessions)
    profile_draw_metric_card(x, w, y, GetLocaleText("profile_week_practices"), value)

    if loading {
        snprintf(insight, sizeof(insight), "%s…",
                 GetLocaleText("profile_updating_status"))
    } else {
        FormatLocaleText(insight, sizeof(insight), "profile_weekly_insight", active_days)
    }
    inbe_text_fit_ellipsis(insight, fitted_insight, sizeof(fitted_insight),
                          w - ScaleUIPx(24), GetUISmallFontSize())
    Text(fitted_insight, x + ScaleUIPx(12), *y + ScaleUIPx(10),
         GetUISmallFontSize(), GetThemeText())
    *y += ScaleUIPx(54)

}

profile_draw_stat_row :: (x: int, w: int, y: int*, label: const char*,
                         value: const char*) #private {
    font := GetUIFontSize()
    small_font := GetUISmallFontSize()
    value_w := 0

    Text(label, x, *y, small_font, DarkenUIColor(GetThemeText(), 35))
    value_w = TextWidth(value, font)
    Text(value, x + w - value_w, *y - ScaleUIPx(2), font,
                  GetThemeText())
    *y += ScaleUIPx(28)
}

profile_draw_data_summary :: (x: int, w: int, y: int*) #private {
    value: [64] char = {0}

    snprintf(value, sizeof(value), "%d", storage_habit_count())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_habits_label"), value)
    snprintf(value, sizeof(value), "%d", storage_session_count())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_sessions_label"), value)
    profile_format_size(value, sizeof(value), storage_total_size())
    profile_draw_stat_row(x, w, y, GetLocaleText("profile_storage_label"), value)
}

profile_draw_divider :: (x: int, w: int, y: int) #private {
    DrawLine(x, y, x + w, y, DarkenUIColor(GetThemeBackground(), 28))
}

profile_tab_title :: (tab: int) -> const char* #private {
    if tab == PROFILE_TAB_OVERVIEW {
        return GetLocaleText("tab_profile")
    }
    if tab == PROFILE_TAB_SYNC {
        return GetLocaleText("profile_sync_tab")
    }
    if tab == PROFILE_TAB_DATA {
        return GetLocaleText("profile_data")
    }
    if tab == PROFILE_TAB_FRIENDS {
        return GetLocaleText("profile_friends_title")
    }
    if tab == PROFILE_TAB_LEADERBOARD {
        return GetLocaleText("profile_leaderboard_title")
    }

    return GetLocaleText("tab_profile")
}

profile_draw_tabs :: (app: InbeApp*, y: int, h: int) -> int #private {
    clicked := -1
    tab_w := view_width / PROFILE_TAB_COUNT

    DrawRectangle(0, y, view_width, h, DarkenUIColor(GetThemeBackground(), 6))
    DrawLine(0, y + h - 1, view_width, y + h - 1,
             DarkenUIColor(GetThemeBackground(), 24))
    for int i = 0; i < PROFILE_TAB_COUNT; i++ {
        x := i * tab_w
        w := i == PROFILE_TAB_COUNT - 1 ? view_width - x : tab_w
        selected := i == app->profile_tab
        if OverlayButton((OverlayButtonProps){
            .bounds = {(float)x, (float)y, (float)w, (float)h},
            .label = profile_tab_title(i),
            .font = GetUISmallFontSize(),
            .background = selected ? DarkenUIColor(GetThemeBackground(), 13)
                                   : BLANK,
            .hover_background = DarkenUIColor(GetThemeBackground(), 10),
            .border = BLANK,
            .hover_border = BLANK,
            .text = GetThemeText()
        }) {
            clicked = i
        }
        if selected {
            line_w := w - ScaleUIPx(24)
            if line_w < ScaleUIPx(24) {
                line_w = ScaleUIPx(24)
            }
            DrawRectangle(x + (w - line_w) / 2, y + h - ScaleUIPx(2),
                          line_w, ScaleUIPx(2), GetThemeText())
        }
    }
    return clicked
}

profile_draw_fitted_text :: (text: const char*, x: int, y: int, max_w: int,
                            font: int, color: Color) #private {
    fitted: [INBE_HABIT_NAME_SIZE + 4] char = {0}

    if text == nil || max_w <= 0 {
        return
    }

    inbe_text_fit_ellipsis(text, fitted, sizeof(fitted), max_w, font)
    Text(fitted, x, y, font, color)
}

profile_draw_data :: (app: InbeApp*, x: int, w: int, y: int*) {
    profile_draw_data_summary(x, w, y)
    settings_data_draw_sync_status(x, w, y)
    *y += ScaleUIPx(10)
    settings_data_draw_actions(app, x, w, y)
}

profile_draw_habits :: (app: InbeApp*, x: int, w: int, y: int*) {
    font := GetUIFontSize()
    small := GetUISmallFontSize()
    btn_h := ScaleUIPx(32)
    btn_w := ScaleUIPx(74)
    gap := ScaleUIPx(8)
    stack_rows := w < ScaleUIPx(260)

    *y += ScaleUIPx(16)

    for int i = 0; i < app->habits.count; i++ {
        row_y := *y
        up_hover := 0
        down_hover := 0
        controls_w := btn_w * 2 + gap
        name_w := stack_rows ? w : w - controls_w - gap

        profile_draw_fitted_text(app->habits.items[i].name, x,
                                    row_y + ScaleUIPx(7), name_w, font,
                                    GetThemeText())
        if stack_rows {
            row_y += ScaleUIPx(36)
        }
        if StyledButton(stack_rows ? x : x + w - btn_w * 2 - gap,
                               row_y, btn_w, btn_h,
                               GetLocaleText("move_up_button"),
                               ButtonStyleSecondary, i == 0,
                               &up_hover) {
            if habits_move(&app->habits, i, i - 1) {
                app_auto_sync(app)
            }
            return
        }
        if StyledButton(stack_rows ? x + btn_w + gap : x + w - btn_w,
                               row_y, btn_w, btn_h,
                               GetLocaleText("move_down_button"),
                               ButtonStyleSecondary,
                               i == app->habits.count - 1, &down_hover) {
            if habits_move(&app->habits, i, i + 1) {
                app_auto_sync(app)
            }
            return
        }
        *y += stack_rows ? ScaleUIPx(78) : ScaleUIPx(46)
        profile_draw_divider(x, w, *y - ScaleUIPx(6))
    }

    if app->habits.count <= 0 {
        Text(GetLocaleText("habit_empty_title"), x, *y, small,
                      DarkenUIColor(GetThemeText(), 35))
    }
}

profile_screen_draw_remove_friend_modal :: (app: InbeApp*) {
    message: [384] char = {0}
    modal_result := 0

    if app == nil || !app->modal.active ||
       app->modal.type != UIModalConfirmRemoveFriend {
        return
    }

    snprintf(message, sizeof(message),
                GetLocaleText("profile_friend_remove_message"),
                app->profile_pending_friend_remove_name[0] != '\0'
                    ? app->profile_pending_friend_remove_name
                    : "this friend")
    modal_result = Modal(GetLocaleText("profile_friend_remove_title"),
                               message,
                               GetLocaleText("cancel_button"),
                               GetLocaleText("delete_button"))
    if modal_result == 1 {
        app->profile_pending_friend_remove_id[0] = '\0'
        app->profile_pending_friend_remove_name[0] = '\0'
        app_close_modal(app)
    } else if modal_result == 2 {
        url: [256] char = {0}

        if profile_social_sync_url(url, sizeof(url)) {
            app_request_friend_remove(app,
                                         app->profile_pending_friend_remove_id)
            settings_screen_set_status_success(
                GetLocaleText("profile_updating_status"), nil)
        } else {
            settings_screen_set_status_error(
                GetLocaleText("sync_server_url_invalid"))
        }
        app->profile_pending_friend_remove_id[0] = '\0'
        app->profile_pending_friend_remove_name[0] = '\0'
        app_close_modal(app)
    }
}

profile_screen_draw :: (app: InbeApp*) -> int {
    if app == nil {
        return 0
    }

    header_h := UIGetNodeHeight(UINodeTitleBar(0))
    tab_h := UIGetNodeHeight(UINodeTabBar((TabBarProps){0}))
    content_y := header_h + (app->profile_view == PROFILE_VIEW_MAIN ? tab_h : 0) +
                 ScaleUIPx(8)
    content_h := view_height - content_y - app_content_bottom_reserved(app)
    page := (UIScrollPage){0}
    y := 0
    title := GetLocaleText("tab_profile")

    #if ANDROID {
        settings_data_handle_android_import(app)
    } #else_if WEB {
        settings_data_handle_web_import(app)
    }

    if app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT ||
       (app->profile_view == PROFILE_VIEW_MAIN && app->profile_tab == PROFILE_TAB_SYNC) {
        settings_data_register_sync_key_dialogs()
    }

    if app->profile_tab < 0 || app->profile_tab >= PROFILE_TAB_COUNT {
        app->profile_tab = PROFILE_TAB_OVERVIEW
    }
    if app->profile_view == PROFILE_VIEW_DATA {
        title = GetLocaleText("profile_data")
    } else if app->profile_view == PROFILE_VIEW_HABITS {
        title = GetLocaleText("profile_my_habits_title")
    }

    if app_draw_close_title_bar(app, title, header_h) {
        if app->profile_tab == PROFILE_TAB_OVERVIEW {
            profile_save_identity(app)
        }
        app->profile_scroll = 0
        app->sync_server_url_focused = 0
        if app_return_to_nav_sidebar_if_needed(app) {
            return 1
        }
        app_switch_screen(app, app->main_tab == APP_MAIN_TAB_HABITS ? InbeScreenHabits : InbeScreenStart)
        return 1
    }

    if content_h < 0 {
        content_h = 0
    }
    if app->profile_view == PROFILE_VIEW_MAIN {
        clicked_tab := profile_draw_tabs(app, header_h, tab_h)
        if clicked_tab >= 0 && clicked_tab < PROFILE_TAB_COUNT &&
           clicked_tab != app->profile_tab {
            if app->profile_tab == PROFILE_TAB_OVERVIEW {
                profile_save_identity(app)
            }
            app->profile_tab = clicked_tab
            app->profile_scroll = 0
            if clicked_tab == PROFILE_TAB_FRIENDS ||
               clicked_tab == PROFILE_TAB_LEADERBOARD {
                app->profile_leaderboard_loaded = 0
                app_request_social_refresh(app)
            }
        }
    }
    page = BeginUIScrollPage((UIScrollPageSpec){
        .y = content_y,
        .height = content_h,
        .max_content_width = ScaleUIPx(CONTENT_MAX_W),
        .min_content_width = ScaleUIPx(320),
        .scroll_offset = &app->profile_scroll,
        .content_height = profile_content_height,
        .user_data = app
    })
    y = page.content_y + ScaleUIPx(12)

    if app->profile_view == PROFILE_VIEW_SYNC_ACCOUNT {
        settings_sync_account_draw_config(app, page.content_x, page.content_w, &y)
    } else if app->profile_view == PROFILE_VIEW_DATA {
        profile_draw_data(app, page.content_x, page.content_w, &y)
    } else if app->profile_view == PROFILE_VIEW_HABITS {
        profile_draw_habits(app, page.content_x, page.content_w, &y)
    } else if app->profile_tab == PROFILE_TAB_OVERVIEW {
        profile_draw_overview(app, page.content_x, page.content_w, &y)
    } else if app->profile_tab == PROFILE_TAB_DATA {
        profile_draw_data(app, page.content_x, page.content_w, &y)
    } else if app->profile_tab == PROFILE_TAB_FRIENDS {
        profile_social_draw_friends(app, page.content_x, page.content_w, &y)
    } else if app->profile_tab == PROFILE_TAB_LEADERBOARD {
        profile_social_draw_leaderboard(app, page.content_x, page.content_w, &y)
    } else {
        settings_sync_account_draw_config(app, page.content_x, page.content_w, &y)
    }
    EndUIScrollPage(page)
    SetUIDropdownClipTop(content_y)
    SetUIDropdownClipBottom(view_height - app_content_bottom_reserved(app))
    SetUIDropdownClipTop(0)
    SetUIDropdownClipBottom(0)
    if app->profile_view == PROFILE_VIEW_MAIN && (app->profile_tab == PROFILE_TAB_LEADERBOARD || app->profile_tab == PROFILE_TAB_FRIENDS) {
        SetUIDropdownClipTop(content_y)
        SetUIDropdownClipBottom(view_height - app_content_bottom_reserved(app))
        SetUIDropdownClipTop(0)
        SetUIDropdownClipBottom(0)
    }

    return 0
}

route profile {
    title "Profile"
    group "App"
    page profile
}

profile :: (app: InbeApp*) #ui {
    Screen root: {
    unused profile_screen_draw(app)
    }
}
