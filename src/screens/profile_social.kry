#module "profile_social"

#import "app.h"
#import "locale.h"
#import "theme.h"
#import "ui.h"
#import "src/screens/settings/settings_screen.h"
#import "storage.h"
#import "sync_account.h"
#import "sync_client.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "time.h"

#enum {
    PROFILE_LEADERBOARD_STREAK = 0
    PROFILE_LEADERBOARD_AVG_HOLD
    PROFILE_LEADERBOARD_METRIC_COUNT
}

ProfileLeaderboardDrawRow :: struct {
    user_id: [80] char
    alias: [48] char
    value: [48] char
    sort_value: double
}

static sync_server_url_key: const char* = "sync_server_url"

text_style :: () -> UITextInputStyle #private {
    return (UITextInputStyle){
        .background = DarkenUIColor(GetThemeBackground(), 6),
        .border = DarkenUIColor(GetThemeBackground(), 34),
        .focus_border = GetThemeButton(),
        .text = GetThemeText(),
        .cursor = GetThemeText(),
        .radius = 0.0f,
        .padding_x = ScaleUIPx(10)
    }
}

friend_filter :: (codepoint: int, user_data: void*) -> int #private {
    unused user_data
    return codepoint > 32 && codepoint < 127
}

sync_url :: (out: char*, out_size: size_t) -> int {
    saved := storage_get_setting_text(sync_server_url_key)

    if saved == nil || saved[0] == '\0' {
        return 0
    }
    return sync_client_normalize_url(saved, out, out_size)
}

practice_id :: (index: int) -> const char* #private {
    if index == EXERCISE_MEDITATION {
        return "meditation"
    }
    if index == EXERCISE_SUN_SALUTATION {
        return "sun_salutation"
    }
    return "whm"
}

practice_label :: (index: int) -> const char* #private {
    if index == EXERCISE_MEDITATION {
        return GetLocaleText("exercise_meditation")
    }
    if index == EXERCISE_SUN_SALUTATION {
        return GetLocaleText("exercise_sun_salutation")
    }
    return GetLocaleText("exercise_wim_hof")
}

metric_id_for_practice :: (practice: int, metric: int) -> const char* #private {
    if metric != PROFILE_LEADERBOARD_AVG_HOLD {
        return "streak"
    }
    if practice == EXERCISE_MEDITATION {
        return "avg_time"
    }
    return "avg_hold"
}

metric_count :: (practice: int) -> int #private {
    return practice == EXERCISE_SUN_SALUTATION
               ? 1
               : PROFILE_LEADERBOARD_METRIC_COUNT
}

format_leaderboard_time :: (seconds: long, out: char*, out_size: size_t) #private {
    if out == nil || out_size == 0 {
        return
    }
    if seconds < 0 {
        seconds = 0
    }
    snprintf(out, out_size, "%ld:%02ld",
                seconds / 3600, (seconds % 3600) / 60)
}

metric_label :: (practice: int, metric: int) -> const char* #private {
    if metric != PROFILE_LEADERBOARD_AVG_HOLD {
        return GetLocaleText("profile_metric_streak")
    }
    return practice == EXERCISE_MEDITATION
               ? GetLocaleText("profile_metric_avg_time")
               : GetLocaleText("profile_metric_avg_hold")
}

cache_key :: (out: char*, out_size: size_t, practice: int, metric: int) #private {
    if out == nil || out_size == 0 {
        return
    }
    snprintf(out, out_size, "leaderboard.inbe.%s.%s",
                practice_id(practice),
                metric_id_for_practice(practice, metric))
}

load_friends_cache :: (app: InbeApp*) {
    if app == nil {
        return
    }
    if !storage_get_social_cache_json("friends.requests",
                                      app->profile_friend_requests_json,
                                      sizeof(app->profile_friend_requests_json)) {
        snprintf(app->profile_friend_requests_json,
                    sizeof(app->profile_friend_requests_json),
                    "{\"incoming\":[],\"outgoing\":[]}")
    }
    if !storage_get_social_cache_json("friends.list",
                                      app->profile_friends_json,
                                      sizeof(app->profile_friends_json)) {
        snprintf(app->profile_friends_json,
                    sizeof(app->profile_friends_json),
                    "{\"friends\":[]}")
    }
    app->profile_friends_loaded = 1
}

load_leaderboard_cache :: (app: InbeApp*) {
    key: [96] char = {0}

    if app == nil {
        return
    }
    cache_key(key, sizeof(key),
                 app->profile_leaderboard_practice,
                 app->profile_leaderboard_metric)
    if !storage_get_social_cache_json(key,
                                      app->profile_leaderboard_json,
                                      sizeof(app->profile_leaderboard_json)) {
        snprintf(app->profile_leaderboard_json,
                    sizeof(app->profile_leaderboard_json),
                    "{\"rows\":[]}")
    }
    app->profile_leaderboard_loaded = 1
}

json_array_count :: (json: const char*, array_key: const char*) -> int #private {
    path: [48] char = {0}

    if array_key == nil || array_key[0] == '\0' {
        return 0
    }
    if snprintf(path, sizeof(path), "$.%s", array_key) >= (int)sizeof(path) {
        return 0
    }
    return storage_json_array_count_path(json, path)
}

friends_count :: (app: InbeApp*) -> int {
    if app != nil && !app->profile_friends_loaded {
        load_friends_cache(app)
    }
    return json_array_count(app != nil ? app->profile_friends_json : "",
                            "friends")
}

pending_count :: (app: InbeApp*) -> int {
    if app != nil && !app->profile_friends_loaded {
        load_friends_cache(app)
    }
    return json_array_count(app != nil ? app->profile_friend_requests_json : "",
                            "incoming")
}

public_id_short :: (out: char*, out_size: size_t, user_id: const char*) #private {
    if out == nil || out_size == 0 {
        return
    }
    if user_id == nil || user_id[0] == '\0' {
        snprintf(out, out_size, "----")
    } else {
        snprintf(out, out_size, "%.*s", 4, user_id)
    }
}

display_name :: (out: char*, out_size: size_t, alias: const char*,
                user_id: const char*) #private {
    short_id: [8] char = {0}

    if out == nil || out_size == 0 {
        return
    }
    if alias != nil && alias[0] != '\0' {
        snprintf(out, out_size, "@%s", alias)
    } else if user_id != nil && user_id[0] != '\0' {
        public_id_short(short_id, sizeof(short_id), user_id)
        snprintf(out, out_size, "%s...", short_id)
    } else {
        snprintf(out, out_size, "----...")
    }
}

prompt_remove_friend :: (app: InbeApp*, friend_user_id: const char*,
                        friend_name: const char*) #private {
    if app == nil || friend_user_id == nil || friend_user_id[0] == '\0' {
        return
    }
    snprintf(app->profile_pending_friend_remove_id,
                sizeof(app->profile_pending_friend_remove_id),
                "%s", friend_user_id)
    snprintf(app->profile_pending_friend_remove_name,
                sizeof(app->profile_pending_friend_remove_name),
                "%s",
                friend_name != nil && friend_name[0] != '\0'
                    ? friend_name
                    : friend_user_id)
    app_open_modal(app, UIModalConfirmRemoveFriend)
}

draw_json_people :: (json: const char*, array_key: const char*,
                    x: int, w: int, y: int*, with_actions: int,
                    app: InbeApp*) #private {
    array_path: [48] char = {0}
    count := 0
    font := GetUIFontSize()
    small := GetUISmallFontSize()
    with_remove := !with_actions && strcmp(array_key, "friends") == 0
    with_cancel := !with_actions && strcmp(array_key, "outgoing") == 0

    if snprintf(array_path, sizeof(array_path), "$.%s", array_key) >=
       (int)sizeof(array_path) {
        DrawUIText(GetLocaleText("profile_none_label"), x, *y, small,
                      DarkenUIColor(GetThemeText(), 35))
        *y += ScaleUIPx(24)
        return
    }

    count = storage_json_array_count_path(json, array_path)
    if count <= 0 {
        DrawUIText(GetLocaleText("profile_none_label"), x, *y, small,
                      DarkenUIColor(GetThemeText(), 35))
        *y += ScaleUIPx(24)
        return
    }

    for int rows = 0; rows < count; rows++ {
        id: [80] char = {0}
        alias: [48] char = {0}
        display_id: [80] char = {0}
        title: [96] char = {0}
        url: [256] char = {0}
        row_h := with_actions ? ScaleUIPx(42) : ScaleUIPx(30)
        hover_accept := 0
        hover_decline := 0
        hover_remove := 0
        hover_cancel := 0

        if !storage_json_array_object_text(json, array_path, rows, "id",
                                           id, sizeof(id)) {
            storage_json_array_object_text(json, array_path, rows,
                                              "user_id_hash", id, sizeof(id))
        }
        if id[0] == '\0' {
            continue
        }

        if strcmp(array_key, "incoming") == 0 {
            storage_json_array_object_text(json, array_path, rows,
                                              "requester_alias", alias,
                                              sizeof(alias))
            storage_json_array_object_text(json, array_path, rows,
                                              "requester_user_id_hash",
                                              display_id, sizeof(display_id))
        } else if strcmp(array_key, "outgoing") == 0 {
            storage_json_array_object_text(json, array_path, rows,
                                              "target_alias", alias,
                                              sizeof(alias))
            storage_json_array_object_text(json, array_path, rows,
                                              "target_user_id_hash",
                                              display_id, sizeof(display_id))
        } else {
            storage_json_array_object_text(json, array_path, rows,
                                              "alias", alias, sizeof(alias))
            storage_json_array_object_text(json, array_path, rows,
                                              "user_id_hash", display_id,
                                              sizeof(display_id))
        }

        if alias[0] == '\0' {
            storage_json_array_object_text(json, array_path, rows,
                                              "alias", alias, sizeof(alias))
        }
        if display_id[0] == '\0' {
            snprintf(display_id, sizeof(display_id), "%s", id)
        }

        display_name(title, sizeof(title), alias, display_id)
        DrawUIText(title, x, *y, font, GetThemeText())

        if with_remove {
            icon_size := ScaleUIPx(18)
            icon_padding := ScaleUIPx(6)
            button_w := icon_size + icon_padding * 2

            if DrawUIPaddedIconBtn(x + w - button_w, *y - ScaleUIPx(6),
                                   icon_size, icon_padding,
                                   app->icons[UI_ICON_TYPE_TRASH],
                                   &hover_remove) {
                prompt_remove_friend(app, display_id, title)
            }
        } else if with_cancel {
            icon_size := ScaleUIPx(18)
            icon_padding := ScaleUIPx(6)
            button_w := icon_size + icon_padding * 2

            if DrawUIPaddedIconBtn(x + w - button_w, *y - ScaleUIPx(6),
                                   icon_size, icon_padding,
                                   app->icons[UI_ICON_TYPE_TRASH],
                                   &hover_cancel) &&
               sync_url(url, sizeof(url)) {
                app_request_friend_decline(app, id)
                settings_screen_set_status_success(
                    GetLocaleText("profile_updating_status"), nil)
            }
        }

        if with_actions {
            btn_w := (w - ScaleUIPx(8)) / 2

            if DrawUIGenericButton(x, *y + ScaleUIPx(22), btn_w,
                                   ScaleUIPx(30),
                                   GetLocaleText("profile_friend_accept_button"),
                                   UI_BUTTON_STYLE_PRIMARY, 0,
                                   &hover_accept) &&
               sync_url(url, sizeof(url)) {
                app_request_friend_accept(app, id)
                settings_screen_set_status_success(
                    GetLocaleText("profile_updating_status"), nil)
            }
            if DrawUIGenericButton(x + btn_w + ScaleUIPx(8),
                                   *y + ScaleUIPx(22), btn_w, ScaleUIPx(30),
                                   GetLocaleText("profile_friend_decline_button"),
                                   UI_BUTTON_STYLE_SECONDARY, 0,
                                   &hover_decline) &&
               sync_url(url, sizeof(url)) {
                app_request_friend_decline(app, id)
                settings_screen_set_status_success(
                    GetLocaleText("profile_updating_status"), nil)
            }
        }

        *y += row_h
    }
}

draw_friends :: (app: InbeApp*, x: int, w: int, y: int*) {
    font := GetUIFontSize()
    btn_h := ScaleUIPx(34)
    hover_add := 0
    commit := 0
    url: [256] char = {0}
    incoming_count := 0
    outgoing_count := 0

    if app == nil {
        return
    }
    if !app->profile_friends_loaded {
        load_friends_cache(app)
    }

    incoming_count = json_array_count(app->profile_friend_requests_json,
                                      "incoming")
    outgoing_count = json_array_count(app->profile_friend_requests_json,
                                      "outgoing")

    *y += ScaleUIPx(16)
    DrawUIText(GetLocaleText("profile_friends_title"), x, *y, font,
                  GetThemeText())
    *y += ScaleUIPx(30)

    DrawUITextField((UITextField){
        .bounds = {x, *y, w, ScaleUIPx(38)},
        .text = app->profile_friend_input,
        .text_size = sizeof(app->profile_friend_input),
        .cursor_position = &app->profile_friend_input_cursor,
        .focused = &app->profile_friend_input_focused,
        .max_codepoints = 79,
        .font = GetUIFontSize(),
        .focus_id = 810,
        .style = profile_social_text_style(),
        .filter = profile_social_friend_filter,
        .commit_pressed = &commit
    })
    *y += ScaleUIPx(46)

    if (DrawUIGenericButton(x, *y, w, btn_h,
                            GetLocaleText("profile_add_friend_button"),
                            UI_BUTTON_STYLE_PRIMARY,
                            app->profile_friend_input[0] == '\0',
                            &hover_add) || commit) &&
       app->profile_friend_input[0] != '\0' {
        if sync_url(url, sizeof(url)) {
            target: [80] char = {0}

            if sync_client_normalize_friend_target(app->profile_friend_input,
                                                   target, sizeof(target)) {
                app_request_friend_send(app, target)
                settings_screen_set_status_success(
                    GetLocaleText("profile_updating_status"), nil)
                load_friends_cache(app)
                app->profile_friend_input[0] = '\0'
                app->profile_friend_input_cursor = 0
            } else {
                settings_screen_set_status_error(
                    GetLocaleText("profile_friend_invalid"))
            }
        } else {
            settings_screen_set_status_error(
                GetLocaleText("sync_server_url_invalid"))
        }
    }
    *y += btn_h + ScaleUIPx(22)

    if incoming_count > 0 {
        DrawUIText(GetLocaleText("profile_incoming_title"), x, *y, font,
                      GetThemeText())
        *y += ScaleUIPx(28)
        draw_json_people(app->profile_friend_requests_json, "incoming",
                            x, w, y, 1, app)
        *y += ScaleUIPx(16)
    }

    DrawUIText(GetLocaleText("profile_friends_title"), x, *y, font,
                  GetThemeText())
    *y += ScaleUIPx(28)
    draw_json_people(app->profile_friends_json, "friends", x, w, y, 0, app)

    if outgoing_count > 0 {
        *y += ScaleUIPx(16)
        DrawUIText(GetLocaleText("profile_outgoing_title"), x, *y, font,
                      GetThemeText())
        *y += ScaleUIPx(28)
        draw_json_people(app->profile_friend_requests_json, "outgoing",
                            x, w, y, 0, app)
    }
}

friends_content_height :: (app: InbeApp*, content_w: int) -> int {
    h := ScaleUIPx(16) + ScaleUIPx(30) + ScaleUIPx(46) +
         ScaleUIPx(34) + ScaleUIPx(22)
    incoming_count := 0
    outgoing_count := 0
    friends := 0

    unused content_w
    if app == nil {
        return h
    }

    incoming_count = json_array_count(app->profile_friend_requests_json,
                                      "incoming")
    outgoing_count = json_array_count(app->profile_friend_requests_json,
                                      "outgoing")
    friends = json_array_count(app->profile_friends_json, "friends")

    if incoming_count > 0 {
        h += ScaleUIPx(28) +
             incoming_count * ScaleUIPx(42) +
             ScaleUIPx(16)
    }
    h += ScaleUIPx(28) +
         (friends > 0 ? friends * ScaleUIPx(30) : ScaleUIPx(24))
    if outgoing_count > 0 {
        h += ScaleUIPx(16) + ScaleUIPx(28) +
             outgoing_count * ScaleUIPx(30)
    }
    return h + ScaleUIPx(16)
}

draw_leaderboard_value :: (x: int, w: int, y: int, value: const char*,
                          font: int) #private {
    rank_w := MeasureUIText(value, font)

    DrawUIText(value, x + w - rank_w, y, font, GetThemeText())
}

leaderboard_zero_value :: (app: InbeApp*, out: char*, out_size: size_t) #private {
    if out == nil || out_size == 0 {
        return
    }
    if app != nil &&
       app->profile_leaderboard_practice == EXERCISE_MEDITATION &&
       app->profile_leaderboard_metric == PROFILE_LEADERBOARD_AVG_HOLD {
        format_leaderboard_time(0, out, out_size)
        return
    }
    snprintf(out, out_size, "0")
}

today_index :: () -> int #private {
    now: time_t = time(nil)
    tm_value := localtime(&now)

    if tm_value == nil {
        return 0
    }
    return (tm_value->tm_year + 1900) * 10000 +
           (tm_value->tm_mon + 1) * 100 + tm_value->tm_mday
}

local_leaderboard_value :: (app: InbeApp*, out: char*,
                           out_size: size_t) -> double #private {
    streak := 0
    avg: long = 0

    if out == nil || out_size == 0 {
        return 0.0
    }
    out[0] = '\0'
    if app == nil {
        return 0.0
    }

    storage_profile_activity_stats(app->profile_leaderboard_practice,
                                      today_index(), &streak, &avg)

    if app->profile_leaderboard_metric != PROFILE_LEADERBOARD_AVG_HOLD {
        snprintf(out, out_size, "%ld", (long)streak)
        return (double)streak
    }
    if app->profile_leaderboard_practice == EXERCISE_MEDITATION {
        format_leaderboard_time(avg, out, out_size)
        return (double)avg
    }

    snprintf(out, out_size, "%ld", avg)
    return (double)avg
}

row_seen :: (rows: const ProfileLeaderboardDrawRow*, count: int,
            user_id: const char*) -> int #private {
    if user_id == nil || user_id[0] == '\0' {
        return 1
    }
    for int i = 0; i < count; i++ {
        if strcmp(rows[i].user_id, user_id) == 0 {
            return 1
        }
    }
    return 0
}

row_compare :: (left_ptr: const void*, right_ptr: const void*) -> int #private {
    left := (const ProfileLeaderboardDrawRow*)left_ptr
    right := (const ProfileLeaderboardDrawRow*)right_ptr
    left_name := left->alias[0] != '\0' ? left->alias : left->user_id
    right_name := right->alias[0] != '\0' ? right->alias : right->user_id

    if left->sort_value < right->sort_value {
        return 1
    }
    if left->sort_value > right->sort_value {
        return -1
    }
    return strcmp(left_name, right_name)
}

draw_leaderboard_rows :: (app: InbeApp*, json: const char*,
                         x: int, w: int, y: int*) #private {
    rows := 0
    cache_rows := 0
    friend_rows := 0
    font := GetUIFontSize()
    small := GetUISmallFontSize()
    draw_rows: [24] ProfileLeaderboardDrawRow = {0}
    account: InbeSyncAccount
    has_account := sync_account_load(&account) && account.public_id[0] != '\0'
    self_seen := 0
    self_value: [48] char = {0}
    self_sort_value := local_leaderboard_value(app, self_value,
                                               sizeof(self_value))

    cache_rows = storage_json_array_count_path(json, "$.rows")
    for int i = 0; i < cache_rows && rows < 24; i++ {
        alias: [48] char = {0}
        user_id: [80] char = {0}
        value: [48] char = {0}
        label: [48] char = {0}
        number: double = 0.0

        if !storage_json_array_object_text(json, "$.rows", i,
                                           "user_id_hash", user_id,
                                           sizeof(user_id)) {
            continue
        }
        storage_json_array_object_text(json, "$.rows", i, "alias",
                                          alias, sizeof(alias))
        storage_json_array_object_text(json, "$.rows", i, "label",
                                          label, sizeof(label))
        number = storage_json_array_object_number(json, "$.rows", i, "value")

        if has_account && strcmp(user_id, account.public_id) == 0 {
            snprintf(value, sizeof(value), "%s", self_value)
            number = self_sort_value
            self_seen = 1
        } else if app != nil &&
                  app->profile_leaderboard_practice == EXERCISE_MEDITATION &&
                  app->profile_leaderboard_metric == PROFILE_LEADERBOARD_AVG_HOLD &&
                  label[0] != '\0' {
            snprintf(value, sizeof(value), "%s", label)
        } else {
            snprintf(value, sizeof(value), "%.0f", number)
        }

        snprintf(draw_rows[rows].user_id,
                    sizeof(draw_rows[rows].user_id), "%s", user_id)
        snprintf(draw_rows[rows].alias,
                    sizeof(draw_rows[rows].alias), "%s", alias)
        snprintf(draw_rows[rows].value,
                    sizeof(draw_rows[rows].value), "%s", value)
        draw_rows[rows].sort_value = number
        rows++
    }

    if has_account && !self_seen && rows < 24 {
        alias_text := storage_get_setting_text("sync_account_alias")

        snprintf(draw_rows[rows].user_id,
                    sizeof(draw_rows[rows].user_id), "%s",
                    account.public_id)
        snprintf(draw_rows[rows].alias,
                    sizeof(draw_rows[rows].alias), "%s",
                    alias_text != nil ? alias_text : "")
        snprintf(draw_rows[rows].value,
                    sizeof(draw_rows[rows].value), "%s", self_value)
        draw_rows[rows].sort_value = self_sort_value
        rows++
    }

    friend_rows = storage_json_array_count_path(app != nil
                                                    ? app->profile_friends_json
                                                    : "",
                                                "$.friends")
    for int i = 0; i < friend_rows && rows < 24; i++ {
        alias: [48] char = {0}
        user_id: [80] char = {0}

        if !storage_json_array_object_text(app != nil
                                               ? app->profile_friends_json
                                               : "",
                                           "$.friends", i, "user_id_hash",
                                           user_id, sizeof(user_id)) {
            continue
        }
        if row_seen(draw_rows, rows, user_id) {
            continue
        }
        storage_json_array_object_text(app != nil
                                              ? app->profile_friends_json
                                              : "",
                                          "$.friends", i, "alias", alias,
                                          sizeof(alias))
        snprintf(draw_rows[rows].user_id,
                    sizeof(draw_rows[rows].user_id), "%s", user_id)
        snprintf(draw_rows[rows].alias,
                    sizeof(draw_rows[rows].alias), "%s", alias)
        leaderboard_zero_value(app, draw_rows[rows].value,
                                  sizeof(draw_rows[rows].value))
        draw_rows[rows].sort_value = 0.0
        rows++
    }

    qsort(draw_rows, (size_t)rows, sizeof(draw_rows[0]),
             profile_social_row_compare)
    for int i = 0; i < rows && i < 12; i++ {
        display: [96] char = {0}
        name: [128] char = {0}

        display_name(display, sizeof(display),
                        draw_rows[i].alias, draw_rows[i].user_id)
        snprintf(name, sizeof(name), "%d. %s", i + 1, display)
        DrawUIText(name, x, *y, font, GetThemeText())
        draw_leaderboard_value(x, w, *y, draw_rows[i].value, font)
        *y += ScaleUIPx(30)
    }

    if rows == 0 {
        DrawUIText(GetLocaleText("profile_no_leaderboard_data"),
                      x, *y, small, DarkenUIColor(GetThemeText(), 35))
        *y += ScaleUIPx(24)
    }
}

leaderboard_row_count :: (app: InbeApp*, json: const char*) -> int #private {
    draw_rows: [24] ProfileLeaderboardDrawRow = {0}
    account: InbeSyncAccount
    has_account := sync_account_load(&account) && account.public_id[0] != '\0'
    self_seen := 0
    rows := 0
    cache_rows := storage_json_array_count_path(json, "$.rows")
    friend_rows := 0

    for int i = 0; i < cache_rows && rows < 24; i++ {
        user_id: [80] char = {0}

        if !storage_json_array_object_text(json, "$.rows", i,
                                           "user_id_hash", user_id,
                                           sizeof(user_id)) {
            continue
        }
        if has_account && strcmp(user_id, account.public_id) == 0 {
            self_seen = 1
        }
        snprintf(draw_rows[rows].user_id,
                    sizeof(draw_rows[rows].user_id), "%s", user_id)
        draw_rows[rows].alias[0] = '\0'
        rows++
    }

    if has_account && !self_seen && rows < 24 {
        snprintf(draw_rows[rows].user_id,
                    sizeof(draw_rows[rows].user_id), "%s",
                    account.public_id)
        rows++
    }

    friend_rows = storage_json_array_count_path(app != nil
                                                    ? app->profile_friends_json
                                                    : "",
                                                "$.friends")
    for int i = 0; i < friend_rows && rows < 24; i++ {
        user_id: [80] char = {0}

        if !storage_json_array_object_text(app != nil
                                               ? app->profile_friends_json
                                               : "",
                                           "$.friends", i, "user_id_hash",
                                           user_id, sizeof(user_id)) {
            continue
        }
        if !row_seen(draw_rows, rows, user_id) {
            snprintf(draw_rows[rows].user_id,
                        sizeof(draw_rows[rows].user_id), "%s", user_id)
            rows++
        }
    }

    return rows > 12 ? 12 : rows
}

leaderboard_content_height :: (app: InbeApp*, content_w: int) -> int {
    rows := 0

    unused content_w
    if app == nil {
        return ScaleUIPx(160)
    }

    rows = leaderboard_row_count(app, app->profile_leaderboard_json)
    return ScaleUIPx(16) + ScaleUIPx(22) + ScaleUIPx(46) +
           ScaleUIPx(34) + ScaleUIPx(10) +
           ScaleUIPx(22) +
           (rows > 0 ? rows * ScaleUIPx(30) : ScaleUIPx(24)) +
           ScaleUIPx(16)
}

refresh_leaderboard :: (app: InbeApp*) #private {
    if app == nil {
        return
    }
    load_leaderboard_cache(app)
    app_request_social_refresh(app)
    settings_screen_set_status_success(
        GetLocaleText("profile_updating_status"), nil)
}

refresh_cache :: (app: InbeApp*) {
    if app == nil {
        return
    }
    load_friends_cache(app)
    load_leaderboard_cache(app)
    app_request_social_refresh(app)
    settings_screen_set_status_success(
        GetLocaleText("profile_updating_status"), nil)
}

draw_choice_row :: (app: InbeApp*, x: int, w: int, y: int*, value: int*,
                   labels: const char* const*, count: int) #private {
    gap := ScaleUIPx(8)
    btn_h := ScaleUIPx(34)
    btn_w := 0

    if count <= 0 {
        return
    }
    btn_w = (w - gap * (count - 1)) / count
    for int i = 0; i < count; i++ {
        hover := 0
        bx := x + i * (btn_w + gap)
        bw := i == count - 1 ? x + w - bx : btn_w
        selected := *value == i

        if DrawUIGenericButton(bx, *y, bw, btn_h, labels[i],
                               selected ? UI_BUTTON_STYLE_TAB_SELECTED
                                        : UI_BUTTON_STYLE_TAB,
                               0, &hover) && !selected {
            *value = i
            load_leaderboard_cache(app)
        }
    }
    *y += btn_h + ScaleUIPx(10)
}

draw_leaderboard :: (app: InbeApp*, x: int, w: int, y: int*) {
    practice_options: [EXERCISE_COUNT] const char* = {0}
    metric_options: [PROFILE_LEADERBOARD_METRIC_COUNT] const char* = {0}
    current_metric_count := 0
    before_practice := 0
    before_metric := 0

    if app == nil {
        return
    }

    for int i = 0; i < EXERCISE_COUNT; i++ {
        practice_options[i] = practice_label(i)
    }

    if app->profile_leaderboard_practice < 0 ||
       app->profile_leaderboard_practice >= EXERCISE_COUNT {
        app->profile_leaderboard_practice = EXERCISE_WIM_HOF
    }
    if app->profile_leaderboard_metric < 0 ||
       app->profile_leaderboard_metric >= PROFILE_LEADERBOARD_METRIC_COUNT {
        app->profile_leaderboard_metric = PROFILE_LEADERBOARD_STREAK
    }

    current_metric_count = metric_count(app->profile_leaderboard_practice)
    if app->profile_leaderboard_metric >= current_metric_count {
        app->profile_leaderboard_metric = PROFILE_LEADERBOARD_STREAK
    }
    if !app->profile_leaderboard_loaded {
        load_leaderboard_cache(app)
    }

    metric_options[PROFILE_LEADERBOARD_STREAK] =
        metric_label(app->profile_leaderboard_practice,
                     PROFILE_LEADERBOARD_STREAK)
    metric_options[PROFILE_LEADERBOARD_AVG_HOLD] =
        metric_label(app->profile_leaderboard_practice,
                     PROFILE_LEADERBOARD_AVG_HOLD)

    *y += ScaleUIPx(16)
    DrawUIText(GetLocaleText("profile_practice_label"), x, *y,
                  GetUISmallFontSize(), DarkenUIColor(GetThemeText(), 35))
    *y += ScaleUIPx(22)

    before_practice = app->profile_leaderboard_practice
    DrawUIDropdownButton(811, x, *y, w, ScaleUIPx(36),
                            practice_options, EXERCISE_COUNT,
                            &app->profile_leaderboard_practice)
    if app->profile_leaderboard_practice != before_practice {
        current_metric_count = metric_count(app->profile_leaderboard_practice)
        if app->profile_leaderboard_metric >= current_metric_count {
            app->profile_leaderboard_metric = PROFILE_LEADERBOARD_STREAK
        }
        metric_options[PROFILE_LEADERBOARD_STREAK] =
            metric_label(app->profile_leaderboard_practice,
                         PROFILE_LEADERBOARD_STREAK)
        metric_options[PROFILE_LEADERBOARD_AVG_HOLD] =
            metric_label(app->profile_leaderboard_practice,
                         PROFILE_LEADERBOARD_AVG_HOLD)
        refresh_leaderboard(app)
    }

    *y += ScaleUIPx(46)
    before_metric = app->profile_leaderboard_metric
    draw_choice_row(app, x, w, y, &app->profile_leaderboard_metric,
                       metric_options, current_metric_count)
    if app->profile_leaderboard_metric != before_metric {
        refresh_leaderboard(app)
    }

    *y += ScaleUIPx(22)
    if !app->profile_friends_loaded {
        load_friends_cache(app)
    }
    draw_leaderboard_rows(app, app->profile_leaderboard_json, x, w, y)
}
