#import "kry_uri.h" #private
#import "app.h"
#import "stdio.h"
#import "version.h"
#import "app_update_check.h"

about_link_icon_columns :: (content_w: int) -> int #private {
    link_count := 3
    icon_size := Scale(32)
    icon_padding := Scale(4)
    icon_spacing := Scale(20)
    icon_btn_w := icon_size + icon_padding * 2
    max_columns := link_count
    min_columns := content_w >= Scale(240) ? 3 : 2

    for int columns = max_columns; columns >= min_columns; columns-- {
        total_w := icon_btn_w * columns + icon_spacing * (columns - 1)
        if total_w <= content_w {
            return columns
        }
    }
    return min_columns
}

about_link_icons_height :: (content_w: int) -> int #private {
    link_count := 3
    icon_size := Scale(32)
    icon_padding := Scale(4)
    row_spacing := Scale(16)
    icon_btn_w := icon_size + icon_padding * 2
    columns := about_link_icon_columns(content_w)
    rows := (link_count + columns - 1) / columns

    return rows * icon_btn_w + (rows - 1) * row_spacing
}

settings_about_content_height :: (content_w: int) -> int {
    description := (ParagraphSpec){
        .text = GetLocaleText("about_text"),
        .width = content_w,
        .font = AppFontSize(),
        .line_gap = Scale(4)
    }
    update_row := update_available() != 0 ? Scale(72) : 0

    return Scale(248) + update_row +
           AppParagraphHeight(description.text, description.width,
                              description.font, description.line_gap) +
           about_link_icons_height(content_w)
}

ABOUT_SOCIAL_DISCORD :: 0
ABOUT_SOCIAL_TELEGRAM :: 1
ABOUT_SOCIAL_GITHUB :: 2

about_draw_social_mark :: (kind: int, x: int, y: int, size: int) #private {
    cx := x + size / 2
    cy := y + size / 2
    tint := GetThemeIcon()
    shade := DarkenColor(tint, 72)

    if kind == ABOUT_SOCIAL_TELEGRAM {
        Triangle(x + size * 27 / 32, y + size * 5 / 32,
                 x + size * 5 / 32, y + size * 15 / 32,
                 x + size * 13 / 32, y + size * 26 / 32,
                 tint)
        Triangle(x + size * 12 / 32, y + size * 20 / 32,
                 x + size * 16 / 32, y + size * 17 / 32,
                 x + size * 13 / 32, y + size * 26 / 32,
                 shade)
        Line(x + size * 5 / 32, y + size * 15 / 32,
             x + size * 27 / 32, y + size * 5 / 32,
             LightenColor(tint, 26))
    } else if kind == ABOUT_SOCIAL_GITHUB {
        Circle(cx, cy, size * 10 / 32, tint)
        Triangle(x + size * 7 / 32, y + size * 11 / 32,
                 x + size * 10 / 32, y + size * 4 / 32,
                 x + size * 14 / 32, y + size * 10 / 32,
                 tint)
        Triangle(x + size * 25 / 32, y + size * 11 / 32,
                 x + size * 22 / 32, y + size * 4 / 32,
                 x + size * 18 / 32, y + size * 10 / 32,
                 tint)
        Circle(x + size * 12 / 32, y + size * 16 / 32, Scale(1), shade)
        Circle(x + size * 20 / 32, y + size * 16 / 32, Scale(1), shade)
        Box((Rectangle){(float)(cx - size * 3 / 32), (float)(cy + size * 8 / 32),
                        (float)(size * 6 / 32), (float)(size * 7 / 32)},
            tint, BLANK)
    } else {
        Box((Rectangle){(float)(x + size * 5 / 32), (float)(y + size * 10 / 32),
                        (float)(size * 22 / 32), (float)(size * 13 / 32)},
            tint, BLANK)
        Circle(x + size * 10 / 32, y + size * 10 / 32, size * 4 / 32, tint)
        Circle(x + size * 22 / 32, y + size * 10 / 32, size * 4 / 32, tint)
        Circle(x + size * 12 / 32, y + size * 16 / 32, Scale(1), shade)
        Circle(x + size * 20 / 32, y + size * 16 / 32, Scale(1), shade)
        Line(x + size * 11 / 32, y + size * 20 / 32,
             x + size * 21 / 32, y + size * 20 / 32,
             LightenColor(tint, 18))
    }
}

about_draw_link_icons :: (app: InnerBreeze*, content_x: int, content_w: int, y: int*) #private {
    link_count := 3
    icon_size := Scale(32)
    icon_padding := Scale(4)
    icon_spacing := Scale(20)
    icon_btn_w := icon_size + icon_padding * 2
    columns := about_link_icon_columns(content_w)
    grid_w := icon_btn_w * columns + icon_spacing * (columns - 1)
    links_start_x := content_x + (content_w - grid_w) / 2
    row_spacing := Scale(16)
    urls: [3] const char* = {
        "https://discord.com/invite/JbGZ4yENDt",
        "https://t.me/lotusinbe",
        "https://github.com/waozixyz/breathing",
    }

    for int i = 0; i < link_count; i++ {
        col := i % columns
        row := i / columns
        button_x := links_start_x + col * (icon_btn_w + icon_spacing)
        button_y := *y + row * (icon_btn_w + row_spacing)
        if Button((ButtonProps){
            .bounds = {(float)button_x, (float)button_y,
                       (float)icon_btn_w, (float)icon_btn_w},
            .id = 18100 + i,
            .icon_only = 1,
            .tone = ButtonToneNeutral,
            .emphasis = ButtonEmphasisSoft
        }) {
            OpenURI(urls[i])
        }
        about_draw_social_mark(i, button_x + icon_padding,
                               button_y + icon_padding, icon_size)
    }
    *y += about_link_icons_height(content_w)
}

about_draw_donate_button :: (app: InnerBreeze*, content_x: int, content_w: int, y: int*) #private {

    button_h := Scale(38)
    button_w := Scale(220)

    if button_w > content_w {
        button_w = content_w
    }

    if Button((ButtonProps){
        .bounds = {(float)(content_x + (content_w - button_w) / 2), (float)(*y), (float)(button_w), (float)(button_h)},
        .label = GetLocaleText("donation_reminder_donate_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        app_open_modal(app, UIModalAboutDonation)
    }
    *y += button_h
}

settings_about_draw :: (app: InnerBreeze*, x: int, w: int, y: int*) {
    version_text: [32] char = {0}
    title_font := AppTitleFontSize(GetLocaleText("app_title"), w)
    font := AppFontSize()
    logo_size := Scale(56)
    text_w := 0
    description := (ParagraphSpec){0}

    *y += Scale(16)
    Icon(0, x + (w - logo_size) / 2, *y, logo_size,
         ICON_PROJ_WAO, WHITE)
    *y += logo_size + Scale(12)

    text_w = AppTextWidth(GetLocaleText("app_title"), title_font)
    Text((TextProps){
        .bounds={(x + (w - text_w) / 2), (*y), 0, 0},
        .text=(GetLocaleText("app_title")),
        .wrap=TextWrapNone
    })
    *y += Scale(34)

    snprintf(version_text, sizeof(version_text), "v%s", APP_VERSION_STRING)
    text_w = AppTextWidth(version_text, font)
    Text((TextProps){
        .bounds={(x + (w - text_w) / 2), (*y), 0, 0},
        .text=(version_text),
        .wrap=TextWrapNone
    })
    *y += Scale(28)

    if update_available() != 0 {
        if update_can_self_update() != 0 {
            /* Self-service channels (AppImage, Windows portable): a row that
             * walks check -> download -> verified -> restart. */
            Text((TextProps){
                .bounds={(x), (*y), 0, 0},
                .text=(update_row_text()),
                .wrap=TextWrapNone
            })
            *y += Scale(26)
            if update_is_downloading() != 0 {
                fraction := update_download_fraction()
                progress: int = fraction >= 0.0 ?
                    (int)(fraction * 100.0 + 0.5) : -1
                progress_text: [40] char = {0}
                if progress >= 0 {
                    snprintf(progress_text, sizeof(progress_text), "%s %d%%",
                             GetLocaleText("update_downloading"), progress)
                } else {
                    snprintf(progress_text, sizeof(progress_text), "%s",
                             GetLocaleText("update_downloading"))
                }
                Text((TextProps){
                    .bounds={(x), (*y), 0, 0},
                    .text=(progress_text),
                    .wrap=TextWrapNone
                })
                *y += Scale(22)
            } else {
                if Button((ButtonProps){
                    .id = 18420,
                    .bounds = {(float)x, (float)*y,
                               (float)w, (float)Scale(36)},
                    .label = update_action_label(),
                    .tone = ButtonToneNeutral,
                    .emphasis = ButtonEmphasisSoft,
                    .full_width = 1
                }) {
                    update_row_action()
                }
                *y += Scale(36)
            }
            error_text := update_error_text()
            if error_text[0] != '\0' {
                Text((TextProps){
                    .bounds={(x), (*y), 0, 0},
                    .text=(error_text),
                    .wrap=TextWrapNone
                })
                *y += Scale(20)
            }
        } else {
            /* System-managed or source installs: link out to the release. */
            update_text := update_row_text()
            update_w := AppTextWidth(update_text, font)
            Link((LinkProps){
                .bounds = {(float)(x + (w - update_w) / 2), (float)*y,
                           (float)update_w, (float)Scale(24)},
                .text = update_text,
                .link = update_download_url(),
                .focus_id = 18421
            })
            *y += Scale(30)
        }
        *y += Scale(8)
    }

    description = (ParagraphSpec){
        .text = GetLocaleText("about_text"),
        .width = w,
        .font = font,
        .line_gap = Scale(4)
    }
    Paragraph(description, x, y)
    *y += Scale(18)

    about_draw_link_icons(app, x, w, y)
    *y += Scale(18)
    about_draw_donate_button(app, x, w, y)
    *y += Scale(32)
}
