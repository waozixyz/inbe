#import "app.h"
#import "app/app_settings.h"
#import "breaks/app_breaks.h"
#import "storage/break_stats.h"
#import "src/screens/settings/settings_ui.h"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB

settings_breaks_slider_h :: () -> int #private {
    return Scale(66)
}

settings_breaks_timer_row_h :: (label: const char*, w: int) -> int #private {
    row := settings_ui_toggle_row_height(label, w)
    return row
}

settings_breaks_content_height :: (app: InbeApp*, content_w: int) -> int {
    unused app
    label_w := content_w > 0 ? content_w : Scale(240)
    height := Scale(120)

    height += settings_ui_toggle_row_height(GetLocaleText("settings_breaks_enabled"), label_w)
    height += Scale(76)
    height += settings_ui_toggle_row_height(GetLocaleText("settings_breaks_sounds"), label_w)
    height += settings_ui_toggle_row_height(GetLocaleText("settings_breaks_reading_mode"), label_w)
    height += settings_ui_toggle_row_height(GetLocaleText("settings_breaks_micro_counts"), label_w)

    timer_keys: [3] const char* = {
        "settings_breaks_micro_header",
        "settings_breaks_rest_header",
        "settings_breaks_daily_header"
    }
    for int t = 0; t < 3; t++ {
        header := GetLocaleText(timer_keys[t])
        height += Scale(44) + GetNodeHeight(NodeParagraph((ParagraphSpec){.text = header, .width = label_w}, 0, 0))
        height += settings_breaks_timer_row_h(GetLocaleText("settings_breaks_timer_enabled"), label_w)
        height += settings_breaks_slider_h()
        height += settings_breaks_slider_h()
        height += settings_breaks_slider_h()
        height += settings_breaks_slider_h()
        height += settings_breaks_timer_row_h(GetLocaleText("settings_breaks_show_skip"), label_w)
        height += settings_breaks_timer_row_h(GetLocaleText("settings_breaks_show_postpone"), label_w)
    }

    height += Scale(200)
    return height
}

settings_breaks_draw_status :: (app: InbeApp*, x: int, w: int, y: int*) #private {
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("settings_breaks_status")),
        .font=(GetFontSize()),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })
    *y += Scale(30)

    muted := DarkenUIColor(GetThemeText(), 40)
    names: [3] const char* = {
        GetLocaleText("break_micro_title"),
        GetLocaleText("break_rest_title"),
        GetLocaleText("break_daily_title")
    }
    bar_x := x + w / 2
    bar_w := w / 2 - Scale(8)
    if bar_w < Scale(80) {
        bar_w = Scale(80)
    }

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        timer: BreakTimer* = &app->breaks.timers[t]
        line: [96] char
        next := break_timer_next_due_s(&app->breaks, t)

        if !timer->enabled {
            snprintf(line, sizeof(line), "%s", GetLocaleText("settings_breaks_timer_off"))
        } else if next < 0 {
            snprintf(line, sizeof(line), "%s", GetLocaleText("settings_breaks_timer_off"))
        } else if next == 0 {
            snprintf(line, sizeof(line), "%s", GetLocaleText("settings_breaks_due_now"))
        } else {
            break_format_duration(line, sizeof(line), next)
        }
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(names[t]),
            .font=(Text12),
            .color=(muted),
            .wrap=TextWrapNone
        })
        Text((TextProps){
            .bounds={(bar_x - Scale(8) - TextWidth(line, Text12)), (*y), 0, 0},
            .text=(line),
            .font=(Text12),
            .color=(GetThemeText()),
            .wrap=TextWrapNone
        })

        track := DarkenUIColor(GetThemeBackground(), 26)
        border := DarkenUIColor(GetThemeText(), 60)
        fill := (Color){74, 178, 102, 255}
        idle_col := (Color){240, 200, 60, 255}
        if timer->limit_s > 0 {
            fraction := timer->active_s * (bar_w - 2) / timer->limit_s
            if fraction > bar_w - 2 {
                fraction = bar_w - 2
            }
            Rect(bar_x, *y + Scale(2), bar_w, Scale(12), track, border)
            if fraction > 0 {
                Rect(bar_x + 1, *y + Scale(3), fraction, Scale(10), fill, fill)
            }
            # Same yellow idle tip as the HUD: fills the rest of the bar while
            # the user is away; full means a natural break resets the timer.
            if timer->state == BreakStateRunning && timer->duration_s > 0 &&
               timer->idle_s > 0 && !timer->idle_latched {
                tip := (bar_w - 2 - fraction) * timer->idle_s / timer->duration_s
                if tip > 0 {
                    Rect(bar_x + 1 + fraction, *y + Scale(3), tip, Scale(10), idle_col, idle_col)
                }
            }
        }
        *y += Scale(22)
    }
    *y += Scale(12)
}

settings_breaks_draw_timer :: (app: InbeApp*, t: int, x: int, w: int, y: int*) #private {
    timer: BreakTimer* = &app->breaks.timers[t]
    header: const char*
    limit_min := timer->limit_s / 60
    duration := timer->duration_s
    postpone := timer->postpone_s
    prompts := timer->max_prompts
    enabled := timer->enabled
    show_skip := timer->show_skip
    show_postpone := timer->show_postpone
    changed := 0

    if t == BREAK_REST {
        header = GetLocaleText("settings_breaks_rest_header")
    } else if t == BREAK_DAILY {
        header = GetLocaleText("settings_breaks_daily_header")
    } else {
        header = GetLocaleText("settings_breaks_micro_header")
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(header),
        .font=(GetFontSize()),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })
    *y += Scale(34)

    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_timer_enabled"),
                                     &enabled, 0) {
        changed = 1
    }
    if settings_ui_commit_slider_row(app, 500 + t * 10, x, w, y, settings_breaks_slider_h(),
                                     GetLocaleText("settings_breaks_limit"),
                                     t == BREAK_DAILY ? 60 : (t == BREAK_REST ? 10 : 1),
                                     t == BREAK_DAILY ? 1440 : (t == BREAK_REST ? 240 : 30),
                                     &limit_min, "", 0) {
        changed = 1
    }
    if t != BREAK_DAILY {
        if settings_ui_commit_slider_row(app, 501 + t * 10, x, w, y, settings_breaks_slider_h(),
                                         GetLocaleText("settings_breaks_duration"),
                                         t == BREAK_REST ? 60 : 5,
                                         t == BREAK_REST ? 1800 : 120,
                                         &duration, "", 0) {
            changed = 1
        }
    }
    if settings_ui_commit_slider_row(app, 502 + t * 10, x, w, y, settings_breaks_slider_h(),
                                     GetLocaleText("settings_breaks_postpone"),
                                     60, 1800, &postpone, "", 0) {
        changed = 1
    }
    if settings_ui_commit_slider_row(app, 503 + t * 10, x, w, y, settings_breaks_slider_h(),
                                     GetLocaleText("settings_breaks_prompts"),
                                     0, 10, &prompts, "", 0) {
        changed = 1
    }
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_show_skip"),
                                     &show_skip, 0) {
        changed = 1
    }
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_show_postpone"),
                                     &show_postpone, 0) {
        changed = 1
    }

    if changed {
        timer->enabled = enabled
        timer->limit_s = limit_min * 60
        timer->duration_s = duration
        timer->postpone_s = postpone
        timer->max_prompts = prompts
        timer->show_skip = show_skip
        timer->show_postpone = show_postpone
        if timer->active_s > timer->limit_s {
            timer->active_s = timer->limit_s
        }
        app->settings_dirty = 1
    }
    *y += Scale(10)
}

settings_breaks_draw_week :: (app: InbeApp*, x: int, w: int, y: int*) #private {
    unused app
    unused w
    rows: [42] BreakDayRow
    count := storage_break_history(7, rows, 42)

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("settings_breaks_week_stats")),
        .font=(GetFontSize()),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })
    *y += Scale(30)
    if count <= 0 {
        muted := DarkenUIColor(GetThemeText(), 40)
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(GetLocaleText("settings_breaks_no_data")),
            .font=(Text12),
            .color=(muted),
            .wrap=TextWrapNone
        })
        *y += Scale(24)
        return
    }

    taken: [3] int
    skipped: [3] int
    postponed: [3] int
    for int i = 0; i < count; i++ {
        t := rows[i].break_type
        if t < 0 || t >= BREAK_TYPE_COUNT {
            continue
        }
        taken[t] += rows[i].taken + rows[i].natural
        skipped[t] += rows[i].skipped
        postponed[t] += rows[i].postponed
    }

    muted := DarkenUIColor(GetThemeText(), 40)
    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        line: [128] char
        name: const char* = t == BREAK_REST ? GetLocaleText("break_rest_title") : t == BREAK_DAILY ? GetLocaleText("break_daily_title") : GetLocaleText("break_micro_title")
        snprintf(line, sizeof(line), "%s  %d / %d / %d",
                 name, taken[t], skipped[t], postponed[t])
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(line),
            .font=(Text12),
            .color=(muted),
            .wrap=TextWrapNone
        })
        *y += Scale(20)
    }
    *y += Scale(12)
}

settings_breaks_draw :: (app: InbeApp*, x: int, w: int, y: int*) {
    enabled := app->breaks_enabled
    sounds := app->break_sounds_enabled
    reading := app->breaks.reading_mode
    micro_counts := app->breaks.micro_counts_as_activity
    block_mode := app->break_block_mode

    settings_breaks_draw_status(app, x, w, y)

    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_enabled"),
                                     &enabled, 0) {
        app->breaks_enabled = enabled
        if !enabled {
            break_engine_set_mode(&app->breaks, BreakModeNormal, 0)
        }
    }

    block_options: [3] const char* = {
        GetLocaleText("settings_breaks_block_off"),
        GetLocaleText("settings_breaks_block_input"),
        GetLocaleText("settings_breaks_block_screen")
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("settings_breaks_block_mode")),
        .font=(GetFontSize()),
        .color=(GetThemeText()),
        .wrap=TextWrapNone
    })
    if Dropdown(540, x, *y + Scale(26), w, Scale(36), block_options, 3, &block_mode) {
        app->break_block_mode = block_mode
        app->settings_dirty = 1
    }
    *y += Scale(76)

    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_sounds"),
                                     &sounds, 0) {
        app->break_sounds_enabled = sounds
    }
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_reading_mode"),
                                     &reading, 0) {
        app->breaks.reading_mode = reading
    }
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("settings_breaks_micro_counts"),
                                     &micro_counts, 0) {
        app->breaks.micro_counts_as_activity = micro_counts
    }

    button_w := (w - Scale(12)) / 2
    if button_w > Scale(200) {
        button_w = Scale(200)
    }
    rest_hover := 0
    if StyledButton(x, *y, button_w, Scale(40),
                    GetLocaleText("settings_breaks_rest_now"),
                    ButtonStyleSecondary, 0, &rest_hover) {
        app_breaks_rest_break_now(app)
    }
    *y += Scale(60)

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        settings_breaks_draw_timer(app, t, x, w, y)
    }

    settings_breaks_draw_week(app, x, w, y)
}
