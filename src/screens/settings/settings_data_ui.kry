HAS_FILE_DIALOG :: #defined(PLATFORM_WEB) || (!ANDROID_BUILD && !#defined(_WIN32) && !#defined(INBE_DISABLE_KRYON_FILE_DIALOG))
ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
NATIVE_FILE_DIALOG :: #defined(INBE_HAS_KRYON_FILE_DIALOG)

#if HAS_FILE_DIALOG {
    INBE_HAS_KRYON_FILE_DIALOG :: #define 1
}

#if WEB {
    #import <emscripten.h>
    web_download_file :: (path: const char*, filename: const char*, mime: const char*) -> int #intrinsic "web"
    static web_file_dialog: FileDialog = {0}
    static web_file_dialog_ready: int = 0
}

#enum {
    SETTINGS_DATA_ACTION_NONE = 0
    SETTINGS_DATA_ACTION_IMPORT
    SETTINGS_DATA_ACTION_EXPORT
    SETTINGS_DATA_ACTION_SYNC_KEY_EXPORT
    SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT
    SETTINGS_DATA_TOP_PADDING = 8
}

static sync_server_url_key: const char* = "sync_server_url"
static sync_server_url_default: const char* = "https://api.waozi.xyz"
static data_import_filter: const char* = ".db,.zip"
static sync_key_import_filter: const char* = ".key"
static android_data_import_mime_types: const char* = "application/zip,application/x-zip-compressed,application/vnd.sqlite3,application/x-sqlite,application/x-sqlite3,application/octet-stream"
static android_sync_key_import_mime_types: const char* = "*/*"
static web_export_path: const char* = "/tmp/inbe-web-export.zip"

SettingsFileDialogOrigin :: struct {
    active: int
    screen: int
    settings_tab: int
    settings_scroll: int
    profile_view: int
    profile_scroll: int
}

static data_file_dialog_action: int = SETTINGS_DATA_ACTION_NONE
static file_dialog_origin: SettingsFileDialogOrigin = {0}
static pending_import_path: [FS_PATH_MAX] char = ""
static pending_import_info: DataImportInfo = {0}
static sync_review_diff_scroll: int = 0

clear_pending_import :: () #private {
    pending_import_path[0] = '\0'
    memset(&pending_import_info, 0, sizeof(pending_import_info))
}

file_dialog_begin :: (app: InbeApp*, action: int) #private {
    #if ANDROID || WEB {
        if app == nil {
            return
        }
        data_file_dialog_action = action
        app->file_dialog_active = 1
        file_dialog_origin.active = 1
        file_dialog_origin.screen = app->inbe.screen
        file_dialog_origin.settings_tab = app->settings_tab
        file_dialog_origin.settings_scroll = app->settings_scroll
        file_dialog_origin.profile_view = app->profile_view
        file_dialog_origin.profile_scroll = app->profile_scroll
    } #else {
        unused app
        unused action
    }
}

file_dialog_finish :: (app: InbeApp*) -> int #private {
    #if ANDROID || WEB {
        action := data_file_dialog_action
        if app != nil && file_dialog_origin.active {
            app->inbe.screen = file_dialog_origin.screen
            app->settings_tab = file_dialog_origin.settings_tab
            app->settings_scroll = file_dialog_origin.settings_scroll
            app->profile_view = file_dialog_origin.profile_view
            app->profile_scroll = file_dialog_origin.profile_scroll
        }
        file_dialog_origin.active = 0
        data_file_dialog_action = SETTINGS_DATA_ACTION_NONE
        if app != nil {
            app->file_dialog_active = 0
        }
        return action
    } #else {
        unused app
        return SETTINGS_DATA_ACTION_NONE
    }
}

web_file_dialog_begin :: (app: InbeApp*, action: int, title: const char*, filter: const char*) #private {
    #if WEB {
        if web_file_dialog_ready {
            CloseFileDialog(&web_file_dialog)
        }
        InitFileDialog(&web_file_dialog)
        web_file_dialog_ready = 1
        file_dialog_begin(app, action)
        BeginLoadFilteredFileDialog(&web_file_dialog, title, filter)
    } #else {
        unused app
        unused action
        unused title
        unused filter
    }
}

web_file_dialog_close :: () #private {
    #if WEB {
        if web_file_dialog_ready {
            CloseFileDialog(&web_file_dialog)
        }
        web_file_dialog_ready = 0
    }
}

import_success :: (app: InbeApp*, imported_settings: int) #private {
    app_reload_after_import(app, imported_settings)
    settings_screen_set_status_success(GetLocaleText("imported_data"), nil)
    TraceLog(LOG_INFO, "DATA: Import successful")
}

perform_import :: (app: InbeApp*, path: const char*, mode: DataImportMode) -> int #private {
    if app == nil || path == nil || path[0] == '\0' {
        settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
        return 0
    }

    if data_import_with_mode(path, mode) {
        import_success(app, mode == DATA_IMPORT_DATA_AND_SETTINGS)
        return 1
    }

    settings_screen_set_status_error(GetLocaleText("import_failed"))
    TraceLog(LOG_ERROR, "DATA: Import failed")
    return 0
}

begin_import_for_path :: (app: InbeApp*, path: const char*) #private {
    info: DataImportInfo = {0}

    if app == nil || path == nil || path[0] == '\0' {
        settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
        return
    }

    if !data_inspect_import(path, &info) || !info.valid {
        settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
        TraceLog(LOG_WARNING, "DATA: Invalid import file selected")
        return
    }

    if (info.has_sessions || info.has_habits) && info.has_settings {
        snprintf(pending_import_path, sizeof(pending_import_path), "%s", path)
        pending_import_info = info
        app_open_modal(app, UIModalConfirmImportDataSettings)
        settings_screen_clear_status()
        return
    }

    perform_import(app, path, DATA_IMPORT_DATA_ONLY)
}

sync_server_load :: (app: InbeApp*) #private {
    if app == nil {
        return
    }

    saved := storage_get_setting_text(sync_server_url_key)
    snprintf(app->sync_server_url, sizeof(app->sync_server_url), "%s",
                saved != nil && saved[0] != '\0'
                    ? saved
                    : sync_server_url_default)
    app->sync_server_url_cursor = (int)strlen(app->sync_server_url)
}

open_sync_account_config :: (app: InbeApp*) {
    if app == nil {
        return
    }

    settings_sync_account_set_save_dialog(start_sync_key_export_dialog)
    settings_sync_account_set_import_dialog(start_sync_key_import_dialog)
    sync_server_load(app)

    route := app_current_route(app)
    route.profile_view = PROFILE_VIEW_MAIN
    route.profile_tab = PROFILE_TAB_SYNC
    app_switch_route(app, route)

    app->profile_scroll = 0
    app->sync_server_url_focused = 0
    settings_screen_clear_status()
}

start_sync_key_export_dialog :: (app: InbeApp*, filename: const char*) -> int #private {
    #if WEB {
        unused filename
        unused app
        return 0
    } #else_if NATIVE_FILE_DIALOG {
        dlg: FileDialog = {0}
        unused app
        InitFileDialog(&dlg)
        if SaveFileDialog(&dlg, GetLocaleText("sync_save_key_dialog_title"), filename) {
            account: InbeSyncAccount
            path := GetFileDialogPath(&dlg)
            if path != nil && path[0] != '\0' &&
               sync_account_load(&account) &&
               sync_account_export_private_key(&account, path) {
                settings_screen_set_status_success(GetLocaleText("sync_private_key_backup_saved"), GetFileName(path))
                TraceLog(LOG_INFO, "SYNC: Private key backup saved to %s", path)
            } else {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_backup_failed"))
                TraceLog(LOG_ERROR, "SYNC: Private key backup failed")
            }
        } else {
            settings_screen_set_status_error(GetLocaleText("sync_private_key_backup_cancelled"))
        }
        CloseFileDialog(&dlg)
        return 4
    } #else {
        unused filename
        unused app
        return 0
    }
}

import_sync_key_path :: (app: InbeApp*, path: const char*) -> int #private {
    account: InbeSyncAccount

    if path != nil && path[0] != '\0' &&
       sync_account_import_private_key_preview(&account, path) {
        if settings_sync_account_save_prepared(app, &account,
                                               InbePendingSyncAccountImport, 0) {
            TraceLog(LOG_INFO, "SYNC: Private key imported from %s", path)
        }
        return 1
    }

    settings_screen_set_status_error(GetLocaleText("sync_private_key_import_failed"))
    TraceLog(LOG_ERROR, "SYNC: Private key import failed")
    unused app
    return 0
}

start_sync_key_import_dialog :: (app: InbeApp*) -> int #private {
    #if WEB {
        web_file_dialog_begin(app, SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT,
                                 GetLocaleText("sync_import_key_dialog_title"),
                                 sync_key_import_filter)
        settings_screen_set_status_success(GetLocaleText("sync_import_key_dialog_title"), nil)
        return 1
    } #else_if ANDROID {
        file_dialog_begin(app, SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT)
        unused app
        if android_import_open_picker(android_sync_key_import_mime_types) {
            settings_screen_set_status_success(GetLocaleText("sync_import_key_dialog_title"), nil)
            return 1
        }
        file_dialog_finish(app)
        return 0
    } #else_if NATIVE_FILE_DIALOG {
        dlg: FileDialog = {0}
        InitFileDialog(&dlg)
        if LoadFilteredFileDialog(&dlg, GetLocaleText("sync_import_key_dialog_title"),
                                  sync_key_import_filter) {
            import_sync_key_path(app, GetFileDialogPath(&dlg))
        } else {
            settings_screen_set_status_error(GetLocaleText("sync_private_key_import_cancelled"))
        }
        CloseFileDialog(&dlg)
        return 1
    } #else {
        unused app
        return 0
    }
}

content_height :: (content_w: int) -> int {
    data_button_h: int = ScaleUIPx(36)

    unused content_w

    return ScaleUIPx(SETTINGS_DATA_TOP_PADDING) +
           data_button_h + ScaleUIPx(12) +
           data_button_h + ScaleUIPx(12) +
           data_button_h + ScaleUIPx(12) +
           ScaleUIPx(42) +
           ScaleUIPx(40)
}

draw_actions :: (app: InbeApp*, x: int, w: int, y: int*) {
    account: InbeSyncAccount
    data_button_h := ScaleUIPx(36)
    hover_import: int = 0
    hover_export: int = 0
    hover_delete: int = 0
    has_account := sync_account_load(&account)

    settings_sync_account_set_save_dialog(start_sync_key_export_dialog)
    settings_sync_account_set_import_dialog(start_sync_key_import_dialog)

    *y += ScaleUIPx(SETTINGS_DATA_TOP_PADDING)
    if DrawUIGenericButton(x, *y, w, data_button_h,
                           GetLocaleText("import_data_button"),
                           UI_BUTTON_STYLE_PRIMARY, 0, &hover_import) {
        import_data(app)
    }
    *y += data_button_h + ScaleUIPx(12)

    if DrawUIGenericButton(x, *y, w, data_button_h,
                           GetLocaleText("export_data_button"),
                           UI_BUTTON_STYLE_PRIMARY, 0, &hover_export) {
        export_data(app)
    }
    *y += data_button_h + ScaleUIPx(12)

    if !has_account {
        if DrawUIGenericButton(x, *y, w, data_button_h,
                               GetLocaleText("clear_local_data_button"),
                               UI_BUTTON_STYLE_DANGER, 0, &hover_delete) {
            request_delete_all_data(app)
        }
        *y += data_button_h + ScaleUIPx(12)
    }
    settings_screen_draw_status_reserved(x, y, ScaleUIPx(42))
}

draw_sync_status :: (x: int, w: int, y: int*) {
    status: InbeStorageSyncStatus
    line: [160] char = {0}
    font: int = GetUISmallFontSize()
    label_font: int = GetUIFontSize()
    label_color: Color = GetThemeText()
    body_color: Color = DarkenUIColor(GetThemeText(), 25)
    warn_color: Color = (Color){196, 126, 45, 255}
    ok_color: Color = (Color){70, 150, 96, 255}
    row_y: int
    left_w: int
    status_line_color: Color

    if !storage_sync_status(&status) || !status.has_account {
        return
    }

    DrawUIText(GetLocaleText("sync_status_title"),
                  x, *y, label_font, label_color)
    *y += ScaleUIPx(24)

    left_w = w / 2
    row_y = *y

    FormatLocaleText(line, sizeof(line), "sync_status_account",
                        GetLocaleText(status.has_account
                                      ? "sync_status_connected"
                                      : "sync_status_not_set"))
    DrawUIText(line, x, row_y, font,
                  status.has_account ? ok_color : body_color)

    FormatLocaleText(line, sizeof(line), "sync_status_queued",
                        status.queued_changes)
    DrawUIText(line, x + left_w, row_y, font,
                  status.queued_changes > 0 ? warn_color : body_color)

    row_y += ScaleUIPx(22)
    FormatLocaleText(line, sizeof(line), "sync_status_server",
                        status.server_version)
    DrawUIText(line, x, row_y, font, body_color)

    FormatLocaleText(line, sizeof(line), "sync_status_clock",
                        status.server_clock)
    DrawUIText(line, x + left_w, row_y, font, body_color)

    row_y += ScaleUIPx(22)
    if status.protocol_upgrade_available {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_upgrade"))
    } else if status.review_pending {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_review_pending"))
    } else if status.repair_pending {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_repair_pending"))
    } else if status.queued_changes > 0 {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_local_queued"))
    } else if !status.full_upload_done {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_initial_upload_pending"))
    } else {
        snprintf(line, sizeof(line), "%s",
                    GetLocaleText("sync_status_ready"))
    }

    status_line_color = body_color
    if status.protocol_upgrade_available ||
       status.review_pending ||
       status.repair_pending {
        status_line_color = warn_color
    }
    DrawUIText(line, x, row_y, font, status_line_color)

    *y += ScaleUIPx(74)
}

handle_android_import :: (app: InbeApp*) {
    #if ANDROID {
        import_path: [FS_PATH_MAX] char = {0}
        import_result := android_import_poll_result(import_path, sizeof(import_path))
        action: int

        if import_result == ANDROID_IMPORT_RESULT_NONE {
            return
        }
        action = file_dialog_finish(app)
        if import_result == ANDROID_IMPORT_RESULT_CANCELLED {
            if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_import_cancelled"))
            } else {
                settings_screen_set_status_error(GetLocaleText("import_cancelled"))
            }
            return
        }
        if import_path[0] == '\0' {
            if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_import_failed"))
            } else {
                settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
            }
            return
        }
        if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
            import_sync_key_path(app, import_path)
        } else {
            begin_import_for_path(app, import_path)
        }
    } #else {
        unused app
    }
}

handle_web_import :: (app: InbeApp*) {
    #if WEB {
        action: int
        result: int
        path: const char*

        if !web_file_dialog_ready || !web_file_dialog.active {
            return
        }

        result = UpdateFileDialog(&web_file_dialog)
        if result == -1 {
            return
        }

        action = file_dialog_finish(app)
        path = GetFileDialogPath(&web_file_dialog)
        if result == 0 {
            if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_import_cancelled"))
            } else {
                settings_screen_set_status_error(GetLocaleText("import_cancelled"))
            }
            web_file_dialog_close()
            return
        }

        if path == nil || path[0] == '\0' {
            if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_import_failed"))
            } else {
                settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
            }
            web_file_dialog_close()
            return
        }

        if action == SETTINGS_DATA_ACTION_SYNC_KEY_IMPORT {
            import_sync_key_path(app, path)
        } else {
            begin_import_for_path(app, path)
        }
        web_file_dialog_close()
    } #else {
        unused app
    }
}

import_data :: (app: InbeApp*) #private {
    #if ANDROID {
        file_dialog_begin(app, SETTINGS_DATA_ACTION_IMPORT)
        if android_import_open_picker(android_data_import_mime_types) {
            settings_screen_set_status_success(GetLocaleText("import_data_dialog_title"), nil)
        } else {
            file_dialog_finish(app)
            settings_screen_set_status_error(GetLocaleText("import_failed"))
        }
    } #else_if WEB {
        web_file_dialog_begin(app, SETTINGS_DATA_ACTION_IMPORT,
                                 GetLocaleText("import_data_dialog_title"),
                                 data_import_filter)
        settings_screen_set_status_success(GetLocaleText("import_data_dialog_title"), nil)
    } #else_if NATIVE_FILE_DIALOG {
        dlg: FileDialog = {0}
        InitFileDialog(&dlg)
        if LoadFilteredFileDialog(&dlg, GetLocaleText("import_data_dialog_title"),
                                  data_import_filter) {
            path := GetFileDialogPath(&dlg)
            if path != nil && path[0] != '\0' {
                begin_import_for_path(app, path)
            } else {
                settings_screen_set_status_error(GetLocaleText("import_invalid_file"))
                TraceLog(LOG_WARNING, "DATA: No file selected for import")
            }
        } else {
            settings_screen_set_status_error(GetLocaleText("import_cancelled"))
        }
        CloseFileDialog(&dlg)
    } #else {
        unused app
        settings_screen_set_status_error(GetLocaleText("import_failed"))
    }
}

export_data :: (app: InbeApp*) #private {
    export_filename: [64] char
    data_default_export_filename(export_filename, sizeof(export_filename))

    if !data_has_any() {
        settings_screen_set_status_error(GetLocaleText("no_data_to_export"))
        return
    }

    #if ANDROID {
        file_dialog_begin(app, SETTINGS_DATA_ACTION_EXPORT)
        if data_export(export_filename) {
            file_dialog_finish(app)
            settings_screen_set_status_success(GetLocaleText("exported_label"), nil)
            TraceLog(LOG_INFO, "DATA: Export successful (share sheet shown)")
        } else {
            file_dialog_finish(app)
            settings_screen_set_status_error(GetLocaleText("export_failed"))
            TraceLog(LOG_ERROR, "DATA: Export failed")
        }
    } #else_if WEB {
        unused app
        if data_export(web_export_path) &&
           web_download_file(web_export_path, export_filename, "application/zip") {
            settings_screen_set_status_success(GetLocaleText("exported_label"), nil)
            TraceLog(LOG_INFO, "DATA: Web export download started")
        } else {
            settings_screen_set_status_error(GetLocaleText("export_failed"))
            TraceLog(LOG_ERROR, "DATA: Web export failed")
        }
    } #else_if NATIVE_FILE_DIALOG {
        dlg: FileDialog = {0}
        unused app
        InitFileDialog(&dlg)
        if SaveFileDialog(&dlg, GetLocaleText("export_data_dialog_title"), export_filename) {
            path := GetFileDialogPath(&dlg)
            if path != nil && data_export(path) {
                filename := GetFileName(path)
                settings_screen_set_status_success(GetLocaleText("exported_label"), filename)
                TraceLog(LOG_INFO, "DATA: Export successful to %s", path)
            } else {
                settings_screen_set_status_error(GetLocaleText("export_failed"))
                TraceLog(LOG_ERROR, "DATA: Export failed")
            }
        } else {
            settings_screen_set_status_error(GetLocaleText("export_cancelled"))
        }
        CloseFileDialog(&dlg)
    } #else {
        unused app
        settings_screen_set_status_error(GetLocaleText("export_failed"))
    }
}

request_delete_all_data :: (app: InbeApp*) #private {
    if data_has_any() {
        app_open_modal(app, UIModalConfirmDeleteData)
    } else {
        settings_screen_set_status_error(GetLocaleText("no_data_to_delete"))
    }
}

draw_import_choice_modal :: (app: InbeApp*) -> int {
    frame: UIPanelFrame
    font: int = GetUIFontSize()
    message: const char* = GetLocaleText("import_choice_message")
    row_gap: int = ScaleUIPx(10)
    btn_h: int = ScaleUIPx(36)
    msg_x: int
    msg_y: int
    btn_y: int
    btn_w: int
    hover: int = 0

    unused app

    frame = DrawUIModalFrame(ScaleUIPx(320),
                             ScaleUIPx(232),
                             GetLocaleText("import_choice_title"),
                             (Texture2D){0},
                             (Texture2D){0})
    msg_x = frame.content_x
    msg_y = frame.content_y

    DrawUIText(message, msg_x, msg_y, font, GetThemeText())

    btn_y = frame.y + frame.h - ScaleUIPx(24) - btn_h * 2 - row_gap
    btn_w = (frame.content_w - row_gap) / 2

    if DrawUIGenericButton(frame.content_x,
                           btn_y,
                           btn_w,
                           btn_h,
                           GetLocaleText("cancel_button"),
                           UI_BUTTON_STYLE_SECONDARY,
                           0,
                           &hover) {
        return 1
    }

    if DrawUIGenericButton(frame.content_x + btn_w + row_gap,
                           btn_y,
                           btn_w,
                           btn_h,
                           GetLocaleText("import_data_only_button"),
                           UI_BUTTON_STYLE_PRIMARY,
                           0,
                           &hover) {
        return 2
    }

    if DrawUIGenericButton(frame.content_x,
                           btn_y + btn_h + row_gap,
                           frame.content_w,
                           btn_h,
                           GetLocaleText("import_data_settings_button"),
                           UI_BUTTON_STYLE_PRIMARY,
                           0,
                           &hover) {
        return 3
    }

    return 0
}

draw_sync_review_modal :: (app: InbeApp*) -> int {
    frame: UIPanelFrame
    diff_detail: char* = nil
    intro: UIParagraph
    intro_y: int
    intro_h: int
    modal_w: int
    modal_h: int
    btn_h: int = ScaleUIPx(36)
    gap: int = ScaleUIPx(10)
    btn_y: int
    diff_y: int
    diff_h: int
    legend_y: int
    hover: int = 0
    diff_content_h: int = ScaleUIPx(40)
    p: const char* = nil
    diff_view: UIScrollView
    line: char* = nil
    line_y: int
    line_color: Color

    unused app

    modal_w = ui_view_width >= ScaleUIPx(620)
        ? ScaleUIPx(560)
        : ScaleUIPx(336)
    modal_h = ui_view_height >= ScaleUIPx(520)
        ? ScaleUIPx(440)
        : ui_view_height - ScaleUIPx(32)

    if modal_h < ScaleUIPx(320) {
        modal_h = ScaleUIPx(320)
    }

    if !storage_sync_review_diff(&diff_detail) {
        free(diff_detail)
        return 0
    }

    frame = DrawUIModalFrame(modal_w,
                             modal_h,
                             GetLocaleText("sync_review_needed"),
                             (Texture2D){0},
                             (Texture2D){0})
    intro = (UIParagraph){
        .text = GetLocaleText("sync_review_message"),
        .width = frame.content_w,
        .font = GetUISmallFontSize(),
        .line_gap = ScaleUIPx(2),
        .color = GetThemeText()
    }
    intro_h = GetUIParagraphHeight(intro)
    intro_y = frame.content_y
    DrawUIParagraph(intro, frame.content_x, &intro_y)

    diff_y = frame.content_y + intro_h + ScaleUIPx(12)
    btn_y = frame.y + frame.h - ScaleUIPx(24) - btn_h
    legend_y = btn_y - ScaleUIPx(24)
    diff_h = legend_y - diff_y - ScaleUIPx(8)
    if diff_h < ScaleUIPx(150) {
        diff_h = ScaleUIPx(150)
    }

    p = diff_detail
    diff_content_h = ScaleUIPx(20)
    while p != nil && *p != '\0' {
        diff_content_h += ScaleUIPx(20)
        p = strchr(p, '\n')
        if p != nil {
            p++
        }
    }

    diff_view = BeginUIScrollContainer((UIScrollArea){
        .bounds = {
            (float)frame.content_x,
            (float)diff_y,
            (float)frame.content_w,
            (float)diff_h
        },
        .content_height = diff_content_h,
        .content_x = frame.content_x + ScaleUIPx(10),
        .content_width = frame.content_w - ScaleUIPx(20),
        .scroll_offset = &sync_review_diff_scroll,
        .wheel_step = ScaleUIPx(24)
    })

    line = strtok(diff_detail, "\n")
    line_y = diff_view.content_y
    while line != nil {
        line_color = GetThemeText()
        if line[0] == '-' {
            line_color = (Color){215, 88, 88, 255}
        } else if line[0] == '+' {
            line_color = (Color){74, 170, 112, 255}
        }

        DrawUIText(line,
                      diff_view.content_x,
                      line_y,
                      GetUISmallFontSize(),
                      line_color)
        line_y += ScaleUIPx(20)
        line = strtok(nil, "\n")
    }

    EndUIScrollContainer((UIScrollArea){
        .bounds = {
            (float)frame.content_x,
            (float)diff_y,
            (float)frame.content_w,
            (float)diff_h
        },
        .scroll_offset = &sync_review_diff_scroll
    }, diff_view)

    DrawUIText(GetLocaleText("sync_review_local_only"),
                  frame.content_x,
                  legend_y,
                  GetUISmallFontSize(),
                  (Color){215, 88, 88, 255})
    DrawUIText(GetLocaleText("sync_review_remote_only"),
                  frame.content_x + ScaleUIPx(112),
                  legend_y,
                  GetUISmallFontSize(),
                  (Color){74, 170, 112, 255})

    if DrawUIGenericButton(frame.content_x,
                           btn_y,
                           (frame.content_w - gap) / 2,
                           btn_h,
                           GetLocaleText("sync_review_keep_local_button"),
                           UI_BUTTON_STYLE_SECONDARY,
                           0,
                           &hover) {
        free(diff_detail)
        return 1
    }

    if DrawUIGenericButton(frame.content_x + (frame.content_w + gap) / 2,
                           btn_y,
                           (frame.content_w - gap) / 2,
                           btn_h,
                           GetLocaleText("sync_review_use_remote_button"),
                           UI_BUTTON_STYLE_PRIMARY,
                           0,
                           &hover) {
        free(diff_detail)
        return 2
    }

    free(diff_detail)
    return 0
}

draw_modals :: (app: InbeApp*) -> int {
    if app == nil || !app->modal.active {
        return 0
    }

    if app->modal.type == UIModalConfirmImportDataSettings {
        modal_result := draw_import_choice_modal(app)
        if modal_result == 1 {
            app_close_modal(app)
            clear_pending_import()
            settings_screen_set_status_error(GetLocaleText("import_cancelled"))
        } else if modal_result == 2 || modal_result == 3 {
            import_path: [FS_PATH_MAX] char
            mode := modal_result == 3
                ? DATA_IMPORT_DATA_AND_SETTINGS
                : DATA_IMPORT_DATA_ONLY
            snprintf(import_path, sizeof(import_path), "%s", pending_import_path)
            app_close_modal(app)
            clear_pending_import()
            perform_import(app, import_path, mode)
        }
        return 1
    }

    if app->modal.type == UIModalConfirmDeleteData {
        modal_result := DrawUIModal(GetLocaleText("clear_local_data_title"),
                                    GetLocaleText("clear_local_data_message"),
                                    GetLocaleText("cancel_button"),
                                    GetLocaleText("clear_button"))
        if modal_result == 1 {
            app_close_modal(app)
            settings_screen_set_status_error(GetLocaleText("delete_cancelled"))
        } else if modal_result == 2 {
            deleted := data_delete_all()
            app_close_modal(app)
            if deleted > 0 {
                deleted_message: [128] char
                habits_free(&app->habits)
                memset(&app->habits, 0, sizeof(app->habits))
                app->habits.loaded = 1
                FormatLocaleText(deleted_message, sizeof(deleted_message),
                                    "deleted_sessions", deleted)
                settings_screen_set_status_success(deleted_message, nil)
            } else {
                cleared := habits_clear_days(&app->habits)
                if cleared > 0 {
                    deleted_message: [128] char
                    habits_save(&app->habits)
                    FormatLocaleText(deleted_message, sizeof(deleted_message),
                                        "deleted_sessions", cleared)
                    settings_screen_set_status_success(deleted_message, nil)
                } else {
                    settings_screen_set_status_error(GetLocaleText("no_data_to_delete"))
                }
            }
        }
        return 1
    }

    if app->modal.type == UIModalConfirmDeleteSyncAccount {
        modal_result := DrawUIModal(GetLocaleText("sync_clear_remote_data_title"),
                                    GetLocaleText("sync_clear_remote_data_message"),
                                    GetLocaleText("cancel_button"),
                                    GetLocaleText("clear_button"))
        if modal_result == 1 {
            app_close_modal(app)
            settings_screen_set_status_error(GetLocaleText("sync_clear_remote_data_cancelled"))
        } else if modal_result == 2 {
            app_close_modal(app)
            settings_sync_account_clear_remote_confirmed(app)
        }
        return 1
    }

    if app->modal.type == UIModalConfirmSyncAccountSwitch {
        modal_result := DrawUIModal(GetLocaleText("sync_account_switch_title"),
                                    GetLocaleText("sync_account_switch_message"),
                                    GetLocaleText("cancel_button"),
                                    GetLocaleText("sync_account_switch_clear_button"))
        if modal_result == 1 {
            app_close_modal(app)
            memset(&app->pending_sync_account, 0, sizeof(app->pending_sync_account))
            app->pending_sync_account_action = InbePendingSyncAccountNone
            settings_screen_set_status_error(GetLocaleText("sync_account_switch_cancelled"))
        } else if modal_result == 2 {
            account := app->pending_sync_account
            action := app->pending_sync_account_action
            app_close_modal(app)
            if settings_sync_account_save_prepared(app, &account, action, 1) {
                app_reload_after_import(app, 0)
            } else {
                settings_screen_set_status_error(GetLocaleText("sync_account_switch_failed"))
            }
        }
        return 1
    }

    if app->modal.type == UIModalSyncAccountBackup {
        modal_result := settings_sync_account_draw_backup_modal(app)
        if modal_result == 1 || modal_result == 2 ||
           modal_result == 3 || modal_result == 4 {
            app_close_modal(app)
            if modal_result == 2 {
                settings_screen_set_status_success(GetLocaleText("sync_private_key_backup_saved"), nil)
            } else if modal_result == 3 {
                settings_screen_set_status_error(GetLocaleText("sync_private_key_backup_failed"))
            }
        }
        return 1
    }

    if app->modal.type == UIModalSyncReview {
        modal_result := draw_sync_review_modal(app)
        if modal_result == 1 || modal_result == 2 {
            use_remote := modal_result == 2
            if storage_apply_pending_sync_review(use_remote) {
                app_close_modal(app)
                if use_remote {
                    app_reload_after_import(app, 0)
                }
                settings_screen_set_status_success(
                    GetLocaleText(use_remote ? "sync_review_using_remote" : "sync_review_keeping_local"),
                    nil)
            } else {
                settings_screen_set_status_error(GetLocaleText("sync_review_failed"))
            }
        }
        return 1
    }

    return 0
}
