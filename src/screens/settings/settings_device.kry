#import "app/app.h"
#import "app/app_settings.h"
#import "app/device_preferences.h"
#import "src/screens/settings/settings_types.h"
#import "src/screens/settings/settings_ui.h"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB

settings_device_orientation_option_count :: () -> int #private {
    #if ANDROID {
        return 4
    } #else {
        return 3
    }
}

settings_device_content_height :: (content_w: int) -> int {
    label_w := content_w > 0 ? content_w : Scale(240)
    height := Scale(76) + Scale(76) + Scale(40)

    height += settings_ui_toggle_row_height(GetLocaleText("language_system_label"), label_w)
    height += settings_ui_toggle_row_height(GetLocaleText("play_in_background_label"), label_w)

    #if DESKTOP {
        height += Scale(50)
        height += settings_ui_toggle_row_height(GetLocaleText("on_screen_keyboard_label"), label_w)
        height += Scale(76)
        height += Scale(76)
    }
    return height
}

settings_device_draw :: (app: InnerBreeze*, x: int, w: int, y: int*, state: SettingsDeviceState*) {
    #if DESKTOP {
        keyboard_toggle := 0
    }
    orientation_options: [4] const char* = {
        GetLocaleText("orientation_system"),
        GetLocaleText("orientation_portrait"),
        GetLocaleText("orientation_landscape"),
        GetLocaleText("orientation_sensor")
    }
    orientation_option_count := settings_device_orientation_option_count()
    play_in_background := app->breathing.play_in_background

    if app == NULL || y == NULL || state == NULL {
        return
    }

    #if !DESKTOP {
        app->on_screen_keyboard_enabled = 1
    } #else {
        keyboard_toggle = app->on_screen_keyboard_enabled
    }

    language_system := app->language_system
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("language_system_label"),
                                     &language_system, 0) {
        app->language_system = language_system
        if app->language_system {
            apply_system_language_selection(app, 1)
        } else {
            apply_language_selection(app, app->language_index, 1)
        }
    }

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("language_label")),
        .wrap=TextWrapNone
    })
    if app_locale_dropdown(101, x, *y + Scale(26), w,
                           Scale(36), &app->language_index) {
        state->language_menu_changed = 1
    }
    state->draw_language_menu = 1
    *y += Scale(76)

    orientation_max := orientation_option_count - 1
    app->orientation_mode = clampi(app->orientation_mode,
                                   APP_ORIENTATION_SYSTEM, orientation_max)
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("orientation_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 103,
                            .bounds = {x, *y + Scale(26), w, Scale(36)},
                            .options = orientation_options,
                            .option_count = orientation_option_count,
                            .selected_index = &app->orientation_mode}) {
        state->orientation_changed = 1
    }
    state->draw_orientation_menu = 1
    *y += Scale(76)

    #if DESKTOP {
        if Checkbox((CheckboxProps){.id = 0,
                                    .bounds = {(float)x, (float)*y,
                                               (float)w, (float)Scale(36)},
                                    .label = GetLocaleText("fullscreen_label"),
                                    .value = &app->fullscreen_enabled}) {
            app_desktop_set_fullscreen(app->fullscreen_enabled)
            app->settings_dirty = 1
        }
        *y += Scale(50)
    }

    #if DESKTOP {
        if settings_ui_commit_toggle_row(app, x, w, y,
                                         GetLocaleText("on_screen_keyboard_label"),
                                         &keyboard_toggle, 0) {
            app->on_screen_keyboard_enabled = keyboard_toggle
        }

        startup_mode := app->desktop_startup_mode
        startup_options: [2] const char* = {
            GetLocaleText("desktop_startup_mode_normal"),
            GetLocaleText("desktop_startup_mode_minimized")
        }
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(GetLocaleText("desktop_startup_mode_label")),
            .wrap=TextWrapNone
        })
        if Dropdown((DropdownProps){.id = 104,
                                 .bounds = {x, *y + Scale(26), w, Scale(36)},
                                 .options = startup_options, .option_count = 2,
                                 .selected_index = &startup_mode}) {
            app->desktop_startup_mode = startup_mode
            app->settings_dirty = 1
            save_settings(app)
        }
        *y += Scale(76)

        close_action := app->desktop_close_action
        close_options: [3] const char* = {
            GetLocaleText("desktop_close_action_ask"),
            GetLocaleText("desktop_close_action_keep_running"),
            GetLocaleText("desktop_close_action_quit")
        }
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(GetLocaleText("desktop_close_action_label")),
            .wrap=TextWrapNone
        })
        if Dropdown((DropdownProps){.id = 105,
                                 .bounds = {x, *y + Scale(26), w, Scale(36)},
                                 .options = close_options, .option_count = 3,
                                 .selected_index = &close_action}) {
            app->desktop_close_action = close_action
            app->settings_dirty = 1
            save_settings(app)
        }
        *y += Scale(76)
    }

    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("play_in_background_label"),
                                     &play_in_background, 0) {
        app->breathing.play_in_background = play_in_background
    }


}

settings_device_handle_overlays :: (app: InnerBreeze*, state: SettingsDeviceState*) {
    orientation_option_count := settings_device_orientation_option_count()

    if app == NULL || state == NULL {
        return
    }
    if state->language_menu_changed {
        apply_language_selection(app, app->language_index, 1)
    }
    if state->orientation_changed {
        orientation_max := orientation_option_count - 1
        app->orientation_mode = clampi(app->orientation_mode,
                                       APP_ORIENTATION_SYSTEM, orientation_max)
        app_apply_orientation_preference(app)
        app->settings_dirty = 1
        save_settings(app)
    }
}
