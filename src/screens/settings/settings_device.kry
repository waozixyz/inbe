#import "app/app_notifications"
#import "platform/android/android_push"
#import "app.h"
#import "app/app_settings.h"
#import "app/device_preferences.h"
#import "src/screens/settings/settings_types.h"
#import "src/screens/settings/settings_ui.h"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB

settings_device_orientation_option_count :: () -> int #private {
    #if ANDROID {
        return 4
    } #else {
        return 3
    }
}

settings_device_content_height :: (content_w: int) -> int {
    label_w := content_w > 0 ? content_w : ScaleUIPx(240)
    height := ScaleUIPx(76) + ScaleUIPx(76) + ScaleUIPx(40)

    height += settings_ui_toggle_row_height(GetLocaleText("play_in_background_label"), label_w)
    height += ScaleUIPx(12)
    height += settings_ui_toggle_row_height(GetLocaleText("notifications_label"), label_w)
    height += ScaleUIPx(44)
    #if ANDROID {
        height += ScaleUIPx(44)
    }

    #if DESKTOP {
        height += ScaleUIPx(50)
        height += settings_ui_toggle_row_height(GetLocaleText("on_screen_keyboard_label"), label_w)
    }
    return height
}

settings_device_draw :: (app: InbeApp*, x: int, w: int, y: int*, state: SettingsDeviceState*) {
    #if DESKTOP {
        keyboard_toggle := 0
    }
    orientation_options: [4] const char* = {
        GetLocaleText("orientation_system"),
        GetLocaleText("orientation_portrait"),
        GetLocaleText("orientation_landscape"),
        GetLocaleText("orientation_sensor")
    }
    orientation_option_count := settings_device_orientation_option_count()
    play_in_background := app->inbe.play_in_background

    if app == NULL || y == NULL || state == NULL {
        return
    }

    #if !DESKTOP {
        app->on_screen_keyboard_enabled = 1
    } #else {
        keyboard_toggle = app->on_screen_keyboard_enabled
    }

    Text(GetLocaleText("language_label"), x, *y,
                  GetUIFontSize(), GetThemeText())
    if LocaleDropdown(101, x, *y + ScaleUIPx(26), w,
                                  ScaleUIPx(36), &app->language_index) {
        state->language_menu_changed = 1
    }
    state->draw_language_menu = 1
    *y += ScaleUIPx(76)

    orientation_max := orientation_option_count - 1
    app->orientation_mode = clampi(app->orientation_mode,
                                   APP_ORIENTATION_SYSTEM, orientation_max)
    Text(GetLocaleText("orientation_label"), x, *y,
                  GetUIFontSize(), GetThemeText())
    if Dropdown(103, x, *y + ScaleUIPx(26), w, ScaleUIPx(36),
                            orientation_options, orientation_option_count,
                            &app->orientation_mode) {
        state->orientation_changed = 1
    }
    state->draw_orientation_menu = 1
    *y += ScaleUIPx(76)

    #if DESKTOP {
        if Checkbox(0, x, *y, GetLocaleText("fullscreen_label"),
                                &app->fullscreen_enabled) {
            app_desktop_set_fullscreen(app->fullscreen_enabled)
            app->settings_dirty = 1
        }
        *y += ScaleUIPx(50)
    }

    #if DESKTOP {
        if settings_ui_commit_toggle_row(app, x, w, y,
                                         GetLocaleText("on_screen_keyboard_label"),
                                         &keyboard_toggle, 0) {
            app->on_screen_keyboard_enabled = keyboard_toggle
        }
    }

    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("play_in_background_label"),
                                     &play_in_background, 0) {
        app->inbe.play_in_background = play_in_background
    }

    notifications_enabled := app->notifications_enabled
    if settings_ui_commit_toggle_row(app, x, w, y,
                                     GetLocaleText("notifications_label"),
                                     &notifications_enabled, 0) {
        app->notifications_enabled = notifications_enabled
        if notifications_enabled && !IsNotificationPermissionGranted() {
            RequestNotificationPermission()
        }
    }

    test_hover := 0
    if GenericButton(107, x, *y, w, ScaleUIPx(34),
                     GetLocaleText("notifications_test"),
                     UI_BUTTON_STYLE_SECONDARY, 0, &test_hover) {
        app_notifications_send_test_notification(app)
    }
    *y += ScaleUIPx(44)

    #if ANDROID {
        push_hover := 0
        if GenericButton(108, x, *y, w, ScaleUIPx(34),
                         GetLocaleText("push_label"),
                         UI_BUTTON_STYLE_SECONDARY, 0, &push_hover) {
            platform_android_push_configure()
        }
        *y += ScaleUIPx(44)
    }

}

settings_device_handle_overlays :: (app: InbeApp*, state: SettingsDeviceState*) {
    orientation_option_count := settings_device_orientation_option_count()

    if app == NULL || state == NULL {
        return
    }
    if state->language_menu_changed {
        apply_language_selection(app, app->language_index, 1)
    }
    if state->orientation_changed {
        orientation_max := orientation_option_count - 1
        app->orientation_mode = clampi(app->orientation_mode,
                                       APP_ORIENTATION_SYSTEM, orientation_max)
        app_apply_orientation_preference(app)
        app->settings_dirty = 1
        save_settings(app)
    }
}
