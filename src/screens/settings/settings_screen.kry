#import "app/app.h"
#import "app_nav.h"
#import "app/app_settings.h"
#import "practices/meditation/meditation_practice.h"
#import "settings_about.h"
#import "screens/settings/settings_audio.h"
#import "screens/settings/settings_notifications.h"
#import "screens/settings/settings_breaks.h"
#import "screens/settings/settings_data_ui.h"
#import "screens/settings/settings_device.h"
#import "screens/settings/settings_types.h"
#import "string.h"

SettingsScrollPageContext :: struct {
    app: InnerBreeze*
    tab: int
}

SettingsMobileHubRow :: struct {
    label: const char*
    icon: int
    tab: int
    route: int
}

SettingsDesktopLayout :: struct {
    content_x: int
    content_y: int
    content_w: int
    content_h: int
    list_x: int
    list_y: int
    list_w: int
    list_h: int
    panel_x: int
    panel_y: int
    panel_w: int
    panel_h: int
    panel_pad: int
}

theme_panel :: #import "src/screens/settings/settings_theme"
ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
DESKTOP :: !ANDROID && !WEB

state {
    unified_status: [256] char = ""
    unified_detail: [256] char = ""
    unified_status_type: int = 0
}

settings_screen_set_status_success :: (message: const char*, detail: const char*) {
    if message != NULL {
        strncpy(unified_status, message, sizeof(unified_status) - 1)
        unified_status[sizeof(unified_status) - 1] = '\0'
    } else {
        unified_status[0] = '\0'
    }
    if detail != NULL {
        strncpy(unified_detail, detail, sizeof(unified_detail) - 1)
        unified_detail[sizeof(unified_detail) - 1] = '\0'
    } else {
        unified_detail[0] = '\0'
    }
    unified_status_type = 1
}

settings_screen_set_status_error :: (message: const char*) {
    if message != NULL {
        strncpy(unified_status, message, sizeof(unified_status) - 1)
        unified_status[sizeof(unified_status) - 1] = '\0'
    } else {
        unified_status[0] = '\0'
    }
    unified_detail[0] = '\0'
    unified_status_type = 2
}

settings_screen_clear_status :: () {
    unified_status[0] = '\0'
    unified_detail[0] = '\0'
    unified_status_type = 0
}

settings_draw_status :: (x: int, y: int*) #private {
    if unified_status[0] == '\0' {
        return
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(unified_status),
        .wrap=TextWrapNone
    })
    *y += Scale(18)
    if unified_detail[0] != '\0' {
        Text((TextProps){
            .bounds={(x), (*y), 0, 0},
            .text=(unified_detail),
            .wrap=TextWrapNone
        })
        *y += Scale(18)
    }
}

settings_screen_draw_status_reserved :: (x: int, y: int*, reserved_h: int) {
    status_y := *y

    settings_draw_status(x, &status_y)
    *y += reserved_h
}

settings_tab_content_height :: (app: InnerBreeze*, tab: int, content_w: int) -> int #private {
    if tab == SETTINGS_TAB_THEME {
        return theme_panel.content_height(app, content_w)
    }
    if tab == SETTINGS_TAB_DEVICE {
        return settings_device_content_height(content_w)
    }
    if tab == SETTINGS_TAB_AUDIO {
        return settings_audio_content_height(app, content_w)
    }
    #if DESKTOP {
        if tab == SETTINGS_TAB_BREAKS {
            return settings_breaks_content_height(app, content_w)
        }
    }
    if tab == SETTINGS_TAB_NOTIFICATIONS {
        return settings_notifications_content_height(app, content_w)
    }
    return settings_about_content_height(content_w)
}

settings_scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (SettingsScrollPageContext*)user_data
    planned_content_w := content_w - Scale(16)

    if planned_content_w < Scale(160) {
        planned_content_w = content_w
    }
    return settings_tab_content_height(ctx->app, ctx->tab, planned_content_w) +
           Scale(24)
}

settings_screen_tab_label :: (tab: int) -> const char* {
    if tab == SETTINGS_TAB_DEVICE {
        return GetLocaleText("settings_tab_device")
    }
    if tab == SETTINGS_TAB_THEME {
        return GetLocaleText("settings_section_appearance")
    }
    if tab == SETTINGS_TAB_AUDIO {
        return GetLocaleText("settings_tab_audio")
    }
    #if DESKTOP {
        if tab == SETTINGS_TAB_BREAKS {
            return GetLocaleText("settings_tab_breaks")
        }
    }
    if tab == SETTINGS_TAB_NOTIFICATIONS {
        return GetLocaleText("settings_tab_notifications")
    }
    if tab == SETTINGS_TAB_ABOUT {
        return GetLocaleText("settings_tab_about")
    }
    return GetLocaleText("settings_title")
}

settings_scaffold_title :: (title: const char*, height: int, user_data: void*) -> int #private {
    app := (InnerBreeze*)user_data

    if app == nil || app->modal.active {
        TitleBar((TitleBarProps){.title = title, .height = height})
        return 0
    }

    if TitleBar((TitleBarProps){.title = title, .height = height,
                                .has_leading_action = 1}) {
        app_block_current_click(app)
        app_settings_back(app)
        return 1
    }
    return 0
}

settings_desktop_tab_count :: () -> int #private {
    #if DESKTOP {
        return 6
    } #else {
        return 5
    }
}

settings_desktop_tab_at :: (index: int) -> int #private {
    #if DESKTOP {
        tabs: [6] const int = {
            SETTINGS_TAB_DEVICE,
            SETTINGS_TAB_AUDIO,
            SETTINGS_TAB_BREAKS,
            SETTINGS_TAB_NOTIFICATIONS,
            SETTINGS_TAB_THEME,
            SETTINGS_TAB_ABOUT
        }
    } #else {
        tabs: [5] const int = {
            SETTINGS_TAB_DEVICE,
            SETTINGS_TAB_AUDIO,
            SETTINGS_TAB_NOTIFICATIONS,
            SETTINGS_TAB_THEME,
            SETTINGS_TAB_ABOUT
        }
    }
    count := settings_desktop_tab_count()

    if index < 0 || index >= count {
        return SETTINGS_TAB_DEVICE
    }
    return tabs[index]
}

settings_screen_normalize :: (app: InnerBreeze*) #private {
    if app == NULL {
        return
    }
    if app->settings_tab < 0 || app->settings_tab >= SETTINGS_TAB_COUNT {
        app->settings_tab = SETTINGS_TAB_DEVICE
    }
    #if !DESKTOP {
        if app->settings_tab == SETTINGS_TAB_BREAKS {
            app->settings_tab = SETTINGS_TAB_DEVICE
        }
    }
}

settings_screen_prepare :: (app: InnerBreeze*) #private {
    if app == NULL {
        return
    }
    #if ANDROID {
        settings_data_handle_android_import(app)
    } #else_if WEB {
        settings_data_handle_web_import(app)
    }
    settings_audio_handle_import(app)
    if app->settings_tab == SETTINGS_TAB_AUDIO {
        meditation_music_update(app)
    }
}

settings_mobile_hub_row :: (app: InnerBreeze*, row: SettingsMobileHubRow,
                            x: int, y: int, w: int, id: int) -> int #private {
    h := Scale(56)
    bounds := (Rectangle){(float)x, (float)y, (float)w, (float)h}
    icon_size := Scale(24)
    icon_x := x + Scale(14)
    text_x := icon_x + icon_size + Scale(14)
    chevron_w := Scale(18)
    wide_nav := app_settings_wide_layout(app)
    if wide_nav {
        chevron_w = 0
    }
    title_w := w - (text_x - x) - chevron_w - Scale(30)

    selected := wide_nav && row.route == APP_NAV_ROUTE_NONE && app->settings_tab == row.tab
    clicked := Button((ButtonProps){
        .bounds = bounds, .id = id,
        .selected = selected,
        .tone = selected ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = app->modal.active
    })
    Icon(0, icon_x, y + (h - icon_size) / 2, icon_size,
         row.icon, LightenColor(GetThemeButtonHover(), 54))
    Text((TextProps){
        .bounds = {(float)text_x, (float)y, (float)title_w, (float)h},
        .text=(row.label),
        .class_name = selected ? StyleClassId("selected-navigation") : 0,
        .wrap = TextWrapNone,
        .vertical_align = TextAlignCenter
    })
    if !wide_nav {
        Text((TextProps){
            .bounds={(float)(x + w - chevron_w - Scale(12)),
                     (float)y, (float)chevron_w, (float)h},
            .text=(">"),
            .wrap = TextWrapNone,
            .vertical_align = TextAlignCenter
        })
    }
    if clicked {
        if row.route != APP_NAV_ROUTE_NONE {
            app_apply_nav_route(app, row.route)
        } else {
            app->settings_overview = 0
            app->settings_tab = row.tab
            app->settings_scroll = 0
            settings_screen_clear_status()
        }
        return 1
    }
    return 0
}

settings_mobile_profile_strip :: (app: InnerBreeze*, x: int, y: int, w: int) -> int #private {
    label: [96] char
    subtitle: [96] char
    h := Scale(76)
    avatar := Scale(52)
    bounds := (Rectangle){(float)x, (float)y, (float)w, (float)h}
    avatar_x := x + Scale(12)
    avatar_y := y + (h - avatar) / 2
    text_x := avatar_x + avatar + Scale(14)

    app_nav_profile_identity(app, label, sizeof(label), subtitle, sizeof(subtitle))
    clicked := Button((ButtonProps){
        .bounds = bounds, .id = 7350,
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = app->modal.active
    })
    DrawCircle(avatar_x + avatar / 2, avatar_y + avatar / 2, avatar / 2,
               LightenColor(GetThemeButton(), 30))
    Icon(0, avatar_x, avatar_y, avatar, app->profile_picture_icon, WHITE)
    Text((TextProps){
        .bounds={(float)text_x, (float)(y + Scale(17)),
                 (float)(w - (text_x - x) - Scale(14)), (float)Scale(24)},
        .text=(label),
        .wrap=TextWrapNone
    })
    if subtitle[0] != '\0' {
        Text((TextProps){
            .bounds={(float)text_x, (float)(y + Scale(42)),
                     (float)(w - (text_x - x) - Scale(14)), (float)Scale(18)},
            .text=(subtitle),
            .wrap=TextWrapNone
        })
    }
    if clicked {
        app_apply_nav_route(app, APP_NAV_ROUTE_PROFILE)
        return 1
    }
    return 0
}

settings_mobile_hub_content_height :: (content_w: int, user_data: void*) -> int #private {
    unused content_w
    unused user_data

    return Scale(76) + Scale(18) + (settings_desktop_tab_count() + 1) * Scale(64) +
           Scale(24)
}

settings_mobile_hub_draw_content :: (content_x: int, content_y: int,
                                     content_w: int, user_data: void*) #private {
    app := (InnerBreeze*)user_data
    y := content_y

    if settings_mobile_profile_strip(app, content_x, y, content_w) {
        return
    }
    y += Scale(94)
    for int i = 0; i < settings_desktop_tab_count(); i++ {
        tab := settings_desktop_tab_at(i)
        row := (SettingsMobileHubRow){settings_screen_tab_label(tab),
            tab == SETTINGS_TAB_THEME ? ICON_LIGHTON :
            tab == SETTINGS_TAB_AUDIO ? ICON_SOUND :
            tab == SETTINGS_TAB_BREAKS ? ICON_ACTIVITY :
            tab == SETTINGS_TAB_NOTIFICATIONS ? ICON_ROUTINE :
            tab == SETTINGS_TAB_ABOUT ? ICON_TEXT : ICON_GEAR,
            tab, APP_NAV_ROUTE_NONE}
        if settings_mobile_hub_row(app, row, content_x, y, content_w, 7600 + i) {
            return
        }
        y += Scale(64)
    }
    row := (SettingsMobileHubRow){GetLocaleText("profile_data"), ICON_SAVE,
                                  SETTINGS_TAB_DEVICE, APP_NAV_ROUTE_DATA}
    unused settings_mobile_hub_row(app, row, content_x, y, content_w, 7690)

}

settings_screen_draw_mobile_hub :: (app: InnerBreeze*) -> int #private {
    side_padding := GetPageSidePadding()
    max_content_w := Scale(CONTENT_MAX_W)
    available := view_width - side_padding * 2
    content_x := 0
    content_w := 0
    content_h := 0
    top := 0
    height := 0

    TitleBar((TitleBarProps){.title = GetLocaleText("settings_title"),
                             .height = AppTitleBarHeight()})

    if max_content_w > available {
        max_content_w = available
    }
    if max_content_w < Scale(280) {
        max_content_w = Scale(280)
    }
    GetCenteredColumn(max_content_w, side_padding, &content_x, &content_w)
    content_h = settings_mobile_hub_content_height(content_w, app)

    top = AppTitleBarHeight() + Scale(8)
    height = view_height - top - app_content_bottom_reserved(app)
    if height < 0 {
        height = 0
    }

    Scroll hub: {
        bounds = (Rectangle){(float)0, (float)top, (float)view_width, (float)height}
        content_height = content_h
        scroll_offset = &app->settings_navigation_scroll
        settings_mobile_hub_draw_content(content_x, (int)hub.y,
                                         content_w, app)
    }
    return 1
}

settings_draw_tab_content :: (app: InnerBreeze*, tab: int, x: int, w: int,
                              y: int*, device_state: SettingsDeviceState*,
                              drawn: int*) #private {
    if drawn != NULL {
        *drawn = 1
    }
    if tab == SETTINGS_TAB_THEME {
        theme_panel.draw(app, x, w, y, &app->theme_state)
        return
    }
    if tab == SETTINGS_TAB_AUDIO {
        settings_audio_draw(app, x, w, y)
        return
    }
    if tab == SETTINGS_TAB_DEVICE {
        settings_device_draw(app, x, w, y, device_state)
        return
    }
    #if DESKTOP {
        if tab == SETTINGS_TAB_BREAKS {
            settings_breaks_draw(app, x, w, y)
            return
        }
    }
    if tab == SETTINGS_TAB_NOTIFICATIONS {
        settings_notifications_draw(app, x, w, y)
        return
    }
    settings_about_draw(app, x, w, y)
}

settings_desktop_layout :: (app: InnerBreeze*, layout: SettingsDesktopLayout*) -> int #private {
    outer_pad := Scale(24)
    header_h := Scale(70)
    gap := Scale(18)
    list_w := Scale(250)
    panel_pad := Scale(26)

    if layout == NULL {
        return 0
    }
    layout->content_x = outer_pad
    layout->content_y = outer_pad
    layout->content_w = view_width - outer_pad * 2
    layout->content_h = view_height - app_content_bottom_reserved(app) - outer_pad * 2
    layout->list_x = layout->content_x
    layout->list_y = layout->content_y + header_h
    layout->list_w = list_w
    layout->list_h = layout->content_h - header_h
    layout->panel_x = layout->list_x + list_w + gap
    layout->panel_y = layout->list_y
    layout->panel_w = layout->content_w - list_w - gap
    layout->panel_h = layout->list_h
    layout->panel_pad = panel_pad

    return layout->content_w >= Scale(640) && layout->panel_w >= Scale(320)
}

settings_desktop_draw_header :: (app: InnerBreeze*, layout: SettingsDesktopLayout) -> int #private {
    return settings_scaffold_title(GetLocaleText("settings_title"), layout.list_y - Scale(12), app)
}

settings_desktop_draw_nav :: (app: InnerBreeze*, layout: SettingsDesktopLayout) #private {
    DrawRectangleRounded((Rectangle){(float)layout.list_x, (float)layout.list_y,
                         (float)layout.list_w, (float)layout.list_h},
                         0.025f, 10, DarkenColor(GetThemeBackground(), 4))
    DrawRectangleRoundedLinesEx((Rectangle){(float)layout.list_x, (float)layout.list_y,
                                (float)layout.list_w, (float)layout.list_h},
                                0.025f, 10, 1.0f, Fade(GetThemeText(), 0.07f))
    Scroll navigation: {
        bounds = {(float)layout.list_x, (float)layout.list_y,
                  (float)layout.list_w, (float)layout.list_h}
        content_height = settings_mobile_hub_content_height(layout.list_w - Scale(20), app)
        scroll_offset = &app->settings_navigation_scroll
        settings_mobile_hub_draw_content(layout.list_x + Scale(10), (int)navigation.y,
                                         layout.list_w - Scale(20), app)
    }

}

settings_desktop_draw_panel :: (app: InnerBreeze*, layout: SettingsDesktopLayout) #private {
    device_state := (SettingsDeviceState){0}
    page_ctx := (SettingsScrollPageContext){app, app != NULL ? app->settings_tab : SETTINGS_TAB_DEVICE}
    y := layout.panel_y + layout.panel_pad
    title := settings_screen_tab_label(app->settings_tab)
    content_h := 0
    drawn := 0

    DrawRectangleRounded((Rectangle){(float)layout.panel_x, (float)layout.panel_y,
                         (float)layout.panel_w, (float)layout.panel_h},
                         0.018f, 10, DarkenColor(GetThemeBackground(), 3))
    DrawRectangleRoundedLinesEx((Rectangle){(float)layout.panel_x, (float)layout.panel_y,
                                (float)layout.panel_w, (float)layout.panel_h},
                                0.018f, 10, 1.0f, Fade(GetThemeText(), 0.07f))
    Text((TextProps){
        .bounds={(float)(layout.panel_x + layout.panel_pad), (float)y,
                 (float)(layout.panel_w - layout.panel_pad * 2), (float)Scale(30)},
        .text=(title),
        .wrap=TextWrapNone
    })
    y += Scale(34) + Scale(18)

    page_ctx.tab = app->settings_tab
    content_h = settings_scroll_page_content_height(
        layout.panel_w - layout.panel_pad * 2, &page_ctx)

    Scroll panel: {
        bounds = {(float)(layout.panel_x + layout.panel_pad), (float)y,
                  (float)(layout.panel_w - layout.panel_pad * 2),
                  (float)(layout.panel_y + layout.panel_h - layout.panel_pad - y)}
        content_height = content_h
        scroll_offset = &app->settings_scroll
        y := (int)panel.y
        settings_draw_tab_content(app, app->settings_tab, (int)panel.x,
                                  (int)panel.width, &y, &device_state, &drawn)
    }

    if app->settings_tab == SETTINGS_TAB_DEVICE {
        settings_device_handle_overlays(app, &device_state)
    }
    if app->settings_tab == SETTINGS_TAB_NOTIFICATIONS {
        settings_notifications_handle_overlays(app)
    }
}

settings_screen_draw_desktop :: (app: InnerBreeze*) -> int #private {
    layout := (SettingsDesktopLayout){0}

    if app == NULL || !settings_desktop_layout(app, &layout) {
        return 0
    }
    if settings_desktop_draw_header(app, layout) {
        return 1
    }
    settings_desktop_draw_nav(app, layout)
    if app->breathing.screen != ScreenSettings {
        return 1
    }
    settings_desktop_draw_panel(app, layout)
    return 1
}

settings_screen_draw :: (app: InnerBreeze*) -> int {

    device_state := (SettingsDeviceState){0}
    page_ctx := (SettingsScrollPageContext){0}
    side_padding := 0
    max_content_w := 0
    available := 0
    content_x := 0
    content_w := 0
    content_h := 0
    top := 0
    height := 0
    y := 0
    drawn := 0
    title := (const char*)NULL

    settings_screen_normalize(app)
    settings_screen_prepare(app)
    if app_settings_wide_layout(app) {
        app->settings_overview = 0
        settings_screen_draw_desktop(app)
        return 0
    }
    if app->settings_overview {
        settings_screen_draw_mobile_hub(app)
        return 0
    }

    title = settings_screen_tab_label(app->settings_tab)
    page_ctx = (SettingsScrollPageContext){app, app->settings_tab}
    if settings_scaffold_title(title, AppTitleBarHeight(), app) {
        return 0
    }

    side_padding = GetPageSidePadding()
    max_content_w = Scale(CONTENT_MAX_W)
    available = view_width - side_padding * 2
    if max_content_w > available {
        max_content_w = available
    }
    if max_content_w < Scale(320) {
        max_content_w = Scale(320)
    }
    GetCenteredColumn(max_content_w, side_padding, &content_x, &content_w)
    content_h = settings_scroll_page_content_height(content_w, &page_ctx)

    top = AppTitleBarHeight() + Scale(8)
    height = view_height - top - app_content_bottom_reserved(app)
    if height < 0 {
        height = 0
    }

    Scroll page: {
        bounds = (Rectangle){(float)0, (float)top, (float)view_width, (float)height}
        content_height = content_h
        scroll_offset = &app->settings_scroll
        y := (int)page.y
        settings_draw_tab_content(app, app->settings_tab, content_x,
                                  content_w, &y, &device_state, &drawn)
    }

    if app->settings_tab == SETTINGS_TAB_DEVICE {
        settings_device_handle_overlays(app, &device_state)
    }
    if app->settings_tab == SETTINGS_TAB_NOTIFICATIONS {
        settings_notifications_handle_overlays(app)
    }

    return 0
}

route settings {
    title "Settings"
    group "App"
    page settings
}

settings :: (app: InnerBreeze*) #ui {
    Screen root: {
    unused settings_screen_draw(app)
    }
}
