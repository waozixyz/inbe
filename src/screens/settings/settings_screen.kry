#import "app.h"
#import "app_nav.h"
#import "app/app_settings.h"
#import "locale.h"
#import "settings_about.h"
#import "screens/settings/settings_data_ui.h"
#import "screens/settings/settings_device.h"
#import "screens/settings/settings_types.h"
#import "string.h"
#import "theme.h"
#import "ui.h"

SettingsScrollPageContext :: struct {
    app: InbeApp*
    tab: int
}

theme_panel :: #import "src/screens/settings/settings_theme"
ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)

state {
    unified_status: [256] char = ""
    unified_detail: [256] char = ""
    unified_status_type: int = 0
}

settings_screen_set_status_success :: (message: const char*, detail: const char*) {
    if message != NULL {
        strncpy(unified_status, message, sizeof(unified_status) - 1)
        unified_status[sizeof(unified_status) - 1] = '\0'
    } else {
        unified_status[0] = '\0'
    }
    if detail != NULL {
        strncpy(unified_detail, detail, sizeof(unified_detail) - 1)
        unified_detail[sizeof(unified_detail) - 1] = '\0'
    } else {
        unified_detail[0] = '\0'
    }
    unified_status_type = 1
}

settings_screen_set_status_error :: (message: const char*) {
    if message != NULL {
        strncpy(unified_status, message, sizeof(unified_status) - 1)
        unified_status[sizeof(unified_status) - 1] = '\0'
    } else {
        unified_status[0] = '\0'
    }
    unified_detail[0] = '\0'
    unified_status_type = 2
}

settings_screen_clear_status :: () {
    unified_status[0] = '\0'
    unified_detail[0] = '\0'
    unified_status_type = 0
}

settings_draw_status :: (x: int, y: int*) #private {
    status_font := 0
    status_color := (Color){0}

    if unified_status[0] == '\0' {
        return
    }
    status_font = GetUISmallFontSize()
    status_color = unified_status_type == 2 ? RED : GetThemeText()
    UITextNode(unified_status, x, *y, status_font, status_color)
    *y += ScaleUIPx(18)
    if unified_detail[0] != '\0' {
        UITextNode(unified_detail, x, *y, status_font, DarkenUIColor(GetThemeText(), 40))
        *y += ScaleUIPx(18)
    }
}

settings_screen_draw_status_reserved :: (x: int, y: int*, reserved_h: int) {
    status_y := *y

    settings_draw_status(x, &status_y)
    *y += reserved_h
}

settings_tab_content_height :: (app: InbeApp*, tab: int, content_w: int) -> int #private {
    unused app
    if tab == SETTINGS_TAB_THEME {
        return theme_panel.content_height(content_w)
    }
    if tab == SETTINGS_TAB_DEVICE {
        return settings_device_content_height(content_w)
    }
    return settings_about_content_height(content_w)
}

settings_scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (SettingsScrollPageContext*)user_data
    planned_content_w := content_w - ScaleUIPx(16)

    if planned_content_w < ScaleUIPx(160) {
        planned_content_w = content_w
    }
    return settings_tab_content_height(ctx->app, ctx->tab, planned_content_w)
}

settings_screen_tab_label :: (tab: int) -> const char* {
    if tab == SETTINGS_TAB_DEVICE {
        return GetLocaleText("settings_tab_device")
    }
    if tab == SETTINGS_TAB_THEME {
        return GetLocaleText("settings_section_appearance")
    }
    if tab == SETTINGS_TAB_ABOUT {
        return GetLocaleText("settings_tab_about")
    }
    return GetLocaleText("settings_title")
}

settings_draw_section_header :: (app: InbeApp*, tab: int) #private {
    header_h := UIGetNodeHeight(UINodeTabBar((UITabBar){0}))
    title := settings_screen_tab_label(tab)

    if app_draw_close_title_bar(app, title, header_h) {
        app->settings_scroll = 0
        if app->modal.type == UIModalThemePicker {
            app_close_modal(app)
        }
        settings_screen_clear_status()
        if app_return_to_nav_sidebar_if_needed(app) {
            return
        }
        app_switch_screen(app, app->main_tab == APP_MAIN_TAB_HABITS ? InbeScreenHabits : InbeScreenStart)
    }
}

settings_screen_draw :: (app: InbeApp*) -> int {
    detail_header_h := 0
    tab_content_start_y := 0
    content_viewport_h := 0
    device_state := (SettingsDeviceState){0}
    page_ctx := (SettingsScrollPageContext){0}
    page := (UIScrollPage){0}
    y := 0

    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        app->settings_drag_slider = 0
    }

    if app->settings_tab < 0 || app->settings_tab >= SETTINGS_TAB_COUNT {
        app->settings_tab = SETTINGS_TAB_DEVICE
    }

    detail_header_h = UIGetNodeHeight(UINodeTabBar((UITabBar){0}))
    tab_content_start_y = detail_header_h
    tab_content_start_y += ScaleUIPx(8)
    content_viewport_h = view_height - tab_content_start_y - app_content_bottom_reserved(app)

    #if ANDROID {
        settings_data_handle_android_import(app)
    } #else_if WEB {
        settings_data_handle_web_import(app)
    }

    if content_viewport_h < 0 {
        content_viewport_h = 0
    }

    settings_draw_section_header(app, app->settings_tab)
    page_ctx = (SettingsScrollPageContext){app, app->settings_tab}
    page = BeginUIScrollPage((UIScrollPageSpec){.y = tab_content_start_y, .height = content_viewport_h, .max_content_width = ScaleUIPx(CONTENT_MAX_W), .min_content_width = ScaleUIPx(320), .scroll_offset = &app->settings_scroll, .content_height = settings_scroll_page_content_height, .user_data = &page_ctx})
    y = page.content_y

    if app->settings_tab == SETTINGS_TAB_THEME {
        theme_panel.draw(app, page.content_x, page.content_w,
                            &y, &app->theme_state)
    } else if app->settings_tab == SETTINGS_TAB_DEVICE {
        settings_device_draw(app, page.content_x, page.content_w, &y, &device_state)
    } else {
        settings_about_draw(app, page.content_x, page.content_w, &y)
    }

    EndUIScrollPage(page)
    SetUIDropdownClipTop(tab_content_start_y)
    SetUIDropdownClipBottom(view_height - app_content_bottom_reserved(app))
    if app->settings_tab == SETTINGS_TAB_DEVICE {
        settings_device_handle_overlays(app, &device_state)
    }
    SetUIDropdownClipTop(0)
    SetUIDropdownClipBottom(0)
    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) && app->settings_dirty && app->settings_save_delay_ticks <= 0 {
        save_settings(app)
    }

    return 0
}

route settings {
    title "Settings"
    group "App"
    page settings
}

screen settings {
    args InbeApp *app
    unused settings_screen_draw(app)
}
