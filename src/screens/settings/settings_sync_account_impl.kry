#module "settings.sync_account"

#import "screens/settings/settings_screen.h"
#import "app/app.h"
#import "storage/sync_account.h"
#import "screens/profile_social.h"
#import "storage.h"
#import "sync_account.h"
#import "sync_client.h"
#import "stdio.h"
#import "string.h"

ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)

SettingsSyncKeySaveDialog :: int (*)(InnerBreeze*, const char*) #type
SettingsSyncKeyImportDialog :: int (*)(InnerBreeze*) #type

#enum {
    PENDING_SYNC_ACCOUNT_NONE = 0
}

static sync_server_url_key: const char* = "sync_server_url"
static sync_server_url_default: const char* = "https://api.waozi.xyz"
static sync_account_alias_key: const char* = "sync_account_alias"

static save_dialog_callback: SettingsSyncKeySaveDialog = nil
static import_dialog_callback: SettingsSyncKeyImportDialog = nil
static public_id_field_cursor: int = 0
static public_id_field_focused: int = 0

set_save_dialog :: (callback: SettingsSyncKeySaveDialog) {
    save_dialog_callback = callback
}

set_import_dialog :: (callback: SettingsSyncKeyImportDialog) {
    import_dialog_callback = callback
}

draw_public_id_link :: (text: const char*, x: int, w: int, y: int*, font: int) -> int #private {
    link_h: int
    clicked := 0

    if text == nil || y == nil {
        return 0
    }

    link_h = AppTextLineHeight(font) + Scale(8)
    if link_h < Scale(28) {
        link_h = Scale(28)
    }

    clicked = Link((LinkProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)link_h},
        .text = text,
        .focus_id = 5201
    })
    *y += link_h

    return clicked
}

draw_public_id_field :: (text: const char*, x: int, w: int, y: int*, font: int) #private {
    field_text: [SYNC_PUBLIC_ID_HEX_SIZE] char = {0}
    field_h := Scale(38)

    if text == nil || y == nil {
        return
    }
    unused font

    snprintf(field_text, sizeof(field_text), "%s", text)
    if public_id_field_cursor > (int)strlen(field_text) {
        public_id_field_cursor = (int)strlen(field_text)
    }
    TextField((TextFieldProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)field_h},
        .text = field_text,
        .text_size = sizeof(field_text),
        .cursor_position = &public_id_field_cursor,
        .focused = &public_id_field_focused,
        .max_codepoints = (int)strlen(field_text),
        .focus_id = 9421,
        .read_only = 1,
    })
    *y += field_h
}

compact_public_id :: (public_id: const char*, out: char*, out_size: size_t) #private {
    len: size_t

    if out == nil || out_size == 0 {
        return
    }

    out[0] = '\0'
    if public_id == nil {
        return
    }

    len = strlen(public_id)
    if len <= 12 {
        snprintf(out, out_size, "%s", public_id)
        return
    }

    snprintf(out, out_size, "%.*s...%.*s",
                4, public_id, 4, public_id + len - 4)
}

backup_filename :: (out: char*, out_size: size_t) #private {
    if out == nil || out_size == 0 {
        return
    }
    snprintf(out, out_size, "account.key")
}

start_sync_key_export :: (app: InnerBreeze*, account: const SyncAccount*) -> int #private {
    filename: [64] char

    backup_filename(filename, sizeof(filename))

    #if ANDROID || WEB {
        unused app
        return sync_account_export_private_key(account, filename) ? 2 : 3
    } #else {
        if save_dialog_callback != nil {
            return save_dialog_callback(app, filename)
        }
        return sync_account_export_private_key(account, filename) ? 2 : 3
    }
}

start_sync_key_import :: (app: InnerBreeze*) -> int #private {
    if import_dialog_callback != nil {
        return import_dialog_callback(app)
    }
    return 0
}

alias_normalize :: (text: char*) #private {
    out: [40] char
    n := 0

    if text == nil {
        return
    }

    for int i = 0; text[i] != '\0' && n < (int)sizeof(out) - 1; i++ {
        ch := (unsigned char)text[i]

        if ch == '@' && n == 0 {
            continue
        }
        if ch >= 'A' && ch <= 'Z' {
            ch = (unsigned char)(ch - 'A' + 'a')
        }
        if (ch >= 'a' && ch <= 'z') ||
           (ch >= '0' && ch <= '9') ||
           ch == '_' {
            out[n] = (char)ch
            n++
        }
    }

    out[n] = '\0'
    snprintf(text, 40, "%s", out)
}

alias_valid :: (text: const char*) -> int #private {
    len: size_t

    if text == nil {
        return 0
    }

    len = strlen(text)
    if len < 4 || len > 32 {
        return 0
    }

    for size_t i = 0; i < len; i++ {
        ch := text[i]

        if (ch >= 'a' && ch <= 'z') ||
           (ch >= '0' && ch <= '9') ||
           ch == '_' {
            continue
        }
        return 0
    }

    return 1
}

server_normalize :: (app: InnerBreeze*, out: char*, out_size: size_t) -> int #private {
    if app == nil || out == nil || out_size == 0 {
        return 0
    }
    if !sync_client_normalize_url(app->sync_server_url, out, out_size) {
        return 0
    }
    snprintf(app->sync_server_url, sizeof(app->sync_server_url), "%s", out)
    app->sync_server_url_cursor = (int)strlen(app->sync_server_url)
    return 1
}

server_save :: (app: InnerBreeze*) #private {
    url: [sizeof(app->sync_server_url)] char

    if app == nil {
        return
    }
    if !server_normalize(app, url, sizeof(url)) {
        settings_screen_set_status_error(GetLocaleText("sync_server_url_invalid"))
        return
    }
    storage_set_setting_text(sync_server_url_key, url)
    storage_set_sync_enabled(0)
    settings_screen_set_status_success(GetLocaleText("sync_server_saved"), url)
}

open_alias_modal :: (app: InnerBreeze*, then_backup: int) #private {
    alias: const char* = nil

    if app == nil {
        return
    }

    alias = storage_get_setting_text(sync_account_alias_key)
    snprintf(app->sync_alias_input, sizeof(app->sync_alias_input), "%s",
                alias != nil ? alias : "")
    alias_normalize(app->sync_alias_input)
    app->sync_alias_cursor = (int)strlen(app->sync_alias_input)
    app->sync_alias_focused = 1
    app->sync_alias_then_backup = then_backup
    app_open_modal(app, UIModalSyncAlias)
}

save_prepared :: (app: InnerBreeze*, account: SyncAccount*,
                     action: int, local_data_choice: SyncAccountLocalDataChoice) -> int {
    result: SyncAccountSaveResult
    owner: const char* = nil
    replacing_local_data: int = 0

    if app == nil || account == nil {
        return 0
    }

    owner = storage_sync_data_owner_public_id()
    replacing_local_data = action == PendingSyncAccountImport &&
    storage_has_local_syncable_data() &&
    (owner == nil || owner[0] == '\0' || strcmp(owner, account->public_id) != 0)
    if replacing_local_data &&
       local_data_choice == SYNC_ACCOUNT_LOCAL_DATA_ASK {
        app->pending_sync_account = *account
        app->pending_sync_account_action = action
        app_open_modal(app, UIModalConfirmSyncAccountSwitch)
        return 0
    }
    if replacing_local_data &&
       local_data_choice == SYNC_ACCOUNT_LOCAL_DATA_REPLACE &&
       !storage_clear_local_syncable_data() {
        return 0
    }

    TraceLog(LOG_WARNING, "SYNC: save_prepared calling sync_account_save...")
    result = sync_account_save(account, local_data_choice)
    TraceLog(LOG_WARNING, "SYNC: sync_account_save result=%d", result)
    if result == SYNC_ACCOUNT_SAVE_NEEDS_CLEAR {
        app->pending_sync_account = *account
        app->pending_sync_account_action = action
        app_open_modal(app, UIModalConfirmSyncAccountSwitch)
        return 0
    }
    if result != SYNC_ACCOUNT_SAVE_OK {
        return 0
    }

    app->pending_sync_account_action = PendingSyncAccountNone
    memset(&app->pending_sync_account, 0, sizeof(app->pending_sync_account))

    if action == PendingSyncAccountCreate {
        settings_screen_set_status_success(GetLocaleText("sync_account_created"), nil)
    } else {
        if app->sync_server_url[0] == '\0' {
            saved_url := storage_get_setting_text(sync_server_url_key)
            snprintf(app->sync_server_url, sizeof(app->sync_server_url), "%s",
                     saved_url != nil && saved_url[0] != '\0' ? saved_url : sync_server_url_default)
        }
        TraceLog(LOG_WARNING, "SYNC: calling run_connect...")
        run_connect(app)
        TraceLog(LOG_WARNING, "SYNC: Private key restored; synchronization requested")
    }

    return 1
}

draw_account_id :: (app: InnerBreeze*, account: const SyncAccount*,
                   x: int, w: int, y: int*, small_font: int) #private {
    alias := storage_get_setting_text(sync_account_alias_key)
    display: [96] char

    if account == nil {
        return
    }

    if alias != nil && alias[0] != '\0' {
        snprintf(display, sizeof(display), "@%s", alias)
    } else {
        compact_public_id(account->public_id, display, sizeof(display))
    }

    if draw_public_id_link(display, x, w, y, small_font) && app != nil {
        app_open_modal(app, UIModalSyncPublicId)
    }
}

server_connected :: (app: InnerBreeze*) -> int #private {
    url: [sizeof(app->sync_server_url)] char
    saved_url: const char* = nil
    saved_normalized: [sizeof(app->sync_server_url)] char
    account: SyncAccount

    if app == nil || !sync_account_load(&account) {
        return 0
    }
    if !storage_sync_enabled() {
        return 0
    }
    if !sync_client_normalize_url(app->sync_server_url, url, sizeof(url)) {
        return 0
    }

    saved_url = storage_get_setting_text(sync_server_url_key)
    if !sync_client_normalize_url(saved_url, saved_normalized,
                                  sizeof(saved_normalized)) {
        return 0
    }

    return strcmp(saved_normalized, url) == 0
}


create_account :: (app: InnerBreeze*, account: SyncAccount*) -> int #private {
    if account == nil {
        return 0
    }

    if !sync_account_generate(account) {
        settings_screen_set_status_error(GetLocaleText("sync_account_create_failed"))
        return 0
    }

    if save_prepared(app, account, PendingSyncAccountCreate, 0) {
        return 1
    }

    if app == nil || app->modal.type != UIModalConfirmSyncAccountSwitch {
        settings_screen_set_status_error(GetLocaleText("sync_account_create_failed"))
    }

    return 0
}

run_connect :: (app: InnerBreeze*) #private {
    url: [sizeof(app->sync_server_url)] char
    account: SyncAccount

    if app == nil {
        return
    }
    if !sync_account_load(&account) {
        storage_set_sync_enabled(0)
        settings_screen_set_status_error(GetLocaleText("sync_no_account"))
        return
    }
    if !server_normalize(app, url, sizeof(url)) {
        storage_set_sync_enabled(0)
        settings_screen_set_status_error(GetLocaleText("sync_server_url_invalid"))
        return
    }

    storage_set_setting_text(sync_server_url_key, url)
    storage_set_sync_enabled(1)
    settings_screen_clear_status()
    app_auto_sync(app)
}

connect :: (app: InnerBreeze*) {
    run_connect(app)
}

logout :: (app: InnerBreeze*) #private {
    if app == nil {
        return
    }
    sync_account_clear()
    settings_screen_set_status_success(
        GetLocaleText("sync_logged_out_local_data_kept"), nil)
}

clear_remote_confirmed :: (app: InnerBreeze*) {
    account: SyncAccount
    result: SyncResult
    url: [sizeof(app->sync_server_url)] char

    if app == nil {
        return
    }
    if !sync_account_load(&account) {
        settings_screen_set_status_error(GetLocaleText("sync_no_account"))
        return
    }

    if server_connected(app) &&
       sync_client_normalize_url(storage_get_setting_text(sync_server_url_key),
                                 url, sizeof(url)) {
        result = sync_client_delete_account(url)
        if result != SYNC_OK {
            TraceLog(LOG_WARNING, "SYNC: remote account delete failed: %d", result)
        }
    } else {
        TraceLog(LOG_WARNING, "SYNC: remote account delete skipped due to invalid URL")
    }

    sync_account_clear()
    settings_screen_set_status_success(GetLocaleText("sync_remote_data_cleared"), nil)
}

SettingsSyncButton :: struct {
    label: const char*
    tone: ButtonTone
    emphasis: ButtonEmphasis
    disabled: int
}

SettingsSyncButtonRow :: struct {
    x: int
    y: int
    width: int
    height: int
    gap: int
    items: const SettingsSyncButton*
    count: int
}

button_min_width :: (label: const char*) -> int #private {
    return AppTextWidth(label != nil ? label : "", AppSmallFontSize()) +
           Scale(20)
}

button_group_fits :: (items: const SettingsSyncButton*, start: int, count: int,
                     width: int, gap: int) -> int #private {
    button_w: int

    if items == nil || count <= 0 || width <= 0 {
        return 0
    }

    button_w = (width - gap * (count - 1)) / count
    if button_w <= 0 {
        return 0
    }

    for int i = 0; i < count; i++ {
        if button_min_width(items[start + i].label) > button_w {
            return 0
        }
    }

    return 1
}

button_group_count :: (items: const SettingsSyncButton*, start: int, count: int,
                      width: int, gap: int) -> int #private {
    for int row_count = count; row_count > 1; row_count-- {
        if button_group_fits(items, start, row_count, width, gap) {
            return row_count
        }
    }
    return 1
}

draw_adaptive_button_row :: (row: SettingsSyncButtonRow, height_out: int*) -> int #private {
    clicked := -1
    gap := row.gap > 0 ? row.gap : Scale(10)
    draw_y := row.y
    index := 0

    if height_out != nil {
        *height_out = 0
    }
    if row.items == nil || row.count <= 0 || row.width <= 0 || row.height <= 0 {
        return -1
    }

    while index < row.count {
        count := button_group_count(row.items, index, row.count - index,
                                    row.width, gap)
        button_w := (row.width - gap * (count - 1)) / count

        for int i = 0; i < count; i++ {
            item_index := index + i
            button_x := row.x + i * (button_w + gap)
            draw_w := i == count - 1 ? row.x + row.width - button_x : button_w

            if Button((ButtonProps){
                    .bounds = {(float)button_x, (float)draw_y,
                               (float)draw_w, (float)row.height},
                    .label = row.items[item_index].label,
                    .tone = row.items[item_index].tone,
                    .emphasis = row.items[item_index].emphasis,
                    .disabled = row.items[item_index].disabled,
                }) {
                clicked = item_index
            }
        }

        index += count
        draw_y += row.height
        if index < row.count {
            draw_y += gap
        }
    }

    if height_out != nil {
        *height_out = draw_y - row.y
    }

    return clicked
}

adaptive_button_row_height :: (items: const SettingsSyncButton*, count: int,
                              width: int, button_h: int, gap: int) -> int #private {
    height := 0
    index := 0

    if items == nil || count <= 0 || width <= 0 || button_h <= 0 {
        return 0
    }

    while index < count {
        row_count := button_group_count(items, index, count - index, width, gap)

        height += button_h
        index += row_count
        if index < count {
            height += gap
        }
    }

    return height
}

draw_connected_header :: (account: const SyncAccount*,
                          x: int, w: int, y: int*) #private {
    alias := storage_get_setting_text(sync_account_alias_key)
    identity: [96] char = {0}
    title: [160] char = {0}
    status_text: [160] char = {0}
    sync_status: StorageSyncStatus
    up_to_date := 0
    card_h := Scale(88)
    icon_box := Scale(36)
    icon_size := Scale(19)

    if alias != nil && alias[0] != '\0' {
        snprintf(identity, sizeof(identity), "@%s", alias)
    } else {
        compact_public_id(account->public_id, identity, sizeof(identity))
    }
    FormatLocaleText(title, sizeof(title), "sync_connected_as", identity)
    if storage_sync_status(&sync_status) {
        up_to_date = sync_status.enabled && sync_status.server_version > 0 &&
                     sync_status.queued_changes == 0 &&
                     !sync_status.review_pending && !app_sync_loading() &&
                     !app_social_refresh_loading() &&
                     storage_get_setting_int("sync_last_result", SYNC_OK) == SYNC_OK
    }
    if up_to_date {
        snprintf(status_text, sizeof(status_text), "%s",
                 GetLocaleText("sync_everything_up_to_date"))
    } else {
        app_sync_progress_text(status_text, sizeof(status_text))
    }

    Card((CardProps){.bounds = {(float)x, (float)*y, (float)w, (float)card_h}})
    Circle(x + Scale(28), *y + Scale(28), icon_box / 2,
           LightenColor(StyleTokenColor("accent"), 10))
    Icon(0, x + Scale(28) - icon_size / 2,
         *y + Scale(28) - icon_size / 2, icon_size, ICON_CHECK, WHITE)
    Text((TextProps){
        .bounds = {(float)(x + Scale(54)), (float)(*y + Scale(15)),
                   (float)(w - Scale(68)), (float)Scale(24)},
        .text = title,
        .font = AppFontSize(),
        .wrap = TextWrapNone
    })
    Text((TextProps){
        .bounds = {(float)(x + Scale(54)), (float)(*y + Scale(43)),
                   (float)(w - Scale(68)), (float)Scale(26)},
        .text = status_text,
        .font = AppSmallFontSize(),
        .disabled = !up_to_date
    })
    *y += card_h
}

draw_sync_step :: (x: int, w: int, y: int*, label: const char*,
                  complete: int) #private {
    icon_size := Scale(16)
    Circle(x + Scale(13), *y + Scale(17), Scale(11),
           complete ? LightenColor(StyleTokenColor("accent"), 10)
                    : DarkenColor(StyleTokenColor("canvas"), 8))
    if complete {
        Icon(0, x + Scale(13) - icon_size / 2,
             *y + Scale(17) - icon_size / 2, icon_size, ICON_CHECK, WHITE)
    }
    Text((TextProps){
        .bounds = {(float)(x + Scale(34)), (float)(*y + Scale(5)),
                   (float)(w - Scale(34)), (float)Scale(26)},
        .text = label,
        .font = AppSmallFontSize(),
        .disabled = !complete,
        .wrap = TextWrapNone
    })
    *y += Scale(36)
}

draw_sync_metric :: (x: int, y: int, w: int, label: const char*,
                     value: int) #private {
    value_text: [24] char = {0}
    card_h := Scale(62)
    snprintf(value_text, sizeof(value_text), "%d", value)
    Card((CardProps){.bounds = {(float)x, (float)y, (float)w, (float)card_h}})
    Text((TextProps){
        .bounds = {(float)(x + Scale(12)), (float)(y + Scale(9)),
                   (float)(w - Scale(24)), (float)Scale(23)},
        .text = value_text,
        .font = Scale(20),
        .wrap = TextWrapNone
    })
    Text((TextProps){
        .bounds = {(float)(x + Scale(12)), (float)(y + Scale(34)),
                   (float)(w - Scale(24)), (float)Scale(20)},
        .text = label,
        .font = AppSmallFontSize(),
        .disabled = 1,
        .wrap = TextWrapNone
    })
}

config_content_height :: (content_w: int) -> int {
    account: SyncAccount
    has_account := sync_account_load(&account)
    btn_h := Scale(36)
    gap := Scale(10)
    h := 0

    if content_w <= 0 {
        content_w = Scale(320)
    }

    if !has_account {
        buttons: [2] SettingsSyncButton = {
            {GetLocaleText("sync_create_account_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
            {GetLocaleText("sync_import_key_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
        }

        h += Scale(12)
        h += adaptive_button_row_height(buttons, 2, content_w, btn_h, gap)
        h += Scale(18)
        h += Scale(42)
        return h
    }

    h += Scale(88) + Scale(16)
    h += Scale(108) + Scale(16)
    h += Scale(202) + Scale(16)
    buttons_main: [2] SettingsSyncButton = {
        {GetLocaleText("sync_backup_key_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_now_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
    }
    h += adaptive_button_row_height(buttons_main, 2, content_w, btn_h, gap)
    h += Scale(12)
    buttons_account: [2] SettingsSyncButton = {
        {GetLocaleText("sync_copy_id_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_alias_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
    }
    h += adaptive_button_row_height(buttons_account, 2, content_w, btn_h, gap)
    h += Scale(12) + Scale(18) + btn_h + Scale(12) + btn_h + Scale(12)
    h += btn_h + Scale(12) + btn_h + Scale(12)
    h += Scale(42)

    return h
}

draw :: (app: InnerBreeze*, x: int, w: int, y: int*) {
    account: SyncAccount
    has_account := sync_account_load(&account)
    font := AppFontSize()
    small_font := AppSmallFontSize()
    btn_h := Scale(36)
    gap := Scale(10)


    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("sync_account_title")),
        .wrap=TextWrapNone
    })
    *y += Scale(26)

    if !has_account {
        if Button((ButtonProps){
            .bounds = {(float)(x), (float)(*y), (float)(w), (float)(btn_h)},
            .label = GetLocaleText("sync_create_account_button"),
            .tone = ButtonToneAccent,
            .emphasis = ButtonEmphasisFilled,
            .disabled = 0
        }) {
            create_account(app, &account)
        }
        *y += btn_h + Scale(18)
        return
    }

    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("sync_public_id_label")),
        .wrap=TextWrapNone
    })
    *y += Scale(18)
    draw_account_id(app, &account, x, w, y, small_font)
    *y += Scale(4)

    buttons: [3] SettingsSyncButton = {
        {GetLocaleText("sync_copy_id_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_alias_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_backup_key_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
    }
    row_h := 0
    clicked := draw_adaptive_button_row((SettingsSyncButtonRow){
        .x = x,
        .y = *y,
        .width = w,
        .height = btn_h,
        .gap = gap,
        .items = buttons,
        .count = 3,
    }, &row_h)

    if clicked == 0 {
        SetClipboardText(account.public_id)
        settings_screen_set_status_success(GetLocaleText("sync_public_id_copied"), nil)
    } else if clicked == 1 {
        open_alias_modal(app, 0)
    } else if clicked == 2 {
        app_open_modal(app, UIModalSyncAccountBackup)
    }

    *y += row_h
    *y += Scale(16)
}

draw_config :: (app: InnerBreeze*, x: int, w: int, y: int*) {
    account: SyncAccount
    has_account := sync_account_load(&account)
    btn_h := Scale(36)
    gap := Scale(10)
    sync_status: StorageSyncStatus = {0}
    list_count: int = 0
    item_count: int = 0

    if app != nil && app->sync_server_url[0] == '\0' {
        saved: const char* = nil

        saved = storage_get_setting_text(sync_server_url_key)
        snprintf(app->sync_server_url, sizeof(app->sync_server_url), "%s",
                    saved != nil && saved[0] != '\0'
                        ? saved
                        : sync_server_url_default)
        app->sync_server_url_cursor = (int)strlen(app->sync_server_url)
    }

    if !has_account {
        buttons: [2] SettingsSyncButton = {
            {GetLocaleText("sync_create_account_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
            {GetLocaleText("sync_import_key_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
        }
        row_h := 0
        clicked: int

        *y += Scale(12)
        clicked = draw_adaptive_button_row((SettingsSyncButtonRow){
            .x = x,
            .y = *y,
            .width = w,
            .height = btn_h,
            .gap = gap,
            .items = buttons,
            .count = 2,
        }, &row_h)

        if clicked == 0 {
            has_account = create_account(app, &account)
        } else if clicked == 1 {
            if !start_sync_key_import(app) {
                settings_screen_set_status_error(
                    GetLocaleText("sync_private_key_import_failed"))
            }
        }
        *y += row_h + Scale(18)
    }

    if !has_account {
        settings_screen_draw_status_reserved(x, y, Scale(42))
        return
    }

    draw_connected_header(&account, x, w, y)
    *y += Scale(16)
    storage_sync_status(&sync_status)
    draw_sync_step(x, w, y, GetLocaleText("sync_step_account_connected"), 1)
    draw_sync_step(x, w, y, GetLocaleText("sync_step_data_restored"),
                   sync_status.server_version > 0)
    draw_sync_step(x, w, y, GetLocaleText("sync_step_automatic_on"),
                   sync_status.enabled)
    *y += Scale(16)

    metric_gap := Scale(8)
    metric_w := (w - metric_gap) / 2
    draw_sync_metric(x, *y, metric_w, GetLocaleText("profile_habits_label"),
                     storage_habit_count())
    draw_sync_metric(x + metric_w + metric_gap, *y, w - metric_w - metric_gap,
                     GetLocaleText("sync_history_days_label"),
                     storage_habit_day_count())
    *y += Scale(70)
    draw_sync_metric(x, *y, metric_w, GetLocaleText("profile_sessions_label"),
                     storage_session_count())
    draw_sync_metric(x + metric_w + metric_gap, *y, w - metric_w - metric_gap,
                     GetLocaleText("profile_friends_title"),
                     profile_social_friends_count(app))
    *y += Scale(70)
    storage_elist_counts(&list_count, &item_count)
    draw_sync_metric(x, *y, metric_w, GetLocaleText("sync_lists_label"),
                     list_count)
    draw_sync_metric(x + metric_w + metric_gap, *y, w - metric_w - metric_gap,
                     GetLocaleText("sync_list_items_label"), item_count)
    *y += Scale(62) + Scale(16)

    buttons_main: [2] SettingsSyncButton = {
        {GetLocaleText("sync_backup_key_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_now_button"), ButtonToneAccent, ButtonEmphasisFilled,
         app_sync_loading()},
    }
    row_h_main := 0
    clicked_main := draw_adaptive_button_row((SettingsSyncButtonRow){
        .x = x,
        .y = *y,
        .width = w,
        .height = btn_h,
        .gap = gap,
        .items = buttons_main,
        .count = 2,
    }, &row_h_main)

    if clicked_main == 0 {
        app_open_modal(app, UIModalSyncAccountBackup)
    } else if clicked_main == 1 {
        run_connect(app)
    }
    *y += row_h_main
    *y += Scale(12)

    buttons_account: [2] SettingsSyncButton = {
        {GetLocaleText("sync_copy_id_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
        {GetLocaleText("sync_alias_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
    }
    row_h_account := 0
    clicked_account := draw_adaptive_button_row((SettingsSyncButtonRow){
        .x = x, .y = *y, .width = w, .height = btn_h, .gap = gap,
        .items = buttons_account, .count = 2,
    }, &row_h_account)
    if clicked_account == 0 {
        SetClipboardText(account.public_id)
        settings_screen_set_status_success(GetLocaleText("sync_public_id_copied"), nil)
    } else if clicked_account == 1 {
        open_alias_modal(app, 0)
    }
    *y += row_h_account + Scale(12)

    Text((TextProps){.bounds = {(float)x, (float)*y, 0, 0},
                     .text = GetLocaleText("sync_remote_label"),
                     .wrap = TextWrapNone})
    *y += Scale(18)
    commit := 0
    TextField((TextFieldProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)btn_h},
        .text = app->sync_server_url,
        .text_size = sizeof(app->sync_server_url),
        .cursor_position = &app->sync_server_url_cursor,
        .focused = &app->sync_server_url_focused,
        .max_codepoints = 255,
        .commit_pressed = &commit,
    })
    if commit {
        server_save(app)
    }
    *y += btn_h + Scale(12)
    if Button((ButtonProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)btn_h},
        .label = GetLocaleText("save_button"),
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        server_save(app)
    }
    *y += btn_h + Scale(12)

    if Button((ButtonProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)btn_h},
        .label = GetLocaleText("sync_logout_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft
    }) {
        logout(app)
    }
    *y += btn_h + Scale(12)
    if Button((ButtonProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)btn_h},
        .label = GetLocaleText("sync_clear_remote_data_button"),
        .tone = ButtonToneDanger,
        .emphasis = ButtonEmphasisSoft
    }) {
        app_open_modal(app, UIModalConfirmDeleteSyncAccount)
    }
    *y += btn_h + Scale(12)

    settings_screen_draw_status_reserved(x, y, Scale(42))
}

draw_backup_modal :: (app: InnerBreeze*) -> int {
    frame: UIPanelFrame
    account: SyncAccount
    btn_h := Scale(36)
    gap := Scale(10)
    pad_bottom := Scale(24)
    text_button_gap := Scale(40)

    y: int
    modal_h: int
    button_y: int
    warning: ParagraphSpec

    memset(&account, 0, sizeof(account))
    sync_account_load(&account)

    warning = (ParagraphSpec){
        .text = GetLocaleText("sync_backup_warning"),
        .width = Scale(336) - Scale(36),
    }
    modal_h = Scale(58) +
              AppParagraphHeight(warning.text, warning.width,
                                 warning.font, warning.line_gap) +
              text_button_gap +
              btn_h * 2 + gap +
              pad_bottom
    if modal_h < Scale(224) {
        modal_h = Scale(224)
    }

    frame = AppModalFrame(Scale(336), modal_h,
                             GetLocaleText("sync_backup_title"),
                             0, 0)
    y = frame.content_y
    warning.width = frame.content_w
    Paragraph(warning, frame.content_x, &y)

    button_y = y + text_button_gap
    if button_y + btn_h * 2 + gap + pad_bottom > frame.y + frame.h {
        button_y = frame.y + frame.h - pad_bottom - btn_h * 2 - gap
    }
    if Button((ButtonProps){
        .bounds = {(float)(frame.content_x), (float)(button_y), (float)(frame.content_w), (float)(btn_h)},
        .label = GetLocaleText("sync_save_key_file_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = 0
    }) {
        return start_sync_key_export(app, &account)
    }
    if Button((ButtonProps){
        .bounds = {(float)(frame.content_x), (float)(button_y + btn_h + gap), (float)(frame.content_w), (float)(btn_h)},
        .label = GetLocaleText("close_button"),
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .disabled = 0
    }) {
        return 1
    }

    return 0
}

draw_alias_modal :: (app: InnerBreeze*) -> int {
    frame: UIPanelFrame
    btn_h := Scale(36)
    gap := Scale(10)
    y: int
    at_w: int
    commit := 0
    result := 0
    url: [256] char
    current_alias: [40] char
    stored_alias: const char* = nil
    has_alias: int
    unchanged_alias: int

    if app == nil {
        return 3
    }

    stored_alias = storage_get_setting_text(sync_account_alias_key)
    snprintf(current_alias, sizeof(current_alias), "%s",
                stored_alias != nil ? stored_alias : "")
    alias_normalize(current_alias)
    has_alias = current_alias[0] != '\0'

    frame = AppModalFrame(Scale(336), Scale(238),
                             GetLocaleText(has_alias
                                            ? "sync_alias_change_title"
                                            : "sync_alias_title"),
                             0, 0)
    y = frame.content_y

    Text((TextProps){
        .bounds={(frame.content_x), (y), 0, 0},
        .text=(GetLocaleText(has_alias ? "sync_alias_change_message" : "sync_alias_message")),
        .wrap=TextWrapNone
    })
    y += Scale(40)

    at_w = AppTextWidth("@", AppFontSize()) + Scale(12)
    Text((TextProps){
        .bounds={(frame.content_x), (AppControlTextY("@", y, btn_h, AppFontSize())), 0, 0},
        .text=("@"),
        .wrap=TextWrapNone
    })
    TextField((TextFieldProps){
        .bounds = {(float)(frame.content_x + at_w), (float)y,
                   (float)(frame.content_w - at_w), (float)btn_h},
        .text = app->sync_alias_input,
        .text_size = sizeof(app->sync_alias_input),
        .cursor_position = &app->sync_alias_cursor,
        .focused = &app->sync_alias_focused,
        .max_codepoints = 32,
        .commit_pressed = &commit,
    })
    alias_normalize(app->sync_alias_input)
    y += btn_h + Scale(12)

    Text((TextProps){
        .bounds={(frame.content_x), (y), 0, 0},
        .text=(GetLocaleText("sync_alias_rule")),
        .wrap=TextWrapNone
    })
    y += Scale(34)
    unchanged_alias = has_alias && strcmp(app->sync_alias_input, current_alias) == 0

    buttons: [2] SettingsSyncButton = {
        {
            GetLocaleText(app->sync_alias_then_backup ? "skip_button" : "close_button"),
            ButtonToneNeutral,
            0,
        },
        {
            GetLocaleText(has_alias
                          ? "sync_alias_save_button"
                          : "sync_alias_register_button"),
            ButtonToneAccent,
            !alias_valid(app->sync_alias_input) || unchanged_alias,
        },
    }
    clicked := draw_adaptive_button_row((SettingsSyncButtonRow){
        .x = frame.content_x,
        .y = y,
        .width = frame.content_w,
        .height = btn_h,
        .gap = gap,
        .items = buttons,
        .count = 2,
    }, nil)

    if clicked == 0 {
        return 3
    }
    if clicked == 1 ||
       (commit && alias_valid(app->sync_alias_input) && !unchanged_alias) {
        if server_connected(app) &&
           sync_client_normalize_url(storage_get_setting_text(sync_server_url_key),
                                     url, sizeof(url)) {
            alias_result := sync_client_register_alias(url, app->sync_alias_input)

            TraceLog(LOG_WARNING, "SYNC: saving alias @%s with %s",
                        app->sync_alias_input, url)
            if alias_result == SYNC_OK {
                TraceLog(LOG_WARNING, "SYNC: alias saved @%s", app->sync_alias_input)
                result = 1
            } else {
                TraceLog(LOG_WARNING,
                            "SYNC: alias register failed result=%d alias=@%s",
                            (int)alias_result, app->sync_alias_input)
                result = 2
            }
        } else {
            TraceLog(LOG_WARNING, "SYNC: alias register failed invalid server url")
            result = 2
        }
    }

    return result
}

draw_public_id_modal :: (app: InnerBreeze*) -> int {
    frame: UIPanelFrame
    account: SyncAccount
    btn_h := Scale(36)
    gap := Scale(10)
    y: int
    result := 0

    unused app
    memset(&account, 0, sizeof(account))
    if !sync_account_load(&account) {
        return 1
    }

    frame = AppModalFrame(Scale(356), Scale(218),
                             GetLocaleText("sync_public_id_full_title"),
                             0, 0)
    y = frame.content_y

    Text((TextProps){
        .bounds={(frame.content_x), (y), 0, 0},
        .text=(GetLocaleText("sync_public_id_full_message")),
        .wrap=TextWrapNone
    })
    y += Scale(34)

    draw_public_id_field(account.public_id, frame.content_x, frame.content_w,
                            &y, AppSmallFontSize())
    y += Scale(18)

    buttons: [2] SettingsSyncButton = {
        {GetLocaleText("sync_copy_id_button"), ButtonToneAccent, ButtonEmphasisFilled, 0},
        {GetLocaleText("close_button"), ButtonToneNeutral, ButtonEmphasisSoft, 0},
    }
    clicked := draw_adaptive_button_row((SettingsSyncButtonRow){
        .x = frame.content_x,
        .y = y,
        .width = frame.content_w,
        .height = btn_h,
        .gap = gap,
        .items = buttons,
        .count = 2,
    }, nil)

    if clicked == 0 {
        SetClipboardText(account.public_id)
        settings_screen_set_status_success(GetLocaleText("sync_public_id_copied"), nil)
    } else if clicked == 1 {
        result = 1
    }

    return result
}
