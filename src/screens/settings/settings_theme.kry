#module "settings.theme"

#import "app/app"
#import "app/app_nav.h"
#import "app/app_settings"
#import "app/app_style"
#import "app/device_preferences"
#import "src/screens/settings/settings_types.h"
#import <stdio.h>

ui :: #import "src/screens/settings/settings_ui"
ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
#if ANDROID {
    #import "android_device.h" #private
}
static scale_drag_active: int = 0
static scale_drag_value: int = 0

theme_dropdown_section_height :: () -> int #private {
    return Scale(28) + Scale(56)
}

theme_value_dropdown_rows_height :: () -> int #private {
    font := AppFontSize()
    row_label_gap := Scale(8)
    row_gap := Scale(14)
    row_h := Scale(40)
    return (font + row_label_gap + row_h + row_gap) * 2
}

scale_slider_content_height :: (content_w: int) -> int #private {
    font := AppFontSize()
    line_h := AppTextLineHeight(font)
    label_w := content_w - Scale(72)
    label_h := 0
    extra := 0
    header := line_h

    if label_w < Scale(80) {
        label_w = content_w
    }
    label_h = AppParagraphHeight(GetLocaleText("appearance_scale_label"),
                                 label_w, font, 0)
    if label_h > header {
        header = label_h
    }
    if content_w < Scale(168) {
        extra = Scale(60)
    }
    return header + Scale(12) + Scale(48) + line_h + Scale(4) + extra + Scale(20)
}

content_height :: (app: InnerBreeze*, content_w: int) -> int {
    sidebar_h := 0
    glow_h := 0
    total := 0
    if style_pack_has_glow(app->style_index) {
        glow_h = ui.toggle_row_height(GetLocaleText("appearance_glow_effects_label"),
        content_w) + Scale(6)
    }
    if app_nav_desktop_rail_enabled(app) {
        options: [2] SegmentOption = {
            {GetLocaleText("navigation_sidebar_expanded"), false},
            {GetLocaleText("navigation_sidebar_compact"), false}
        }
        sidebar_h = Scale(44) + GetSegmentedControlHeight((SegmentedControlProps){
            .bounds = {0, 0, content_w, Scale(40)},
            .options = options, .option_count = 2,
            .height = Scale(40), .wrap = true
        })
    }

    total += theme_dropdown_section_height()
    total += glow_h
    total += scale_slider_content_height(content_w)
    total += theme_dropdown_section_height()
    total += sidebar_h
    total += theme_value_dropdown_rows_height()
    total += Scale(24)
    total += Scale(58)
    #if ANDROID {
        total += Scale(80)
    }
    return total
}

draw :: (app: InnerBreeze*, x: int, w: int, y: int*, state: SettingsThemeState*) {
    if app == NULL || y == NULL || state == NULL {
        return
    }

    #if ANDROID {
        if !state->app_icon_loaded {
            state->app_icon = android_device_app_icon()
            state->app_icon_loaded = 1
        }
        if Button((ButtonProps){
            .id = 152, .bounds = {x, *y, w, Scale(64)},
            .label = GetLocaleText("app_icon_label"),
            .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
            .disabled = app->modal.active
        }) {
            state->app_icon = android_device_app_icon()
            state->app_icon_error = 0
            app_open_modal(app, UIModalAppIconPicker)
        }
        Image((ImageProps){
            .asset_path = state->app_icon == 1 ? "assets/app/icon-ink-and-air.png"
                                               : "assets/app/icon-sky-cradle.png",
            .bounds = {x + Scale(8), *y + Scale(4), Scale(56), Scale(56)},
            .fit = ImageFitContain
        })
        *y += Scale(80)
    }

    styles: [3] const char* = {
        style_pack_label(1),
        style_pack_label(2), style_pack_label(3)
    }
    selected_style := app->style_index - 1
    Text((TextProps){
        .bounds = {x, *y, w, Scale(24)},
        .text = GetLocaleText("appearance_style_label")
    })
    *y += Scale(28)
    if Dropdown((DropdownProps){
        .id = 150, .bounds = {x, *y, w, Scale(40)},
        .options = styles, .option_count = 3,
        .selected_index = &selected_style
    }) {
        app->style_index = selected_style + 1
        app_apply_style(app)
        app->settings_scroll = 0
        app_block_current_click(app)
        save_settings(app)
    }
    *y += Scale(56)
    if style_pack_has_glow(app->style_index) {
        if ui.commit_toggle_row(app, x, w, y,
        GetLocaleText("appearance_glow_effects_label"),
        &app->lightfield_glow_enabled, 1) {
            app_apply_style(app)
        }
        *y += Scale(6)
    }
    draw_scale_row(app, x, w, y)

    placements: [5] const char* = {
        GetLocaleText("navigation_automatic"),
        GetLocaleText("navigation_left"),
        GetLocaleText("navigation_bottom"),
        GetLocaleText("navigation_right"),
        GetLocaleText("navigation_top")
    }
    Text((TextProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)Scale(24)},
        .text = GetLocaleText("navigation_placement")
    })
    *y += Scale(28)
    if Dropdown((DropdownProps){.id = 149, .bounds = {x, *y, w, Scale(40)},
        .options = placements, .option_count = 5,
        .selected_index = &app->navigation_placement}) {
        app->settings_scroll = 0
        app_block_current_click(app)
        save_settings(app)
    }
    *y += Scale(56)

    if app_nav_desktop_rail_enabled(app) {
        sidebar_options: [2] SegmentOption = {
            {GetLocaleText("navigation_sidebar_expanded"), false},
            {GetLocaleText("navigation_sidebar_compact"), false}
        }
        Text((TextProps){
            .bounds = {x, *y, w, Scale(24)},
            .text = GetLocaleText("navigation_sidebar")
        })
        *y += Scale(28)
        sidebar := SegmentedControl((SegmentedControlProps){
            .id = 151, .bounds = {x, *y, w, Scale(40)},
            .options = sidebar_options, .option_count = 2,
            .selected_index = &app->nav_rail_collapsed,
            .height = Scale(40), .wrap = true
        })
        if sidebar.changed {
            app_block_current_click(app)
            save_settings(app)
        }
        *y += sidebar.height + Scale(16)
    }

    if draw_theme_settings(app, x, w, y) {
        app_refresh_theme(app)
        app->settings_dirty = 1
        app->settings_save_delay_ticks = 18
    }
    *y += Scale(24)

    if Button((ButtonProps){
        .bounds = {(float)(x), (float)(*y), (float)(w), (float)(Scale(44))},
        .label = GetLocaleText("customize_nav_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = app->modal.active
    }) {
        app_open_customize_nav(app)
    }
    *y += Scale(58)
}

settings_screen_draw_app_icon_modal :: (app: InnerBreeze*) #export {
    #if ANDROID {
        state := &app->theme_state
        frame := AppModalFrame(Scale(360), Scale(300),
                               GetLocaleText("app_icon_label"), 0, ICON_X)
        if frame.right_clicked {
            app_close_modal(app)
            return
        }
        names: [2] const char* = {
            GetLocaleText("app_icon_sky_cradle"),
            GetLocaleText("app_icon_ink_and_air")
        }
        previews: [2] const char* = {
            "assets/app/icon-sky-cradle.png",
            "assets/app/icon-ink-and-air.png"
        }
        gap := Scale(12)
        choice_w := (frame.content_w - gap) / 2
        for int i = 0; i < 2; i++ {
            choice_x := frame.content_x + i * (choice_w + gap)
            selected := state->app_icon == i
            Image((ImageProps){
                .asset_path = previews[i], .alt_text = names[i],
                .bounds = {choice_x, frame.content_y, choice_w, Scale(120)},
                .fit = ImageFitContain
            })
            if Button((ButtonProps){
                .id = 153 + i,
                .bounds = {choice_x, frame.content_y + Scale(128), choice_w, Scale(44)},
                .label = names[i], .selected = selected,
                .tone = selected ? ButtonToneAccent : ButtonToneNeutral,
                .emphasis = ButtonEmphasisSoft
            }) {
                state->app_icon_error = !android_device_set_app_icon(i)
                state->app_icon = android_device_app_icon()
                app_block_current_click(app)
                if !state->app_icon_error {
                    app_close_modal(app)
                    return
                }
            }
        }
        message := GetLocaleText(state->app_icon_error ? "app_icon_error" : "app_icon_hint")
        Text((TextProps){
            .bounds = {frame.content_x, frame.content_y + Scale(184), frame.content_w, 0},
            .text = message, .wrap = TextWrapNone,
            .font = AppFitFontSize(message, frame.content_w, AppSmallFontSize(), Scale(Text8))
        })
    } #else {
        unused app
    }
}

draw_theme_settings :: (app: InnerBreeze*, x: int, w: int, y: int*) -> int #private {
    changed := 0
    row_label_gap := Scale(8)
    row_gap := Scale(14)
    row_h := Scale(40)
    font := AppFontSize()
    follow_device_label: [128] char
    snprintf(follow_device_label, sizeof(follow_device_label), "%s (%s)",
             GetLocaleText("theme_follow_device"),
             GetLocaleText(app->dark_mode ? "theme_dark" : "theme_light"))
    mode_options: [3] const char* = {
        follow_device_label,
        GetLocaleText("theme_light"),
        GetLocaleText("theme_dark")
    }
    mode_index := app->theme_mode

    if mode_index < APP_THEME_SYSTEM || mode_index > APP_THEME_DARK {
        mode_index = APP_THEME_SYSTEM
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("theme_mode_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 102,
        .bounds = {x, *y + font + row_label_gap, w, row_h},
        .options = mode_options, .option_count = 3,
        .selected_index = &mode_index,
        .disabled = app->theme_source == APP_THEME_SOURCE_SYSTEM}) {
        app->theme_mode = mode_index
        changed = 1
    }
    *y += font + row_label_gap + row_h + row_gap

    theme_options: [THEME_COUNT + 1] const char* = {0}
    theme_options[0] = GetLocaleText("theme_system")
    for int i = 0; i < THEME_COUNT; i++ {
        theme_options[i + 1] = GetThemeLabel((ThemeId)i)
    }
    theme_index := app->theme_source == APP_THEME_SOURCE_SYSTEM
        ? 0
        : app->theme_id + 1
    if theme_index < 0 || theme_index > THEME_COUNT {
        theme_index = 1
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("theme_color_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 103,
        .bounds = {x, *y + font + row_label_gap, w, row_h},
        .options = theme_options, .option_count = THEME_COUNT + 1,
        .selected_index = &theme_index}) {
        if theme_index == 0 {
            app->theme_source = APP_THEME_SOURCE_SYSTEM
            app->theme_mode = APP_THEME_SYSTEM
        } else {
            app->theme_source = APP_THEME_SOURCE_APP
            app->theme_id = clampi(theme_index - 1, 0, THEME_COUNT - 1)
        }
        changed = 1
    }
    *y += font + row_label_gap + row_h + row_gap
    return changed
}

draw_scale_row :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    scale_value := scale_drag_active ? scale_drag_value : app->ui_scale_tenths
    slider_height: float = 0.0f
    changed := Slider((SliderProps){
        .id = 140,
        .bounds = {x, *y, w, 0},
        .label = GetLocaleText("appearance_scale_label"),
        .kind = NumericInt, .int_values = &scale_value,
        .value_count = 1, .min = 5, .max = 25,
        .value_scale = 10.0, .value_format = "%.0f%%",
        .step_buttons = true, .show_limits = true,
        .measured_height = &slider_height
    })
    if changed {
        if IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
            scale_drag_active = 1
            scale_drag_value = scale_value
        } else {
            scale_drag_active = 0
            app->ui_scale_tenths = scale_value
            app->settings_dirty = 1
            save_settings(app)
        }
    }
    if scale_drag_active && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        scale_drag_active = 0
        app->ui_scale_tenths = scale_drag_value
        app->settings_dirty = 1
        save_settings(app)
    }
    *y += (int)slider_height + Scale(20)
}

settings_screen_draw_theme_picker_modal :: (app: InnerBreeze*) #export {
    modal_w := Scale(320)
    modal_h := Scale(360)
    title := GetLocaleText("theme_picker_title")
    frame := (UIPanelFrame){0}
    picker_h := 0

    frame = AppModalFrame(modal_w, modal_h, title, 0, ICON_X)
    if frame.right_clicked {
        app_close_modal(app)
        return
    }

    picker_h = theme_picker_content_height(frame.content_w)

    Scroll picker: {
        bounds = (Rectangle){(float)frame.content_x, (float)frame.content_y,
                             (float)frame.content_w, (float)frame.content_h}
        content_height = picker_h
        scroll_offset = &app->theme_state.theme_picker_scroll
        if draw_theme_picker((int)picker.x, (int)picker.y,
                             (int)picker.width, app->dark_mode, &app->theme_id) {
            app->theme_id = clampi(app->theme_id, 0, THEME_COUNT - 1)
            app->theme_source = APP_THEME_SOURCE_APP
            app_refresh_theme(app)
            app->settings_dirty = 1
            save_settings(app)
            app_close_modal(app)
        }
    }
}

theme_picker_content_height :: (w: int) -> int #private {
    unused w
    return THEME_COUNT * Scale(46)
}

draw_theme_picker :: (x: int, y: int, w: int, dark_mode: int, theme_id: int*) -> int #private {
    unused dark_mode
    selected := theme_id != nil ? *theme_id : THEME_SKY
    changed := 0

    for int i = 0; i < THEME_COUNT; i++ {
        if Button((ButtonProps){
            .id = 51000 + i,
            .bounds = {(float)x, (float)(y + i * Scale(46)),
                       (float)w, (float)Scale(40)},
            .label = GetThemeLabel((ThemeId)i),
            .tone = selected == i ? ButtonToneAccent : ButtonToneNeutral,
            .emphasis = selected == i ? ButtonEmphasisFilled : ButtonEmphasisSoft
        }) {
            if theme_id != nil {
                *theme_id = i
            }
            changed = 1
        }
    }
    return changed
}
