#module "settings.theme"

#import "app.h"
#import "app/app_settings.h"
#import "app/app_style.h"
#import "app/device_preferences.h"
#import "src/screens/settings/settings_types.h"
#import <stdio.h>

ui :: #import "src/screens/settings/settings_ui"
ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
static scale_drag_active: int = 0
static scale_drag_value: int = 0

content_height :: (content_w: int) -> int {
    unused content_w

    #if WEB {
        return Scale(366) + Scale(292)
    } #else {
        return Scale(350) + Scale(292)
    }
}

draw :: (app: InnerBreeze*, x: int, w: int, y: int*, state: SettingsThemeState*) {
    if app == NULL || y == NULL || state == NULL {
        return
    }

    styles: [3] const char* = {
        style_pack_label(1),
        style_pack_label(2), style_pack_label(3)
    }
    selected_style := app->style_index - 1
    Text((TextProps){
        .bounds = {x, *y, w, Scale(24)},
        .text = GetLocaleText("appearance_style_label")
    })
    *y += Scale(28)
    if Dropdown((DropdownProps){
        .id = 150, .bounds = {x, *y, w, Scale(40)},
        .options = styles, .option_count = 3,
        .selected_index = &selected_style
    }) {
        app->style_index = selected_style + 1
        app_apply_style(app)
        app_block_current_click(app)
        save_settings(app)
    }
    *y += Scale(56)
    draw_scale_row(app, x, w, y)

    placements: [5] const char* = {
        GetLocaleText("navigation_automatic"),
        GetLocaleText("navigation_left"),
        GetLocaleText("navigation_bottom"),
        GetLocaleText("navigation_right"),
        GetLocaleText("navigation_top")
    }
    Text((TextProps){
        .bounds = {(float)x, (float)*y, (float)w, (float)Scale(24)},
        .text = GetLocaleText("navigation_placement")
    })
    *y += Scale(28)
    if Dropdown((DropdownProps){.id = 149, .bounds = {x, *y, w, Scale(40)},
        .options = placements, .option_count = 5,
        .selected_index = &app->navigation_placement}) {
        app->settings_scroll = 0
        app_block_current_click(app)
        save_settings(app)
    }
    *y += Scale(56)

    if draw_theme_settings(app, x, w, y) {
        app_refresh_theme(app)
        app->settings_dirty = 1
        app->settings_save_delay_ticks = 18
    }
    *y += Scale(24)

    glow_effects := app->glow_effects_enabled
    if ui.commit_toggle_row(app, x, w, y,
                            GetLocaleText("appearance_glow_effects_label"),
                            &glow_effects, 1) {
        app->glow_effects_enabled = glow_effects
        SetFancyEffectsEnabled(app->glow_effects_enabled)
    }
    *y += Scale(6)

    if Button((ButtonProps){
        .bounds = {(float)(x), (float)(*y), (float)(w), (float)(Scale(44))},
        .label = GetLocaleText("customize_nav_button"),
        .tone = ButtonToneAccent,
        .emphasis = ButtonEmphasisFilled,
        .disabled = app->modal.active
    }) {
        app_open_customize_nav(app)
    }
    *y += Scale(58)
}

draw_theme_settings :: (app: InnerBreeze*, x: int, w: int, y: int*) -> int #private {
    changed := 0
    row_label_gap := Scale(8)
    row_gap := Scale(14)
    row_h := Scale(40)
    font := AppFontSize()
    mode_options: [3] const char* = {
        GetLocaleText("theme_follow_device"),
        GetLocaleText("theme_light"),
        GetLocaleText("theme_dark")
    }
    mode_index := app->theme_mode

    if mode_index < APP_THEME_SYSTEM || mode_index > APP_THEME_DARK {
        mode_index = APP_THEME_SYSTEM
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("theme_mode_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 102,
        .bounds = {x, *y + font + row_label_gap, w, row_h},
        .options = mode_options, .option_count = 3,
        .selected_index = &mode_index,
        .disabled = app->theme_source == APP_THEME_SOURCE_SYSTEM}) {
        app->theme_mode = mode_index
        changed = 1
    }
    *y += font + row_label_gap + row_h + row_gap

    theme_options: [THEME_COUNT + 1] const char* = {0}
    theme_options[0] = GetLocaleText("theme_system")
    for int i = 0; i < THEME_COUNT; i++ {
        theme_options[i + 1] = GetThemeLabel((ThemeId)i)
    }
    theme_index := app->theme_source == APP_THEME_SOURCE_SYSTEM
        ? 0
        : app->theme_id + 1
    if theme_index < 0 || theme_index > THEME_COUNT {
        theme_index = 1
    }
    Text((TextProps){
        .bounds={(x), (*y), 0, 0},
        .text=(GetLocaleText("theme_color_label")),
        .wrap=TextWrapNone
    })
    if Dropdown((DropdownProps){.id = 103,
        .bounds = {x, *y + font + row_label_gap, w, row_h},
        .options = theme_options, .option_count = THEME_COUNT + 1,
        .selected_index = &theme_index}) {
        if theme_index == 0 {
            app->theme_source = APP_THEME_SOURCE_SYSTEM
            app->theme_mode = APP_THEME_SYSTEM
        } else {
            app->theme_source = APP_THEME_SOURCE_APP
            app->theme_id = clampi(theme_index - 1, 0, THEME_COUNT - 1)
        }
        changed = 1
    }
    *y += font + row_label_gap + row_h + row_gap
    return changed
}

draw_scale_row :: (app: InnerBreeze*, x: int, w: int, y: int*) #private {
    scale_value := scale_drag_active ? scale_drag_value : app->ui_scale_tenths
    multiplier := scale_value / 10.0f
    effective: float = multiplier * GetDPIScale()
    scale_text: [16] char
    step_w := Scale(28)
    step_gap := Scale(8)
    step_y := *y + Scale(28) - Scale(14)
    slider_x := x + step_w + step_gap
    slider_w := w - (step_w + step_gap) * 2


    step_changed := 0
    slider_changed := 0
    snprintf(scale_text, sizeof(scale_text), "%.1fx", effective)
    if Button((ButtonProps){
        .id = 141, .label = "-",
        .bounds = {(x + step_w / 2) - fmaxf(AppTextWidth("-", AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(step_y), fmaxf(AppTextWidth("-", AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
        if scale_value > 5 {
            scale_value = scale_value - 1
            step_changed = 1
        }
    }
    if slider_w < Scale(100) {
        slider_x = x
        slider_w = w
    }
    unused scale_text
    slider_changed = Slider((SliderProps){.id = 140,
        .bounds = {slider_x, *y, slider_w, Scale(56)},
        .label = GetLocaleText("appearance_scale_label"),
        .kind = NumericInt, .int_values = &scale_value,
        .value_count = 1, .min = 5, .max = 25, .format = "%d"})
    if slider_changed {
        if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
            scale_drag_active = 0
            app->ui_scale_tenths = scale_value
            app->settings_dirty = 1
            save_settings(app)
        } else {
            scale_drag_active = 1
            scale_drag_value = scale_value
        }
    }
    if slider_w < w {
        if Button((ButtonProps){
        .id = 142, .label = "+",
        .bounds = {(x + w - step_w / 2) - fmaxf(AppTextWidth("+", AppFontSize()) + Scale(16), Scale(34)) / 2.0f,
                   (float)(step_y), fmaxf(AppTextWidth("+", AppFontSize()) + Scale(16), Scale(34)), fmaxf(AppTextLineHeight(AppFontSize()) + Scale(8), Scale(34))},
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft
    }) {
            if scale_value < 25 {
                scale_value = scale_value + 1
                step_changed = 1
            }
        }
    }
    if scale_drag_active && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        scale_drag_active = 0
        app->ui_scale_tenths = scale_drag_value
        app->settings_dirty = 1
        save_settings(app)
    } else if step_changed && scale_value != app->ui_scale_tenths {
        scale_drag_active = 0
        app->ui_scale_tenths = scale_value
        app->settings_dirty = 1
        save_settings(app)
    }
    *y += Scale(66)
}

settings_screen_draw_theme_picker_modal :: (app: InnerBreeze*) #export {
    modal_w := Scale(320)
    modal_h := Scale(360)
    title := GetLocaleText("theme_picker_title")
    frame := (UIPanelFrame){0}
    picker_h := 0

    frame = AppModalFrame(modal_w, modal_h, title, 0, ICON_X)
    if frame.right_clicked {
        app_close_modal(app)
        return
    }

    picker_h = theme_picker_content_height(frame.content_w)

    Scroll picker: {
        bounds = (Rectangle){(float)frame.content_x, (float)frame.content_y,
                             (float)frame.content_w, (float)frame.content_h}
        content_height = picker_h
        scroll_offset = &app->theme_state.theme_picker_scroll
        if draw_theme_picker((int)picker.x, (int)picker.y,
                             (int)picker.width, app->dark_mode, &app->theme_id) {
            app->theme_id = clampi(app->theme_id, 0, THEME_COUNT - 1)
            app->theme_source = APP_THEME_SOURCE_APP
            app_refresh_theme(app)
            app->settings_dirty = 1
            save_settings(app)
            app_close_modal(app)
        }
    }
}

theme_picker_content_height :: (w: int) -> int #private {
    unused w
    return THEME_COUNT * Scale(46)
}

draw_theme_picker :: (x: int, y: int, w: int, dark_mode: int, theme_id: int*) -> int #private {
    unused dark_mode
    selected := theme_id != nil ? *theme_id : THEME_SKY
    changed := 0

    for int i = 0; i < THEME_COUNT; i++ {
        if Button((ButtonProps){
            .id = 51000 + i,
            .bounds = {(float)x, (float)(y + i * Scale(46)),
                       (float)w, (float)Scale(40)},
            .label = GetThemeLabel((ThemeId)i),
            .tone = selected == i ? ButtonToneAccent : ButtonToneNeutral,
            .emphasis = selected == i ? ButtonEmphasisFilled : ButtonEmphasisSoft
        }) {
            if theme_id != nil {
                *theme_id = i
            }
            changed = 1
        }
    }
    return changed
}
