#module "settings_ui"

#import "app.h"

label_paragraph :: (label: const char*, w: int) -> ParagraphSpec #private {
    return (ParagraphSpec){.text = label, .width = w}
}

toggle_switch_width :: () -> int {
    return Scale(50)
}

toggle_switch :: (id: int, x: int, y: int, value: int*) -> int {
    w := toggle_switch_width()
    h := Scale(28)
    knob := Scale(22)
    pad := (h - knob) / 2
    on := value != NULL && *value != 0
    bounds := (Rectangle){(float)x, (float)y, (float)w, (float)h}
    hot := CheckCollisionPointRec(GetMousePosition(), bounds) &&
           !UIInputCapturesClick(GetMousePosition())
    fill := on ? LightenUIColor(GetThemeButton(), 18) : DarkenUIColor(GetThemeBackground(), 10)
    border := on ? Fade(GetThemeButtonHover(), 0.82f) : Fade(GetThemeText(), 0.16f)
    knob_x := x + (on ? w - knob - pad : pad)

    if hot {
        fill = on ? LightenUIColor(fill, 12) : LightenUIColor(fill, 8)
        border = on ? GetThemeButtonHover() : Fade(GetThemeText(), 0.28f)
    }
    DrawRectangleRounded(bounds, 0.5f, 16, fill)
    DrawRectangleRoundedLinesEx(bounds, 0.5f, 16, 1.0f, border)
    DrawCircle(knob_x + knob / 2, y + h / 2, knob / 2,
               on ? WHITE : Fade(GetThemeText(), 0.72f))
    if InvisibleButton((InvisibleButtonProps){.bounds = bounds, .id = id}) {
        if value != NULL {
            *value = !*value
            return 1
        }
    }
    return 0
}

toggle_row_height :: (label: const char*, w: int) -> int {
    if w <= 0 {
        w = Scale(160)
    }

    toggle_w := toggle_switch_width()
    toggle_h := Scale(28)
    gap := Scale(18)
    label_w := w - toggle_w - gap

    if label_w < Scale(120) {
        label_w = w
    }

    label_h := GetNodeHeight(NodeParagraph(label_paragraph(label, label_w), 0, 0))
    if label_w < w {
        row_h := label_h
        if row_h < toggle_h {
            row_h = toggle_h
        }
        row_h += Scale(16)
        if row_h < Scale(52) {
            row_h = Scale(52)
        }
        return row_h
    }

    row_h := label_h + Scale(8) + toggle_h + Scale(18)
    if row_h < Scale(70) {
        row_h = Scale(70)
    }
    return row_h
}

draw_toggle_row :: (x: int, w: int, y: int*, label: const char*, value: int*) -> int {
    if y == NULL {
        return 0
    }

    row_h := toggle_row_height(label, w)
    toggle_w := toggle_switch_width()
    toggle_h := Scale(28)
    gap := Scale(18)
    label_w := w - toggle_w - gap
    label_h: int
    label_y: int

    if label_w < Scale(120) {
        label_w = w
    }

    label_h = GetNodeHeight(NodeParagraph(label_paragraph(label, label_w), 0, 0))
    toggle_x := x
    toggle_y := *y + (row_h - toggle_h) / 2

    if label_w < w {
        label_y = *y + (row_h - label_h) / 2
        toggle_x = x + w - toggle_w
    } else {
        label_y = *y + Scale(8)
        toggle_y = label_y + label_h + Scale(8)
    }
    Paragraph(label_paragraph(label, label_w), x, &label_y)

    if toggle_switch(62000 + *y, toggle_x, toggle_y, value) {
        *y += row_h
        return 1
    }

    *y += row_h
    return 0
}

commit_toggle_row :: (app: InnerBreeze*, x: int, w: int, y: int*, label: const char*, value: int*, save_now: int) -> int {
    if draw_toggle_row(x, w, y, label, value) {
        if app != NULL {
            app->settings_dirty = 1
            if save_now {
                save_settings(app)
            }
        }
        return 1
    }
    return 0
}

commit_slider_row :: (app: InnerBreeze*, id: int, x: int, w: int, y: int*, row_h: int, label: const char*, min: int, max: int, value: int*, suffix: const char*, save_now: int) -> int {
    if y == NULL {
        return 0
    }

    changed := Slider(id, x, *y, w, label, min, max, value, suffix, nil)
    if changed && app != NULL {
        app->settings_dirty = 1
        if save_now {
            save_settings(app)
        }
    }
    *y += row_h
    return changed
}

audio_meter_height :: () -> int {
    return Scale(18) + Scale(10) + Scale(8)
}

draw_audio_meter :: (app: InnerBreeze*, x: int, y: int, w: int, label: const char*) -> int {
    label_font := Text12
    bar_h := Scale(10)
    label_h := Scale(18)
    level := app_audio_output_level(app)
    fill_w := (int)(level * (float)w)
    bg := GetThemeBackground()

    if w <= 0 {
        return audio_meter_height()
    }
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }

    Text((TextProps){
        .bounds={(x), (y), 0, 0},
        .text=(label),
        .font=(label_font),
        .color=(DarkenUIColor(GetThemeText(), 28)),
        .wrap=TextWrapNone
    })
    DrawRectangle(x, y + label_h, w, bar_h, DarkenUIColor(bg, 28))
    Bevel(x, y + label_h, w, bar_h,
                DarkenUIColor(bg, 55), LightenUIColor(bg, 35))
    if fill_w > 0 {
        inner_w := fill_w - Scale(4)
        if inner_w < Scale(2) {
            inner_w = Scale(2)
        }
        DrawRectangle(x + Scale(2), y + label_h + Scale(2),
                      inner_w, bar_h - Scale(4), GetThemeButtonHover())
    }
    return audio_meter_height()
}
