#module "settings_ui"

#import "app.h"

label_paragraph :: (label: const char*, w: int) -> ParagraphSpec #private {
    return (ParagraphSpec){.text = label, .width = w}
}

toggle_switch_width :: () -> int {
    if GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL {
        return Scale(52)
    }

    font := GetFontSize()
    off_w := TextWidth(GetLocaleText("toggle_off"), font)
    on_w := TextWidth(GetLocaleText("toggle_on"), font)
    half := (off_w > on_w ? off_w : on_w) + Scale(16)

    return half * 2 + Scale(6)
}

toggle_row_height :: (label: const char*, w: int) -> int {
    if w <= 0 {
        w = Scale(160)
    }

    toggle_w := toggle_switch_width()
    toggle_h := Scale(30)
    material := GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    gap := Scale(material ? 22 : 16)
    label_w := w - toggle_w - gap

    if label_w < Scale(120) {
        label_w = w
    }

    label_h := GetNodeHeight(NodeParagraph(label_paragraph(label, label_w), 0, 0))
    if label_w < w {
        row_h := label_h
        if row_h < toggle_h {
            row_h = toggle_h
        }
        row_h += Scale(material ? 32 : 24)
        if row_h < Scale(material ? 66 : 58) {
            row_h = Scale(material ? 66 : 58)
        }
        return row_h
    }

    row_h := label_h + Scale(material ? 14 : 10) + toggle_h +
        Scale(material ? 30 : 22)
    if row_h < Scale(material ? 86 : 76) {
        row_h = Scale(material ? 86 : 76)
    }
    return row_h
}

draw_toggle_row :: (x: int, w: int, y: int*, label: const char*, value: int*) -> int {
    if y == NULL {
        return 0
    }

    row_h := toggle_row_height(label, w)
    label_y := *y
    toggle_w := toggle_switch_width()
    toggle_h := Scale(30)
    material := GetEffectiveThemeStyle() == THEME_STYLE_MATERIAL
    gap := Scale(material ? 22 : 16)
    label_w := w - toggle_w - gap

    if label_w < Scale(120) {
        label_w = w
    }

    Paragraph(label_paragraph(label, label_w), x, &label_y)
    label_h := label_y - *y
    toggle_x := x
    toggle_y := *y + label_h + Scale(material ? 14 : 10)

    if label_w < w {
        toggle_x = x + w - toggle_w
        toggle_y = *y + (row_h - toggle_h) / 2
    }

    if Toggle(0, toggle_x, toggle_y, toggle_w, toggle_h, value, GetLocaleText("toggle_off"), GetLocaleText("toggle_on")) {
        *y += row_h
        return 1
    }

    *y += row_h
    return 0
}

commit_toggle_row :: (app: InbeApp*, x: int, w: int, y: int*, label: const char*, value: int*, save_now: int) -> int {
    if draw_toggle_row(x, w, y, label, value) {
        if app != NULL {
            app->settings_dirty = 1
            if save_now {
                save_settings(app)
            }
        }
        return 1
    }
    return 0
}

commit_slider_row :: (app: InbeApp*, id: int, x: int, w: int, y: int*, row_h: int, label: const char*, min: int, max: int, value: int*, suffix: const char*, save_now: int) -> int {
    if y == NULL {
        return 0
    }

    changed := Slider(id, x, *y, w, label, min, max, value, suffix, nil)
    if changed && app != NULL {
        app->settings_dirty = 1
        if save_now {
            save_settings(app)
        }
    }
    *y += row_h
    return changed
}

audio_meter_height :: () -> int {
    return Scale(18) + Scale(10) + Scale(8)
}

draw_audio_meter :: (app: InbeApp*, x: int, y: int, w: int, label: const char*) -> int {
    label_font := Text12
    bar_h := Scale(10)
    label_h := Scale(18)
    level := app_audio_output_level(app)
    fill_w := (int)(level * (float)w)
    bg := GetThemeBackground()

    if w <= 0 {
        return audio_meter_height()
    }
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }

    Text((TextProps){
        .bounds={(x), (y), 0, 0},
        .text=(label),
        .font=(label_font),
        .color=(DarkenUIColor(GetThemeText(), 28)),
        .wrap=TextWrapNone
    })
    DrawRectangle(x, y + label_h, w, bar_h, DarkenUIColor(bg, 28))
    Bevel(x, y + label_h, w, bar_h,
                DarkenUIColor(bg, 55), LightenUIColor(bg, 35))
    if fill_w > 0 {
        inner_w := fill_w - Scale(4)
        if inner_w < Scale(2) {
            inner_w = Scale(2)
        }
        DrawRectangle(x + Scale(2), y + label_h + Scale(2),
                      inner_w, bar_h - Scale(4), GetThemeButtonHover())
    }
    return audio_meter_height()
}
