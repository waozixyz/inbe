#module "settings_ui"

#import "app/app.h"

label_paragraph :: (label: const char*, w: int) -> ParagraphSpec #private {
    return (ParagraphSpec){.text = label, .width = w}
}

toggle_switch_width :: () -> int {
    return Scale(54)
}

toggle_row_height :: (label: const char*, w: int) -> int {
    if w <= 0 {
        w = Scale(160)
    }

    toggle_w := toggle_switch_width()
    toggle_h := Scale(34)
    gap := Scale(18)
    label_w := w - toggle_w - gap

    if label_w < Scale(120) {
        label_w = w
    }

    label_h := AppParagraphHeight(label, label_w, 0, 0)
    if label_w < w {
        row_h := label_h
        if row_h < toggle_h {
            row_h = toggle_h
        }
        row_h += Scale(16)
        if row_h < Scale(52) {
            row_h = Scale(52)
        }
        return row_h
    }

    row_h := label_h + Scale(8) + toggle_h + Scale(18)
    if row_h < Scale(70) {
        row_h = Scale(70)
    }
    return row_h
}

draw_toggle_row :: (x: int, w: int, y: int*, label: const char*, value: int*) -> int {
    if y == NULL {
        return 0
    }

    row_h := toggle_row_height(label, w)
    toggle_w := toggle_switch_width()
    toggle_h := Scale(34)
    gap := Scale(18)
    label_w := w - toggle_w - gap
    label_h: int
    label_y: int

    if label_w < Scale(120) {
        label_w = w
    }

    label_h = AppParagraphHeight(label, label_w, 0, 0)
    toggle_x := x
    toggle_y := *y + (row_h - toggle_h) / 2

    if label_w < w {
        label_y = *y + (row_h - label_h) / 2
        toggle_x = x + w - toggle_w
    } else {
        label_y = *y + Scale(8)
        toggle_y = label_y + label_h + Scale(8)
    }
    Paragraph(label_paragraph(label, label_w), x, &label_y)

    if Toggle((ToggleProps){.id = 62000 + *y,
        .bounds = {toggle_x, toggle_y, toggle_w, toggle_h},
        .value = value, .off_label = "", .on_label = ""}) {
        *y += row_h
        return 1
    }

    *y += row_h
    return 0
}

commit_toggle_row :: (app: InnerBreeze*, x: int, w: int, y: int*, label: const char*, value: int*, save_now: int) -> int {
    if draw_toggle_row(x, w, y, label, value) {
        if app != NULL {
            app->settings_dirty = 1
            if save_now {
                save_settings(app)
            }
        }
        return 1
    }
    return 0
}

commit_slider_row :: (app: InnerBreeze*, id: int, x: int, w: int, y: int*, row_h: int, label: const char*, min: int, max: int, value: int*, suffix: const char*, save_now: int) -> int {
    if y == NULL {
        return 0
    }

    format := "%d"
    if suffix != nil && suffix[0] != '\0' {
        if suffix[0] == 's' && suffix[1] == '\0' {
            format = "%ds"
        } else if suffix[0] == 'x' && suffix[1] == '\0' {
            format = "%dx"
        }
    }
    changed := Slider((SliderProps){.id = id,
        .bounds = {x, *y, w, Scale(56)}, .label = label,
        .kind = NumericInt, .int_values = value, .value_count = 1,
        .min = min, .max = max, .format = format})
    if changed && app != NULL {
        app->settings_dirty = 1
        if save_now {
            save_settings(app)
        }
    }
    *y += row_h
    return changed
}

audio_meter_height :: () -> int {
    return Scale(18) + Scale(10) + Scale(8)
}

draw_audio_meter :: (app: InnerBreeze*, x: int, y: int, w: int, label: const char*) -> int {
    bar_h := Scale(10)
    label_h := Scale(18)
    level := app_audio_output_level(app)
    fill_w := (int)(level * (float)w)
    bg := GetThemeBackground()

    if w <= 0 {
        return audio_meter_height()
    }
    if fill_w < 0 {
        fill_w = 0
    }
    if fill_w > w {
        fill_w = w
    }

    Text((TextProps){
        .bounds={(x), (y), 0, 0},
        .text=(label),
        .wrap=TextWrapNone
    })
    DrawRectangle(x, y + label_h, w, bar_h, DarkenColor(bg, 28))
    Bevel(x, y + label_h, w, bar_h,
                DarkenColor(bg, 55), LightenColor(bg, 35))
    if fill_w > 0 {
        inner_w := fill_w - Scale(4)
        if inner_w < Scale(2) {
            inner_w = Scale(2)
        }
        DrawRectangle(x + Scale(2), y + label_h + Scale(2),
                      inner_w, bar_h - Scale(4), GetThemeButtonHover())
    }
    return audio_meter_height()
}
