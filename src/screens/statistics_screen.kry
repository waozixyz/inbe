#import "app.h"
#import "habits/habits.h"
#import "stddef.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "time.h"

#enum {
    STATISTICS_MAX_GRAPH_DAYS = 31
    STATISTICS_MAX_GRAPH_POINTS = 256
}

StatisticsGraphPoint :: struct {
    time_key: int
    round_index: int
    day_slot: int
    hold_seconds: int
    x: int
    y: int
}

StatisticsScrollPageContext :: struct {
    linked_count: int
    mood_count: int
}

statistics_day_count :: (habit: const InbeHabit*, linked_ctx: const HabitLinkedContext*, day_index: int) -> int {
    count := habit_effective_day_count(habit, day_index, linked_ctx)

    if count > 0 {
        return count
    }
    return habit_completed_day(habit, day_index) || habit_linked_has_day(linked_ctx, day_index) ? 1 : 0
}

statistics_day_of_week :: (day_index: int) -> int {
    tm_value := (struct tm){0}

    tm_value.tm_year = day_index / 10000 - 1900
    tm_value.tm_mon = (day_index / 100) % 100 - 1
    tm_value.tm_mday = day_index % 100
    tm_value.tm_hour = 12
    mktime(&tm_value)
    return tm_value.tm_wday
}

statistics_format_day_count :: (out: char*, out_size: size_t, count: int) {
    FormatLocaleText(out, out_size, count == 1 ? "habit_stats_day_singular" : "habit_stats_day_plural", count)
}

statistics_entry_matches_filter :: (entry: const HabitLinkedEntry*, filter: int) -> int {
    if entry == NULL {
        return 0
    }
    return entry->activity == filter
}

statistics_has_wim_hof_rounds :: (linked_ctx: const HabitLinkedContext*) -> int {
    if linked_ctx == NULL {
        return 0
    }
    for int i = 0; i < linked_ctx->count; i++ {
        if linked_ctx->entries[i].activity == EXERCISE_WIM_HOF && linked_ctx->entries[i].round_count > 0 {
            return 1
        }
    }
    return 0
}

statistics_day_offset_from_today :: (day_index: int, today_tm: const struct tm*) -> int {
    day_tm := (struct tm){0}
    today_copy := (struct tm){0}
    today_time := (time_t)0
    day_time := (time_t)0
    diff_days := 0.0

    if today_tm == NULL {
        return -1
    }
    today_copy = *today_tm
    day_tm = *today_tm
    day_tm.tm_year = day_index / 10000 - 1900
    day_tm.tm_mon = (day_index / 100) % 100 - 1
    day_tm.tm_mday = day_index % 100
    day_tm.tm_hour = 12
    day_tm.tm_min = 0
    day_tm.tm_sec = 0
    today_time = mktime(&today_copy)
    day_time = mktime(&day_tm)
    diff_days = difftime(today_time, day_time) / 86400.0
    if diff_days < -0.5 || diff_days > 30.5 {
        return -1
    }
    return (int)(diff_days + 0.5)
}

statistics_draw_metric :: (x: int, y: int, w: int, h: int, label: const char*, value: const char*, accent: Color) #private {
    label_font := Text16
    value_font := Text24
    value_w := 0

    DrawRectangle(x, y, w, h, DarkenUIColor(GetThemeBackground(), 8))
    DrawRectangle(x, y, ScaleUIPx(4), h, accent)
    DrawLine(x, y + h - 1, x + w, y + h - 1, DarkenUIColor(GetThemeBackground(), 30))
    Text(label, x + ScaleUIPx(12), y + ScaleUIPx(8), label_font, DarkenUIColor(GetThemeText(), 20))
    value_w = TextWidth(value, value_font)
    if value_w > w - ScaleUIPx(24) {
        value_font = 20
    }
    Text(value, x + ScaleUIPx(12), y + ScaleUIPx(30), value_font, GetThemeText())
}

statistics_draw_section_title :: (title: const char*, x: int, y: int, w: int) -> int #private {
    paragraph := (ParagraphSpec){.text = title, .width = w, .font = Text16, .line_gap = ScaleUIPx(3), .color = GetThemeText()}
    title_y := y
    height := GetNodeHeight(NodeParagraph(paragraph, 0, 0))

    Paragraph(paragraph, x, &title_y)
    return height
}

statistics_mood_color :: (mood: int) -> Color #private {
    if mood <= 1 {
        return (Color){226, 83, 78, 255}
    } else if mood == 2 {
        return (Color){238, 139, 70, 255}
    } else if mood == 3 {
        return (Color){235, 202, 77, 255}
    } else if mood == 4 {
        return (Color){108, 199, 104, 255}
    }
    return (Color){73, 194, 192, 255}
}

statistics_format_average :: (out: char*, out_size: size_t, value_x100: int,
                              suffix: const char*) #private {
    sign: [2] char = {0}
    value := value_x100

    if out == nil || out_size == 0 {
        return
    }
    if value < 0 {
        sign[0] = '-'
        value = -value
    }
    snprintf(out, out_size, "%s%d.%02d%s", sign, value / 100, value % 100,
             suffix != nil ? suffix : "")
}

statistics_draw_mood_panel :: (content_x: int, y: int, content_w: int,
                               stats: const InbeStorageMoodStats*,
                               accent: Color) -> int #private {
    panel_h := ScaleUIPx(156)
    metrics_gap := ScaleUIPx(8)
    metric_h := ScaleUIPx(58)
    metric_w := (content_w - metrics_gap) / 2
    bars_y := y + ScaleUIPx(78)
    bars_h := ScaleUIPx(54)
    slot_w := content_w / 5
    value: [32] char = {0}

    if stats == nil || stats->total <= 0 {
        return 0
    }

    y += statistics_draw_section_title(GetLocaleText("habit_stats_mood_title"),
                                       content_x, y, content_w) + ScaleUIPx(10)
    statistics_format_average(value, sizeof(value), stats->average_after_x100,
                              "/5")
    statistics_draw_metric(content_x, y, metric_w, metric_h,
                           GetLocaleText("habit_stats_mood_average"), value,
                           accent)
    snprintf(value, sizeof(value), "%d", stats->total)
    statistics_draw_metric(content_x + metric_w + metrics_gap, y,
                           content_w - metric_w - metrics_gap, metric_h,
                           GetLocaleText("habit_stats_mood_checkins"), value,
                           LightenUIColor(accent, 20))

    DrawRectangle(content_x, bars_y, content_w, bars_h,
                  DarkenUIColor(GetThemeBackground(), 7))
    for int i = 0; i < 5; i++ {
        count := stats->counts[i]
        bar_h := count > 0 ? (count * (bars_h - ScaleUIPx(24))) / stats->total
                           : ScaleUIPx(3)
        x := content_x + i * slot_w + ScaleUIPx(7)
        w := slot_w - ScaleUIPx(14)
        bar_y := bars_y + bars_h - bar_h - ScaleUIPx(18)
        label: [4] char = {0}

        if w < ScaleUIPx(4) {
            w = ScaleUIPx(4)
        }
        DrawRectangle(x, bar_y, w, bar_h,
                      count > 0 ? statistics_mood_color(i + 1)
                                : DarkenUIColor(GetThemeBackground(), 24))
        snprintf(label, sizeof(label), "%d", i + 1)
        Text(label, x + (w - TextWidth(label, Text12)) / 2,
             bars_y + bars_h - ScaleUIPx(16), Text12,
             DarkenUIColor(GetThemeText(), 18))
    }

    return panel_h
}

statistics_draw_hold_range_selector :: (app: InbeApp*, x: int, y: int, w: int) -> int #private {
    labels: [2] const char* = {"1W", "1M"}
    values: [2] const int = {7, 31}
    selected := app->habits.hold_stats_range_days == 31 ? 1 : 0
    h := ScaleUIPx(34)
    segment_w := w / 2
    clicked := 0
    mouse_world := GetScreenToWorld2D(GetMousePosition(), app->camera)

    for int i = 0; i < 2; i++ {
        segment_x := x + i * segment_w
        current_w := i == 1 ? x + w - segment_x : segment_w
        rect := (Rectangle){segment_x, y, current_w, h}
        active_hit := CheckCollisionPointRec(mouse_world, rect) && !UIInputCapturesClick(mouse_world)
        hovered := active_hit && UIHoverEffectsEnabled()
        active := i == selected
        fill := active ? GetThemeButton() : DarkenUIColor(GetThemeBackground(), 10)
        top := LightenUIColor(fill, 35)
        bottom := DarkenUIColor(fill, 45)
        font := GetUIFontSize()
        text_w := 0

        if active_hit {
            MarkUIClickable()
            if hovered && !active {
                fill = GetThemeButtonHover()
                top = DarkenUIColor(GetThemeButtonHover(), 40)
                bottom = LightenUIColor(GetThemeButtonHover(), 40)
            }
        }

        DrawRectangle(segment_x, y, current_w, h, fill)
        Bevel(segment_x, y, current_w, h, top, bottom)
        text_w = TextWidth(labels[i], font)
        Text(labels[i], segment_x + (current_w - text_w) / 2, GetUIControlTextY(labels[i], y, h, font), font, GetThemeText())
        if active_hit && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) && !UIInputCapturesClick(mouse_world) && selected != i {
            app->habits.hold_stats_range_days = values[i]
            clicked = 1
        }
    }

    return clicked
}

statistics_content_height :: (linked_count: int, mood_count: int) -> int #private {
    return ScaleUIPx(linked_count > 0 ? 710 : 420) +
           (mood_count > 0 ? ScaleUIPx(188) : 0)
}

statistics_scroll_page_content_height :: (content_w: int, user_data: void*) -> int #private {
    ctx := (StatisticsScrollPageContext*)user_data

    unused content_w
    return statistics_content_height(ctx->linked_count, ctx->mood_count)
}

statistics_draw_hold_graph :: (app: InbeApp*, linked_ctx: const HabitLinkedContext*, content_x: int, y: int, content_w: int, today_tm: const struct tm*, filter: int, accent: Color) #private {
    points := (StatisticsGraphPoint[STATISTICS_MAX_GRAPH_POINTS]){0}
    point_count := 0
    graph_days := app->habits.hold_stats_range_days == 31 ? 31 : 7
    day_points := (int[STATISTICS_MAX_GRAPH_DAYS]){0}
    day_totals := (int[STATISTICS_MAX_GRAPH_DAYS]){0}
    max_hold := 1
    graph_h := ScaleUIPx(170)
    axis_w := ScaleUIPx(48)
    plot_x := content_x + axis_w
    plot_y := y + ScaleUIPx(8)
    plot_w := content_w - axis_w - ScaleUIPx(10)
    plot_h := graph_h - ScaleUIPx(36)
    axis_label: [32] char = {0}

    DrawRectangle(content_x, y, content_w, graph_h, DarkenUIColor(GetThemeBackground(), 7))
    for int i = 0; linked_ctx != NULL && i < linked_ctx->count; i++ {
        entry: const HabitLinkedEntry* = &linked_ctx->entries[i]
        day_index := 0
        day_offset := 0

        if !statistics_entry_matches_filter(entry, filter) {
            continue
        }
        day_index = entry->year * 10000 + entry->month * 100 + entry->day
        day_offset = statistics_day_offset_from_today(day_index, today_tm)
        if day_offset < 0 || day_offset >= graph_days {
            continue
        }
        for int r = 0; r < entry->round_count && point_count < STATISTICS_MAX_GRAPH_POINTS; r++ {
            day_slot := graph_days - 1 - day_offset
            if entry->rounds[r] > max_hold {
                max_hold = entry->rounds[r]
            }
            day_points[day_slot]++
            day_totals[day_slot] += entry->rounds[r]
            points[point_count++] = (StatisticsGraphPoint){day_index * 86400 + entry->hour * 3600 + entry->minute * 60 + entry->second, r, day_slot, entry->rounds[r], 0, 0}
        }
    }

    for int i = 1; i < point_count; i++ {
        point: StatisticsGraphPoint = points[i]
        j := i - 1
        while j >= 0 && (points[j].time_key > point.time_key || (points[j].time_key == point.time_key && points[j].round_index > point.round_index)) {
            points[j + 1] = points[j]
            j--
        }
        points[j + 1] = point
    }

    for int i = 1; i < graph_days; i++ {
        if graph_days == 7 || i % 5 == 0 {
            x := plot_x + (plot_w * i) / graph_days
            DrawLine(x, plot_y, x, plot_y + plot_h, DarkenUIColor(GetThemeBackground(), 22))
        }
    }
    for int i = 0; i <= 2; i++ {
        line_y := plot_y + (plot_h * i) / 2
        seconds := max_hold - (max_hold * i) / 2
        snprintf(axis_label, sizeof(axis_label), "%ds", seconds)
        DrawLine(plot_x, line_y, plot_x + plot_w, line_y, DarkenUIColor(GetThemeBackground(), 20))
        Text(axis_label, content_x + ScaleUIPx(4), line_y - ScaleUIPx(8), Text12, DarkenUIColor(GetThemeText(), 24))
    }
    DrawLine(plot_x, plot_y + plot_h, plot_x + plot_w, plot_y + plot_h, DarkenUIColor(GetThemeText(), 42))
    {
        day_seen := (int[STATISTICS_MAX_GRAPH_DAYS]){0}
        day_first_x := (int[STATISTICS_MAX_GRAPH_DAYS]){0}
        day_last_x := (int[STATISTICS_MAX_GRAPH_DAYS]){0}

        for int i = 0; i < graph_days; i++ {
            day_first_x[i] = -1
            day_last_x[i] = -1
        }
        for int i = 0; i < point_count; i++ {
            day_slot := points[i].day_slot
            count := day_points[day_slot] > 0 ? day_points[day_slot] : 1
            ordinal := day_seen[day_slot]++
            x0 := plot_x + (plot_w * day_slot) / graph_days
            x1 := plot_x + (plot_w * (day_slot + 1)) / graph_days
            points[i].x = x0 + ((ordinal + 1) * (x1 - x0)) / (count + 1)
            points[i].y = plot_y + plot_h - (points[i].hold_seconds * (plot_h - ScaleUIPx(10))) / max_hold
            if day_first_x[day_slot] < 0 || points[i].x < day_first_x[day_slot] {
                day_first_x[day_slot] = points[i].x
            }
            if day_last_x[day_slot] < 0 || points[i].x > day_last_x[day_slot] {
                day_last_x[day_slot] = points[i].x
            }
        }

        {
            prev_x := 0
            prev_y := 0
            has_prev := 0

            for int i = 0; i < graph_days; i++ {
                avg_seconds := 0
                avg_y := 0

                if day_points[i] <= 0 {
                    continue
                }
                avg_seconds = day_totals[i] / day_points[i]
                avg_y = plot_y + plot_h - (avg_seconds * (plot_h - ScaleUIPx(10))) / max_hold
                if has_prev {
                    DrawLine(prev_x, prev_y, day_first_x[i], avg_y, accent)
                }
                DrawLine(day_first_x[i], avg_y, day_last_x[i], avg_y, accent)
                prev_x = day_last_x[i]
                prev_y = avg_y
                has_prev = 1
            }
        }
    }

    for int i = 0; i < point_count; i++ {
        DrawCircle(points[i].x, points[i].y, ScaleUIPx(3), accent)
    }
    if point_count <= 0 {
        empty := GetLocaleText(graph_days == 31 ? "habit_stats_no_rounds_month" : "habit_stats_no_rounds_week")
        text_w := TextWidth(empty, Text12)
        Text(empty, content_x + (content_w - text_w) / 2, y + graph_h / 2 - ScaleUIPx(8), Text12, DarkenUIColor(GetThemeText(), 24))
    }
    for int i = 0; i < graph_days; i++ {
        day_offset := graph_days - 1 - i
        show_label := graph_days == 7 || day_offset == 0 || day_offset % 5 == 0
        label: [8] char = {0}
        day_x := 0

        if !show_label {
            continue
        }
        if day_offset == 0 {
            snprintf(label, sizeof(label), "%s", GetLocaleText("statistics_now_label"))
        } else {
            FormatLocaleText(label, sizeof(label), "statistics_day_offset_label", day_offset)
        }
        day_x = plot_x + (plot_w * i) / graph_days
        Text(label, day_x + ScaleUIPx(2), y + graph_h - ScaleUIPx(20), Text12, DarkenUIColor(GetThemeText(), 24))
    }
}

statistics_draw_view :: (app: InbeApp*, active: InbeHabit*, linked_ctx: HabitLinkedContext*, content_x: int, content_w: int, y: int) #private {
    now := time(NULL)
    today_tm: struct tm = (struct tm){0}
    now_tm := localtime(&now)
    current_streak := 0
    best_streak := 0
    running_streak := 0
    last_30_done := 0
    last_30_total := 30
    weekday_counts: [7] int = {0}
    max_weekday := 1
    chart_h := ScaleUIPx(128)
    metrics_gap := ScaleUIPx(8)
    metric_h := ScaleUIPx(66)
    metric_w := 0
    value: [64] char = {0}
    has_wim_hof_rounds := statistics_has_wim_hof_rounds(linked_ctx)
    mood_stats: InbeStorageMoodStats = {0}
    mood_count := 0

    if active != nil && active->sync_mode == INBE_HABIT_SYNC_ACTIVITIES &&
       active->sync_activity != 0 {
        mood_count = storage_mood_stats(active->sync_activity, 0, &mood_stats)
    }

    if now_tm != NULL {
        today_tm = *now_tm
    } else {
        memset(&today_tm, 0, sizeof(today_tm))
    }
    today_tm.tm_hour = 12
    today_tm.tm_min = 0
    today_tm.tm_sec = 0
    mktime(&today_tm)
    for int i = 0; i < 365; i++ {
        day_tm: struct tm = today_tm
        day_index := 0
        count := 0

        day_tm.tm_mday -= i
        mktime(&day_tm)
        day_index = habit_tm_date_index(&day_tm)
        count = statistics_day_count(active, linked_ctx, day_index)
        scheduled := active == nil || active->weekdays == 0 ||
                     (active->weekdays &
                      (1 << ((day_tm.tm_wday + 6) % 7))) != 0
        if i < 30 && count > 0 {
            last_30_done++
        }
        if i < 56 && count > 0 {
            weekday := statistics_day_of_week(day_index)
            if weekday >= 0 && weekday < 7 {
                weekday_counts[weekday]++
                if weekday_counts[weekday] > max_weekday {
                    max_weekday = weekday_counts[weekday]
                }
            }
        }
        if count > 0 {
            running_streak++
            if running_streak > best_streak {
                best_streak = running_streak
            }
            if i == current_streak {
                current_streak++
            }
        } else if !scheduled {
            # off-schedule days neither extend nor break a streak
            if i == current_streak {
                current_streak++
            }
        } else {
            running_streak = 0
        }
    }

    metric_w = (content_w - metrics_gap) / 2
    statistics_format_day_count(value, sizeof(value), current_streak)
    statistics_draw_metric(content_x, y, metric_w, metric_h, GetLocaleText("habit_stats_current_streak"), value, active->color)
    snprintf(value, sizeof(value), "%d/%d", last_30_done, last_30_total)
    statistics_draw_metric(content_x + metric_w + metrics_gap, y, content_w - metric_w - metrics_gap, metric_h, GetLocaleText("habit_stats_last_30_days"), value, LightenUIColor(active->color, 24))
    y += metric_h + ScaleUIPx(22)

    if mood_count > 0 {
        y += statistics_draw_mood_panel(content_x, y, content_w, &mood_stats,
                                        active->color) + ScaleUIPx(22)
    }

    if has_wim_hof_rounds {
        y += statistics_draw_section_title(GetLocaleText("habit_stats_wim_hof_hold_rounds"), content_x, y, content_w) + ScaleUIPx(10)
        statistics_draw_hold_range_selector(app, content_x, y, ScaleUIPx(118))
        y += ScaleUIPx(42)
        statistics_draw_hold_graph(app, linked_ctx, content_x, y, content_w, &today_tm, EXERCISE_WIM_HOF, active->color)
        y += ScaleUIPx(194)
    }

    y += statistics_draw_section_title(GetLocaleText("habit_stats_weekday_pattern"), content_x, y, content_w) + ScaleUIPx(10)
    DrawRectangle(content_x, y, content_w, chart_h, DarkenUIColor(GetThemeBackground(), 7))
    {
        labels: [7] const char* = {"S", "M", "T", "W", "T", "F", "S"}
        slot_w := content_w / 7
        for int i = 0; i < 7; i++ {
            h := weekday_counts[i] > 0 ? (weekday_counts[i] * (chart_h - ScaleUIPx(34))) / max_weekday : ScaleUIPx(3)
            x := content_x + i * slot_w + ScaleUIPx(5)
            w := slot_w - ScaleUIPx(10)
            bar_y := y + chart_h - h - ScaleUIPx(22)

            if w < ScaleUIPx(4) {
                w = ScaleUIPx(4)
            }
            DrawRectangle(x, bar_y, w, h, weekday_counts[i] > 0 ? LightenUIColor(active->color, 12) : DarkenUIColor(GetThemeBackground(), 24))
            Text(labels[i], x + (w - TextWidth(labels[i], Text12)) / 2, y + chart_h - ScaleUIPx(18), Text12, DarkenUIColor(GetThemeText(), 18))
        }
    }
    y += chart_h + ScaleUIPx(24)

    if linked_ctx != NULL && linked_ctx->count > 0 {
        best: [32] char = {0}
        total: [32] char = {0}
        y += statistics_draw_section_title(GetLocaleText("habit_stats_practice_time"), content_x, y, content_w) + ScaleUIPx(10)
        habit_format_duration(linked_ctx->best_seconds, best, sizeof(best))
        habit_format_duration(linked_ctx->total_seconds, total, sizeof(total))
        statistics_draw_metric(content_x, y, metric_w, metric_h, GetLocaleText("habit_stats_best_hold"), best, active->color)
        statistics_draw_metric(content_x + metric_w + metrics_gap, y, content_w - metric_w - metrics_gap, metric_h, GetLocaleText("habit_stats_total_hold"), total, LightenUIColor(active->color, 20))
    } else {
        statistics_format_day_count(value, sizeof(value), best_streak)
        statistics_draw_metric(content_x, y, content_w, metric_h, GetLocaleText("habit_stats_best_streak"), value, active->color)
    }
}

draw_statistics_content :: (app: InbeApp*, content_top: int) {
    if app == NULL {
        return
    }

    content_bottom := app_content_bottom_reserved(app)
    viewport_h := view_height - content_top - content_bottom
    scroll_y := content_top + ScaleUIPx(4)
    scroll_h := viewport_h - ScaleUIPx(4)
    max_w := ScaleUIPx(CONTENT_MAX_W)
    active := (InbeHabit*)NULL
    linked_ctx := (HabitLinkedContext*)NULL
    page_ctx := (StatisticsScrollPageContext){0}
    page := (UIScrollPage){0}
    page_mood_stats: InbeStorageMoodStats = {0}
    page_mood_count := 0

    if app->habits.count <= 0 {
        return
    }
    if app->habits.selected < 0 || app->habits.selected >= app->habits.count {
        app->habits.selected = 0
    }

    active = &app->habits.items[app->habits.selected]
    if habit_is_linked(active) {
        linked_ctx = calloc(1, sizeof(*linked_ctx))
        if linked_ctx != NULL {
            habit_collect_linked_entries(active, 0, linked_ctx)
        }
    }

    if scroll_h < 0 {
        scroll_h = 0
    }
    if active != NULL && active->sync_mode == INBE_HABIT_SYNC_ACTIVITIES &&
       active->sync_activity != 0 {
        page_mood_count = storage_mood_stats(active->sync_activity, 0,
                                             &page_mood_stats)
    }
    page_ctx.linked_count = linked_ctx != NULL ? linked_ctx->count : 0
    page_ctx.mood_count = page_mood_count
    page = BeginUIScrollPage((UIScrollPageSpec){.y = scroll_y, .height = scroll_h, .max_content_width = max_w, .scroll_offset = &app->habits.scroll, .content_height = statistics_scroll_page_content_height, .user_data = &page_ctx})
    statistics_draw_view(app, active, linked_ctx, page.content_x, page.content_w, page.content_y + ScaleUIPx(8))
    EndUIScrollPage(page)
    free(linked_ctx)
}
