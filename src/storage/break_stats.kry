#import "storage.h"
#import "breaks/break_engine.h"

#import "storage/db.h" #private
#import <sqlite3.h>
#import <stdio.h>
#import <time.h>

BreakDayRow :: struct {
    local_date: int
    break_type: int
    prompts: int
    repeated_prompts: int
    taken: int
    natural: int
    skipped: int
    postponed: int
    overdue_s: int
    usage_s: int
}

storage_break_today :: () -> int #private {
    now: time_t = time(nil)
    tm: struct tm* = localtime(&now)

    if tm == nil {
        return 0
    }
    return (tm->tm_year + 1900) * 10000 + (tm->tm_mon + 1) * 100 + tm->tm_mday
}

storage_break_flush_day :: (e: const BreakEngine*) {
    sql: const char* = "INSERT OR REPLACE INTO break_days("
        "(user_id,local_date,break_type,prompts,repeated_prompts,taken,"
        "natural,skipped,postponed,overdue_s,usage_s,updated_at) "
        "VALUES(?,?,?,?,?,?,?,?,?,?,?,?)"
    stmt: sqlite3_stmt* = nil
    date: int
    now: long long

    if e == nil || g_storage.db == nil {
        return
    }

    date = storage_break_today()
    if date <= 0 {
        return
    }
    now = now_seconds()

    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return
    }

    for int t = 0; t < BREAK_TYPE_COUNT; t++ {
        sqlite3_reset(stmt)
        sqlite3_bind_text(stmt, 1, g_storage.user_id, -1, SQLITE_TRANSIENT)
        sqlite3_bind_int(stmt, 2, date)
        sqlite3_bind_int(stmt, 3, t)
        sqlite3_bind_int(stmt, 4, e->stats[t].prompts)
        sqlite3_bind_int(stmt, 5, e->stats[t].repeated_prompts)
        sqlite3_bind_int(stmt, 6, e->stats[t].taken)
        sqlite3_bind_int(stmt, 7, e->stats[t].natural)
        sqlite3_bind_int(stmt, 8, e->stats[t].skipped)
        sqlite3_bind_int(stmt, 9, e->stats[t].postponed)
        sqlite3_bind_int(stmt, 10, e->stats[t].overdue_s)
        sqlite3_bind_int(stmt, 11, e->usage_today_s)
        sqlite3_bind_int64(stmt, 12, now)
        if sqlite3_step(stmt) != SQLITE_DONE {
            break
        }
    }
    sqlite3_finalize(stmt)
}

storage_break_history :: (days: int, out: BreakDayRow*, max_rows: int) -> int {
    sql: const char* = "SELECT local_date,break_type,prompts,repeated_prompts,"
        "taken,natural,skipped,postponed,overdue_s,usage_s FROM break_days "
        "WHERE user_id = ? AND local_date >= ? ORDER BY local_date DESC,break_type"
    stmt: sqlite3_stmt* = nil
    today: int
    cutoff: int
    count: int

    if out == nil || max_rows <= 0 || g_storage.db == nil {
        return 0
    }

    today = storage_break_today()
    cutoff = today - days * 100
    if cutoff < 0 {
        cutoff = 0
    }

    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    sqlite3_bind_text(stmt, 1, g_storage.user_id, -1, SQLITE_TRANSIENT)
    sqlite3_bind_int(stmt, 2, cutoff)

    count = 0
    for int guard = 0; guard < max_rows; guard++ {
        if sqlite3_step(stmt) != SQLITE_ROW {
            break
        }
        out[count].local_date = sqlite3_column_int(stmt, 0)
        out[count].break_type = sqlite3_column_int(stmt, 1)
        out[count].prompts = sqlite3_column_int(stmt, 2)
        out[count].repeated_prompts = sqlite3_column_int(stmt, 3)
        out[count].taken = sqlite3_column_int(stmt, 4)
        out[count].natural = sqlite3_column_int(stmt, 5)
        out[count].skipped = sqlite3_column_int(stmt, 6)
        out[count].postponed = sqlite3_column_int(stmt, 7)
        out[count].overdue_s = sqlite3_column_int(stmt, 8)
        out[count].usage_s = sqlite3_column_int(stmt, 9)
        count++
    }
    sqlite3_finalize(stmt)
    return count
}
