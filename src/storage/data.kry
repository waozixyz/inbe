ANDROID :: ANDROID_BUILD
WEB :: #defined(PLATFORM_WEB)
WIN32 :: #defined(_WIN32)

#if ANDROID {
    #import "android_share.h" #private
    #import <android_native_app_glue.h>
    GetAndroidApp :: () -> struct android_app* #extern
}

DATA_PATH_MAX :: 512

static g_data_root: [DATA_PATH_MAX] char = ""
static g_today_dir: [DATA_PATH_MAX] char = ""
static g_data_ready: int = 0

data_directory_exists :: (path: const char*) -> int #private {
    st: struct stat

    return path != nil && stat(path, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR
}

migrate_data_root :: (legacy_root: const char*, current_root: const char*) #private {
    backup_root: [DATA_PATH_MAX] char
    legacy_exists: int = data_directory_exists(legacy_root)
    current_exists: int = data_directory_exists(current_root)
    archived: int = 0
    moved: int = 0
    selected: int

    if legacy_exists && current_exists {
        for int suffix = 0; suffix < 16; suffix++ {
            snprintf(backup_root, sizeof(backup_root), STORAGE_DIR_ARCHIVE_FMT,
                     current_root, suffix + 1)
            if path_exists(backup_root) {
                continue
            }
            archived = rename(current_root, backup_root) == 0
            if archived {
                current_exists = 0
            }
            break
        }
        if !archived {
            TraceLog(LOG_WARNING, "DATA: existing current directory could not be archived; using legacy data")
        }
    }
    if legacy_exists && !current_exists {
        moved = rename(legacy_root, current_root) == 0
        if !moved {
            TraceLog(LOG_WARNING, "DATA: legacy directory move failed; continuing with existing data")
        }
    }
    selected = storage_layout_decisions[legacy_exists][current_exists][moved ? 0 : 1]
    snprintf(g_data_root, sizeof(g_data_root), "%s",
             selected == STORAGE_ROOT_CURRENT ? current_root : legacy_root)
}

data_root :: () -> const char* {
    if g_data_root[0] != '\0' {
        return g_data_root
    }

    # Desktop screenshot and test runs must never seed the real user's database.
    #if !WEB && !ANDROID {
        override_root: const char* = getenv("APP_DATA_ROOT")
        if override_root != nil && override_root[0] != '\0' {
            snprintf(g_data_root, sizeof(g_data_root), "%s", override_root)
            storage_ensure_dir(g_data_root)
            return g_data_root
        }
    }

    #if WEB {
        migrate_data_root(STORAGE_WEB_HOME_LEGACY, STORAGE_WEB_HOME)
    } #else_if ANDROID {
        app: struct android_app* = GetAndroidApp()
        internal_path: const char* = nil
        base_path: const char*
        legacy_root: [DATA_PATH_MAX] char
        current_root: [DATA_PATH_MAX] char

        if app != nil && app->activity != nil {
            internal_path = app->activity->internalDataPath
        }
        base_path = internal_path != nil && internal_path[0] != '\0' ?
                    internal_path : GetWorkingDirectory()
        storage_join_path(legacy_root, sizeof(legacy_root), base_path,
                          STORAGE_DIR_LEGACY_ANDROID)
        storage_join_path(current_root, sizeof(current_root), base_path,
                          STORAGE_DIR_NAME)
        migrate_data_root(legacy_root, current_root)
    } #else_if WIN32 {
        local: const char* = getenv("LOCALAPPDATA")
        roaming: const char* = getenv("APPDATA")
        base_path: const char* = local != nil && local[0] != '\0' ? local : roaming
        legacy_root: [DATA_PATH_MAX] char
        current_root: [DATA_PATH_MAX] char

        if base_path != nil && base_path[0] != '\0' {
            storage_join_path(legacy_root, sizeof(legacy_root), base_path,
                              STORAGE_DIR_LEGACY_WINDOWS)
            storage_join_path(current_root, sizeof(current_root), base_path,
                              STORAGE_DIR_NAME)
        } else {
            snprintf(legacy_root, sizeof(legacy_root), "%s", STORAGE_DIR_LEGACY_WINDOWS)
            snprintf(current_root, sizeof(current_root), "%s", STORAGE_DIR_NAME)
        }
        migrate_data_root(legacy_root, current_root)
    } #else {
        xdg: const char* = getenv("XDG_DATA_HOME")
        home: const char* = getenv("HOME")
        plan9_home: const char* = getenv("home")
        base_path: [DATA_PATH_MAX] char
        legacy_root: [DATA_PATH_MAX] char
        current_root: [DATA_PATH_MAX] char

        if xdg != nil && xdg[0] != '\0' {
            snprintf(base_path, sizeof(base_path), "%s", xdg)
        } else if home != nil && home[0] != '\0' {
            snprintf(base_path, sizeof(base_path), "%s/.local/share", home)
        } else if plan9_home != nil && plan9_home[0] != '\0' {
            snprintf(base_path, sizeof(base_path), "%s/.local/share", plan9_home)
        } else {
            snprintf(base_path, sizeof(base_path), ".local")
        }
        storage_join_path(legacy_root, sizeof(legacy_root), base_path,
                          STORAGE_DIR_LEGACY_POSIX)
        storage_join_path(current_root, sizeof(current_root), base_path,
                          STORAGE_DIR_NAME)
        migrate_data_root(legacy_root, current_root)
    }

    if !storage_ensure_dir(g_data_root) {
        TraceLog(LOG_ERROR, "DATA: failed to create root directory: %s", g_data_root)
    }
    TraceLog(LOG_INFO, "DATA: root directory: %s", g_data_root)
    return g_data_root
}

data_init :: () {
    if g_data_ready {
        return
    }
    g_data_ready = storage_init(data_root())
}

data_today_dir :: () -> const char* {
    now: time_t = time(nil)
    tm: struct tm* = localtime(&now)

    if tm == nil {
        return data_root()
    }
    snprintf(g_today_dir, sizeof(g_today_dir), "%s/%04d/%02d/%02d",
             data_root(), tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday)
    return g_today_dir
}

data_save_session_path :: (round_times: const int*, round_count: int,
                              out_path: char*, out_path_size: size_t) -> int {
    data_init()
    return storage_save_session(round_times, round_count, out_path, out_path_size)
}

data_save_session_path_for_activity :: (round_times: const int*, round_count: int,
                                           topic: int, activity: int,
                                           out_path: char*,
                                           out_path_size: size_t) -> int {
    data_init()
    return storage_save_session_for_activity(round_times, round_count, topic, activity,
                                             out_path, out_path_size)
}

data_replace_session :: (path: const char*, round_times: const int*,
                            round_count: int) -> int {
    data_init()
    return storage_replace_session(path, round_times, round_count)
}

data_rename_session :: (old_path: const char*, new_path: const char*) -> int {
    name: const char*
    hour: int = 0
    minute: int = 0
    second: int = 0

    data_init()
    name = GetFileName(new_path)
    if name == nil ||
       sscanf(name, STORAGE_SESSION_LEGACY_SCAN, &hour, &minute, &second) != 3 {
        return 0
    }
    unused second
    return storage_rename_session_time(old_path, hour, minute)
}

data_delete_session :: (path: const char*) -> int {
    data_init()
    return storage_delete_session(path)
}

data_discard_session :: (path: const char*) -> int {
    data_init()
    return storage_delete_session(path)
}

data_save_session_checkin :: (path: const char*,
                                 checkin: const StorageSessionCheckin*) -> int {
    data_init()
    return storage_save_session_checkin(path, checkin)
}

data_has_any :: () -> int {
    data_init()
    return storage_has_any()
}

data_get_total_size :: () -> long long {
    data_init()
    return storage_total_size()
}

data_get_session_count :: () -> int {
    data_init()
    return storage_session_count()
}

data_delete_all :: () -> long long {
    data_init()
    return storage_delete_all_sessions()
}

data_default_export_filename :: (out: char*, out_size: size_t) {
    now: time_t

    if out == nil || out_size == 0 {
        return
    }

    now = time(nil)
    if now > 0 {
        snprintf(out, out_size, STORAGE_EXPORT_FILENAME_FMT, (long long)now)
    } else {
        snprintf(out, out_size, "%s", STORAGE_EXPORT_FILENAME_FALLBACK)
    }
}

data_export :: (path: const char*) -> int {
    data_init()
    #if ANDROID {
        filename: [64] char = {0}

        if path != nil && path[0] != '\0' {
            return android_share_export(path)
        }
        data_default_export_filename(filename, sizeof(filename))
        return android_share_export(filename)
    } #else {
        return storage_export_zip(path)
    }
}

data_validate_import_file :: (path: const char*) -> int {
    fp: FILE*

    if path == nil || path[0] == '\0' || !FileExists(path) {
        return 0
    }
    fp = fopen(path, "rb")
    if fp == nil {
        return 0
    }
    fclose(fp)
    return 1
}

data_import :: (path: const char*) -> int {
    return data_import_with_mode(path, DATA_IMPORT_DATA_ONLY)
}

data_import_with_mode :: (path: const char*, mode: DataImportMode) -> int {
    extension: const char*

    data_init()
    extension = path != nil ? strrchr(path, '.') : nil
    if extension != nil && strcmp(extension, ".1list") == 0 {
        return storage_elist_import_onelist(path)
    }
    return storage_import_zip_ex(
        path,
        mode == DATA_IMPORT_DATA_AND_SETTINGS
            ? STORAGE_IMPORT_DATA_AND_SETTINGS
            : STORAGE_IMPORT_DATA_ONLY)
}

data_inspect_import :: (path: const char*, info: DataImportInfo*) -> int {
    storage_info: StorageImportInfo
    extension: const char*

    data_init()
    if info != nil {
        memset(info, 0, sizeof(*info))
    }
    extension = path != nil ? strrchr(path, '.') : nil
    if extension != nil && strcmp(extension, ".1list") == 0 {
        if !data_validate_import_file(path) {
            return 0
        }
        if info != nil {
            info->valid = 1
        }
        return 1
    }
    if !storage_inspect_import(path, &storage_info) {
        return 0
    }
    if info != nil {
        info->valid = storage_info.valid
        info->has_sessions = storage_info.has_sessions
        info->has_habits = storage_info.has_habits
        info->has_settings = storage_info.has_settings
        info->session_count = storage_info.session_count
        info->habit_count = storage_info.habit_count
        info->setting_count = storage_info.setting_count
    }
    return 1
}

DbListSessionContext :: struct {
    callback: data_session_callback
    user: void*
}

db_list_session_callback :: (path: const char*, year: int, month: int, day: int,
                            hour: int, minute: int, second: int,
                            topic: int, activity: int,
                            round_times: const int*, round_count: int,
                            user: void*) #private {
    ctx: DbListSessionContext* = user
    date: [16] char = {0}
    time_text: [16] char = {0}
    best: int = 0

    unused path
    unused topic
    unused activity
    for int i = 0; i < round_count; i++ {
        if round_times[i] > best {
            best = round_times[i]
        }
    }
    snprintf(date, sizeof(date), "%04d-%02d-%02d", year, month, day)
    snprintf(time_text, sizeof(time_text), "%02d:%02d:%02d", hour, minute, second)
    ctx->callback(date, time_text, round_count, best, ctx->user)
}

data_list_sessions :: (callback: data_session_callback, user: void*) {
    ctx: DbListSessionContext = {callback, user}

    if callback == nil {
        return
    }
    data_list_session_records(db_list_session_callback, &ctx)
}

data_list_session_records :: (callback: data_session_record_callback,
                                 user: void*) {
    data_init()
    if callback != nil {
        storage_list_session_records((StorageSessionRecordCallback)callback, user)
    }
}

data_load_session :: (path: const char*, round_times: int*, max_rounds: int,
                         year: int*, month: int*, day: int*,
                         hour: int*, minute: int*, second: int*) -> int {
    data_init()
    return storage_load_session(path, round_times, max_rounds,
                                year, month, day, hour, minute, second)
}
