#module "storage.db"
#import "storage/db.h"
#import "storage_layout.h"

#import "import.h"
#import "kryon.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "sys/stat.h"
#import "time.h"
#import "unistd.h"

WIN32 :: #defined(_WIN32)
ANDROID :: ANDROID_BUILD
EMSCRIPTEN :: #defined(__EMSCRIPTEN__)
WEB :: #defined(PLATFORM_WEB)

g_storage :: StorageState #global #export

make_user_id :: (out: char*, out_size: size_t) {
    r: unsigned int = (unsigned int)rand()

    snprintf(out, out_size, "local-%lld-%u", now_seconds(), r)
}

storage_join_path :: (out: char*, out_size: size_t, root: const char*,
                                name: const char*) -> int #export {
    root_len: size_t
    name_len: size_t

    if out == nil || out_size == 0 || root == nil || root[0] == '\0' ||
       name == nil {
        return 0
    }
    root_len = strlen(root)
    name_len = strlen(name)
    if root_len + 1 + name_len + 1 > out_size {
        return 0
    }
    memcpy(out, root, root_len)
    out[root_len] = '/'
    memcpy(out + root_len + 1, name, name_len + 1)
    return 1
}

path_exists :: (path: const char*) -> int #export {
    st: struct stat

    return path != nil && stat(path, &st) == 0
}

storage_dir_exists :: (path: const char*) -> int #private {
    st: struct stat

    return path != nil && stat(path, &st) == 0 && S_ISDIR(st.st_mode)
}

storage_make_dir :: (path: const char*) -> int #private {
    #if WIN32 {
        return mkdir(path) == 0
    } #else {
        return mkdir(path, 0700) == 0
    }
}

# The one recursive directory creator for app storage. Every persisted path
# goes through storage_join_path + storage_ensure_dir; duplicates are banned
# by scripts/check-storage-literals.sh.
storage_ensure_dir :: (path: const char*) -> int #export {
    temp: [STORAGE_PATH_SIZE] char
    p: char*

    if path == nil || path[0] == '\0' {
        return 0
    }
    if storage_dir_exists(path) {
        return 1
    }

    snprintf(temp, sizeof(temp), "%s", path)
    p = temp
    if *p == '/' {
        p++
    }
    while (p = strchr(p, '/')) != nil {
        *p = '\0'
        if temp[0] != '\0' && !storage_dir_exists(temp) &&
           !storage_make_dir(temp) && !storage_dir_exists(temp) {
            *p = '/'
            return 0
        }
        *p = '/'
        p++
    }
    return storage_make_dir(path) || storage_dir_exists(path)
}

exec_sql :: (sql: const char*) -> int #export {
    error: char* = nil
    rc: int = SQLITE_OK
    mutex: sqlite3_mutex*
    held: int*

    if g_storage.db == nil || sql == nil {
        return 0
    }
    mutex = sqlite3_db_mutex(g_storage.db)
    held = storage_sql_transaction_lock_held()
    if mutex != nil && *held == 0 {
        sqlite3_mutex_enter(mutex)
        *held = 1
    }

    for int attempt = 0; attempt < 20; attempt++ {
        rc = sqlite3_exec(g_storage.db, sql, nil, nil, &error)
        if rc == SQLITE_OK {
            break
        }
        if rc != SQLITE_BUSY && rc != SQLITE_LOCKED {
            break
        }
        sqlite3_free(error)
        error = nil
        #if !EMSCRIPTEN {
            usleep(50000)
        }
    }
    if rc != SQLITE_OK {
        TraceLog(LOG_ERROR, "STORAGE: SQL failed code=%d: %s", rc,
                 error != nil ? error : sqlite3_errmsg(g_storage.db))
        sqlite3_free(error)
    }
    if mutex != nil && *held != 0 && sqlite3_get_autocommit(g_storage.db) {
        *held = 0
        sqlite3_mutex_leave(mutex)
    }
    return rc == SQLITE_OK
}

table_has_column :: (table: const char*, column: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    sql: [128] char
    found: int = 0

    if table == nil || column == nil || g_storage.db == nil {
        return 0
    }
    snprintf(sql, sizeof(sql), "PRAGMA table_info(%s)", table)
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    while sqlite3_step(stmt) == SQLITE_ROW {
        name: const char* = (const char*)sqlite3_column_text(stmt, 1)

        if name != nil && strcmp(name, column) == 0 {
            found = 1
            break
        }
    }
    sqlite3_finalize(stmt)
    return found
}

table_exists :: (table: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    found: int = 0

    if table == nil || g_storage.db == nil {
        return 0
    }
    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?1 LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, table)
    found = sqlite3_step(stmt) == SQLITE_ROW
    sqlite3_finalize(stmt)
    return found
}

now_seconds :: () -> long long #export {
    return (long long)time(nil)
}

bind_text :: (stmt: sqlite3_stmt*, index: int, text: const char*) -> int #export {
    return sqlite3_bind_text(stmt, index, text != nil ? text : "", -1,
                             SQLITE_TRANSIENT) == SQLITE_OK
}

db_select_int64 :: (sql: const char*, fallback: long long) -> long long #export {
    stmt: sqlite3_stmt* = nil
    value: long long = fallback

    if g_storage.db == nil || sql == nil {
        return fallback
    }
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return fallback
    }
    if sqlite3_step(stmt) == SQLITE_ROW {
        value = sqlite3_column_int64(stmt, 0)
    }
    sqlite3_finalize(stmt)
    return value
}

db_select_int :: (sql: const char*, fallback: int) -> int #export {
    return (int)db_select_int64(sql, fallback)
}

db_exec_text :: (sql: const char*, text: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    ok: int

    if g_storage.db == nil || sql == nil {
        return 0
    }
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, text)
    ok = sqlite3_step(stmt) == SQLITE_DONE
    sqlite3_finalize(stmt)
    return ok
}

schema_exec :: (sql: const char*) -> int {
    return exec_sql(sql)
}

schema_create :: () -> int #export {
    #if WEB {
        if !schema_exec(
            "PRAGMA journal_mode=WAL;"
            "PRAGMA synchronous=OFF;"
            "PRAGMA foreign_keys=ON;") {
            return 0
        }
    } #else {
        if !schema_exec(
            "PRAGMA journal_mode=WAL;"
            "PRAGMA synchronous=NORMAL;"
            "PRAGMA foreign_keys=ON;") {
            return 0
        }
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS meta("
        " key TEXT PRIMARY KEY,"
        " value TEXT NOT NULL"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS users("
        " id TEXT PRIMARY KEY,"
        " created_at INTEGER NOT NULL,"
        " kind TEXT NOT NULL"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS settings("
        " user_id TEXT NOT NULL,"
        " key TEXT NOT NULL,"
        " value TEXT NOT NULL,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(user_id,key)"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS social_snapshots("
        " user_id TEXT NOT NULL,"
        " kind TEXT NOT NULL,"
        " json TEXT NOT NULL,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(user_id,kind)"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS sessions("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " started_at INTEGER NOT NULL,"
        " local_date INTEGER NOT NULL,"
        " topic INTEGER NOT NULL DEFAULT 0,"
        " activity INTEGER NOT NULL DEFAULT 0,"
        " source TEXT NOT NULL,"
        " imported_at INTEGER NOT NULL,"
        " rounds_hash INTEGER NOT NULL,"
        " mood_before INTEGER NOT NULL DEFAULT 0,"
        " mood_after INTEGER NOT NULL DEFAULT 0,"
        " energy INTEGER NOT NULL DEFAULT 0,"
        " stress INTEGER NOT NULL DEFAULT 0,"
        " note TEXT NOT NULL DEFAULT '',"
        " tags TEXT NOT NULL DEFAULT '',"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL DEFAULT 0,"
        " UNIQUE(user_id,started_at,rounds_hash)"
        ");"
        "CREATE TABLE IF NOT EXISTS session_rounds("
        " session_id TEXT NOT NULL,"
        " round_index INTEGER NOT NULL,"
        " seconds INTEGER NOT NULL,"
        " PRIMARY KEY(session_id,round_index)"
        ");"
        "CREATE TABLE IF NOT EXISTS meditation_logs("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " session_id TEXT NOT NULL,"
        " duration_seconds INTEGER NOT NULL,"
        " completed_at INTEGER NOT NULL,"
        " updated_at INTEGER NOT NULL DEFAULT 0"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS habits("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " name TEXT NOT NULL,"
        " description TEXT NOT NULL DEFAULT '',"
        " color_r INTEGER NOT NULL,"
        " color_g INTEGER NOT NULL,"
        " color_b INTEGER NOT NULL,"
        " sync_mode INTEGER NOT NULL,"
        " sync_activity INTEGER NOT NULL,"
        " counter_enabled INTEGER NOT NULL DEFAULT 0,"
        " counter_target INTEGER NOT NULL DEFAULT 1,"
        " sort_order INTEGER NOT NULL,"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL DEFAULT 0"
        ");"
        "CREATE TABLE IF NOT EXISTS habit_days("
        " habit_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL,"
        " completed INTEGER NOT NULL,"
        " count INTEGER NOT NULL DEFAULT 0,"
        " session_count INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(habit_id,local_date)"
        ");"
        "CREATE TABLE IF NOT EXISTS sync_remote_habit_map("
        " old_id TEXT PRIMARY KEY,"
        " new_id TEXT NOT NULL"
        ");"
        "CREATE TABLE IF NOT EXISTS break_days("
        " user_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL,"
        " break_type INTEGER NOT NULL,"
        " prompts INTEGER NOT NULL DEFAULT 0,"
        " repeated_prompts INTEGER NOT NULL DEFAULT 0,"
        " taken INTEGER NOT NULL DEFAULT 0,"
        " natural INTEGER NOT NULL DEFAULT 0,"
        " skipped INTEGER NOT NULL DEFAULT 0,"
        " postponed INTEGER NOT NULL DEFAULT 0,"
        " overdue_s INTEGER NOT NULL DEFAULT 0,"
        " usage_s INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(user_id,local_date,break_type)"
        ");"
        "CREATE TABLE IF NOT EXISTS elist_lists("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " title TEXT NOT NULL,"
        " sort_order INTEGER NOT NULL,"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL"
        ");"
        "CREATE TABLE IF NOT EXISTS elist_items("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " list_id TEXT NOT NULL,"
        " title TEXT NOT NULL,"
        " comment TEXT NOT NULL DEFAULT '',"
        " done INTEGER NOT NULL DEFAULT 0,"
        " sort_order INTEGER NOT NULL,"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS imports("
        " id TEXT PRIMARY KEY,"
        " imported_at INTEGER NOT NULL,"
        " format TEXT NOT NULL,"
        " source_name TEXT NOT NULL,"
        " session_count INTEGER NOT NULL,"
        " habit_count INTEGER NOT NULL"
        ");"
        "CREATE TABLE IF NOT EXISTS sync_outbox("
        " seq INTEGER PRIMARY KEY AUTOINCREMENT,"
        " entity_type TEXT NOT NULL,"
        " entity_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL DEFAULT 0,"
        " queued_at INTEGER NOT NULL,"
        " UNIQUE(entity_type,entity_id,local_date)"
        ");"
        "CREATE TABLE IF NOT EXISTS sync_ops("
        " op_id TEXT PRIMARY KEY,"
        " client_id TEXT NOT NULL,"
        " seq INTEGER NOT NULL,"
        " entity_type TEXT NOT NULL,"
        " entity_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL DEFAULT 0,"
        " op_type TEXT NOT NULL,"
        " payload_json TEXT NOT NULL DEFAULT '',"
        " created_at INTEGER NOT NULL,"
        " sent_at INTEGER NOT NULL DEFAULT 0,"
        " acked_at INTEGER NOT NULL DEFAULT 0"
        ");"
        "INSERT OR IGNORE INTO meta(key,value) VALUES('schema_version','1');") {
        return 0
    }
    return 1
}

load_or_create_user :: () -> int #export {
    stmt: sqlite3_stmt* = nil
    rc: int

    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT id FROM users WHERE kind='local' ORDER BY created_at LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    rc = sqlite3_step(stmt)
    if rc == SQLITE_ROW {
        snprintf(g_storage.user_id, sizeof(g_storage.user_id), "%s",
                 (const char*)sqlite3_column_text(stmt, 0))
        sqlite3_finalize(stmt)
        return 1
    }
    sqlite3_finalize(stmt)

    make_user_id(g_storage.user_id, sizeof(g_storage.user_id))
    if sqlite3_prepare_v2(g_storage.db,
                          "INSERT INTO users(id,created_at,kind) VALUES(?1,?2,'local')",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, g_storage.user_id)
    sqlite3_bind_int64(stmt, 2, now_seconds())
    rc = sqlite3_step(stmt)
    sqlite3_finalize(stmt)
    return rc == SQLITE_DONE
}

meta_equals :: (key: const char*, value: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    ok: int = 0

    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        ok = text != nil && strcmp(text, value) == 0
    }
    sqlite3_finalize(stmt)
    return ok
}

get_meta_text :: (key: const char*) -> const char* #export {
    stmt: sqlite3_stmt* = nil
    text_value: char* = storage_setting_text_buffer()

    text_value[0] = '\0'

    if g_storage.db == nil || key == nil {
        return nil
    }
    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return nil
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        snprintf(text_value, STORAGE_SETTING_TEXT_BUFFER_SIZE, "%s",
                 text != nil ? text : "")
    }
    sqlite3_finalize(stmt)
    return text_value[0] != '\0' ? text_value : nil
}

set_meta :: (key: const char*, value: const char*) #export {
    stmt: sqlite3_stmt* = nil

    if sqlite3_prepare_v2(g_storage.db,
                          "INSERT INTO meta(key,value) VALUES(?1,?2) "
                          "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                          -1, &stmt, nil) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, key)
    bind_text(stmt, 2, value)
    sqlite3_step(stmt)
    sqlite3_finalize(stmt)
}

get_meta_int64 :: (key: const char*, fallback: long long) -> long long #export {
    stmt: sqlite3_stmt* = nil
    value: long long = fallback

    if g_storage.db == nil || key == nil {
        return fallback
    }
    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return fallback
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        if text != nil && text[0] != '\0' {
            value = atoll(text)
        }
    }
    sqlite3_finalize(stmt)
    return value
}

set_meta_int64 :: (key: const char*, value: long long) #export {
    text: [32] char

    snprintf(text, sizeof(text), "%lld", value)
    set_meta(key, text)
}

migrate_schema :: () -> int #export {
    now: long long = now_seconds()
    had_outbox: int = table_exists("sync_outbox")

    if table_has_column("habits", "sync_topic") {
        if !exec_sql(
            "BEGIN IMMEDIATE;"
            "ALTER TABLE habits RENAME TO habits_with_sync_topic;"
            "CREATE TABLE habits("
            " id TEXT PRIMARY KEY,"
            " user_id TEXT NOT NULL,"
            " name TEXT NOT NULL,"
            " description TEXT NOT NULL DEFAULT '',"
            " color_r INTEGER NOT NULL,"
            " color_g INTEGER NOT NULL,"
            " color_b INTEGER NOT NULL,"
            " sync_mode INTEGER NOT NULL,"
            " sync_activity INTEGER NOT NULL,"
            " sort_order INTEGER NOT NULL,"
            " deleted_at INTEGER NOT NULL DEFAULT 0,"
            " updated_at INTEGER NOT NULL DEFAULT 0"
            ");"
            "INSERT INTO habits(id,user_id,name,description,color_r,color_g,color_b,sync_mode,sync_activity,sort_order,deleted_at,updated_at)"
            " SELECT id,user_id,name,'',color_r,color_g,color_b,sync_mode,sync_activity,sort_order,deleted_at,0"
            " FROM habits_with_sync_topic;"
            "DROP TABLE habits_with_sync_topic;"
            "COMMIT;") {
            return 0
        }
    }
    if !table_has_column("habits", "description") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN description TEXT NOT NULL DEFAULT ''") {
        return 0
    }
    if !table_has_column("habits", "counter_enabled") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN counter_enabled INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("habits", "counter_target") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN counter_target INTEGER NOT NULL DEFAULT 1") {
        return 0
    }
    if !table_has_column("habit_days", "count") &&
       !exec_sql("ALTER TABLE habit_days ADD COLUMN count INTEGER NOT NULL DEFAULT 0;"
                 "UPDATE habit_days SET count=CASE WHEN completed!=0 THEN 1 ELSE 0 END WHERE count=0") {
        return 0
    }
    if !table_has_column("habit_days", "session_count") &&
       !exec_sql("ALTER TABLE habit_days ADD COLUMN session_count INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("habits", "weekdays") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN weekdays INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("habits", "reminder_hour") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN reminder_hour INTEGER NOT NULL DEFAULT -1") {
        return 0
    }
    if !table_has_column("habits", "updated_at") {
        sql: [160] char

        snprintf(sql, sizeof(sql),
                 "ALTER TABLE habits ADD COLUMN updated_at INTEGER NOT NULL DEFAULT %lld",
                 now)
        if !exec_sql(sql) {
            return 0
        }
    }
    if !table_has_column("sessions", "updated_at") {
        sql: [160] char

        snprintf(sql, sizeof(sql),
                 "ALTER TABLE sessions ADD COLUMN updated_at INTEGER NOT NULL DEFAULT %lld",
                 now)
        if !exec_sql(sql) {
            return 0
        }
    }
    if !table_has_column("sessions", "mood_before") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN mood_before INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("sessions", "mood_after") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN mood_after INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("sessions", "energy") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN energy INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("sessions", "stress") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN stress INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("sessions", "note") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN note TEXT NOT NULL DEFAULT ''") {
        return 0
    }
    if !table_has_column("sessions", "tags") &&
       !exec_sql("ALTER TABLE sessions ADD COLUMN tags TEXT NOT NULL DEFAULT ''") {
        return 0
    }
    if !exec_sql(
           "CREATE TABLE IF NOT EXISTS sync_outbox("
           " seq INTEGER PRIMARY KEY AUTOINCREMENT,"
           " entity_type TEXT NOT NULL,"
           " entity_id TEXT NOT NULL,"
           " local_date INTEGER NOT NULL DEFAULT 0,"
           " queued_at INTEGER NOT NULL,"
           " UNIQUE(entity_type,entity_id,local_date)"
           ");"
           "CREATE TABLE IF NOT EXISTS sync_ops("
           " op_id TEXT PRIMARY KEY,"
           " client_id TEXT NOT NULL,"
           " seq INTEGER NOT NULL,"
           " entity_type TEXT NOT NULL,"
           " entity_id TEXT NOT NULL,"
           " local_date INTEGER NOT NULL DEFAULT 0,"
           " op_type TEXT NOT NULL,"
           " payload_json TEXT NOT NULL DEFAULT '',"
           " created_at INTEGER NOT NULL,"
           " sent_at INTEGER NOT NULL DEFAULT 0,"
           " acked_at INTEGER NOT NULL DEFAULT 0"
           ");"
           "CREATE TABLE IF NOT EXISTS social_snapshots("
           " user_id TEXT NOT NULL,"
           " kind TEXT NOT NULL,"
           " json TEXT NOT NULL,"
           " updated_at INTEGER NOT NULL,"
           " PRIMARY KEY(user_id,kind)"
           ");"
           "CREATE TABLE IF NOT EXISTS elist_lists("
           " id TEXT PRIMARY KEY,"
           " user_id TEXT NOT NULL,"
           " title TEXT NOT NULL,"
           " sort_order INTEGER NOT NULL,"
           " deleted_at INTEGER NOT NULL DEFAULT 0,"
           " updated_at INTEGER NOT NULL"
           ");"
           "CREATE TABLE IF NOT EXISTS elist_items("
           " id TEXT PRIMARY KEY,"
           " user_id TEXT NOT NULL,"
           " list_id TEXT NOT NULL,"
           " title TEXT NOT NULL,"
           " comment TEXT NOT NULL DEFAULT '',"
           " done INTEGER NOT NULL DEFAULT 0,"
           " sort_order INTEGER NOT NULL,"
           " deleted_at INTEGER NOT NULL DEFAULT 0,"
           " updated_at INTEGER NOT NULL"
           ");") {
        return 0
    }
    if table_exists("social_cache") {
        exec_sql("INSERT OR REPLACE INTO social_snapshots(user_id,kind,json,updated_at) "
                 "SELECT user_id,kind,json,updated_at FROM social_cache;"
                 "DROP TABLE social_cache;")
    }
    if !had_outbox {
        if !exec_sql(
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'habit',id,0,updated_at FROM habits;"
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'habit_day',habit_id,local_date,updated_at FROM habit_days;"
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'session',id,0,updated_at FROM sessions;") {
            return 0
        }
    }
    return 1
}

storage_copy_legacy_database :: (legacy_path: const char*, current_path: const char*,
                                  marker_path: const char*, temporary_path: const char*) -> int #private {
    source: sqlite3* = nil
    destination: sqlite3* = nil
    backup: sqlite3_backup* = nil
    check: sqlite3_stmt* = nil
    marker: FILE* = nil
    ok: int = 0
    rc: int
    marker_written: int = 0

    remove(temporary_path)
    if sqlite3_open_v2(legacy_path, &source, SQLITE_OPEN_READWRITE, nil) != SQLITE_OK {
        goto done
    }
    if sqlite3_open_v2(temporary_path, &destination,
                       SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nil) != SQLITE_OK {
        goto done
    }
    backup = sqlite3_backup_init(destination, "main", source, "main")
    if backup == nil {
        goto done
    }
    rc = sqlite3_backup_step(backup, -1)
    if sqlite3_backup_finish(backup) != SQLITE_OK || rc != SQLITE_DONE {
        backup = nil
        goto done
    }
    backup = nil
    if sqlite3_prepare_v2(destination, "PRAGMA quick_check", -1, &check, nil) != SQLITE_OK ||
       sqlite3_step(check) != SQLITE_ROW ||
       strcmp((const char*)sqlite3_column_text(check, 0), "ok") != 0 {
        goto done
    }
    sqlite3_finalize(check)
    check = nil
    if sqlite3_close(destination) != SQLITE_OK {
        destination = nil
        goto done
    }
    destination = nil
    if sqlite3_close(source) != SQLITE_OK {
        source = nil
        goto done
    }
    source = nil
    marker = fopen(marker_path, "wb")
    if marker == nil {
        goto done
    }
    marker_written = fprintf(marker, "%s\n", STORAGE_DB_NAME) > 0 && fflush(marker) == 0
    if fclose(marker) != 0 {
        marker_written = 0
    }
    marker = nil
    if !marker_written {
        goto done
    }
    ok = rename(temporary_path, current_path) == 0

done:
    if marker != nil {
        fclose(marker)
    }
    if check != nil {
        sqlite3_finalize(check)
    }
    if backup != nil {
        sqlite3_backup_finish(backup)
    }
    if destination != nil {
        sqlite3_close(destination)
    }
    if source != nil {
        sqlite3_close(source)
    }
    if !ok {
        remove(temporary_path)
    }
    return ok
}

storage_init :: (root: const char*) -> int #export {
    legacy_db_path: [STORAGE_PATH_SIZE] char
    current_db_path: [STORAGE_PATH_SIZE] char
    marker_path: [STORAGE_PATH_SIZE] char
    temporary_path: [STORAGE_PATH_SIZE] char
    marker_name: [64] char
    temporary_name: [64] char
    use_legacy_db: int = 0
    if root == nil || root[0] == '\0' {
        return 0
    }
    g_storage.pending_sync_outbox_seq = 0
    g_storage.last_sync_changed = 0
    snprintf(g_storage.root, sizeof(g_storage.root), "%s", root)
    if !storage_ensure_dir(g_storage.root) {
        TraceLog(LOG_ERROR, "STORAGE: failed to create root directory: %s",
                 g_storage.root)
        return 0
    }
    snprintf(marker_name, sizeof(marker_name), "%s.migrated", STORAGE_DB_NAME)
    snprintf(temporary_name, sizeof(temporary_name), "%s.migrating", STORAGE_DB_NAME)
    if !storage_join_path(legacy_db_path, sizeof(legacy_db_path),
                          g_storage.root, STORAGE_DB_NAME_LEGACY) ||
       !storage_join_path(current_db_path, sizeof(current_db_path),
                          g_storage.root, STORAGE_DB_NAME) ||
       !storage_join_path(marker_path, sizeof(marker_path),
                          g_storage.root, marker_name) ||
       !storage_join_path(temporary_path, sizeof(temporary_path),
                          g_storage.root, temporary_name) {
        TraceLog(LOG_ERROR, "STORAGE: database path is too long")
        return 0
    }
    if path_exists(legacy_db_path) && path_exists(current_db_path) &&
       !path_exists(marker_path) {
        TraceLog(LOG_ERROR, "STORAGE: both database names exist without a migration marker")
        return 0
    }
    if path_exists(legacy_db_path) && !path_exists(current_db_path) {
        if storage_copy_legacy_database(legacy_db_path, current_db_path,
                                        marker_path, temporary_path) {
            TraceLog(LOG_INFO, "STORAGE: migrated database to %s", STORAGE_DB_NAME)
        } else {
            TraceLog(LOG_WARNING, "STORAGE: database migration deferred; using legacy database")
            use_legacy_db = 1
        }
    }
    snprintf(g_storage.db_path, sizeof(g_storage.db_path), "%s",
             use_legacy_db ? legacy_db_path : current_db_path)
    if sqlite3_open_v2(g_storage.db_path, &g_storage.db,
                       SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX,
                       nil) != SQLITE_OK {
        TraceLog(LOG_ERROR, "STORAGE: failed to open %s", g_storage.db_path)
        sqlite3_close(g_storage.db)
        g_storage.db = nil
        return 0
    }
    sqlite3_busy_timeout(g_storage.db, 1000)
    if !schema_create() || !migrate_schema() || !load_or_create_user() {
        sqlite3_close(g_storage.db)
        g_storage.db = nil
        return 0
    }
    storage_migrate_default_habit_ids()
    storage_migrate_habit_ids_to_uuid()
    storage_migrate_default_meditation_activity_mask()
    storage_migrate_sync_enabled_flag()
    storage_materialize_session_habit_days()
    migrate_legacy_file_sessions_once()
    return 1
}

storage_close :: () #export {
    if g_storage.db != nil {
        sqlite3_close(g_storage.db)
        g_storage.db = nil
    }
    g_storage.pending_sync_outbox_seq = 0
    g_storage.last_sync_changed = 0
}

storage_db_path :: () -> const char* #export {
    return g_storage.db_path
}
