#module "storage.db"
#import "db.h"

#import "import.h"
#import "kryon.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "sys/stat.h"
#import "time.h"
#import "unistd.h"

WIN32 :: #defined(_WIN32)
EMSCRIPTEN :: #defined(__EMSCRIPTEN__)

g_storage :: StorageState #global #export

make_user_id :: (out: char*, out_size: size_t) {
    r: unsigned int = (unsigned int)rand()

    snprintf(out, out_size, "local-%lld-%u", now_seconds(), r)
}

storage_join_path :: (out: char*, out_size: size_t, root: const char*,
                                name: const char*) -> int #export {
    root_len: size_t
    name_len: size_t

    if out == nil || out_size == 0 || root == nil || root[0] == '\0' ||
       name == nil {
        return 0
    }
    root_len = strlen(root)
    name_len = strlen(name)
    if root_len + 1 + name_len + 1 > out_size {
        return 0
    }
    memcpy(out, root, root_len)
    out[root_len] = '/'
    memcpy(out + root_len + 1, name, name_len + 1)
    return 1
}

path_exists :: (path: const char*) -> int #export {
    st: struct stat

    return path != nil && stat(path, &st) == 0
}

dir_exists_local :: (path: const char*) -> int {
    st: struct stat

    return path != nil && stat(path, &st) == 0 && S_ISDIR(st.st_mode)
}

make_dir :: (path: const char*) -> int {
    #if WIN32 {
        return mkdir(path) == 0
    } #else {
        return mkdir(path, 0700) == 0
    }
}

ensure_dir_local :: (path: const char*) -> int #export {
    temp: [INBE_STORAGE_PATH_SIZE] char
    p: char*

    if path == nil || path[0] == '\0' {
        return 0
    }
    if dir_exists_local(path) {
        return 1
    }

    snprintf(temp, sizeof(temp), "%s", path)
    p = temp
    if *p == '/' {
        p++
    }
    while (p = strchr(p, '/')) != nil {
        *p = '\0'
        if temp[0] != '\0' && !dir_exists_local(temp) && !make_dir(temp) &&
           !dir_exists_local(temp) {
            *p = '/'
            return 0
        }
        *p = '/'
        p++
    }

    return make_dir(path) || dir_exists_local(path)
}

exec_sql :: (sql: const char*) -> int #export {
    error: char* = nil
    rc: int = SQLITE_OK

    for int attempt = 0; attempt < 20; attempt++ {
        rc = sqlite3_exec(g_storage.db, sql, nil, nil, &error)
        if rc == SQLITE_OK {
            return 1
        }
        if rc != SQLITE_BUSY && rc != SQLITE_LOCKED {
            break
        }
        sqlite3_free(error)
        error = nil
        #if !EMSCRIPTEN {
            usleep(50000)
        }
    }
    if rc != SQLITE_OK {
        TraceLog(LOG_ERROR, "STORAGE: SQL failed: %s",
                 error != nil ? error : "unknown")
        sqlite3_free(error)
        return 0
    }
    return 1
}

table_has_column :: (table: const char*, column: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    sql: [128] char
    found: int = 0

    if table == nil || column == nil || g_storage.db == nil {
        return 0
    }
    snprintf(sql, sizeof(sql), "PRAGMA table_info(%s)", table)
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    while sqlite3_step(stmt) == SQLITE_ROW {
        name: const char* = (const char*)sqlite3_column_text(stmt, 1)

        if name != nil && strcmp(name, column) == 0 {
            found = 1
            break
        }
    }
    sqlite3_finalize(stmt)
    return found
}

table_exists :: (table: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    found: int = 0

    if table == nil || g_storage.db == nil {
        return 0
    }
    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?1 LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, table)
    found = sqlite3_step(stmt) == SQLITE_ROW
    sqlite3_finalize(stmt)
    return found
}

now_seconds :: () -> long long #export {
    return (long long)time(nil)
}

bind_text :: (stmt: sqlite3_stmt*, index: int, text: const char*) -> int #export {
    return sqlite3_bind_text(stmt, index, text != nil ? text : "", -1,
                             SQLITE_TRANSIENT) == SQLITE_OK
}

db_select_int64 :: (sql: const char*, fallback: long long) -> long long #export {
    stmt: sqlite3_stmt* = nil
    value: long long = fallback

    if g_storage.db == nil || sql == nil {
        return fallback
    }
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return fallback
    }
    if sqlite3_step(stmt) == SQLITE_ROW {
        value = sqlite3_column_int64(stmt, 0)
    }
    sqlite3_finalize(stmt)
    return value
}

db_select_int :: (sql: const char*, fallback: int) -> int #export {
    return (int)db_select_int64(sql, fallback)
}

db_exec_text :: (sql: const char*, text: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    ok: int

    if g_storage.db == nil || sql == nil {
        return 0
    }
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, text)
    ok = sqlite3_step(stmt) == SQLITE_DONE
    sqlite3_finalize(stmt)
    return ok
}

schema_exec :: (sql: const char*) -> int {
    return exec_sql(sql)
}

schema_create :: () -> int #export {
    if !schema_exec(
        "PRAGMA journal_mode=WAL;"
        "PRAGMA synchronous=NORMAL;"
        "PRAGMA foreign_keys=ON;") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS meta("
        " key TEXT PRIMARY KEY,"
        " value TEXT NOT NULL"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS users("
        " id TEXT PRIMARY KEY,"
        " created_at INTEGER NOT NULL,"
        " kind TEXT NOT NULL"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS settings("
        " user_id TEXT NOT NULL,"
        " key TEXT NOT NULL,"
        " value TEXT NOT NULL,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(user_id,key)"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS social_snapshots("
        " user_id TEXT NOT NULL,"
        " kind TEXT NOT NULL,"
        " json TEXT NOT NULL,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(user_id,kind)"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS sessions("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " started_at INTEGER NOT NULL,"
        " local_date INTEGER NOT NULL,"
        " topic INTEGER NOT NULL DEFAULT 0,"
        " activity INTEGER NOT NULL DEFAULT 0,"
        " source TEXT NOT NULL,"
        " imported_at INTEGER NOT NULL,"
        " rounds_hash INTEGER NOT NULL,"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL DEFAULT 0,"
        " UNIQUE(user_id,started_at,rounds_hash)"
        ");"
        "CREATE TABLE IF NOT EXISTS session_rounds("
        " session_id TEXT NOT NULL,"
        " round_index INTEGER NOT NULL,"
        " seconds INTEGER NOT NULL,"
        " PRIMARY KEY(session_id,round_index)"
        ");"
        "CREATE TABLE IF NOT EXISTS meditation_logs("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " session_id TEXT NOT NULL,"
        " duration_seconds INTEGER NOT NULL,"
        " completed_at INTEGER NOT NULL,"
        " updated_at INTEGER NOT NULL DEFAULT 0"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS habits("
        " id TEXT PRIMARY KEY,"
        " user_id TEXT NOT NULL,"
        " name TEXT NOT NULL,"
        " description TEXT NOT NULL DEFAULT '',"
        " color_r INTEGER NOT NULL,"
        " color_g INTEGER NOT NULL,"
        " color_b INTEGER NOT NULL,"
        " sync_mode INTEGER NOT NULL,"
        " sync_activity INTEGER NOT NULL,"
        " counter_enabled INTEGER NOT NULL DEFAULT 0,"
        " sort_order INTEGER NOT NULL,"
        " deleted_at INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL DEFAULT 0"
        ");"
        "CREATE TABLE IF NOT EXISTS habit_days("
        " habit_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL,"
        " completed INTEGER NOT NULL,"
        " count INTEGER NOT NULL DEFAULT 0,"
        " session_count INTEGER NOT NULL DEFAULT 0,"
        " updated_at INTEGER NOT NULL,"
        " PRIMARY KEY(habit_id,local_date)"
        ");") {
        return 0
    }
    if !schema_exec(
        "CREATE TABLE IF NOT EXISTS imports("
        " id TEXT PRIMARY KEY,"
        " imported_at INTEGER NOT NULL,"
        " format TEXT NOT NULL,"
        " source_name TEXT NOT NULL,"
        " session_count INTEGER NOT NULL,"
        " habit_count INTEGER NOT NULL"
        ");"
        "CREATE TABLE IF NOT EXISTS sync_outbox("
        " seq INTEGER PRIMARY KEY AUTOINCREMENT,"
        " entity_type TEXT NOT NULL,"
        " entity_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL DEFAULT 0,"
        " queued_at INTEGER NOT NULL,"
        " UNIQUE(entity_type,entity_id,local_date)"
        ");"
        "CREATE TABLE IF NOT EXISTS sync_ops("
        " op_id TEXT PRIMARY KEY,"
        " client_id TEXT NOT NULL,"
        " seq INTEGER NOT NULL,"
        " entity_type TEXT NOT NULL,"
        " entity_id TEXT NOT NULL,"
        " local_date INTEGER NOT NULL DEFAULT 0,"
        " op_type TEXT NOT NULL,"
        " payload_json TEXT NOT NULL DEFAULT '',"
        " created_at INTEGER NOT NULL,"
        " sent_at INTEGER NOT NULL DEFAULT 0,"
        " acked_at INTEGER NOT NULL DEFAULT 0"
        ");"
        "INSERT OR IGNORE INTO meta(key,value) VALUES('schema_version','1');") {
        return 0
    }
    return 1
}

load_or_create_user :: () -> int #export {
    stmt: sqlite3_stmt* = nil
    rc: int

    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT id FROM users WHERE kind='local' ORDER BY created_at LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    rc = sqlite3_step(stmt)
    if rc == SQLITE_ROW {
        snprintf(g_storage.user_id, sizeof(g_storage.user_id), "%s",
                 (const char*)sqlite3_column_text(stmt, 0))
        sqlite3_finalize(stmt)
        return 1
    }
    sqlite3_finalize(stmt)

    make_user_id(g_storage.user_id, sizeof(g_storage.user_id))
    if sqlite3_prepare_v2(g_storage.db,
                          "INSERT INTO users(id,created_at,kind) VALUES(?1,?2,'local')",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, g_storage.user_id)
    sqlite3_bind_int64(stmt, 2, now_seconds())
    rc = sqlite3_step(stmt)
    sqlite3_finalize(stmt)
    return rc == SQLITE_DONE
}

meta_equals :: (key: const char*, value: const char*) -> int #export {
    stmt: sqlite3_stmt* = nil
    ok: int = 0

    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        ok = text != nil && strcmp(text, value) == 0
    }
    sqlite3_finalize(stmt)
    return ok
}

get_meta_text :: (key: const char*) -> const char* #export {
    stmt: sqlite3_stmt* = nil

    g_storage.text_value[0] = '\0'

    if g_storage.db == nil || key == nil {
        return nil
    }
    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return nil
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        snprintf(g_storage.text_value, sizeof(g_storage.text_value), "%s",
                 text != nil ? text : "")
    }
    sqlite3_finalize(stmt)
    return g_storage.text_value[0] != '\0' ? g_storage.text_value : nil
}

set_meta :: (key: const char*, value: const char*) #export {
    stmt: sqlite3_stmt* = nil

    if sqlite3_prepare_v2(g_storage.db,
                          "INSERT INTO meta(key,value) VALUES(?1,?2) "
                          "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                          -1, &stmt, nil) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, key)
    bind_text(stmt, 2, value)
    sqlite3_step(stmt)
    sqlite3_finalize(stmt)
}

get_meta_int64 :: (key: const char*, fallback: long long) -> long long #export {
    stmt: sqlite3_stmt* = nil
    value: long long = fallback

    if g_storage.db == nil || key == nil {
        return fallback
    }
    if sqlite3_prepare_v2(g_storage.db, "SELECT value FROM meta WHERE key=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return fallback
    }
    bind_text(stmt, 1, key)
    if sqlite3_step(stmt) == SQLITE_ROW {
        text: const char* = (const char*)sqlite3_column_text(stmt, 0)

        if text != nil && text[0] != '\0' {
            value = atoll(text)
        }
    }
    sqlite3_finalize(stmt)
    return value
}

set_meta_int64 :: (key: const char*, value: long long) #export {
    text: [32] char

    snprintf(text, sizeof(text), "%lld", value)
    set_meta(key, text)
}

migrate_schema :: () -> int #export {
    now: long long = now_seconds()
    had_outbox: int = table_exists("sync_outbox")

    if table_has_column("habits", "sync_topic") {
        if !exec_sql(
            "BEGIN IMMEDIATE;"
            "ALTER TABLE habits RENAME TO habits_with_sync_topic;"
            "CREATE TABLE habits("
            " id TEXT PRIMARY KEY,"
            " user_id TEXT NOT NULL,"
            " name TEXT NOT NULL,"
            " description TEXT NOT NULL DEFAULT '',"
            " color_r INTEGER NOT NULL,"
            " color_g INTEGER NOT NULL,"
            " color_b INTEGER NOT NULL,"
            " sync_mode INTEGER NOT NULL,"
            " sync_activity INTEGER NOT NULL,"
            " sort_order INTEGER NOT NULL,"
            " deleted_at INTEGER NOT NULL DEFAULT 0,"
            " updated_at INTEGER NOT NULL DEFAULT 0"
            ");"
            "INSERT INTO habits(id,user_id,name,description,color_r,color_g,color_b,sync_mode,sync_activity,sort_order,deleted_at,updated_at)"
            " SELECT id,user_id,name,'',color_r,color_g,color_b,sync_mode,sync_activity,sort_order,deleted_at,0"
            " FROM habits_with_sync_topic;"
            "DROP TABLE habits_with_sync_topic;"
            "COMMIT;") {
            return 0
        }
    }
    if !table_has_column("habits", "description") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN description TEXT NOT NULL DEFAULT ''") {
        return 0
    }
    if !table_has_column("habits", "counter_enabled") &&
       !exec_sql("ALTER TABLE habits ADD COLUMN counter_enabled INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("habit_days", "count") &&
       !exec_sql("ALTER TABLE habit_days ADD COLUMN count INTEGER NOT NULL DEFAULT 0;"
                 "UPDATE habit_days SET count=CASE WHEN completed!=0 THEN 1 ELSE 0 END WHERE count=0") {
        return 0
    }
    if !table_has_column("habit_days", "session_count") &&
       !exec_sql("ALTER TABLE habit_days ADD COLUMN session_count INTEGER NOT NULL DEFAULT 0") {
        return 0
    }
    if !table_has_column("habits", "updated_at") {
        sql: [160] char

        snprintf(sql, sizeof(sql),
                 "ALTER TABLE habits ADD COLUMN updated_at INTEGER NOT NULL DEFAULT %lld",
                 now)
        if !exec_sql(sql) {
            return 0
        }
    }
    if !table_has_column("sessions", "updated_at") {
        sql: [160] char

        snprintf(sql, sizeof(sql),
                 "ALTER TABLE sessions ADD COLUMN updated_at INTEGER NOT NULL DEFAULT %lld",
                 now)
        if !exec_sql(sql) {
            return 0
        }
    }
    if !exec_sql(
           "CREATE TABLE IF NOT EXISTS sync_outbox("
           " seq INTEGER PRIMARY KEY AUTOINCREMENT,"
           " entity_type TEXT NOT NULL,"
           " entity_id TEXT NOT NULL,"
           " local_date INTEGER NOT NULL DEFAULT 0,"
           " queued_at INTEGER NOT NULL,"
           " UNIQUE(entity_type,entity_id,local_date)"
           ");"
           "CREATE TABLE IF NOT EXISTS sync_ops("
           " op_id TEXT PRIMARY KEY,"
           " client_id TEXT NOT NULL,"
           " seq INTEGER NOT NULL,"
           " entity_type TEXT NOT NULL,"
           " entity_id TEXT NOT NULL,"
           " local_date INTEGER NOT NULL DEFAULT 0,"
           " op_type TEXT NOT NULL,"
           " payload_json TEXT NOT NULL DEFAULT '',"
           " created_at INTEGER NOT NULL,"
           " sent_at INTEGER NOT NULL DEFAULT 0,"
           " acked_at INTEGER NOT NULL DEFAULT 0"
           ");"
           "CREATE TABLE IF NOT EXISTS social_snapshots("
           " user_id TEXT NOT NULL,"
           " kind TEXT NOT NULL,"
           " json TEXT NOT NULL,"
           " updated_at INTEGER NOT NULL,"
           " PRIMARY KEY(user_id,kind)"
           ");") {
        return 0
    }
    if table_exists("social_cache") {
        exec_sql("INSERT OR REPLACE INTO social_snapshots(user_id,kind,json,updated_at) "
                 "SELECT user_id,kind,json,updated_at FROM social_cache;"
                 "DROP TABLE social_cache;")
    }
    if !had_outbox {
        if !exec_sql(
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'habit',id,0,updated_at FROM habits;"
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'habit_day',habit_id,local_date,updated_at FROM habit_days;"
               "INSERT OR IGNORE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) "
               "SELECT 'session',id,0,updated_at FROM sessions;") {
            return 0
        }
    }
    return 1
}

storage_init :: (root: const char*) -> int #export {
    if root == nil || root[0] == '\0' {
        return 0
    }
    g_storage.pending_sync_outbox_seq = 0
    g_storage.last_sync_changed = 0
    snprintf(g_storage.root, sizeof(g_storage.root), "%s", root)
    if !ensure_dir_local(g_storage.root) {
        TraceLog(LOG_ERROR, "STORAGE: failed to create root directory: %s",
                 g_storage.root)
        return 0
    }
    if !storage_join_path(g_storage.db_path, sizeof(g_storage.db_path),
                          g_storage.root, "inbe.db") {
        TraceLog(LOG_ERROR, "STORAGE: database path is too long")
        return 0
    }
    if sqlite3_open(g_storage.db_path, &g_storage.db) != SQLITE_OK {
        TraceLog(LOG_ERROR, "STORAGE: failed to open %s", g_storage.db_path)
        sqlite3_close(g_storage.db)
        g_storage.db = nil
        return 0
    }
    sqlite3_busy_timeout(g_storage.db, 1000)
    if !schema_create() || !migrate_schema() || !load_or_create_user() {
        sqlite3_close(g_storage.db)
        g_storage.db = nil
        return 0
    }
    storage_migrate_default_habit_ids()
    storage_migrate_habit_ids_to_uuid()
    storage_materialize_session_habit_days()
    migrate_legacy_file_sessions_once()
    return 1
}

storage_close :: () #export {
    if g_storage.db != nil {
        sqlite3_close(g_storage.db)
        g_storage.db = nil
    }
    g_storage.pending_sync_outbox_seq = 0
    g_storage.last_sync_changed = 0
}

storage_db_path :: () -> const char* #export {
    return g_storage.db_path
}
