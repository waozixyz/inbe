importable_setting_keys :: [41] const char* = { "speed", "max_rounds", "max_breaths", "pause_seconds", "sound_volume", "music_volume", "retention_marker_enabled", "tutorial_seen", "exercise_manual_seen_mask", "theme", "theme_source", "dark_mode", "theme_mode", "theme_style", "orientation_mode", "ui_scale", "main_tab", "fullscreen", "on_screen_keyboard", "progressive_speed", "progressive_start_speed", "breath_animation", "double_tap_to_breathe", "advanced_session_controls", "exercise_type", "sun_salutation_repetitions", "sun_salutation_start_seconds", "sun_salutation_end_seconds", "sun_salutation_figure", "meditation_duration_mode", "meditation_custom_minutes", "meditation_show_extend_controls", "meditation_music_track", "practice_music_mask", "practice_music_track_wim_hof", "practice_music_track_meditation", "practice_music_track_sun_salutation", "play_in_background", "language", "practice_category_tab", "practice_visible_mask" } #global #private

static import_habit_id_counter: unsigned int = 0

tickmate_color_fallback :: [6] Color #global #private = { {99, 196, 165, 255}, {94, 166, 232, 255}, {210, 180, 72, 255}, {224, 124, 104, 255}, {180, 132, 220, 255}, {216, 116, 164, 255} }

source_table_has_column :: (db: sqlite3*, table: const char*, column: const char*) -> int #private {
    stmt: sqlite3_stmt* = nil
    sql: [128] char
    found: int = 0

    if db == nil || table == nil || column == nil {
        return 0
    }
    snprintf(sql, sizeof(sql), "PRAGMA table_info(%s)", table)
    if sqlite3_prepare_v2(db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    while sqlite3_step(stmt) == SQLITE_ROW {
        name: const char* = (const char*)sqlite3_column_text(stmt, 1)
        if name != nil && strcmp(name, column) == 0 {
            found = 1
            break
        }
    }
    sqlite3_finalize(stmt)
    return found
}

source_table_exists :: (db: sqlite3*, table: const char*) -> int #private {
    stmt: sqlite3_stmt* = nil
    found: int = 0

    if db == nil || table == nil {
        return 0
    }
    if sqlite3_prepare_v2(db,
                          "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?1 LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    sqlite3_bind_text(stmt, 1, table, -1, SQLITE_TRANSIENT)
    found = sqlite3_step(stmt) == SQLITE_ROW
    sqlite3_finalize(stmt)
    return found
}

source_count_rows :: (db: sqlite3*, sql: const char*) -> int #private {
    stmt: sqlite3_stmt* = nil
    count: int = 0

    if db == nil || sql == nil {
        return 0
    }
    if sqlite3_prepare_v2(db, sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    if sqlite3_step(stmt) == SQLITE_ROW {
        count = sqlite3_column_int(stmt, 0)
    }
    sqlite3_finalize(stmt)
    return count
}

setting_key_importable :: (key: const char*) -> int #private {
    if key == nil || key[0] == '\0' {
        return 0
    }
    for size_t i = 0; i < sizeof(importable_setting_keys) / sizeof(importable_setting_keys[0]); i++ {
        if strcmp(key, importable_setting_keys[i]) == 0 {
            return 1
        }
    }
    return 0
}

source_count_importable_settings :: (db: sqlite3*) -> int #private {
    stmt: sqlite3_stmt* = nil
    count: int = 0

    if db == nil || !source_table_exists(db, "settings") {
        return 0
    }
    if sqlite3_prepare_v2(db, "SELECT DISTINCT key FROM settings", -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    while sqlite3_step(stmt) == SQLITE_ROW {
        key: const char* = (const char*)sqlite3_column_text(stmt, 0)
        if setting_key_importable(key) {
            count++
        }
    }
    sqlite3_finalize(stmt)
    return count
}

local_habit_id_by_name :: (name: const char*, out: char*, out_size: size_t) -> int #private {
    stmt: sqlite3_stmt* = nil
    found: int = 0

    if name == nil || name[0] == '\0' || out == nil || out_size == 0 ||
       g_storage.db == nil {
        return 0
    }

    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT id FROM habits WHERE name=?1 COLLATE NOCASE AND deleted_at=0 ORDER BY sort_order,id LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, name)
    if sqlite3_step(stmt) == SQLITE_ROW {
        id: const char* = (const char*)sqlite3_column_text(stmt, 0)
        if id != nil && id[0] != '\0' {
            snprintf(out, out_size, "%s", id)
            found = out[0] != '\0'
        }
    }
    sqlite3_finalize(stmt)
    return found
}

local_habit_id_exists :: (id: const char*) -> int #private {
    stmt: sqlite3_stmt* = nil
    found: int = 0

    if id == nil || id[0] == '\0' || g_storage.db == nil {
        return 0
    }
    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT 1 FROM habits WHERE id=?1 LIMIT 1",
                          -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, id)
    found = sqlite3_step(stmt) == SQLITE_ROW
    sqlite3_finalize(stmt)
    return found
}

make_import_habit_id :: (out: char*, out_size: size_t) #private {
    if out == nil || out_size == 0 {
        return
    }
    while true {
        snprintf(out, out_size, "import-%lld-%u", now_seconds(), import_habit_id_counter)
        import_habit_id_counter++
        if !local_habit_id_exists(out) {
            break
        }
    }
}

resolve_import_habit_id :: (import_id: const char*, name: const char*,
                            out: char*, out_size: size_t) -> int #private {
    if out == nil || out_size == 0 {
        return 0
    }
    out[0] = '\0'

    if local_habit_id_by_name(name, out, out_size) {
        return 1
    }

    if import_id != nil && import_id[0] != '\0' && !local_habit_id_exists(import_id) {
        snprintf(out, out_size, "%s", import_id)
        return out[0] != '\0'
    }

    make_import_habit_id(out, out_size)
    return out[0] != '\0'
}

import_prepare_habit_upsert :: (stmt: sqlite3_stmt**) -> int #private {
    if stmt == nil || g_storage.db == nil {
        return 0
    }
    return sqlite3_prepare_v2(g_storage.db,
                              "INSERT OR REPLACE INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) "
                              "VALUES(?1,?2,COALESCE((SELECT name FROM habits WHERE id=?1),?3),?4,?5,?6,?7,?8,"
                              "CASE WHEN ?9!=0 THEN 1 ELSE COALESCE((SELECT counter_enabled FROM habits WHERE id=?1),0) END,?10,0,?11)",
                              -1, stmt, nil) == SQLITE_OK
}

import_upsert_habit :: (stmt: sqlite3_stmt*, id: const char*, name: const char*,
                        color: Color, sync_mode: int, sync_activity: int,
                        counter_enabled: int, sort_order: int, updated_at: long long) -> int #private {
    rc: int

    if stmt == nil || id == nil || id[0] == '\0' ||
       name == nil || name[0] == '\0' {
        return 0
    }
    sqlite3_reset(stmt)
    sqlite3_clear_bindings(stmt)
    bind_text(stmt, 1, id)
    bind_text(stmt, 2, g_storage.user_id)
    bind_text(stmt, 3, name)
    sqlite3_bind_int(stmt, 4, color.r)
    sqlite3_bind_int(stmt, 5, color.g)
    sqlite3_bind_int(stmt, 6, color.b)
    sqlite3_bind_int(stmt, 7, sync_mode)
    sqlite3_bind_int(stmt, 8, sync_activity)
    sqlite3_bind_int(stmt, 9, counter_enabled ? 1 : 0)
    sqlite3_bind_int(stmt, 10, sort_order)
    sqlite3_bind_int64(stmt, 11, updated_at)
    rc = sqlite3_step(stmt)
    return rc == SQLITE_DONE
}

import_prepare_habit_day_upsert :: (stmt: sqlite3_stmt**) -> int #private {
    if stmt == nil || g_storage.db == nil {
        return 0
    }
    return sqlite3_prepare_v2(g_storage.db,
                              "INSERT INTO habit_days(habit_id,local_date,completed,count,updated_at) "
                              "VALUES(?1,?2,?3,?4,?5) "
                              "ON CONFLICT(habit_id,local_date) DO UPDATE SET "
                              "count=CASE WHEN habit_days.count>excluded.count THEN habit_days.count ELSE excluded.count END,"
                              "completed=CASE WHEN habit_days.count>0 OR excluded.count>0 OR habit_days.completed!=0 OR excluded.completed!=0 THEN 1 ELSE 0 END,"
                              "updated_at=CASE WHEN excluded.count>habit_days.count THEN excluded.updated_at ELSE habit_days.updated_at END",
                              -1, stmt, nil) == SQLITE_OK
}

import_upsert_habit_day :: (stmt: sqlite3_stmt*, habit_id: const char*, local_date: int,
                            completed: int, count: int, updated_at: long long) -> int #private {
    rc: int

    if stmt == nil || habit_id == nil || habit_id[0] == '\0' || local_date <= 0 {
        return 0
    }
    sqlite3_reset(stmt)
    sqlite3_clear_bindings(stmt)
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, local_date)
    sqlite3_bind_int(stmt, 3, completed ? 1 : 0)
    sqlite3_bind_int(stmt, 4, count)
    sqlite3_bind_int64(stmt, 5, updated_at)
    rc = sqlite3_step(stmt)
    return rc == SQLITE_DONE
}

storage_export_zip :: (path: const char*) -> int #export {
    archive: mz_zip_archive
    fp: FILE*
    buf: char*
    size: long
    metadata: [512] char

    if path == nil || path[0] == '\0' || g_storage.db == nil {
        return 0
    }
    sqlite3_exec(g_storage.db, "PRAGMA wal_checkpoint(FULL)", nil, nil, nil)
    fp = fopen(g_storage.db_path, "rb")
    if fp == nil {
        return 0
    }
    fseek(fp, 0, SEEK_END)
    size = ftell(fp)
    fseek(fp, 0, SEEK_SET)
    if size <= 0 {
        fclose(fp)
        return 0
    }
    buf = malloc((size_t)size)
    if buf == nil {
        fclose(fp)
        return 0
    }
    if fread(buf, 1, (size_t)size, fp) != (size_t)size {
        free(buf)
        fclose(fp)
        return 0
    }
    fclose(fp)
    memset(&archive, 0, sizeof(archive))
    if !mz_zip_writer_init_file(&archive, path, 0) {
        free(buf)
        return 0
    }
    snprintf(metadata, sizeof(metadata),
             "{\n\"format\":\"inbe-data-sqlite\",\n\"format_version\":1,\n\"app_version\":\"%s\",\n\"user_id\":\"%s\",\n\"session_count\":%d,\n\"habit_count\":%d\n}\n",
             INBE_VERSION_STRING, g_storage.user_id, storage_session_count(), storage_habit_count())
    mz_zip_writer_add_mem(&archive, "inbe-data/metadata.json", metadata, strlen(metadata), MZ_NO_COMPRESSION)
    mz_zip_writer_add_mem(&archive, "inbe-data/inbe.db", buf, (size_t)size, MZ_BEST_COMPRESSION)
    free(buf)
    mz_zip_writer_finalize_archive(&archive)
    mz_zip_writer_end(&archive)
    return 1
}

tickmate_color_from_int :: (value: int, index: int) -> Color #private {
    color: Color = tickmate_color_fallback[index % (int)(sizeof(tickmate_color_fallback) / sizeof(tickmate_color_fallback[0]))]

    if value != 0 {
        color.r = (unsigned char)((value >> 16) & 0xff)
        color.g = (unsigned char)((value >> 8) & 0xff)
        color.b = (unsigned char)(value & 0xff)
        color.a = 255
        if color.r == 0 && color.g == 0 && color.b == 0 {
            color = tickmate_color_fallback[index % (int)(sizeof(tickmate_color_fallback) / sizeof(tickmate_color_fallback[0]))]
        }
    }
    return color
}

parse_legacy_rounds :: (text: const char*, size: size_t, rounds: int*, max_rounds: int) -> int #private {
    count: int = 0
    pos: size_t = 0

    if text == nil || rounds == nil || max_rounds <= 0 {
        return 0
    }
    while pos < size && count < max_rounds {
        value: int = 0
        seen: int = 0
        while pos < size && (text[pos] == ' ' || text[pos] == '\t' ||
                             text[pos] == '\r' || text[pos] == '\n') {
            pos++
        }
        while pos < size && text[pos] >= '0' && text[pos] <= '9' {
            seen = 1
            value = value * 10 + (text[pos] - '0')
            pos++
        }
        if seen && value > 0 {
            rounds[count] = value
            count++
        }
        while pos < size && text[pos] != '\n' {
            pos++
        }
    }
    return count
}

legacy_session_started_at :: (year: int, month: int, day: int, hour: int, minute: int, second: int) -> long long #private {
    tm_value: struct tm

    memset(&tm_value, 0, sizeof(tm_value))
    tm_value.tm_year = year - 1900
    tm_value.tm_mon = month - 1
    tm_value.tm_mday = day
    tm_value.tm_hour = hour
    tm_value.tm_min = minute
    tm_value.tm_sec = second
    tm_value.tm_isdst = -1
    return (long long)mktime(&tm_value)
}

parse_legacy_session_filename :: (filename: const char*, year: int*, month: int*, day: int*,
                                  hour: int*, minute: int*, second: int*) -> int #private {
    p: const char*

    if filename == nil {
        return 0
    }
    for p = filename; *p != '\0'; p++ {
        if sscanf(p, "sessions/%4d/%2d/%2d/inbe-%2d%2d%2d",
                  year, month, day, hour, minute, second) == 6 {
            return 1
        }
        if sscanf(p, "%4d/%2d/%2d/inbe-%2d%2d%2d",
                  year, month, day, hour, minute, second) == 6 {
            return 1
        }
    }
    return 0
}

import_legacy_session_bytes :: (name: const char*, bytes: const char*, size: size_t) -> int #private {
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    rounds: [MaxRounds] int
    round_count: int
    local_date: int
    started_at: long long

    if !parse_legacy_session_filename(name, &year, &month, &day, &hour, &minute, &second) {
        return 0
    }
    round_count = parse_legacy_rounds(bytes, size, rounds, MaxRounds)
    if round_count <= 0 {
        TraceLog(LOG_WARNING, "DATA: legacy import ignored empty session %s", name)
        return 0
    }
    local_date = year * 10000 + month * 100 + day
    started_at = legacy_session_started_at(year, month, day, hour, minute, second)
    if started_at <= 0 {
        TraceLog(LOG_WARNING, "DATA: legacy import invalid date in %s", name)
        return 0
    }
    return insert_session_at_ex(started_at, local_date, rounds, round_count,
                                0, 0, "legacy-file-import", nil, 0)
}

import_legacy_session_zip :: (archive: mz_zip_archive*) -> int #private {
    file_count: mz_uint
    imported: int = 0

    if archive == nil {
        return 0
    }
    g_storage.materialize_defer++
    file_count = mz_zip_reader_get_num_files(archive)
    for mz_uint i = 0; i < file_count; i++ {
        stat: mz_zip_archive_file_stat
        year: int
        month: int
        day: int
        hour: int
        minute: int
        second: int
        text_size: size_t = 0
        text: char*

        if !mz_zip_reader_file_stat(archive, i, &stat) {
            continue
        }
        if stat.m_is_directory {
            continue
        }
        if !parse_legacy_session_filename(stat.m_filename,
                                          &year, &month, &day,
                                          &hour, &minute, &second) {
            continue
        }

        text = mz_zip_reader_extract_to_heap(archive, i, &text_size, 0)
        if text == nil {
            TraceLog(LOG_WARNING, "DATA: legacy import failed to extract %s", stat.m_filename)
            continue
        }
        if import_legacy_session_bytes(stat.m_filename, text, text_size) {
            imported++
        }
        free(text)
    }
    g_storage.materialize_defer--
    if g_storage.materialize_defer == 0 && g_storage.materialize_needed {
        g_storage.materialize_needed = 0
        storage_materialize_session_habit_days()
    }
    if imported <= 0 {
        TraceLog(LOG_WARNING, "DATA: no legacy sessions found in archive")
    }
    return imported > 0
}

read_file_heap :: (path: const char*, out_size: size_t*) -> char* #private {
    fp: FILE*
    size: long
    buf: char*

    if out_size != nil {
        *out_size = 0
    }
    if path == nil || path[0] == '\0' {
        return nil
    }
    fp = fopen(path, "rb")
    if fp == nil {
        return nil
    }
    fseek(fp, 0, SEEK_END)
    size = ftell(fp)
    fseek(fp, 0, SEEK_SET)
    if size <= 0 {
        fclose(fp)
        return nil
    }
    buf = malloc((size_t)size)
    if buf == nil {
        fclose(fp)
        return nil
    }
    if fread(buf, 1, (size_t)size, fp) != (size_t)size {
        free(buf)
        fclose(fp)
        return nil
    }
    fclose(fp)
    if out_size != nil {
        *out_size = (size_t)size
    }
    return buf
}

ImportedFiles :: struct #private {
    paths: char**
    count: int
    capacity: int
}

imported_files_init :: (files: ImportedFiles*) #private {
    if files == nil {
        return
    }
    files->paths = nil
    files->count = 0
    files->capacity = 0
}

imported_files_add :: (files: ImportedFiles*, path: const char*) #private {
    copy: char*
    new_paths: char**
    new_capacity: int

    if files == nil || path == nil {
        return
    }
    if files->count >= files->capacity {
        new_capacity = files->capacity == 0 ? 64 : files->capacity * 2
        new_paths = realloc(files->paths, (size_t)new_capacity * sizeof(char*))
        if new_paths == nil {
            return
        }
        files->paths = new_paths
        files->capacity = new_capacity
    }
    copy = strdup(path)
    if copy == nil {
        return
    }
    files->paths[files->count] = copy
    files->count++
}

imported_files_cleanup :: (files: ImportedFiles*) #private {
    i: int

    if files == nil {
        return
    }
    if files->paths != nil {
        for i = 0; i < files->count; i++ {
            if files->paths[i] != nil {
                free(files->paths[i])
            }
        }
        free(files->paths)
    }
    files->paths = nil
    files->count = 0
    files->capacity = 0
}

delete_imported_legacy_files :: (files: ImportedFiles*) #private {
    i: int

    if files == nil {
        return
    }
    for i = 0; i < files->count; i++ {
        if files->paths[i] != nil {
            if remove(files->paths[i]) == 0 {
                TraceLog(LOG_INFO, "DATA: deleted migrated legacy file %s", files->paths[i])
            } else {
                TraceLog(LOG_WARNING, "DATA: failed to delete %s", files->paths[i])
            }
        }
    }
}

migrate_legacy_file_sessions_in_dir :: (dir_path: const char*, imported: ImportedFiles*) -> int #private {
    dir: DIR*
    entry: struct dirent*
    count: int = 0

    if dir_path == nil || dir_path[0] == '\0' {
        return 0
    }
    dir = opendir(dir_path)
    if dir == nil {
        return 0
    }
    while (entry = readdir(dir)) != nil {
        child: [INBE_STORAGE_PATH_SIZE] char
        st: struct stat

        if strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0 {
            continue
        }
        snprintf(child, sizeof(child), "%s/%s", dir_path, entry->d_name)
        if stat(child, &st) != 0 {
            continue
        }
        if S_ISDIR(st.st_mode) {
            count += migrate_legacy_file_sessions_in_dir(child, imported)
        } else if S_ISREG(st.st_mode) {
            year: int
            month: int
            day: int
            hour: int
            minute: int
            second: int
            if parse_legacy_session_filename(child, &year, &month, &day,
                                             &hour, &minute, &second) {
                size: size_t = 0
                bytes: char* = read_file_heap(child, &size)
                if bytes != nil {
                    if import_legacy_session_bytes(child, bytes, size) {
                        count++
                        imported_files_add(imported, child)
                    }
                    free(bytes)
                } else {
                    TraceLog(LOG_WARNING, "DATA: legacy file migration could not read %s", child)
                }
            }
        }
    }
    closedir(dir)
    return count
}

migrate_legacy_file_sessions_once :: () #export {
    imported: ImportedFiles

    if g_storage.db == nil || g_storage.root[0] == '\0' {
        return
    }
    if meta_equals("legacy_file_sessions_migrated", "1") {
        return
    }

    imported_files_init(&imported)
    migrate_legacy_file_sessions_in_dir(g_storage.root, &imported)
    set_meta("legacy_file_sessions_migrated", "1")
    storage_schedule_persist()

    if imported.count > 0 {
        TraceLog(LOG_INFO, "DATA: deleting %d migrated legacy file(s)", imported.count)
        delete_imported_legacy_files(&imported)
    }
    imported_files_cleanup(&imported)
}

import_tickmate_db :: (src: sqlite3*) -> int #private {
    stmt: sqlite3_stmt* = nil
    write_stmt: sqlite3_stmt* = nil
    ok: int = 0
    has_multiple_entries: int
    track_sql: const char*
    imported_at: long long = now_seconds()

    if src == nil || g_storage.db == nil {
        return 0
    }
    if !source_table_has_column(src, "tracks", "name") ||
       !source_table_has_column(src, "ticks", "_track_id") {
        return 0
    }

    has_multiple_entries = source_table_has_column(src, "tracks", "multiple_entries_per_day")
    if has_multiple_entries {
        track_sql = "SELECT _id,name,color,\"order\",multiple_entries_per_day,EXISTS(SELECT 1 FROM ticks WHERE ticks._track_id=tracks._id GROUP BY year,month,day HAVING COUNT(*)>1 LIMIT 1) FROM tracks WHERE enabled!=0 ORDER BY \"order\",_id"
    } else {
        track_sql = "SELECT _id,name,color,\"order\",0,EXISTS(SELECT 1 FROM ticks WHERE ticks._track_id=tracks._id GROUP BY year,month,day HAVING COUNT(*)>1 LIMIT 1) FROM tracks WHERE enabled!=0 ORDER BY \"order\",_id"
    }

    if sqlite3_prepare_v2(src, track_sql, -1, &stmt, nil) != SQLITE_OK {
        return 0
    }
    if !import_prepare_habit_upsert(&write_stmt) {
        sqlite3_finalize(stmt)
        return 0
    }

    exec_sql("BEGIN IMMEDIATE")
    while sqlite3_step(stmt) == SQLITE_ROW {
        import_habit_id: [64] char
        local_habit_id: [INBE_STORAGE_ID_SIZE] char
        name: const char* = (const char*)sqlite3_column_text(stmt, 1)
        track_id: int = sqlite3_column_int(stmt, 0)
        sort_order: int = sqlite3_column_int(stmt, 3)
        counter_enabled: int = sqlite3_column_int(stmt, 4) != 0 ||
                              sqlite3_column_int(stmt, 5) != 0
        color: Color = tickmate_color_from_int(sqlite3_column_int(stmt, 2), track_id)

        if name == nil || name[0] == '\0' {
            continue
        }
        snprintf(import_habit_id, sizeof(import_habit_id), "tickmate-%d", track_id)
        if !resolve_import_habit_id(import_habit_id, name, local_habit_id,
                                    sizeof(local_habit_id)) {
            continue
        }
        if import_upsert_habit(write_stmt, local_habit_id, name, color,
                               INBE_HABIT_SYNC_NONE, 0, counter_enabled,
                               sort_order, imported_at) {
            ok = 1
        }
    }
    sqlite3_finalize(stmt)
    stmt = nil
    sqlite3_finalize(write_stmt)
    write_stmt = nil

    if sqlite3_prepare_v2(src,
                          "SELECT ticks._track_id,tracks.name,ticks.year,ticks.month,ticks.day,COUNT(*) "
                          "FROM ticks JOIN tracks ON tracks._id=ticks._track_id "
                          "WHERE tracks.enabled!=0 "
                          "GROUP BY ticks._track_id,ticks.year,ticks.month,ticks.day",
                          -1, &stmt, nil) == SQLITE_OK {
        if !import_prepare_habit_day_upsert(&write_stmt) {
            sqlite3_finalize(stmt)
            stmt = nil
            goto finish
        }
        while sqlite3_step(stmt) == SQLITE_ROW {
            import_habit_id: [64] char
            local_habit_id: [INBE_STORAGE_ID_SIZE] char
            track_id: int = sqlite3_column_int(stmt, 0)
            name: const char* = (const char*)sqlite3_column_text(stmt, 1)
            year: int = sqlite3_column_int(stmt, 2)
            month: int = sqlite3_column_int(stmt, 3)
            day: int = sqlite3_column_int(stmt, 4)
            count: int = sqlite3_column_int(stmt, 5)
            local_date: int

            if name == nil || name[0] == '\0' {
                continue
            }
            if year <= 0 || month < 0 || month > 11 || day <= 0 || day > 31 {
                continue
            }
            local_date = year * 10000 + (month + 1) * 100 + day
            snprintf(import_habit_id, sizeof(import_habit_id), "tickmate-%d", track_id)
            if !resolve_import_habit_id(import_habit_id, name, local_habit_id,
                                        sizeof(local_habit_id)) {
                continue
            }
            if import_upsert_habit_day(write_stmt, local_habit_id, local_date,
                                       1, count > 0 ? count : 1, imported_at) {
                ok = 1
            }
        }
    }
finish:
    sqlite3_finalize(stmt)
    sqlite3_finalize(write_stmt)
    exec_sql("COMMIT")
    return ok
}

import_settings_from_source :: (src: sqlite3*) -> int #private {
    stmt: sqlite3_stmt* = nil
    write_stmt: sqlite3_stmt* = nil
    imported: int = 0
    imported_at: long long = now_seconds()

    if src == nil || g_storage.db == nil || !source_table_exists(src, "settings") {
        return 0
    }
    if sqlite3_prepare_v2(src, "SELECT key,value FROM settings", -1, &stmt, nil) != SQLITE_OK {
        return 0
    }

    if sqlite3_prepare_v2(g_storage.db,
                          "INSERT INTO settings(user_id,key,value,updated_at) VALUES(?1,?2,?3,?4) "
                          "ON CONFLICT(user_id,key) DO UPDATE SET "
                          "value=CASE WHEN excluded.value!='' OR settings.value='' THEN excluded.value ELSE settings.value END,"
                          "updated_at=CASE WHEN excluded.value!='' OR settings.value='' THEN excluded.updated_at ELSE settings.updated_at END",
                          -1, &write_stmt, nil) != SQLITE_OK {
        sqlite3_finalize(stmt)
        return 0
    }

    exec_sql("BEGIN IMMEDIATE")
    while sqlite3_step(stmt) == SQLITE_ROW {
        key: const char* = (const char*)sqlite3_column_text(stmt, 0)
        value: const char* = (const char*)sqlite3_column_text(stmt, 1)

        if !setting_key_importable(key) {
            continue
        }
        sqlite3_reset(write_stmt)
        sqlite3_clear_bindings(write_stmt)
        bind_text(write_stmt, 1, g_storage.user_id)
        bind_text(write_stmt, 2, key)
        bind_text(write_stmt, 3, value != nil ? value : "")
        sqlite3_bind_int64(write_stmt, 4, imported_at)
        if sqlite3_step(write_stmt) == SQLITE_DONE {
            imported++
        }
    }
    sqlite3_finalize(stmt)
    sqlite3_finalize(write_stmt)
    exec_sql("COMMIT")
    return imported
}

inspect_sqlite_db_file :: (db_path: const char*, info: InbeStorageImportInfo*) -> int #private {
    src: sqlite3* = nil
    ok: int = 0

    if info != nil {
        memset(info, 0, sizeof(*info))
    }
    if db_path == nil || db_path[0] == '\0' || info == nil {
        return 0
    }
    if sqlite3_open(db_path, &src) != SQLITE_OK {
        goto done
    }

    if source_table_exists(src, "sessions") && source_table_exists(src, "session_rounds") {
        info->session_count = source_count_rows(src, "SELECT COUNT(*) FROM sessions WHERE deleted_at=0")
        info->habit_count = source_table_exists(src, "habits")
                                ? source_count_rows(src, "SELECT COUNT(*) FROM habits WHERE deleted_at=0")
                                : 0
        info->setting_count = source_count_importable_settings(src)
        info->has_sessions = info->session_count > 0
        info->has_habits = info->habit_count > 0
        info->has_settings = info->setting_count > 0
        info->valid = info->has_sessions || info->has_habits || info->has_settings
        ok = info->valid
        goto done
    }

    if source_table_has_column(src, "tracks", "name") &&
       source_table_has_column(src, "ticks", "_track_id") {
        info->habit_count = source_count_rows(src, "SELECT COUNT(*) FROM tracks WHERE enabled!=0")
        info->has_habits = info->habit_count > 0
        info->valid = info->has_habits
        ok = info->valid
    }

done:
    if src != nil {
        sqlite3_close(src)
    }
    return ok
}

import_sqlite_db_file :: (db_path: const char*, mode: InbeStorageImportMode) -> int #private {
    src: sqlite3* = nil
    stmt: sqlite3_stmt* = nil
    hstmt: sqlite3_stmt* = nil
    habit_write_stmt: sqlite3_stmt* = nil
    day_write_stmt: sqlite3_stmt* = nil
    ok: int = 0
    imported_settings: int = 0
    deferred_materialize: int = 0
    imported_at: long long = now_seconds()

    if db_path == nil || db_path[0] == '\0' {
        return 0
    }
    if sqlite3_open(db_path, &src) != SQLITE_OK {
        TraceLog(LOG_WARNING, "DATA: sqlite import could not open %s", db_path)
        goto done
    }
    g_storage.materialize_defer++
    deferred_materialize = 1
    if sqlite3_prepare_v2(src,
                          "SELECT id,started_at,local_date,topic,activity,source FROM sessions WHERE deleted_at=0",
                          -1, &stmt, nil) != SQLITE_OK {
        goto try_tickmate
    }

    while sqlite3_step(stmt) == SQLITE_ROW {
        rstmt: sqlite3_stmt* = nil
        rounds: [MaxRounds] int
        count: int = 0
        sid: const char* = (const char*)sqlite3_column_text(stmt, 0)
        started_at: long long = sqlite3_column_int64(stmt, 1)
        local_date: int = sqlite3_column_int(stmt, 2)
        topic: int = sqlite3_column_int(stmt, 3)
        activity: int = sqlite3_column_int(stmt, 4)

        if sqlite3_prepare_v2(src,
                              "SELECT seconds FROM session_rounds WHERE session_id=?1 ORDER BY round_index",
                              -1, &rstmt, nil) == SQLITE_OK {
            sqlite3_bind_text(rstmt, 1, sid != nil ? sid : "", -1, SQLITE_TRANSIENT)
            while count < MaxRounds && sqlite3_step(rstmt) == SQLITE_ROW {
                rounds[count] = sqlite3_column_int(rstmt, 0)
                count++
            }
        }
        sqlite3_finalize(rstmt)
        if count > 0 {
            insert_session_at_ex(started_at, local_date, rounds, count,
                                 topic, activity, "sqlite-import", nil, 0)
            ok = 1
        }
    }
    sqlite3_finalize(stmt)
    stmt = nil

    if source_table_exists(src, "habits") {
        has_sync_activity: int = source_table_has_column(src, "habits", "sync_activity")
        has_counter_enabled: int = source_table_has_column(src, "habits", "counter_enabled")
        has_day_count: int = source_table_has_column(src, "habit_days", "count")
        day_sql: const char*
        habit_sql: const char*
        if has_day_count {
            day_sql = "SELECT local_date,completed,count FROM habit_days WHERE habit_id=?1"
        } else {
            day_sql = "SELECT local_date,completed,CASE WHEN completed!=0 THEN 1 ELSE 0 END FROM habit_days WHERE habit_id=?1"
        }
        if has_sync_activity && has_counter_enabled {
            habit_sql = "SELECT id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order FROM habits WHERE deleted_at=0 ORDER BY sort_order,id"
        } else if has_sync_activity {
            habit_sql = "SELECT id,name,color_r,color_g,color_b,sync_mode,sync_activity,0,sort_order FROM habits WHERE deleted_at=0 ORDER BY sort_order,id"
        } else if has_counter_enabled {
            habit_sql = "SELECT id,name,color_r,color_g,color_b,sync_mode,0,counter_enabled,sort_order FROM habits WHERE deleted_at=0 ORDER BY sort_order,id"
        } else {
            habit_sql = "SELECT id,name,color_r,color_g,color_b,sync_mode,0,0,sort_order FROM habits WHERE deleted_at=0 ORDER BY sort_order,id"
        }
        if sqlite3_prepare_v2(src, habit_sql, -1, &stmt, nil) != SQLITE_OK {
            goto after_habits
        }
        if !import_prepare_habit_upsert(&habit_write_stmt) ||
           !import_prepare_habit_day_upsert(&day_write_stmt) {
            goto after_habits
        }
        sqlite3_prepare_v2(src, day_sql, -1, &hstmt, nil)
        exec_sql("BEGIN IMMEDIATE")
        while sqlite3_step(stmt) == SQLITE_ROW {
            import_habit_id: const char* = (const char*)sqlite3_column_text(stmt, 0)
            name: const char* = (const char*)sqlite3_column_text(stmt, 1)
            local_habit_id: [INBE_STORAGE_ID_SIZE] char
            color: Color = {(unsigned char)sqlite3_column_int(stmt, 2),
                           (unsigned char)sqlite3_column_int(stmt, 3),
                           (unsigned char)sqlite3_column_int(stmt, 4), 255}
            sync_activity: int = sqlite3_column_int(stmt, 6)
            counter_enabled: int = sqlite3_column_int(stmt, 7) != 0
            sort_order: int = sqlite3_column_int(stmt, 8)

            if import_habit_id == nil || import_habit_id[0] == '\0' ||
               name == nil || name[0] == '\0' {
                continue
            }
            if !resolve_import_habit_id(import_habit_id, name, local_habit_id,
                                        sizeof(local_habit_id)) {
                continue
            }
            if import_upsert_habit(habit_write_stmt, local_habit_id, name, color,
                                   sqlite3_column_int(stmt, 5), sync_activity,
                                   counter_enabled, sort_order, imported_at) {
                ok = 1
            }

            if hstmt != nil {
                sqlite3_reset(hstmt)
                sqlite3_clear_bindings(hstmt)
                sqlite3_bind_text(hstmt, 1, import_habit_id, -1, SQLITE_TRANSIENT)
                while sqlite3_step(hstmt) == SQLITE_ROW {
                    import_upsert_habit_day(day_write_stmt, local_habit_id,
                                            sqlite3_column_int(hstmt, 0),
                                            sqlite3_column_int(hstmt, 1) != 0,
                                            sqlite3_column_int(hstmt, 2),
                                            imported_at)
                }
            }
        }
        exec_sql("COMMIT")
        sqlite3_finalize(hstmt)
        hstmt = nil
        sqlite3_finalize(habit_write_stmt)
        habit_write_stmt = nil
        sqlite3_finalize(day_write_stmt)
        day_write_stmt = nil
    }
after_habits:
    sqlite3_finalize(hstmt)
    hstmt = nil
    sqlite3_finalize(habit_write_stmt)
    habit_write_stmt = nil
    sqlite3_finalize(day_write_stmt)
    day_write_stmt = nil

    if mode == INBE_STORAGE_IMPORT_DATA_AND_SETTINGS {
        imported_settings = import_settings_from_source(src)
    }
    if imported_settings > 0 {
        ok = 1
    }

    goto done

try_tickmate:
    sqlite3_finalize(stmt)
    stmt = nil
    ok = import_tickmate_db(src)
    if !ok {
        TraceLog(LOG_WARNING, "DATA: sqlite import was neither Inbe nor supported Tickmate schema")
    }

done:
    sqlite3_finalize(hstmt)
    hstmt = nil
    sqlite3_finalize(habit_write_stmt)
    habit_write_stmt = nil
    sqlite3_finalize(day_write_stmt)
    day_write_stmt = nil
    if deferred_materialize && g_storage.materialize_defer > 0 {
        g_storage.materialize_defer--
        if g_storage.materialize_defer == 0 && g_storage.materialize_needed {
            g_storage.materialize_needed = 0
            storage_materialize_session_habit_days()
        }
    }
    sqlite3_finalize(stmt)
    if src != nil {
        sqlite3_close(src)
    }
    if ok {
        storage_enqueue_all_sync_state()
        storage_schedule_persist()
    }
    return ok
}

storage_import_zip :: (path: const char*) -> int #export {
    return storage_import_zip_ex(path, INBE_STORAGE_IMPORT_DATA_ONLY)
}

storage_import_zip_ex :: (path: const char*, mode: InbeStorageImportMode) -> int #export {
    archive: mz_zip_archive
    ok: int = 0

    if path == nil || path[0] == '\0' {
        TraceLog(LOG_ERROR, "DATA: import path is empty")
        return 0
    }
    if !path_exists(path) {
        TraceLog(LOG_ERROR, "DATA: import path does not exist: %s", path)
        return 0
    }
    memset(&archive, 0, sizeof(archive))
    if !mz_zip_reader_init_file(&archive, path, 0) {
        return import_sqlite_db_file(path, mode)
    }
    if mz_zip_reader_locate_file(&archive, "inbe-data/inbe.db", nil, 0) >= 0 {
        db_bytes: char*
        db_size: size_t = 0
        temp_path: [INBE_STORAGE_PATH_SIZE] char
        fp: FILE*
        db_bytes = mz_zip_reader_extract_file_to_heap(&archive, "inbe-data/inbe.db", &db_size, 0)
        if !storage_join_path(temp_path, sizeof(temp_path), g_storage.root, "import-inbe.db") {
            TraceLog(LOG_ERROR, "DATA: import temp path is too long")
            free(db_bytes)
            mz_zip_reader_end(&archive)
            return 0
        }
        fp = fopen(temp_path, "wb")
        if db_bytes != nil && fp != nil && fwrite(db_bytes, 1, db_size, fp) == db_size {
            fclose(fp)
            fp = nil
            ok = import_sqlite_db_file(temp_path, mode)
            remove(temp_path)
            if !ok {
                TraceLog(LOG_ERROR, "DATA: archive contained inbe-data/inbe.db but sqlite import failed")
            }
        } else {
            TraceLog(LOG_ERROR, "DATA: failed to extract inbe-data/inbe.db from archive")
        }
        if fp != nil {
            fclose(fp)
        }
        free(db_bytes)
    } else {
        ok = import_legacy_session_zip(&archive)
    }
    mz_zip_reader_end(&archive)
    if !ok {
        TraceLog(LOG_ERROR, "DATA: import failed for %s", path)
    } else {
        storage_enqueue_all_sync_state()
    }
    return ok
}

storage_inspect_import :: (path: const char*, info: InbeStorageImportInfo*) -> int #export {
    archive: mz_zip_archive
    ok: int = 0

    if info != nil {
        memset(info, 0, sizeof(*info))
    }
    if path == nil || path[0] == '\0' || info == nil || !path_exists(path) {
        return 0
    }

    memset(&archive, 0, sizeof(archive))
    if !mz_zip_reader_init_file(&archive, path, 0) {
        return inspect_sqlite_db_file(path, info)
    }

    if mz_zip_reader_locate_file(&archive, "inbe-data/inbe.db", nil, 0) >= 0 {
        db_bytes: char*
        db_size: size_t = 0
        temp_path: [INBE_STORAGE_PATH_SIZE] char
        fp: FILE*
        db_bytes = mz_zip_reader_extract_file_to_heap(&archive, "inbe-data/inbe.db", &db_size, 0)
        if !storage_join_path(temp_path, sizeof(temp_path), g_storage.root,
                              "import-inspect-inbe.db") {
            free(db_bytes)
            mz_zip_reader_end(&archive)
            return 0
        }
        fp = fopen(temp_path, "wb")
        if db_bytes != nil && fp != nil && fwrite(db_bytes, 1, db_size, fp) == db_size {
            fclose(fp)
            fp = nil
            ok = inspect_sqlite_db_file(temp_path, info)
            remove(temp_path)
        }
        if fp != nil {
            fclose(fp)
        }
        free(db_bytes)
    } else {
        file_count: mz_uint = mz_zip_reader_get_num_files(&archive)
        for mz_uint i = 0; i < file_count; i++ {
            stat: mz_zip_archive_file_stat
            year: int
            month: int
            day: int
            hour: int
            minute: int
            second: int

            if !mz_zip_reader_file_stat(&archive, i, &stat) || stat.m_is_directory {
                continue
            }
            if parse_legacy_session_filename(stat.m_filename, &year, &month, &day,
                                             &hour, &minute, &second) {
                info->session_count++
            }
        }
        info->has_sessions = info->session_count > 0
        info->valid = info->has_sessions
        ok = info->valid
    }
    mz_zip_reader_end(&archive)
    return ok
}
