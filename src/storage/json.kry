#import "storage_json_builder.h"
#import <stdarg.h>
#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>

storage_json_builder_reserve :: (json: StorageJsonBuilder*, extra: size_t) -> int #export {
    next: char*
    next_cap: size_t
    if json == nil || !json->ok {
        return 0
    }
    if extra <= json->cap - json->len {
        return 1
    }
    next_cap = json->cap > 0 ? json->cap : 1024
    while extra > next_cap - json->len {
        next_cap *= 2
    }
    next = (char *)realloc(json->data, next_cap)
    if next == nil {
        json->ok = 0
        return 0
    }
    json->data = next
    json->cap = next_cap
    return 1
}

storage_json_builder_append_len :: (json: StorageJsonBuilder*, text: const char*, len: size_t) #export {
    if text == nil || len == 0 {
        return
    }
    if !storage_json_builder_reserve(json, len + 1) {
        return
    }
    memcpy(json->data + json->len, text, len)
    json->len += len
    json->data[json->len] = '\0'
}

storage_json_builder_append :: (json: StorageJsonBuilder*, text: const char*) #export {
    if text != nil {
        storage_json_builder_append_len(json, text, strlen(text))
    }
}

storage_json_builder_append_string :: (json: StorageJsonBuilder*, text: const char*) #export {
    p: const unsigned char* = (const unsigned char *)(text != nil ? text : "")
    storage_json_builder_append(json, "\"")
    while *p != '\0' {
        escaped: [8] char
        if *p == '"' || *p == '\\' {
            escaped[0] = '\\'
            escaped[1] = (char)*p
            storage_json_builder_append_len(json, escaped, 2)
        } else if *p == '\b' {
            storage_json_builder_append(json, "\\b")
        } else if *p == '\f' {
            storage_json_builder_append(json, "\\f")
        } else if *p == '\n' {
            storage_json_builder_append(json, "\\n")
        } else if *p == '\r' {
            storage_json_builder_append(json, "\\r")
        } else if *p == '\t' {
            storage_json_builder_append(json, "\\t")
        } else if *p < 0x20 {
            snprintf(escaped, sizeof(escaped), "\\u%04x", *p)
            storage_json_builder_append(json, escaped)
        } else {
            storage_json_builder_append_len(json, (const char *)p, 1)
        }
        p++
    }
    storage_json_builder_append(json, "\"")
}

storage_json_builder_append_key_string :: (json: StorageJsonBuilder*, key: const char*, value: const char*) #export {
    storage_json_builder_append_string(json, key)
    storage_json_builder_append(json, ":")
    storage_json_builder_append_string(json, value)
}

storage_json_builder_free :: (json: StorageJsonBuilder*) #export {
    if json == nil {
        return
    }
    free(json->data)
    memset(json, 0, sizeof(*json))
}

storage_json_builder_append_epoch :: (json: StorageJsonBuilder*, seconds: long long) #export {
    formatted: [32] char
    tm_value: struct tm
    value: time_t = (time_t)seconds
    if seconds <= 0 {
        value = time(nil)
    }
    #if #defined(_WIN32) {
        gmtime_s(&tm_value, &value)
    } #else {
        gmtime_r(&value, &tm_value)
    }
    strftime(formatted, sizeof(formatted), "%Y-%m-%dT%H:%M:%SZ", &tm_value)
    storage_json_builder_append_string(json, formatted)
}
