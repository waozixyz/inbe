#import "storage.h"

#import "db.h" #private
#import <sqlite3.h>
#import <stdio.h>
#import <stdlib.h>
#import <string.h>

static storage_sync_pending_review_key: const char* = "sync_pending_review_pending"
static storage_sync_apply_review_key: const char* = "sync_apply_pending_review"
static storage_sync_full_replace_key: const char* = "sync_full_replace_requested"
static storage_sync_auto_apply_visible_change_limit: int = 2

ReviewText :: struct {
    data: char*
    len: size_t
    cap: size_t
    ok: int
}

review_sql_bool :: (sql: const char*, text_arg: const char*, fallback: int) -> int #private {
    stmt: sqlite3_stmt* = nil
    result: int = fallback

    if g_storage.db == nil || sql == nil {
        return fallback
    }
    if sqlite3_prepare_v2(g_storage.db, sql, -1, &stmt, nil) != SQLITE_OK {
        return fallback
    }
    if text_arg != nil {
        bind_text(stmt, 1, text_arg)
    }
    if sqlite3_step(stmt) == SQLITE_ROW {
        result = sqlite3_column_int(stmt, 0) != 0
    }
    sqlite3_finalize(stmt)
    return result
}

review_reserve :: (text: ReviewText*, extra: size_t) -> int #private {
    next: char*
    next_cap: size_t

    if text == nil || !text->ok {
        return 0
    }
    if extra <= text->cap - text->len {
        return 1
    }
    next_cap = text->cap > 0 ? text->cap : 2048
    while extra > next_cap - text->len {
        next_cap *= 2
    }
    next = (char*)realloc(text->data, next_cap)
    if next == nil {
        text->ok = 0
        return 0
    }
    text->data = next
    text->cap = next_cap
    return 1
}

review_append :: (text: ReviewText*, value: const char*) #private {
    len: size_t

    if text == nil || value == nil {
        return
    }
    len = strlen(value)
    if !review_reserve(text, len + 1) {
        return
    }
    memcpy(text->data + text->len, value, len)
    text->len += len
    text->data[text->len] = '\0'
}

review_append_buffer :: (text: ReviewText*, buffer: const char*) #private {
    if text == nil || !text->ok {
        return
    }
    review_append(text, buffer)
}

review_append_date :: (out: ReviewText*, local_date: int) #private {
    buffer: [16] char = {0}

    snprintf(buffer, sizeof(buffer), "%04d-%02d-%02d",
             local_date / 10000, (local_date / 100) % 100, local_date % 100)
    review_append_buffer(out, buffer)
}

review_append_date_time :: (out: ReviewText*, local_date: int, time_text: const char*) #private {
    review_append_date(out, local_date)
    review_append(out, " ")
    review_append(out, time_text != nil ? time_text : "--:--")
    review_append(out, "\n")
}

review_append_count :: (out: ReviewText*, count: int) #private {
    buffer: [32] char = {0}

    snprintf(buffer, sizeof(buffer), " count %d", count)
    review_append_buffer(out, buffer)
}

review_append_seconds :: (out: ReviewText*, seconds: int) #private {
    buffer: [32] char = {0}

    snprintf(buffer, sizeof(buffer), "%ds", seconds)
    review_append_buffer(out, buffer)
}

review_append_duration :: (out: ReviewText*, seconds: int) #private {
    buffer: [32] char = {0}

    snprintf(buffer, sizeof(buffer), "duration %ds", seconds)
    review_append_buffer(out, buffer)
}

review_append_rounds :: (out: ReviewText*, rounds: const char*) #private {
    review_append(out, "rounds ")
    review_append(out, rounds != nil ? rounds : "none")
}

storage_sync_review_path :: (out: char*, out_size: size_t) #private {
    if !storage_join_path(out, out_size, g_storage.root, "sync-review.json") &&
       out != nil && out_size > 0 {
        out[0] = '\0'
    }
}

storage_sync_review_write_json :: (json: const char*) -> int {
    path: [INBE_STORAGE_PATH_SIZE] char
    file: FILE*
    len: size_t

    if json == nil {
        return 0
    }
    storage_sync_review_path(path, sizeof(path))
    if path[0] == '\0' {
        return 0
    }
    file = fopen(path, "wb")
    if file == nil {
        return 0
    }
    len = strlen(json)
    if fwrite(json, 1, len, file) != len {
        fclose(file)
        return 0
    }
    return fclose(file) == 0
}

storage_sync_review_read_json :: () -> char* #private {
    path: [INBE_STORAGE_PATH_SIZE] char
    file: FILE*
    size: long
    data: char*

    storage_sync_review_path(path, sizeof(path))
    if path[0] == '\0' {
        return nil
    }
    file = fopen(path, "rb")
    if file == nil {
        return nil
    }
    if fseek(file, 0, SEEK_END) != 0 {
        fclose(file)
        return nil
    }
    size = ftell(file)
    if size < 0 || size > 8 * 1024 * 1024 {
        fclose(file)
        return nil
    }
    rewind(file)
    data = (char*)malloc((size_t)size + 1)
    if data == nil {
        fclose(file)
        return nil
    }
    if fread(data, 1, (size_t)size, file) != (size_t)size {
        free(data)
        fclose(file)
        return nil
    }
    data[size] = '\0'
    fclose(file)
    return data
}

storage_sync_review_delete_json :: () {
    path: [INBE_STORAGE_PATH_SIZE] char

    storage_sync_review_path(path, sizeof(path))
    if path[0] != '\0' {
        remove(path)
    }
}

storage_sync_review_pending :: () -> int {
    return get_meta_int64(storage_sync_pending_review_key, 0) != 0
}

review_activity_name :: (activity: int) -> const char* #private {
    switch activity {
    case 0:
        return GetLocaleText("exercise_wim_hof")
    case 1:
        return GetLocaleText("exercise_meditation")
    case 2:
        return GetLocaleText("exercise_sun_salutation")
    default:
        break
    }
    return nil
}

review_activity_uses_duration :: (activity: int) -> int #private {
    return activity == 1
}

review_append_activity_heading :: (out: ReviewText*, activity: int) #private {
    name: const char* = review_activity_name(activity)

    if name == nil {
        return
    }
    review_append(out, name)
    review_append(out, "\n")
}

review_append_habit_day :: (out: ReviewText*, last_name: char*, last_name_size: size_t,
                           rows: int*, name: const char*, local_date: int, count: int) #private {
    safe_name: const char* = name != nil && name[0] != '\0' ? name : "(unnamed)"

    if strcmp(last_name, safe_name) != 0 {
        if *rows > 0 {
            review_append(out, "\n")
        }
        review_append(out, safe_name)
        review_append(out, "\n")
        snprintf(last_name, last_name_size, "%s", safe_name)
    }
    review_append_date(out, local_date)
    if count > 0 {
        review_append_count(out, count)
    }
    review_append(out, "\n")
    (*rows)++
}

review_append_local_rounds :: (out: ReviewText*, session_id: const char*) #private {
    stmt: sqlite3_stmt* = nil
    first: int = 1

    if g_storage.db == nil || session_id == nil {
        return
    }
    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT seconds FROM session_rounds WHERE session_id=?1 ORDER BY round_index",
                          -1, &stmt, nil) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, session_id)
    while sqlite3_step(stmt) == SQLITE_ROW {
        if !first {
            review_append(out, ",")
        }
        first = 0
        review_append_seconds(out, sqlite3_column_int(stmt, 0))
    }
    sqlite3_finalize(stmt)
    if first {
        review_append(out, "none")
    }
}

review_append_local_duration :: (out: ReviewText*, session_id: const char*) #private {
    stmt: sqlite3_stmt* = nil
    total: int = 0

    if g_storage.db == nil || session_id == nil {
        return
    }
    if sqlite3_prepare_v2(g_storage.db,
                          "SELECT COALESCE(SUM(seconds),0) FROM session_rounds WHERE session_id=?1",
                          -1, &stmt, nil) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, session_id)
    if sqlite3_step(stmt) == SQLITE_ROW {
        total = sqlite3_column_int(stmt, 0)
    }
    sqlite3_finalize(stmt)
    review_append_duration(out, total)
}

review_append_local :: (out: ReviewText*) #private {
    stmt: sqlite3_stmt* = nil
    rows: int = 0
    last_activity: int = -1000000

    review_append(out, "Sessions\n")
    if g_storage.db != nil &&
       sqlite3_prepare_v2(g_storage.db,
                          "SELECT id,local_date,strftime('%H:%M',started_at,'unixepoch','localtime'),activity,deleted_at "
                          "FROM sessions WHERE user_id=?1 AND deleted_at=0 ORDER BY activity,local_date DESC,started_at DESC,id",
                          -1, &stmt, nil) == SQLITE_OK {
        bind_text(stmt, 1, g_storage.user_id)
        while sqlite3_step(stmt) == SQLITE_ROW {
            id: const char* = (const char*)sqlite3_column_text(stmt, 0)
            local_date: int = sqlite3_column_int(stmt, 1)
            time_text: const char* = (const char*)sqlite3_column_text(stmt, 2)
            activity: int = sqlite3_column_int(stmt, 3)

            if review_activity_name(activity) == nil {
                continue
            }
            if activity != last_activity {
                if rows > 0 {
                    review_append(out, "\n")
                }
                review_append_activity_heading(out, activity)
                last_activity = activity
            }
            review_append_date_time(out, local_date, time_text)
            if activity == 2 {
                review_append(out, "session 1")
            } else if review_activity_uses_duration(activity) {
                review_append_local_duration(out, id)
            } else {
                review_append(out, "rounds ")
                review_append_local_rounds(out, id)
            }
            if sqlite3_column_int64(stmt, 4) != 0 {
                review_append(out, " deleted")
            }
            review_append(out, "\n")
            rows++
        }
        sqlite3_finalize(stmt)
    }
    if rows == 0 {
        review_append(out, "No sessions\n")
    }

    rows = 0
    review_append(out, "\nHabit days\n")
    if g_storage.db != nil &&
       sqlite3_prepare_v2(g_storage.db,
                          "SELECT h.name,hd.local_date,hd.count "
                          "FROM habit_days hd JOIN habits h ON h.id=hd.habit_id "
                          "WHERE h.user_id=?1 AND (hd.completed!=0 OR hd.count>0 OR hd.session_count>0) "
                          "ORDER BY h.name,hd.local_date DESC",
                          -1, &stmt, nil) == SQLITE_OK {
        last_name: [256] char = {0}

        bind_text(stmt, 1, g_storage.user_id)
        while sqlite3_step(stmt) == SQLITE_ROW {
            local_date: int = sqlite3_column_int(stmt, 1)
            name: const char* = (const char*)sqlite3_column_text(stmt, 0)

            review_append_habit_day(out, last_name, sizeof(last_name), &rows,
                                    name, local_date, sqlite3_column_int(stmt, 2))
        }
        sqlite3_finalize(stmt)
    }
    if rows == 0 {
        review_append(out, "No habit days\n")
    }
}

review_append_remote :: (out: ReviewText*, json: const char*) #private {
    stmt: sqlite3_stmt* = nil
    rows: int = 0
    last_activity: int = -1000000

    review_append(out, "Sessions\n")
    if g_storage.db != nil && json != nil &&
       sqlite3_prepare_v2(g_storage.db,
                          "SELECT CAST(COALESCE(json_extract(s.value,'$.local_date'),0) AS INTEGER),"
                          "       COALESCE(strftime('%H:%M',json_extract(s.value,'$.started_at'),'localtime'),'--:--'),"
                          "       CAST(COALESCE(json_extract(s.value,'$.activity'),0) AS INTEGER),"
                          "       CAST(COALESCE(json_extract(s.value,'$.deleted_at'),0) AS INTEGER),"
                          "       COALESCE((SELECT group_concat(CAST(COALESCE(json_extract(r.value,'$.hold_seconds'),0) AS INTEGER) || 's', ',') FROM json_each(s.value,'$.rounds') AS r),'none'),"
                          "       CAST(COALESCE((SELECT SUM(CAST(COALESCE(json_extract(r.value,'$.hold_seconds'),0) AS INTEGER)) FROM json_each(s.value,'$.rounds') AS r),0) AS INTEGER) "
                          "FROM json_each(?1,'$.changes.sessions') AS s "
                          "WHERE CAST(COALESCE(json_extract(s.value,'$.deleted_at'),0) AS INTEGER)=0 "
                          "ORDER BY 3,1 DESC,2 DESC",
                          -1, &stmt, nil) == SQLITE_OK {
        bind_text(stmt, 1, json)
        while sqlite3_step(stmt) == SQLITE_ROW {
            local_date: int = sqlite3_column_int(stmt, 0)
            time_text: const char* = (const char*)sqlite3_column_text(stmt, 1)
            activity: int = sqlite3_column_int(stmt, 2)
            rounds: const char* = (const char*)sqlite3_column_text(stmt, 4)
            duration: int = sqlite3_column_int(stmt, 5)

            if review_activity_name(activity) == nil {
                continue
            }
            if activity != last_activity {
                if rows > 0 {
                    review_append(out, "\n")
                }
                review_append_activity_heading(out, activity)
                last_activity = activity
            }
            review_append_date_time(out, local_date, time_text)
            if activity == 2 {
                review_append(out, "session 1")
            } else if review_activity_uses_duration(activity) {
                review_append_duration(out, duration)
            } else {
                review_append_rounds(out, rounds)
            }
            if sqlite3_column_int64(stmt, 3) != 0 {
                review_append(out, " deleted")
            }
            review_append(out, "\n")
            rows++
        }
        sqlite3_finalize(stmt)
    }
    if rows == 0 {
        review_append(out, "No sessions\n")
    }

    rows = 0
    review_append(out, "\nHabit days\n")
    if g_storage.db != nil && json != nil &&
       sqlite3_prepare_v2(g_storage.db,
                          "SELECT COALESCE((SELECT COALESCE(json_extract(h.value,'$.name'),'') FROM json_each(?1,'$.changes.habits') AS h WHERE COALESCE(json_extract(h.value,'$.id'),'')=COALESCE(json_extract(d.value,'$.habit_id'),'')),"
                          "                (SELECT name FROM habits WHERE id=COALESCE(json_extract(d.value,'$.habit_id'),'') LIMIT 1),"
                          "                ''),"
                          "       CAST(COALESCE(json_extract(d.value,'$.local_date'),0) AS INTEGER),"
                          "       CAST(COALESCE(json_extract(d.value,'$.count'),0) AS INTEGER) "
                          "FROM json_each(?1,'$.changes.habit_days') AS d "
                          "WHERE json_extract(d.value,'$.completed') OR CAST(COALESCE(json_extract(d.value,'$.count'),0) AS INTEGER)>0 "
                          "ORDER BY 1,2 DESC",
                          -1, &stmt, nil) == SQLITE_OK {
        last_name: [256] char = {0}

        bind_text(stmt, 1, json)
        while sqlite3_step(stmt) == SQLITE_ROW {
            local_date: int = sqlite3_column_int(stmt, 1)
            name: const char* = (const char*)sqlite3_column_text(stmt, 0)

            if name == nil || name[0] == '\0' {
                continue
            }
            review_append_habit_day(out, last_name, sizeof(last_name), &rows,
                                    name, local_date, sqlite3_column_int(stmt, 2))
        }
        sqlite3_finalize(stmt)
    }
    if rows == 0 {
        review_append(out, "No habit days\n")
    }
}

storage_sync_review_details :: (local_out: char**, remote_out: char**) -> int {
    json: char* = storage_sync_review_read_json()
    local: ReviewText = {0}
    remote: ReviewText = {0}

    if local_out != nil {
        *local_out = nil
    }
    if remote_out != nil {
        *remote_out = nil
    }
    local.ok = 1
    remote.ok = 1
    review_append_local(&local)
    review_append_remote(&remote, json)
    free(json)
    if !local.ok || !remote.ok {
        free(local.data)
        free(remote.data)
        return 0
    }
    if local_out != nil {
        *local_out = local.data != nil ? local.data : strdup("")
    } else {
        free(local.data)
    }
    if remote_out != nil {
        *remote_out = remote.data != nil ? remote.data : strdup("")
    } else {
        free(remote.data)
    }
    return (local_out == nil || *local_out != nil) &&
           (remote_out == nil || *remote_out != nil)
}

review_line_equal :: (line: const char*, line_len: size_t, other: const char*) -> int #private {
    p: const char* = other
    end: const char*
    len: size_t

    if line == nil || other == nil {
        return 0
    }
    while *p != '\0' {
        end = strchr(p, '\n')
        len = end != nil ? (size_t)(end - p) : strlen(p)
        if len == line_len && strncmp(p, line, line_len) == 0 {
            return 1
        }
        if end == nil {
            break
        }
        p = end + 1
    }
    return 0
}

review_append_unique_lines :: (out: ReviewText*, prefix: const char*,
                              lines: const char*, other: const char*) #private {
    p: const char* = lines
    end: const char*
    len: size_t

    if out == nil || prefix == nil || lines == nil {
        return
    }
    while *p != '\0' {
        end = strchr(p, '\n')
        len = end != nil ? (size_t)(end - p) : strlen(p)
        if len > 0 && !review_line_equal(p, len, other) {
            review_append(out, prefix)
            if !review_reserve(out, len + 2) {
                return
            }
            memcpy(out->data + out->len, p, len)
            out->len += len
            out->data[out->len] = '\n'
            out->len++
            out->data[out->len] = '\0'
        }
        if end == nil {
            break
        }
        p = end + 1
    }
}

storage_sync_review_diff_for_json :: (json: const char*, include_empty_message: int,
                                     diff_out: char**) -> int #private {
    local: ReviewText = {0}
    remote: ReviewText = {0}
    diff: ReviewText = {0}

    if diff_out != nil {
        *diff_out = nil
    }
    if diff_out == nil {
        return 0
    }
    local.ok = 1
    remote.ok = 1
    diff.ok = 1
    review_append_local(&local)
    review_append_remote(&remote, json)
    if !local.ok || !remote.ok {
        free(local.data)
        free(remote.data)
        return 0
    }
    review_append_unique_lines(&diff, "- ", local.data != nil ? local.data : "",
                               remote.data != nil ? remote.data : "")
    review_append_unique_lines(&diff, "+ ", remote.data != nil ? remote.data : "",
                               local.data != nil ? local.data : "")
    if diff.len == 0 && include_empty_message {
        review_append(&diff, "No visible differences.\n")
    }
    free(local.data)
    free(remote.data)
    if !diff.ok {
        free(diff.data)
        return 0
    }
    *diff_out = diff.data != nil ? diff.data : strdup("")
    return *diff_out != nil
}

storage_sync_review_diff :: (diff_out: char**) -> int {
    json: char* = storage_sync_review_read_json()
    ok: int = storage_sync_review_diff_for_json(json, 1, diff_out)

    free(json)
    return ok
}

storage_sync_review_has_visible_diff :: () -> int {
    json: char* = storage_sync_review_read_json()
    result: int = storage_sync_review_json_has_visible_diff(json)

    free(json)
    return result
}

storage_sync_review_clear_if_no_visible_diff :: () -> int {
    if !storage_sync_review_pending() {
        return 0
    }
    if storage_sync_review_has_visible_diff() {
        return 0
    }
    set_meta(storage_sync_pending_review_key, "")
    storage_sync_review_delete_json()
    set_meta_int64(storage_sync_apply_review_key, 0)
    storage_schedule_persist()
    return 1
}

storage_sync_review_apply_remote_if_local_empty :: () -> int {
    if !storage_sync_review_pending() {
        return 0
    }
    if review_has_local_activity() {
        return 0
    }
    return storage_apply_pending_sync_review(1)
}

storage_sync_review_json_has_visible_diff :: (json: const char*) -> int {
    diff: char* = nil
    has_diff: int

    if !storage_sync_review_diff_for_json(json, 0, &diff) {
        free(diff)
        return 1
    }
    has_diff = diff != nil && diff[0] != '\0' &&
               (review_has_pending_outbox() || review_has_unknown_activity(json))
    free(diff)
    return has_diff
}

storage_sync_review_json_should_auto_apply_remote :: (json: const char*) -> int {
    diff: char* = nil
    result: int

    if review_has_unknown_activity(json) {
        return 0
    }
    if !storage_sync_review_diff_for_json(json, 0, &diff) {
        free(diff)
        return 0
    }
    if diff == nil || diff[0] == '\0' {
        free(diff)
        return 1
    }
    if !review_has_local_activity() {
        free(diff)
        return 1
    }
    if !review_has_pending_outbox() {
        free(diff)
        return 1
    }
    result = review_small_session_only_change(diff)
    free(diff)
    return result
}

review_has_local_activity :: () -> int #private {
    return review_sql_bool("SELECT EXISTS("
                           " SELECT 1 FROM sessions WHERE deleted_at=0"
                           " UNION ALL"
                           " SELECT 1 FROM habit_days "
                           " WHERE completed!=0 OR count>0 OR session_count>0"
                           " LIMIT 1"
                           ")",
                           nil, 1)
}

review_has_pending_outbox :: () -> int #private {
    return review_sql_bool("SELECT EXISTS(SELECT 1 FROM sync_outbox LIMIT 1)",
                           nil, 1)
}

review_pending_outbox_sessions_only :: () -> int #private {
    return review_sql_bool(
        "SELECT EXISTS(SELECT 1 FROM sync_outbox LIMIT 1) "
        "AND NOT EXISTS(SELECT 1 FROM sync_outbox WHERE entity_type<>'session')",
        nil, 0)
}

review_has_unknown_activity :: (json: const char*) -> int #private {
    if review_sql_bool("SELECT EXISTS(SELECT 1 FROM sessions "
                       "WHERE deleted_at=0 AND activity NOT IN (0,1,2))",
                       nil, 1) {
        return 1
    }

    if json == nil {
        return 0
    }
    return review_sql_bool(
        "SELECT EXISTS("
        " SELECT 1 FROM json_each(?1,'$.changes.sessions') AS s "
        " WHERE CAST(COALESCE(json_extract(s.value,'$.deleted_at'),0) AS INTEGER)=0 "
        " AND CAST(COALESCE(json_extract(s.value,'$.activity'),0) AS INTEGER) NOT IN (0,1,2)"
        ")",
        json, 1)
}

review_small_session_only_change :: (diff: const char*) -> int #private {
    count: int

    if !review_pending_outbox_sessions_only() {
        return 0
    }
    count = review_visible_change_count(diff)
    return count > 0 && count <= storage_sync_auto_apply_visible_change_limit
}

review_line_starts_with_date :: (line: const char*, len: size_t) -> int #private {
    if line == nil || len < 10 {
        return 0
    }
    return line[0] >= '0' && line[0] <= '9' &&
           line[1] >= '0' && line[1] <= '9' &&
           line[2] >= '0' && line[2] <= '9' &&
           line[3] >= '0' && line[3] <= '9' &&
           line[4] == '-' &&
           line[5] >= '0' && line[5] <= '9' &&
           line[6] >= '0' && line[6] <= '9' &&
           line[7] == '-' &&
           line[8] >= '0' && line[8] <= '9' &&
           line[9] >= '0' && line[9] <= '9'
}

review_line_equals_literal :: (line: const char*, len: size_t, literal: const char*) -> int #private {
    literal_len: size_t

    if line == nil || literal == nil {
        return 0
    }
    literal_len = strlen(literal)
    return len == literal_len && strncmp(line, literal, len) == 0
}

review_visible_change_count :: (diff: const char*) -> int #private {
    p: const char* = diff
    diff_line: const char*
    end: const char*
    len: size_t
    date_lines: int = 0
    changed_lines: int = 0

    if diff == nil {
        return 0
    }
    while *p != '\0' {
        end = strchr(p, '\n')
        len = end != nil ? (size_t)(end - p) : strlen(p)
        if len > 2 && (p[0] == '-' || p[0] == '+') && p[1] == ' ' {
            diff_line = p + 2
            len -= 2
            if review_line_starts_with_date(diff_line, len) {
                date_lines++
            } else if !review_line_equals_literal(diff_line, len, "Sessions") &&
                      !review_line_equals_literal(diff_line, len, "Habit days") {
                changed_lines++
            }
        }
        if end == nil {
            break
        }
        p = end + 1
    }
    return date_lines > 0 ? date_lines : changed_lines
}

storage_apply_pending_sync_review :: (use_remote: int) -> int {
    json: char* = storage_sync_review_read_json()
    copy: char*
    ok: int

    if json == nil || json[0] == '\0' {
        free(json)
        return 0
    }
    if !use_remote {
        set_meta(storage_sync_pending_review_key, "")
        storage_sync_review_delete_json()
        set_meta_int64(storage_sync_apply_review_key, 0)
        set_meta_int64(storage_sync_full_replace_key, 0)
        exec_sql("DELETE FROM sync_outbox")
        g_storage.pending_sync_outbox_seq = 0
        storage_schedule_persist()
        free(json)
        return 1
    }
    copy = strdup(json)
    free(json)
    if copy == nil {
        return 0
    }
    if !exec_sql("BEGIN IMMEDIATE") ||
       !exec_sql("DELETE FROM session_rounds") ||
       !exec_sql("DELETE FROM sessions") ||
       !exec_sql("DELETE FROM habit_days") ||
       !exec_sql("DELETE FROM habits") ||
       !exec_sql("DELETE FROM sync_outbox") ||
       !exec_sql("COMMIT") {
        exec_sql("ROLLBACK")
        free(copy)
        return 0
    }
    set_meta_int64(storage_sync_apply_review_key, 1)
    ok = storage_apply_sync_response_json(copy)
    free(copy)
    if ok {
        exec_sql("DELETE FROM sync_outbox")
        g_storage.pending_sync_outbox_seq = 0
        set_meta(storage_sync_pending_review_key, "")
        storage_sync_review_delete_json()
        storage_schedule_persist()
    }
    return ok
}
