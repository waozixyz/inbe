#import "sync_client.h"
#import "storage.h"
#import "sync_account.h"
#import <stdint.h>
#import <stdio.h>
#import <stdlib.h>
#import <string.h>

SYNC_WS_PATH :: "/api/v1/sync/ws"

ACCOUNT_ALIAS_PATH :: "/api/v1/account/alias"

FRIENDS_PATH :: "/api/v1/friends"

FRIEND_REQUESTS_PATH :: "/api/v1/friends/requests"

FRIEND_STATS_PATH :: "/api/v1/friends/stats"

SYNC_SERVER_URL_KEY :: "sync_server_url"

sync_log_http_failure :: (step: const char*, status: long, response: const char*) #private {
    unused response
    TraceLog(LOG_WARNING, "SYNC: %s failed status=%ld", step, status)
}

sync_client_connected_server :: (base_url: const char*) -> int #private {
    saved_url: const char*
    saved_normalized: [256] char
    requested_normalized: [256] char
    if !storage_sync_enabled() {
        return 0
    }
    saved_url = storage_get_setting_text(SYNC_SERVER_URL_KEY)
    if saved_url == nil || saved_url[0] == '\0' {
        return 0
    }
    if !sync_client_normalize_url(saved_url, saved_normalized, sizeof(saved_normalized)) {
        return 0
    }
    if !sync_client_normalize_url(base_url, requested_normalized,
    sizeof(requested_normalized)) {
        return 0
    }
    return strcmp(saved_normalized, requested_normalized) == 0
}

sync_client_url_valid :: (url: const char*) -> int #export {
    return IsSyncURLValid(url)
}

sync_client_normalize_url :: (input: const char*, out: char*, out_size: size_t) -> int #export {
    return NormalizeSyncURL(input, out, out_size)
}

sync_client_is_hex64 :: (text: const char*) -> int #private {
    if text == nil || strlen(text) != 64 {
        return 0
    }
    for int i = 0; i < 64; i++ {
        ch: char = text[i]
        if !((ch >= '0' && ch <= '9') ||
        (ch >= 'a' && ch <= 'f') ||
        (ch >= 'A' && ch <= 'F')) {
            return 0
        }
    }
    return 1
}

sync_client_normalize_friend_target :: (target: const char*, out: char*, out_size: size_t) -> int #export {
    alias: [40] char
    n: int = 0
    start: int = 0
    if out == nil || out_size == 0 {
        return 0
    }
    out[0] = '\0'
    if target == nil {
        return 0
    }
    while target[start] == ' ' || target[start] == '\t' ||
    target[start] == '\n' || target[start] == '\r' {
        start++
    }
    if target[start] == '@' {
        start++
    }
    if sync_client_is_hex64(target + start) {
        if out_size < 65 {
            return 0
        }
        for int i = 0; i < 64; i++ {
            ch: char = target[start + i]
            out[i] = (ch >= 'A' && ch <= 'F') ? (char)(ch - 'A' + 'a') : ch
        }
        out[64] = '\0'
        return 1
    }
    for int i = start; target[i] != '\0' && n < (int)sizeof(alias) - 1; i++ {
        ch: unsigned char = (unsigned char)target[i]
        if ch >= 'A' && ch <= 'Z' {
            ch = (unsigned char)(ch - 'A' + 'a')
        }
        if (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' {
            alias[n++] = (char)ch
        } else if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
            break
        } else {
            return 0
        }
    }
    alias[n] = '\0'
    if n < 4 || n > 32 || out_size < (size_t)n + 2 {
        return 0
    }
    snprintf(out, out_size, "@%s", alias)
    return 1
}

#if #defined(SYNC_CLIENT_TESTS) {
    sync_client_test_response_buffer :: (first: const char*, second: const char*, out: char*, out_size: size_t) -> int #export {
        buffer: SyncBuffer = {0}
        ok: int
        if out == nil || out_size == 0 {
            return 0
        }
        out[0] = '\0'
        ok = AppendSyncBuffer(&buffer, first, first != nil ? strlen(first) : 0) &&
        AppendSyncBuffer(&buffer, second, second != nil ? strlen(second) : 0)
        if ok && buffer.data != nil {
            snprintf(out, out_size, "%s", buffer.data)
        }
        FreeSyncBuffer(&buffer)
        return ok
    }
    sync_client_test_friend_request_body :: (target: const char*, out: char*, out_size: size_t) -> int #export {
        body: SyncBuffer = {0}
        normalized: [80] char
        ok: int
        if out == nil || out_size == 0 {
            return 0
        }
        out[0] = '\0'
        if !sync_client_normalize_friend_target(target, normalized, sizeof(normalized)) {
            return 0
        }
        ok = AppendSyncBuffer(&body, "{\"target\":", strlen("{\"target\":")) &&
        AppendSyncBufferJSONString(&body, normalized) &&
        AppendSyncBuffer(&body, "}", 1)
        if ok && body.data != nil && strlen(body.data) < out_size {
            snprintf(out, out_size, "%s", body.data)
        } else {
            ok = 0
        }
        FreeSyncBuffer(&body)
        return ok
    }
}

sync_kryon_get_text :: (key: const char*, user: void*) -> const char* #private {
    unused user
    return storage_get_setting_text(key)
}

sync_kryon_set_text :: (key: const char*, value: const char*, user: void*) #private {
    unused user
    storage_set_setting_text(key, value)
}

sync_kryon_build_payload :: (user_id_hash: const char*, public_key_hex: const char*, user: void*) -> char* #private {
    unused user
    return storage_build_sync_payload_json(user_id_hash, public_key_hex)
}

sync_kryon_free_payload :: (payload: char*, user: void*) #private {
    unused user
    storage_free_sync_payload_json(payload)
}

sync_kryon_apply_response :: (response_json: const char*, user: void*) -> int #private {
    unused user
    return storage_apply_sync_response_json(response_json)
}

sync_kryon_log_http_failure :: (step: const char*, status: long, response: const char*, user: void*) #private {
    unused user
    sync_log_http_failure(step, status, response)
}

sync_kryon_config :: (base_url: const char*, account: const SyncAccount*) -> SyncConfig #private {
    cfg: SyncConfig
    memset(&cfg, 0, sizeof(cfg))
    cfg.base_url = base_url
    cfg.account = account
    cfg.client_id = storage_sync_client_id()
    cfg.app_id = "inbe"
    cfg.protocol_version = SYNC_PROTOCOL_VERSION
    cfg.http_request = DefaultSyncHttpRequest
    cfg.get_text = sync_kryon_get_text
    cfg.set_text = sync_kryon_set_text
    cfg.build_payload = sync_kryon_build_payload
    cfg.free_payload = sync_kryon_free_payload
    cfg.apply_response = sync_kryon_apply_response
    cfg.purge_synced_deleted = nil
    cfg.log_http_failure = sync_kryon_log_http_failure
    return cfg
}

sync_client_clear_auth_token :: () #export {
    cfg: SyncConfig
    memset(&cfg, 0, sizeof(cfg))
    cfg.set_text = sync_kryon_set_text
    ClearSyncAuthToken(&cfg)
}

sync_client_run_sync :: (base_url: const char*) -> SyncResult #private {
    account: SyncAccount
    cfg: SyncConfig
    if !sync_client_url_valid(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_account_load(&account) {
        return SYNC_NO_ACCOUNT
    }
    cfg = sync_kryon_config(base_url, &account)
    return RunSync(&cfg)
}

sync_client_sync :: (base_url: const char*) -> SyncResult #export {
    if !sync_client_connected_server(base_url) {
        return SYNC_INVALID_URL
    }
    return sync_client_run_sync(base_url)
}

sync_client_connect :: (base_url: const char*) -> SyncResult #export {
    return sync_client_run_sync(base_url)
}

sync_client_register_alias :: (base_url: const char*, alias: const char*) -> SyncResult #export {
    account: SyncAccount
    body: SyncBuffer = {0}
    result: SyncResult
    response: [512] char
    saved_alias: [40] char
    if !sync_client_url_valid(base_url) {
        return SYNC_INVALID_URL
    }
    if alias == nil || alias[0] == '\0' {
        return SYNC_PAYLOAD_FAILED
    }
    if !sync_account_load(&account) {
        return SYNC_NO_ACCOUNT
    }
    if !AppendSyncBuffer(&body, "{\"user_id_hash\":", strlen("{\"user_id_hash\":")) ||
    !AppendSyncBufferJSONString(&body, account.public_id) ||
    !AppendSyncBuffer(&body, ",\"alias\":", strlen(",\"alias\":")) ||
    !AppendSyncBufferJSONString(&body, alias) ||
    !AppendSyncBuffer(&body, "}", 1) {
        FreeSyncBuffer(&body)
        return SYNC_PAYLOAD_FAILED
    }
    TraceLog(LOG_INFO, "SYNC: alias request alias=@%s", alias)
    result = sync_client_bearer_request(base_url, "POST", ACCOUNT_ALIAS_PATH,
    body.data, response, sizeof(response))
    FreeSyncBuffer(&body)
    if result != SYNC_OK {
        return result
    }
    if FindSyncJSONString(response, "alias", saved_alias, sizeof(saved_alias)) {
        storage_set_setting_text("sync_account_alias", saved_alias)
        TraceLog(LOG_INFO, "SYNC: alias response stored @%s", saved_alias)
    } else {
        TraceLog(LOG_WARNING, "SYNC: alias response missing alias field")
    }
    return SYNC_OK
}

sync_client_bearer_request :: (base_url: const char*, method: const char*, path: const char*, body: const char*, out: char*, out_size: size_t) -> SyncResult #private {
    account: SyncAccount
    cfg: SyncConfig
    if !sync_client_url_valid(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_client_connected_server(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_account_load(&account) {
        return SYNC_NO_ACCOUNT
    }
    cfg = sync_kryon_config(base_url, &account)
    return RequestSyncBearer(&cfg, method, path, body, out, out_size)
}

sync_client_send_friend_request :: (base_url: const char*, target: const char*) -> SyncResult #export {
    body: SyncBuffer = {0}
    result: SyncResult
    normalized: [80] char
    if !sync_client_normalize_friend_target(target, normalized, sizeof(normalized)) {
        return SYNC_PAYLOAD_FAILED
    }
    if !AppendSyncBuffer(&body, "{\"target\":", strlen("{\"target\":")) ||
    !AppendSyncBufferJSONString(&body, normalized) ||
    !AppendSyncBuffer(&body, "}", 1) {
        FreeSyncBuffer(&body)
        return SYNC_PAYLOAD_FAILED
    }
    TraceLog(LOG_INFO, "SYNC: friend request target=%s", normalized)
    result = sync_client_bearer_request(base_url, "POST", FRIEND_REQUESTS_PATH,
    body.data, nil, 0)
    FreeSyncBuffer(&body)
    return result
}

sync_client_get_friend_requests :: (base_url: const char*, out: char*, out_size: size_t) -> SyncResult #export {
    return sync_client_bearer_request(base_url, "GET", FRIEND_REQUESTS_PATH,
    nil, out, out_size)
}

sync_client_get_friends :: (base_url: const char*, out: char*, out_size: size_t) -> SyncResult #export {
    return sync_client_bearer_request(base_url, "GET", FRIENDS_PATH,
    nil, out, out_size)
}

sync_client_friend_request_action :: (base_url: const char*, request_id: const char*, action: const char*) -> SyncResult #private {
    path: [256] char
    if request_id == nil || request_id[0] == '\0' || action == nil {
        return SYNC_PAYLOAD_FAILED
    }
    if snprintf(path, sizeof(path), "%s/%s/%s", FRIEND_REQUESTS_PATH,
    request_id, action) >= (int)sizeof(path) {
        return SYNC_PAYLOAD_FAILED
    }
    return sync_client_bearer_request(base_url, "POST", path, "{}", nil, 0)
}

sync_client_accept_friend_request :: (base_url: const char*, request_id: const char*) -> SyncResult #export {
    return sync_client_friend_request_action(base_url, request_id, "accept")
}

sync_client_decline_friend_request :: (base_url: const char*, request_id: const char*) -> SyncResult #export {
    return sync_client_friend_request_action(base_url, request_id, "decline")
}

sync_client_remove_friend :: (base_url: const char*, friend_user_id: const char*) -> SyncResult #export {
    path: [192] char
    if friend_user_id == nil || friend_user_id[0] == '\0' {
        return SYNC_PAYLOAD_FAILED
    }
    if snprintf(path, sizeof(path), "%s/%s", FRIENDS_PATH,
    friend_user_id) >= (int)sizeof(path) {
        return SYNC_PAYLOAD_FAILED
    }
    return sync_client_bearer_request(base_url, "DELETE", path, nil, nil, 0)
}

sync_url_append_query :: (url: char*, url_size: size_t, key: const char*, value: const char*) -> int #private {
    p: const char*
    sep: char = strchr(url, '?') == nil ? '?' : '&'
    if strlen(url) + strlen(key) + 2 >= url_size {
        return 0
    }
    strncat(url, &sep, 1)
    strncat(url, key, url_size - strlen(url) - 1)
    strncat(url, "=", url_size - strlen(url) - 1)
    if value == nil {
        value = ""
    }
    for p = value; *p != '\0'; p++ {
        encoded: [4] char
        if (*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
        (*p >= '0' && *p <= '9') || *p == '_' || *p == '-' ||
        *p == '.' || *p == ':' {
            if strlen(url) + 1 >= url_size {
                return 0
            }
            strncat(url, p, 1)
        } else {
            if strlen(url) + 3 >= url_size {
                return 0
            }
            snprintf(encoded, sizeof(encoded), "%%%02X", (unsigned char)*p)
            strncat(url, encoded, url_size - strlen(url) - 1)
        }
    }
    return 1
}

sync_client_get_friend_stats :: (base_url: const char*, app: const char*, practice: const char*, metric: const char*, out: char*, out_size: size_t) -> SyncResult #export {
    path: [512] char
    snprintf(path, sizeof(path), "%s", FRIEND_STATS_PATH)
    if !sync_url_append_query(path, sizeof(path), "app", app != nil ? app : "inbe") ||
    !sync_url_append_query(path, sizeof(path), "practice", practice) ||
    !sync_url_append_query(path, sizeof(path), "metric", metric) {
        return SYNC_PAYLOAD_FAILED
    }
    return sync_client_bearer_request(base_url, "GET", path, nil, out, out_size)
}

#if #defined(SYNC_CLIENT_TESTS) {
    sync_client_test_friend_stats_path :: (app: const char*, practice: const char*, metric: const char*, out: char*, out_size: size_t) -> int #export {
        path: [512] char
        if out == nil || out_size == 0 {
            return 0
        }
        out[0] = '\0'
        snprintf(path, sizeof(path), "%s", FRIEND_STATS_PATH)
        if !sync_url_append_query(path, sizeof(path), "app", app) ||
        !sync_url_append_query(path, sizeof(path), "practice", practice) ||
        !sync_url_append_query(path, sizeof(path), "metric", metric) ||
        strlen(path) >= out_size {
            return 0
        }
        snprintf(out, out_size, "%s", path)
        return 1
    }
}

sync_client_wait_for_remote_event :: (base_url: const char*) -> SyncResult #export {
    account: SyncAccount
    cfg: SyncConfig
    if !sync_client_url_valid(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_client_connected_server(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_account_load(&account) {
        return SYNC_NO_ACCOUNT
    }
    cfg = sync_kryon_config(base_url, &account)
    return WaitForRemoteSyncEvent(&cfg, SYNC_WS_PATH)
}

sync_client_delete_account :: (base_url: const char*) -> SyncResult #export {
    account: SyncAccount
    cfg: SyncConfig
    if !sync_client_url_valid(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_client_connected_server(base_url) {
        return SYNC_INVALID_URL
    }
    if !sync_account_load(&account) {
        return SYNC_NO_ACCOUNT
    }
    cfg = sync_kryon_config(base_url, &account)
    return DeleteSyncAccount(&cfg)
}

#if #defined(__EMSCRIPTEN__) {
    sync_client_web_start_remote_events :: (base_url: const char*) -> int #export {
        account: SyncAccount
        cfg: SyncConfig
        if !sync_client_url_valid(base_url) {
            return 0
        }
        if !sync_client_connected_server(base_url) {
            return 0
        }
        if !sync_account_load(&account) {
            return 0
        }
        cfg = sync_kryon_config(base_url, &account)
        return StartWebRemoteEvents(&cfg, SYNC_WS_PATH)
    }
    sync_client_web_poll_remote_event :: () -> int #export {
        return PollWebRemoteEvents()
    }
    sync_client_web_sync_start :: (base_url: const char*) -> int #export {
        account: SyncAccount
        cfg: SyncConfig
        if !sync_client_url_valid(base_url) {
            return 0
        }
        if !sync_client_connected_server(base_url) {
            return 0
        }
        if !sync_account_load(&account) {
            return 0
        }
        cfg = sync_kryon_config(base_url, &account)
        return StartWebSync(&cfg)
    }
    sync_client_web_sync_poll :: (result: SyncResult*, changed: int*) -> int #export {
        done: int
        done = PollWebSync(result, changed)
        if done && result != nil && *result == SYNC_OK && changed != nil {
            *changed = storage_last_sync_changed()
        }
        return done
    }
}
