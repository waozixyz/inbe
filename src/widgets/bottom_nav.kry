#import "app.h"
#import "app_nav.h"

bottom_nav_route_icon :: (app: InnerBreeze*, route: int) -> Texture2D #private {
    if app == NULL {
        return (Texture2D){0}
    }
    if route == APP_NAV_ROUTE_PROFILE || route == APP_NAV_ROUTE_ACCOUNT {
        return app->icons[UI_ICON_TYPE_PROFILE]
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return app->icons[UI_ICON_TYPE_GEAR]
    }
    if route == APP_NAV_ROUTE_DATA {
        return app->icons[UI_ICON_TYPE_SAVE]
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return app->icons[UI_ICON_TYPE_PROFILE]
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return app->icons[UI_ICON_TYPE_STAT]
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app->icons[UI_ICON_TYPE_ACTIVITY]
    }
    if route == APP_NAV_ROUTE_ELIST {
        return app->icons[UI_ICON_TYPE_CHECK]
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app->icons[UI_ICON_TYPE_AMEN]
    }
    return (Texture2D){0}
}

bottom_nav_practice_fullscreen_subview :: (app: InnerBreeze*) -> int #private {
    return app != NULL && app->breathing.screen == ScreenStart && (app->practice_tab == PRACTICE_TAB_MANUAL || app->practice_tab == PRACTICE_TAB_CONFIG)
}

bottom_nav_blank_home :: (app: InnerBreeze*) -> int #private {
    return app != NULL && app->breathing.screen == ScreenStart && app->main_tab == APP_MAIN_TAB_NONE
}

bottom_nav_route_active :: (app: InnerBreeze*, route: int) -> int #private {
    if app == NULL {
        return 0
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return app->breathing.screen == ScreenProfile &&
               app->profile_view == PROFILE_VIEW_MAIN &&
               app->profile_tab == PROFILE_TAB_OVERVIEW
    }
    if route == APP_NAV_ROUTE_ACCOUNT {
        return app->breathing.screen == ScreenProfile && app->profile_view == PROFILE_VIEW_MAIN && app->profile_tab == PROFILE_TAB_SYNC
    }
    if route == APP_NAV_ROUTE_DATA {
        return app->breathing.screen == ScreenProfile && (app->profile_view == PROFILE_VIEW_DATA || app->profile_tab == PROFILE_TAB_DATA)
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return app->breathing.screen == ScreenProfile && app->profile_tab == PROFILE_TAB_FRIENDS
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return app->breathing.screen == ScreenProfile && app->profile_tab == PROFILE_TAB_LEADERBOARD
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app->breathing.screen == ScreenStart && app->main_tab == APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app->breathing.screen == ScreenHabits || app->breathing.screen == ScreenHabitEdit || app->breathing.screen == ScreenHabitSessionEdit
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return app->breathing.screen == ScreenSettings
    }
    return 0
}

bottom_nav_should_draw :: (app: InnerBreeze*) -> int #private {
    if app == NULL {
        return 0
    }
    if app_nav_desktop_rail_enabled(app) {
        return 0
    }
    if app->breathing.screen == ScreenHabitEdit {
        return 0
    }
    if app->file_dialog_active {
        return 0
    }
    if app->modal.active && app->modal.type == UIModalEditProgressiveStartSpeed {
        return 0
    }
    if app->breathing.screen == ScreenHabits && app->habits.screen_mode == HABITS_SCREEN_REORDER {
        return 0
    }
    return app_current_nav_route(app) != APP_NAV_ROUTE_NONE || bottom_nav_blank_home(app)
}

bottom_nav_draw_icon :: (icon: Texture2D, bounds: Rectangle, tint: Color) #private {
    if icon.id == 0 {
        return
    }
    DrawTexturePro(icon,
                   (Rectangle){0, 0, (float)icon.width, (float)icon.height},
                   bounds, (Vector2){0}, 0.0f, tint)
}

desktop_rail_button :: (app: InnerBreeze*, route: int, rail_x: int, y: int, item_h: int) -> int #private {
    rail_w := app_nav_desktop_rail_width()
    margin := Scale(16)
    item_w := rail_w - margin * 2
    icon_size := Scale(24)
    icon := bottom_nav_route_icon(app, route)
    label := app_nav_route_label(route)
    bounds := (Rectangle){(float)(rail_x + margin), (float)y, (float)item_w, (float)item_h}
    active := bottom_nav_route_active(app, route)
    tint := Fade(GetThemeText(), 0.82f)
    label_font := Text16
    icon_x := rail_x + margin + Scale(16)
    icon_y := y + (item_h - icon_size) / 2
    label_x := icon_x + icon_size + Scale(14)

    clicked := Button((ButtonProps){
        .bounds = bounds, .id = 6600 + route,
        .tone = active ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .selected = active, .disabled = app->modal.active,
        .style = {.normal = {
            .fields = StyleRadius,
            .radius = 14
        }}
    })
    bottom_nav_draw_icon(icon,
                         (Rectangle){(float)icon_x, (float)icon_y,
                                     (float)icon_size, (float)icon_size},
                         tint)
    Text((TextProps){
        .bounds = {(float)label_x,
                   (float)GetUIControlTextY(label, y, item_h, label_font),
                   (float)(rail_x + rail_w - margin - Scale(12) - label_x),
                   (float)Scale(24)},
        .text = label,
        .font = label_font,
        .color = tint,
        .wrap = TextWrapNone
    })

    if clicked {
        app_apply_nav_route(app, route)
        return 1
    }
    return 0
}

desktop_rail_profile_button :: (app: InnerBreeze*, rail_x: int, y: int,
                                rail_w: int) -> int #private {
    margin := Scale(16)
    item_w := rail_w - margin * 2
    item_h := Scale(76)
    avatar_size := Scale(40)
    avatar_x := rail_x + margin + Scale(12)
    avatar_y: int
    label: [96] char
    subtitle: [96] char
    bounds := (Rectangle){(float)(rail_x + margin), (float)y,
                          (float)item_w, (float)item_h}
    active := app != NULL && app->breathing.screen == ScreenProfile &&
              app->profile_view == PROFILE_VIEW_MAIN
    tint := GetThemeText()
    label_font := Text14
    sub_font := Text12
    label_w: int
    sub_w: int
    label_h := Scale(18)
    sub_h := Scale(16)
    sub_gap := Scale(3)
    content_h: int
    content_y: int
    label_y: int
    sub_y: int

    app_nav_profile_identity(app, label, sizeof(label), subtitle, sizeof(subtitle))
    label_w = TextWidth(label, label_font)
    text_x := avatar_x + avatar_size + Scale(12)
    text_w := rail_x + rail_w - margin - Scale(12) - text_x
    while label_font > Text12 && label_w > text_w {
        label_font--
        label_w = TextWidth(label, label_font)
    }
    sub_w = TextWidth(subtitle, sub_font)
    while sub_font > Text12 && sub_w > text_w {
        sub_font--
        sub_w = TextWidth(subtitle, sub_font)
    }
    content_h = label_h
    if subtitle[0] != '\0' {
        content_h += sub_gap + sub_h
    }
    content_y = y + (item_h - content_h) / 2
    avatar_y = y + (item_h - avatar_size) / 2
    label_y = content_y
    sub_y = label_y + label_h + sub_gap

    clicked := Button((ButtonProps){
        .bounds = bounds, .id = 6690,
        .tone = active ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = active ? ButtonEmphasisSoft : ButtonEmphasisGhost,
        .selected = active, .disabled = app->modal.active
    })
    DrawCircle(avatar_x + avatar_size / 2, avatar_y + avatar_size / 2,
               avatar_size / 2, LightenUIColor(GetThemeButton(), 30))
    bottom_nav_draw_icon(app->icons[app->profile_picture_icon],
                         (Rectangle){(float)avatar_x, (float)avatar_y,
                                     (float)avatar_size, (float)avatar_size},
                         WHITE)
    Text((TextProps){
        .bounds = {(float)text_x,
                   (float)GetUIControlTextY(label, label_y, label_h, label_font),
                   (float)text_w, (float)label_h},
        .text = label,
        .font = label_font,
        .color = tint,
        .wrap = TextWrapNone
    })
    if subtitle[0] != '\0' {
        Text((TextProps){
            .bounds = {(float)text_x,
                       (float)GetUIControlTextY(subtitle, sub_y, sub_h, sub_font),
                       (float)text_w, (float)sub_h},
            .text = subtitle,
            .font = sub_font,
            .color = Fade(tint, 0.70f),
            .wrap = TextWrapNone
        })
    }

    if clicked {
        app_apply_nav_route(app, APP_NAV_ROUTE_PROFILE)
        return 1
    }
    return 0
}

app_draw_desktop_nav_rail :: (app: InnerBreeze*) #private {
    rail_w := app_nav_desktop_rail_width()
    rail_x := -rail_w
    route_y := Scale(128)
    gap := Scale(12)
    item_h := Scale(52)
    footer_y := view_height - Scale(24) - item_h
    minimum_footer_y := route_y + 3 * (item_h + gap) + Scale(16)
    if footer_y < minimum_footer_y {
        footer_y = minimum_footer_y
    }
    routes: [3] int = {
        APP_NAV_ROUTE_ELIST,
        APP_NAV_ROUTE_HABITS,
        APP_NAV_ROUTE_PRACTICE
    }

    if app == NULL || !app_nav_desktop_rail_enabled(app) {
        return
    }

    DrawRectangle(rail_x, 0, rail_w, view_height,
                  DarkenUIColor(GetThemeBackground(), 9))
    DrawLine(rail_x + rail_w - 1, 0, rail_x + rail_w - 1, view_height,
             Fade(GetThemeText(), 0.12f))

    if desktop_rail_profile_button(app, rail_x, Scale(24), rail_w) {
        return
    }

    for int i = 0; i < 3; i++ {
        if desktop_rail_button(app, routes[i], rail_x, route_y, item_h) {
            return
        }
        route_y += item_h + gap
    }

    desktop_rail_button(app, APP_NAV_ROUTE_SETTINGS, rail_x, footer_y, item_h)
}

app_draw_bottom_nav :: (app: InnerBreeze*) {
    routes := (int[APP_BOTTOM_NAV_CONTENT_MAX + 1]){0}
    route_count := 0
    items := (BottomNavItem[APP_BOTTOM_NAV_CONTENT_MAX + 1]){0}
    result := (BottomNavResult){0}

    if app != NULL && app_nav_desktop_rail_enabled(app) {
        app_draw_desktop_nav_rail(app)
        return
    }

    if app != NULL && (app->nav_sidebar_open || app_nav_sidebar_screen_active(app)) {
        app_draw_nav_sidebar(app)
        return
    }

    if bottom_nav_should_draw(app) {
        app_sanitize_bottom_nav_routes(app)
        route_count = app->bottom_nav_route_count
        for int i = 0; i < route_count; i++ {
            routes[i] = app->bottom_nav_routes[i]
        }
        if app->blocked_input_frame != app->breathing.frame || !IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
            for int i = 0; i < route_count; i++ {
                route := routes[i]
                items[i] = (BottomNavItem){route, app_nav_route_label(route), bottom_nav_route_icon(app, route), bottom_nav_route_active(app, route), app->modal.active}
            }
            result = BottomNav((BottomNavProps){.view_width = view_width, .view_height = view_height, .bottom_margin = 0, .count = route_count, .items = items})
            if result.clicked_route != APP_NAV_ROUTE_NONE {
                app_apply_nav_route(app, result.clicked_route)
            }
        }
    }

    app_draw_nav_sidebar(app)
}
