#import "app/app"
#import "app_nav.h"

DesktopRailLayout :: struct {
    rail_x: int
    rail_w: int
    route_y: int
    gap: int
    item_h: int
    footer_y: int
}

bottom_nav_route_icon_type :: (route: int) -> IconType #private {
    if route == APP_NAV_ROUTE_SETTINGS {
        return ICON_NAV_SETTINGS
    }
    if route == APP_NAV_ROUTE_HABITS {
        return ICON_NAV_HABITS
    }
    if route == APP_NAV_ROUTE_ELIST {
        return ICON_NAV_LIST
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return ICON_NAV_PRACTICE
    }
    if route == APP_NAV_ROUTE_PROFILE || route == APP_NAV_ROUTE_ACCOUNT {
        return ICON_PROFILE
    }
    if route == APP_NAV_ROUTE_DATA {
        return ICON_SAVE
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return ICON_PROFILE
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return ICON_STAT
    }
    return ICON_NONE
}

bottom_nav_practice_fullscreen_subview :: (app: InnerBreeze*) -> int #private {
    return app != NULL && app->breathing.screen == ScreenStart && (app->practice_tab == PRACTICE_TAB_MANUAL || app->practice_tab == PRACTICE_TAB_CONFIG)
}

bottom_nav_blank_home :: (app: InnerBreeze*) -> int #private {
    return app != NULL && app->breathing.screen == ScreenStart && app->main_tab == APP_MAIN_TAB_NONE
}

bottom_nav_route_active :: (app: InnerBreeze*, route: int) -> int #private {
    if app == NULL {
        return 0
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return app->breathing.screen == ScreenProfile &&
        app->profile_view == PROFILE_VIEW_MAIN &&
        app->profile_tab == PROFILE_TAB_OVERVIEW
    }
    if route == APP_NAV_ROUTE_ACCOUNT {
        return app->breathing.screen == ScreenProfile && app->profile_view == PROFILE_VIEW_MAIN && app->profile_tab == PROFILE_TAB_SYNC
    }
    if route == APP_NAV_ROUTE_DATA {
        return app->breathing.screen == ScreenProfile && (app->profile_view == PROFILE_VIEW_DATA || app->profile_tab == PROFILE_TAB_DATA)
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return app->breathing.screen == ScreenProfile && app->profile_tab == PROFILE_TAB_FRIENDS
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return app->breathing.screen == ScreenProfile && app->profile_tab == PROFILE_TAB_LEADERBOARD
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app->breathing.screen == ScreenStart && app->main_tab == APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app->breathing.screen == ScreenHabits || app->breathing.screen == ScreenHabitEdit || app->breathing.screen == ScreenHabitSessionEdit
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return app->breathing.screen == ScreenSettings
    }
    if route == APP_NAV_ROUTE_ELIST {
        return app->breathing.screen == ScreenEList
    }
    return 0
}

bottom_nav_should_draw :: (app: InnerBreeze*) -> int #private {
    if app == NULL {
        return 0
    }
    if app_nav_desktop_rail_enabled(app) {
        return 0
    }
    if app->breathing.screen == ScreenHabitEdit {
        return 0
    }
    if app->file_dialog_active {
        return 0
    }
    if app->modal.active && app->modal.type == UIModalEditProgressiveStartSpeed {
        return 0
    }
    return app_current_nav_route(app) != APP_NAV_ROUTE_NONE || bottom_nav_blank_home(app)
}

desktop_rail_layout :: (app: InnerBreeze*, layout: DesktopRailLayout*) -> int #private {
    route_y := Scale(120)
    gap := Scale(12)
    item_h := Scale(52)
    footer_y := view_height - Scale(24) - item_h
    minimum_footer_y := route_y + 3 * (item_h + gap) + Scale(16)

    if app == NULL || layout == NULL || !app_nav_desktop_rail_enabled(app) {
        return 0
    }
    if footer_y < minimum_footer_y {
        footer_y = minimum_footer_y
    }
    layout->rail_w = app_nav_desktop_rail_width(app)
    layout->rail_x = app_navigation_placement(app) == NAVIGATION_RIGHT ? view_width : -layout->rail_w
    layout->route_y = route_y
    layout->gap = gap
    layout->item_h = item_h
    layout->footer_y = footer_y
    return 1
}

desktop_rail_collect_routes :: (app: InnerBreeze*, routes: int*, route_count: int*) #private {
    if app == NULL || routes == NULL || route_count == NULL {
        return
    }
    *route_count = 0
    app_sanitize_bottom_nav_routes(app)
    for int i = 0; i < app->bottom_nav_route_count; i++ {
        route := app->bottom_nav_routes[i]
        if route != APP_NAV_ROUTE_SETTINGS && route != APP_NAV_ROUTE_PROFILE &&
           *route_count < APP_BOTTOM_NAV_CONTENT_MAX {
            routes[*route_count] = route
            *route_count += 1
        }
    }
}

desktop_rail_draw_background :: (layout: DesktopRailLayout) #private {
    DrawRectangle(layout.rail_x, 0, layout.rail_w, view_height,
    DarkenColor(StyleTokenColor("canvas"), 9))
    DrawLine(layout.rail_x + layout.rail_w - 1, 0,
             layout.rail_x + layout.rail_w - 1, view_height,
    Fade(StyleTokenColor("text"), 0.12f))
}

desktop_rail_button :: (app: InnerBreeze*, route: int, rail_x: int, y: int, item_h: int) -> int #private {
    rail_w := app_nav_desktop_rail_width(app)
    margin := Scale(16)
    item_w := rail_w - margin * 2
    label := app_nav_route_label(route)
    bounds := (Rectangle){(float)(rail_x + margin), (float)y, (float)item_w, (float)item_h}
    active := bottom_nav_route_active(app, route)
    clicked := Button((ButtonProps){
        .bounds = bounds, .id = 6600 + route,
        .label = app->nav_rail_collapsed ? NULL : label,
        .icon_type = bottom_nav_route_icon_type(route),
        .icon_only = app->nav_rail_collapsed,
        .tone = active ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .selected = active,
        .disabled = app->modal.active ||
                    app->blocked_input_frame == app->breathing.frame
    })
    if clicked {
        app_apply_nav_route(app, route)
        return 1
    }
    return 0
}

desktop_rail_profile_button :: (app: InnerBreeze*, rail_x: int, y: int,
rail_w: int) -> int #private {
    margin := Scale(16)
    item_w := rail_w - margin * 2
    item_h := Scale(76)
    avatar_size := Scale(40)
    avatar_x := rail_x + margin + Scale(12)
    if app->nav_rail_collapsed {
        avatar_x = rail_x + (rail_w - avatar_size) / 2
    }
    avatar_y: int
    label: [96] char
    subtitle: [96] char
    bounds := (Rectangle){(float)(rail_x + margin), (float)y,
        (float)item_w, (float)item_h}
    active := app != NULL && app->breathing.screen == ScreenProfile &&
    app->profile_view == PROFILE_VIEW_MAIN
    label_font := Text14
    sub_font := Text12
    label_w: int
    sub_w: int
    label_h := Scale(18)
    sub_h := Scale(16)
    sub_gap := Scale(3)
    content_h: int
    content_y: int
    label_y: int
    sub_y: int
    text_class := active ? StyleClassId("selected-navigation") : 0
    subtitle_class := active ? text_class : StyleClassId("muted")

    app_nav_profile_identity(app, label, sizeof(label), subtitle, sizeof(subtitle))
    label_w = AppTextWidth(label, label_font)
    text_x := avatar_x + avatar_size + Scale(12)
    text_w := rail_x + rail_w - margin - Scale(12) - text_x
    while label_font > Text12 && label_w > text_w {
        label_font--
        label_w = AppTextWidth(label, label_font)
    }
    sub_w = AppTextWidth(subtitle, sub_font)
    while sub_font > Text12 && sub_w > text_w {
        sub_font--
        sub_w = AppTextWidth(subtitle, sub_font)
    }
    content_h = label_h
    if subtitle[0] != '\0' {
        content_h += sub_gap + sub_h
    }
    content_y = y + (item_h - content_h) / 2
    avatar_y = y + (item_h - avatar_size) / 2
    label_y = content_y
    sub_y = label_y + label_h + sub_gap
    clicked := Button((ButtonProps){
        .bounds = bounds, .id = 6690,
        .tone = active ? ButtonToneAccent : ButtonToneNeutral,
        .emphasis = active ? ButtonEmphasisSoft : ButtonEmphasisGhost,
        .selected = active,
        .disabled = app->modal.active ||
                    app->blocked_input_frame == app->breathing.frame
    })
    DrawCircle(avatar_x + avatar_size / 2, avatar_y + avatar_size / 2,
    avatar_size / 2, LightenColor(StyleTokenColor("accent"), 30))
    Icon(0, avatar_x, avatar_y, avatar_size,
         app->profile_picture_icon, WHITE)
    if !app->nav_rail_collapsed {
        Text((TextProps){
            .text = label,
            .bounds = {(float)text_x,
                       (float)AppControlTextY(label, label_y, label_h, label_font),
                       (float)text_w, (float)label_h},
            .font = label_font,
            .class_name = text_class,
            .wrap = TextWrapNone
        })
        if subtitle[0] != '\0' {
            Text((TextProps){
                .text = subtitle,
                .bounds = {(float)text_x,
                           (float)AppControlTextY(subtitle, sub_y, sub_h, sub_font),
                           (float)text_w, (float)sub_h},
                .font = sub_font,
                .class_name = subtitle_class,
                .wrap = TextWrapNone
            })
        }
    }

    if clicked {
        app_apply_nav_route(app, APP_NAV_ROUTE_PROFILE)
        return 1
    }
    return 0
}

app_draw_desktop_nav_rail :: (app: InnerBreeze*) #private {
    layout := (DesktopRailLayout){0}
    routes: [APP_BOTTOM_NAV_CONTENT_MAX] int
    route_count := 0

    if !desktop_rail_layout(app, &layout) {
        return
    }
    desktop_rail_collect_routes(app, routes, &route_count)
    desktop_rail_draw_background(layout)

    if desktop_rail_profile_button(app, layout.rail_x, Scale(16), layout.rail_w) {
        return
    }

    for int i = 0; i < route_count; i++ {
        if desktop_rail_button(app, routes[i], layout.rail_x,
                               layout.route_y, layout.item_h) {
            return
        }
        layout.route_y += layout.item_h + layout.gap
    }

    desktop_rail_button(app, APP_NAV_ROUTE_SETTINGS, layout.rail_x,
                        layout.footer_y, layout.item_h)
}

app_draw_bottom_nav :: (app: InnerBreeze*) {
    routes := (int[APP_BOTTOM_NAV_CONTENT_MAX + 1]){0}
    route_count := 0
    items := (NavigationBarItem[APP_BOTTOM_NAV_CONTENT_MAX + 1]){0}
    result := (NavigationBarResult){0}

    if app != NULL && app_nav_desktop_rail_enabled(app) {
        app_draw_desktop_nav_rail(app)
        return
    }

    if bottom_nav_should_draw(app) {
        app_sanitize_bottom_nav_routes(app)
        route_count = app->bottom_nav_route_count
        for int i = 0; i < route_count; i++ {
            routes[i] = app->bottom_nav_routes[i]
        }
        blocked := app->blocked_input_frame == app->breathing.frame && IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
        if blocked {
            PushInputCapture((Rectangle){0, 0, view_width, view_height}, 0)
        }
        {
            for int i = 0; i < route_count; i++ {
                route := routes[i]
                items[i] = (NavigationBarItem){
                    .route = route,
                    .label = app_nav_route_label(route),
                    .icon_type = bottom_nav_route_icon_type(route),
                    .active = bottom_nav_route_active(app, route),
                    .disabled = app->modal.active
                }
            }
            result = NavigationBar((NavigationBarProps){
                .view_width = view_width,
                .view_height = app_navigation_placement(app) == NAVIGATION_TOP ? 1 : view_height,
                .height = Scale(86),
                .count = route_count, .items = items
            })
            if !blocked && result.clicked_route != APP_NAV_ROUTE_NONE {
                app_apply_nav_route(app, result.clicked_route)
            }
        }
        if blocked {
            PopInputCapture()
        }
    }

}
