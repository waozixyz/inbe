#module "pet"

#import "app.h"
#import "math.h"

draw_egg :: (app: InbeApp*, center_x: int, center_y: int, egg_size: int) {
    if app == NULL {
        return
    }

    if app->pet.egg.id == 0 {
        app->pet.egg = app_load_asset_texture("pet/egg1.png")
    }
    if app->pet.egg.id == 0 {
        return
    }

    t := (float)app->inbe.frame / 60.0f
    scale := 1.0f + 0.035f * sinf(t * 2.0f)
    src := (Rectangle){0, 0, (float)app->pet.egg.width, (float)app->pet.egg.height}
    dst := (Rectangle){(float)center_x, (float)center_y, (float)egg_size * scale, (float)egg_size * scale}
    origin := (Vector2){dst.width / 2.0f, dst.height / 2.0f}

    DrawTexturePro(app->pet.egg, src, dst, origin, 0.0f, WHITE)
}
